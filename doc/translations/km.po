"ប្រសិនបើកំណត់ទៅជា [code]Color(0.0, 0.0, 0.0)[/code] (តាមលំនាំដើម) ពណ៌ដែលបានកំណត់នៅក្នុង "
"[member ProjectSettings.debug/shapes/collision/shape_color] នឹងត្រូវបានប្រើ។"

msgid ""
"The shape's destination point, relative to this node's [member "
"Node3D.position]."
msgstr "ចំណុចគោលដៅរបស់រាង ធៀបនឹង [member Node3D.position] របស់ node នេះ។"

msgid "A shortcut for binding input."
msgstr "ផ្លូវកាត់ (shortcut) សម្រាប់ភ្ជាប់ input។"

msgid ""
"Shortcuts (also known as hotkeys) are containers of [InputEvent] resources. "
"They are commonly used to interact with a [Control] element from an "
"[InputEvent].\n"
"One shortcut can contain multiple [InputEvent] resources, making it possible "
"to trigger one action with multiple different inputs.\n"
"[b]Example:[/b] Capture the [kbd]Ctrl + S[/kbd] shortcut using a [Shortcut] "
"resource:\n"
"[codeblocks]\n"
"[gdscript]\n"
"extends Node\n"
"\n"
"var save_shortcut = Shortcut.new()\n"
"func _ready():\n"
"\tvar key_event = InputEventKey.new()\n"
"\tkey_event.keycode = KEY_S\n"
"\tkey_event.ctrl_pressed = true\n"
"\tkey_event.command_or_control_autoremap = true # Swaps Ctrl for Command on "
"Mac.\n"
"\tsave_shortcut.events = [key_event]\n"
"\n"
"func _input(event):\n"
"\tif save_shortcut.matches_event(event) and event.is_pressed() and not "
"event.is_echo():\n"
"\t\tprint(\"Save shortcut pressed!\")\n"
"\t\tget_viewport().set_input_as_handled()\n"
"[/gdscript]\n"
"[csharp]\n"
"using Godot;\n"
"\n"
"public partial class MyNode : Node\n"
"{\n"
"\tprivate readonly Shortcut _saveShortcut = new Shortcut();\n"
"\n"
"\tpublic override void _Ready()\n"
"\t{\n"
"\t\tInputEventKey keyEvent = new InputEventKey\n"
"\t\t{\n"
"\t\t\tKeycode = Key.S,\n"
"\t\t\tCtrlPressed = true,\n"
"\t\t\tCommandOrControlAutoremap = true, // Swaps Ctrl for Command on Mac.\n"
"\t\t};\n"
"\n"
"\t\t_saveShortcut.Events = [keyEvent];\n"
"\t}\n"
"\n"
"\tpublic override void _Input(InputEvent @event)\n"
"\t{\n"
"\t\tif (@event is InputEventKey keyEvent &&\n"
"\t\t\t_saveShortcut.MatchesEvent(@event) &&\n"
"\t\t\tkeyEvent.Pressed && !keyEvent.Echo)\n"
"\t\t{\n"
"\t\t\tGD.Print(\"Save shortcut pressed!\");\n"
"\t\t\tGetViewport().SetInputAsHandled();\n"
"\t\t}\n"
"\t}\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"ផ្លូវកាត់ (ឬហៅថា hotkeys) គឺជាកន្លែងផ្ទុកធនធាន [InputEvent]។ "
"វាត្រូវបានប្រើជាទូទៅដើម្បីធ្វើអន្តរកម្មជាមួយធាតុ [Control] ពី [InputEvent]។\n"
"ផ្លូវកាត់មួយអាចផ្ទុកធនធាន [InputEvent] ច្រើន ដែលធ្វើឱ្យអាចបង្កឱ្យមានសកម្មភាពមួយដោយប្រើ "
"input ផ្សេងៗគ្នាជាច្រើន។\n"
"[b]ឧទាហរណ៍៖[/b] ចាប់យកផ្លូវកាត់ [kbd]Ctrl + S[/kbd] ដោយប្រើធនធាន [Shortcut]៖\n"
"[codeblocks]\n"
"[gdscript]\n"
"extends Node\n"
"\n"
"var save_shortcut = Shortcut.new()\n"
"func _ready():\n"
"\tvar key_event = InputEventKey.new()\n"
"\tkey_event.keycode = KEY_S\n"
"\tkey_event.ctrl_pressed = true\n"
"\tkey_event.command_or_control_autoremap = true # Swaps Ctrl for Command on "
"Mac.\n"
"\tsave_shortcut.events = [key_event]\n"
"\n"
"func _input(event):\n"
"\tif save_shortcut.matches_event(event) and event.is_pressed() and not "
"event.is_echo():\n"
"\t\tprint(\"Save shortcut pressed!\")\n"
"\t\tget_viewport().set_input_as_handled()\n"
"[/gdscript]\n"
"[csharp]\n"
"using Godot;\n"
"\n"
"public partial class MyNode : Node\n"
"{\n"
"\tprivate readonly Shortcut _saveShortcut = new Shortcut();\n"
"\n"
"\tpublic override void _Ready()\n"
"\t{\n"
"\t\tInputEventKey keyEvent = new InputEventKey\n"
"\t\t{\n"
"\t\t\tKeycode = Key.S,\n"
"\t\t\tCtrlPressed = true,\n"
"\t\t\tCommandOrControlAutoremap = true, // Swaps Ctrl for Command on Mac.\n"
"\t\t};\n"
"\n"
"\t\t_saveShortcut.Events = [keyEvent];\n"
"\t}\n"
"\n"
"\tpublic override void _Input(InputEvent @event)\n"
"\t{\n"
"\t\tif (@event is InputEventKey keyEvent &&\n"
"\t\t\t_saveShortcut.MatchesEvent(@event) &&\n"
"\t\t\tkeyEvent.Pressed && !keyEvent.Echo)\n"
"\t\t{\n"
"\t\t\tGD.Print(\"Save shortcut pressed!\");\n"
"\t\t\tGetViewport().SetInputAsHandled();\n"
"\t\t}\n"
"\t}\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]"

msgid "Returns the shortcut's first valid [InputEvent] as a [String]."
msgstr "បង្វិល [InputEvent] ដែលត្រឹមត្រូវដំបូងគេរបស់ផ្លូវកាត់ ជា [String]។"

msgid "Returns whether [member events] contains an [InputEvent] which is valid."
msgstr "បង្វិលថាតើ [member events] មានផ្ទុក [InputEvent] ដែលត្រឹមត្រូវឬអត់។"

msgid ""
"Returns whether any [InputEvent] in [member events] equals [param event]. "
"This uses [method InputEvent.is_match] to compare events."
msgstr ""
"បង្វិលថាតើ [InputEvent] ណាមួយនៅក្នុង [member events] ស្មើនឹង [param event] ឬអត់។ "
"វាប្រើ [method InputEvent.is_match] ដើម្បីប្រៀបធៀបព្រឹត្តិការណ៍។"

msgid ""
"The shortcut's [InputEvent] array.\n"
"Generally the [InputEvent] used is an [InputEventKey], though it can be any "
"[InputEvent], including an [InputEventAction]."
msgstr ""
"អារេ [InputEvent] របស់ផ្លូវកាត់។\n"
"ជាទូទៅ [InputEvent] ដែលបានប្រើគឺ [InputEventKey] ប៉ុន្តែវាក៏អាចជា [InputEvent] "
"ណាមួយក៏បាន រួមទាំង [InputEventAction] ផងដែរ។"

msgid "A built-in type representing a signal of an [Object]."
msgstr "ប្រភេទដែលមានស្រាប់ (built-in type) ដែលតំណាងឱ្យ signal របស់ [Object]។"

msgid ""
"[Signal] is a built-in [Variant] type that represents a signal of an [Object] "
"instance. Like all [Variant] types, it can be stored in variables and passed "
"to functions. Signals allow all connected [Callable]s (and by extension their "
"respective objects) to listen and react to events, without directly "
"referencing one another. This keeps the code flexible and easier to manage. "
"You can check whether an [Object] has a given signal name using [method "
"Object.has_signal].\n"
"In GDScript, signals can be declared with the [code]signal[/code] keyword. In "
"C#, you may use the [code][Signal][/code] attribute on a delegate.\n"
"[codeblocks]\n"
"[gdscript]\n"
"signal attacked\n"
"\n"
"# Additional arguments may be declared.\n"
"# These arguments must be passed when the signal is emitted.\n"
"signal item_dropped(item_name, amount)\n"
"[/gdscript]\n"
"[csharp]\n"
"[Signal]\n"
"delegate void AttackedEventHandler();\n"
"\n"
"// Additional arguments may be declared.\n"
"// These arguments must be passed when the signal is emitted.\n"
"[Signal]\n"
"delegate void ItemDroppedEventHandler(string itemName, int amount);\n"
"[/csharp]\n"
"[/codeblocks]\n"
"Connecting signals is one of the most common operations in Godot and the API "
"gives many options to do so, which are described further down. The code block "
"below shows the recommended approach.\n"
"[codeblocks]\n"
"[gdscript]\n"
"func _ready():\n"
"\tvar button = Button.new()\n"
"\t# `button_down` here is a Signal Variant type. We therefore call the "
"Signal.connect() method, not Object.connect().\n"
"\t# See discussion below for a more in-depth overview of the API.\n"
"\tbutton.button_down.connect(_on_button_down)\n"
"\n"
"\t# This assumes that a `Player` class exists, which defines a `hit` signal.\n"
"\tvar player = Player.new()\n"
"\t# We use Signal.connect() again, and we also use the Callable.bind() "
"method,\n"
"\t# which returns a new Callable with the parameter binds.\n"
"\tplayer.hit.connect(_on_player_hit.bind(\"sword\", 100))\n"
"\n"
"func _on_button_down():\n"
"\tprint(\"Button down!\")\n"
"\n"
"func _on_player_hit(weapon_type, damage):\n"
"\tprint(\"Hit with weapon %s for %d damage.\" % [weapon_type, damage])\n"
"[/gdscript]\n"
"[csharp]\n"
"public override void _Ready()\n"
"{\n"
"\tvar button = new Button();\n"
"\t// C# supports passing signals as events, so we can use this idiomatic "
"construct:\n"
"\tbutton.ButtonDown += OnButtonDown;\n"
"\n"
"\t// This assumes that a `Player` class exists, which defines a `Hit` "
"signal.\n"
"\tvar player = new Player();\n"
"\t// We can use lambdas when we need to bind additional parameters.\n"
"\tplayer.Hit += () => OnPlayerHit(\"sword\", 100);\n"
"}\n"
"\n"
"private void OnButtonDown()\n"
"{\n"
"\tGD.Print(\"Button down!\");\n"
"}\n"
"\n"
"private void OnPlayerHit(string weaponType, int damage)\n"
"{\n"
"\tGD.Print($\"Hit with weapon {weaponType} for {damage} damage.\");\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[code skip-lint]Object.connect()[/code] [b]or[/b] [code skip-"
"lint]Signal.connect()[/code][b]?[/b]\n"
"As seen above, the recommended method to connect signals is not [method "
"Object.connect]. The code block below shows the four options for connecting "
"signals, using either this legacy method or the recommended [method "
"Signal.connect], and using either an implicit [Callable] or a manually "
"defined one.\n"
"[codeblocks]\n"
"[gdscript]\n"
"func _ready():\n"
"\tvar button = Button.new()\n"
"\t# Option 1: Object.connect() with an implicit Callable for the defined "
"function.\n"
"\tbutton.connect(\"button_down\", _on_button_down)\n"
"\t# Option 2: Object.connect() with a constructed Callable using a target "
"object and method name.\n"
"\tbutton.connect(\"button_down\", Callable(self, \"_on_button_down\"))\n"
"\t# Option 3: Signal.connect() with an implicit Callable for the defined "
"function.\n"
"\tbutton.button_down.connect(_on_button_down)\n"
"\t# Option 4: Signal.connect() with a constructed Callable using a target "
"object and method name.\n"
"\tbutton.button_down.connect(Callable(self, \"_on_button_down\"))\n"
"\n"
"func _on_button_down():\n"
"\tprint(\"Button down!\")\n"
"[/gdscript]\n"
"[csharp]\n"
"public override void _Ready()\n"
"{\n"
"\tvar button = new Button();\n"
"\t// Option 1: In C#, we can use signals as events and connect with this "
"idiomatic syntax:\n"
"\tbutton.ButtonDown += OnButtonDown;\n"
"\t// Option 2: GodotObject.Connect() with a constructed Callable from a "
"method group.\n"
"\tbutton.Connect(Button.SignalName.ButtonDown, Callable.From(OnButtonDown));\n"
"\t// Option 3: GodotObject.Connect() with a constructed Callable using a "
"target object and method name.\n"
"\tbutton.Connect(Button.SignalName.ButtonDown, new Callable(this, "
"MethodName.OnButtonDown));\n"
"}\n"
"\n"
"private void OnButtonDown()\n"
"{\n"
"\tGD.Print(\"Button down!\");\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]\n"
"While all options have the same outcome ([code]button[/code]'s [signal "
"BaseButton.button_down] signal will be connected to [code]_on_button_down[/"
"code]), [b]option 3[/b] offers the best validation: it will print a compile-"
"time error if either the [code]button_down[/code] [Signal] or the "
"[code]_on_button_down[/code] [Callable] are not defined. On the other hand, "
"[b]option 2[/b] only relies on string names and will only be able to validate "
"either names at runtime: it will generate an error at runtime if [code]"
"\"button_down\"[/code] is not a signal, or if [code]\"_on_button_down\"[/"
"code] is not a method in the object [code]self[/code]. The main reason for "
"using options 1, 2, or 4 would be if you actually need to use strings (e.g. "
"to connect signals programmatically based on strings read from a "
"configuration file). Otherwise, option 3 is the recommended (and fastest) "
"method.\n"
"[b]Binding and passing parameters:[/b]\n"
"The syntax to bind parameters is through [method Callable.bind], which "
"returns a copy of the [Callable] with its parameters bound.\n"
"When calling [method emit] or [method Object.emit_signal], the signal "
"parameters can be also passed. The examples below show the relationship "
"between these signal parameters and bound parameters.\n"
"[codeblocks]\n"
"[gdscript]\n"
"func _ready():\n"
"\t# This assumes that a `Player` class exists, which defines a `hit` signal.\n"
"\tvar player = Player.new()\n"
"\t# Using Callable.bind().\n"
"\tplayer.hit.connect(_on_player_hit.bind(\"sword\", 100))\n"
"\n"
"\t# Parameters added when emitting the signal are passed first.\n"
"\tplayer.hit.emit(\"Dark lord\", 5)\n"
"\n"
"# We pass two arguments when emitting (`hit_by`, `level`),\n"
"# and bind two more arguments when connecting (`weapon_type`, `damage`).\n"
"func _on_player_hit(hit_by, level, weapon_type, damage):\n"
"\tprint(\"Hit by %s (level %d) with weapon %s for %d damage.\" % [hit_by, "
"level, weapon_type, damage])\n"
"[/gdscript]\n"
"[csharp]\n"
"public override void _Ready()\n"
"{\n"
"\t// This assumes that a `Player` class exists, which defines a `Hit` "
"signal.\n"
"\tvar player = new Player();\n"
"\t// Using lambda expressions that create a closure that captures the "
"additional parameters.\n"
"\t// The lambda only receives the parameters defined by the signal's "
"delegate.\n"
"\tplayer.Hit += (hitBy, level) => OnPlayerHit(hitBy, level, \"sword\", 100);\n"
"\n"
"\t// Parameters added when emitting the signal are passed first.\n"
"\tplayer.EmitSignal(SignalName.Hit, \"Dark lord\", 5);\n"
"}\n"
"\n"
"// We pass two arguments when emitting (`hit_by`, `level`),\n"
"// and bind two more arguments when connecting (`weapon_type`, `damage`).\n"
"private void OnPlayerHit(string hitBy, int level, string weaponType, int "
"damage)\n"
"{\n"
"\tGD.Print($\"Hit by {hitBy} (level {level}) with weapon {weaponType} for "
"{damage} damage.\");\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]Note:[/b] In a boolean context, a signal will evaluate to [code]false[/"
"code] if it's null (see [method is_null]). Otherwise, a signal will always "
"evaluate to [code]true[/code]."
msgstr ""
"[Signal] គឺជាប្រភេទ [Variant] ដែលមានស្រាប់ ដែលតំណាងឱ្យ signal នៃ instance [Object]។ "
"ដូចប្រភេទ [Variant] ទាំងអស់ដែរ វាអាចត្រូវបានរក្សាទុកក្នុងអថេរ និងបញ្ជូនទៅកាន់អនុគមន៍។ Signals "
"អនុញ្ញាតឱ្យ [Callable]s ទាំងអស់ដែលបានភ្ជាប់ (និងជាវិសាលភាពនៃ object របស់ពួកវា) ស្តាប់ "
"និងឆ្លើយតបទៅនឹងព្រឹត្តិការណ៍ ដោយមិនចាំបាច់យោងទៅលើគ្នាទៅវិញទៅមកដោយផ្ទាល់។ "
"នេះធ្វើឱ្យកូដមានភាពបត់បែន និងងាយស្រួលគ្រប់គ្រង។ អ្នកអាចពិនិត្យមើលថាតើ [Object] មានឈ្មោះ "
"signal ដែលបានផ្តល់ឱ្យដែរឬទេ ដោយប្រើ [method Object.has_signal]។\n"
"នៅក្នុង GDScript, signals អាចត្រូវបានប្រកាសដោយប្រើពាក្យគន្លឹះ [code]signal[/code]។ "
"នៅក្នុង C# អ្នកអាចប្រើ attribute [code][Signal][/code] នៅលើ delegate។\n"
"[codeblocks]\n"
"[gdscript]\n"
"signal attacked\n"
"\n"
"# Additional arguments may be declared.\n"
"# These arguments must be passed when the signal is emitted.\n"
"signal item_dropped(item_name, amount)\n"
"[/gdscript]\n"
"[csharp]\n"
"[Signal]\n"
"delegate void AttackedEventHandler();\n"
"\n"
"// Additional arguments may be declared.\n"
"// These arguments must be passed when the signal is emitted.\n"
"[Signal]\n"
"delegate void ItemDroppedEventHandler(string itemName, int amount);\n"
"[/csharp]\n"
"[/codeblocks]\n"
"ការភ្ជាប់ signals គឺជាប្រតិបត្តិការទូទៅបំផុតមួយនៅក្នុង Godot ហើយ API "
"ផ្តល់ជម្រើសជាច្រើនដើម្បីធ្វើដូច្នេះ ដែលត្រូវបានពណ៌នានៅខាងក្រោម។ "
"ប្លុកកូដខាងក្រោមបង្ហាញពីវិធីសាស្រ្តដែលបានណែនាំ។\n"
"[codeblocks]\n"
"[gdscript]\n"
"func _ready():\n"
"\tvar button = Button.new()\n"
"\t# `button_down` នៅទីនេះគឺជាប្រភេទ Signal Variant។ ដូច្នេះហើយ យើងហៅវិធីសាស្រ្ត "
"Signal.connect() មិនមែន Object.connect() ទេ។\n"
"\t# សូមមើលការពិភាក្សាខាងក្រោមសម្រាប់ទិដ្ឋភាពទូទៅកាន់តែស៊ីជម្រៅអំពី API។\n"
"\tbutton.button_down.connect(_on_button_down)\n"
"\n"
"\t# នេះសន្មត់ថាមាន class `Player` ដែលកំណត់ signal `hit`។\n"
"\tvar player = Player.new()\n"
"\t# យើងប្រើ Signal.connect() ម្តងទៀត ហើយយើងក៏ប្រើវិធីសាស្រ្ត Callable.bind() ផងដែរ\n"
"\t# ដែលបង្វិល Callable ថ្មីជាមួយនឹង parameter binds។\n"
"\tplayer.hit.connect(_on_player_hit.bind(\"sword\", 100))\n"
"\n"
"func _on_button_down():\n"
"\tprint(\"Button down!\")\n"
"\n"
"func _on_player_hit(weapon_type, damage):\n"
"\tprint(\"Hit with weapon %s for %d damage.\" % [weapon_type, damage])\n"
"[/gdscript]\n"
"[csharp]\n"
"public override void _Ready()\n"
"{\n"
"\tvar button = new Button();\n"
"\t// C# គាំទ្រការបញ្ជូន signals ជា events ដូច្នេះយើងអាចប្រើទម្រង់នេះ៖\n"
"\tbutton.ButtonDown += OnButtonDown;\n"
"\n"
"\t// នេះសន្មត់ថាមាន class `Player` ដែលកំណត់ signal `Hit`។\n"
"\tvar player = new Player();\n"
"\t// យើងអាចប្រើ lambdas នៅពេលដែលយើងត្រូវការភ្ជាប់ប៉ារ៉ាម៉ែត្របន្ថែម។\n"
"\tplayer.Hit += () => OnPlayerHit(\"sword\", 100);\n"
"}\n"
"\n"
"private void OnButtonDown()\n"
"{\n"
"\tGD.Print(\"Button down!\");\n"
"}\n"
"\n"
"private void OnPlayerHit(string weaponType, int damage)\n"
"{\n"
"\tGD.Print($\"Hit with weapon {weaponType} for {damage} damage.\");\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[code skip-lint]Object.connect()[/code] [b]ឬ[/b] [code skip-"
"lint]Signal.connect()[/code][b]?[/b]\n"
"ដូចដែលបានឃើញខាងលើ វិធីសាស្រ្តដែលបានណែនាំដើម្បីភ្ជាប់ signals មិនមែនជា [method "
"Object.connect] ទេ។ ប្លុកកូដខាងក្រោមបង្ហាញពីជម្រើសទាំងបួនសម្រាប់ការភ្ជាប់ signals "
"ដោយប្រើវិធីសាស្រ្តចាស់នេះ ឬ [method Signal.connect] ដែលបានណែនាំ ហើយប្រើ [Callable] "
"ដែលបង្កប់ដោយស្វ័យប្រវត្តិ ឬកំណត់ដោយដៃ។\n"
"[codeblocks]\n"
"[gdscript]\n"
"func _ready():\n"
"\tvar button = Button.new()\n"
"\t# ជម្រើស 1: Object.connect() ជាមួយនឹង Callable បង្កប់សម្រាប់អនុគមន៍ដែលបានកំណត់។\n"
"\tbutton.connect(\"button_down\", _on_button_down)\n"
"\t# ជម្រើស 2: Object.connect() ជាមួយនឹង Callable ដែលបានបង្កើតឡើងដោយប្រើ target "
"object និងឈ្មោះអនុគមន៍។\n"
"\tbutton.connect(\"button_down\", Callable(self, \"_on_button_down\"))\n"
"\t# ជម្រើស 3: Signal.connect() ជាមួយនឹង Callable បង្កប់សម្រាប់អនុគមន៍ដែលបានកំណត់។\n"
"\tbutton.button_down.connect(_on_button_down)\n"
"\t# ជម្រើស 4: Signal.connect() ជាមួយនឹង Callable ដែលបានបង្កើតឡើងដោយប្រើ target "
"object និងឈ្មោះអនុគមន៍។\n"
"\tbutton.button_down.connect(Callable(self, \"_on_button_down\"))\n"
"\n"
"func _on_button_down():\n"
"\tprint(\"Button down!\")\n"
"[/gdscript]\n"
"[csharp]\n"
"public override void _Ready()\n"
"{\n"
"\tvar button = new Button();\n"
"\t// ជម្រើស 1: នៅក្នុង C# យើងអាចប្រើ signals ជា events ហើយភ្ជាប់ជាមួយ syntax នេះ៖\n"
"\tbutton.ButtonDown += OnButtonDown;\n"
"\t// ជម្រើស 2: GodotObject.Connect() ជាមួយនឹង Callable ដែលបានបង្កើតឡើងពី method "
"group។\n"
"\tbutton.Connect(Button.SignalName.ButtonDown, Callable.From(OnButtonDown));\n"
"\t// ជម្រើស 3: GodotObject.Connect() ជាមួយនឹង Callable ដែលបានបង្កើតឡើងដោយប្រើ "
"target object និងឈ្មោះអនុគមន៍។\n"
"\tbutton.Connect(Button.SignalName.ButtonDown, new Callable(this, "
"MethodName.OnButtonDown));\n"
"}\n"
"\n"
"private void OnButtonDown()\n"
"{\n"
"\tGD.Print(\"Button down!\");\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]\n"
"ទោះបីជាជម្រើសទាំងអស់មានលទ្ធផលដូចគ្នា ([code]button[/code]'s [signal "
"BaseButton.button_down] signal នឹងត្រូវបានភ្ជាប់ទៅ [code]_on_button_down[/code]) "
"ក៏ដោយ [b]ជម្រើស 3[/b] ផ្តល់នូវការផ្ទៀងផ្ទាត់ល្អបំផុត៖ វានឹងបោះពុម្ពកំហុសពេល compile ប្រសិនបើ "
"[code]button_down[/code] [Signal] ឬ [code]_on_button_down[/code] [Callable] "
"មិនត្រូវបានកំណត់។ ម្យ៉ាងទៀត [b]ជម្រើស 2[/b] ពឹងផ្អែកតែលើឈ្មោះ string ប៉ុណ្ណោះ "
"ហើយនឹងអាចផ្ទៀងផ្ទាត់ឈ្មោះបានតែនៅពេល runtime ប៉ុណ្ណោះ៖ វានឹងបង្កកំហុសនៅពេល runtime ប្រសិនបើ "
"[code]\"button_down\"[/code] មិនមែនជា signal ឬប្រសិនបើ [code]"
"\"_on_button_down\"[/code] មិនមែនជាអនុគមន៍នៅក្នុង object [code]self[/code]។ "
"ហេតុផលចម្បងសម្រាប់ការប្រើជម្រើស 1, 2 ឬ 4 គឺនៅពេលដែលអ្នកពិតជាត្រូវការប្រើ strings (ឧ. "
"ដើម្បីភ្ជាប់ signals តាមរយៈកម្មវិធីដោយផ្អែកលើ strings ដែលបានអានពីឯកសារកំណត់រចនាសម្ព័ន្ធ)។ "
"បើមិនដូច្នេះទេ ជម្រើស 3 គឺជាវិធីសាស្រ្តដែលបានណែនាំ (និងលឿនបំផុត)។\n"
"[b]ការភ្ជាប់ និងបញ្ជូនប៉ារ៉ាម៉ែត្រ៖[/b]\n"
"Syntax សម្រាប់ភ្ជាប់ប៉ារ៉ាម៉ែត្រគឺតាមរយៈ [method Callable.bind] ដែលបង្វិលច្បាប់ចម្លងនៃ "
"[Callable] ជាមួយនឹងប៉ារ៉ាម៉ែត្រដែលបានភ្ជាប់របស់វា។\n"
"នៅពេលហៅ [method emit] ឬ [method Object.emit_signal] ប៉ារ៉ាម៉ែត្រ signal "
"ក៏អាចត្រូវបានបញ្ជូនផងដែរ។ ឧទាហរណ៍ខាងក្រោមបង្ហាញពីទំនាក់ទំនងរវាងប៉ារ៉ាម៉ែត្រ signal "
"និងប៉ារ៉ាម៉ែត្រដែលបានភ្ជាប់ទាំងនេះ។\n"
"[codeblocks]\n"
"[gdscript]\n"
"func _ready():\n"
"\t# នេះសន្មត់ថាមាន class `Player` ដែលកំណត់ signal `hit`។\n"
"\tvar player = Player.new()\n"
"\t# ប្រើ Callable.bind()។\n"
"\tplayer.hit.connect(_on_player_hit.bind(\"sword\", 100))\n"
"\n"
"\t# ប៉ារ៉ាម៉ែត្រដែលបានបន្ថែមនៅពេលបញ្ចេញ signal ត្រូវបានបញ្ជូនមុនគេ។\n"
"\tplayer.hit.emit(\"Dark lord\", 5)\n"
"\n"
"# យើងបញ្ជូនអាគុយម៉ង់ពីរនៅពេលបញ្ចេញ (`hit_by`, `level`)\n"
"# ហើយភ្ជាប់អាគុយម៉ង់ពីរទៀតនៅពេលភ្ជាប់ (`weapon_type`, `damage`)។\n"
"func _on_player_hit(hit_by, level, weapon_type, damage):\n"
"\tprint(\"Hit by %s (level %d) with weapon %s for %d damage.\" % [hit_by, "
"level, weapon_type, damage])\n"
"[/gdscript]\n"
"[csharp]\n"
"public override void _Ready()\n"
"{\n"
"\t// នេះសន្មត់ថាមាន class `Player` ដែលកំណត់ signal `Hit`។\n"
"\tvar player = new Player();\n"
"\t// ប្រើ lambda expressions ដែលបង្កើត closure ដែលចាប់យកប៉ារ៉ាម៉ែត្របន្ថែម។\n"
"\t// lambda ទទួលតែប៉ារ៉ាម៉ែត្រដែលបានកំណត់ដោយ delegate របស់ signal ប៉ុណ្ណោះ។\n"
"\tplayer.Hit += (hitBy, level) => OnPlayerHit(hitBy, level, \"sword\", 100);\n"
"\n"
"\t// ប៉ារ៉ាម៉ែត្រដែលបានបន្ថែមនៅពេលបញ្ចេញ signal ត្រូវបានបញ្ជូនមុនគេ។\n"
"\tplayer.EmitSignal(SignalName.Hit, \"Dark lord\", 5);\n"
"}\n"
"\n"
"// យើងបញ្ជូនអាគុយម៉ង់ពីរនៅពេលបញ្ចេញ (`hit_by`, `level`)\n"
"// ហើយភ្ជាប់អាគុយម៉ង់ពីរទៀតនៅពេលភ្ជាប់ (`weapon_type`, `damage`)។\n"
"private void OnPlayerHit(string hitBy, int level, string weaponType, int "
"damage)\n"
"{\n"
"\tGD.Print($\"Hit by {hitBy} (level {level}) with weapon {weaponType} for "
"{damage} damage.\");\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]ចំណាំ៖[/b] នៅក្នុងបរិបទ boolean, signal នឹងវាយតម្លៃទៅជា [code]false[/code] "
"ប្រសិនបើវាជា null (សូមមើល [method is_null])។ បើមិនដូច្នេះទេ signal នឹងវាយតម្លៃទៅជា "
"[code]true[/code] ជានិច្ច។"

msgid "Using Signals"
msgstr "ការប្រើប្រាស់ Signals"

msgid "GDScript Basics"
msgstr "មូលដ្ឋានគ្រឹះ GDScript"

msgid "Constructs an empty [Signal] with no object nor signal name bound."
msgstr "បង្កើត [Signal] ទទេដោយគ្មាន object ឬឈ្មោះ signal ដែលបានភ្ជាប់។"

msgid "Constructs a [Signal] as a copy of the given [Signal]."
msgstr "បង្កើត [Signal] ជាច្បាប់ចម្លងនៃ [Signal] ដែលបានផ្តល់ឱ្យ។"

msgid ""
"Creates a [Signal] object referencing a signal named [param signal] in the "
"specified [param object]."
msgstr ""
"បង្កើត object [Signal] ដែលយោងទៅ signal ឈ្មោះ [param signal] នៅក្នុង [param "
"object] ដែលបានបញ្ជាក់។"

msgid ""
"Emits this signal. All [Callable]s connected to this signal will be "
"triggered. This method supports a variable number of arguments, so parameters "
"can be passed as a comma separated list."
msgstr ""
"បញ្ចេញ signal នេះ។ [Callable]s ទាំងអស់ដែលបានភ្ជាប់ទៅ signal នេះនឹងត្រូវបានដំណើរការ "
"(triggered)។ វិធីសាស្រ្តនេះគាំទ្រចំនួនអាគុយម៉ង់ដែលអាចប្រែប្រួលបាន "
"ដូច្នេះប៉ារ៉ាម៉ែត្រអាចត្រូវបានបញ្ជូនជាបញ្ជីដែលបំបែកដោយសញ្ញាក្បៀស។"

msgid ""
"Returns an [Array] of connections for this signal. Each connection is "
"represented as a [Dictionary] that contains three entries:\n"
"- [code]signal[/code] is a reference to this signal;\n"
"- [code]callable[/code] is a reference to the connected [Callable];\n"
"- [code]flags[/code] is a combination of [enum Object.ConnectFlags]."
msgstr ""
"បង្វិល [Array] នៃការភ្ជាប់សម្រាប់ signal នេះ។ ការភ្ជាប់នីមួយៗត្រូវបានតំណាងជា [Dictionary] "
"ដែលមានបីធាតុ៖\n"
"- [code]signal[/code] គឺជាការយោងទៅ signal នេះ;\n"
"- [code]callable[/code] គឺជាការយោងទៅ [Callable] ដែលបានភ្ជាប់;\n"
"- [code]flags[/code] គឺជាការផ្សំបញ្ចូលគ្នានៃ [enum Object.ConnectFlags]។"

msgid "Returns the name of this signal."
msgstr "បង្វិលឈ្មោះនៃ signal នេះ។"

msgid "Returns the object emitting this signal."
msgstr "បង្វិល object ដែលកំពុងបញ្ចេញ signal នេះ។"

msgid ""
"Returns the ID of the object emitting this signal (see [method "
"Object.get_instance_id])."
msgstr ""
"បង្វិល ID នៃ object ដែលកំពុងបញ្ចេញ signal នេះ (សូមមើល [method "
"Object.get_instance_id])។"

msgid "Returns [code]true[/code] if any [Callable] is connected to this signal."
msgstr "បង្វិល [code]true[/code] ប្រសិនបើ [Callable] ណាមួយត្រូវបានភ្ជាប់ទៅ signal នេះ។"

msgid ""
"Returns [code]true[/code] if the specified [Callable] is connected to this "
"signal."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ [Callable] ដែលបានបញ្ជាក់ត្រូវបានភ្ជាប់ទៅ signal នេះ។"

msgid ""
"Returns [code]true[/code] if this [Signal] has no object and the signal name "
"is empty. Equivalent to [code]signal == Signal()[/code]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ [Signal] នេះគ្មាន object ហើយឈ្មោះ signal គឺទទេ។ "
"ស្មើនឹង [code]signal == Signal()[/code]។"

msgid ""
"Returns [code]true[/code] if the signals do not share the same object and "
"name."
msgstr "បង្វិល [code]true[/code] ប្រសិនបើ signals មិនចែករំលែក object និងឈ្មោះដូចគ្នា។"

msgid ""
"Returns [code]true[/code] if both signals share the same object and name."
msgstr "បង្វិល [code]true[/code] ប្រសិនបើ signals ទាំងពីរចែករំលែក object និងឈ្មោះដូចគ្នា។"

msgid ""
"The parent of a hierarchy of [Bone2D]s, used to create a 2D skeletal "
"animation."
msgstr ""
"មេ (parent) នៃឋានានុក្រមនៃ [Bone2D]s ដែលប្រើសម្រាប់បង្កើតចលនាឆ្អឹង 2D (2D skeletal "
"animation)។"

msgid ""
"[Skeleton2D] parents a hierarchy of [Bone2D] nodes. It holds a reference to "
"each [Bone2D]'s rest pose and acts as a single point of access to its bones.\n"
"To set up different types of inverse kinematics for the given Skeleton2D, a "
"[SkeletonModificationStack2D] should be created. The inverse kinematics be "
"applied by increasing [member SkeletonModificationStack2D.modification_count] "
"and creating the desired number of modifications."
msgstr ""
"[Skeleton2D] គឺជាមេនៃឋានានុក្រមនៃ node [Bone2D]។ វាទុកការយោងទៅលើ rest pose របស់ "
"[Bone2D] នីមួយៗ ហើយដើរតួជាចំណុចចូលប្រើប្រាស់តែមួយទៅកាន់ឆ្អឹងរបស់វា។\n"
"ដើម្បីរៀបចំប្រភេទផ្សេងៗនៃ inverse kinematics សម្រាប់ Skeleton2D ដែលបានផ្តល់ឱ្យ "
"[SkeletonModificationStack2D] គួរតែត្រូវបានបង្កើតឡើង។ Inverse kinematics "
"អាចត្រូវបានអនុវត្តដោយបង្កើន [member "
"SkeletonModificationStack2D.modification_count] និងបង្កើតចំនួន modifications "
"តាមដែលចង់បាន។"

msgid "2D skeletons"
msgstr "ឆ្អឹង 2D (2D skeletons)"

msgid ""
"Executes all the modifications on the [SkeletonModificationStack2D], if the "
"Skeleton2D has one assigned."
msgstr ""
"ដំណើរការ modifications ទាំងអស់នៅលើ [SkeletonModificationStack2D] ប្រសិនបើ "
"Skeleton2D មានមួយដែលបានកំណត់។"

msgid ""
"Returns a [Bone2D] from the node hierarchy parented by Skeleton2D. The object "
"to return is identified by the parameter [param idx]. Bones are indexed by "
"descending the node hierarchy from top to bottom, adding the children of each "
"branch before moving to the next sibling."
msgstr ""
"បង្វិល [Bone2D] ពីឋានានុក្រម node ដែលមាន Skeleton2D ជាមេ។ Object "
"ដែលត្រូវបង្វិលត្រូវបានកំណត់ដោយប៉ារ៉ាម៉ែត្រ [param idx]។ ឆ្អឹងត្រូវបានធ្វើលិបិក្រមដោយចុះពីឋានានុក្រម "
"node ពីលើចុះក្រោម ដោយបន្ថែមកូន (children) នៃសាខានីមួយៗមុននឹងផ្លាស់ទីទៅ sibling បន្ទាប់។"

msgid ""
"Returns the number of [Bone2D] nodes in the node hierarchy parented by "
"Skeleton2D."
msgstr "បង្វិលចំនួន node [Bone2D] នៅក្នុងឋានានុក្រម node ដែលមាន Skeleton2D ជាមេ។"

msgid "Returns the local pose override transform for [param bone_idx]."
msgstr "បង្វិល local pose override transform សម្រាប់ [param bone_idx]។"

msgid ""
"Returns the [SkeletonModificationStack2D] attached to this skeleton, if one "
"exists."
msgstr "បង្វិល [SkeletonModificationStack2D] ដែលបានភ្ជាប់ទៅ skeleton នេះ ប្រសិនបើមាន។"

msgid "Returns the [RID] of a Skeleton2D instance."
msgstr "បង្វិល [RID] នៃ instance Skeleton2D។"

msgid ""
"Sets the local pose transform, [param override_pose], for the bone at [param "
"bone_idx].\n"
"[param strength] is the interpolation strength that will be used when "
"applying the pose, and [param persistent] determines if the applied pose will "
"remain.\n"
"[b]Note:[/b] The pose transform needs to be a local transform relative to the "
"[Bone2D] node at [param bone_idx]!"
msgstr ""
"កំណត់ local pose transform, [param override_pose], សម្រាប់ឆ្អឹងនៅ [param "
"bone_idx]។\n"
"[param strength] គឺជាកម្លាំង interpolation ដែលនឹងត្រូវបានប្រើនៅពេលអនុវត្ត pose ហើយ "
"[param persistent] កំណត់ថាតើ pose ដែលបានអនុវត្តនឹងនៅជាប់ដែរឬទេ។\n"
"[b]ចំណាំ៖[/b] pose transform ត្រូវតែជា local transform ធៀបនឹង node [Bone2D] នៅ "
"[param bone_idx]!"

msgid "Sets the [SkeletonModificationStack2D] attached to this skeleton."
msgstr "កំណត់ [SkeletonModificationStack2D] ដែលបានភ្ជាប់ទៅ skeleton នេះ។"

msgid ""
"Emitted when the [Bone2D] setup attached to this skeletons changes. This is "
"primarily used internally within the skeleton."
msgstr ""
"បញ្ចេញនៅពេលដែលការរៀបចំ [Bone2D] ដែលបានភ្ជាប់ទៅ skeletons នេះផ្លាស់ប្តូរ។ "
"នេះត្រូវបានប្រើជាចម្បងនៅខាងក្នុង skeleton ផ្ទាល់។"

msgid ""
"A node containing a bone hierarchy, used to create a 3D skeletal animation."
msgstr ""
"ថ្នាំង (Node) ដែលផ្ទុកឋានានុក្រមឆ្អឹង ប្រើសម្រាប់បង្កើតចលនាឆ្អឹង 3D (3D skeletal animation)។"

msgid ""
"[Skeleton3D] provides an interface for managing a hierarchy of bones, "
"including pose, rest and animation (see [Animation]). It can also use ragdoll "
"physics.\n"
"The overall transform of a bone with respect to the skeleton is determined by "
"bone pose. Bone rest defines the initial transform of the bone pose.\n"
"Note that \"global pose\" below refers to the overall transform of the bone "
"with respect to skeleton, so it is not the actual global/world transform of "
"the bone."
msgstr ""
"[Skeleton3D] ផ្តល់នូវចំណុចប្រទាក់សម្រាប់គ្រប់គ្រងឋានានុក្រមនៃឆ្អឹង រួមទាំង pose, rest និង "
"animation (សូមមើល [Animation])។ វាក៏អាចប្រើ ragdoll physics ផងដែរ។\n"
"Transform សរុបនៃឆ្អឹងធៀបនឹង skeleton ត្រូវបានកំណត់ដោយ bone pose។ Bone rest កំណត់ "
"transform ដំបូងនៃ bone pose។\n"
"ចំណាំថា \"global pose\" នៅខាងក្រោមសំដៅលើ transform សរុបនៃឆ្អឹងធៀបនឹង skeleton "
"ដូច្នេះវាមិនមែនជា global/world transform ជាក់ស្តែងរបស់ឆ្អឹងនោះទេ។"

msgid ""
"Adds a new bone with the given name. Returns the new bone's index, or "
"[code]-1[/code] if this method fails.\n"
"[b]Note:[/b] Bone names should be unique, non empty, and cannot include the "
"[code]:[/code] and [code]/[/code] characters."
msgstr ""
"បន្ថែមឆ្អឹងថ្មីជាមួយនឹងឈ្មោះដែលបានផ្តល់ឱ្យ។ បង្វិលលិបិក្រមរបស់ឆ្អឹងថ្មី ឬ [code]-1[/code] "
"ប្រសិនបើវិធីសាស្រ្តនេះបរាជ័យ។\n"
"[b]ចំណាំ៖[/b] ឈ្មោះឆ្អឹងគួរតែមានលក្ខណៈពិសេស (unique) មិនទទេ និងមិនអាចមានតួអក្សរ [code]:[/"
"code] និង [code]/[/code] ឡើយ។"

msgid ""
"Manually advance the child [SkeletonModifier3D]s by the specified time (in "
"seconds).\n"
"[b]Note:[/b] The [param delta] is temporarily accumulated in the "
"[Skeleton3D], and the deferred process uses the accumulated value to process "
"the modification."
msgstr ""
"រុញច្រាន (advance) [SkeletonModifier3D]s កូនដោយដៃ តាមរយៈពេលវេលាដែលបានបញ្ជាក់ "
"(គិតជាវិនាទី)។\n"
"[b]ចំណាំ៖[/b] [param delta] ត្រូវបានប្រមូលផ្តុំជាបណ្តោះអាសន្ននៅក្នុង [Skeleton3D] "
"ហើយដំណើរការ deferred ប្រើតម្លៃដែលបានប្រមូលផ្តុំដើម្បីដំណើរការ modification។"

msgid "Clear all the bones in this skeleton."
msgstr "សម្អាតឆ្អឹងទាំងអស់នៅក្នុង skeleton នេះ។"

msgid "Removes the global pose override on all bones in the skeleton."
msgstr "លុប global pose override ចេញពីឆ្អឹងទាំងអស់នៅក្នុង skeleton។"

msgid ""
"Returns the bone index that matches [param name] as its name. Returns "
"[code]-1[/code] if no bone with this name exists."
msgstr ""
"បង្វិលលិបិក្រមឆ្អឹងដែលត្រូវនឹង [param name] ជាឈ្មោះរបស់វា។ បង្វិល [code]-1[/code] "
"ប្រសិនបើគ្មានឆ្អឹងដែលមានឈ្មោះនេះទេ។"

msgid "Force updates the bone transforms/poses for all bones in the skeleton."
msgstr "បង្ខំឱ្យធ្វើបច្ចុប្បន្នភាព bone transforms/poses សម្រាប់ឆ្អឹងទាំងអស់នៅក្នុង skeleton។"

msgid ""
"Force updates the bone transform for the bone at [param bone_idx] and all of "
"its children."
msgstr ""
"បង្ខំឱ្យធ្វើបច្ចុប្បន្នភាព bone transform សម្រាប់ឆ្អឹងនៅ [param bone_idx] និងកូនៗរបស់វាទាំងអស់។"

msgid ""
"Returns an array containing the bone indexes of all the child node of the "
"passed in bone, [param bone_idx]."
msgstr ""
"បង្វិលអារេដែលផ្ទុកលិបិក្រមឆ្អឹងនៃ child node ទាំងអស់នៃឆ្អឹងដែលបានបញ្ជូនចូល [param bone_idx]។"

msgid "Returns the number of bones in the skeleton."
msgstr "បង្វិលចំនួនឆ្អឹងនៅក្នុង skeleton។"

msgid ""
"Returns the overall transform of the specified bone, with respect to the "
"skeleton. Being relative to the skeleton frame, this is not the actual "
"\"global\" transform of the bone.\n"
"[b]Note:[/b] This is the global pose you set to the skeleton in the process, "
"the final global pose can get overridden by modifiers in the deferred "
"process, if you want to access the final global pose, use [signal "
"SkeletonModifier3D.modification_processed]."
msgstr ""
"បង្វិល transform សរុបនៃឆ្អឹងដែលបានបញ្ជាក់ ធៀបនឹង skeleton។ ដោយសារវាធៀបនឹង skeleton "
"frame នេះមិនមែនជា \"global\" transform ជាក់ស្តែងរបស់ឆ្អឹងនោះទេ។\n"
"[b]ចំណាំ៖[/b] នេះគឺជា global pose ដែលអ្នកបានកំណត់ទៅ skeleton នៅក្នុង process, final "
"global pose អាចត្រូវបាន override ដោយ modifiers នៅក្នុង deferred process "
"ប្រសិនបើអ្នកចង់ចូលប្រើ final global pose សូមប្រើ [signal "
"SkeletonModifier3D.modification_processed]។"

msgid ""
"Returns the overall transform of the specified bone, with respect to the "
"skeleton, but without any global pose overrides. Being relative to the "
"skeleton frame, this is not the actual \"global\" transform of the bone."
msgstr ""
"បង្វិល transform សរុបនៃឆ្អឹងដែលបានបញ្ជាក់ ធៀបនឹង skeleton ប៉ុន្តែដោយគ្មាន global pose "
"overrides ណាមួយឡើយ។ ដោយសារវាធៀបនឹង skeleton frame នេះមិនមែនជា \"global\" "
"transform ជាក់ស្តែងរបស់ឆ្អឹងនោះទេ។"

msgid "Returns the global pose override transform for [param bone_idx]."
msgstr "បង្វិល global pose override transform សម្រាប់ [param bone_idx]។"

msgid "Returns the global rest transform for [param bone_idx]."
msgstr "បង្វិល global rest transform សម្រាប់ [param bone_idx]។"

msgid ""
"Returns the metadata with the given [param key] for the bone at index [param "
"bone_idx]."
msgstr ""
"បង្វិល metadata ជាមួយនឹង [param key] ដែលបានផ្តល់ឱ្យ សម្រាប់ឆ្អឹងនៅលិបិក្រម [param bone_idx]។"

msgid ""
"Returns the list of all metadata keys for the bone at index [param bone_idx]."
msgstr "បង្វិលបញ្ជីនៃ metadata keys ទាំងអស់សម្រាប់ឆ្អឹងនៅលិបិក្រម [param bone_idx]។"

msgid "Returns the name of the bone at index [param bone_idx]."
msgstr "បង្វិលឈ្មោះនៃឆ្អឹងនៅលិបិក្រម [param bone_idx]។"

msgid ""
"Returns the bone index which is the parent of the bone at [param bone_idx]. "
"If -1, then bone has no parent.\n"
"[b]Note:[/b] The parent bone returned will always be less than [param "
"bone_idx]."
msgstr ""
"បង្វិលលិបិក្រមឆ្អឹងដែលជាមេនៃឆ្អឹងនៅ [param bone_idx]។ ប្រសិនបើ -1 នោះឆ្អឹងគ្មានមេទេ។\n"
"[b]ចំណាំ៖[/b] ឆ្អឹងមេដែលបានបង្វិលនឹងតែងតែតូចជាង [param bone_idx]។"

msgid ""
"Returns the pose transform of the specified bone.\n"
"[b]Note:[/b] This is the pose you set to the skeleton in the process, the "
"final pose can get overridden by modifiers in the deferred process, if you "
"want to access the final pose, use [signal "
"SkeletonModifier3D.modification_processed]."
msgstr ""
"បង្វិល pose transform នៃឆ្អឹងដែលបានបញ្ជាក់។\n"
"[b]ចំណាំ៖[/b] នេះគឺជា pose ដែលអ្នកបានកំណត់ទៅ skeleton នៅក្នុង process, final pose "
"អាចត្រូវបាន override ដោយ modifiers នៅក្នុង deferred process ប្រសិនបើអ្នកចង់ចូលប្រើ "
"final pose សូមប្រើ [signal SkeletonModifier3D.modification_processed]។"

msgid ""
"Returns the pose position of the bone at [param bone_idx]. The returned "
"[Vector3] is in the local coordinate space of the [Skeleton3D] node."
msgstr ""
"បង្វិល pose position នៃឆ្អឹងនៅ [param bone_idx]។ [Vector3] ដែលបានបង្វិលគឺស្ថិតនៅក្នុង "
"local coordinate space នៃ node [Skeleton3D]។"

msgid ""
"Returns the pose rotation of the bone at [param bone_idx]. The returned "
"[Quaternion] is local to the bone with respect to the rotation of any parent "
"bones."
msgstr ""
"បង្វិល pose rotation នៃឆ្អឹងនៅ [param bone_idx]។ [Quaternion] ដែលបានបង្វិលគឺ local "
"ទៅកាន់ឆ្អឹង ធៀបនឹង rotation នៃឆ្អឹងមេណាមួយ។"

msgid "Returns the pose scale of the bone at [param bone_idx]."
msgstr "បង្វិល pose scale នៃឆ្អឹងនៅ [param bone_idx]។"

msgid "Returns the rest transform for a bone [param bone_idx]."
msgstr "បង្វិល rest transform សម្រាប់ឆ្អឹង [param bone_idx]។"

msgid ""
"Returns all bone names concatenated with commas ([code],[/code]) as a single "
"[StringName].\n"
"It is useful to set it as a hint for the enum property."
msgstr ""
"បង្វិលឈ្មោះឆ្អឹងទាំងអស់ដែលបានភ្ជាប់គ្នាដោយសញ្ញាក្បៀស ([code],[/code]) ជា [StringName] "
"តែមួយ។\n"
"វាមានប្រយោជន៍ក្នុងការកំណត់វាជា hint សម្រាប់ enum property។"

msgid ""
"Returns an array with all of the bones that are parentless. Another way to "
"look at this is that it returns the indexes of all the bones that are not "
"dependent or modified by other bones in the Skeleton."
msgstr ""
"បង្វិលអារេជាមួយនឹងឆ្អឹងទាំងអស់ដែលគ្មានមេ។ វិធីមួយទៀតដើម្បីមើលរឿងនេះគឺថា "
"វាបង្វិលលិបិក្រមនៃឆ្អឹងទាំងអស់ដែលមិនអាស្រ័យ ឬកែប្រែដោយឆ្អឹងផ្សេងទៀតនៅក្នុង Skeleton។"

msgid ""
"Returns the number of times the bone hierarchy has changed within this "
"skeleton, including renames.\n"
"The Skeleton version is not serialized: only use within a single instance of "
"Skeleton3D.\n"
"Use for invalidating caches in IK solvers and other nodes which process bones."
msgstr ""
"បង្វិលចំនួនដងដែលឋានានុក្រមឆ្អឹងបានផ្លាស់ប្តូរនៅក្នុង skeleton នេះ រួមទាំងការប្តូរឈ្មោះ "
"(renames)។\n"
"Skeleton version មិនត្រូវបាន serialized ទេ៖ ប្រើតែនៅក្នុង instance តែមួយនៃ "
"Skeleton3D ប៉ុណ្ណោះ។\n"
"ប្រើសម្រាប់ការធ្វើឱ្យ caches មិនសុពលភាព (invalidating) នៅក្នុង IK solvers និង node "
"ផ្សេងទៀតដែលដំណើរការឆ្អឹង។"

msgid ""
"Returns [code]true[/code] if the bone at index [param bone_idx] has metadata "
"with the given [param key]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើឆ្អឹងនៅលិបិក្រម [param bone_idx] មាន metadata ជាមួយនឹង "
"[param key] ដែលបានផ្តល់ឱ្យ។"

msgid ""
"Returns whether the bone pose for the bone at [param bone_idx] is enabled."
msgstr "បង្វិលថាតើ bone pose សម្រាប់ឆ្អឹងនៅ [param bone_idx] ត្រូវបានបើកឬអត់។"

msgid "Returns all bones in the skeleton to their rest poses."
msgstr "ត្រឡប់ឆ្អឹងទាំងអស់នៅក្នុង skeleton ទៅកាន់ rest poses របស់ពួកវា។"

msgid "Binds the given Skin to the Skeleton."
msgstr "ភ្ជាប់ (Binds) Skin ដែលបានផ្តល់ឱ្យទៅកាន់ Skeleton។"

msgid "Sets the bone pose to rest for [param bone_idx]."
msgstr "កំណត់ bone pose ទៅជា rest សម្រាប់ [param bone_idx]។"

msgid "Sets all bone poses to rests."
msgstr "កំណត់ bone poses ទាំងអស់ទៅជា rests។"

msgid ""
"Disables the pose for the bone at [param bone_idx] if [code]false[/code], "
"enables the bone pose if [code]true[/code]."
msgstr ""
"បិទ pose សម្រាប់ឆ្អឹងនៅ [param bone_idx] ប្រសិនបើ [code]false[/code] បើក bone pose "
"ប្រសិនបើ [code]true[/code]។"

msgid ""
"Sets the global pose transform, [param pose], for the bone at [param "
"bone_idx].\n"
"[b]Note:[/b] If other bone poses have been changed, this method executes a "
"dirty poses recalculation and will cause performance to deteriorate. If you "
"know that multiple global poses will be applied, consider using [method "
"set_bone_pose] with precalculation."
msgstr ""
"កំណត់ global pose transform, [param pose], សម្រាប់ឆ្អឹងនៅ [param bone_idx]។\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើ bone poses ផ្សេងទៀតត្រូវបានផ្លាស់ប្តូរ វិធីសាស្រ្តនេះនឹងដំណើរការ dirty "
"poses recalculation ហើយនឹងធ្វើឱ្យ performance ធ្លាក់ចុះ។ ប្រសិនបើអ្នកដឹងថា global poses "
"ជាច្រើននឹងត្រូវបានអនុវត្ត សូមពិចារណាប្រើ [method set_bone_pose] ជាមួយនឹង precalculation។"

msgid ""
"Sets the global pose transform, [param pose], for the bone at [param "
"bone_idx].\n"
"[param amount] is the interpolation strength that will be used when applying "
"the pose, and [param persistent] determines if the applied pose will remain.\n"
"[b]Note:[/b] The pose transform needs to be a global pose! To convert a world "
"transform from a [Node3D] to a global bone pose, multiply the [method "
"Transform3D.affine_inverse] of the node's [member Node3D.global_transform] by "
"the desired world transform."
msgstr ""
"កំណត់ global pose transform, [param pose], សម្រាប់ឆ្អឹងនៅ [param bone_idx]។\n"
"[param amount] គឺជាកម្លាំង interpolation ដែលនឹងត្រូវបានប្រើនៅពេលអនុវត្ត pose ហើយ "
"[param persistent] កំណត់ថាតើ pose ដែលបានអនុវត្តនឹងនៅជាប់ដែរឬទេ។\n"
"[b]ចំណាំ៖[/b] pose transform ត្រូវតែជា global pose! ដើម្បីបម្លែង world transform ពី "
"[Node3D] ទៅជា global bone pose សូមគុណ [method Transform3D.affine_inverse] នៃ "
"[member Node3D.global_transform] របស់ node ជាមួយនឹង world transform ដែលចង់បាន។"

msgid ""
"Sets the metadata with the given [param key] to [param value] for the bone at "
"index [param bone_idx]."
msgstr ""
"កំណត់ metadata ជាមួយនឹង [param key] ដែលបានផ្តល់ឱ្យ ទៅជា [param value] "
"សម្រាប់ឆ្អឹងនៅលិបិក្រម [param bone_idx]។"

msgid "Sets the bone name, [param name], for the bone at [param bone_idx]."
msgstr "កំណត់ឈ្មោះឆ្អឹង, [param name], សម្រាប់ឆ្អឹងនៅ [param bone_idx]។"

msgid ""
"Sets the bone index [param parent_idx] as the parent of the bone at [param "
"bone_idx]. If -1, then bone has no parent.\n"
"[b]Note:[/b] [param parent_idx] must be less than [param bone_idx]."
msgstr ""
"កំណត់លិបិក្រមឆ្អឹង [param parent_idx] ជាមេនៃឆ្អឹងនៅ [param bone_idx]។ ប្រសិនបើ -1 "
"នោះឆ្អឹងគ្មានមេទេ។\n"
"[b]ចំណាំ៖[/b] [param parent_idx] ត្រូវតែតូចជាង [param bone_idx]។"

msgid "Sets the pose transform, [param pose], for the bone at [param bone_idx]."
msgstr "កំណត់ pose transform, [param pose], សម្រាប់ឆ្អឹងនៅ [param bone_idx]។"

msgid ""
"Sets the pose position of the bone at [param bone_idx] to [param position]. "
"[param position] is a [Vector3] describing a position local to the "
"[Skeleton3D] node."
msgstr ""
"កំណត់ pose position នៃឆ្អឹងនៅ [param bone_idx] ទៅជា [param position]។ [param "
"position] គឺជា [Vector3] ដែលពណ៌នាអំពី position local ទៅកាន់ node [Skeleton3D]។"

msgid ""
"Sets the pose rotation of the bone at [param bone_idx] to [param rotation]. "
"[param rotation] is a [Quaternion] describing a rotation in the bone's local "
"coordinate space with respect to the rotation of any parent bones."
msgstr ""
"កំណត់ pose rotation នៃឆ្អឹងនៅ [param bone_idx] ទៅជា [param rotation]។ [param "
"rotation] គឺជា [Quaternion] ដែលពណ៌នាអំពី rotation នៅក្នុង local coordinate space "
"របស់ឆ្អឹង ធៀបនឹង rotation នៃឆ្អឹងមេណាមួយ។"

msgid "Sets the pose scale of the bone at [param bone_idx] to [param scale]."
msgstr "កំណត់ pose scale នៃឆ្អឹងនៅ [param bone_idx] ទៅជា [param scale]។"

msgid "Sets the rest transform for bone [param bone_idx]."
msgstr "កំណត់ rest transform សម្រាប់ឆ្អឹង [param bone_idx]។"

msgid ""
"Unparents the bone at [param bone_idx] and sets its rest position to that of "
"its parent prior to being reset."
msgstr ""
"ផ្តាច់ឆ្អឹងនៅ [param bone_idx] ចេញពីមេ (Unparents) ហើយកំណត់ rest position របស់វាទៅជា "
"rest position របស់មេវា មុនពេលកំណត់ឡើងវិញ។"

msgid ""
"If you follow the recommended workflow and explicitly have "
"[PhysicalBoneSimulator3D] as a child of [Skeleton3D], you can control whether "
"it is affected by raycasting without running [method "
"physical_bones_start_simulation], by its [member SkeletonModifier3D.active].\n"
"However, for old (deprecated) configurations, [Skeleton3D] has an internal "
"virtual [PhysicalBoneSimulator3D] for compatibility. This property controls "
"the internal virtual [PhysicalBoneSimulator3D]'s [member "
"SkeletonModifier3D.active]."
msgstr ""
"ប្រសិនបើអ្នកអនុវត្តតាម workflow ដែលបានណែនាំ ហើយមាន [PhysicalBoneSimulator3D] "
"ជាកូនរបស់ [Skeleton3D] យ៉ាងច្បាស់លាស់ អ្នកអាចគ្រប់គ្រងថាតើវាត្រូវបានប៉ះពាល់ដោយ raycasting "
"ដោយមិនចាំបាច់ដំណើរការ [method physical_bones_start_simulation] តាមរយៈ [member "
"SkeletonModifier3D.active] របស់វា។\n"
"ទោះជាយ៉ាងណាក៏ដោយ សម្រាប់ការកំណត់រចនាសម្ព័ន្ធចាស់ៗ (deprecated) [Skeleton3D] មាន "
"[PhysicalBoneSimulator3D] virtual ខាងក្នុងសម្រាប់ភាពឆបគ្នា។ Property នេះគ្រប់គ្រង "
"[member SkeletonModifier3D.active] របស់ [PhysicalBoneSimulator3D] virtual "
"ខាងក្នុង។"

msgid "Sets the processing timing for the Modifier."
msgstr "កំណត់ពេលវេលាដំណើរការ (processing timing) សម្រាប់ Modifier។"

msgid ""
"Multiplies the 3D position track animation.\n"
"[b]Note:[/b] Unless this value is [code]1.0[/code], the key value in "
"animation will not match the actual position value."
msgstr ""
"គុណនឹង 3D position track animation។\n"
"[b]ចំណាំ៖[/b] លុះត្រាតែតម្លៃនេះគឺ [code]1.0[/code] ទើបតម្លៃ key នៅក្នុង animation "
"នឹងមិនត្រូវនឹងតម្លៃ position ជាក់ស្តែងឡើយ។"

msgid ""
"If [code]true[/code], forces the bones in their default rest pose, regardless "
"of their values. In the editor, this also prevents the bones from being "
"edited."
msgstr ""
"ប្រសិនបើ [code]true[/code] បង្ខំឆ្អឹងឱ្យស្ថិតក្នុង default rest pose របស់ពួកវា "
"ដោយមិនគិតពីតម្លៃរបស់ពួកវា។ នៅក្នុងកម្មវិធីនិពន្ធ (editor) "
"នេះក៏រារាំងឆ្អឹងមិនឱ្យត្រូវបានកែសម្រួលផងដែរ។"

msgid ""
"Emitted when the bone at [param bone_idx] is toggled with [method "
"set_bone_enabled]. Use [method is_bone_enabled] to check the new value."
msgstr ""
"បញ្ចេញនៅពេលដែលឆ្អឹងនៅ [param bone_idx] ត្រូវបានបិទ/បើក (toggled) ជាមួយ [method "
"set_bone_enabled]។ ប្រើ [method is_bone_enabled] ដើម្បីពិនិត្យមើលតម្លៃថ្មី។"

msgid ""
"Emitted when the list of bones changes, such as when calling [method "
"add_bone], [method set_bone_parent], [method unparent_bone_and_rest], or "
"[method clear_bones]."
msgstr ""
"បញ្ចេញនៅពេលដែលបញ្ជីឆ្អឹងផ្លាស់ប្តូរ ដូចជានៅពេលហៅ [method add_bone], [method "
"set_bone_parent], [method unparent_bone_and_rest] ឬ [method clear_bones]។"

msgid ""
"Emitted when the pose is updated.\n"
"[b]Note:[/b] During the update process, this signal is not fired, so "
"modification by [SkeletonModifier3D] is not detected."
msgstr ""
"បញ្ចេញនៅពេលដែល pose ត្រូវបានធ្វើបច្ចុប្បន្នភាព។\n"
"[b]ចំណាំ៖[/b] ក្នុងអំឡុងពេលដំណើរការ update, signal នេះមិនត្រូវបានបាញ់ចេញទេ ដូច្នេះ "
"modification ដោយ [SkeletonModifier3D] មិនត្រូវបានរកឃើញទេ។"

msgid "Emitted when the rest is updated."
msgstr "បញ្ចេញនៅពេលដែល rest ត្រូវបានធ្វើបច្ចុប្បន្នភាព។"

msgid "Emitted when the value of [member show_rest_only] changes."
msgstr "បញ្ចេញនៅពេលដែលតម្លៃនៃ [member show_rest_only] ផ្លាស់ប្តូរ។"

msgid ""
"Emitted when the final pose has been calculated will be applied to the skin "
"in the update process.\n"
"This means that all [SkeletonModifier3D] processing is complete. In order to "
"detect the completion of the processing of each [SkeletonModifier3D], use "
"[signal SkeletonModifier3D.modification_processed]."
msgstr ""
"បញ្ចេញនៅពេលដែល final pose ដែលបានគណនា នឹងត្រូវបានអនុវត្តទៅលើ skin នៅក្នុងដំណើរការ "
"update។\n"
"នេះមានន័យថាការដំណើរការ [SkeletonModifier3D] ទាំងអស់បានបញ្ចប់។ "
"ដើម្បីរកឃើញការបញ្ចប់នៃការដំណើរការនៃ [SkeletonModifier3D] នីមួយៗ សូមប្រើ [signal "
"SkeletonModifier3D.modification_processed]។"

msgid ""
"Notification received when this skeleton's pose needs to be updated. In that "
"case, this is called only once per frame in a deferred process."
msgstr ""
"សេចក្តីជូនដំណឹង (Notification) ដែលទទួលបាននៅពេលដែល pose របស់ skeleton "
"នេះត្រូវការធ្វើបច្ចុប្បន្នភាព។ ក្នុងករណីនោះ វាត្រូវបានហៅតែម្តងគត់ក្នុងមួយ frame នៅក្នុង deferred "
"process។"

msgid ""
"Set a flag to process modification during physics frames (see [constant "
"Node.NOTIFICATION_INTERNAL_PHYSICS_PROCESS])."
msgstr ""
"កំណត់ flag ដើម្បីដំណើរការ modification ក្នុងអំឡុង physics frames (សូមមើល [constant "
"Node.NOTIFICATION_INTERNAL_PHYSICS_PROCESS])។"

msgid ""
"Set a flag to process modification during process frames (see [constant "
"Node.NOTIFICATION_INTERNAL_PROCESS])."
msgstr ""
"កំណត់ flag ដើម្បីដំណើរការ modification ក្នុងអំឡុង process frames (សូមមើល [constant "
"Node.NOTIFICATION_INTERNAL_PROCESS])។"

msgid ""
"Do not process modification. Use [method advance] to process the modification "
"manually."
msgstr ""
"កុំដំណើរការ modification។ ប្រើ [method advance] ដើម្បីដំណើរការ modification ដោយដៃ។"

msgid ""
"A node used to rotate all bones of a [Skeleton3D] bone chain a way that "
"places the end bone at a desired 3D position."
msgstr ""
"Node ដែលប្រើដើម្បីបង្វិលឆ្អឹងទាំងអស់នៃ [Skeleton3D] bone chain "
"តាមរបៀបដែលដាក់ឆ្អឹងចុងក្រោយនៅទីតាំង 3D ដែលចង់បាន។"

msgid ""
"SkeletonIK3D is used to rotate all bones of a [Skeleton3D] bone chain a way "
"that places the end bone at a desired 3D position. A typical scenario for IK "
"in games is to place a character's feet on the ground or a character's hands "
"on a currently held object. SkeletonIK uses FabrikInverseKinematic internally "
"to solve the bone chain and applies the results to the [Skeleton3D] "
"[code]bones_global_pose_override[/code] property for all affected bones in "
"the chain. If fully applied, this overwrites any bone transform from "
"[Animation]s or bone custom poses set by users. The applied amount can be "
"controlled with the [member SkeletonModifier3D.influence] property.\n"
"[codeblock]\n"
"# Apply IK effect automatically on every new frame (not the current)\n"
"skeleton_ik_node.start()\n"
"\n"
"# Apply IK effect only on the current frame\n"
"skeleton_ik_node.start(true)\n"
"\n"
"# Stop IK effect and reset bones_global_pose_override on Skeleton\n"
"skeleton_ik_node.stop()\n"
"\n"
"# Apply full IK effect\n"
"skeleton_ik_node.set_influence(1.0)\n"
"\n"
"# Apply half IK effect\n"
"skeleton_ik_node.set_influence(0.5)\n"
"\n"
"# Apply zero IK effect (a value at or below 0.01 also removes "
"bones_global_pose_override on Skeleton)\n"
"skeleton_ik_node.set_influence(0.0)\n"
"[/codeblock]"
msgstr ""
"SkeletonIK3D ត្រូវបានប្រើដើម្បីបង្វិលឆ្អឹងទាំងអស់នៃ [Skeleton3D] bone chain "
"តាមរបៀបដែលដាក់ឆ្អឹងចុងក្រោយនៅទីតាំង 3D ដែលចង់បាន។ សេណារីយ៉ូទូទៅសម្រាប់ IK "
"នៅក្នុងហ្គេមគឺការដាក់ជើងតួអង្គនៅលើដី ឬដៃតួអង្គលើវត្ថុដែលកំពុងកាន់។ SkeletonIK ប្រើ "
"FabrikInverseKinematic ខាងក្នុងដើម្បីដោះស្រាយ bone chain ហើយអនុវត្តលទ្ធផលទៅកាន់ "
"property [code]bones_global_pose_override[/code] របស់ [Skeleton3D] "
"សម្រាប់ឆ្អឹងរងគ្រោះទាំងអស់នៅក្នុង chain។ ប្រសិនបើអនុវត្តពេញលេញ នេះនឹងសរសេរជាន់លើ bone "
"transform ណាមួយពី [Animation]s ឬ bone custom poses ដែលបានកំណត់ដោយអ្នកប្រើប្រាស់។ "
"ចំនួនដែលបានអនុវត្តអាចត្រូវបានគ្រប់គ្រងដោយ property [member "
"SkeletonModifier3D.influence]។\n"
"[codeblock]\n"
"# Apply IK effect automatically on every new frame (not the current)\n"
"skeleton_ik_node.start()\n"
"\n"
"# Apply IK effect only on the current frame\n"
"skeleton_ik_node.start(true)\n"
"\n"
"# Stop IK effect and reset bones_global_pose_override on Skeleton\n"
"skeleton_ik_node.stop()\n"
"\n"
"# Apply full IK effect\n"
"skeleton_ik_node.set_influence(1.0)\n"
"\n"
"# Apply half IK effect\n"
"skeleton_ik_node.set_influence(0.5)\n"
"\n"
"# Apply zero IK effect (a value at or below 0.01 also removes "
"bones_global_pose_override on Skeleton)\n"
"skeleton_ik_node.set_influence(0.0)\n"
"[/codeblock]"

msgid ""
"Returns the parent [Skeleton3D] node that was present when SkeletonIK entered "
"the scene tree. Returns [code]null[/code] if the parent node was not a "
"[Skeleton3D] node when SkeletonIK3D entered the scene tree."
msgstr ""
"បង្វិល node មេ [Skeleton3D] ដែលមានវត្តមាននៅពេល SkeletonIK ចូលទៅក្នុង scene tree។ "
"បង្វិល [code]null[/code] ប្រសិនបើ node មេមិនមែនជា node [Skeleton3D] នៅពេល "
"SkeletonIK3D ចូលទៅក្នុង scene tree។"

msgid ""
"Returns [code]true[/code] if SkeletonIK is applying IK effects on continues "
"frames to the [Skeleton3D] bones. Returns [code]false[/code] if SkeletonIK is "
"stopped or [method start] was used with the [code]one_time[/code] parameter "
"set to [code]true[/code]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ SkeletonIK កំពុងអនុវត្ត IK effects លើ frames "
"បន្តបន្ទាប់ទៅកាន់ឆ្អឹង [Skeleton3D]។ បង្វិល [code]false[/code] ប្រសិនបើ SkeletonIK "
"ត្រូវបានបញ្ឈប់ ឬ [method start] ត្រូវបានប្រើជាមួយនឹងប៉ារ៉ាម៉ែត្រ [code]one_time[/code] "
"ដែលបានកំណត់ទៅជា [code]true[/code]។"

msgid ""
"Starts applying IK effects on each frame to the [Skeleton3D] bones but will "
"only take effect starting on the next frame. If [param one_time] is "
"[code]true[/code], this will take effect immediately but also reset on the "
"next frame."
msgstr ""
"ចាប់ផ្តើមអនុវត្ត IK effects លើ frame នីមួយៗទៅកាន់ឆ្អឹង [Skeleton3D] "
"ប៉ុន្តែនឹងមានប្រសិទ្ធភាពចាប់ពី frame បន្ទាប់។ ប្រសិនបើ [param one_time] គឺ [code]true[/"
"code] វានឹងមានប្រសិទ្ធភាពភ្លាមៗ ប៉ុន្តែក៏នឹងកំណត់ឡើងវិញនៅលើ frame បន្ទាប់ផងដែរ។"

msgid ""
"Stops applying IK effects on each frame to the [Skeleton3D] bones and also "
"calls [method Skeleton3D.clear_bones_global_pose_override] to remove existing "
"overrides on all bones."
msgstr ""
"បញ្ឈប់ការអនុវត្ត IK effects លើ frame នីមួយៗទៅកាន់ឆ្អឹង [Skeleton3D] ហើយក៏ហៅ [method "
"Skeleton3D.clear_bones_global_pose_override] ដើម្បីលុប overrides "
"ដែលមានស្រាប់ចេញពីឆ្អឹងទាំងអស់។"

msgid "Use [member SkeletonModifier3D.influence] instead."
msgstr "សូមប្រើ [member SkeletonModifier3D.influence] ជំនួសវិញ។"

msgid ""
"Interpolation value for how much the IK results are applied to the current "
"skeleton bone chain. A value of [code]1.0[/code] will overwrite all skeleton "
"bone transforms completely while a value of [code]0.0[/code] will visually "
"disable the SkeletonIK."
msgstr ""
"តម្លៃ Interpolation សម្រាប់កម្រិតដែលលទ្ធផល IK ត្រូវបានអនុវត្តទៅលើ skeleton bone chain "
"បច្ចុប្បន្ន។ តម្លៃ [code]1.0[/code] នឹងសរសេរជាន់លើ skeleton bone transforms "
"ទាំងអស់ទាំងស្រុង ខណៈពេលដែលតម្លៃ [code]0.0[/code] នឹងបិទ SkeletonIK ជាលក្ខណៈរូបភាព "
"(visually)។"

msgid ""
"Secondary target position (first is [member target] property or [member "
"target_node]) for the IK chain. Use magnet position (pole target) to control "
"the bending of the IK chain. Only works if the bone chain has more than 2 "
"bones. The middle chain bone position will be linearly interpolated with the "
"magnet position."
msgstr ""
"ទីតាំងគោលដៅបន្ទាប់បន្សំ (ទីមួយគឺ property [member target] ឬ [member target_node]) "
"សម្រាប់ IK chain។ ប្រើ magnet position (pole target) ដើម្បីគ្រប់គ្រងការពត់នៃ IK chain។ "
"ដំណើរការតែនៅពេលដែល bone chain មានឆ្អឹងលើសពី 2 ប៉ុណ្ណោះ។ ទីតាំងឆ្អឹងកណ្តាលនៃ chain "
"នឹងត្រូវបាន interpolated ជាលីនេអ៊ែរជាមួយនឹង magnet position។"

msgid ""
"Number of iteration loops used by the IK solver to produce more accurate (and "
"elegant) bone chain results."
msgstr ""
"ចំនួន iteration loops ដែលប្រើដោយ IK solver ដើម្បីបង្កើតលទ្ធផល bone chain កាន់តែត្រឹមត្រូវ "
"(និងស្រស់ស្អាត)។"

msgid ""
"The minimum distance between bone and goal target. If the distance is below "
"this value, the IK solver stops further iterations."
msgstr ""
"ចម្ងាយអប្បបរមារវាងឆ្អឹង និង goal target។ ប្រសិនបើចម្ងាយទាបជាងតម្លៃនេះ IK solver នឹងបញ្ឈប់ "
"iterations បន្ថែម។"

msgid ""
"If [code]true[/code] overwrites the rotation of the tip bone with the "
"rotation of the [member target] (or [member target_node] if defined)."
msgstr ""
"ប្រសិនបើ [code]true[/code] សរសេរជាន់លើ rotation នៃ tip bone ជាមួយនឹង rotation នៃ "
"[member target] (ឬ [member target_node] ប្រសិនបើបានកំណត់)។"

msgid "The name of the current root bone, the first bone in the IK chain."
msgstr "ឈ្មោះនៃ root bone បច្ចុប្បន្ន ដែលជាឆ្អឹងទីមួយនៅក្នុង IK chain។"

msgid ""
"Target node [NodePath] for the IK chain. If available, the node's current "
"[Transform3D] is used instead of the [member target] property."
msgstr ""
"[NodePath] របស់ node គោលដៅសម្រាប់ IK chain។ ប្រសិនបើមាន [Transform3D] បច្ចុប្បន្នរបស់ "
"node ត្រូវបានប្រើជំនួសឱ្យ property [member target]។"

msgid ""
"The name of the current tip bone, the last bone in the IK chain placed at the "
"[member target] transform (or [member target_node] if defined)."
msgstr ""
"ឈ្មោះនៃ tip bone បច្ចុប្បន្ន ដែលជាឆ្អឹងចុងក្រោយនៅក្នុង IK chain ដែលបានដាក់នៅ transform "
"[member target] (ឬ [member target_node] ប្រសិនបើបានកំណត់)។"

msgid ""
"If [code]true[/code], instructs the IK solver to consider the secondary "
"magnet target (pole target) when calculating the bone chain. Use the magnet "
"position (pole target) to control the bending of the IK chain."
msgstr ""
"ប្រសិនបើ [code]true[/code] ណែនាំ IK solver ឱ្យពិចារណា secondary magnet target "
"(pole target) នៅពេលគណនា bone chain។ ប្រើ magnet position (pole target) "
"ដើម្បីគ្រប់គ្រងការពត់នៃ IK chain។"

msgid "Base class for resources that operate on [Bone2D]s in a [Skeleton2D]."
msgstr "Class មូលដ្ឋានសម្រាប់ធនធានដែលដំណើរការលើ [Bone2D]s នៅក្នុង [Skeleton2D]។"

msgid ""
"This resource provides an interface that can be expanded so code that "
"operates on [Bone2D] nodes in a [Skeleton2D] can be mixed and matched "
"together to create complex interactions.\n"
"This is used to provide Godot with a flexible and powerful Inverse Kinematics "
"solution that can be adapted for many different uses."
msgstr ""
"ធនធាននេះផ្តល់នូវចំណុចប្រទាក់ដែលអាចពង្រីកបាន ដើម្បីឱ្យកូដដែលដំណើរការលើ node [Bone2D] នៅក្នុង "
"[Skeleton2D] អាចត្រូវបានលាយបញ្ចូលគ្នាដើម្បីបង្កើតអន្តរកម្មស្មុគស្មាញ។\n"
"វាត្រូវបានប្រើដើម្បីផ្តល់ឱ្យ Godot នូវដំណោះស្រាយ Inverse Kinematics ដែលមានភាពបត់បែន "
"និងខ្លាំងក្លា ដែលអាចសម្របខ្លួនបានសម្រាប់ការប្រើប្រាស់ផ្សេងៗគ្នាជាច្រើន។"

msgid ""
"Executes the given modification. This is where the modification performs "
"whatever function it is designed to do."
msgstr ""
"ដំណើរការ modification ដែលបានផ្តល់ឱ្យ។ នេះគឺជាកន្លែងដែល modification "
"អនុវត្តអនុគមន៍ណាមួយដែលវាត្រូវបានរចនាឡើងដើម្បីធ្វើ។"

msgid ""
"Called when the modification is setup. This is where the modification "
"performs initialization."
msgstr ""
"ត្រូវបានហៅនៅពេលដែល modification ត្រូវបានរៀបចំ (setup)។ នេះគឺជាកន្លែងដែល modification "
"អនុវត្ត initialization។"

msgid ""
"Takes an angle and clamps it so it is within the passed-in [param min] and "
"[param max] range. [param invert] will inversely clamp the angle, clamping it "
"to the range outside of the given bounds."
msgstr ""
"យកមុំ (angle) ហើយ clamp វា ដើម្បីឱ្យវាស្ថិតនៅក្នុងចន្លោះ [param min] និង [param max] "
"ដែលបានបញ្ជូនចូល។ [param invert] នឹង clamp មុំបែបបញ្ច្រាស ដោយ clamp "
"វាទៅកាន់ចន្លោះនៅខាងក្រៅព្រំដែនដែលបានផ្តល់ឱ្យ។"

msgid ""
"Returns whether this modification will call [method _draw_editor_gizmo] in "
"the Godot editor to draw modification-specific gizmos."
msgstr ""
"បង្វិលថាតើ modification នេះនឹងហៅ [method _draw_editor_gizmo] នៅក្នុង Godot editor "
"ដើម្បីគូរ gizmos ជាក់លាក់សម្រាប់ modification ដែរឬទេ។"

msgid "Returns whether this modification has been successfully setup or not."
msgstr "បង្វិលថាតើ modification នេះត្រូវបានរៀបចំ (setup) ដោយជោគជ័យឬអត់។"

msgid ""
"Returns the [SkeletonModificationStack2D] that this modification is bound to. "
"Through the modification stack, you can access the Skeleton2D the "
"modification is operating on."
msgstr ""
"បង្វិល [SkeletonModificationStack2D] ដែល modification នេះត្រូវបានភ្ជាប់ (bound)។ "
"តាមរយៈ modification stack អ្នកអាចចូលប្រើ Skeleton2D ដែល modification "
"កំពុងដំណើរការលើ។"

msgid ""
"Sets whether this modification will call [method _draw_editor_gizmo] in the "
"Godot editor to draw modification-specific gizmos."
msgstr ""
"កំណត់ថាតើ modification នេះនឹងហៅ [method _draw_editor_gizmo] នៅក្នុង Godot editor "
"ដើម្បីគូរ gizmos ជាក់លាក់សម្រាប់ modification ដែរឬទេ។"

msgid ""
"Manually allows you to set the setup state of the modification. This function "
"should only rarely be used, as the [SkeletonModificationStack2D] the "
"modification is bound to should handle setting the modification up."
msgstr ""
"អនុញ្ញាតឱ្យអ្នកកំណត់ setup state នៃ modification ដោយដៃ។ "
"អនុគមន៍នេះគួរតែត្រូវបានប្រើកម្រប៉ុណ្ណោះ ព្រោះ [SkeletonModificationStack2D] ដែល "
"modification ត្រូវបានភ្ជាប់ គួរតែដោះស្រាយការរៀបចំ modification ដោយខ្លួនឯង។"

msgid ""
"If [code]true[/code], the modification's [method _execute] function will be "
"called by the [SkeletonModificationStack2D]."
msgstr ""
"ប្រសិនបើ [code]true[/code], អនុគមន៍ [method _execute] របស់ modification "
"នឹងត្រូវបានហៅដោយ [SkeletonModificationStack2D]។"

msgid ""
"The execution mode for the modification. This tells the modification stack "
"when to execute the modification. Some modifications have settings that are "
"only available in certain execution modes."
msgstr ""
"របៀបនៃការដំណើរការ (execution mode) សម្រាប់ modification។ នេះប្រាប់ modification "
"stack ថាពេលណាត្រូវដំណើរការ modification។ Modifications "
"មួយចំនួនមានការកំណត់ដែលមានតែនៅក្នុង execution modes ជាក់លាក់ប៉ុណ្ណោះ។"

msgid ""
"A modification that uses CCDIK to manipulate a series of bones to reach a "
"target in 2D."
msgstr "Modification ដែលប្រើ CCDIK ដើម្បីចាត់ចែងឆ្អឹងមួយចំនួនដើម្បីឈានទៅដល់គោលដៅក្នុង 2D។"

msgid ""
"This [SkeletonModification2D] uses an algorithm called Cyclic Coordinate "
"Descent Inverse Kinematics, or CCDIK, to manipulate a chain of bones in a "
"[Skeleton2D] so it reaches a defined target.\n"
"CCDIK works by rotating a set of bones, typically called a \"bone chain\", on "
"a single axis. Each bone is rotated to face the target from the tip (by "
"default), which over a chain of bones allow it to rotate properly to reach "
"the target. Because the bones only rotate on a single axis, CCDIK [i]can[/i] "
"look more robotic than other IK solvers.\n"
"[b]Note:[/b] The CCDIK modifier has [code]ccdik_joints[/code], which are the "
"data objects that hold the data for each joint in the CCDIK chain. This is "
"different from a bone! CCDIK joints hold the data needed for each bone in the "
"bone chain used by CCDIK.\n"
"CCDIK also fully supports angle constraints, allowing for more control over "
"how a solution is met."
msgstr ""
"[SkeletonModification2D] នេះប្រើក្បួនដោះស្រាយដែលហៅថា Cyclic Coordinate Descent "
"Inverse Kinematics ឬ CCDIK ដើម្បីចាត់ចែង chain នៃឆ្អឹងនៅក្នុង [Skeleton2D] "
"ដើម្បីឱ្យវាឈានទៅដល់គោលដៅដែលបានកំណត់។\n"
"CCDIK ដំណើរការដោយបង្វិលសំណុំនៃឆ្អឹង ដែលជាទូទៅហៅថា \"bone chain\" នៅលើអ័ក្សតែមួយ។ "
"ឆ្អឹងនីមួយៗត្រូវបានបង្វិលដើម្បី បែរមុខទៅរកគោលដៅពី tip (តាមលំនាំដើម) ដែលនៅលើ chain "
"នៃឆ្អឹងអនុញ្ញាតឱ្យវាបង្វិលបានត្រឹមត្រូវដើម្បីឈានទៅដល់គោលដៅ។ ដោយសារឆ្អឹងបង្វិលតែលើអ័ក្សតែមួយ CCDIK "
"[i]អាច[/i] មើលទៅដូចមនុស្សយន្ត (robotic) ជាង IK solvers ផ្សេងទៀត។\n"
"[b]ចំណាំ៖[/b] CCDIK modifier មាន [code]ccdik_joints[/code] ដែលជា data objects "
"ដែលផ្ទុកទិន្នន័យសម្រាប់ joint នីមួយៗនៅក្នុង CCDIK chain។ នេះខុសពីឆ្អឹង! CCDIK joints "
"ផ្ទុកទិន្នន័យដែលចាំបាច់សម្រាប់ឆ្អឹងនីមួយៗនៅក្នុង bone chain ដែលប្រើដោយ CCDIK។\n"
"CCDIK ក៏គាំទ្រយ៉ាងពេញលេញនូវ angle constraints "
"ដែលអនុញ្ញាតឱ្យមានការគ្រប់គ្រងកាន់តែច្រើនលើរបៀបដែលដំណោះស្រាយ ត្រូវបានបំពេញ។"

msgid ""
"Returns the [Bone2D] node assigned to the CCDIK joint at [param joint_idx]."
msgstr "បង្វិល node [Bone2D] ដែលបានកំណត់ទៅកាន់ CCDIK joint នៅ [param joint_idx]។"

msgid ""
"Returns the index of the [Bone2D] node assigned to the CCDIK joint at [param "
"joint_idx]."
msgstr ""
"បង្វិលលិបិក្រមនៃ node [Bone2D] ដែលបានកំណត់ទៅកាន់ CCDIK joint នៅ [param joint_idx]។"

msgid ""
"Returns whether the CCDIK joint at [param joint_idx] uses an inverted joint "
"constraint. See [method set_ccdik_joint_constraint_angle_invert] for details."
msgstr ""
"បង្វិលថាតើ CCDIK joint នៅ [param joint_idx] ប្រើ inverted joint constraint ឬអត់។ "
"សូមមើល [method set_ccdik_joint_constraint_angle_invert] សម្រាប់ព័ត៌មានលម្អិត។"

msgid "Returns the maximum angle constraint for the joint at [param joint_idx]."
msgstr "បង្វិល maximum angle constraint សម្រាប់ joint នៅ [param joint_idx]។"

msgid "Returns the minimum angle constraint for the joint at [param joint_idx]."
msgstr "បង្វិល minimum angle constraint សម្រាប់ joint នៅ [param joint_idx]។"

msgid ""
"Returns whether angle constraints on the CCDIK joint at [param joint_idx] are "
"enabled."
msgstr ""
"បង្វិលថាតើ angle constraints នៅលើ CCDIK joint នៅ [param joint_idx] ត្រូវបានបើកឬអត់។"

msgid ""
"Returns whether the joint at [param joint_idx] is set to rotate from the "
"joint, [code]true[/code], or to rotate from the tip, [code]false[/code]. The "
"default is to rotate from the tip."
msgstr ""
"បង្វិលថាតើ joint នៅ [param joint_idx] ត្រូវបានកំណត់ឱ្យបង្វិលពី joint, [code]true[/code] "
"ឬបង្វិលពី tip, [code]false[/code]។ តាមលំនាំដើមគឺបង្វិលពី tip។"

msgid "Sets the [Bone2D] node assigned to the CCDIK joint at [param joint_idx]."
msgstr "កំណត់ node [Bone2D] ដែលបានកំណត់ទៅកាន់ CCDIK joint នៅ [param joint_idx]។"

msgid ""
"Sets the bone index, [param bone_idx], of the CCDIK joint at [param "
"joint_idx]. When possible, this will also update the [code]bone2d_node[/code] "
"of the CCDIK joint based on data provided by the linked skeleton."
msgstr ""
"កំណត់លិបិក្រមឆ្អឹង, [param bone_idx], នៃ CCDIK joint នៅ [param joint_idx]។ "
"នៅពេលដែលអាចធ្វើទៅបាន វាក៏នឹងធ្វើបច្ចុប្បន្នភាព [code]bone2d_node[/code] នៃ CCDIK "
"joint ដោយផ្អែកលើទិន្នន័យដែលផ្តល់ដោយ skeleton ដែលបានភ្ជាប់។"

msgid ""
"Sets whether the CCDIK joint at [param joint_idx] uses an inverted joint "
"constraint.\n"
"An inverted joint constraint only constraints the CCDIK joint to the angles "
"[i]outside of[/i] the inputted minimum and maximum angles. For this reason, "
"it is referred to as an inverted joint constraint, as it constraints the "
"joint to the outside of the inputted values."
msgstr ""
"កំណត់ថាតើ CCDIK joint នៅ [param joint_idx] ប្រើ inverted joint constraint ឬអត់។\n"
"Inverted joint constraint គ្រាន់តែ constraint CCDIK joint ទៅកាន់មុំ [i]outside of[/"
"i] (នៅខាងក្រៅ) នៃ minimum និង maximum angles ដែលបានបញ្ចូល។ ដោយសារហេតុផលនេះ "
"វាត្រូវបានគេហៅថា inverted joint constraint ព្រោះវា constraint joint "
"ទៅកាន់ខាងក្រៅនៃតម្លៃដែលបានបញ្ចូល។"

msgid "Sets the maximum angle constraint for the joint at [param joint_idx]."
msgstr "កំណត់ maximum angle constraint សម្រាប់ joint នៅ [param joint_idx]។"

msgid "Sets the minimum angle constraint for the joint at [param joint_idx]."
msgstr "កំណត់ minimum angle constraint សម្រាប់ joint នៅ [param joint_idx]។"

msgid ""
"Determines whether angle constraints on the CCDIK joint at [param joint_idx] "
"are enabled. When [code]true[/code], constraints will be enabled and taken "
"into account when solving."
msgstr ""
"កំណត់ថាតើ angle constraints នៅលើ CCDIK joint នៅ [param joint_idx] ត្រូវបានបើកឬអត់។ "
"នៅពេល [code]true[/code], constraints នឹងត្រូវបានបើក "
"ហើយត្រូវបានយកទៅពិចារណានៅពេលដោះស្រាយ (solving)។"

msgid ""
"Sets whether the joint at [param joint_idx] is set to rotate from the joint, "
"[code]true[/code], or to rotate from the tip, [code]false[/code]."
msgstr ""
"កំណត់ថាតើ joint នៅ [param joint_idx] ត្រូវបានកំណត់ឱ្យបង្វិលពី joint, [code]true[/code] "
"ឬបង្វិលពី tip, [code]false[/code]។"

msgid "The number of CCDIK joints in the CCDIK modification."
msgstr "ចំនួន CCDIK joints នៅក្នុង CCDIK modification។"

msgid ""
"The NodePath to the node that is the target for the CCDIK modification. This "
"node is what the CCDIK chain will attempt to rotate the bone chain to."
msgstr ""
"NodePath ទៅកាន់ node ដែលជាគោលដៅសម្រាប់ CCDIK modification។ Node នេះគឺជាអ្វីដែល "
"CCDIK chain នឹងព្យាយាមបង្វិល bone chain ទៅរក។"

msgid ""
"The end position of the CCDIK chain. Typically, this should be a child of a "
"[Bone2D] node attached to the final [Bone2D] in the CCDIK chain."
msgstr ""
"ទីតាំងចុងក្រោយ (end position) នៃ CCDIK chain។ ជាទូទៅ នេះគួរតែជាកូននៃ node [Bone2D] "
"ដែលបានភ្ជាប់ទៅនឹង [Bone2D] ចុងក្រោយនៅក្នុង CCDIK chain។"

msgid ""
"A modification that uses FABRIK to manipulate a series of [Bone2D] nodes to "
"reach a target."
msgstr ""
"Modification ដែលប្រើ FABRIK ដើម្បីចាត់ចែង node [Bone2D] មួយចំនួនដើម្បីឈានទៅដល់គោលដៅ។"

msgid ""
"This [SkeletonModification2D] uses an algorithm called Forward And Backward "
"Reaching Inverse Kinematics, or FABRIK, to rotate a bone chain so that it "
"reaches a target.\n"
"FABRIK works by knowing the positions and lengths of a series of bones, "
"typically called a \"bone chain\". It first starts by running a forward pass, "
"which places the final bone at the target's position. Then all other bones "
"are moved towards the tip bone, so they stay at the defined bone length away. "
"Then a backwards pass is performed, where the root/first bone in the FABRIK "
"chain is placed back at the origin. Then all other bones are moved so they "
"stay at the defined bone length away. This positions the bone chain so that "
"it reaches the target when possible, but all of the bones stay the correct "
"length away from each other.\n"
"Because of how FABRIK works, it often gives more natural results than those "
"seen in [SkeletonModification2DCCDIK].\n"
"[b]Note:[/b] The FABRIK modifier has [code]fabrik_joints[/code], which are "
"the data objects that hold the data for each joint in the FABRIK chain. This "
"is different from [Bone2D] nodes! FABRIK joints hold the data needed for each "
"[Bone2D] in the bone chain used by FABRIK.\n"
"To help control how the FABRIK joints move, a magnet vector can be passed, "
"which can nudge the bones in a certain direction prior to solving, giving a "
"level of control over the final result."
msgstr ""
"[SkeletonModification2D] នេះប្រើក្បួនដោះស្រាយដែលហៅថា Forward And Backward "
"Reaching Inverse Kinematics ឬ FABRIK ដើម្បីបង្វិល bone chain "
"ដើម្បីឱ្យវាឈានទៅដល់គោលដៅ។\n"
"FABRIK ដំណើរការដោយដឹងពីទីតាំង និងប្រវែងនៃឆ្អឹងមួយចំនួន ដែលជាទូទៅហៅថា \"bone chain\"។ "
"ដំបូងវាចាប់ផ្តើមដោយដំណើរការ forward pass ដែលដាក់ឆ្អឹងចុងក្រោយនៅទីតាំងរបស់គោលដៅ។ "
"បន្ទាប់មកឆ្អឹងផ្សេងទៀតទាំងអស់ត្រូវបានផ្លាស់ទីទៅរក tip bone "
"ដើម្បីឱ្យពួកវានៅចម្ងាយប្រវែងឆ្អឹងដែលបានកំណត់។ បន្ទាប់មក backwards pass ត្រូវបានអនុវត្ត ដែល "
"root/first bone នៅក្នុង FABRIK chain ត្រូវបានដាក់ត្រឡប់ទៅ origin វិញ។ "
"បន្ទាប់មកឆ្អឹងផ្សេងទៀតទាំងអស់ត្រូវបានផ្លាស់ទី ដើម្បីឱ្យពួកវានៅចម្ងាយប្រវែងឆ្អឹងដែលបានកំណត់។ នេះដាក់ "
"bone chain ដើម្បីឱ្យវាឈានទៅដល់គោលដៅនៅពេលដែលអាចធ្វើទៅបាន "
"ប៉ុន្តែឆ្អឹងទាំងអស់នៅចម្ងាយប្រវែងត្រឹមត្រូវពីគ្នាទៅវិញទៅមក។\n"
"ដោយសាររបៀបដែល FABRIK ដំណើរការ វាតែងតែផ្តល់លទ្ធផលធម្មជាតិជាងអ្វីដែលឃើញនៅក្នុង "
"[SkeletonModification2DCCDIK]។\n"
"[b]ចំណាំ៖[/b] FABRIK modifier មាន [code]fabrik_joints[/code] ដែលជា data objects "
"ដែលផ្ទុកទិន្នន័យសម្រាប់ joint នីមួយៗនៅក្នុង FABRIK chain។ នេះខុសពី node [Bone2D]! FABRIK "
"joints ផ្ទុកទិន្នន័យដែលចាំបាច់សម្រាប់ [Bone2D] នីមួយៗនៅក្នុង bone chain ដែលប្រើដោយ FABRIK។\n"
"ដើម្បីជួយគ្រប់គ្រងរបៀបដែល FABRIK joints ផ្លាស់ទី magnet vector អាចត្រូវបានបញ្ជូន "
"ដែលអាចរុញឆ្អឹងទៅក្នុងទិសដៅជាក់លាក់មួយមុនពេលដោះស្រាយ ផ្តល់នូវកម្រិតនៃការគ្រប់គ្រងលើលទ្ធផលចុងក្រោយ។"

msgid ""
"Returns the [Bone2D] node assigned to the FABRIK joint at [param joint_idx]."
msgstr "បង្វិល node [Bone2D] ដែលបានកំណត់ទៅកាន់ FABRIK joint នៅ [param joint_idx]។"

msgid ""
"Returns the index of the [Bone2D] node assigned to the FABRIK joint at [param "
"joint_idx]."
msgstr ""
"បង្វិលលិបិក្រមនៃ node [Bone2D] ដែលបានកំណត់ទៅកាន់ FABRIK joint នៅ [param joint_idx]។"

msgid "Returns the magnet position vector for the joint at [param joint_idx]."
msgstr "បង្វិល magnet position vector សម្រាប់ joint នៅ [param joint_idx]។"

msgid ""
"Returns whether the joint is using the target's rotation rather than allowing "
"FABRIK to rotate the joint. This option only applies to the tip/final joint "
"in the chain."
msgstr ""
"បង្វិលថាតើ joint កំពុងប្រើ rotation របស់គោលដៅ ជាជាងអនុញ្ញាតឱ្យ FABRIK បង្វិល joint ឬអត់។ "
"ជម្រើសនេះអនុវត្តតែចំពោះ tip/final joint នៅក្នុង chain ប៉ុណ្ណោះ។"

msgid ""
"Sets the [Bone2D] node assigned to the FABRIK joint at [param joint_idx]."
msgstr "កំណត់ node [Bone2D] ដែលបានកំណត់ទៅកាន់ FABRIK joint នៅ [param joint_idx]។"

msgid ""
"Sets the bone index, [param bone_idx], of the FABRIK joint at [param "
"joint_idx]. When possible, this will also update the [code]bone2d_node[/code] "
"of the FABRIK joint based on data provided by the linked skeleton."
msgstr ""
"កំណត់លិបិក្រមឆ្អឹង, [param bone_idx], នៃ FABRIK joint នៅ [param joint_idx]។ "
"នៅពេលដែលអាចធ្វើទៅបាន វាក៏នឹងធ្វើបច្ចុប្បន្នភាព [code]bone2d_node[/code] នៃ FABRIK "
"joint ដោយផ្អែកលើទិន្នន័យដែលផ្តល់ដោយ skeleton ដែលបានភ្ជាប់។"

msgid "Sets the magnet position vector for the joint at [param joint_idx]."
msgstr "កំណត់ magnet position vector សម្រាប់ joint នៅ [param joint_idx]។"

msgid ""
"Sets whether the joint at [param joint_idx] will use the target node's "
"rotation rather than letting FABRIK rotate the node.\n"
"[b]Note:[/b] This option only works for the tip/final joint in the chain. For "
"all other nodes, this option will be ignored."
msgstr ""
"កំណត់ថាតើ joint នៅ [param joint_idx] នឹងប្រើ rotation របស់ target node ជាជាងទុកឱ្យ "
"FABRIK បង្វិល node ឬអត់។\n"
"[b]ចំណាំ៖[/b] ជម្រើសនេះដំណើរការតែសម្រាប់ tip/final joint នៅក្នុង chain ប៉ុណ្ណោះ។ សម្រាប់ "
"node ផ្សេងទៀតទាំងអស់ ជម្រើសនេះនឹងត្រូវបានមិនអើពើ។"

msgid "The number of FABRIK joints in the FABRIK modification."
msgstr "ចំនួន FABRIK joints នៅក្នុង FABRIK modification។"

msgid ""
"The NodePath to the node that is the target for the FABRIK modification. This "
"node is what the FABRIK chain will attempt to rotate the bone chain to."
msgstr ""
"NodePath ទៅកាន់ node ដែលជាគោលដៅសម្រាប់ FABRIK modification។ Node នេះគឺជាអ្វីដែល "
"FABRIK chain នឹងព្យាយាមបង្វិល bone chain ទៅរក។"

msgid ""
"A modification that jiggles [Bone2D] nodes as they move towards a target."
msgstr ""
"Modification ដែលធ្វើឱ្យ node [Bone2D] រង្គើ (jiggles) នៅពេលពួកវាផ្លាស់ទីទៅរកគោលដៅ។"

msgid ""
"This modification moves a series of bones, typically called a bone chain, "
"towards a target. What makes this modification special is that it calculates "
"the velocity and acceleration for each bone in the bone chain, and runs a "
"very light physics-like calculation using the inputted values. This allows "
"the bones to overshoot the target and \"jiggle\" around. It can be configured "
"to act more like a spring, or sway around like cloth might.\n"
"This modification is useful for adding additional motion to things like hair, "
"the edges of clothing, and more. It has several settings to that allow "
"control over how the joint moves when the target moves.\n"
"[b]Note:[/b] The Jiggle modifier has [code]jiggle_joints[/code], which are "
"the data objects that hold the data for each joint in the Jiggle chain. This "
"is different from than [Bone2D] nodes! Jiggle joints hold the data needed for "
"each [Bone2D] in the bone chain used by the Jiggle modification."
msgstr ""
"Modification នេះផ្លាស់ទីឆ្អឹងមួយចំនួន ដែលជាទូទៅហៅថា bone chain ទៅរកគោលដៅ។ អ្វីដែលធ្វើឱ្យ "
"modification នេះពិសេសគឺថាវាគណនា velocity និង acceleration សម្រាប់ឆ្អឹងនីមួយៗនៅក្នុង bone "
"chain ហើយដំណើរការការគណនាស្រដៀងនឹង physics ដែលស្រាលបំផុតដោយប្រើតម្លៃដែលបានបញ្ចូល។ "
"នេះអនុញ្ញាតឱ្យឆ្អឹងហួសគោលដៅ (overshoot) ហើយ \"jiggle\" (រង្គើ) ជុំវិញ។ "
"វាអាចត្រូវបានកំណត់រចនាសម្ព័ន្ធឱ្យដើរតួដូចជា spring ឬរង្គើដូចជា cloth។\n"
"Modification នេះមានប្រយោជន៍សម្រាប់បន្ថែមចលនាបន្ថែមទៅកាន់របស់ដូចជា សក់ គែមសម្លៀកបំពាក់ "
"និងច្រើនទៀត។ វាមានការកំណត់ជាច្រើនដែលអនុញ្ញាតឱ្យគ្រប់គ្រងពីរបៀបដែល joint "
"ផ្លាស់ទីនៅពេលដែលគោលដៅផ្លាស់ទី។\n"
"[b]ចំណាំ៖[/b] Jiggle modifier មាន [code]jiggle_joints[/code] ដែលជា data objects "
"ដែលផ្ទុកទិន្នន័យសម្រាប់ joint នីមួយៗនៅក្នុង Jiggle chain។ នេះខុសពី node [Bone2D]! Jiggle "
"joints ផ្ទុកទិន្នន័យដែលចាំបាច់សម្រាប់ [Bone2D] នីមួយៗនៅក្នុង bone chain ដែលប្រើដោយ Jiggle "
"modification។"

msgid ""
"Returns the collision mask used by the Jiggle modifier when collisions are "
"enabled."
msgstr ""
"បង្វិល collision mask ដែលប្រើដោយ Jiggle modifier នៅពេលដែល collisions ត្រូវបានបើក។"

msgid ""
"Returns the [Bone2D] node assigned to the Jiggle joint at [param joint_idx]."
msgstr "បង្វិល node [Bone2D] ដែលបានកំណត់ទៅកាន់ Jiggle joint នៅ [param joint_idx]។"

msgid ""
"Returns the index of the [Bone2D] node assigned to the Jiggle joint at [param "
"joint_idx]."
msgstr ""
"បង្វិលលិបិក្រមនៃ node [Bone2D] ដែលបានកំណត់ទៅកាន់ Jiggle joint នៅ [param joint_idx]។"

msgid "Returns the amount of damping of the Jiggle joint at [param joint_idx]."
msgstr "បង្វិលចំនួន damping នៃ Jiggle joint នៅ [param joint_idx]។"

msgid ""
"Returns a [Vector2] representing the amount of gravity the Jiggle joint at "
"[param joint_idx] is influenced by."
msgstr ""
"បង្វិល [Vector2] ដែលតំណាងឱ្យចំនួន gravity ដែល Jiggle joint នៅ [param joint_idx] "
"ត្រូវបានជះឥទ្ធិពល។"

msgid "Returns the amount of mass of the jiggle joint at [param joint_idx]."
msgstr "បង្វិលចំនួន mass នៃ jiggle joint នៅ [param joint_idx]។"

msgid ""
"Returns a boolean that indicates whether the joint at [param joint_idx] is "
"overriding the default Jiggle joint data defined in the modification."
msgstr ""
"បង្វិល boolean ដែលបង្ហាញថាតើ joint នៅ [param joint_idx] កំពុង override default "
"Jiggle joint data ដែលបានកំណត់នៅក្នុង modification ឬអត់។"

msgid "Returns the stiffness of the Jiggle joint at [param joint_idx]."
msgstr "បង្វិល stiffness នៃ Jiggle joint នៅ [param joint_idx]។"

msgid ""
"Returns a boolean that indicates whether the joint at [param joint_idx] is "
"using gravity or not."
msgstr ""
"បង្វិល boolean ដែលបង្ហាញថាតើ joint នៅ [param joint_idx] កំពុងប្រើ gravity ឬអត់។"

msgid ""
"Returns whether the jiggle modifier is taking physics colliders into account "
"when solving."
msgstr ""
"បង្វិលថាតើ jiggle modifier កំពុងយក physics colliders ទៅពិចារណានៅពេលដោះស្រាយឬអត់។"

msgid ""
"Resets the internal jiggle simulation state to the current bone positions, "
"clearing velocity, acceleration, and accumulated forces."
msgstr ""
"កំណត់ internal jiggle simulation state ឡើងវិញទៅជាទីតាំងឆ្អឹងបច្ចុប្បន្ន ដោយសម្អាត "
"velocity, acceleration និង accumulated forces។"

msgid ""
"Sets the collision mask that the Jiggle modifier will use when reacting to "
"colliders, if the Jiggle modifier is set to take colliders into account."
msgstr ""
"កំណត់ collision mask ដែល Jiggle modifier នឹងប្រើនៅពេលមានប្រតិកម្មជាមួយ colliders "
"ប្រសិនបើ Jiggle modifier ត្រូវបានកំណត់ឱ្យយក colliders ទៅពិចារណា។"

msgid ""
"Sets the [Bone2D] node assigned to the Jiggle joint at [param joint_idx]."
msgstr "កំណត់ node [Bone2D] ដែលបានកំណត់ទៅកាន់ Jiggle joint នៅ [param joint_idx]។"

msgid ""
"Sets the bone index, [param bone_idx], of the Jiggle joint at [param "
"joint_idx]. When possible, this will also update the [code]bone2d_node[/code] "
"of the Jiggle joint based on data provided by the linked skeleton."
msgstr ""
"កំណត់លិបិក្រមឆ្អឹង, [param bone_idx], នៃ Jiggle joint នៅ [param joint_idx]។ "
"នៅពេលដែលអាចធ្វើទៅបាន វាក៏នឹងធ្វើបច្ចុប្បន្នភាព [code]bone2d_node[/code] នៃ Jiggle "
"joint ដោយផ្អែកលើទិន្នន័យដែលផ្តល់ដោយ skeleton ដែលបានភ្ជាប់។"

msgid "Sets the amount of damping of the Jiggle joint at [param joint_idx]."
msgstr "កំណត់ចំនួន damping នៃ Jiggle joint នៅ [param joint_idx]។"

msgid "Sets the gravity vector of the Jiggle joint at [param joint_idx]."
msgstr "កំណត់ gravity vector នៃ Jiggle joint នៅ [param joint_idx]។"

msgid "Sets the of mass of the Jiggle joint at [param joint_idx]."
msgstr "កំណត់ចំនួន mass នៃ Jiggle joint នៅ [param joint_idx]។"

msgid ""
"Sets whether the Jiggle joint at [param joint_idx] should override the "
"default Jiggle joint settings. Setting this to [code]true[/code] will make "
"the joint use its own settings rather than the default ones attached to the "
"modification."
msgstr ""
"កំណត់ថាតើ Jiggle joint នៅ [param joint_idx] គួរ override default Jiggle joint "
"settings ឬអត់។ ការកំណត់វាទៅជា [code]true[/code] នឹងធ្វើឱ្យ joint ប្រើការកំណត់របស់វាផ្ទាល់ "
"ជាជាងការកំណត់លំនាំដើមដែលបានភ្ជាប់ទៅនឹង modification។"

msgid "Sets the of stiffness of the Jiggle joint at [param joint_idx]."
msgstr "កំណត់ចំនួន stiffness នៃ Jiggle joint នៅ [param joint_idx]។"

msgid "Sets whether the Jiggle joint at [param joint_idx] should use gravity."
msgstr "កំណត់ថាតើ Jiggle joint នៅ [param joint_idx] គួរប្រើ gravity ឬអត់។"

msgid ""
"If [code]true[/code], the Jiggle modifier will take colliders into account, "
"keeping them from entering into these collision objects."
msgstr ""
"ប្រសិនបើ [code]true[/code], Jiggle modifier នឹងយក colliders ទៅពិចារណា "
"ដោយរារាំងពួកវាមិនឱ្យចូលទៅក្នុង collision objects ទាំងនេះ។"

msgid ""
"The default amount of damping applied to the Jiggle joints, if they are not "
"overridden. Higher values lead to more of the calculated velocity being "
"applied."
msgstr ""
"ចំនួន damping លំនាំដើមដែលបានអនុវត្តទៅលើ Jiggle joints ប្រសិនបើពួកវាមិនត្រូវបាន overridden "
"ទេ។ តម្លៃខ្ពស់នាំឱ្យ calculated velocity កាន់តែច្រើនត្រូវបានអនុវត្ត។"

msgid ""
"The default amount of gravity applied to the Jiggle joints, if they are not "
"overridden."
msgstr ""
"ចំនួន gravity លំនាំដើមដែលបានអនុវត្តទៅលើ Jiggle joints ប្រសិនបើពួកវាមិនត្រូវបាន overridden "
"ទេ។"

msgid "The amount of Jiggle joints in the Jiggle modification."
msgstr "ចំនួន Jiggle joints នៅក្នុង Jiggle modification។"

msgid ""
"The default amount of mass assigned to the Jiggle joints, if they are not "
"overridden. Higher values lead to faster movements and more overshooting."
msgstr ""
"ចំនួន mass លំនាំដើមដែលបានកំណត់ទៅលើ Jiggle joints ប្រសិនបើពួកវាមិនត្រូវបាន overridden ទេ។ "
"តម្លៃខ្ពស់នាំឱ្យចលនាកាន់តែលឿន និង overshooting កាន់តែច្រើន។"

msgid ""
"The default amount of stiffness assigned to the Jiggle joints, if they are "
"not overridden. Higher values act more like springs, quickly moving into the "
"correct position."
msgstr ""
"ចំនួន stiffness លំនាំដើមដែលបានកំណត់ទៅលើ Jiggle joints ប្រសិនបើពួកវាមិនត្រូវបាន overridden "
"ទេ។ តម្លៃខ្ពស់ដើរតួដូចជា springs ដោយផ្លាស់ទីយ៉ាងឆាប់រហ័សទៅកាន់ទីតាំងត្រឹមត្រូវ។"

msgid ""
"The NodePath to the node that is the target for the Jiggle modification. This "
"node is what the Jiggle chain will attempt to rotate the bone chain to."
msgstr ""
"NodePath ទៅកាន់ node ដែលជាគោលដៅសម្រាប់ Jiggle modification។ Node នេះគឺជាអ្វីដែល "
"Jiggle chain នឹងព្យាយាមបង្វិល bone chain ទៅរក។"

msgid ""
"Whether the gravity vector, [member gravity], should be applied to the Jiggle "
"joints, assuming they are not overriding the default settings."
msgstr ""
"ថាតើ gravity vector, [member gravity], គួរត្រូវបានអនុវត្តទៅលើ Jiggle joints ឬអត់ "
"ដោយសន្មត់ថាពួកវាមិនកំពុង override ការកំណត់លំនាំដើម។"

msgid "A modification that rotates a [Bone2D] node to look at a target."
msgstr "Modification ដែលបង្វិល node [Bone2D] ដើម្បីសម្លឹងមើលទៅរកគោលដៅ។"

msgid ""
"This [SkeletonModification2D] rotates a bone to look a target. This is "
"extremely helpful for moving character's head to look at the player, rotating "
"a turret to look at a target, or any other case where you want to make a bone "
"rotate towards something quickly and easily."
msgstr ""
"[SkeletonModification2D] នេះបង្វិលឆ្អឹងដើម្បីសម្លឹងមើលគោលដៅ។ "
"នេះមានប្រយោជន៍ខ្លាំងណាស់សម្រាប់ការផ្លាស់ទីក្បាលតួអង្គដើម្បីសម្លឹងមើលអ្នកលេង បង្វិល turret "
"ដើម្បីសម្លឹងមើលគោលដៅ ឬករណីផ្សេងទៀតដែលអ្នកចង់ឱ្យឆ្អឹងបង្វិលទៅរកអ្វីមួយយ៉ាងឆាប់រហ័ស និងងាយស្រួល។"

msgid ""
"Returns the amount of additional rotation that is applied after the LookAt "
"modification executes."
msgstr "បង្វិលចំនួន rotation បន្ថែមដែលត្រូវបានអនុវត្តបន្ទាប់ពី LookAt modification ដំណើរការ។"

msgid ""
"Returns whether the constraints to this modification are inverted or not."
msgstr "បង្វិលថាតើ constraints ទៅកាន់ modification នេះត្រូវបាន invert ឬអត់។"

msgid "Returns the constraint's maximum allowed angle."
msgstr "បង្វិល maximum allowed angle របស់ constraint។"

msgid "Returns the constraint's minimum allowed angle."
msgstr "បង្វិល minimum allowed angle របស់ constraint។"

msgid ""
"Returns [code]true[/code] if the LookAt modification is using constraints."
msgstr "បង្វិល [code]true[/code] ប្រសិនបើ LookAt modification កំពុងប្រើ constraints។"

msgid ""
"Sets the amount of additional rotation that is to be applied after executing "
"the modification. This allows for offsetting the results by the inputted "
"rotation amount."
msgstr ""
"កំណត់ចំនួន rotation បន្ថែមដែលត្រូវអនុវត្តបន្ទាប់ពីដំណើរការ modification។ នេះអនុញ្ញាតឱ្យ "
"offset លទ្ធផលដោយចំនួន rotation ដែលបានបញ្ចូល។"

msgid ""
"When [code]true[/code], the modification will use an inverted joint "
"constraint.\n"
"An inverted joint constraint only constraints the [Bone2D] to the angles "
"[i]outside of[/i] the inputted minimum and maximum angles. For this reason, "
"it is referred to as an inverted joint constraint, as it constraints the "
"joint to the outside of the inputted values."
msgstr ""
"នៅពេល [code]true[/code], modification នឹងប្រើ inverted joint constraint។\n"
"Inverted joint constraint គ្រាន់តែ constraint [Bone2D] ទៅកាន់មុំ [i]outside of[/i] "
"(នៅខាងក្រៅ) នៃ minimum និង maximum angles ដែលបានបញ្ចូល។ ដោយសារហេតុផលនេះ "
"វាត្រូវបានគេហៅថា inverted joint constraint ព្រោះវា constraint joint "
"ទៅកាន់ខាងក្រៅនៃតម្លៃដែលបានបញ្ចូល។"

msgid "Sets the constraint's maximum allowed angle."
msgstr "កំណត់ maximum allowed angle របស់ constraint។"

msgid "Sets the constraint's minimum allowed angle."
msgstr "កំណត់ minimum allowed angle របស់ constraint។"

msgid ""
"Sets whether this modification will use constraints or not. When [code]true[/"
"code], constraints will be applied when solving the LookAt modification."
msgstr ""
"កំណត់ថាតើ modification នេះនឹងប្រើ constraints ឬអត់។ នៅពេល [code]true[/code], "
"constraints នឹងត្រូវបានអនុវត្តនៅពេលដោះស្រាយ LookAt modification។"

msgid "The [Bone2D] node that the modification will operate on."
msgstr "Node [Bone2D] ដែល modification នឹងដំណើរការលើ។"

msgid "The index of the [Bone2D] node that the modification will operate on."
msgstr "លិបិក្រមនៃ node [Bone2D] ដែល modification នឹងដំណើរការលើ។"

msgid ""
"The NodePath to the node that is the target for the LookAt modification. This "
"node is what the modification will rotate the [Bone2D] to."
msgstr ""
"NodePath ទៅកាន់ node ដែលជាគោលដៅសម្រាប់ LookAt modification។ Node នេះគឺជាអ្វីដែល "
"modification នឹងបង្វិល [Bone2D] ទៅរក។"

msgid ""
"Physical bones may be changed in the future to perform the position update of "
"[Bone2D] on their own, without needing this resource."
msgstr ""
"Physical bones អាចនឹងត្រូវបានផ្លាស់ប្តូរនៅពេលអនាគត ដើម្បីអនុវត្ត position update នៃ "
"[Bone2D] ដោយខ្លួនឯង ដោយមិនចាំបាច់ត្រូវការធនធាននេះ។"

msgid ""
"A modification that applies the transforms of [PhysicalBone2D] nodes to "
"[Bone2D] nodes."
msgstr ""
"Modification ដែលអនុវត្ត transforms នៃ node [PhysicalBone2D] ទៅកាន់ node [Bone2D]។"

msgid ""
"This modification takes the transforms of [PhysicalBone2D] nodes and applies "
"them to [Bone2D] nodes. This allows the [Bone2D] nodes to react to physics "
"thanks to the linked [PhysicalBone2D] nodes."
msgstr ""
"Modification នេះយក transforms នៃ node [PhysicalBone2D] ហើយអនុវត្តវាទៅកាន់ node "
"[Bone2D]។ នេះអនុញ្ញាតឱ្យ node [Bone2D] មានប្រតិកម្មទៅនឹង physics ដោយសារតែ node "
"[PhysicalBone2D] ដែលបានភ្ជាប់។"

msgid ""
"Empties the list of [PhysicalBone2D] nodes and populates it with all "
"[PhysicalBone2D] nodes that are children of the [Skeleton2D]."
msgstr ""
"សម្អាតបញ្ជីនៃ node [PhysicalBone2D] ហើយបំពេញវាដោយ node [PhysicalBone2D] "
"ទាំងអស់ដែលជាកូនរបស់ [Skeleton2D]។"

msgid "Returns the [PhysicalBone2D] node at [param joint_idx]."
msgstr "បង្វិល node [PhysicalBone2D] នៅ [param joint_idx]។"

msgid ""
"Sets the [PhysicalBone2D] node at [param joint_idx].\n"
"[b]Note:[/b] This is just the index used for this modification, not the bone "
"index used in the [Skeleton2D]."
msgstr ""
"កំណត់ node [PhysicalBone2D] នៅ [param joint_idx]។\n"
"[b]ចំណាំ៖[/b] នេះគ្រាន់តែជាលិបិក្រមដែលប្រើសម្រាប់ modification នេះប៉ុណ្ណោះ "
"មិនមែនជាលិបិក្រមឆ្អឹងដែលប្រើក្នុង [Skeleton2D] ទេ។"

msgid ""
"Tell the [PhysicalBone2D] nodes to start simulating and interacting with the "
"physics world.\n"
"Optionally, an array of bone names can be passed to this function, and that "
"will cause only [PhysicalBone2D] nodes with those names to start simulating."
msgstr ""
"ប្រាប់ node [PhysicalBone2D] ឱ្យចាប់ផ្តើម simulate និងធ្វើអន្តរកម្មជាមួយ physics "
"world។\n"
"ជាជម្រើស អារេនៃឈ្មោះឆ្អឹងអាចត្រូវបានបញ្ជូនទៅកាន់អនុគមន៍នេះ ហើយវានឹងធ្វើឱ្យតែ node "
"[PhysicalBone2D] ដែលមានឈ្មោះទាំងនោះប៉ុណ្ណោះចាប់ផ្តើម simulate។"

msgid ""
"Tell the [PhysicalBone2D] nodes to stop simulating and interacting with the "
"physics world.\n"
"Optionally, an array of bone names can be passed to this function, and that "
"will cause only [PhysicalBone2D] nodes with those names to stop simulating."
msgstr ""
"ប្រាប់ node [PhysicalBone2D] ឱ្យបញ្ឈប់ការ simulate និងធ្វើអន្តរកម្មជាមួយ physics "
"world។\n"
"ជាជម្រើស អារេនៃឈ្មោះឆ្អឹងអាចត្រូវបានបញ្ជូនទៅកាន់អនុគមន៍នេះ ហើយវានឹងធ្វើឱ្យតែ node "
"[PhysicalBone2D] ដែលមានឈ្មោះទាំងនោះប៉ុណ្ណោះបញ្ឈប់ការ simulate។"

msgid "The number of [PhysicalBone2D] nodes linked in this modification."
msgstr "ចំនួន node [PhysicalBone2D] ដែលបានភ្ជាប់នៅក្នុង modification នេះ។"

msgid "A modification that holds and executes a [SkeletonModificationStack2D]."
msgstr "Modification ដែលទុក និងដំណើរការ [SkeletonModificationStack2D]។"

msgid ""
"This [SkeletonModification2D] holds a reference to a "
"[SkeletonModificationStack2D], allowing you to use multiple modification "
"stacks on a single [Skeleton2D].\n"
"[b]Note:[/b] The modifications in the held [SkeletonModificationStack2D] will "
"only be executed if their execution mode matches the execution mode of the "
"SkeletonModification2DStackHolder."
msgstr ""
"[SkeletonModification2D] នេះទុកការយោងទៅកាន់ [SkeletonModificationStack2D] "
"ដែលអនុញ្ញាតឱ្យអ្នកប្រើ modification stacks ច្រើននៅលើ [Skeleton2D] តែមួយ។\n"
"[b]ចំណាំ៖[/b] modifications នៅក្នុង [SkeletonModificationStack2D] ដែលបានទុក "
"នឹងត្រូវបានដំណើរការតែនៅពេលដែល execution mode របស់ពួកវាត្រូវនឹង execution mode របស់ "
"SkeletonModification2DStackHolder ប៉ុណ្ណោះ។"

msgid ""
"Returns the [SkeletonModificationStack2D] that this modification is holding."
msgstr "បង្វិល [SkeletonModificationStack2D] ដែល modification នេះកំពុងទុក។"

msgid ""
"Sets the [SkeletonModificationStack2D] that this modification is holding. "
"This modification stack will then be executed when this modification is "
"executed."
msgstr ""
"កំណត់ [SkeletonModificationStack2D] ដែល modification នេះកំពុងទុក។ Modification "
"stack នេះនឹងត្រូវបានដំណើរការនៅពេលដែល modification នេះត្រូវបានដំណើរការ។"

msgid ""
"A modification that rotates two bones using the law of cosines to reach the "
"target."
msgstr "Modification ដែលបង្វិលឆ្អឹងពីរដោយប្រើ law of cosines ដើម្បីឈានទៅដល់គោលដៅ។"

msgid ""
"This [SkeletonModification2D] uses an algorithm typically called TwoBoneIK. "
"This algorithm works by leveraging the law of cosines and the lengths of the "
"bones to figure out what rotation the bones currently have, and what rotation "
"they need to make a complete triangle, where the first bone, the second bone, "
"and the target form the three vertices of the triangle. Because the algorithm "
"works by making a triangle, it can only operate on two bones.\n"
"TwoBoneIK is great for arms, legs, and really any joints that can be "
"represented by just two bones that bend to reach a target. This solver is "
"more lightweight than [SkeletonModification2DFABRIK], but gives similar, "
"natural looking results."
msgstr ""
"[SkeletonModification2D] នេះប្រើក្បួនដោះស្រាយដែលជាទូទៅហៅថា TwoBoneIK។ "
"ក្បួនដោះស្រាយនេះដំណើរការដោយទាញយកប្រយោជន៍ពី law of cosines និងប្រវែងនៃឆ្អឹង "
"ដើម្បីរកមើលថាតើឆ្អឹងបច្ចុប្បន្នមាន rotation អ្វី និង rotation "
"អ្វីដែលពួកវាត្រូវការដើម្បីបង្កើតជាត្រីកោណពេញលេញ ដែលឆ្អឹងទីមួយ ឆ្អឹងទីពីរ និងគោលដៅបង្កើតជា "
"vertices ទាំងបីនៃត្រីកោណ។ ដោយសារក្បួនដោះស្រាយដំណើរការដោយបង្កើតត្រីកោណ "
"វាអាចដំណើរការបានតែលើឆ្អឹងពីរប៉ុណ្ណោះ។\n"
"TwoBoneIK ល្អសម្រាប់ដៃ ជើង និង joint "
"ណាមួយដែលអាចតំណាងដោយឆ្អឹងត្រឹមតែពីរដែលពត់ដើម្បីឈានទៅដល់គោលដៅ។ Solver នេះមានទំហំតូចជាង "
"(lightweight) [SkeletonModification2DFABRIK] "
"ប៉ុន្តែផ្តល់លទ្ធផលស្រដៀងគ្នាដែលមើលទៅធម្មជាតិ។"

msgid ""
"Returns the [Bone2D] node that is being used as the first bone in the "
"TwoBoneIK modification."
msgstr "បង្វិល node [Bone2D] ដែលកំពុងត្រូវបានប្រើជាឆ្អឹងទីមួយនៅក្នុង TwoBoneIK modification។"

msgid ""
"Returns the index of the [Bone2D] node that is being used as the first bone "
"in the TwoBoneIK modification."
msgstr ""
"បង្វិលលិបិក្រមនៃ node [Bone2D] ដែលកំពុងត្រូវបានប្រើជាឆ្អឹងទីមួយនៅក្នុង TwoBoneIK modification។"

msgid ""
"Returns the [Bone2D] node that is being used as the second bone in the "
"TwoBoneIK modification."
msgstr "បង្វិល node [Bone2D] ដែលកំពុងត្រូវបានប្រើជាឆ្អឹងទីពីរនៅក្នុង TwoBoneIK modification។"

msgid ""
"Returns the index of the [Bone2D] node that is being used as the second bone "
"in the TwoBoneIK modification."
msgstr ""
"បង្វិលលិបិក្រមនៃ node [Bone2D] ដែលកំពុងត្រូវបានប្រើជាឆ្អឹងទីពីរនៅក្នុង TwoBoneIK modification។"

msgid ""
"Sets the [Bone2D] node that is being used as the first bone in the TwoBoneIK "
"modification."
msgstr "កំណត់ node [Bone2D] ដែលកំពុងត្រូវបានប្រើជាឆ្អឹងទីមួយនៅក្នុង TwoBoneIK modification។"

msgid ""
"Sets the index of the [Bone2D] node that is being used as the first bone in "
"the TwoBoneIK modification."
msgstr ""
"កំណត់លិបិក្រមនៃ node [Bone2D] ដែលកំពុងត្រូវបានប្រើជាឆ្អឹងទីមួយនៅក្នុង TwoBoneIK modification។"

msgid ""
"Sets the [Bone2D] node that is being used as the second bone in the TwoBoneIK "
"modification."
msgstr "កំណត់ node [Bone2D] ដែលកំពុងត្រូវបានប្រើជាឆ្អឹងទីពីរនៅក្នុង TwoBoneIK modification។"

msgid ""
"Sets the index of the [Bone2D] node that is being used as the second bone in "
"the TwoBoneIK modification."
msgstr ""
"កំណត់លិបិក្រមនៃ node [Bone2D] ដែលកំពុងត្រូវបានប្រើជាឆ្អឹងទីពីរនៅក្នុង TwoBoneIK modification។"

msgid ""
"If [code]true[/code], the bones in the modification will bend outward as "
"opposed to inwards when contracting. If [code]false[/code], the bones will "
"bend inwards when contracting."
msgstr ""
"ប្រសិនបើ [code]true[/code], ឆ្អឹងនៅក្នុង modification នេះនឹងពត់ទៅក្រៅ "
"ផ្ទុយពីការពត់ទៅក្នុងនៅពេល contracting។ ប្រសិនបើ [code]false[/code], ឆ្អឹងនឹងពត់ទៅក្នុងនៅពេល "
"contracting។"

msgid ""
"The maximum distance the target can be at. If the target is farther than this "
"distance, the modification will solve as if it's at this maximum distance. "
"When set to [code]0[/code], the modification will solve without distance "
"constraints."
msgstr ""
"ចម្ងាយអតិបរមាដែលគោលដៅអាចស្ថិតនៅ។ ប្រសិនបើគោលដៅនៅឆ្ងាយជាងចម្ងាយនេះ modification "
"នឹងដោះស្រាយដូចជាវានៅចម្ងាយអតិបរមានេះ។ នៅពេលកំណត់ទៅជា [code]0[/code], modification "
"នឹងដោះស្រាយដោយគ្មាន distance constraints។"

msgid ""
"The minimum distance the target can be at. If the target is closer than this "
"distance, the modification will solve as if it's at this minimum distance. "
"When set to [code]0[/code], the modification will solve without distance "
"constraints."
msgstr ""
"ចម្ងាយអប្បបរមាដែលគោលដៅអាចស្ថិតនៅ។ ប្រសិនបើគោលដៅនៅជិតជាងចម្ងាយនេះ modification "
"នឹងដោះស្រាយដូចជាវានៅចម្ងាយអប្បបរមានេះ។ នៅពេលកំណត់ទៅជា [code]0[/code], modification "
"នឹងដោះស្រាយដោយគ្មាន distance constraints។"

msgid ""
"The NodePath to the node that is the target for the TwoBoneIK modification. "
"This node is what the modification will use when bending the [Bone2D] nodes."
msgstr ""
"NodePath ទៅកាន់ node ដែលជាគោលដៅសម្រាប់ TwoBoneIK modification។ Node នេះគឺជាអ្វីដែល "
"modification នឹងប្រើនៅពេលពត់ node [Bone2D]។"

msgid "A resource that holds a stack of [SkeletonModification2D]s."
msgstr "ធនធានដែលទុក stack នៃ [SkeletonModification2D]s។"

msgid ""
"This resource is used by the Skeleton and holds a stack of "
"[SkeletonModification2D]s.\n"
"This controls the order of the modifications and how they are applied. "
"Modification order is especially important for full-body IK setups, as you "
"need to execute the modifications in the correct order to get the desired "
"results. For example, you want to execute a modification on the spine "
"[i]before[/i] the arms on a humanoid skeleton.\n"
"This resource also controls how strongly all of the modifications are applied "
"to the [Skeleton2D]."
msgstr ""
"ធនធាននេះត្រូវបានប្រើដោយ Skeleton ហើយទុក stack នៃ [SkeletonModification2D]s។\n"
"វាគ្រប់គ្រងលំដាប់នៃ modifications និងរបៀបដែលពួកវាត្រូវបានអនុវត្ត។ លំដាប់ Modification "
"មានសារៈសំខាន់ជាពិសេសសម្រាប់ការរៀបចំ full-body IK ព្រោះអ្នកត្រូវដំណើរការ modifications "
"តាមលំដាប់លំដោយត្រឹមត្រូវ ដើម្បីទទួលបានលទ្ធផលដែលចង់បាន។ ឧទាហរណ៍ អ្នកចង់ដំណើរការ modification "
"លើឆ្អឹងខ្នង [i]before[/i] (មុន) ដៃនៅលើ humanoid skeleton។\n"
"ធនធាននេះក៏គ្រប់គ្រងកម្រិតដែល modifications ទាំងអស់ត្រូវបានអនុវត្តទៅលើ [Skeleton2D] ផងដែរ។"

msgid "Adds the passed-in [SkeletonModification2D] to the stack."
msgstr "បន្ថែម [SkeletonModification2D] ដែលបានបញ្ជូនចូល ទៅកាន់ stack។"

msgid ""
"Deletes the [SkeletonModification2D] at the index position [param mod_idx], "
"if it exists."
msgstr "លុប [SkeletonModification2D] នៅទីតាំងលិបិក្រម [param mod_idx] ប្រសិនបើវាមាន។"

msgid "Enables all [SkeletonModification2D]s in the stack."
msgstr "បើក [SkeletonModification2D]s ទាំងអស់នៅក្នុង stack។"

msgid ""
"Executes all of the [SkeletonModification2D]s in the stack that use the same "
"execution mode as the passed-in [param execution_mode], starting from index "
"[code]0[/code] to [member modification_count].\n"
"[b]Note:[/b] The order of the modifications can matter depending on the "
"modifications. For example, modifications on a spine should operate before "
"modifications on the arms in order to get proper results."
msgstr ""
"ដំណើរការ [SkeletonModification2D]s ទាំងអស់នៅក្នុង stack ដែលប្រើ execution mode "
"ដូចគ្នានឹង [param execution_mode] ដែលបានបញ្ជូនចូល ចាប់ពីលិបិក្រម [code]0[/code] ដល់ "
"[member modification_count]។\n"
"[b]ចំណាំ៖[/b] លំដាប់នៃ modifications អាចមានសារៈសំខាន់អាស្រ័យលើ modifications។ ឧទាហរណ៍ "
"modifications លើឆ្អឹងខ្នងគួរតែដំណើរការមុន modifications លើដៃ ដើម្បីទទួលបានលទ្ធផលត្រឹមត្រូវ។"

msgid ""
"Returns a boolean that indicates whether the modification stack is setup and "
"can execute."
msgstr ""
"បង្វិល boolean ដែលបង្ហាញថាតើ modification stack ត្រូវបានរៀបចំ (setup) "
"និងអាចដំណើរការបានឬអត់។"

msgid ""
"Returns the [SkeletonModification2D] at the passed-in index, [param mod_idx]."
msgstr "បង្វិល [SkeletonModification2D] នៅលិបិក្រមដែលបានបញ្ជូនចូល [param mod_idx]។"

msgid ""
"Returns the [Skeleton2D] node that the SkeletonModificationStack2D is bound "
"to."
msgstr ""
"បង្វិល node [Skeleton2D] ដែល SkeletonModificationStack2D ត្រូវបានភ្ជាប់ (bound) ទៅ។"

msgid ""
"Sets the modification at [param mod_idx] to the passed-in modification, "
"[param modification]."
msgstr ""
"កំណត់ modification នៅ [param mod_idx] ទៅជា modification ដែលបានបញ្ជូនចូល [param "
"modification]។"

msgid ""
"Sets up the modification stack so it can execute. This function should be "
"called by [Skeleton2D] and shouldn't be manually called unless you know what "
"you are doing."
msgstr ""
"រៀបចំ (Sets up) modification stack ដើម្បីឱ្យវាអាចដំណើរការបាន។ "
"អនុគមន៍នេះគួរតែត្រូវបានហៅដោយ [Skeleton2D] ហើយមិនគួរត្រូវបានហៅដោយដៃទេ "
"លុះត្រាតែអ្នកដឹងពីអ្វីដែលអ្នកកំពុងធ្វើ។"

msgid "The number of modifications in the stack."
msgstr "ចំនួន modifications នៅក្នុង stack។"

msgid ""
"The interpolation strength of the modifications in stack. A value of [code]0[/"
"code] will make it where the modifications are not applied, a strength of "
"[code]0.5[/code] will be half applied, and a strength of [code]1[/code] will "
"allow the modifications to be fully applied and override the [Skeleton2D] "
"[Bone2D] poses."
msgstr ""
"កម្លាំង interpolation នៃ modifications នៅក្នុង stack។ តម្លៃ [code]0[/code] នឹងធ្វើឱ្យ "
"modifications មិនត្រូវបានអនុវត្ត កម្លាំង [code]0.5[/code] នឹងត្រូវបានអនុវត្តពាក់កណ្តាល "
"ហើយកម្លាំង [code]1[/code] នឹងអនុញ្ញាតឱ្យ modifications ត្រូវបានអនុវត្តពេញលេញ និង "
"override poses របស់ [Skeleton2D] [Bone2D]។"

msgid "A node that may modify a Skeleton3D's bones."
msgstr "Node ដែលអាចកែប្រែឆ្អឹងរបស់ Skeleton3D។"

msgid ""
"[SkeletonModifier3D] retrieves a target [Skeleton3D] by having a [Skeleton3D] "
"parent.\n"
"If there is an [AnimationMixer], a modification always performs after "
"playback process of the [AnimationMixer].\n"
"This node should be used to implement custom IK solvers, constraints, or "
"skeleton physics."
msgstr ""
"[SkeletonModifier3D] ទាញយក [Skeleton3D] គោលដៅដោយមានមេ [Skeleton3D]។\n"
"ប្រសិនបើមាន [AnimationMixer], modification តែងតែដំណើរការបន្ទាប់ពីដំណើរការ playback "
"នៃ [AnimationMixer]។\n"
"Node នេះគួរតែត្រូវបានប្រើដើម្បីអនុវត្ត custom IK solvers, constraints ឬ skeleton "
"physics។"

msgid "Design of the Skeleton Modifier 3D"
msgstr "ការរចនានៃ Skeleton Modifier 3D"

msgid "Use [method _process_modification_with_delta] instead."
msgstr "សូមប្រើ [method _process_modification_with_delta] ជំនួសវិញ។"

msgid ""
"Override this virtual method to implement a custom skeleton modifier. You "
"should do things like get the [Skeleton3D]'s current pose and apply the pose "
"here.\n"
"[method _process_modification] must not apply [member influence] to bone "
"poses because the [Skeleton3D] automatically applies influence to all bone "
"poses set by the modifier."
msgstr ""
"Override virtual method នេះដើម្បីអនុវត្ត custom skeleton modifier។ "
"អ្នកគួរតែធ្វើរឿងដូចជា ទាញយក pose បច្ចុប្បន្នរបស់ [Skeleton3D] ហើយអនុវត្ត pose នៅទីនេះ។\n"
"[method _process_modification] មិនត្រូវអនុវត្ត [member influence] ទៅលើ bone poses "
"ទេ ព្រោះ [Skeleton3D] អនុវត្ត influence ដោយស្វ័យប្រវត្តិទៅលើ bone poses "
"ទាំងអស់ដែលបានកំណត់ដោយ modifier។"

msgid ""
"Override this virtual method to implement a custom skeleton modifier. You "
"should do things like get the [Skeleton3D]'s current pose and apply the pose "
"here.\n"
"[method _process_modification_with_delta] must not apply [member influence] "
"to bone poses because the [Skeleton3D] automatically applies influence to all "
"bone poses set by the modifier.\n"
"[param delta] is passed from parent [Skeleton3D]. See also [method "
"Skeleton3D.advance].\n"
"[b]Note:[/b] This method may be called outside [method Node._process] and "
"[method Node._physics_process] with [param delta] is [code]0.0[/code], since "
"the modification should be processed immediately after initialization of the "
"[Skeleton3D]."
msgstr ""
"Override virtual method នេះដើម្បីអនុវត្ត custom skeleton modifier។ "
"អ្នកគួរតែធ្វើរឿងដូចជា ទាញយក pose បច្ចុប្បន្នរបស់ [Skeleton3D] ហើយអនុវត្ត pose នៅទីនេះ។\n"
"[method _process_modification_with_delta] មិនត្រូវអនុវត្ត [member influence] ទៅលើ "
"bone poses ទេ ព្រោះ [Skeleton3D] អនុវត្ត influence ដោយស្វ័យប្រវត្តិទៅលើ bone poses "
"ទាំងអស់ដែលបានកំណត់ដោយ modifier។\n"
"[param delta] ត្រូវបានបញ្ជូនពីមេ [Skeleton3D]។ សូមមើលផងដែរ [method "
"Skeleton3D.advance]។\n"
"[b]ចំណាំ៖[/b] វិធីសាស្រ្តនេះអាចត្រូវបានហៅនៅខាងក្រៅ [method Node._process] និង [method "
"Node._physics_process] ជាមួយនឹង [param delta] គឺ [code]0.0[/code] ព្រោះ "
"modification គួរតែត្រូវបានដំណើរការភ្លាមៗបន្ទាប់ពី initialization នៃ [Skeleton3D]។"

msgid "Called when the skeleton is changed."
msgstr "ត្រូវបានហៅនៅពេលដែល skeleton ត្រូវបានផ្លាស់ប្តូរ។"

msgid ""
"Called when bone names and indices need to be validated, such as when "
"entering the scene tree or changing skeleton."
msgstr ""
"ត្រូវបានហៅនៅពេលដែលឈ្មោះ និងលិបិក្រមឆ្អឹងត្រូវការផ្ទៀងផ្ទាត់ ដូចជានៅពេលចូលទៅក្នុង scene tree "
"ឬផ្លាស់ប្តូរ skeleton។"

msgid ""
"Returns the parent [Skeleton3D] node if it exists. Otherwise, returns "
"[code]null[/code]."
msgstr ""
"បង្វិល node មេ [Skeleton3D] ប្រសិនបើវាមាន។ បើមិនដូច្នោះទេ បង្វិល [code]null[/code]។"

msgid "If [code]true[/code], the [SkeletonModifier3D] will be processing."
msgstr "ប្រសិនបើ [code]true[/code], [SkeletonModifier3D] នឹងកំពុងដំណើរការ។"

msgid ""
"Sets the influence of the modification.\n"
"[b]Note:[/b] This value is used by [Skeleton3D] to blend, so the "
"[SkeletonModifier3D] should always apply only 100% of the result without "
"interpolation."
msgstr ""
"កំណត់ influence នៃ modification។\n"
"[b]ចំណាំ៖[/b] តម្លៃនេះត្រូវបានប្រើដោយ [Skeleton3D] ដើម្បី blend ដូច្នេះ "
"[SkeletonModifier3D] គួរតែអនុវត្តតែ 100% នៃលទ្ធផលដោយគ្មាន interpolation ជានិច្ច។"

msgid ""
"Notifies when the modification have been finished.\n"
"[b]Note:[/b] If you want to get the modified bone pose by the modifier, you "
"must use [method Skeleton3D.get_bone_pose] or [method "
"Skeleton3D.get_bone_global_pose] at the moment this signal is fired."
msgstr ""
"ជូនដំណឹងនៅពេលដែល modification បានបញ្ចប់។\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើអ្នកចង់ទទួលបាន modified bone pose ដោយ modifier អ្នកត្រូវតែប្រើ "
"[method Skeleton3D.get_bone_pose] ឬ [method Skeleton3D.get_bone_global_pose] "
"នៅពេលដែល signal នេះត្រូវបានបាញ់ចេញ។"

msgid "Enumerated value for the +X axis."
msgstr "តម្លៃ Enumerated សម្រាប់អ័ក្ស +X។"

msgid "Enumerated value for the -X axis."
msgstr "តម្លៃ Enumerated សម្រាប់អ័ក្ស -X។"

msgid "Enumerated value for the +Y axis."
msgstr "តម្លៃ Enumerated សម្រាប់អ័ក្ស +Y។"

msgid "Enumerated value for the -Y axis."
msgstr "តម្លៃ Enumerated សម្រាប់អ័ក្ស -Y។"

msgid "Enumerated value for the +Z axis."
msgstr "តម្លៃ Enumerated សម្រាប់អ័ក្ស +Z។"

msgid "Enumerated value for the -Z axis."
msgstr "តម្លៃ Enumerated សម្រាប់អ័ក្ស -Z។"

msgid "Enumerated value for the axis from a parent bone to the child bone."
msgstr "តម្លៃ Enumerated សម្រាប់អ័ក្សពីឆ្អឹងមេទៅកាន់ឆ្អឹងកូន។"

msgid "Enumerated value for the case when the axis is undefined."
msgstr "តម្លៃ Enumerated សម្រាប់ករណីនៅពេលដែលអ័ក្សមិនបានកំណត់ (undefined)។"

msgid "Enumerated value for an optional axis."
msgstr "តម្លៃ Enumerated សម្រាប់អ័ក្សជាជម្រើស (optional)។"

msgid "Enumerated value for the rotation of the X axis."
msgstr "តម្លៃ Enumerated សម្រាប់ rotation នៃអ័ក្ស X។"

msgid "Enumerated value for the rotation of the Y axis."
msgstr "តម្លៃ Enumerated សម្រាប់ rotation នៃអ័ក្ស Y។"

msgid "Enumerated value for the rotation of the Z axis."
msgstr "តម្លៃ Enumerated សម្រាប់ rotation នៃអ័ក្ស Z។"

msgid "Enumerated value for the unconstrained rotation."
msgstr "តម្លៃ Enumerated សម្រាប់ unconstrained rotation។"

msgid "Enumerated value for an optional rotation axis."
msgstr "តម្លៃ Enumerated សម្រាប់ rotation axis ជាជម្រើស។"

msgid ""
"Base class for a profile of a virtual skeleton used as a target for "
"retargeting."
msgstr ""
"Class មូលដ្ឋានសម្រាប់ profile នៃ virtual skeleton ដែលប្រើជាគោលដៅសម្រាប់ retargeting។"

msgid ""
"This resource is used in [EditorScenePostImport]. Some parameters are "
"referring to bones in [Skeleton3D], [Skin], [Animation], and some other nodes "
"are rewritten based on the parameters of [SkeletonProfile].\n"
"[b]Note:[/b] These parameters need to be set only when creating a custom "
"profile. In [SkeletonProfileHumanoid], they are defined internally as read-"
"only values."
msgstr ""
"ធនធាននេះត្រូវបានប្រើនៅក្នុង [EditorScenePostImport]។ ប៉ារ៉ាម៉ែត្រមួយចំនួនកំពុងយោងទៅឆ្អឹងនៅក្នុង "
"[Skeleton3D], [Skin], [Animation] ហើយ node "
"មួយចំនួនទៀតត្រូវបានសរសេរឡើងវិញដោយផ្អែកលើប៉ារ៉ាម៉ែត្រនៃ [SkeletonProfile]។\n"
"[b]ចំណាំ៖[/b] ប៉ារ៉ាម៉ែត្រទាំងនេះត្រូវកំណត់តែនៅពេលបង្កើត custom profile ប៉ុណ្ណោះ។ នៅក្នុង "
"[SkeletonProfileHumanoid] ពួកវាត្រូវបានកំណត់ខាងក្នុងជាតម្លៃ read-only។"

msgid "Returns the bone index that matches [param bone_name] as its name."
msgstr "បង្វិលលិបិក្រមឆ្អឹងដែលត្រូវនឹង [param bone_name] ជាឈ្មោះរបស់វា។"

msgid ""
"Returns the name of the bone at [param bone_idx] that will be the key name in "
"the [BoneMap].\n"
"In the retargeting process, the returned bone name is the bone name of the "
"target skeleton."
msgstr ""
"បង្វិលឈ្មោះនៃឆ្អឹងនៅ [param bone_idx] ដែលនឹងក្លាយជាឈ្មោះ key នៅក្នុង [BoneMap]។\n"
"នៅក្នុងដំណើរការ retargeting ឈ្មោះឆ្អឹងដែលបានបង្វិលគឺជាឈ្មោះឆ្អឹងនៃ target skeleton។"

msgid ""
"Returns the name of the bone which is the parent to the bone at [param "
"bone_idx]. The result is empty if the bone has no parent."
msgstr ""
"បង្វិលឈ្មោះនៃឆ្អឹងដែលជាមេទៅកាន់ឆ្អឹងនៅ [param bone_idx]។ លទ្ធផលគឺទទេ ប្រសិនបើឆ្អឹងគ្មានមេ។"

msgid ""
"Returns the name of the bone which is the tail of the bone at [param "
"bone_idx]."
msgstr "បង្វិលឈ្មោះនៃឆ្អឹងដែលជា tail នៃឆ្អឹងនៅ [param bone_idx]។"

msgid "Returns the group of the bone at [param bone_idx]."
msgstr "បង្វិល group នៃឆ្អឹងនៅ [param bone_idx]។"

msgid ""
"Returns the name of the group at [param group_idx] that will be the drawing "
"group in the [BoneMap] editor."
msgstr ""
"បង្វិលឈ្មោះនៃ group នៅ [param group_idx] ដែលនឹងក្លាយជា drawing group នៅក្នុង editor "
"[BoneMap]។"

msgid ""
"Returns the offset of the bone at [param bone_idx] that will be the button "
"position in the [BoneMap] editor.\n"
"This is the offset with origin at the top left corner of the square."
msgstr ""
"បង្វិល offset នៃឆ្អឹងនៅ [param bone_idx] ដែលនឹងក្លាយជាទីតាំង button នៅក្នុង editor "
"[BoneMap]។\n"
"នេះគឺជា offset ដែលមាន origin នៅជ្រុងខាងឆ្វេងផ្នែកខាងលើនៃការ៉េ។"

msgid "Returns the reference pose transform for bone [param bone_idx]."
msgstr "បង្វិល reference pose transform សម្រាប់ឆ្អឹង [param bone_idx]។"

msgid "Returns the tail direction of the bone at [param bone_idx]."
msgstr "បង្វិល tail direction នៃឆ្អឹងនៅ [param bone_idx]។"

msgid ""
"Returns the texture of the group at [param group_idx] that will be the "
"drawing group background image in the [BoneMap] editor."
msgstr ""
"បង្វិល texture នៃ group នៅ [param group_idx] ដែលនឹងក្លាយជា drawing group "
"background image នៅក្នុង editor [BoneMap]។"

msgid ""
"Returns whether the bone at [param bone_idx] is required for retargeting.\n"
"This value is used by the bone map editor. If this method returns [code]true[/"
"code], and no bone is assigned, the handle color will be red on the bone map "
"editor."
msgstr ""
"បង្វិលថាតើឆ្អឹងនៅ [param bone_idx] ត្រូវការសម្រាប់ retargeting ឬអត់។\n"
"តម្លៃនេះត្រូវបានប្រើដោយ bone map editor។ ប្រសិនបើវិធីសាស្រ្តនេះបង្វិល [code]true[/code] "
"ហើយគ្មានឆ្អឹងត្រូវបានកំណត់ទេ handle color នឹងមានពណ៌ក្រហមនៅលើ bone map editor។"

msgid ""
"Sets the name of the bone at [param bone_idx] that will be the key name in "
"the [BoneMap].\n"
"In the retargeting process, the setting bone name is the bone name of the "
"target skeleton."
msgstr ""
"កំណត់ឈ្មោះនៃឆ្អឹងនៅ [param bone_idx] ដែលនឹងក្លាយជាឈ្មោះ key នៅក្នុង [BoneMap]។\n"
"នៅក្នុងដំណើរការ retargeting ឈ្មោះឆ្អឹងដែលបានកំណត់គឺជាឈ្មោះឆ្អឹងនៃ target skeleton។"

msgid ""
"Sets the bone with name [param bone_parent] as the parent of the bone at "
"[param bone_idx]. If an empty string is passed, then the bone has no parent."
msgstr ""
"កំណត់ឆ្អឹងដែលមានឈ្មោះ [param bone_parent] ជាមេនៃឆ្អឹងនៅ [param bone_idx]។ ប្រសិនបើ "
"string ទទេត្រូវបានបញ្ជូន នោះឆ្អឹងគ្មានមេទេ។"

msgid ""
"Sets the bone with name [param bone_tail] as the tail of the bone at [param "
"bone_idx]."
msgstr "កំណត់ឆ្អឹងដែលមានឈ្មោះ [param bone_tail] ជា tail នៃឆ្អឹងនៅ [param bone_idx]។"

msgid "Sets the group of the bone at [param bone_idx]."
msgstr "កំណត់ group នៃឆ្អឹងនៅ [param bone_idx]។"

msgid ""
"Sets the name of the group at [param group_idx] that will be the drawing "
"group in the [BoneMap] editor."
msgstr ""
"កំណត់ឈ្មោះនៃ group នៅ [param group_idx] ដែលនឹងក្លាយជា drawing group នៅក្នុង editor "
"[BoneMap]។"

msgid ""
"Sets the offset of the bone at [param bone_idx] that will be the button "
"position in the [BoneMap] editor.\n"
"This is the offset with origin at the top left corner of the square."
msgstr ""
"កំណត់ offset នៃឆ្អឹងនៅ [param bone_idx] ដែលនឹងក្លាយជាទីតាំង button នៅក្នុង editor "
"[BoneMap]។\n"
"នេះគឺជា offset ដែលមាន origin នៅជ្រុងខាងឆ្វេងផ្នែកខាងលើនៃការ៉េ។"

msgid "Sets the reference pose transform for bone [param bone_idx]."
msgstr "កំណត់ reference pose transform សម្រាប់ឆ្អឹង [param bone_idx]។"

msgid "Sets the required status for bone [param bone_idx] to [param required]."
msgstr "កំណត់ required status សម្រាប់ឆ្អឹង [param bone_idx] ទៅជា [param required]។"

msgid ""
"Sets the tail direction of the bone at [param bone_idx].\n"
"[b]Note:[/b] This only specifies the method of calculation. The actual "
"coordinates required should be stored in an external skeleton, so the "
"calculation itself needs to be done externally."
msgstr ""
"កំណត់ tail direction នៃឆ្អឹងនៅ [param bone_idx]។\n"
"[b]ចំណាំ៖[/b] នេះគ្រាន់តែបញ្ជាក់ពីវិធីសាស្រ្តនៃការគណនាប៉ុណ្ណោះ។ "
"កូអរដោនេជាក់ស្តែងដែលត្រូវការគួរតែត្រូវបានរក្សាទុកនៅក្នុង skeleton ខាងក្រៅ "
"ដូច្នេះការគណនាដោយខ្លួនឯងត្រូវធ្វើឡើងនៅខាងក្រៅ។"

msgid ""
"Sets the texture of the group at [param group_idx] that will be the drawing "
"group background image in the [BoneMap] editor."
msgstr ""
"កំណត់ texture នៃ group នៅ [param group_idx] ដែលនឹងក្លាយជា drawing group "
"background image នៅក្នុង editor [BoneMap]។"

msgid ""
"The amount of groups of bones in retargeting section's [BoneMap] editor. For "
"example, [SkeletonProfileHumanoid] has 4 groups.\n"
"This property exists to separate the bone list into several sections in the "
"editor."
msgstr ""
"ចំនួន groups នៃឆ្អឹងនៅក្នុង editor [BoneMap] នៃផ្នែក retargeting។ ឧទាហរណ៍ "
"[SkeletonProfileHumanoid] មាន 4 groups។\n"
"Property នេះមានដើម្បីបំបែកបញ្ជីឆ្អឹងទៅជាផ្នែកជាច្រើននៅក្នុង editor។"

msgid ""
"A bone name that will be used as the root bone in [AnimationTree]. This "
"should be the bone of the parent of hips that exists at the world origin."
msgstr ""
"ឈ្មោះឆ្អឹងដែលនឹងត្រូវបានប្រើជា root bone នៅក្នុង [AnimationTree]។ នេះគួរតែជាឆ្អឹងនៃមេនៃ "
"hips ដែលមាននៅ world origin។"

msgid ""
"A bone name which will use model's height as the coefficient for "
"normalization. For example, [SkeletonProfileHumanoid] defines it as "
"[code]Hips[/code]."
msgstr ""
"ឈ្មោះឆ្អឹងដែលនឹងប្រើកម្ពស់របស់ model ជា coefficient សម្រាប់ normalization។ ឧទាហរណ៍ "
"[SkeletonProfileHumanoid] កំណត់វាថាជា [code]Hips[/code]។"

msgid ""
"This signal is emitted when change the value in profile. This is used to "
"update key name in the [BoneMap] and to redraw the [BoneMap] editor.\n"
"[b]Note:[/b] This signal is not connected directly to editor to simplify the "
"reference, instead it is passed on to editor through the [BoneMap]."
msgstr ""
"Signal នេះត្រូវបានបញ្ចេញនៅពេលផ្លាស់ប្តូរតម្លៃនៅក្នុង profile។ "
"នេះត្រូវបានប្រើដើម្បីធ្វើបច្ចុប្បន្នភាពឈ្មោះ key នៅក្នុង [BoneMap] និងគូរ editor [BoneMap] "
"ឡើងវិញ។\n"
"[b]ចំណាំ៖[/b] Signal នេះមិនត្រូវបានភ្ជាប់ដោយផ្ទាល់ទៅ editor ដើម្បីសម្រួលដល់ការយោងនោះទេ "
"ផ្ទុយទៅវិញវាត្រូវបានបញ្ជូនបន្តទៅ editor តាមរយៈ [BoneMap]។"

msgid "Direction to the average coordinates of bone children."
msgstr "ទិសដៅទៅកាន់កូអរដោនេមធ្យមនៃ bone children។"

msgid "Direction to the coordinates of specified bone child."
msgstr "ទិសដៅទៅកាន់កូអរដោនេនៃ bone child ដែលបានបញ្ជាក់។"

msgid "Direction is not calculated."
msgstr "ទិសដៅមិនត្រូវបានគណនាទេ។"

msgid "A humanoid [SkeletonProfile] preset."
msgstr "ការកំណត់ជាមុន (preset) នៃ [SkeletonProfile] បែប humanoid។"

msgid ""
"A [SkeletonProfile] as a preset that is optimized for the human form. This "
"exists for standardization, so all parameters are read-only.\n"
"A humanoid skeleton profile contains 56 bones divided into 4 groups: [code]"
"\"Body\"[/code], [code]\"Face\"[/code], [code]\"LeftHand\"[/code], and [code]"
"\"RightHand\"[/code]. It is structured as follows:\n"
"[codeblock lang=text]\n"
"Root\n"
"└─ Hips\n"
"    ├─ LeftUpperLeg\n"
"    │  └─ LeftLowerLeg\n"
"    │     └─ LeftFoot\n"
"    │        └─ LeftToes\n"
"    ├─ RightUpperLeg\n"
"    │  └─ RightLowerLeg\n"
"    │     └─ RightFoot\n"
"    │        └─ RightToes\n"
"    └─ Spine\n"
"        └─ Chest\n"
"            └─ UpperChest\n"
"                ├─ Neck\n"
"                │   └─ Head\n"
"                │       ├─ Jaw\n"
"                │       ├─ LeftEye\n"
"                │       └─ RightEye\n"
"                ├─ LeftShoulder\n"
"                │  └─ LeftUpperArm\n"
"                │     └─ LeftLowerArm\n"
"                │        └─ LeftHand\n"
"                │           ├─ LeftThumbMetacarpal\n"
"                │           │  └─ LeftThumbProximal\n"
"                │           │    └─ LeftThumbDistal\n"
"                │           ├─ LeftIndexProximal\n"
"                │           │  └─ LeftIndexIntermediate\n"
"                │           │    └─ LeftIndexDistal\n"
"                │           ├─ LeftMiddleProximal\n"
"                │           │  └─ LeftMiddleIntermediate\n"
"                │           │    └─ LeftMiddleDistal\n"
"                │           ├─ LeftRingProximal\n"
"                │           │  └─ LeftRingIntermediate\n"
"                │           │    └─ LeftRingDistal\n"
"                │           └─ LeftLittleProximal\n"
"                │              └─ LeftLittleIntermediate\n"
"                │                └─ LeftLittleDistal\n"
"                └─ RightShoulder\n"
"                   └─ RightUpperArm\n"
"                      └─ RightLowerArm\n"
"                         └─ RightHand\n"
"                            ├─ RightThumbMetacarpal\n"
"                            │  └─ RightThumbProximal\n"
"                            │     └─ RightThumbDistal\n"
"                            ├─ RightIndexProximal\n"
"                            │  └─ RightIndexIntermediate\n"
"                            │     └─ RightIndexDistal\n"
"                            ├─ RightMiddleProximal\n"
"                            │  └─ RightMiddleIntermediate\n"
"                            │     └─ RightMiddleDistal\n"
"                            ├─ RightRingProximal\n"
"                            │  └─ RightRingIntermediate\n"
"                            │     └─ RightRingDistal\n"
"                            └─ RightLittleProximal\n"
"                               └─ RightLittleIntermediate\n"
"                                 └─ RightLittleDistal\n"
"[/codeblock]"
msgstr ""
"[SkeletonProfile] ជាការកំណត់ជាមុនដែលត្រូវបានធ្វើឱ្យប្រសើរសម្រាប់ទម្រង់មនុស្ស។ "
"នេះមានសម្រាប់ការធ្វើស្តង់ដារ ដូច្នេះប៉ារ៉ាម៉ែត្រទាំងអស់គឺ read-only។\n"
"Humanoid skeleton profile មាន 56 ឆ្អឹង ដែលបែងចែកជា 4 groups៖ [code]\"Body\"[/"
"code], [code]\"Face\"[/code], [code]\"LeftHand\"[/code], និង [code]"
"\"RightHand\"[/code]។ វាត្រូវបានរៀបចំដូចខាងក្រោម៖\n"
"[codeblock lang=text]\n"
"Root\n"
"└─ Hips\n"
"    ├─ LeftUpperLeg\n"
"    │  └─ LeftLowerLeg\n"
"    │     └─ LeftFoot\n"
"    │        └─ LeftToes\n"
"    ├─ RightUpperLeg\n"
"    │  └─ RightLowerLeg\n"
"    │     └─ RightFoot\n"
"    │        └─ RightToes\n"
"    └─ Spine\n"
"        └─ Chest\n"
"            └─ UpperChest\n"
"                ├─ Neck\n"
"                │   └─ Head\n"
"                │       ├─ Jaw\n"
"                │       ├─ LeftEye\n"
"                │       └─ RightEye\n"
"                ├─ LeftShoulder\n"
"                │  └─ LeftUpperArm\n"
"                │     └─ LeftLowerArm\n"
"                │        └─ LeftHand\n"
"                │           ├─ LeftThumbMetacarpal\n"
"                │           │  └─ LeftThumbProximal\n"
"                │           │    └─ LeftThumbDistal\n"
"                │           ├─ LeftIndexProximal\n"
"                │           │  └─ LeftIndexIntermediate\n"
"                │           │    └─ LeftIndexDistal\n"
"                │           ├─ LeftMiddleProximal\n"
"                │           │  └─ LeftMiddleIntermediate\n"
"                │           │    └─ LeftMiddleDistal\n"
"                │           ├─ LeftRingProximal\n"
"                │           │  └─ LeftRingIntermediate\n"
"                │           │    └─ LeftRingDistal\n"
"                │           └─ LeftLittleProximal\n"
"                │              └─ LeftLittleIntermediate\n"
"                │                └─ LeftLittleDistal\n"
"                └─ RightShoulder\n"
"                   └─ RightUpperArm\n"
"                      └─ RightLowerArm\n"
"                         └─ RightHand\n"
"                            ├─ RightThumbMetacarpal\n"
"                            │  └─ RightThumbProximal\n"
"                            │     └─ RightThumbDistal\n"
"                            ├─ RightIndexProximal\n"
"                            │  └─ RightIndexIntermediate\n"
"                            │     └─ RightIndexDistal\n"
"                            ├─ RightMiddleProximal\n"
"                            │  └─ RightMiddleIntermediate\n"
"                            │     └─ RightMiddleDistal\n"
"                            ├─ RightRingProximal\n"
"                            │  └─ RightRingIntermediate\n"
"                            │     └─ RightRingDistal\n"
"                            └─ RightLittleProximal\n"
"                               └─ RightLittleIntermediate\n"
"                                 └─ RightLittleDistal\n"
"[/codeblock]"

msgid ""
"A reference-counted holder object for a skeleton RID used in the "
"[RenderingServer]."
msgstr ""
"Object ដែលកាន់កាប់ដោយ reference-counted សម្រាប់ skeleton RID ដែលប្រើក្នុង "
"[RenderingServer]។"

msgid ""
"An internal object containing a mapping from a [Skin] used within the context "
"of a particular [MeshInstance3D] to refer to the skeleton's [RID] in the "
"RenderingServer.\n"
"See also [method MeshInstance3D.get_skin_reference] and [method "
"RenderingServer.instance_attach_skeleton].\n"
"Note that despite the similar naming, the skeleton RID used in the "
"[RenderingServer] does not have a direct one-to-one correspondence to a "
"[Skeleton3D] node.\n"
"In particular, a [Skeleton3D] node with no [MeshInstance3D] children may be "
"unknown to the [RenderingServer].\n"
"On the other hand, a [Skeleton3D] with multiple [MeshInstance3D] nodes which "
"each have different [member MeshInstance3D.skin] objects may have multiple "
"SkinReference instances (and hence, multiple skeleton [RID]s)."
msgstr ""
"Object ខាងក្នុងដែលផ្ទុកការ map ពី [Skin] ដែលប្រើនៅក្នុងបរិបទនៃ [MeshInstance3D] "
"ជាក់លាក់មួយ ដើម្បីយោងទៅ [RID] របស់ skeleton នៅក្នុង RenderingServer។\n"
"សូមមើលផងដែរ [method MeshInstance3D.get_skin_reference] និង [method "
"RenderingServer.instance_attach_skeleton]។\n"
"ចំណាំថា ទោះបីជាមានឈ្មោះស្រដៀងគ្នាក៏ដោយ skeleton RID ដែលប្រើក្នុង [RenderingServer] "
"មិនមានទំនាក់ទំនងផ្ទាល់មួយទល់មួយ (one-to-one correspondence) ទៅកាន់ node [Skeleton3D] "
"ទេ។\n"
"ជាពិសេស node [Skeleton3D] ដែលគ្មានកូន [MeshInstance3D] អាចមិនត្រូវបានស្គាល់ដោយ "
"[RenderingServer]។\n"
"ម្យ៉ាងទៀត [Skeleton3D] ដែលមាន node [MeshInstance3D] ច្រើន ដែលនីមួយៗមាន object "
"[member MeshInstance3D.skin] ផ្សេងៗគ្នា អាចមាន instance SkinReference ច្រើន "
"(ហេតុនេះមាន skeleton [RID]s ច្រើន)។"

msgid ""
"Returns the [RID] owned by this SkinReference, as returned by [method "
"RenderingServer.skeleton_create]."
msgstr ""
"បង្វិល [RID] ដែលកាន់កាប់ដោយ SkinReference នេះ ដូចដែលបានបង្វិលដោយ [method "
"RenderingServer.skeleton_create]។"

msgid ""
"Returns the [Skin] connected to this SkinReference. In the case of "
"[MeshInstance3D] with no [member MeshInstance3D.skin] assigned, this will "
"reference an internal default [Skin] owned by that [MeshInstance3D].\n"
"Note that a single [Skin] may have more than one [SkinReference] in the case "
"that it is shared by meshes across multiple [Skeleton3D] nodes."
msgstr ""
"បង្វិល [Skin] ដែលបានភ្ជាប់ទៅ SkinReference នេះ។ ក្នុងករណី [MeshInstance3D] ដែលគ្មាន "
"[member MeshInstance3D.skin] ត្រូវបានកំណត់ វានឹងយោងទៅ [Skin] "
"លំនាំដើមខាងក្នុងដែលកាន់កាប់ដោយ [MeshInstance3D] នោះ។\n"
"ចំណាំថា [Skin] មួយអាចមាន [SkinReference] ច្រើនជាងមួយ ក្នុងករណីដែលវាត្រូវបានចែករំលែកដោយ "
"meshes ឆ្លងកាត់ node [Skeleton3D] ជាច្រើន។"

msgid "Defines a 3D environment's background by using a [Material]."
msgstr "កំណត់ផ្ទៃខាងក្រោយនៃបរិស្ថាន 3D ដោយប្រើ [Material]។"

msgid ""
"The [Sky] class uses a [Material] to render a 3D environment's background and "
"the light it emits by updating the reflection/radiance cubemaps."
msgstr ""
"Class [Sky] ប្រើ [Material] ដើម្បី render ផ្ទៃខាងក្រោយនៃបរិស្ថាន 3D និងពន្លឺដែលវាបញ្ចេញ "
"ដោយធ្វើបច្ចុប្បន្នភាព reflection/radiance cubemaps។"

msgid ""
"The method for generating the radiance map from the sky. The radiance map is "
"a cubemap with increasingly blurry versions of the sky corresponding to "
"different levels of roughness. Radiance maps can be expensive to calculate."
msgstr ""
"វិធីសាស្រ្តសម្រាប់បង្កើត radiance map ពី sky។ Radiance map គឺជា cubemap "
"ដែលមានកំណែព្រាលកាន់តែខ្លាំងឡើងៗនៃ sky ដែលត្រូវនឹងកម្រិត roughness ផ្សេងៗគ្នា។ Radiance "
"maps អាចចំណាយពេលគណនាច្រើន។"

msgid ""
"The [Sky]'s radiance map size. The higher the radiance map size, the more "
"detailed the lighting from the [Sky] will be.\n"
"[b]Note:[/b] Some hardware will have trouble with higher radiance sizes, "
"especially [constant RADIANCE_SIZE_512] and above. Only use such high values "
"on high-end hardware."
msgstr ""
"ទំហំ radiance map របស់ [Sky]។ ទំហំ radiance map កាន់តែធំ ពន្លឺពី [Sky] នឹងកាន់តែលម្អិត។\n"
"[b]ចំណាំ៖[/b] Hardware មួយចំនួននឹងមានបញ្ហាជាមួយទំហំ radiance ខ្ពស់ ជាពិសេស [constant "
"RADIANCE_SIZE_512] និងលើសពីនេះ។ សូមប្រើតែតម្លៃខ្ពស់បែបនេះនៅលើ hardware កម្រិតខ្ពស់ប៉ុណ្ណោះ។"

msgid ""
"[Material] used to draw the background. Can be [PanoramaSkyMaterial], "
"[ProceduralSkyMaterial], [PhysicalSkyMaterial], or even a [ShaderMaterial] if "
"you want to use your own custom shader."
msgstr ""
"[Material] ដែលប្រើសម្រាប់គូរផ្ទៃខាងក្រោយ។ អាចជា [PanoramaSkyMaterial], "
"[ProceduralSkyMaterial], [PhysicalSkyMaterial] ឬសូម្បីតែ [ShaderMaterial] "
"ប្រសិនបើអ្នកចង់ប្រើ custom shader ផ្ទាល់ខ្លួនរបស់អ្នក។"

msgid "Radiance texture size is 32×32 pixels."
msgstr "ទំហំ Radiance texture គឺ 32×32 pixels។"

msgid "Radiance texture size is 64×64 pixels."
msgstr "ទំហំ Radiance texture គឺ 64×64 pixels។"

msgid "Radiance texture size is 128×128 pixels."
msgstr "ទំហំ Radiance texture គឺ 128×128 pixels។"

msgid "Radiance texture size is 256×256 pixels."
msgstr "ទំហំ Radiance texture គឺ 256×256 pixels។"

msgid "Radiance texture size is 512×512 pixels."
msgstr "ទំហំ Radiance texture គឺ 512×512 pixels។"

msgid "Radiance texture size is 1024×1024 pixels."
msgstr "ទំហំ Radiance texture គឺ 1024×1024 pixels។"

msgid "Radiance texture size is 2048×2048 pixels."
msgstr "ទំហំ Radiance texture គឺ 2048×2048 pixels។"

msgid "Represents the size of the [enum RadianceSize] enum."
msgstr "តំណាងឱ្យទំហំនៃ [enum RadianceSize] enum។"

msgid ""
"Automatically selects the appropriate process mode based on your sky shader. "
"If your shader uses [code]TIME[/code] or [code]POSITION[/code], this will use "
"[constant PROCESS_MODE_REALTIME]. If your shader uses any of the "
"[code]LIGHT_*[/code] variables or any custom uniforms, this uses [constant "
"PROCESS_MODE_INCREMENTAL]. Otherwise, this defaults to [constant "
"PROCESS_MODE_QUALITY]."
msgstr ""
"ជ្រើសរើស process mode សមស្របដោយស្វ័យប្រវត្តិដោយផ្អែកលើ sky shader របស់អ្នក។ ប្រសិនបើ "
"shader របស់អ្នកប្រើ [code]TIME[/code] ឬ [code]POSITION[/code] វានឹងប្រើ [constant "
"PROCESS_MODE_REALTIME]។ ប្រសិនបើ shader របស់អ្នកប្រើអថេរ [code]LIGHT_*[/code] ណាមួយ "
"ឬ custom uniforms ណាមួយ វាប្រើ [constant PROCESS_MODE_INCREMENTAL]។ បើមិនដូច្នោះទេ "
"វាមានលំនាំដើមទៅជា [constant PROCESS_MODE_QUALITY]។"

msgid ""
"Uses high quality importance sampling to process the radiance map. In "
"general, this results in much higher quality than [constant "
"PROCESS_MODE_REALTIME] but takes much longer to generate. This should not be "
"used if you plan on changing the sky at runtime. If you are finding that the "
"reflection is not blurry enough and is showing sparkles or fireflies, try "
"increasing [member ProjectSettings.rendering/reflections/sky_reflections/"
"ggx_samples]."
msgstr ""
"ប្រើ high quality importance sampling ដើម្បីដំណើរការ radiance map។ ជាទូទៅ "
"វាផ្តល់គុណភាពខ្ពស់ជាង [constant PROCESS_MODE_REALTIME] ឆ្ងាយណាស់ "
"ប៉ុន្តែចំណាយពេលយូរជាងក្នុងការបង្កើត។ វាមិនគួរត្រូវបានប្រើទេ ប្រសិនបើអ្នកគ្រោងនឹងផ្លាស់ប្តូរ sky "
"នៅពេល runtime។ ប្រសិនបើអ្នករកឃើញថាការចាំងផ្លាត (reflection) មិនព្រាលគ្រប់គ្រាន់ "
"ហើយកំពុងបង្ហាញ sparkles ឬ fireflies សូមព្យាយាមបង្កើន [member "
"ProjectSettings.rendering/reflections/sky_reflections/ggx_samples]។"

msgid ""
"Uses the same high quality importance sampling to process the radiance map as "
"[constant PROCESS_MODE_QUALITY], but updates over several frames. The number "
"of frames is determined by [member ProjectSettings.rendering/reflections/"
"sky_reflections/roughness_layers]. Use this when you need highest quality "
"radiance maps, but have a sky that updates slowly."
msgstr ""
"ប្រើ high quality importance sampling ដូចគ្នាដើម្បីដំណើរការ radiance map ដូច "
"[constant PROCESS_MODE_QUALITY] ប៉ុន្តែធ្វើបច្ចុប្បន្នភាពលើ frames ជាច្រើន។ ចំនួន frames "
"ត្រូវបានកំណត់ដោយ [member ProjectSettings.rendering/reflections/sky_reflections/"
"roughness_layers]។ ប្រើវានៅពេលអ្នកត្រូវការ radiance maps ដែលមានគុណភាពខ្ពស់បំផុត "
"ប៉ុន្តែមាន sky ដែលធ្វើបច្ចុប្បន្នភាពយឺត។"

msgid ""
"Uses the fast filtering algorithm to process the radiance map. In general "
"this results in lower quality, but substantially faster run times. If you "
"need better quality, but still need to update the sky every frame, consider "
"turning on [member ProjectSettings.rendering/reflections/sky_reflections/"
"fast_filter_high_quality].\n"
"[b]Note:[/b] The fast filtering algorithm is limited to 256×256 cubemaps, so "
"[member radiance_size] must be set to [constant RADIANCE_SIZE_256]. "
"Otherwise, a warning is printed and the overridden radiance size is ignored."
msgstr ""
"ប្រើ fast filtering algorithm ដើម្បីដំណើរការ radiance map។ ជាទូទៅ វាផ្តល់គុណភាពទាបជាង "
"ប៉ុន្តែពេលវេលាដំណើរការលឿនជាងឆ្ងាយ។ ប្រសិនបើអ្នកត្រូវការគុណភាពល្អជាងនេះ "
"ប៉ុន្តែនៅតែត្រូវធ្វើបច្ចុប្បន្នភាព sky រាល់ frame សូមពិចារណាបើក [member "
"ProjectSettings.rendering/reflections/sky_reflections/"
"fast_filter_high_quality]។\n"
"[b]ចំណាំ៖[/b] Fast filtering algorithm ត្រូវបានកំណត់ត្រឹម 256×256 cubemaps ដូច្នេះ "
"[member radiance_size] ត្រូវតែកំណត់ទៅជា [constant RADIANCE_SIZE_256]។ បើមិនដូច្នោះទេ "
"ការព្រមានត្រូវបានបោះពុម្ព ហើយទំហំ radiance ដែលបាន override ត្រូវបានមិនអើពើ។"

msgid "Abstract base class for sliders."
msgstr "Abstract base class សម្រាប់ sliders។"

msgid ""
"Abstract base class for sliders, used to adjust a value by moving a grabber "
"along a horizontal or vertical axis. Sliders are [Range]-based controls."
msgstr ""
"Abstract base class សម្រាប់ sliders ដែលប្រើដើម្បីកែតម្រូវតម្លៃដោយផ្លាស់ទី grabber "
"តាមបណ្តោយអ័ក្សផ្តេក ឬបញ្ឈរ។ Sliders គឺជា controls ផ្អែកលើ [Range]។"

msgid ""
"If [code]true[/code], the slider can be interacted with. If [code]false[/"
"code], the value can be changed only by code."
msgstr ""
"ប្រសិនបើ [code]true[/code], slider អាចត្រូវបានធ្វើអន្តរកម្ម។ ប្រសិនបើ [code]false[/"
"code], តម្លៃអាចត្រូវបានផ្លាស់ប្តូរតែដោយកូដប៉ុណ្ណោះ។"

msgid "If [code]true[/code], the value can be changed using the mouse wheel."
msgstr "ប្រសិនបើ [code]true[/code], តម្លៃអាចត្រូវបានផ្លាស់ប្តូរដោយប្រើ mouse wheel។"

msgid ""
"Number of ticks displayed on the slider, including border ticks. Ticks are "
"uniformly-distributed value markers."
msgstr ""
"ចំនួន ticks ដែលបង្ហាញនៅលើ slider រួមទាំង border ticks។ Ticks "
"គឺជាសញ្ញាសម្គាល់តម្លៃដែលចែកចាយស្មើៗគ្នា (uniformly-distributed)។"

msgid ""
"If [code]true[/code], the slider will display ticks for minimum and maximum "
"values."
msgstr ""
"ប្រសិនបើ [code]true[/code], slider នឹងបង្ហាញ ticks សម្រាប់តម្លៃអប្បបរមា និងអតិបរមា។"

msgid "Sets the position of the ticks. See [enum TickPosition] for details."
msgstr "កំណត់ទីតាំងនៃ ticks។ សូមមើល [enum TickPosition] សម្រាប់ព័ត៌មានលម្អិត។"

msgid ""
"Emitted when the grabber stops being dragged. If [param value_changed] is "
"[code]true[/code], [member Range.value] is different from the value when the "
"dragging was started."
msgstr ""
"បញ្ចេញនៅពេលដែល grabber ឈប់ត្រូវបានអូស។ ប្រសិនបើ [param value_changed] គឺ [code]true[/"
"code], [member Range.value] គឺខុសពីតម្លៃនៅពេលដែលការអូសបានចាប់ផ្តើម។"

msgid ""
"Emitted when the grabber starts being dragged. This is emitted before the "
"corresponding [signal Range.value_changed] signal."
msgstr ""
"បញ្ចេញនៅពេលដែល grabber ចាប់ផ្តើមត្រូវបានអូស។ នេះត្រូវបានបញ្ចេញមុន [signal "
"Range.value_changed] ដែល ត្រូវគ្នា។"

msgid ""
"Places the ticks at the bottom of the [HSlider], or right of the [VSlider]."
msgstr "ដាក់ ticks នៅផ្នែកខាងក្រោមនៃ [HSlider] ឬខាងស្តាំនៃ [VSlider]។"

msgid "Places the ticks at the top of the [HSlider], or left of the [VSlider]."
msgstr "ដាក់ ticks នៅផ្នែកខាងលើនៃ [HSlider] ឬខាងឆ្វេងនៃ [VSlider]។"

msgid "Places the ticks at the both sides of the slider."
msgstr "ដាក់ ticks នៅសងខាងនៃ slider។"

msgid "Places the ticks at the center of the slider."
msgstr "ដាក់ ticks នៅចំកណ្តាលនៃ slider។"

msgid ""
"Boolean constant. If [code]1[/code], the grabber texture size will be ignored "
"and it will fit within slider's bounds based only on its center position."
msgstr ""
"ថេរ Boolean។ ប្រសិនបើ [code]1[/code], ទំហំ grabber texture នឹងត្រូវបានមិនអើពើ "
"ហើយវានឹងសមនឹង bounds របស់ slider ដោយផ្អែកតែលើទីតាំងកណ្តាលរបស់វាប៉ុណ្ណោះ។"

msgid "Vertical or horizontal offset of the grabber."
msgstr "Offset បញ្ឈរ ឬផ្តេកនៃ grabber។"

msgid ""
"Vertical or horizontal offset of the ticks. The offset is reversed for top or "
"left ticks."
msgstr ""
"Offset បញ្ឈរ ឬផ្តេកនៃ ticks។ Offset ត្រូវបានបញ្ច្រាសសម្រាប់ ticks នៅខាងលើ ឬខាងឆ្វេង។"

msgid "The texture for the grabber (the draggable element)."
msgstr "Texture សម្រាប់ grabber (ធាតុដែលអាចអូសបាន)។"

msgid "The texture for the grabber when it's disabled."
msgstr "Texture សម្រាប់ grabber នៅពេលវាត្រូវបានបិទ។"

msgid "The texture for the grabber when it's focused."
msgstr "Texture សម្រាប់ grabber នៅពេលវាត្រូវបាន focus។"

msgid ""
"The texture for the ticks, visible when [member Slider.tick_count] is greater "
"than 0."
msgstr "Texture សម្រាប់ ticks ដែលមើលឃើញនៅពេល [member Slider.tick_count] ធំជាង 0។"

msgid "The background of the area to the left or bottom of the grabber."
msgstr "ផ្ទៃខាងក្រោយនៃផ្ទៃនៅខាងឆ្វេង ឬខាងក្រោមនៃ grabber។"

msgid ""
"The background of the area to the left or bottom of the grabber that displays "
"when it's being hovered or focused."
msgstr ""
"ផ្ទៃខាងក្រោយនៃផ្ទៃនៅខាងឆ្វេង ឬខាងក្រោមនៃ grabber ដែលបង្ហាញនៅពេលវាត្រូវបាន hover ឬ "
"focus។"

msgid ""
"The background for the whole slider. Affects the height or width of the "
"[theme_item grabber_area]."
msgstr ""
"ផ្ទៃខាងក្រោយសម្រាប់ slider ទាំងមូល។ ប៉ះពាល់ដល់កម្ពស់ ឬទទឹងនៃ [theme_item grabber_area]។"

msgid ""
"A physics joint that restricts the movement of a 3D physics body along an "
"axis relative to another physics body."
msgstr ""
"Physics joint ដែលរឹតបន្តឹងចលនានៃ 3D physics body តាមបណ្តោយអ័ក្សធៀបនឹង physics body "
"មួយទៀត។"

msgid ""
"A physics joint that restricts the movement of a 3D physics body along an "
"axis relative to another physics body. For example, Body A could be a "
"[StaticBody3D] representing a piston base, while Body B could be a "
"[RigidBody3D] representing the piston head, moving up and down."
msgstr ""
"Physics joint ដែលរឹតបន្តឹងចលនានៃ 3D physics body តាមបណ្តោយអ័ក្សធៀបនឹង physics body "
"មួយទៀត។ ឧទាហរណ៍ Body A អាចជា [StaticBody3D] ដែលតំណាងឱ្យ piston base ខណៈពេលដែល "
"Body B អាចជា [RigidBody3D] ដែលតំណាងឱ្យ piston head ដោយផ្លាស់ទីឡើងចុះ។"

msgid "Returns the value of the given parameter."
msgstr "បង្វិលតម្លៃនៃប៉ារ៉ាម៉ែត្រដែលបានផ្តល់ឱ្យ។"

msgid "Assigns [param value] to the given parameter."
msgstr "កំណត់ [param value] ទៅកាន់ប៉ារ៉ាម៉ែត្រដែលបានផ្តល់ឱ្យ។"

msgid ""
"The amount of damping of the rotation when the limit is surpassed.\n"
"A lower damping value allows a rotation initiated by body A to travel to body "
"B slower."
msgstr ""
"បរិមាណនៃការរំងាប់ (damping) នៃការបង្វិលនៅពេលដែលលើសពីកម្រិតកំណត់។\n"
"តម្លៃរំងាប់កាន់តែទាប អនុញ្ញាតឱ្យការបង្វិលដែលចាប់ផ្តើមដោយ body A ធ្វើចលនាទៅកាន់ body B "
"យឺតជាងមុន។"

msgid "The lower limit of rotation in the slider."
msgstr "កម្រិតកំណត់ទាបបំផុតនៃការបង្វិលនៅក្នុង slider។"

msgid ""
"The amount of restitution of the rotation when the limit is surpassed.\n"
"Does not affect damping."
msgstr ""
"បរិមាណនៃការស្តារ (restitution) នៃការបង្វិលនៅពេលដែលលើសពីកម្រិតកំណត់។\n"
"មិនប៉ះពាល់ដល់ការរំងាប់ (damping) ទេ។"

msgid ""
"A factor applied to the all rotation once the limit is surpassed.\n"
"Makes all rotation slower when between 0 and 1."
msgstr ""
"កត្តាដែលអនុវត្តលើការបង្វិលទាំងអស់នៅពេលដែលលើសពីកម្រិតកំណត់។\n"
"ធ្វើឱ្យការបង្វិលទាំងអស់យឺតជាងមុននៅពេលមានតម្លៃចន្លោះពី 0 និង 1។"

msgid "The upper limit of rotation in the slider."
msgstr "កម្រិតកំណត់ខ្ពស់បំផុតនៃការបង្វិលនៅក្នុង slider។"

msgid "The amount of damping of the rotation in the limits."
msgstr "បរិមាណនៃការរំងាប់ (damping) នៃការបង្វិលនៅក្នុងកម្រិតកំណត់។"

msgid "The amount of restitution of the rotation in the limits."
msgstr "បរិមាណនៃការស្តារ (restitution) នៃការបង្វិលនៅក្នុងកម្រិតកំណត់។"

msgid "A factor applied to the all rotation in the limits."
msgstr "កត្តាដែលអនុវត្តលើការបង្វិលទាំងអស់នៅក្នុងកម្រិតកំណត់។"

msgid ""
"The amount of damping of the rotation across axes orthogonal to the slider."
msgstr "បរិមាណនៃការរំងាប់ (damping) នៃការបង្វិលឆ្លងកាត់អ័ក្សដែលកែងនឹង slider។"

msgid ""
"The amount of restitution of the rotation across axes orthogonal to the "
"slider."
msgstr "បរិមាណនៃការស្តារ (restitution) នៃការបង្វិលឆ្លងកាត់អ័ក្សដែលកែងនឹង slider។"

msgid ""
"A factor applied to the all rotation across axes orthogonal to the slider."
msgstr "កត្តាដែលអនុវត្តលើការបង្វិលទាំងអស់ឆ្លងកាត់អ័ក្សដែលកែងនឹង slider។"

msgid ""
"The amount of damping that happens once the limit defined by [member "
"linear_limit/lower_distance] and [member linear_limit/upper_distance] is "
"surpassed."
msgstr ""
"បរិមាណនៃការរំងាប់ (damping) ដែលកើតឡើងនៅពេលដែលកម្រិតកំណត់ដោយ [member linear_limit/"
"lower_distance] និង [member linear_limit/upper_distance] ត្រូវបានលើស។"

msgid ""
"The amount of restitution once the limits are surpassed. The lower, the more "
"velocity-energy gets lost."
msgstr ""
"បរិមាណនៃការស្តារ (restitution) នៅពេលដែលលើសពីកម្រិតកំណត់។ តម្លៃកាន់តែទាប "
"ថាមពលល្បឿនកាន់តែបាត់បង់ច្រើន។"

msgid ""
"A factor applied to the movement across the slider axis once the limits get "
"surpassed. The lower, the slower the movement."
msgstr ""
"កត្តាដែលអនុវត្តលើចលនាឆ្លងកាត់អ័ក្ស slider នៅពេលដែលលើសពីកម្រិតកំណត់។ តម្លៃកាន់តែទាប "
"ចលនាកាន់តែយឺត។"

msgid "The amount of damping inside the slider limits."
msgstr "បរិមាណនៃការរំងាប់ (damping) នៅខាងក្នុងកម្រិតកំណត់ slider។"

msgid "The amount of restitution inside the slider limits."
msgstr "បរិមាណនៃការស្តារ (restitution) នៅខាងក្នុងកម្រិតកំណត់ slider។"

msgid ""
"A factor applied to the movement across the slider axis as long as the slider "
"is in the limits. The lower, the slower the movement."
msgstr ""
"កត្តាដែលអនុវត្តលើចលនាឆ្លងកាត់អ័ក្ស slider ដរាបណា slider នៅក្នុងកម្រិតកំណត់។ តម្លៃកាន់តែទាប "
"ចលនាកាន់តែយឺត។"

msgid ""
"The amount of damping when movement is across axes orthogonal to the slider."
msgstr "បរិមាណនៃការរំងាប់ (damping) នៅពេលដែលចលនាឆ្លងកាត់អ័ក្សដែលកែងនឹង slider។"

msgid ""
"The amount of restitution when movement is across axes orthogonal to the "
"slider."
msgstr "បរិមាណនៃការស្តារ (restitution) នៅពេលដែលចលនាឆ្លងកាត់អ័ក្សដែលកែងនឹង slider។"

msgid "A factor applied to the movement across axes orthogonal to the slider."
msgstr "កត្តាដែលអនុវត្តលើចលនាឆ្លងកាត់អ័ក្សដែលកែងនឹង slider។"

msgid ""
"Constant for accessing [member linear_limit/upper_distance]. The maximum "
"difference between the pivot points on their X axis before damping happens."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member linear_limit/upper_distance]។ "
"ភាពខុសគ្នាអតិបរមារវាងចំណុចគន្លឹះ (pivot points) នៅលើអ័ក្ស X របស់វា មុនពេលការរំងាប់ "
"(damping) កើតឡើង។"

msgid ""
"Constant for accessing [member linear_limit/lower_distance]. The minimum "
"difference between the pivot points on their X axis before damping happens."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member linear_limit/lower_distance]។ "
"ភាពខុសគ្នាអប្បបរមារវាងចំណុចគន្លឹះ (pivot points) នៅលើអ័ក្ស X របស់វា មុនពេលការរំងាប់ "
"(damping) កើតឡើង។"

msgid ""
"Constant for accessing [member linear_limit/softness]. A factor applied to "
"the movement across the slider axis once the limits get surpassed. The lower, "
"the slower the movement."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member linear_limit/softness]។ "
"កត្តាដែលអនុវត្តលើចលនាឆ្លងកាត់អ័ក្ស slider នៅពេលដែលលើសពីកម្រិតកំណត់។ តម្លៃកាន់តែទាប "
"ចលនាកាន់តែយឺត។"

msgid ""
"Constant for accessing [member linear_limit/restitution]. The amount of "
"restitution once the limits are surpassed. The lower, the more velocity-"
"energy gets lost."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member linear_limit/restitution]។ បរិមាណនៃការស្តារ "
"(restitution) នៅពេលដែលលើសពីកម្រិតកំណត់។ តម្លៃកាន់តែទាប ថាមពលល្បឿនកាន់តែបាត់បង់ច្រើន។"

msgid ""
"Constant for accessing [member linear_limit/damping]. The amount of damping "
"once the slider limits are surpassed."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member linear_limit/damping]។ បរិមាណនៃការរំងាប់ "
"(damping) នៅពេលដែលលើសពីកម្រិតកំណត់ slider។"

msgid ""
"Constant for accessing [member linear_motion/softness]. A factor applied to "
"the movement across the slider axis as long as the slider is in the limits. "
"The lower, the slower the movement."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member linear_motion/softness]។ "
"កត្តាដែលអនុវត្តលើចលនាឆ្លងកាត់អ័ក្ស slider ដរាបណា slider នៅក្នុងកម្រិតកំណត់។ តម្លៃកាន់តែទាប "
"ចលនាកាន់តែយឺត។"

msgid ""
"Constant for accessing [member linear_motion/restitution]. The amount of "
"restitution inside the slider limits."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member linear_motion/restitution]។ បរិមាណនៃការស្តារ "
"(restitution) នៅខាងក្នុងកម្រិតកំណត់ slider។"

msgid ""
"Constant for accessing [member linear_motion/damping]. The amount of damping "
"inside the slider limits."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member linear_motion/damping]។ បរិមាណនៃការរំងាប់ "
"(damping) នៅខាងក្នុងកម្រិតកំណត់ slider។"

msgid ""
"Constant for accessing [member linear_ortho/softness]. A factor applied to "
"the movement across axes orthogonal to the slider."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member linear_ortho/softness]។ "
"កត្តាដែលអនុវត្តលើចលនាឆ្លងកាត់អ័ក្សដែលកែងនឹង slider។"

msgid ""
"Constant for accessing [member linear_motion/restitution]. The amount of "
"restitution when movement is across axes orthogonal to the slider."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member linear_motion/restitution]។ បរិមាណនៃការស្តារ "
"(restitution) នៅពេលដែលចលនាឆ្លងកាត់អ័ក្សដែលកែងនឹង slider។"

msgid ""
"Constant for accessing [member linear_motion/damping]. The amount of damping "
"when movement is across axes orthogonal to the slider."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member linear_motion/damping]។ បរិមាណនៃការរំងាប់ "
"(damping) នៅពេលដែលចលនាឆ្លងកាត់អ័ក្សដែលកែងនឹង slider។"

msgid ""
"Constant for accessing [member angular_limit/upper_angle]. The upper limit of "
"rotation in the slider."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member angular_limit/upper_angle]។ "
"កម្រិតកំណត់ខ្ពស់បំផុតនៃការបង្វិលនៅក្នុង slider។"

msgid ""
"Constant for accessing [member angular_limit/lower_angle]. The lower limit of "
"rotation in the slider."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member angular_limit/lower_angle]។ "
"កម្រិតកំណត់ទាបបំផុតនៃការបង្វិលនៅក្នុង slider។"

msgid ""
"Constant for accessing [member angular_limit/softness]. A factor applied to "
"the all rotation once the limit is surpassed."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member angular_limit/softness]។ "
"កត្តាដែលអនុវត្តលើការបង្វិលទាំងអស់នៅពេលដែលលើសពីកម្រិតកំណត់។"

msgid ""
"Constant for accessing [member angular_limit/restitution]. The amount of "
"restitution of the rotation when the limit is surpassed."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member angular_limit/restitution]។ បរិមាណនៃការស្តារ "
"(restitution) នៃការបង្វិលនៅពេលដែលលើសពីកម្រិតកំណត់។"

msgid ""
"Constant for accessing [member angular_limit/damping]. The amount of damping "
"of the rotation when the limit is surpassed."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member angular_limit/damping]។ បរិមាណនៃការរំងាប់ "
"(damping) នៃការបង្វិលនៅពេលដែលលើសពីកម្រិតកំណត់។"

msgid ""
"Constant for accessing [member angular_motion/softness]. A factor applied to "
"the all rotation in the limits."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member angular_motion/softness]។ "
"កត្តាដែលអនុវត្តលើការបង្វិលទាំងអស់នៅក្នុងកម្រិតកំណត់។"

msgid ""
"Constant for accessing [member angular_motion/restitution]. The amount of "
"restitution of the rotation in the limits."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member angular_motion/restitution]។ បរិមាណនៃការស្តារ "
"(restitution) នៃការបង្វិលនៅក្នុងកម្រិតកំណត់។"

msgid ""
"Constant for accessing [member angular_motion/damping]. The amount of damping "
"of the rotation in the limits."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member angular_motion/damping]។ បរិមាណនៃការរំងាប់ "
"(damping) នៃការបង្វិលនៅក្នុងកម្រិតកំណត់។"

msgid ""
"Constant for accessing [member angular_ortho/softness]. A factor applied to "
"the all rotation across axes orthogonal to the slider."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member angular_ortho/softness]។ "
"កត្តាដែលអនុវត្តលើការបង្វិលទាំងអស់ឆ្លងកាត់អ័ក្សដែលកែងនឹង slider។"

msgid ""
"Constant for accessing [member angular_ortho/restitution]. The amount of "
"restitution of the rotation across axes orthogonal to the slider."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member angular_ortho/restitution]។ បរិមាណនៃការស្តារ "
"(restitution) នៃការបង្វិលឆ្លងកាត់អ័ក្សដែលកែងនឹង slider។"

msgid ""
"Constant for accessing [member angular_ortho/damping]. The amount of damping "
"of the rotation across axes orthogonal to the slider."
msgstr ""
"ថេរ (Constant) សម្រាប់ចូលប្រើ [member angular_ortho/damping]។ បរិមាណនៃការរំងាប់ "
"(damping) នៃការបង្វិលឆ្លងកាត់អ័ក្សដែលកែងនឹង slider។"

msgid "An abstract class for servers based on sockets."
msgstr "ក្លាសអរូបី (abstract class) សម្រាប់ម៉ាស៊ីនមេដែលផ្អែកលើ sockets។"

msgid "A socket server."
msgstr "ម៉ាស៊ីនមេ socket។"

msgid "Returns [code]true[/code] if a connection is available for taking."
msgstr "ត្រឡប់ [code]true[/code] ប្រសិនបើមានការតភ្ជាប់ដែលអាចទទួលយកបាន។"

msgid ""
"Returns [code]true[/code] if the server is currently listening for "
"connections."
msgstr "ត្រឡប់ [code]true[/code] ប្រសិនបើម៉ាស៊ីនមេកំពុងស្តាប់រកការតភ្ជាប់។"

msgid "Stops listening."
msgstr "បញ្ឈប់ការស្តាប់។"

msgid ""
"If a connection is available, returns a StreamPeerSocket with the connection."
msgstr "ប្រសិនបើមានការតភ្ជាប់ វានឹងត្រឡប់ StreamPeerSocket ជាមួយនឹងការតភ្ជាប់នោះ។"

msgid "A deformable 3D physics mesh."
msgstr "ម៉ាស (mesh) រូបវិទ្យា 3D ដែលអាចបត់បែនបាន។"

msgid "SoftBody"
msgstr "SoftBody"

msgid "Returns the internal [RID] used by the [PhysicsServer3D] for this body."
msgstr "ត្រឡប់ [RID] ខាងក្នុងដែលប្រើដោយ [PhysicsServer3D] សម្រាប់ body នេះ។"

msgid "Returns local translation of a vertex in the surface array."
msgstr "ត្រឡប់ការផ្លាស់ទីក្នុងតំបន់ (local translation) នៃ vertex នៅក្នុង surface array។"

msgid "Returns [code]true[/code] if vertex is set to pinned."
msgstr "ត្រឡប់ [code]true[/code] ប្រសិនបើ vertex ត្រូវបានកំណត់ជា pinned (ជាប់)។"

msgid ""
"Sets the pinned state of a surface vertex. When set to [code]true[/code], the "
"optional [param attachment_path] can define a [Node3D] the pinned vertex will "
"be attached to."
msgstr ""
"កំណត់ស្ថានភាព pinned នៃ surface vertex។ នៅពេលកំណត់ជា [code]true[/code] [param "
"attachment_path] ជាជម្រើសអាចកំណត់ [Node3D] ដែល pinned vertex នឹងត្រូវភ្ជាប់ទៅ។"

msgid ""
"The physics layers this SoftBody3D [b]is in[/b]. Collision objects can exist "
"in one or more of 32 different layers. See also [member collision_mask].\n"
"[b]Note:[/b] Object A can detect a contact with object B only if object B is "
"in any of the layers that object A scans. See [url=$DOCS_URL/tutorials/"
"physics/physics_introduction.html#collision-layers-and-masks]Collision layers "
"and masks[/url] in the documentation for more information."
msgstr ""
"ស្រទាប់រូបវិទ្យាដែល SoftBody3D នេះ [b]ស្ថិតនៅ[/b]។ វត្ថុប៉ះទង្គិច (Collision objects) "
"អាចមាននៅក្នុងស្រទាប់មួយ ឬច្រើនក្នុងចំណោម 32 ស្រទាប់ផ្សេងគ្នា។ សូមមើលផងដែរ [member "
"collision_mask]។\n"
"[b]ចំណាំ៖[/b] វត្ថុ A អាចរកឃើញការប៉ះទង្គិចជាមួយវត្ថុ B លុះត្រាតែវត្ថុ B "
"ស្ថិតនៅក្នុងស្រទាប់ណាមួយដែលវត្ថុ A ស្កែន។ សូមមើល [url=$DOCS_URL/tutorials/physics/"
"physics_introduction.html#collision-layers-and-masks]Collision layers and "
"masks[/url] នៅក្នុងឯកសារសម្រាប់ព័ត៌មានបន្ថែម។"

msgid ""
"The physics layers this SoftBody3D [b]scans[/b]. Collision objects can scan "
"one or more of 32 different layers. See also [member collision_layer].\n"
"[b]Note:[/b] Object A can detect a contact with object B only if object B is "
"in any of the layers that object A scans. See [url=$DOCS_URL/tutorials/"
"physics/physics_introduction.html#collision-layers-and-masks]Collision layers "
"and masks[/url] in the documentation for more information."
msgstr ""
"ស្រទាប់រូបវិទ្យាដែល SoftBody3D នេះ [b]ស្កែន[/b]។ វត្ថុប៉ះទង្គិច (Collision objects) "
"អាចស្កែនស្រទាប់មួយ ឬច្រើនក្នុងចំណោម 32 ស្រទាប់ផ្សេងគ្នា។ សូមមើលផងដែរ [member "
"collision_layer]។\n"
"[b]ចំណាំ៖[/b] វត្ថុ A អាចរកឃើញការប៉ះទង្គិចជាមួយវត្ថុ B លុះត្រាតែវត្ថុ B "
"ស្ថិតនៅក្នុងស្រទាប់ណាមួយដែលវត្ថុ A ស្កែន។ សូមមើល [url=$DOCS_URL/tutorials/physics/"
"physics_introduction.html#collision-layers-and-masks]Collision layers and "
"masks[/url] នៅក្នុងឯកសារសម្រាប់ព័ត៌មានបន្ថែម។"

msgid ""
"The body's damping coefficient. Higher values will slow down the body more "
"noticeably when forces are applied."
msgstr ""
"មេគុណរំងាប់ (damping coefficient) របស់ body។ តម្លៃខ្ពស់ជាងនឹងធ្វើឱ្យ body "
"យឺតជាងមុនយ៉ាងច្បាស់នៅពេលដែលកម្លាំងត្រូវបានអនុវត្ត។"

msgid ""
"The body's drag coefficient. Higher values increase this body's air "
"resistance.\n"
"[b]Note:[/b] This value is currently unused by Godot's default physics "
"implementation."
msgstr ""
"មេគុណកកិតខ្យល់ (drag coefficient) របស់ body។ តម្លៃខ្ពស់ជាងនឹងបង្កើនភាពធន់នឹងខ្យល់របស់ body "
"នេះ។\n"
"[b]ចំណាំ៖[/b] តម្លៃនេះបច្ចុប្បន្នមិនត្រូវបានប្រើដោយការអនុវត្តរូបវិទ្យាលំនាំដើមរបស់ Godot ទេ។"

msgid ""
"Higher values will result in a stiffer body, while lower values will increase "
"the body's ability to bend. The value can be between [code]0.0[/code] and "
"[code]1.0[/code] (inclusive)."
msgstr ""
"តម្លៃខ្ពស់ជាងនឹងធ្វើឱ្យ body រឹងជាងមុន ខណៈដែលតម្លៃទាបជាងនឹងបង្កើនសមត្ថភាពក្នុងការបត់បែនរបស់ "
"body។ តម្លៃអាចនៅចន្លោះពី [code]0.0[/code] ដល់ [code]1.0[/code] (រាប់បញ្ចូលទាំងពីរ)។"

msgid ""
"[NodePath] to a [CollisionObject3D] this SoftBody3D should avoid clipping."
msgstr ""
"[NodePath] ទៅកាន់ [CollisionObject3D] ដែល SoftBody3D នេះគួរតែជៀសវាងការកាត់ត "
"(clipping)។"

msgid ""
"The pressure coefficient of this soft body. Simulate pressure build-up from "
"inside this body. Higher values increase the strength of this effect."
msgstr ""
"មេគុណសម្ពាធនៃ soft body នេះ។ ក្លែងធ្វើការកើនឡើងនៃសម្ពាធពីខាងក្នុង body នេះ។ "
"តម្លៃខ្ពស់ជាងនឹងបង្កើនកម្លាំងនៃឥទ្ធិពលនេះ។"

msgid "If [code]true[/code], the [SoftBody3D] will respond to [RayCast3D]s."
msgstr "ប្រសិនបើ [code]true[/code] [SoftBody3D] នឹងឆ្លើយតបទៅនឹង [RayCast3D]s។"

msgid ""
"Scales the rest lengths of [SoftBody3D]'s edge constraints. Positive values "
"shrink the mesh, while negative values expand it. For example, a value of "
"[code]0.1[/code] shortens the edges of the mesh by 10%, while [code]-0.1[/"
"code] expands the edges by 10%.\n"
"[b]Note:[/b] [member shrinking_factor] is best used on surface meshes with "
"pinned points."
msgstr ""
"ធ្វើមាត្រដ្ឋានប្រវែងសល់នៃ edge constraints របស់ [SoftBody3D]។ តម្លៃវិជ្ជមានធ្វើឱ្យ mesh "
"រួមតូច ខណៈដែលតម្លៃអវិជ្ជមានធ្វើឱ្យវារីកធំ។ ឧទាហរណ៍ តម្លៃ [code]0.1[/code] ធ្វើឱ្យគែមនៃ "
"mesh ខ្លីជាងមុន 10% ខណៈដែល [code]-0.1[/code] ធ្វើឱ្យគែមរីកធំ 10%។\n"
"[b]ចំណាំ៖[/b] [member shrinking_factor] ប្រើបានល្អបំផុតនៅលើ surface meshes "
"ដែលមានចំណុច pinned។"

msgid ""
"Increasing this value will improve the resulting simulation, but can affect "
"performance. Use with care."
msgstr ""
"ការបង្កើនតម្លៃនេះនឹងធ្វើឱ្យការក្លែងធ្វើ (simulation) ដែលទទួលបានប្រសើរជាងមុន "
"ប៉ុន្តែអាចប៉ះពាល់ដល់ដំណើរការ។ សូមប្រើដោយប្រុងប្រយ័ត្ន។"

msgid "The SoftBody3D's mass."
msgstr "ម៉ាស់ (mass) របស់ SoftBody3D។"

msgid ""
"When [member Node.process_mode] is set to [constant "
"Node.PROCESS_MODE_DISABLED], remove from the physics simulation to stop all "
"physics interactions with this [SoftBody3D].\n"
"Automatically re-added to the physics simulation when the [Node] is processed "
"again."
msgstr ""
"នៅពេលដែល [member Node.process_mode] ត្រូវបានកំណត់ទៅជា [constant "
"Node.PROCESS_MODE_DISABLED] សូមដកចេញពីការក្លែងធ្វើរូបវិទ្យា "
"ដើម្បីបញ្ឈប់រាល់អន្តរកម្មរូបវិទ្យាទាំងអស់ជាមួយ [SoftBody3D] នេះ។\n"
"ត្រូវបានបន្ថែមចូលទៅក្នុងការក្លែងធ្វើរូបវិទ្យាដោយស្វ័យប្រវត្តិ នៅពេលដែល [Node] "
"ត្រូវបានដំណើរការម្តងទៀត។"

msgid "Class representing a spherical [PrimitiveMesh]."
msgstr "ក្លាសដែលតំណាងឱ្យ [PrimitiveMesh] រាងស្វ៊ែរ។"

msgid "Full height of the sphere."
msgstr "កម្ពស់ពេញលេញនៃស្វ៊ែរ។"

msgid ""
"If [code]true[/code], a hemisphere is created rather than a full sphere.\n"
"[b]Note:[/b] To get a regular hemisphere, the height and radius of the sphere "
"must be equal."
msgstr ""
"ប្រសិនបើ [code]true[/code] ពាក់កណ្តាលស្វ៊ែរ (hemisphere) "
"នឹងត្រូវបានបង្កើតឡើងជំនួសឱ្យស្វ៊ែរពេញលេញ។\n"
"[b]ចំណាំ៖[/b] ដើម្បីទទួលបានពាក់កណ្តាលស្វ៊ែរធម្មតា កម្ពស់និងកាំនៃស្វ៊ែរត្រូវតែស្មើគ្នា។"

msgid "Number of radial segments on the sphere."
msgstr "ចំនួនផ្នែកជ្រុង (radial segments) នៅលើស្វ៊ែរ។"

msgid "Radius of sphere."
msgstr "កាំនៃស្វ៊ែរ។"

msgid "Number of segments along the height of the sphere."
msgstr "ចំនួនផ្នែកតាមបណ្តោយកម្ពស់នៃស្វ៊ែរ។"

msgid "Spherical shape for use with occlusion culling in [OccluderInstance3D]."
msgstr "រាងស្វ៊ែរសម្រាប់ប្រើជាមួយ occlusion culling នៅក្នុង [OccluderInstance3D]។"

msgid ""
"[SphereOccluder3D] stores a sphere shape that can be used by the engine's "
"occlusion culling system.\n"
"See [OccluderInstance3D]'s documentation for instructions on setting up "
"occlusion culling."
msgstr ""
"[SphereOccluder3D] រក្សាទុករាងស្វ៊ែរដែលអាចប្រើបានដោយប្រព័ន្ធ occlusion culling របស់ "
"engine។\n"
"សូមមើលឯកសាររបស់ [OccluderInstance3D] សម្រាប់ការណែនាំអំពីការរៀបចំ occlusion culling។"

msgid "The sphere's radius in 3D units."
msgstr "កាំនៃស្វ៊ែរគិតជាខ្នាត 3D។"

msgid "A 3D sphere shape used for physics collision."
msgstr "រាងស្វ៊ែរ 3D ដែលប្រើសម្រាប់ការប៉ះទង្គិចរូបវិទ្យា។"

msgid ""
"A 3D sphere shape, intended for use in physics. Usually used to provide a "
"shape for a [CollisionShape3D].\n"
"[b]Performance:[/b] [SphereShape3D] is fast to check collisions against. It "
"is faster than [BoxShape3D], [CapsuleShape3D], and [CylinderShape3D]."
msgstr ""
"រាងស្វ៊ែរ 3D ដែលមានបំណងប្រើប្រាស់ក្នុងរូបវិទ្យា។ ជាធម្មតាប្រើដើម្បីផ្តល់រាងសម្រាប់ "
"[CollisionShape3D]។\n"
"[b]ដំណើរការ៖[/b] [SphereShape3D] មានល្បឿនលឿនក្នុងការពិនិត្យមើលការប៉ះទង្គិច។ វាលឿនជាង "
"[BoxShape3D], [CapsuleShape3D], និង [CylinderShape3D]។"

msgid "The sphere's radius. The shape's diameter is double the radius."
msgstr "កាំនៃស្វ៊ែរ។ អង្កត់ផ្ចិតនៃរាងគឺស្មើនឹងពីរដងនៃកាំ។"

msgid "An input field for numbers."
msgstr "វាលបញ្ចូលសម្រាប់លេខ។"

msgid ""
"Applies the current value of this [SpinBox]. This is equivalent to pressing "
"[kbd]Enter[/kbd] while editing the [LineEdit] used by the [SpinBox]. This "
"will cause [signal LineEdit.text_submitted] to be emitted and its currently "
"contained expression to be evaluated."
msgstr ""
"អនុវត្តតម្លៃបច្ចុប្បន្ននៃ [SpinBox] នេះ។ វាស្មើនឹងការចុច [kbd]Enter[/kbd] "
"ខណៈពេលកំពុងកែសម្រួល [LineEdit] ដែលប្រើដោយ [SpinBox]។ វានឹងធ្វើឱ្យ [signal "
"LineEdit.text_submitted] ត្រូវបានបញ្ជូន ហើយកន្សោមដែលមាននៅក្នុងនោះបច្ចុប្បន្ននឹងត្រូវបានគណនា។"

msgid ""
"Returns the [LineEdit] instance from this [SpinBox]. You can use it to access "
"properties and methods of [LineEdit].\n"
"[b]Warning:[/b] This is a required internal node, removing and freeing it may "
"cause a crash. If you wish to hide it or any of its children, use their "
"[member CanvasItem.visible] property."
msgstr ""
"ត្រឡប់ instance [LineEdit] ពី [SpinBox] នេះ។ អ្នកអាចប្រើវាដើម្បីចូលប្រើលក្ខណៈសម្បត្តិ "
"និងវិធីសាស្ត្រ (methods) របស់ [LineEdit]។\n"
"[b]ព្រមាន៖[/b] នេះគឺជា internal node ដែលចាំបាច់ ការលុប និងដោះវាអាចបណ្តាលឱ្យគាំងកម្មវិធី។ "
"ប្រសិនបើអ្នកចង់លាក់វា ឬកូនរបស់វា សូមប្រើលក្ខណៈសម្បត្តិ [member CanvasItem.visible] របស់ពួកវា។"

msgid "Changes the alignment of the underlying [LineEdit]."
msgstr "ផ្លាស់ប្តូរការតម្រឹមនៃ [LineEdit] ដែលនៅពីក្រោម។"

msgid ""
"If [code]true[/code], the value will be rounded to a multiple of [member "
"custom_arrow_step] when interacting with the arrow buttons. Otherwise, "
"increments the value by [member custom_arrow_step] and then rounds it "
"according to [member Range.step]."
msgstr ""
"ប្រសិនបើ [code]true[/code] តម្លៃនឹងត្រូវបានបង្គត់ទៅជាពហុគុណនៃ [member "
"custom_arrow_step] នៅពេលធ្វើអន្តរកម្មជាមួយប៊ូតុងព្រួញ។ បើមិនដូច្នោះទេ បង្កើនតម្លៃដោយ "
"[member custom_arrow_step] ហើយបន្ទាប់មកបង្គត់វាទៅតាម [member Range.step]។"

msgid ""
"If not [code]0[/code], sets the step when interacting with the arrow buttons "
"of the [SpinBox].\n"
"[b]Note:[/b] [member Range.value] will still be rounded to a multiple of "
"[member Range.step]."
msgstr ""
"ប្រសិនបើមិនមែន [code]0[/code] កំណត់ជំហាននៅពេលធ្វើអន្តរកម្មជាមួយប៊ូតុងព្រួញរបស់ [SpinBox]។\n"
"[b]ចំណាំ៖[/b] [member Range.value] នៅតែត្រូវបានបង្គត់ទៅជាពហុគុណនៃ [member Range.step]។"

msgid ""
"If [code]true[/code], the [SpinBox] will be editable. Otherwise, it will be "
"read only."
msgstr ""
"ប្រសិនបើ [code]true[/code] [SpinBox] នឹងអាចកែសម្រួលបាន។ បើមិនដូច្នោះទេ "
"វានឹងអាចត្រឹមតែអានប៉ុណ្ណោះ (read only)។"

msgid ""
"If [code]true[/code], the [SpinBox] will select the whole text when the "
"[LineEdit] gains focus. Clicking the up and down arrows won't trigger this "
"behavior."
msgstr ""
"ប្រសិនបើ [code]true[/code] [SpinBox] នឹងជ្រើសរើសអត្ថបទទាំងមូលនៅពេលដែល [LineEdit] "
"ទទួលបាន focus។ ការចុចលើព្រួញឡើង និងចុះនឹងមិនបង្កឱ្យមានសកម្មភាពនេះទេ។"

msgid ""
"Sets the value of the [Range] for this [SpinBox] when the [LineEdit] text is "
"[i]changed[/i] instead of [i]submitted[/i]. See [signal "
"LineEdit.text_changed] and [signal LineEdit.text_submitted].\n"
"[b]Note:[/b] If set to [code]true[/code], this will interfere with entering "
"mathematical expressions in the [SpinBox]. The [SpinBox] will try to evaluate "
"the expression as you type, which means symbols like a trailing [code]+[/"
"code] are removed immediately by the expression being evaluated."
msgstr ""
"កំណត់តម្លៃនៃ [Range] សម្រាប់ [SpinBox] នេះនៅពេលដែលអត្ថបទ [LineEdit] ត្រូវបាន "
"[i]ផ្លាស់ប្តូរ[/i] ជំនួសឱ្យការ [i]បញ្ជូន[/i]។ សូមមើល [signal LineEdit.text_changed] និង "
"[signal LineEdit.text_submitted]។\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើកំណត់ជា [code]true[/code] វានឹងរំខានដល់ការបញ្ចូលកន្សោមគណិតវិទ្យានៅក្នុង "
"[SpinBox]។ [SpinBox] នឹងព្យាយាមគណនាកន្សោមនៅពេលវាយ ដែលមានន័យថានិមិត្តសញ្ញាដូចជា [code]+"
"[/code] នៅចុងបញ្ចប់នឹងត្រូវ បានលុបចេញភ្លាមៗដោយកន្សោមដែលកំពុងត្រូវបានគណនា។"

msgid "Down button icon modulation color, when the button is disabled."
msgstr "ពណ៌ modulation របស់រូបតំណាងប៊ូតុងចុះ នៅពេលដែលប៊ូតុងអសកម្ម។"

msgid "Down button icon modulation color, when the button is hovered."
msgstr "ពណ៌ modulation របស់រូបតំណាងប៊ូតុងចុះ នៅពេលដាក់កណ្តុរពីលើ។"

msgid "Down button icon modulation color."
msgstr "ពណ៌ modulation របស់រូបតំណាងប៊ូតុងចុះ។"

msgid "Down button icon modulation color, when the button is being pressed."
msgstr "ពណ៌ modulation របស់រូបតំណាងប៊ូតុងចុះ នៅពេលដែលប៊ូតុងកំពុងត្រូវបានចុច។"

msgid "Up button icon modulation color, when the button is disabled."
msgstr "ពណ៌ modulation របស់រូបតំណាងប៊ូតុងឡើង នៅពេលដែលប៊ូតុងអសកម្ម។"

msgid "Up button icon modulation color, when the button is hovered."
msgstr "ពណ៌ modulation របស់រូបតំណាងប៊ូតុងឡើង នៅពេលដាក់កណ្តុរពីលើ។"

msgid "Up button icon modulation color."
msgstr "ពណ៌ modulation របស់រូបតំណាងប៊ូតុងឡើង។"

msgid "Up button icon modulation color, when the button is being pressed."
msgstr "ពណ៌ modulation របស់រូបតំណាងប៊ូតុងឡើង នៅពេលដែលប៊ូតុងកំពុងត្រូវបានចុច។"

msgid "Vertical separation between the up and down buttons."
msgstr "គម្លាតបញ្ឈររវាងប៊ូតុងឡើង និងចុះ។"

msgid ""
"Width of the up and down buttons. If smaller than any icon set on the "
"buttons, the respective icon may overlap neighboring elements. If smaller "
"than [code]0[/code], the width is automatically adjusted from the icon size."
msgstr ""
"ទទឹងនៃប៊ូតុងឡើង និងចុះ។ ប្រសិនបើតូចជាងរូបតំណាងណាមួយដែលបានកំណត់នៅលើប៊ូតុង "
"រូបតំណាងនោះអាចនឹងត្រួតលើធាតុដែលនៅជាប់គ្នា។ ប្រសិនបើតូចជាង [code]0[/code] "
"ទទឹងនឹងត្រូវបានកែតម្រូវដោយស្វ័យប្រវត្តិតាមទំហំរូបតំណាង។"

msgid ""
"Width of the horizontal separation between the text input field ([LineEdit]) "
"and the buttons."
msgstr "ទទឹងនៃគម្លាតផ្តេករវាងវាលបញ្ចូលអត្ថបទ ([LineEdit]) និងប៊ូតុង។"

msgid ""
"This property exists only for compatibility with older themes. Setting "
"[theme_item buttons_width] to a negative value has the same effect."
msgstr ""
"លក្ខណៈសម្បត្តិនេះមានតែសម្រាប់ភាពឆបគ្នាជាមួយ theme ចាស់ៗប៉ុណ្ណោះ។ ការកំណត់ [theme_item "
"buttons_width] ទៅជាតម្លៃអវិជ្ជមានមានឥទ្ធិពលដូចគ្នា។"

msgid ""
"If not [code]0[/code], the minimum button width corresponds to the widest of "
"all icons set on those buttons, even if [theme_item buttons_width] is smaller."
msgstr ""
"ប្រសិនបើមិនមែន [code]0[/code] "
"ទទឹងប៊ូតុងអប្បបរមាត្រូវនឹងទទឹងធំបំផុតនៃរូបតំណាងទាំងអស់ដែលបានកំណត់នៅលើប៊ូតុងទាំងនោះ សូម្បីតែ "
"[theme_item buttons_width] តូចជាងក៏ដោយ។"

msgid ""
"Down button icon, displayed in the middle of the down (value-decreasing) "
"button."
msgstr "រូបតំណាងប៊ូតុងចុះ បង្ហាញនៅចំកណ្តាលនៃប៊ូតុងចុះ (បន្ថយតម្លៃ)។"

msgid "Down button icon when the button is disabled."
msgstr "រូបតំណាងប៊ូតុងចុះ នៅពេលដែលប៊ូតុងអសកម្ម។"

msgid "Down button icon when the button is hovered."
msgstr "រូបតំណាងប៊ូតុងចុះ នៅពេលដាក់កណ្តុរពីលើ។"

msgid "Down button icon when the button is being pressed."
msgstr "រូបតំណាងប៊ូតុងចុះ នៅពេលដែលប៊ូតុងកំពុងត្រូវបានចុច។"

msgid ""
"Up button icon, displayed in the middle of the up (value-increasing) button."
msgstr "រូបតំណាងប៊ូតុងឡើង បង្ហាញនៅចំកណ្តាលនៃប៊ូតុងឡើង (បង្កើនតម្លៃ)។"

msgid "Up button icon when the button is disabled."
msgstr "រូបតំណាងប៊ូតុងឡើង នៅពេលដែលប៊ូតុងអសកម្ម។"

msgid "Up button icon when the button is hovered."
msgstr "រូបតំណាងប៊ូតុងឡើង នៅពេលដាក់កណ្តុរពីលើ។"

msgid "Up button icon when the button is being pressed."
msgstr "រូបតំណាងប៊ូតុងឡើង នៅពេលដែលប៊ូតុងកំពុងត្រូវបានចុច។"

msgid "Use [theme_item up] and [theme_item down] instead."
msgstr "សូមប្រើ [theme_item up] និង [theme_item down] ជំនួសវិញ។"

msgid ""
"Single texture representing both the up and down buttons icons. It is "
"displayed in the middle of the buttons and does not change upon interaction. "
"If a valid icon is assigned, it will replace [theme_item up] and [theme_item "
"down]."
msgstr ""
"Texture តែមួយដែលតំណាងឱ្យរូបតំណាងប៊ូតុងទាំងឡើង និងចុះ។ វាត្រូវបានបង្ហាញនៅចំកណ្តាលនៃប៊ូតុង "
"ហើយមិនផ្លាស់ប្តូរនៅពេលមានអន្តរកម្មទេ។ ប្រសិនបើរូបតំណាងត្រឹមត្រូវត្រូវបានកំណត់ វានឹងជំនួស "
"[theme_item up] និង [theme_item down]។"

msgid "Background style of the down button."
msgstr "រចនាប័ទ្មផ្ទៃខាងក្រោយនៃប៊ូតុងចុះ។"

msgid "Background style of the down button when disabled."
msgstr "រចនាប័ទ្មផ្ទៃខាងក្រោយនៃប៊ូតុងចុះ នៅពេលអសកម្ម។"

msgid "Background style of the down button when hovered."
msgstr "រចនាប័ទ្មផ្ទៃខាងក្រោយនៃប៊ូតុងចុះ នៅពេលដាក់កណ្តុរពីលើ។"

msgid "Background style of the down button when being pressed."
msgstr "រចនាប័ទ្មផ្ទៃខាងក្រោយនៃប៊ូតុងចុះ នៅពេលកំពុងត្រូវបានចុច។"

msgid ""
"[StyleBox] drawn in the space occupied by the separation between the input "
"field and the buttons."
msgstr "[StyleBox] ដែលគូរនៅក្នុងចន្លោះដែលកាន់កាប់ដោយគម្លាតរវាងវាលបញ្ចូល និងប៊ូតុង។"

msgid "Background style of the up button."
msgstr "រចនាប័ទ្មផ្ទៃខាងក្រោយនៃប៊ូតុងឡើង។"

msgid "Background style of the up button when disabled."
msgstr "រចនាប័ទ្មផ្ទៃខាងក្រោយនៃប៊ូតុងឡើង នៅពេលអសកម្ម។"

msgid "Background style of the up button when hovered."
msgstr "រចនាប័ទ្មផ្ទៃខាងក្រោយនៃប៊ូតុងឡើង នៅពេលដាក់កណ្តុរពីលើ។"

msgid "Background style of the up button when being pressed."
msgstr "រចនាប័ទ្មផ្ទៃខាងក្រោយនៃប៊ូតុងឡើង នៅពេលកំពុងត្រូវបានចុច។"

msgid ""
"[StyleBox] drawn in the space occupied by the separation between the up and "
"down buttons."
msgstr "[StyleBox] ដែលគូរនៅក្នុងចន្លោះដែលកាន់កាប់ដោយគម្លាតរវាងប៊ូតុងឡើង និងចុះ។"

msgid "A [SkeletonModifier3D] for aligning bones along a [Path3D]."
msgstr "[SkeletonModifier3D] សម្រាប់តម្រឹមឆ្អឹង (bones) តាមបណ្តោយ [Path3D]។"

msgid ""
"A [SkeletonModifier3D] for aligning bones along a [Path3D]. The smoothness of "
"the fitting depends on the [member Curve3D.bake_interval].\n"
"If you want the [Path3D] to attach to a specific bone, it is recommended to "
"place a [ModifierBoneTarget3D] before the [SplineIK3D] in the "
"[SkeletonModifier3D] list (children of the [Skeleton3D]), and then place a "
"[Path3D] as the [ModifierBoneTarget3D]'s child.\n"
"Bone twist is determined based on the [method Curve3D.get_point_tilt].\n"
"If the root bone joint and the start point of the [Curve3D] are separated, it "
"assumes that there is a linear line segment between them. This means that the "
"vector pointing toward the start point of the [Curve3D] takes precedence over "
"the shortest intersection point along the [Curve3D].\n"
"If the end bone joint exceeds the path length, it is bent as close as "
"possible to the end point of the [Curve3D].\n"
"[b]Note:[/b] All the methods in this class take an [code]index[/code] "
"parameter. This parameter specifies which setting list entry to return if the "
"IK has multiple entries (e.g. [code]settings/<index>/root_bone_name[/code])."
msgstr ""
"[SkeletonModifier3D] សម្រាប់តម្រឹមឆ្អឹង (bones) តាមបណ្តោយ [Path3D]។ "
"ភាពរលូននៃការតភ្ជាប់អាស្រ័យលើ [member Curve3D.bake_interval]។\n"
"ប្រសិនបើអ្នកចង់ឱ្យ [Path3D] ភ្ជាប់ទៅនឹងឆ្អឹងជាក់លាក់ណាមួយ វាត្រូវបានណែនាំឱ្យដាក់ "
"[ModifierBoneTarget3D] នៅពីមុខ [SplineIK3D] នៅក្នុងបញ្ជី [SkeletonModifier3D] "
"(កូនរបស់ [Skeleton3D]) ហើយបន្ទាប់មកដាក់ [Path3D] ជាកូនរបស់ [ModifierBoneTarget3D]។\n"
"ការបង្វិលឆ្អឹង (Bone twist) ត្រូវបានកំណត់ដោយផ្អែកលើ [method Curve3D.get_point_tilt]។\n"
"ប្រសិនបើសន្លាក់ឆ្អឹងឫស (root bone joint) និងចំណុចចាប់ផ្តើមនៃ [Curve3D] ត្រូវបានបំបែក "
"វាសន្មត់ថាមានបន្ទាត់ត្រង់រវាងពួកវា។ នេះមានន័យថាវ៉ិចទ័រដែលចង្អុលទៅរកចំណុចចាប់ផ្តើមនៃ [Curve3D] "
"មានអាទិភាពជាងចំណុចប្រសព្វខ្លីបំផុតតាមបណ្តោយ [Curve3D]។\n"
"ប្រសិនបើសន្លាក់ឆ្អឹងចុងកាត់លើសពីប្រវែងផ្លូវ វានឹងត្រូវបានបត់ឱ្យកៀកបំផុតទៅនឹងចំណុចបញ្ចប់នៃ [Curve3D]។\n"
"[b]ចំណាំ៖[/b] វិធីសាស្ត្រ (methods) ទាំងអស់នៅក្នុងក្លាសនេះទទួលយកប៉ារ៉ាម៉ែត្រ [code]index[/"
"code]។ ប៉ារ៉ាម៉ែត្រនេះបញ្ជាក់ថាត្រូវត្រឡប់ធាតុណាមួយនៃបញ្ជីការកំណត់ ប្រសិនបើ IK មានធាតុច្រើន (ឧ. "
"[code]settings/<index>/root_bone_name[/code])។"

msgid "Returns the node path of the [Path3D] which is describing the path."
msgstr "ត្រឡប់ node path នៃ [Path3D] ដែលកំពុងពិពណ៌នាអំពីផ្លូវ។"

msgid ""
"Returns the tilt interpolation method used between the root bone and the "
"start point of the [Curve3D] when they are apart. See also [method "
"set_tilt_fade_in]."
msgstr ""
"ត្រឡប់វិធីសាស្ត្រ interpolate ការបត់ (tilt interpolation) ដែលប្រើរវាងឆ្អឹងឫស "
"និងចំណុចចាប់ផ្តើមនៃ [Curve3D] នៅពេលដែលពួកវាឃ្លាតពីគ្នា។ សូមមើលផងដែរ [method "
"set_tilt_fade_in]។"

msgid ""
"Returns the tilt interpolation method used between the end bone and the end "
"point of the [Curve3D] when they are apart. See also [method "
"set_tilt_fade_out]."
msgstr ""
"ត្រឡប់វិធីសាស្ត្រ interpolate ការបត់ (tilt interpolation) ដែលប្រើរវាងឆ្អឹងចុង "
"និងចំណុចបញ្ចប់នៃ [Curve3D] នៅពេលដែលពួកវាឃ្លាតពីគ្នា។ សូមមើលផងដែរ [method "
"set_tilt_fade_out]។"

msgid "Returns if the tilt property of the [Curve3D] affects the bone twist."
msgstr ""
"ត្រឡប់ថាតើលក្ខណៈសម្បត្តិ tilt របស់ [Curve3D] ប៉ះពាល់ដល់ការបង្វិលឆ្អឹង (bone twist) ឬអត់។"

msgid "Sets the node path of the [Path3D] which is describing the path."
msgstr "កំណត់ node path នៃ [Path3D] ដែលកំពុងពិពណ៌នាអំពីផ្លូវ។"

msgid "Sets if the tilt property of the [Curve3D] should affect the bone twist."
msgstr ""
"កំណត់ថាតើលក្ខណៈសម្បត្តិ tilt របស់ [Curve3D] គួរតែប៉ះពាល់ដល់ការបង្វិលឆ្អឹង (bone twist) ឬអត់។"

msgid ""
"If [param size] is greater than [code]0[/code], the tilt is interpolated "
"between [param size] start bones from the start point of the [Curve3D] when "
"they are apart.\n"
"If [param size] is equal [code]0[/code], the tilts between the root bone head "
"and the start point of the [Curve3D] are unified with a tilt of the start "
"point of the [Curve3D].\n"
"If [param size] is less than [code]0[/code], the tilts between the root bone "
"and the start point of the [Curve3D] are [code]0.0[/code]."
msgstr ""
"ប្រសិនបើ [param size] ធំជាង [code]0[/code] ការបត់ (tilt) ត្រូវបាន interpolated "
"រវាងឆ្អឹងចាប់ផ្តើមចំនួន [param size] ពីចំណុចចាប់ផ្តើមនៃ [Curve3D] នៅពេលដែលពួកវាឃ្លាតពីគ្នា។\n"
"ប្រសិនបើ [param size] ស្មើនឹង [code]0[/code] ការបត់រវាងក្បាលឆ្អឹងឫស និងចំណុចចាប់ផ្តើមនៃ "
"[Curve3D] ត្រូវបានបង្រួបបង្រួមជាមួយនឹងការបត់នៃចំណុចចាប់ផ្តើមនៃ [Curve3D]។\n"
"ប្រសិនបើ [param size] តូចជាង [code]0[/code] ការបត់រវាងឆ្អឹងឫស និងចំណុចចាប់ផ្តើមនៃ "
"[Curve3D] គឺ [code]0.0[/code]។"

msgid ""
"If [param size] is greater than [code]0[/code], the tilt is interpolated "
"between [param size] end bones from the end point of the [Curve3D] when they "
"are apart.\n"
"If [param size] is equal [code]0[/code], the tilts between the end bone tail "
"and the end point of the [Curve3D] are unified with a tilt of the end point "
"of the [Curve3D].\n"
"If [param size] is less than [code]0[/code], the tilts between the end bone "
"and the end point of the [Curve3D] are [code]0.0[/code]."
msgstr ""
"ប្រសិនបើ [param size] ធំជាង [code]0[/code] ការបត់ (tilt) ត្រូវបាន interpolated "
"រវាងឆ្អឹងចុងចំនួន [param size] ពីចំណុចបញ្ចប់នៃ [Curve3D] នៅពេលដែលពួកវាឃ្លាតពីគ្នា។\n"
"ប្រសិនបើ [param size] ស្មើនឹង [code]0[/code] ការបត់រវាងកន្ទុយឆ្អឹងចុង និងចំណុចបញ្ចប់នៃ "
"[Curve3D] ត្រូវបានបង្រួបបង្រួមជាមួយនឹងការបត់នៃចំណុចបញ្ចប់នៃ [Curve3D]។\n"
"ប្រសិនបើ [param size] តូចជាង [code]0[/code] ការបត់រវាងឆ្អឹងចុង និងចំណុចបញ្ចប់នៃ [Curve3D] "
"គឺ [code]0.0[/code]។"

msgid ""
"A container that arranges child controls horizontally or vertically and "
"provides grabbers for adjusting the split ratios between them."
msgstr ""
"Container ដែលរៀបចំ child controls ជាផ្តេក ឬបញ្ឈរ ហើយផ្តល់នូវ grabbers សម្រាប់កែតម្រូវ "
"split ratios រវាងពួកវា។"

msgid ""
"A container that arranges child controls horizontally or vertically and "
"creates grabbers between them. The grabbers can be dragged around to change "
"the size relations between the child controls."
msgstr ""
"Container ដែលរៀបចំ child controls ជាផ្តេក ឬបញ្ឈរ ហើយបង្កើត grabbers រវាងពួកវា។ "
"Grabbers អាចត្រូវបានអូសដើម្បីផ្លាស់ប្តូរទំនាក់ទំនងទំហំរវាង child controls។"

msgid ""
"Clamps the [member split_offsets] values to ensure they are within valid "
"ranges and do not overlap with each other. When overlaps occur, this method "
"prioritizes one split offset (at index [param priority_index]) by clamping "
"any overlapping split offsets to it."
msgstr ""
"Clamps តម្លៃ [member split_offsets] ដើម្បីធានាថាពួកវាស្ថិតនៅក្នុង ranges ដែលមានសុពលភាព "
"ហើយមិនត្រួតគ្នាទេ។ នៅពេលដែលការត្រួតគ្នាកើតឡើង វិធីសាស្រ្តនេះផ្តល់អាទិភាពដល់ split offset មួយ "
"(នៅសន្ទស្សន៍ [param priority_index]) ដោយ clamping split offsets ណាដែលត្រួតគ្នាទៅវា។"

msgid "Use the first element of [method get_drag_area_controls] instead."
msgstr "ប្រើ element ទីមួយនៃ [method get_drag_area_controls] ជំនួសវិញ។"

msgid ""
"Returns the drag area [Control]. For example, you can move a pre-configured "
"button into the drag area [Control] so that it rides along with the split "
"bar. Try setting the [Button] anchors to [code]center[/code] prior to the "
"[code]reparent()[/code] call.\n"
"[codeblock]\n"
"$BarnacleButton.reparent($SplitContainer.get_drag_area_control())\n"
"[/codeblock]\n"
"[b]Note:[/b] The drag area [Control] is drawn over the [SplitContainer]'s "
"children, so [CanvasItem] draw objects called from the [Control] and children "
"added to the [Control] will also appear over the [SplitContainer]'s children. "
"Try setting [member Control.mouse_filter] of custom children to [constant "
"Control.MOUSE_FILTER_IGNORE] to prevent blocking the mouse from dragging if "
"desired.\n"
"[b]Warning:[/b] This is a required internal node, removing and freeing it may "
"cause a crash."
msgstr ""
"ត្រឡប់ drag area [Control]។ ឧទាហរណ៍ អ្នកអាចផ្លាស់ទី button "
"ដែលបានកំណត់រចនាសម្ព័ន្ធជាមុនទៅក្នុង drag area [Control] ដើម្បីឱ្យវាធ្វើចលនាទៅតាម split "
"bar។ សាកល្បងកំណត់ [Button] anchors ទៅ [code]center[/code] មុនពេលហៅ "
"[code]reparent()[/code]។\n"
"[codeblock]\n"
"$BarnacleButton.reparent($SplitContainer.get_drag_area_control())\n"
"[/codeblock]\n"
"[b]ចំណាំ៖[/b] drag area [Control] ត្រូវបានគូរពីលើ children របស់ [SplitContainer] "
"ដូច្នេះ [CanvasItem] draw objects ដែលបានហៅពី [Control] និង children "
"ដែលបានបន្ថែមទៅក្នុង [Control] នឹងលេចឡើងពីលើ children របស់ [SplitContainer] ផងដែរ។ "
"សាកល្បងកំណត់ [member Control.mouse_filter] នៃ custom children ទៅ [constant "
"Control.MOUSE_FILTER_IGNORE] ដើម្បីការពារកុំឱ្យទប់ស្កាត់ mouse ពីការអូស ប្រសិនបើចង់បាន។\n"
"[b]ព្រមាន៖[/b] នេះគឺជា internal node ដែលទាមទារ ការដក និង freeing វាអាចបណ្តាលឱ្យគាំង "
"(crash)។"

msgid ""
"Returns an [Array] of the drag area [Control]s. These are the interactable "
"[Control] nodes between each child. For example, this can be used to add a "
"pre-configured button to a drag area [Control] so that it rides along with "
"the split bar. Try setting the [Button] anchors to [code]center[/code] prior "
"to the [method Node.reparent] call.\n"
"[codeblock]\n"
"$BarnacleButton.reparent($SplitContainer.get_drag_area_controls()[0])\n"
"[/codeblock]\n"
"[b]Note:[/b] The drag area [Control]s are drawn over the [SplitContainer]'s "
"children, so [CanvasItem] draw objects called from a drag area and children "
"added to it will also appear over the [SplitContainer]'s children. Try "
"setting [member Control.mouse_filter] of custom children to [constant "
"Control.MOUSE_FILTER_IGNORE] to prevent blocking the mouse from dragging if "
"desired.\n"
"[b]Warning:[/b] These are required internal nodes, removing or freeing them "
"may cause a crash."
msgstr ""
"ត្រឡប់ [Array] នៃ drag area [Control]s។ ទាំងនេះគឺជា [Control] nodes "
"ដែលអាចធ្វើអន្តរកម្មបានរវាង child នីមួយៗ។ ឧទាហរណ៍ វាអាចត្រូវបានប្រើដើម្បីបន្ថែម button "
"ដែលបានកំណត់រចនាសម្ព័ន្ធជាមុនទៅក្នុង drag area [Control] ដើម្បីឱ្យវាធ្វើចលនាទៅតាម split "
"bar។ សាកល្បងកំណត់ [Button] anchors ទៅ [code]center[/code] មុនពេលហៅ [method "
"Node.reparent]។\n"
"[codeblock]\n"
"$BarnacleButton.reparent($SplitContainer.get_drag_area_controls()[0])\n"
"[/codeblock]\n"
"[b]ចំណាំ៖[/b] drag area [Control]s ត្រូវបានគូរពីលើ children របស់ [SplitContainer] "
"ដូច្នេះ [CanvasItem] draw objects ដែលបានហៅពី drag area និង children "
"ដែលបានបន្ថែមទៅក្នុងវា នឹងលេចឡើងពីលើ children របស់ [SplitContainer] ផងដែរ។ សាកល្បងកំណត់ "
"[member Control.mouse_filter] នៃ custom children ទៅ [constant "
"Control.MOUSE_FILTER_IGNORE] ដើម្បីការពារកុំឱ្យទប់ស្កាត់ mouse ពីការអូស ប្រសិនបើចង់បាន។\n"
"[b]ព្រមាន៖[/b] ទាំងនេះគឺជា internal nodes ដែលទាមទារ ការដក ឬ freeing "
"ពួកវាអាចបណ្តាលឱ្យគាំង។"

msgid ""
"If [code]true[/code], the draggers will be disabled and the children will be "
"sized as if all [member split_offsets] were [code]0[/code]."
msgstr ""
"ប្រសិនបើ [code]true[/code] draggers នឹងត្រូវបានបិទ ហើយ children "
"នឹងត្រូវបានកំណត់ទំហំហាក់ដូចជា [member split_offsets] ទាំងអស់គឺ [code]0[/code]។"

msgid ""
"Highlights the drag area [Rect2] so you can see where it is during "
"development. The drag area is gold if [member dragging_enabled] is "
"[code]true[/code], and red if [code]false[/code]."
msgstr ""
"បន្លិច drag area [Rect2] ដើម្បីឱ្យអ្នកអាចមើលឃើញថាវានៅទីណាក្នុងអំឡុងពេលអភិវឌ្ឍន៍។ drag area "
"គឺពណ៌មាស ប្រសិនបើ [member dragging_enabled] គឺ [code]true[/code] និងពណ៌ក្រហម ប្រសិនបើ "
"[code]false[/code]។"

msgid ""
"Reduces the size of the drag area and split bar [theme_item "
"split_bar_background] at the beginning of the container."
msgstr ""
"កាត់បន្ថយទំហំនៃ drag area និង split bar [theme_item split_bar_background] នៅដើម "
"container។"

msgid ""
"Reduces the size of the drag area and split bar [theme_item "
"split_bar_background] at the end of the container."
msgstr ""
"កាត់បន្ថយទំហំនៃ drag area និង split bar [theme_item split_bar_background] "
"នៅចុងបញ្ចប់នៃ container។"

msgid ""
"Shifts the drag area in the axis of the container to prevent the drag area "
"from overlapping the [ScrollBar] or other selectable [Control] of a child "
"node."
msgstr ""
"រំកិល drag area នៅក្នុងអ័ក្សនៃ container ដើម្បីការពារ drag area ពីការត្រួតគ្នាលើ "
"[ScrollBar] ឬ [Control] ដែលអាចជ្រើសរើសបានផ្សេងទៀតនៃ child node។"

msgid ""
"Adds extra draggers at the intersection of the draggers of two "
"SplitContainers to allow dragging both at once. This must be set to "
"[code]true[/code] for both SplitContainers, and one needs to be a descendant "
"of the other. They also must be orthogonal (their [member vertical] are "
"different) and the descendant must be next to at least one of the ancestor's "
"draggers (within [theme_item minimum_grab_thickness])."
msgstr ""
"បន្ថែម draggers បន្ថែមនៅចំណុចប្រសព្វនៃ draggers នៃ SplitContainers ពីរ "
"ដើម្បីអនុញ្ញាតឱ្យអូសទាំងពីរក្នុងពេលតែមួយ។ វាត្រូវតែត្រូវបានកំណត់ទៅ [code]true[/code] សម្រាប់ "
"SplitContainers ទាំងពីរ ហើយមួយត្រូវតែជា descendant នៃមួយទៀត។ ពួកវាក៏ត្រូវតែ orthogonal "
"( [member vertical] របស់ពួកវាខុសគ្នា) ហើយ descendant ត្រូវតែនៅក្បែរ dragger "
"យ៉ាងហោចណាស់មួយរបស់ ancestor (នៅក្នុង [theme_item minimum_grab_thickness])។"

msgid ""
"Determines the dragger's visibility. This property does not determine whether "
"dragging is enabled or not. Use [member dragging_enabled] for that."
msgstr ""
"កំណត់ភាពមើលឃើញរបស់ dragger។ Property នេះមិនកំណត់ថាតើការអូសត្រូវបានបើក ឬអត់ទេ។ ប្រើ "
"[member dragging_enabled] សម្រាប់រឿងនោះ។"

msgid "Enables or disables split dragging."
msgstr "បើក ឬបិទការអូស split។"

msgid ""
"Use [member split_offsets] instead. The first element of the array is the "
"split offset between the first two children."
msgstr ""
"ប្រើ [member split_offsets] ជំនួសវិញ។ Element ទីមួយនៃ array គឺជា split offset រវាង "
"children ពីរដំបូង។"

msgid "The first element of [member split_offsets]."
msgstr "Element ទីមួយនៃ [member split_offsets]។"

msgid ""
"Offsets for each dragger in pixels. Each one is the offset of the split "
"between the [Control] nodes before and after the dragger, with [code]0[/code] "
"being the default position. The default position is based on the [Control] "
"nodes expand flags and minimum sizes. See [member "
"Control.size_flags_horizontal], [member Control.size_flags_vertical], and "
"[member Control.size_flags_stretch_ratio].\n"
"If none of the [Control] nodes before the dragger are expanded, the default "
"position will be at the start of the [SplitContainer]. If none of the "
"[Control] nodes after the dragger are expanded, the default position will be "
"at the end of the [SplitContainer]. If the dragger is in between expanded "
"[Control] nodes, the default position will be in the middle, based on the "
"[member Control.size_flags_stretch_ratio]s and minimum sizes.\n"
"[b]Note:[/b] If the split offsets cause [Control] nodes to overlap, the first "
"split will take priority when resolving the positions."
msgstr ""
"Offsets សម្រាប់ dragger នីមួយៗគិតជា pixels។ នីមួយៗគឺជា offset នៃ split រវាង [Control] "
"nodes មុន និងបន្ទាប់ពី dragger ដោយ [code]0[/code] គឺជាទីតាំងលំនាំដើម។ ទីតាំងលំនាំដើមគឺផ្អែកលើ "
"expand flags និងទំហំអប្បបរមារបស់ [Control] nodes។ សូមមើល [member "
"Control.size_flags_horizontal], [member Control.size_flags_vertical], និង "
"[member Control.size_flags_stretch_ratio]។\n"
"ប្រសិនបើគ្មាន [Control] nodes ណាមួយមុន dragger ត្រូវបានពង្រីកទេ ទីតាំងលំនាំដើមនឹងស្ថិតនៅដើម "
"[SplitContainer]។ ប្រសិនបើគ្មាន [Control] nodes ណាមួយបន្ទាប់ពី dragger ត្រូវបានពង្រីកទេ "
"ទីតាំងលំនាំដើមនឹងស្ថិតនៅចុងបញ្ចប់នៃ [SplitContainer]។ ប្រសិនបើ dragger ស្ថិតនៅចន្លោះ "
"[Control] nodes ដែលបានពង្រីក ទីតាំងលំនាំដើមនឹងស្ថិតនៅកណ្តាល ដោយផ្អែកលើ [member "
"Control.size_flags_stretch_ratio]s និងទំហំអប្បបរមា។\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើ split offsets ធ្វើឱ្យ [Control] nodes ត្រួតគ្នា split "
"ទីមួយនឹងទទួលបានអាទិភាពនៅពេលដោះស្រាយទីតាំង។"

msgid ""
"If [code]true[/code], a touch-friendly drag handle will be enabled for better "
"usability on smaller screens. Unlike the standard grabber, this drag handle "
"overlaps the [SplitContainer]'s children and does not affect their minimum "
"separation. The standard grabber will no longer be drawn when this option is "
"enabled."
msgstr ""
"ប្រសិនបើ [code]true[/code] touch-friendly drag handle "
"នឹងត្រូវបានបើកដើម្បីងាយស្រួលប្រើប្រាស់លើអេក្រង់តូចៗ។ ខុសពី standard grabber drag handle "
"នេះត្រួតលើ children របស់ [SplitContainer] ហើយមិនប៉ះពាល់ដល់ minimum separation "
"របស់ពួកវាទេ។ Standard grabber នឹងលែងត្រូវបានគូរទៀតហើយ នៅពេលដែលជម្រើសនេះត្រូវបានបើក។"

msgid ""
"If [code]true[/code], the [SplitContainer] will arrange its children "
"vertically, rather than horizontally.\n"
"Can't be changed when using [HSplitContainer] and [VSplitContainer]."
msgstr ""
"ប្រសិនបើ [code]true[/code] [SplitContainer] នឹងរៀបចំ children របស់វាជាបញ្ឈរ "
"ជាជាងផ្តេក។\n"
"មិនអាចផ្លាស់ប្តូរបានទេ នៅពេលប្រើ [HSplitContainer] និង [VSplitContainer]។"

msgid "Emitted when the user ends dragging."
msgstr "បញ្ចេញនៅពេលដែលអ្នកប្រើបញ្ចប់ការអូស។"

msgid "Emitted when the user starts dragging."
msgstr "បញ្ចេញនៅពេលដែលអ្នកប្រើចាប់ផ្តើមអូស។"

msgid "Emitted when any dragger is dragged by user."
msgstr "បញ្ចេញនៅពេលដែល dragger ណាមួយត្រូវបានអូសដោយអ្នកប្រើ។"

msgid ""
"The split dragger icon is always visible when [theme_item autohide] is "
"[code]false[/code], otherwise visible only when the cursor hovers it.\n"
"The size of the grabber icon determines the minimum [theme_item separation].\n"
"The dragger icon is automatically hidden if the length of the grabber icon is "
"longer than the split bar."
msgstr ""
"Split dragger icon គឺមើលឃើញជានិច្ចនៅពេលដែល [theme_item autohide] គឺ [code]false[/"
"code] បើមិនដូច្នេះទេ មើលឃើញតែនៅពេលដែល cursor hover លើវាប៉ុណ្ណោះ។\n"
"ទំហំនៃ grabber icon កំណត់ [theme_item separation] អប្បបរមា។\n"
"Dragger icon ត្រូវបានលាក់ដោយស្វ័យប្រវត្តិ ប្រសិនបើប្រវែងនៃ grabber icon វែងជាង split bar។"

msgid ""
"The split dragger icon is never visible regardless of the value of "
"[theme_item autohide].\n"
"The size of the grabber icon determines the minimum [theme_item separation]."
msgstr ""
"Split dragger icon មិនដែលមើលឃើញទេ ដោយមិនខ្វល់ពីតម្លៃនៃ [theme_item autohide]។\n"
"ទំហំនៃ grabber icon កំណត់ [theme_item separation] អប្បបរមា។"

msgid ""
"The split dragger icon is not visible, and the split bar is collapsed to zero "
"thickness."
msgstr "Split dragger icon មិនមើលឃើញទេ ហើយ split bar ត្រូវបានបង្រួមទៅជាកម្រាស់សូន្យ។"

msgid "The color of the touch dragger."
msgstr "ពណ៌នៃ touch dragger។"

msgid "The color of the touch dragger when hovered."
msgstr "ពណ៌នៃ touch dragger នៅពេល hovered។"

msgid "The color of the touch dragger when pressed."
msgstr "ពណ៌នៃ touch dragger នៅពេលចុច។"

msgid ""
"Boolean value. If [code]1[/code] ([code]true[/code]), the grabbers will hide "
"automatically when they aren't under the cursor. If [code]0[/code] "
"([code]false[/code]), the grabbers are always visible. The [member "
"dragger_visibility] must be [constant DRAGGER_VISIBLE]."
msgstr ""
"តម្លៃ Boolean។ ប្រសិនបើ [code]1[/code] ([code]true[/code]) grabbers "
"នឹងលាក់ដោយស្វ័យប្រវត្តិនៅពេលដែលពួកវាមិនស្ថិតនៅក្រោម cursor។ ប្រសិនបើ [code]0[/code] "
"([code]false[/code]) grabbers គឺមើលឃើញជានិច្ច។ [member dragger_visibility] "
"ត្រូវតែជា [constant DRAGGER_VISIBLE]។"

msgid ""
"The minimum thickness of the area users can click on to grab a split bar. "
"This ensures that the split bar can still be dragged if [theme_item "
"separation] or [theme_item h_grabber] / [theme_item v_grabber]'s size is too "
"narrow to easily select."
msgstr ""
"កម្រាស់អប្បបរមានៃតំបន់ដែលអ្នកប្រើអាចចុចដើម្បីចាប់ split bar។ នេះធានាថា split bar "
"នៅតែអាចត្រូវបានអូស ប្រសិនបើ [theme_item separation] ឬទំហំរបស់ [theme_item "
"h_grabber] / [theme_item v_grabber] ចង្អៀតពេកក្នុងការជ្រើសរើស។"

msgid ""
"The split bar thickness, i.e., the gap between each child of the container. "
"This is overridden by the size of the grabber icon if [member "
"dragger_visibility] is set to [constant DRAGGER_VISIBLE], or [constant "
"DRAGGER_HIDDEN], and [theme_item separation] is smaller than the size of the "
"grabber icon in the same axis.\n"
"[b]Note:[/b] To obtain [theme_item separation] values less than the size of "
"the grabber icon, for example a [code]1 px[/code] hairline, set [theme_item "
"h_grabber] or [theme_item v_grabber] to a new [ImageTexture], which "
"effectively sets the grabber icon size to [code]0 px[/code]."
msgstr ""
"កម្រាស់ split bar ពោលគឺជាគម្លាតរវាង child នីមួយៗនៃ container។ នេះត្រូវបាន override "
"ដោយទំហំនៃ grabber icon ប្រសិនបើ [member dragger_visibility] ត្រូវបានកំណត់ទៅ [constant "
"DRAGGER_VISIBLE] ឬ [constant DRAGGER_HIDDEN] ហើយ [theme_item separation] "
"តូចជាងទំហំនៃ grabber icon នៅក្នុងអ័ក្សដូចគ្នា។\n"
"[b]ចំណាំ៖[/b] ដើម្បីទទួលបានតម្លៃ [theme_item separation] តូចជាងទំហំនៃ grabber icon "
"ឧទាហរណ៍ [code]1 px[/code] hairline សូមកំណត់ [theme_item h_grabber] ឬ [theme_item "
"v_grabber] ទៅជា [ImageTexture] ថ្មី ដែលជាការកំណត់ទំហំ grabber icon ទៅជា [code]0 px[/"
"code] ដោយមានប្រសិទ្ធភាព។"

msgid ""
"The icon used for the grabbers drawn in the separations. This is only used in "
"[HSplitContainer] and [VSplitContainer]. For [SplitContainer], see "
"[theme_item h_grabber] and [theme_item v_grabber] instead."
msgstr ""
"Icon ដែលប្រើសម្រាប់ grabbers ដែលគូរនៅក្នុង separations។ នេះត្រូវបានប្រើតែនៅក្នុង "
"[HSplitContainer] និង [VSplitContainer] ប៉ុណ្ណោះ។ សម្រាប់ [SplitContainer] សូមមើល "
"[theme_item h_grabber] និង [theme_item v_grabber] ជំនួសវិញ។"

msgid ""
"The icon used for the grabbers drawn in the separations when [member "
"vertical] is [code]false[/code]."
msgstr ""
"Icon ដែលប្រើសម្រាប់ grabbers ដែលគូរនៅក្នុង separations នៅពេលដែល [member vertical] គឺ "
"[code]false[/code]។"

msgid ""
"The icon used for the drag handle when [member touch_dragger_enabled] is "
"[code]true[/code] and [member vertical] is [code]false[/code]."
msgstr ""
"Icon ដែលប្រើសម្រាប់ drag handle នៅពេលដែល [member touch_dragger_enabled] គឺ "
"[code]true[/code] និង [member vertical] គឺ [code]false[/code]។"

msgid ""
"The icon used for the drag handle when [member touch_dragger_enabled] is "
"[code]true[/code]. This is only used in [HSplitContainer] and "
"[VSplitContainer]. For [SplitContainer], see [theme_item h_touch_dragger] and "
"[theme_item v_touch_dragger] instead."
msgstr ""
"Icon ដែលប្រើសម្រាប់ drag handle នៅពេលដែល [member touch_dragger_enabled] គឺ "
"[code]true[/code]។ នេះត្រូវបានប្រើតែនៅក្នុង [HSplitContainer] និង [VSplitContainer] "
"ប៉ុណ្ណោះ។ សម្រាប់ [SplitContainer] សូមមើល [theme_item h_touch_dragger] និង "
"[theme_item v_touch_dragger] ជំនួសវិញ។"

msgid ""
"The icon used for the grabbers drawn in the separations when [member "
"vertical] is [code]true[/code]."
msgstr ""
"Icon ដែលប្រើសម្រាប់ grabbers ដែលគូរនៅក្នុង separations នៅពេលដែល [member vertical] គឺ "
"[code]true[/code]។"

msgid ""
"The icon used for the drag handle when [member touch_dragger_enabled] is "
"[code]true[/code] and [member vertical] is [code]true[/code]."
msgstr ""
"Icon ដែលប្រើសម្រាប់ drag handle នៅពេលដែល [member touch_dragger_enabled] គឺ "
"[code]true[/code] និង [member vertical] គឺ [code]true[/code]។"

msgid ""
"Determines the background of the split bar if its thickness is greater than "
"zero."
msgstr "កំណត់ផ្ទៃខាងក្រោយនៃ split bar ប្រសិនបើកម្រាស់របស់វាធំជាងសូន្យ។"

msgid "A spotlight, such as a reflector spotlight or a lantern."
msgstr "Spotlight ដូចជា reflector spotlight ឬ lantern។"

msgid ""
"A Spotlight is a type of [Light3D] node that emits lights in a specific "
"direction, in the shape of a cone. The light is attenuated through the "
"distance. This attenuation can be configured by changing the energy, radius "
"and attenuation parameters of [Light3D].\n"
"Light is emitted in the -Z direction of the node's global basis. For an "
"unrotated light, this means that the light is emitted forwards, illuminating "
"the front side of a 3D model (see [constant Vector3.FORWARD] and [constant "
"Vector3.MODEL_FRONT]).\n"
"[b]Note:[/b] When using the Mobile rendering method, only 8 spot lights can "
"be displayed on each mesh resource. Attempting to display more than 8 spot "
"lights on a single mesh resource will result in spot lights flickering in and "
"out as the camera moves. When using the Compatibility rendering method, only "
"8 spot lights can be displayed on each mesh resource by default, but this can "
"be increased by adjusting [member ProjectSettings.rendering/limits/opengl/"
"max_lights_per_object].\n"
"[b]Note:[/b] When using the Mobile or Compatibility rendering methods, spot "
"lights will only correctly affect meshes whose visibility AABB intersects "
"with the light's AABB. If using a shader to deform the mesh in a way that "
"makes it go outside its AABB, [member GeometryInstance3D.extra_cull_margin] "
"must be increased on the mesh. Otherwise, the light may not be visible on the "
"mesh."
msgstr ""
"Spotlight គឺជាប្រភេទនៃ [Light3D] node ដែលបញ្ចេញពន្លឺក្នុងទិសដៅជាក់លាក់មួយ ជារាងកោណ។ "
"ពន្លឺត្រូវបានកាត់បន្ថយ (attenuated) តាមរយៈចម្ងាយ។ "
"ការកាត់បន្ថយនេះអាចត្រូវបានកំណត់រចនាសម្ព័ន្ធដោយផ្លាស់ប្តូរ energy, radius និងប៉ារ៉ាម៉ែត្រ "
"attenuation នៃ [Light3D]។\n"
"ពន្លឺត្រូវបានបញ្ចេញក្នុងទិសដៅ -Z នៃ global basis របស់ node។ សម្រាប់ពន្លឺដែលមិនបានបង្វិល "
"នេះមានន័យថាពន្លឺត្រូវបានបញ្ចេញទៅមុខ បំភ្លឺផ្នែកខាងមុខនៃ 3D model (សូមមើល [constant "
"Vector3.FORWARD] និង [constant Vector3.MODEL_FRONT])។\n"
"[b]ចំណាំ៖[/b] នៅពេលប្រើ Mobile rendering method មានតែ 8 spot lights "
"ប៉ុណ្ណោះដែលអាចបង្ហាញបានលើ mesh resource នីមួយៗ។ ការព្យាយាមបង្ហាញ spot lights ច្រើនជាង "
"8 លើ mesh resource តែមួយ នឹងបណ្តាលឱ្យ spot lights ភ្លឹបភ្លែតៗ នៅពេលដែលកាមេរ៉ាផ្លាស់ទី។ "
"នៅពេលប្រើ Compatibility rendering method តាមលំនាំដើមមានតែ 8 spot lights "
"ប៉ុណ្ណោះដែលអាចបង្ហាញបានលើ mesh resource នីមួយៗ ប៉ុន្តែវាអាចត្រូវបានបង្កើនដោយកែតម្រូវ "
"[member ProjectSettings.rendering/limits/opengl/max_lights_per_object]។\n"
"[b]ចំណាំ៖[/b] នៅពេលប្រើ Mobile ឬ Compatibility rendering methods spot lights "
"នឹងប៉ះពាល់យ៉ាងត្រឹមត្រូវតែលើ meshes ដែល visibility AABB របស់វាប្រសព្វជាមួយ AABB "
"របស់ពន្លឺប៉ុណ្ណោះ។ ប្រសិនបើប្រើ shader ដើម្បីពត់ mesh ក្នុងលក្ខណៈដែលធ្វើឱ្យវាចេញក្រៅ AABB របស់វា "
"[member GeometryInstance3D.extra_cull_margin] ត្រូវតែត្រូវបានបង្កើនលើ mesh។ "
"បើមិនដូច្នេះទេ ពន្លឺអាចនឹងមិនមើលឃើញលើ mesh ទេ។"

msgid ""
"The spotlight's angle in degrees. This is the angular radius, meaning the "
"angle from the -Z axis, the cone's center, to the edge of the cone. The "
"default angular radius of 45 degrees corresponds to a cone with an angular "
"diameter of 90 degrees.\n"
"[b]Note:[/b] [member spot_angle] is not affected by [member Node3D.scale] "
"(the light's scale or its parent's scale)."
msgstr ""
"មុំរបស់ spotlight គិតជាដឺក្រេ។ នេះគឺជា angular radius មានន័យថាមុំពីអ័ក្ស -Z "
"ដែលជាចំណុចកណ្តាលនៃកោណ ទៅកាន់គែមនៃកោណ។ Angular radius លំនាំដើម 45 ដឺក្រេ "
"ត្រូវនឹងកោណដែលមាន angular diameter 90 ដឺក្រេ។\n"
"[b]ចំណាំ៖[/b] [member spot_angle] មិនរងផលប៉ះពាល់ដោយ [member Node3D.scale] "
"(មាត្រដ្ឋានរបស់ពន្លឺ ឬមាត្រដ្ឋានរបស់ parent របស់វា) ទេ។"

msgid ""
"The spotlight's [i]angular[/i] attenuation curve. See also [member "
"spot_attenuation]."
msgstr ""
"ខ្សែកោង attenuation [i]angular[/i] របស់ spotlight។ សូមមើលផងដែរ [member "
"spot_attenuation]។"

msgid ""
"Controls the distance attenuation function for spotlights.\n"
"A value of [code]0.0[/code] will maintain a constant brightness through most "
"of the range, but smoothly attenuate the light at the edge of the range. Use "
"a value of [code]2.0[/code] for physically accurate lights as it results in "
"the proper inverse square attenutation.\n"
"[b]Note:[/b] Setting attenuation to [code]2.0[/code] or higher may result in "
"distant objects receiving minimal light, even within range. For example, with "
"a range of [code]4096[/code], an object at [code]100[/code] units is "
"attenuated by a factor of [code]0.0001[/code]. With a default brightness of "
"[code]1[/code], the light would not be visible at that distance.\n"
"[b]Note:[/b] Using negative or values higher than [code]10.0[/code] may lead "
"to unexpected results."
msgstr ""
"គ្រប់គ្រងអនុគមន៍ distance attenuation សម្រាប់ spotlights។\n"
"តម្លៃ [code]0.0[/code] នឹងរក្សាពន្លឺថេរពេញភាគច្រើននៃ range "
"ប៉ុន្តែកាត់បន្ថយពន្លឺដោយរលូននៅគែមនៃ range។ ប្រើតម្លៃ [code]2.0[/code] "
"សម្រាប់ពន្លឺដែលត្រឹមត្រូវតាមលក្ខណៈរូបវន្ត ព្រោះវាផ្តល់នូវ inverse square attenuation "
"ត្រឹមត្រូវ។\n"
"[b]ចំណាំ៖[/b] ការកំណត់ attenuation ទៅ [code]2.0[/code] ឬខ្ពស់ជាងនេះ អាចបណ្តាលឱ្យ "
"objects ដែលនៅឆ្ងាយទទួលបានពន្លឺតិចបំផុត សូម្បីតែនៅក្នុង range ក៏ដោយ។ ឧទាហរណ៍ ជាមួយនឹង range "
"[code]4096[/code] object នៅ [code]100[/code] units ត្រូវបាន attenuate ដោយកត្តា "
"[code]0.0001[/code]។ ជាមួយនឹងពន្លឺលំនាំដើម [code]1[/code] "
"ពន្លឺនឹងមិនមើលឃើញនៅចម្ងាយនោះទេ។\n"
"[b]ចំណាំ៖[/b] ការប្រើតម្លៃអវិជ្ជមាន ឬតម្លៃខ្ពស់ជាង [code]10.0[/code] "
"អាចនាំឱ្យមានលទ្ធផលដែលមិនបានរំពឹងទុក។"

msgid ""
"The maximal range that can be reached by the spotlight. Note that the "
"effectively lit area may appear to be smaller depending on the [member "
"spot_attenuation] in use. No matter the [member spot_attenuation] in use, the "
"light will never reach anything outside this range.\n"
"[b]Note:[/b] [member spot_range] is not affected by [member Node3D.scale] "
"(the light's scale or its parent's scale)."
msgstr ""
"Range អតិបរមាដែលអាចឈានដល់ដោយ spotlight។ "
"សូមចំណាំថាតំបន់ដែលភ្លឺជាក់ស្តែងអាចមើលទៅហាក់ដូចជាតូចជាង អាស្រ័យលើ [member spot_attenuation] "
"ដែលកំពុងប្រើ។ ទោះបីជា [member spot_attenuation] ដែលកំពុងប្រើយ៉ាងណាក៏ដោយ "
"ពន្លឺនឹងមិនដែលឈានដល់អ្វីដែលនៅក្រៅ range នេះទេ។\n"
"[b]ចំណាំ៖[/b] [member spot_range] មិនរងផលប៉ះពាល់ដោយ [member Node3D.scale] "
"(មាត្រដ្ឋានរបស់ពន្លឺ ឬមាត្រដ្ឋានរបស់ parent របស់វា) ទេ។"

msgid ""
"A 3D raycast that dynamically moves its children near the collision point."
msgstr "3D raycast ដែលរំកិល children របស់វាទៅជិតចំណុចប៉ះទង្គិចដោយឌីណាមិក។"

msgid ""
"[SpringArm3D] casts a ray or a shape along its Z axis and moves all its "
"direct children to the collision point, with an optional margin. This is "
"useful for 3rd person cameras that move closer to the player when inside a "
"tight space (you may need to exclude the player's collider from the "
"[SpringArm3D]'s collision check)."
msgstr ""
"[SpringArm3D] cast ray ឬ shape តាមបណ្តោយអ័ក្ស Z របស់វា ហើយរំកិល direct children "
"ទាំងអស់របស់វាទៅកាន់ចំណុចប៉ះទង្គិច ជាមួយនឹង margin ជាជម្រើស។ នេះមានប្រយោជន៍សម្រាប់កាមេរ៉ាមនុស្សទី "
"3 ដែលរំកិលទៅជិតអ្នកលេងនៅពេលនៅក្នុងកន្លែងចង្អៀត (អ្នកប្រហែលជាត្រូវដក collider "
"របស់អ្នកលេងចេញពីការត្រួតពិនិត្យការប៉ះទង្គិចរបស់ [SpringArm3D])។"

msgid "Third-person camera with spring arm"
msgstr "កាមេរ៉ាមនុស្សទី 3 ជាមួយ spring arm"

msgid ""
"Adds the [PhysicsBody3D] object with the given [RID] to the list of "
"[PhysicsBody3D] objects excluded from the collision check."
msgstr ""
"បន្ថែម object [PhysicsBody3D] ជាមួយ [RID] ដែលបានផ្តល់ឱ្យទៅក្នុងបញ្ជីនៃ objects "
"[PhysicsBody3D] ដែលត្រូវបានដកចេញពីការត្រួតពិនិត្យការប៉ះទង្គិច។"

msgid ""
"Clears the list of [PhysicsBody3D] objects excluded from the collision check."
msgstr "សម្អាតបញ្ជីនៃ objects [PhysicsBody3D] ដែលត្រូវបានដកចេញពីការត្រួតពិនិត្យការប៉ះទង្គិច។"

msgid "Returns the spring arm's current length."
msgstr "ត្រឡប់ប្រវែងបច្ចុប្បន្នរបស់ spring arm។"

msgid ""
"Removes the given [RID] from the list of [PhysicsBody3D] objects excluded "
"from the collision check."
msgstr ""
"ដក [RID] ដែលបានផ្តល់ឱ្យចេញពីបញ្ជីនៃ objects [PhysicsBody3D] "
"ដែលត្រូវបានដកចេញពីការត្រួតពិនិត្យការប៉ះទង្គិច។"

msgid ""
"The layers against which the collision check will be done. See [url=$DOCS_URL/"
"tutorials/physics/physics_introduction.html#collision-layers-and-"
"masks]Collision layers and masks[/url] in the documentation for more "
"information."
msgstr ""
"Layers ដែលការត្រួតពិនិត្យការប៉ះទង្គិចនឹងត្រូវធ្វើឡើង។ សូមមើល [url=$DOCS_URL/tutorials/"
"physics/physics_introduction.html#collision-layers-and-masks]Collision layers "
"and masks[/url] នៅក្នុងឯកសារសម្រាប់ព័ត៌មានបន្ថែម។"

msgid ""
"When the collision check is made, a candidate length for the SpringArm3D is "
"given.\n"
"The margin is then subtracted to this length and the translation is applied "
"to the child objects of the SpringArm3D.\n"
"This margin is useful for when the SpringArm3D has a [Camera3D] as a child "
"node: without the margin, the [Camera3D] would be placed on the exact point "
"of collision, while with the margin the [Camera3D] would be placed close to "
"the point of collision."
msgstr ""
"នៅពេលដែលការត្រួតពិនិត្យការប៉ះទង្គិចត្រូវបានធ្វើឡើង ប្រវែងបេក្ខភាព (candidate length) សម្រាប់ "
"SpringArm3D ត្រូវបានផ្តល់ឱ្យ។\n"
"Margin បន្ទាប់មកត្រូវបានដកចេញពីប្រវែងនេះ ហើយ translation ត្រូវបានអនុវត្តទៅកាន់ child "
"objects នៃ SpringArm3D។\n"
"Margin នេះមានប្រយោជន៍សម្រាប់ពេលដែល SpringArm3D មាន [Camera3D] ជា child node: "
"បើគ្មាន margin ទេ [Camera3D] នឹងត្រូវបានដាក់នៅចំណុចនៃការប៉ះទង្គិចយ៉ាងពិតប្រាកដ "
"ខណៈពេលដែលមាន margin [Camera3D] នឹងត្រូវបានដាក់នៅជិតចំណុចនៃការប៉ះទង្គិច។"

msgid ""
"The [Shape3D] to use for the SpringArm3D.\n"
"When the shape is set, the SpringArm3D will cast the [Shape3D] on its z axis "
"instead of performing a ray cast."
msgstr ""
"[Shape3D] ដែលត្រូវប្រើសម្រាប់ SpringArm3D។\n"
"នៅពេលដែល shape ត្រូវបានកំណត់ SpringArm3D នឹង cast [Shape3D] នៅលើអ័ក្ស z របស់វា "
"ជំនួសឱ្យការធ្វើ ray cast។"

msgid ""
"The maximum extent of the SpringArm3D. This is used as a length for both the "
"ray and the shape cast used internally to calculate the desired position of "
"the SpringArm3D's child nodes.\n"
"To know more about how to perform a shape cast or a ray cast, please consult "
"the [PhysicsDirectSpaceState3D] documentation."
msgstr ""
"កម្រិតអតិបរមានៃ SpringArm3D។ នេះត្រូវបានប្រើជាប្រវែងសម្រាប់ទាំង ray និង shape cast "
"ដែលប្រើខាងក្នុងដើម្បីគណនាទីតាំងដែលចង់បាននៃ child nodes របស់ SpringArm3D។\n"
"ដើម្បីដឹងបន្ថែមអំពីរបៀបធ្វើ shape cast ឬ ray cast សូមពិគ្រោះឯកសារ "
"[PhysicsDirectSpaceState3D]។"

msgid ""
"A base class of the collision that interacts with [SpringBoneSimulator3D]."
msgstr "Class មូលដ្ឋាននៃ collision ដែលធ្វើអន្តរកម្មជាមួយ [SpringBoneSimulator3D]។"

msgid ""
"A collision can be a child of [SpringBoneSimulator3D]. If it is not a child "
"of [SpringBoneSimulator3D], it has no effect.\n"
"The colliding and sliding are done in the [SpringBoneSimulator3D]'s "
"modification process in order of its collision list which is set by [method "
"SpringBoneSimulator3D.set_collision_path]. If [method "
"SpringBoneSimulator3D.are_all_child_collisions_enabled] is [code]true[/code], "
"the order matches [SceneTree].\n"
"If [member bone] is set, it synchronizes with the bone pose of the ancestor "
"[Skeleton3D], which is done in before the [SpringBoneSimulator3D]'s "
"modification process as the pre-process.\n"
"[b]Warning:[/b] A scaled [SpringBoneCollision3D] will likely not behave as "
"expected. Make sure that the parent [Skeleton3D] and its bones are not scaled."
msgstr ""
"Collision អាចជា child នៃ [SpringBoneSimulator3D]។ ប្រសិនបើវាមិនមែនជា child នៃ "
"[SpringBoneSimulator3D] ទេ វាគ្មានឥទ្ធិពលទេ។\n"
"ការប៉ះទង្គិច និងការរអិល ត្រូវបានធ្វើឡើងនៅក្នុងដំណើរការកែប្រែរបស់ [SpringBoneSimulator3D] "
"តាមលំដាប់នៃបញ្ជី collision របស់វា ដែលត្រូវបានកំណត់ដោយ [method "
"SpringBoneSimulator3D.set_collision_path]។ ប្រសិនបើ [method "
"SpringBoneSimulator3D.are_all_child_collisions_enabled] គឺ [code]true[/code] "
"លំដាប់គឺត្រូវនឹង [SceneTree]។\n"
"ប្រសិនបើ [member bone] ត្រូវបានកំណត់ វាធ្វើសមកាលកម្មជាមួយ bone pose នៃ ancestor "
"[Skeleton3D] ដែលត្រូវបានធ្វើឡើងមុនដំណើរការកែប្រែរបស់ [SpringBoneSimulator3D] ជា pre-"
"process។\n"
"[b]ព្រមាន៖[/b] [SpringBoneCollision3D] ដែលបានធ្វើមាត្រដ្ឋាន "
"ទំនងជាមិនដំណើរការដូចការរំពឹងទុកទេ។ សូមប្រាកដថា parent [Skeleton3D] និង bones "
"របស់វាមិនត្រូវបានធ្វើមាត្រដ្ឋានទេ។"

msgid ""
"Get parent [Skeleton3D] node of the parent [SpringBoneSimulator3D] if found."
msgstr ""
"ទទួលបាន parent [Skeleton3D] node នៃ parent [SpringBoneSimulator3D] ប្រសិនបើរកឃើញ។"

msgid ""
"The offset of the position from [Skeleton3D]'s [member bone] pose position."
msgstr "គម្លាត (offset) នៃទីតាំងពីទីតាំង bone pose [member bone] របស់ [Skeleton3D]។"

msgid ""
"The offset of the rotation from [Skeleton3D]'s [member bone] pose rotation."
msgstr "គម្លាតនៃការបង្វិលពីការបង្វិល bone pose [member bone] របស់ [Skeleton3D]។"

msgid "A capsule shape collision that interacts with [SpringBoneSimulator3D]."
msgstr "ការប៉ះទង្គិចរាង capsule ដែលធ្វើអន្តរកម្មជាមួយ [SpringBoneSimulator3D]។"

msgid ""
"If [code]true[/code], the collision acts to trap the joint within the "
"collision."
msgstr ""
"ប្រសិនបើ [code]true[/code] ការប៉ះទង្គិចដើរតួដើម្បីទាក់ (trap) joint នៅក្នុងការប៉ះទង្គិច។"

msgid "An infinite plane collision that interacts with [SpringBoneSimulator3D]."
msgstr ""
"ការប៉ះទង្គិចប្លង់គ្មានដែនកំណត់ (infinite plane) ដែលធ្វើអន្តរកម្មជាមួយ "
"[SpringBoneSimulator3D]។"

msgid ""
"An infinite plane collision that interacts with [SpringBoneSimulator3D]. It "
"is an infinite size XZ plane, and the +Y direction is treated as normal."
msgstr ""
"ការប៉ះទង្គិចប្លង់គ្មានដែនកំណត់ដែលធ្វើអន្តរកម្មជាមួយ [SpringBoneSimulator3D]។ វាជាប្លង់ XZ "
"ដែលមានទំហំគ្មានដែនកំណត់ ហើយទិសដៅ +Y ត្រូវបានចាត់ទុកថាជា normal។"

msgid "A sphere shape collision that interacts with [SpringBoneSimulator3D]."
msgstr "ការប៉ះទង្គិចរាង sphere ដែលធ្វើអន្តរកម្មជាមួយ [SpringBoneSimulator3D]។"

msgid "The sphere's radius."
msgstr "កាំ (radius) របស់ sphere។"

msgid "A [SkeletonModifier3D] to apply inertial wavering to bone chains."
msgstr "[SkeletonModifier3D] ដើម្បីអនុវត្ត inertial wavering ទៅកាន់ bone chains។"

msgid ""
"This [SkeletonModifier3D] can be used to wiggle hair, cloth, and tails. This "
"modifier behaves differently from [PhysicalBoneSimulator3D] as it attempts to "
"return the original pose after modification.\n"
"If you setup [method set_root_bone] and [method set_end_bone], it is treated "
"as one bone chain. Note that it does not support a branched chain like Y-"
"shaped chains.\n"
"When a bone chain is created, an array is generated from the bones that exist "
"in between and listed in the joint list.\n"
"Several properties can be applied to each joint, such as [method "
"set_joint_stiffness], [method set_joint_drag], and [method "
"set_joint_gravity].\n"
"For simplicity, you can set values to all joints at the same time by using a "
"[Curve]. If you want to specify detailed values individually, set [method "
"set_individual_config] to [code]true[/code].\n"
"For physical simulation, [SpringBoneSimulator3D] can have children as self-"
"standing collisions that are not related to [PhysicsServer3D], see also "
"[SpringBoneCollision3D].\n"
"[b]Warning:[/b] A scaled [SpringBoneSimulator3D] will likely not behave as "
"expected. Make sure that the parent [Skeleton3D] and its bones are not "
"scaled.\n"
"[b]Note:[/b] Most methods in this class take an [code]index[/code] parameter. "
"This parameter specifies which setting list entry to return if the IK has "
"multiple entries (e.g. [code]settings/<index>/root_bone_name[/code])."
msgstr ""
"[SkeletonModifier3D] នេះអាចត្រូវបានប្រើដើម្បីធ្វើឱ្យសក់ ក្រណាត់ និងកន្ទុយកម្រើក។ Modifier "
"នេះដំណើរការខុសពី [PhysicalBoneSimulator3D] ព្រោះវាព្យាយាមត្រឡប់ទៅកាន់ pose "
"ដើមវិញបន្ទាប់ពីការកែប្រែ។\n"
"ប្រសិនបើអ្នករៀបចំ [method set_root_bone] និង [method set_end_bone] "
"វាត្រូវបានចាត់ទុកថាជា bone chain មួយ។ សូមចំណាំថាវាមិនគាំទ្រ branched chain ដូចជា chain "
"រាង Y ទេ។\n"
"នៅពេលដែល bone chain ត្រូវបានបង្កើត array ត្រូវបានបង្កើតពី bones ដែលមាននៅចន្លោះ "
"ហើយរាយបញ្ជីនៅក្នុង joint list។\n"
"លក្ខណៈសម្បត្តិជាច្រើនអាចត្រូវបានអនុវត្តទៅលើ joint នីមួយៗ ដូចជា [method "
"set_joint_stiffness], [method set_joint_drag], និង [method "
"set_joint_gravity]។\n"
"ដើម្បីភាពងាយស្រួល អ្នកអាចកំណត់តម្លៃទៅកាន់ joints ទាំងអស់ក្នុងពេលតែមួយដោយប្រើ [Curve]។ "
"ប្រសិនបើអ្នកចង់បញ្ជាក់តម្លៃលម្អិតដោយឡែកពីគ្នា សូមកំណត់ [method set_individual_config] ទៅជា "
"[code]true[/code]។\n"
"សម្រាប់ការក្លែងធ្វើរូបវន្ត [SpringBoneSimulator3D] អាចមាន children ជា self-standing "
"collisions ដែលមិនទាក់ទងនឹង [PhysicsServer3D] សូមមើលផងដែរ "
"[SpringBoneCollision3D]។\n"
"[b]ព្រមាន៖[/b] [SpringBoneSimulator3D] ដែលបានធ្វើមាត្រដ្ឋាន "
"ទំនងជាមិនដំណើរការដូចការរំពឹងទុកទេ។ សូមប្រាកដថា parent [Skeleton3D] និង bones "
"របស់វាមិនត្រូវបានធ្វើមាត្រដ្ឋានទេ។\n"
"[b]ចំណាំ៖[/b] Methods ភាគច្រើននៅក្នុង class នេះយកប៉ារ៉ាម៉ែត្រ [code]index[/code]។ "
"ប៉ារ៉ាម៉ែត្រនេះបញ្ជាក់ថាតើត្រូវត្រឡប់ setting list entry មួយណា ប្រសិនបើ IK មាន entries "
"ច្រើន (ឧ. [code]settings/<index>/root_bone_name[/code])។"

msgid ""
"Returns [code]true[/code] if all child [SpringBoneCollision3D]s are contained "
"in the collision list at [param index] in the settings."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ child [SpringBoneCollision3D]s "
"ទាំងអស់ត្រូវបានដាក់បញ្ចូលក្នុងបញ្ជី collision នៅ [param index] នៅក្នុង settings។"

msgid ""
"Clears all collisions from the collision list at [param index] in the "
"settings when [method are_all_child_collisions_enabled] is [code]false[/code]."
msgstr ""
"សម្អាត collisions ទាំងអស់ចេញពីបញ្ជី collision នៅ [param index] នៅក្នុង settings "
"នៅពេលដែល [method are_all_child_collisions_enabled] គឺ [code]false[/code]។"

msgid ""
"Clears all exclude collisions from the collision list at [param index] in the "
"settings when [method are_all_child_collisions_enabled] is [code]true[/code]."
msgstr ""
"សម្អាត exclude collisions ទាំងអស់ចេញពីបញ្ជី collision នៅ [param index] នៅក្នុង "
"settings នៅពេលដែល [method are_all_child_collisions_enabled] គឺ [code]true[/"
"code]។"

msgid "Returns the center bone index of the bone chain."
msgstr "ត្រឡប់សន្ទស្សន៍ center bone នៃ bone chain។"

msgid "Returns the center bone name of the bone chain."
msgstr "ត្រឡប់ឈ្មោះ center bone នៃ bone chain។"

msgid "Returns what the center originates from in the bone chain."
msgstr "ត្រឡប់ប្រភពដើមនៃ center នៅក្នុង bone chain។"

msgid "Returns the center node path of the bone chain."
msgstr "ត្រឡប់ node path របស់ center នៃ bone chain។"

msgid ""
"Returns the collision count of the bone chain's collision list when [method "
"are_all_child_collisions_enabled] is [code]false[/code]."
msgstr ""
"ត្រឡប់ចំនួន collision នៃបញ្ជី collision របស់ bone chain នៅពេលដែល [method "
"are_all_child_collisions_enabled] គឺ [code]false[/code]។"

msgid ""
"Returns the node path of the [SpringBoneCollision3D] at [param collision] in "
"the bone chain's collision list when [method "
"are_all_child_collisions_enabled] is [code]false[/code]."
msgstr ""
"ត្រឡប់ node path នៃ [SpringBoneCollision3D] នៅ [param collision] ក្នុងបញ្ជី "
"collision របស់ bone chain នៅពេលដែល [method are_all_child_collisions_enabled] គឺ "
"[code]false[/code]។"

msgid "Returns the drag force damping curve of the bone chain."
msgstr "ត្រឡប់ខ្សែកោង damping នៃកម្លាំង drag របស់ bone chain។"

msgid ""
"Returns the exclude collision count of the bone chain's exclude collision "
"list when [method are_all_child_collisions_enabled] is [code]true[/code]."
msgstr ""
"ត្រឡប់ចំនួន exclude collision នៃបញ្ជី exclude collision របស់ bone chain នៅពេលដែល "
"[method are_all_child_collisions_enabled] គឺ [code]true[/code]។"

msgid ""
"Returns the node path of the [SpringBoneCollision3D] at [param collision] in "
"the bone chain's exclude collision list when [method "
"are_all_child_collisions_enabled] is [code]true[/code]."
msgstr ""
"ត្រឡប់ node path នៃ [SpringBoneCollision3D] នៅ [param collision] ក្នុងបញ្ជី exclude "
"collision របស់ bone chain នៅពេលដែល [method are_all_child_collisions_enabled] គឺ "
"[code]true[/code]។"

msgid "Returns the gravity amount of the bone chain."
msgstr "ត្រឡប់ចំនួនទំនាញ (gravity amount) របស់ bone chain។"

msgid "Returns the gravity amount damping curve of the bone chain."
msgstr "ត្រឡប់ខ្សែកោង damping នៃចំនួនទំនាញរបស់ bone chain។"

msgid "Returns the gravity direction of the bone chain."
msgstr "ត្រឡប់ទិសដៅទំនាញរបស់ bone chain។"

msgid "Returns the drag force at [param joint] in the bone chain's joint list."
msgstr "ត្រឡប់កម្លាំង drag នៅ [param joint] ក្នុងបញ្ជី joint របស់ bone chain។"

msgid ""
"Returns the gravity amount at [param joint] in the bone chain's joint list."
msgstr "ត្រឡប់ចំនួនទំនាញនៅ [param joint] ក្នុងបញ្ជី joint របស់ bone chain។"

msgid ""
"Returns the gravity direction at [param joint] in the bone chain's joint list."
msgstr "ត្រឡប់ទិសដៅទំនាញនៅ [param joint] ក្នុងបញ្ជី joint របស់ bone chain។"

msgid "Returns the radius at [param joint] in the bone chain's joint list."
msgstr "ត្រឡប់កាំ (radius) នៅ [param joint] ក្នុងបញ្ជី joint របស់ bone chain។"

msgid ""
"Returns the stiffness force at [param joint] in the bone chain's joint list."
msgstr ""
"ត្រឡប់កម្លាំងរឹង (stiffness force) នៅ [param joint] ក្នុងបញ្ជី joint របស់ bone chain។"

msgid "Returns the joint radius of the bone chain."
msgstr "ត្រឡប់ joint radius របស់ bone chain។"

msgid "Returns the joint radius damping curve of the bone chain."
msgstr "ត្រឡប់ខ្សែកោង damping នៃ joint radius របស់ bone chain។"

msgid "Returns the rotation axis of the bone chain."
msgstr "ត្រឡប់អ័ក្សបង្វិល (rotation axis) របស់ bone chain។"

msgid ""
"Returns the rotation axis vector of the bone chain. This vector represents "
"the axis around which the bone chain can rotate. It is determined based on "
"the rotation axis set for the bone chain.\n"
"If [method get_rotation_axis] is [constant "
"SkeletonModifier3D.ROTATION_AXIS_ALL], this method returns [code]Vector3(0, "
"0, 0)[/code]."
msgstr ""
"ត្រឡប់វ៉ិចទ័រអ័ក្សបង្វិលរបស់ bone chain។ វ៉ិចទ័រនេះតំណាងឱ្យអ័ក្សដែល bone chain អាចបង្វិលជុំវិញ។ "
"វាត្រូវបានកំណត់ដោយផ្អែកលើអ័ក្សបង្វិលដែលបានកំណត់សម្រាប់ bone chain។\n"
"ប្រសិនបើ [method get_rotation_axis] គឺ [constant "
"SkeletonModifier3D.ROTATION_AXIS_ALL] វិធីសាស្រ្តនេះត្រឡប់ [code]Vector3(0, 0, 0)[/"
"code]។"

msgid "Returns the stiffness force of the bone chain."
msgstr "ត្រឡប់កម្លាំងរឹងរបស់ bone chain។"

msgid "Returns the stiffness force damping curve of the bone chain."
msgstr "ត្រឡប់ខ្សែកោង damping នៃកម្លាំងរឹងរបស់ bone chain។"

msgid ""
"Returns [code]true[/code] if the config can be edited individually for each "
"joint."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ config អាចត្រូវបានកែសម្រួលដោយឡែកពីគ្នាសម្រាប់ joint "
"នីមួយៗ។"

msgid "Sets the center bone index of the bone chain."
msgstr "កំណត់សន្ទស្សន៍ center bone នៃ bone chain។"

msgid "Sets the center bone name of the bone chain."
msgstr "កំណត់ឈ្មោះ center bone នៃ bone chain។"

msgid ""
"Sets what the center originates from in the bone chain.\n"
"Bone movement is calculated based on the difference in relative distance "
"between center and bone in the previous and next frames.\n"
"For example, if the parent [Skeleton3D] is used as the center, the bones are "
"considered to have not moved if the [Skeleton3D] moves in the world.\n"
"In this case, only a change in the bone pose is considered to be a bone "
"movement."
msgstr ""
"កំណត់ប្រភពដើមនៃ center នៅក្នុង bone chain។\n"
"ចលនា bone ត្រូវបានគណនាដោយផ្អែកលើភាពខុសគ្នានៃចម្ងាយ relative រវាង center និង bone "
"នៅក្នុង frames មុន និងបន្ទាប់។\n"
"ឧទាហរណ៍ ប្រសិនបើ parent [Skeleton3D] ត្រូវបានប្រើជា center bones "
"ត្រូវបានចាត់ទុកថាមិនបានផ្លាស់ទីទេ ប្រសិនបើ [Skeleton3D] ផ្លាស់ទីក្នុងពិភពលោក។\n"
"ក្នុងករណីនេះ មានតែការផ្លាស់ប្តូរនៅក្នុង bone pose ប៉ុណ្ណោះដែលត្រូវបានចាត់ទុកថាជាចលនា bone។"

msgid "Sets the center node path of the bone chain."
msgstr "កំណត់ node path របស់ center នៃ bone chain។"

msgid ""
"Sets the number of collisions in the collision list at [param index] in the "
"settings when [method are_all_child_collisions_enabled] is [code]false[/code]."
msgstr ""
"កំណត់ចំនួន collisions នៅក្នុងបញ្ជី collision នៅ [param index] នៅក្នុង settings នៅពេលដែល "
"[method are_all_child_collisions_enabled] គឺ [code]false[/code]។"

msgid ""
"Sets the node path of the [SpringBoneCollision3D] at [param collision] in the "
"bone chain's collision list when [method are_all_child_collisions_enabled] is "
"[code]false[/code]."
msgstr ""
"កំណត់ node path នៃ [SpringBoneCollision3D] នៅ [param collision] ក្នុងបញ្ជី "
"collision របស់ bone chain នៅពេលដែល [method are_all_child_collisions_enabled] គឺ "
"[code]false[/code]។"

msgid ""
"Sets the drag force of the bone chain. The greater the value, the more "
"suppressed the wiggling.\n"
"The value is scaled by [method set_drag_damping_curve] and cached in each "
"joint setting in the joint list."
msgstr ""
"កំណត់កម្លាំង drag របស់ bone chain។ តម្លៃកាន់តែធំ ការកម្រើកកាន់តែត្រូវបានទប់ស្កាត់។\n"
"តម្លៃត្រូវបានធ្វើមាត្រដ្ឋានដោយ [method set_drag_damping_curve] ហើយត្រូវបាន cache "
"នៅក្នុង joint setting នីមួយៗក្នុងបញ្ជី joint។"

msgid "Sets the drag force damping curve of the bone chain."
msgstr "កំណត់ខ្សែកោង damping នៃកម្លាំង drag របស់ bone chain។"

msgid ""
"If [param enabled] is [code]true[/code], all child [SpringBoneCollision3D]s "
"are colliding and [method set_exclude_collision_path] is enabled as an "
"exclusion list at [param index] in the settings.\n"
"If [param enabled] is [code]false[/code], you need to manually register all "
"valid collisions with [method set_collision_path]."
msgstr ""
"ប្រសិនបើ [param enabled] គឺ [code]true[/code] child [SpringBoneCollision3D]s "
"ទាំងអស់កំពុងប៉ះទង្គិច ហើយ [method set_exclude_collision_path] ត្រូវបានបើកជាបញ្ជីដកចេញ "
"(exclusion list) នៅ [param index] នៅក្នុង settings។\n"
"ប្រសិនបើ [param enabled] គឺ [code]false[/code] អ្នកត្រូវចុះឈ្មោះ collisions "
"ដែលមានសុពលភាពទាំងអស់ដោយដៃជាមួយ [method set_collision_path]។"

msgid ""
"Sets the end bone name of the bone chain.\n"
"[b]Note:[/b] End bone must be the root bone or a child of the root bone. If "
"they are the same, the tail must be extended by [method set_extend_end_bone] "
"to jiggle the bone."
msgstr ""
"កំណត់ឈ្មោះ end bone នៃ bone chain។\n"
"[b]ចំណាំ៖[/b] End bone ត្រូវតែជា root bone ឬ child នៃ root bone។ ប្រសិនបើពួកវាដូចគ្នា "
"tail ត្រូវតែត្រូវបានពង្រីកដោយ [method set_extend_end_bone] ដើម្បីធ្វើឱ្យ bone កម្រើក។"

msgid ""
"Sets the number of exclude collisions in the exclude collision list at [param "
"index] in the settings when [method are_all_child_collisions_enabled] is "
"[code]true[/code]."
msgstr ""
"កំណត់ចំនួន exclude collisions នៅក្នុងបញ្ជី exclude collision នៅ [param index] នៅក្នុង "
"settings នៅពេលដែល [method are_all_child_collisions_enabled] គឺ [code]true[/"
"code]។"

msgid ""
"Sets the node path of the [SpringBoneCollision3D] at [param collision] in the "
"bone chain's exclude collision list when [method "
"are_all_child_collisions_enabled] is [code]true[/code]."
msgstr ""
"កំណត់ node path នៃ [SpringBoneCollision3D] នៅ [param collision] ក្នុងបញ្ជី exclude "
"collision របស់ bone chain នៅពេលដែល [method are_all_child_collisions_enabled] គឺ "
"[code]true[/code]។"

msgid ""
"Sets the gravity amount of the bone chain. This value is not an acceleration, "
"but a constant velocity of movement in [method set_gravity_direction].\n"
"If [param gravity] is not [code]0[/code], the modified pose will not return "
"to the original pose since it is always affected by gravity.\n"
"The value is scaled by [method set_gravity_damping_curve] and cached in each "
"joint setting in the joint list."
msgstr ""
"កំណត់ចំនួនទំនាញរបស់ bone chain។ តម្លៃនេះមិនមែនជា acceleration ទេ "
"ប៉ុន្តែជាល្បឿនថេរនៃចលនានៅក្នុង [method set_gravity_direction]។\n"
"ប្រសិនបើ [param gravity] មិនមែន [code]0[/code] ទេ pose ដែលបានកែប្រែនឹងមិនត្រឡប់ទៅកាន់ "
"pose ដើមវិញទេ ព្រោះវាតែងតែរងផលប៉ះពាល់ដោយទំនាញ។\n"
"តម្លៃត្រូវបានធ្វើមាត្រដ្ឋានដោយ [method set_gravity_damping_curve] ហើយត្រូវបាន cache "
"នៅក្នុង joint setting នីមួយៗក្នុងបញ្ជី joint។"

msgid "Sets the gravity amount damping curve of the bone chain."
msgstr "កំណត់ខ្សែកោង damping នៃចំនួនទំនាញរបស់ bone chain។"

msgid ""
"Sets the gravity direction of the bone chain. This value is internally "
"normalized and then multiplied by [method set_gravity].\n"
"The value is cached in each joint setting in the joint list."
msgstr ""
"កំណត់ទិសដៅទំនាញរបស់ bone chain។ តម្លៃនេះត្រូវបាន normalize ខាងក្នុង ហើយបន្ទាប់មកគុណនឹង "
"[method set_gravity]។\n"
"តម្លៃត្រូវបាន cache នៅក្នុង joint setting នីមួយៗក្នុងបញ្ជី joint។"

msgid ""
"If [param enabled] is [code]true[/code], the config can be edited "
"individually for each joint."
msgstr ""
"ប្រសិនបើ [param enabled] គឺ [code]true[/code] config "
"អាចត្រូវបានកែសម្រួលដោយឡែកពីគ្នាសម្រាប់ joint នីមួយៗ។"

msgid ""
"Sets the drag force at [param joint] in the bone chain's joint list when "
"[method is_config_individual] is [code]true[/code]."
msgstr ""
"កំណត់កម្លាំង drag នៅ [param joint] ក្នុងបញ្ជី joint របស់ bone chain នៅពេលដែល [method "
"is_config_individual] គឺ [code]true[/code]។"

msgid ""
"Sets the gravity amount at [param joint] in the bone chain's joint list when "
"[method is_config_individual] is [code]true[/code]."
msgstr ""
"កំណត់ចំនួនទំនាញនៅ [param joint] ក្នុងបញ្ជី joint របស់ bone chain នៅពេលដែល [method "
"is_config_individual] គឺ [code]true[/code]។"

msgid ""
"Sets the gravity direction at [param joint] in the bone chain's joint list "
"when [method is_config_individual] is [code]true[/code]."
msgstr ""
"កំណត់ទិសដៅទំនាញនៅ [param joint] ក្នុងបញ្ជី joint របស់ bone chain នៅពេលដែល [method "
"is_config_individual] គឺ [code]true[/code]។"

msgid ""
"Sets the joint radius at [param joint] in the bone chain's joint list when "
"[method is_config_individual] is [code]true[/code]."
msgstr ""
"កំណត់ joint radius នៅ [param joint] ក្នុងបញ្ជី joint របស់ bone chain នៅពេលដែល "
"[method is_config_individual] គឺ [code]true[/code]។"

msgid ""
"Sets the rotation axis at [param joint] in the bone chain's joint list when "
"[method is_config_individual] is [code]true[/code].\n"
"The axes are based on the reference pose's space, if [param axis] is "
"[constant SkeletonModifier3D.ROTATION_AXIS_CUSTOM], you can specify any "
"axis.\n"
"In here, the reference pose is the bone pose immediately before the "
"simulation.\n"
"[b]Note:[/b] The rotation axis and the forward vector shouldn't be colinear "
"to avoid unintended rotation since [SpringBoneSimulator3D] does not factor in "
"twisting forces."
msgstr ""
"កំណត់អ័ក្សបង្វិលនៅ [param joint] ក្នុងបញ្ជី joint របស់ bone chain នៅពេលដែល [method "
"is_config_individual] គឺ [code]true[/code]។\n"
"អ័ក្សទាំងនេះគឺផ្អែកលើ space នៃ reference pose ប្រសិនបើ [param axis] គឺ [constant "
"SkeletonModifier3D.ROTATION_AXIS_CUSTOM] អ្នកអាចបញ្ជាក់អ័ក្សណាក៏បាន។\n"
"នៅទីនេះ reference pose គឺជា bone pose ភ្លាមៗមុនពេលការក្លែងធ្វើ។\n"
"[b]ចំណាំ៖[/b] អ័ក្សបង្វិល និង forward vector មិនគួរ colinear ទេ "
"ដើម្បីជៀសវាងការបង្វិលដែលមិនបានបំណង ព្រោះ [SpringBoneSimulator3D] មិនគិតពីកម្លាំងបង្វិល "
"(twisting forces) ទេ។"

msgid ""
"Sets the stiffness force at [param joint] in the bone chain's joint list when "
"[method is_config_individual] is [code]true[/code]."
msgstr ""
"កំណត់កម្លាំងរឹងនៅ [param joint] ក្នុងបញ្ជី joint របស់ bone chain នៅពេលដែល [method "
"is_config_individual] គឺ [code]true[/code]។"

msgid ""
"Sets the joint radius of the bone chain. It is used to move and slide with "
"the [SpringBoneCollision3D] in the collision list.\n"
"The value is scaled by [method set_radius_damping_curve] and cached in each "
"joint setting in the joint list."
msgstr ""
"កំណត់ joint radius របស់ bone chain។ វាត្រូវបានប្រើដើម្បីផ្លាស់ទី និងរអិលជាមួយ "
"[SpringBoneCollision3D] នៅក្នុងបញ្ជី collision។\n"
"តម្លៃត្រូវបានធ្វើមាត្រដ្ឋានដោយ [method set_radius_damping_curve] ហើយត្រូវបាន cache "
"នៅក្នុង joint setting នីមួយៗក្នុងបញ្ជី joint។"

msgid "Sets the joint radius damping curve of the bone chain."
msgstr "កំណត់ខ្សែកោង damping នៃ joint radius របស់ bone chain។"

msgid ""
"Sets the rotation axis of the bone chain. If set to a specific axis, it acts "
"like a hinge joint. The value is cached in each joint setting in the joint "
"list.\n"
"The axes are based on the reference pose's space, if [param axis] is "
"[constant SkeletonModifier3D.ROTATION_AXIS_CUSTOM], you can specify any "
"axis.\n"
"In here, the reference pose is the bone pose immediately before the "
"simulation.\n"
"[b]Note:[/b] The rotation axis vector and the forward vector shouldn't be "
"colinear to avoid unintended rotation since [SpringBoneSimulator3D] does not "
"factor in twisting forces."
msgstr ""
"កំណត់អ័ក្សបង្វិលរបស់ bone chain។ ប្រសិនបើកំណត់ទៅជាអ័ក្សជាក់លាក់ វាដើរតួដូចជា hinge joint។ "
"តម្លៃត្រូវបាន cache នៅក្នុង joint setting នីមួយៗក្នុងបញ្ជី joint។\n"
"អ័ក្សទាំងនេះគឺផ្អែកលើ space នៃ reference pose ប្រសិនបើ [param axis] គឺ [constant "
"SkeletonModifier3D.ROTATION_AXIS_CUSTOM] អ្នកអាចបញ្ជាក់អ័ក្សណាក៏បាន។\n"
"នៅទីនេះ reference pose គឺជា bone pose ភ្លាមៗមុនពេលការក្លែងធ្វើ។\n"
"[b]ចំណាំ៖[/b] វ៉ិចទ័រអ័ក្សបង្វិល និង forward vector មិនគួរ colinear ទេ "
"ដើម្បីជៀសវាងការបង្វិលដែលមិនបានបំណង ព្រោះ [SpringBoneSimulator3D] មិនគិតពីកម្លាំងបង្វិលទេ។"

msgid ""
"Sets the rotation axis vector of the bone chain. The value is cached in each "
"joint setting in the joint list.\n"
"This vector is normalized by an internal process and represents the axis "
"around which the bone chain can rotate.\n"
"If the vector length is [code]0[/code], it is considered synonymous with "
"[constant SkeletonModifier3D.ROTATION_AXIS_ALL]."
msgstr ""
"កំណត់វ៉ិចទ័រអ័ក្សបង្វិលរបស់ bone chain។ តម្លៃត្រូវបាន cache នៅក្នុង joint setting នីមួយៗក្នុងបញ្ជី "
"joint។\n"
"វ៉ិចទ័រនេះត្រូវបាន normalize ដោយដំណើរការខាងក្នុង ហើយតំណាងឱ្យអ័ក្សដែល bone chain "
"អាចបង្វិលជុំវិញ។\n"
"ប្រសិនបើប្រវែងវ៉ិចទ័រគឺ [code]0[/code] វាត្រូវបានចាត់ទុកថាដូចគ្នានឹង [constant "
"SkeletonModifier3D.ROTATION_AXIS_ALL]។"

msgid ""
"Sets the stiffness force of the bone chain. The greater the value, the faster "
"it recovers to its initial pose.\n"
"If [param stiffness] is [code]0[/code], the modified pose will not return to "
"the original pose.\n"
"The value is scaled by [method set_stiffness_damping_curve] and cached in "
"each joint setting in the joint list."
msgstr ""
"កំណត់កម្លាំងរឹងរបស់ bone chain។ តម្លៃកាន់តែធំ វាកាន់តែឆាប់ត្រឡប់ទៅកាន់ pose ដើមរបស់វា។\n"
"ប្រសិនបើ [param stiffness] គឺ [code]0[/code] pose ដែលបានកែប្រែនឹងមិនត្រឡប់ទៅកាន់ pose "
"ដើមវិញទេ។\n"
"តម្លៃត្រូវបានធ្វើមាត្រដ្ឋានដោយ [method set_stiffness_damping_curve] ហើយត្រូវបាន cache "
"នៅក្នុង joint setting នីមួយៗក្នុងបញ្ជី joint។"

msgid "Sets the stiffness force damping curve of the bone chain."
msgstr "កំណត់ខ្សែកោង damping នៃកម្លាំងរឹងរបស់ bone chain។"

msgid ""
"The constant force that always affected bones. It is equal to the result when "
"the parent [Skeleton3D] moves at this speed in the opposite direction.\n"
"This is useful for effects such as wind and anti-gravity."
msgstr ""
"កម្លាំងថេរដែលតែងតែប៉ះពាល់ដល់ bones។ វាស្មើនឹងលទ្ធផលនៅពេលដែល parent [Skeleton3D] "
"ផ្លាស់ទីក្នុងល្បឿននេះក្នុងទិសដៅផ្ទុយ។\n"
"នេះមានប្រយោជន៍សម្រាប់ឥទ្ធិពលដូចជាខ្យល់ និងការប្រឆាំងទំនាញ (anti-gravity)។"

msgid ""
"If [code]true[/code], the solver retrieves the bone axis from the bone pose "
"every frame.\n"
"If [code]false[/code], the solver retrieves the bone axis from the bone rest "
"and caches it, which increases performance slightly, but position changes in "
"the bone pose made before processing this [SpringBoneSimulator3D] are ignored."
msgstr ""
"ប្រសិនបើ [code]true[/code] solver ទាញយក bone axis ពី bone pose រាល់ frame។\n"
"ប្រសិនបើ [code]false[/code] solver ទាញយក bone axis ពី bone rest ហើយ cache វា "
"ដែលបង្កើន performance បន្តិច ប៉ុន្តែការផ្លាស់ប្តូរទីតាំងនៅក្នុង bone pose "
"ដែលបានធ្វើមុនពេលដំណើរការ [SpringBoneSimulator3D] នេះ ត្រូវបានរំលង។"

msgid "The world origin is defined as center."
msgstr "World origin ត្រូវបានកំណត់ថាជា center។"

msgid ""
"The [Node3D] specified by [method set_center_node] is defined as center.\n"
"If [Node3D] is not found, the parent [Skeleton3D] is treated as center."
msgstr ""
"[Node3D] ដែលបានបញ្ជាក់ដោយ [method set_center_node] ត្រូវបានកំណត់ថាជា center។\n"
"ប្រសិនបើ [Node3D] មិនត្រូវបានរកឃើញទេ parent [Skeleton3D] ត្រូវបានចាត់ទុកថាជា center។"

msgid ""
"The bone pose origin of the parent [Skeleton3D] specified by [method "
"set_center_bone] is defined as center.\n"
"If [Node3D] is not found, the parent [Skeleton3D] is treated as center."
msgstr ""
"Bone pose origin នៃ parent [Skeleton3D] ដែលបានបញ្ជាក់ដោយ [method "
"set_center_bone] ត្រូវបានកំណត់ថាជា center។\n"
"ប្រសិនបើ [Node3D] មិនត្រូវបានរកឃើញទេ parent [Skeleton3D] ត្រូវបានចាត់ទុកថាជា center។"

msgid "General-purpose sprite node."
msgstr "Sprite node សម្រាប់គោលបំណងទូទៅ។"

msgid ""
"A node that displays a 2D texture. The texture displayed can be a region from "
"a larger atlas texture, or a frame from a sprite sheet animation."
msgstr ""
"Node ដែលបង្ហាញ 2D texture។ Texture ដែលបង្ហាញអាចជា region ពី atlas texture ធំជាង ឬ "
"frame ពី sprite sheet animation។"

msgid ""
"Returns a [Rect2] representing the Sprite2D's boundary in local coordinates.\n"
"[b]Example:[/b] Detect if the Sprite2D was clicked:\n"
"[codeblocks]\n"
"[gdscript]\n"
"func _input(event):\n"
"\tif event is InputEventMouseButton and event.pressed and event.button_index "
"== MOUSE_BUTTON_LEFT:\n"
"\t\tif get_rect().has_point(to_local(event.position)):\n"
"\t\t\tprint(\"A click!\")\n"
"[/gdscript]\n"
"[csharp]\n"
"public override void _Input(InputEvent @event)\n"
"{\n"
"\tif (@event is InputEventMouseButton inputEventMouse)\n"
"\t{\n"
"\t\tif (inputEventMouse.Pressed && inputEventMouse.ButtonIndex == "
"MouseButton.Left)\n"
"\t\t{\n"
"\t\t\tif (GetRect().HasPoint(ToLocal(inputEventMouse.Position)))\n"
"\t\t\t{\n"
"\t\t\t\tGD.Print(\"A click!\");\n"
"\t\t\t}\n"
"\t\t}\n"
"\t}\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"ត្រឡប់ [Rect2] ដែលតំណាងឱ្យ boundary របស់ Sprite2D នៅក្នុងកូអរដោនេ local។\n"
"[b]ឧទាហរណ៍៖[/b] រកឃើញថាតើ Sprite2D ត្រូវបានចុចឬអត់៖\n"
"[codeblocks]\n"
"[gdscript]\n"
"func _input(event):\n"
"\tif event is InputEventMouseButton and event.pressed and event.button_index "
"== MOUSE_BUTTON_LEFT:\n"
"\t\tif get_rect().has_point(to_local(event.position)):\n"
"\t\t\tprint(\"A click!\")\n"
"[/gdscript]\n"
"[csharp]\n"
"public override void _Input(InputEvent @event)\n"
"{\n"
"\tif (@event is InputEventMouseButton inputEventMouse)\n"
"\t{\n"
"\t\tif (inputEventMouse.Pressed && inputEventMouse.ButtonIndex == "
"MouseButton.Left)\n"
"\t\t{\n"
"\t\t\tif (GetRect().HasPoint(ToLocal(inputEventMouse.Position)))\n"
"\t\t\t{\n"
"\t\t\t\tGD.Print(\"A click!\");\n"
"\t\t\t}\n"
"\t\t}\n"
"\t}\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Returns [code]true[/code] if the pixel at the given position is opaque, "
"[code]false[/code] otherwise. Also returns [code]false[/code] if the given "
"position is out of bounds or this sprite's [member texture] is [code]null[/"
"code]. [param pos] is in local coordinates."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ pixel នៅទីតាំងដែលបានផ្តល់ឱ្យគឺ opaque, [code]false[/"
"code] បើមិនដូច្នោះទេ។ ក៏ត្រឡប់ [code]false[/code] ផងដែរ ប្រសិនបើទីតាំងដែលបានផ្តល់ឱ្យនៅក្រៅ "
"bounds ឬ [member texture] របស់ sprite នេះគឺ [code]null[/code]។ [param pos] "
"ស្ថិតនៅក្នុងកូអរដោនេ local។"

msgid ""
"If [code]true[/code], texture is centered.\n"
"[b]Note:[/b] For games with a pixel art aesthetic, textures may appear "
"deformed when centered. This is caused by their position being between "
"pixels. To prevent this, set this property to [code]false[/code], or consider "
"enabling [member ProjectSettings.rendering/2d/snap/snap_2d_vertices_to_pixel] "
"and [member ProjectSettings.rendering/2d/snap/snap_2d_transforms_to_pixel]."
msgstr ""
"ប្រសិនបើ [code]true[/code] texture ត្រូវបានដាក់កណ្តាល។\n"
"[b]ចំណាំ៖[/b] សម្រាប់ហ្គេមដែលមានសោភ័ណភាព pixel art textures "
"អាចមើលទៅហាក់ដូចជាខូចទ្រង់ទ្រាយនៅពេលដាក់កណ្តាល។ នេះបណ្តាលមកពីទីតាំងរបស់ពួកវាស្ថិតនៅចន្លោះ "
"pixels។ ដើម្បីការពាររឿងនេះ សូមកំណត់ property នេះទៅជា [code]false[/code] ឬពិចារណាបើក "
"[member ProjectSettings.rendering/2d/snap/snap_2d_vertices_to_pixel] និង "
"[member ProjectSettings.rendering/2d/snap/snap_2d_transforms_to_pixel]។"

msgid ""
"Current frame to display from sprite sheet. [member hframes] or [member "
"vframes] must be greater than 1. This property is automatically adjusted when "
"[member hframes] or [member vframes] are changed to keep pointing to the same "
"visual frame (same column and row). If that's impossible, this value is reset "
"to [code]0[/code]."
msgstr ""
"Frame បច្ចុប្បន្នដែលត្រូវបង្ហាញពី sprite sheet។ [member hframes] ឬ [member vframes] "
"ត្រូវតែធំជាង 1។ Property នេះត្រូវបានកែតម្រូវដោយស្វ័យប្រវត្តិនៅពេលដែល [member hframes] ឬ "
"[member vframes] ត្រូវបានផ្លាស់ប្តូរ ដើម្បីរក្សាការចង្អុលទៅកាន់ visual frame ដដែល (column "
"និង row ដដែល)។ ប្រសិនបើមិនអាចធ្វើទៅបាន តម្លៃនេះត្រូវបានកំណត់ឡើងវិញទៅជា [code]0[/code]។"

msgid ""
"Coordinates of the frame to display from sprite sheet. This is as an alias "
"for the [member frame] property. [member hframes] or [member vframes] must be "
"greater than 1."
msgstr ""
"កូអរដោនេនៃ frame ដែលត្រូវបង្ហាញពី sprite sheet។ នេះគឺជា alias សម្រាប់ property "
"[member frame]។ [member hframes] ឬ [member vframes] ត្រូវតែធំជាង 1។"

msgid ""
"The number of columns in the sprite sheet. When this property is changed, "
"[member frame] is adjusted so that the same visual frame is maintained (same "
"row and column). If that's impossible, [member frame] is reset to [code]0[/"
"code]."
msgstr ""
"ចំនួន columns នៅក្នុង sprite sheet។ នៅពេលដែល property នេះត្រូវបានផ្លាស់ប្តូរ [member "
"frame] ត្រូវបានកែតម្រូវដើម្បីឱ្យ visual frame ដដែលត្រូវបានរក្សាទុក (row និង column ដដែល)។ "
"ប្រសិនបើមិនអាចធ្វើទៅបាន [member frame] ត្រូវបានកំណត់ឡើងវិញទៅជា [code]0[/code]។"

msgid ""
"The texture's drawing offset.\n"
"[b]Note:[/b] When you increase [member offset].y in Sprite2D, the sprite "
"moves downward on screen (i.e., +Y is down)."
msgstr ""
"Drawing offset របស់ texture។\n"
"[b]ចំណាំ៖[/b] នៅពេលដែលអ្នកបង្កើន [member offset].y នៅក្នុង Sprite2D sprite "
"ផ្លាស់ទីចុះក្រោមលើអេក្រង់ (ពោលគឺ +Y គឺចុះក្រោម)។"

msgid ""
"If [code]true[/code], texture is cut from a larger atlas texture. See [member "
"region_rect].\n"
"[b]Note:[/b] When using a custom [Shader] on a [Sprite2D], the [code]UV[/"
"code] shader built-in will refer to the entire texture space. Use the "
"[code]REGION_RECT[/code] built-in to get the currently visible region defined "
"in [member region_rect] instead. See [url=$DOCS_URL/tutorials/shaders/"
"shader_reference/canvas_item_shader.html]CanvasItem shaders[/url] for details."
msgstr ""
"ប្រសិនបើ [code]true[/code] texture ត្រូវបានកាត់ពី atlas texture ធំជាង។ សូមមើល [member "
"region_rect]។\n"
"[b]ចំណាំ៖[/b] នៅពេលប្រើ [Shader] ផ្ទាល់ខ្លួនលើ [Sprite2D] shader built-in [code]UV[/"
"code] នឹងយោងទៅលើ texture space ទាំងមូល។ ប្រើ built-in [code]REGION_RECT[/code] "
"ដើម្បីទទួលបាន region ដែលកំពុងមើលឃើញបច្ចុប្បន្នដែលបានកំណត់នៅក្នុង [member region_rect] "
"ជំនួសវិញ។ សូមមើល [url=$DOCS_URL/tutorials/shaders/shader_reference/"
"canvas_item_shader.html]CanvasItem shaders[/url] សម្រាប់ព័ត៌មានលម្អិត។"

msgid ""
"If [code]true[/code], the area outside of the [member region_rect] is clipped "
"to avoid bleeding of the surrounding texture pixels. [member region_enabled] "
"must be [code]true[/code]."
msgstr ""
"ប្រសិនបើ [code]true[/code] តំបន់ខាងក្រៅ [member region_rect] ត្រូវបាន clip "
"ដើម្បីជៀសវាងការហូរនៃ surrounding texture pixels។ [member region_enabled] ត្រូវតែជា "
"[code]true[/code]។"

msgid ""
"The region of the atlas texture to display. [member region_enabled] must be "
"[code]true[/code]."
msgstr ""
"Region នៃ atlas texture ដែលត្រូវបង្ហាញ។ [member region_enabled] ត្រូវតែជា "
"[code]true[/code]។"

msgid "[Texture2D] object to draw."
msgstr "Object [Texture2D] ដែលត្រូវគូរ។"

msgid ""
"The number of rows in the sprite sheet. When this property is changed, "
"[member frame] is adjusted so that the same visual frame is maintained (same "
"row and column). If that's impossible, [member frame] is reset to [code]0[/"
"code]."
msgstr ""
"ចំនួន rows នៅក្នុង sprite sheet។ នៅពេលដែល property នេះត្រូវបានផ្លាស់ប្តូរ [member "
"frame] ត្រូវបានកែតម្រូវដើម្បីឱ្យ visual frame ដដែលត្រូវបានរក្សាទុក (row និង column ដដែល)។ "
"ប្រសិនបើមិនអាចធ្វើទៅបាន [member frame] ត្រូវបានកំណត់ឡើងវិញទៅជា [code]0[/code]។"

msgid "Emitted when the [member frame] changes."
msgstr "បញ្ចេញនៅពេលដែល [member frame] ផ្លាស់ប្តូរ។"

msgid "Emitted when the [member texture] changes."
msgstr "បញ្ចេញនៅពេលដែល [member texture] ផ្លាស់ប្តូរ។"

msgid "2D sprite node in a 3D world."
msgstr "2D sprite node នៅក្នុងពិភព 3D។"

msgid ""
"A node that displays a 2D texture in a 3D environment. The texture displayed "
"can be a region from a larger atlas texture, or a frame from a sprite sheet "
"animation. See also [SpriteBase3D] where properties such as the billboard "
"mode are defined."
msgstr ""
"Node ដែលបង្ហាញ 2D texture នៅក្នុងបរិស្ថាន 3D។ Texture ដែលបង្ហាញអាចជា region ពី atlas "
"texture ធំជាង ឬ frame ពី sprite sheet animation។ សូមមើលផងដែរ [SpriteBase3D] "
"ដែលលក្ខណៈសម្បត្តិដូចជា billboard mode ត្រូវបានកំណត់។"

msgid ""
"If [code]true[/code], the sprite will use [member region_rect] and display "
"only the specified part of its texture."
msgstr ""
"ប្រសិនបើ [code]true[/code] sprite នឹងប្រើ [member region_rect] "
"ហើយបង្ហាញតែផ្នែកដែលបានបញ្ជាក់នៃ texture របស់វាប៉ុណ្ណោះ។"

msgid ""
"[Texture2D] object to draw. If [member GeometryInstance3D.material_override] "
"is used, this will be overridden. The size information is still used."
msgstr ""
"Object [Texture2D] ដែលត្រូវគូរ។ ប្រសិនបើ [member "
"GeometryInstance3D.material_override] ត្រូវបានប្រើ វានឹងត្រូវបាន override។ "
"ព័ត៌មានទំហំនៅតែត្រូវបានប្រើ។"

msgid "2D sprite node in 3D environment."
msgstr "2D sprite node នៅក្នុងបរិស្ថាន 3D។"

msgid ""
"A node that displays 2D texture information in a 3D environment. See also "
"[Sprite3D] where many other properties are defined."
msgstr ""
"Node ដែលបង្ហាញព័ត៌មាន 2D texture នៅក្នុងបរិស្ថាន 3D។ សូមមើលផងដែរ [Sprite3D] "
"ដែលលក្ខណៈសម្បត្តិជាច្រើនទៀតត្រូវបានកំណត់។"

msgid ""
"Returns a [TriangleMesh] with the sprite's vertices following its current "
"configuration (such as its [member axis] and [member pixel_size])."
msgstr ""
"ត្រឡប់ [TriangleMesh] ជាមួយនឹង vertices របស់ sprite "
"ដែលអនុលោមតាមការកំណត់រចនាសម្ព័ន្ធបច្ចុប្បន្នរបស់វា (ដូចជា [member axis] និង [member "
"pixel_size] របស់វា)។"

msgid "Returns the rectangle representing this sprite."
msgstr "ត្រឡប់ចតុកោណកែងដែលតំណាងឱ្យ sprite នេះ។"

msgid "If [code]true[/code], the specified flag will be enabled."
msgstr "ប្រសិនបើ [code]true[/code] flag ដែលបានបញ្ជាក់នឹងត្រូវបានបើក។"

msgid "The direction in which the front of the texture faces."
msgstr "ទិសដៅដែលផ្នែកខាងមុខនៃ texture បែរមុខទៅ។"

msgid ""
"The billboard mode to use for the sprite.\n"
"[b]Note:[/b] When billboarding is enabled and the material also casts "
"shadows, billboards will face [b]the[/b] camera in the scene when rendering "
"shadows. In scenes with multiple cameras, the intended shadow cannot be "
"determined and this will result in undefined behavior. See [url=https://"
"github.com/godotengine/godot/pull/72638]GitHub Pull Request #72638[/url] for "
"details."
msgstr ""
"Billboard mode ដែលត្រូវប្រើសម្រាប់ sprite។\n"
"[b]ចំណាំ៖[/b] នៅពេលដែល billboarding ត្រូវបានបើក ហើយ material ក៏បញ្ចាំងស្រមោលផងដែរ "
"billboards នឹងបែរមុខទៅរកកាមេរ៉ានៅក្នុង scene នៅពេល render ស្រមោល។ នៅក្នុង scenes "
"ដែលមានកាមេរ៉ាច្រើន ស្រមោលដែលចង់បានមិនអាចកំណត់បានទេ "
"ហើយវានឹងបណ្តាលឱ្យមានឥរិយាបថដែលមិនបានកំណត់ (undefined behavior)។ សូមមើល [url=https://"
"github.com/godotengine/godot/pull/72638]GitHub Pull Request #72638[/url] "
"សម្រាប់ព័ត៌មានលម្អិត។"

msgid "If [code]true[/code], texture will be centered."
msgstr "ប្រសិនបើ [code]true[/code] texture នឹងត្រូវបានដាក់កណ្តាល។"

msgid ""
"If [code]true[/code], texture can be seen from the back as well, if "
"[code]false[/code], it is invisible when looking at it from behind."
msgstr ""
"ប្រសិនបើ [code]true[/code] texture ក៏អាចមើលឃើញពីខាងក្រោយផងដែរ ប្រសិនបើ [code]false[/"
"code] វាមើលមិនឃើញនៅពេលមើលពីខាងក្រោយ។"

msgid ""
"If [code]true[/code], the texture is rendered at the same size regardless of "
"distance. The texture's size on screen is the same as if the camera was "
"[code]1.0[/code] units away from the texture's origin, regardless of the "
"actual distance from the camera. The [Camera3D]'s field of view (or [member "
"Camera3D.size] when in orthogonal/frustum mode) still affects the size the "
"sprite is drawn at."
msgstr ""
"ប្រសិនបើ [code]true[/code] texture ត្រូវបាន render ក្នុងទំហំដដែល ដោយមិនគិតពីចម្ងាយ។ ទំហំរបស់ "
"texture នៅលើអេក្រង់គឺដូចគ្នាទៅនឹងពេលដែលកាមេរ៉ាស្ថិតនៅចម្ងាយ [code]1.0[/code] units ពី "
"origin របស់ texture ដោយមិនគិតពីចម្ងាយជាក់ស្តែងពីកាមេរ៉ា។ Field of view របស់ [Camera3D] "
"(ឬ [member Camera3D.size] នៅពេលស្ថិតក្នុង orthogonal/frustum mode) "
"នៅតែប៉ះពាល់ដល់ទំហំដែល sprite ត្រូវបានគូរ។"

msgid ""
"A color value used to [i]multiply[/i] the texture's colors. Can be used for "
"mood-coloring or to simulate the color of ambient light.\n"
"[b]Note:[/b] Unlike [member CanvasItem.modulate] for 2D, colors with values "
"above [code]1.0[/code] (overbright) are not supported.\n"
"[b]Note:[/b] If a [member GeometryInstance3D.material_override] is defined on "
"the [SpriteBase3D], the material override must be configured to take vertex "
"colors into account for albedo. Otherwise, the color defined in [member "
"modulate] will be ignored. For a [BaseMaterial3D], [member "
"BaseMaterial3D.vertex_color_use_as_albedo] must be [code]true[/code]. For a "
"[ShaderMaterial], [code]ALBEDO *= COLOR.rgb;[/code] must be inserted in the "
"shader's [code]fragment()[/code] function."
msgstr ""
"តម្លៃពណ៌ដែលប្រើដើម្បី [i]គុណ[/i] ពណ៌របស់ texture។ អាចត្រូវបានប្រើសម្រាប់ mood-coloring "
"ឬដើម្បីក្លែងធ្វើពណ៌នៃពន្លឺ ambient។\n"
"[b]ចំណាំ៖[/b] ខុសពី [member CanvasItem.modulate] សម្រាប់ 2D ពណ៌ដែលមានតម្លៃលើស "
"[code]1.0[/code] (overbright) មិនត្រូវបានគាំទ្រទេ។\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើ [member GeometryInstance3D.material_override] ត្រូវបានកំណត់លើ "
"[SpriteBase3D] material override ត្រូវតែត្រូវបានកំណត់រចនាសម្ព័ន្ធដើម្បីគិតពីពណ៌ vertex "
"សម្រាប់ albedo។ បើមិនដូច្នេះទេ ពណ៌ដែលបានកំណត់នៅក្នុង [member modulate] នឹងត្រូវបានរំលង។ "
"សម្រាប់ [BaseMaterial3D], [member BaseMaterial3D.vertex_color_use_as_albedo] "
"ត្រូវតែជា [code]true[/code]។ សម្រាប់ [ShaderMaterial], [code]ALBEDO *= COLOR.rgb;"
"[/code] ត្រូវតែត្រូវបានបញ្ចូលក្នុងអនុគមន៍ [code]fragment()[/code] របស់ shader។"

msgid ""
"The texture's drawing offset.\n"
"[b]Note:[/b] When you increase [member offset].y in Sprite3D, the sprite "
"moves upward in world space (i.e., +Y is up)."
msgstr ""
"Drawing offset របស់ texture។\n"
"[b]ចំណាំ៖[/b] នៅពេលដែលអ្នកបង្កើន [member offset].y នៅក្នុង Sprite3D sprite "
"ផ្លាស់ទីឡើងលើក្នុង world space (ពោលគឺ +Y គឺឡើងលើ)។"

msgid "The size of one pixel's width on the sprite to scale it in 3D."
msgstr "ទំហំនៃទទឹងមួយ pixel នៅលើ sprite ដើម្បីធ្វើមាត្រដ្ឋានវាក្នុង 3D។"

msgid ""
"Sets the render priority for the sprite. Higher priority objects will be "
"sorted in front of lower priority objects.\n"
"[b]Note:[/b] This only applies if [member alpha_cut] is set to [constant "
"ALPHA_CUT_DISABLED] (default value).\n"
"[b]Note:[/b] This only applies to sorting of transparent objects. This will "
"not impact how transparent objects are sorted relative to opaque objects. "
"This is because opaque objects are not sorted, while transparent objects are "
"sorted from back to front (subject to priority)."
msgstr ""
"កំណត់អាទិភាព render សម្រាប់ sprite។ "
"វត្ថុដែលមានអាទិភាពខ្ពស់នឹងត្រូវបានតម្រៀបនៅខាងមុខវត្ថុដែលមានអាទិភាពទាប។\n"
"[b]ចំណាំ៖[/b] វាអនុវត្តតែនៅពេលដែល [member alpha_cut] ត្រូវបានកំណត់ទៅ [constant "
"ALPHA_CUT_DISABLED] (តម្លៃលំនាំដើម)។\n"
"[b]ចំណាំ៖[/b] វាអនុវត្តតែចំពោះការតម្រៀបវត្ថុថ្លា (transparent objects) ប៉ុណ្ណោះ។ "
"វានឹងមិនប៉ះពាល់ដល់របៀបដែលវត្ថុថ្លាត្រូវបានតម្រៀបធៀបនឹងវត្ថុស្រអាប់ (opaque objects) នោះទេ។ "
"នេះគឺដោយសារតែវត្ថុស្រអាប់មិនត្រូវបានតម្រៀបទេ ខណៈដែលវត្ថុថ្លាត្រូវបានតម្រៀបពីក្រោយទៅមុខ "
"(អាស្រ័យលើអាទិភាព)។"

msgid ""
"If [code]true[/code], the [Light3D] in the [Environment] has effects on the "
"sprite."
msgstr ""
"ប្រសិនបើ [code]true[/code] [Light3D] នៅក្នុង [Environment] នឹងមានឥទ្ធិពលលើ sprite។"

msgid ""
"Filter flags for the texture.\n"
"[b]Note:[/b] Linear filtering may cause artifacts around the edges, which are "
"especially noticeable on opaque textures. To prevent this, use textures with "
"transparent or identical colors around the edges."
msgstr ""
"Flags សម្រាប់តម្រង (Filter) នៃ texture។\n"
"[b]ចំណាំ៖[/b] ការច្រោះបែប Linear អាចបង្កឱ្យមាន artifacts នៅជុំវិញគែម "
"ដែលងាយស្រួលមើលឃើញជាពិសេសនៅលើ opaque textures។ ដើម្បីការពារបញ្ហានេះ សូមប្រើ textures "
"ដែលមានពណ៌ថ្លា ឬពណ៌ដូចគ្នានៅជុំវិញគែម។"

msgid ""
"If [code]true[/code], the texture's transparency and the opacity are used to "
"make those parts of the sprite invisible."
msgstr ""
"ប្រសិនបើ [code]true[/code] ភាពថ្លា (transparency) និង opacity របស់ texture "
"ត្រូវបានប្រើដើម្បីធ្វើឱ្យផ្នែកទាំងនោះនៃ sprite មើលមិនឃើញ។"

msgid ""
"If set, the texture's transparency and the opacity are used to make those "
"parts of the sprite invisible."
msgstr ""
"ប្រសិនបើបានកំណត់ ភាពថ្លា និង opacity របស់ texture ត្រូវបានប្រើដើម្បីធ្វើឱ្យផ្នែកទាំងនោះនៃ "
"sprite មើលមិនឃើញ។"

msgid "If set, lights in the environment affect the sprite."
msgstr "ប្រសិនបើបានកំណត់ ពន្លឺនៅក្នុង environment នឹងមានឥទ្ធិពលលើ sprite។"

msgid ""
"If set, texture can be seen from the back as well. If not, the texture is "
"invisible when looking at it from behind."
msgstr ""
"ប្រសិនបើបានកំណត់ texture ក៏អាចមើលឃើញពីខាងក្រោយផងដែរ។ បើមិនដូច្នេះទេ texture "
"នឹងមើលមិនឃើញនៅពេលមើលពីខាងក្រោយ។"

msgid ""
"This mode performs standard alpha blending. It can display translucent areas, "
"but transparency sorting issues may be visible when multiple transparent "
"materials are overlapping."
msgstr ""
"Mode នេះអនុវត្តការលាយបញ្ចូលគ្នានៃ alpha (alpha blending) បែបស្តង់ដារ។ "
"វាអាចបង្ហាញតំបន់ថ្លា (translucent) បាន ប៉ុន្តែបញ្ហាការតម្រៀបភាពថ្លាអាចនឹងមើលឃើញ នៅពេលដែល "
"transparent materials ជាច្រើនត្រួតគ្នា។"

msgid ""
"This mode only allows fully transparent or fully opaque pixels. Harsh edges "
"will be visible unless some form of screen-space antialiasing is enabled (see "
"[member ProjectSettings.rendering/anti_aliasing/quality/screen_space_aa]). On "
"the bright side, this mode doesn't suffer from transparency sorting issues "
"when multiple transparent materials are overlapping. This mode is also known "
"as [i]alpha testing[/i] or [i]1-bit transparency[/i]."
msgstr ""
"Mode នេះអនុញ្ញាតតែភីកសែលដែលថ្លាទាំងស្រុង ឬស្រអាប់ទាំងស្រុងប៉ុណ្ណោះ។ គែមរដុបនឹងមើលឃើញ លុះត្រាតែ "
"screen-space antialiasing ទម្រង់ណាមួយត្រូវបានបើក (សូមមើល [member "
"ProjectSettings.rendering/anti_aliasing/quality/screen_space_aa])។ "
"ចំណែកឯចំណុចល្អវិញ mode នេះមិនជួបបញ្ហាការតម្រៀបភាពថ្លាទេ នៅពេលដែល transparent materials "
"ជាច្រើនត្រួតគ្នា។ Mode នេះក៏ត្រូវបានគេស្គាល់ថាជា [i]alpha testing[/i] ឬ [i]1-bit "
"transparency[/i] ផងដែរ។"

msgid ""
"This mode draws fully opaque pixels in the depth prepass. This is slower than "
"[constant ALPHA_CUT_DISABLED] or [constant ALPHA_CUT_DISCARD], but it allows "
"displaying translucent areas and smooth edges while using proper sorting."
msgstr ""
"Mode នេះគូរភីកសែលដែលស្រអាប់ទាំងស្រុងនៅក្នុង depth prepass។ វាយឺតជាង [constant "
"ALPHA_CUT_DISABLED] ឬ [constant ALPHA_CUT_DISCARD] ប៉ុន្តែវាអនុញ្ញាតឱ្យបង្ហាញតំបន់ថ្លា "
"និងគែមរលូន ខណៈពេលដែលប្រើការតម្រៀបត្រឹមត្រូវ។"

msgid "Sprite frame library for AnimatedSprite2D and AnimatedSprite3D."
msgstr "បណ្ណាល័យ Sprite frame សម្រាប់ AnimatedSprite2D និង AnimatedSprite3D។"

msgid ""
"Sprite frame library for an [AnimatedSprite2D] or [AnimatedSprite3D] node. "
"Contains frames and animation data for playback."
msgstr ""
"បណ្ណាល័យ Sprite frame សម្រាប់ node [AnimatedSprite2D] ឬ [AnimatedSprite3D]។ "
"មានផ្ទុក frames និងទិន្នន័យ animation សម្រាប់ការចាក់បង្ហាញ (playback)។"

msgid "Adds a new [param anim] animation to the library."
msgstr "បន្ថែម animation [param anim] ថ្មីទៅក្នុងបណ្ណាល័យ។"

msgid ""
"Adds a frame to the [param anim] animation. If [param at_position] is "
"[code]-1[/code], the frame will be added to the end of the animation. [param "
"duration] specifies the relative duration, see [method get_frame_duration] "
"for details."
msgstr ""
"បន្ថែម frame ទៅក្នុង animation [param anim]។ ប្រសិនបើ [param at_position] គឺ "
"[code]-1[/code] frame នឹងត្រូវបានបន្ថែមទៅចុងបញ្ចប់នៃ animation។ [param duration] "
"បញ្ជាក់ពីថិរវេលាធៀប (relative duration) សូមមើល [method get_frame_duration] "
"សម្រាប់ព័ត៌មានលម្អិត។"

msgid "Removes all frames from the [param anim] animation."
msgstr "លុប frames ទាំងអស់ចេញពី animation [param anim]។"

msgid ""
"Removes all animations. An empty [code]default[/code] animation will be "
"created."
msgstr "លុប animations ទាំងអស់។ Animation [code]default[/code] ទទេមួយនឹងត្រូវបានបង្កើត។"

msgid ""
"Duplicates the animation [param anim_from] to a new animation named [param "
"anim_to]. Fails if [param anim_to] already exists, or if [param anim_from] "
"does not exist."
msgstr ""
"ចម្លង animation [param anim_from] ទៅជា animation ថ្មីដែលមានឈ្មោះ [param anim_to]។ "
"បរាជ័យ ប្រសិនបើ [param anim_to] មានស្រាប់ ឬប្រសិនបើ [param anim_from] មិនមាន។"

msgid "Use [method get_animation_loop_mode] instead."
msgstr "សូមប្រើ [method get_animation_loop_mode] ជំនួសវិញ។"

msgid ""
"Returns [code]true[/code] if [code]get_animation_loop_mode(anim) == "
"LOOP_LINEAR[/code]. Otherwise, returns [code]false[/code]."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ [code]get_animation_loop_mode(anim) == "
"LOOP_LINEAR[/code]។ បើមិនដូច្នេះទេ ត្រឡប់ [code]false[/code]។"

msgid "Returns the loop mode for the [param anim] animation."
msgstr "ត្រឡប់ loop mode សម្រាប់ animation [param anim]។"

msgid ""
"Returns an array containing the names associated to each animation. Values "
"are placed in alphabetical order."
msgstr ""
"ត្រឡប់ array ដែលមានឈ្មោះទាក់ទងនឹង animation នីមួយៗ។ តម្លៃត្រូវបានតម្រៀបតាមលំដាប់អក្ខរក្រម។"

msgid "Returns the speed in frames per second for the [param anim] animation."
msgstr "ត្រឡប់ល្បឿនគិតជា frames ក្នុងមួយវិនាទី (fps) សម្រាប់ animation [param anim]។"

msgid "Returns the number of frames for the [param anim] animation."
msgstr "ត្រឡប់ចំនួន frames សម្រាប់ animation [param anim]។"

msgid ""
"Returns a relative duration of the frame [param idx] in the [param anim] "
"animation (defaults to [code]1.0[/code]). For example, a frame with a "
"duration of [code]2.0[/code] is displayed twice as long as a frame with a "
"duration of [code]1.0[/code]. You can calculate the absolute duration (in "
"seconds) of a frame using the following formula:\n"
"[codeblock]\n"
"absolute_duration = relative_duration / (animation_fps * abs(playing_speed))\n"
"[/codeblock]\n"
"In this example, [code]playing_speed[/code] refers to either [method "
"AnimatedSprite2D.get_playing_speed] or [method "
"AnimatedSprite3D.get_playing_speed]."
msgstr ""
"ត្រឡប់ថិរវេលាធៀប (relative duration) នៃ frame [param idx] នៅក្នុង animation [param "
"anim] (លំនាំដើមគឺ [code]1.0[/code])។ ឧទាហរណ៍ frame ដែលមានថិរវេលា [code]2.0[/code] "
"ត្រូវបានបង្ហាញយូរជាង frame ដែលមានថិរវេលា [code]1.0[/code] ពីរដង។ "
"អ្នកអាចគណនាថិរវេលាដាច់ខាត (គិតជាវិនាទី) នៃ frame ដោយប្រើរូបមន្តខាងក្រោម៖\n"
"[codeblock]\n"
"absolute_duration = relative_duration / (animation_fps * abs(playing_speed))\n"
"[/codeblock]\n"
"នៅក្នុងឧទាហរណ៍នេះ [code]playing_speed[/code] សំដៅលើ [method "
"AnimatedSprite2D.get_playing_speed] ឬ [method "
"AnimatedSprite3D.get_playing_speed]។"

msgid ""
"Returns the texture of the frame [param idx] in the [param anim] animation."
msgstr "ត្រឡប់ texture នៃ frame [param idx] នៅក្នុង animation [param anim]។"

msgid "Returns [code]true[/code] if the [param anim] animation exists."
msgstr "ត្រឡប់ [code]true[/code] ប្រសិនបើ animation [param anim] មាន។"

msgid "Removes the [param anim] animation."
msgstr "លុប animation [param anim] ចេញ។"

msgid "Removes the [param anim] animation's frame [param idx]."
msgstr "លុប frame [param idx] របស់ animation [param anim] ចេញ។"

msgid "Changes the [param anim] animation's name to [param newname]."
msgstr "ប្តូរឈ្មោះរបស់ animation [param anim] ទៅជា [param newname]។"

msgid "Use [method set_animation_loop_mode] instead."
msgstr "សូមប្រើ [method set_animation_loop_mode] ជំនួសវិញ។"

msgid ""
"If [param loop] is [code]false[/code] equivalent to "
"[code]set_animation_loop_mode(LOOP_NONE)[/code].\n"
"If [param loop] is [code]true[/code] equivalent to "
"[code]set_animation_loop_mode(LOOP_LINEAR)[/code]."
msgstr ""
"ប្រសិនបើ [param loop] គឺ [code]false[/code] ស្មើនឹង "
"[code]set_animation_loop_mode(LOOP_NONE)[/code]។\n"
"ប្រសិនបើ [param loop] គឺ [code]true[/code] ស្មើនឹង "
"[code]set_animation_loop_mode(LOOP_LINEAR)[/code]។"

msgid "Sets the [param loop_mode] for the [param anim] animation."
msgstr "កំណត់ [param loop_mode] សម្រាប់ animation [param anim]។"

msgid "Sets the speed for the [param anim] animation in frames per second."
msgstr "កំណត់ល្បឿនសម្រាប់ animation [param anim] គិតជា frames ក្នុងមួយវិនាទី។"

msgid ""
"Sets the [param texture] and the [param duration] of the frame [param idx] in "
"the [param anim] animation. [param duration] specifies the relative duration, "
"see [method get_frame_duration] for details."
msgstr ""
"កំណត់ [param texture] និង [param duration] នៃ frame [param idx] នៅក្នុង animation "
"[param anim]។ [param duration] បញ្ជាក់ពីថិរវេលាធៀប សូមមើល [method "
"get_frame_duration] សម្រាប់ព័ត៌មានលម្អិត។"

msgid ""
"The animation plays once and stops when it reaches the end, or the start if "
"played in reverse."
msgstr "Animation ចាក់តែម្តង ហើយឈប់នៅពេលវាដល់ចុងបញ្ចប់ ឬដល់ចំណុចចាប់ផ្តើម ប្រសិនបើចាក់បញ្ច្រាស។"

msgid ""
"The animation restarts from the beginning when it reaches the end, or from "
"the end if played in reverse, repeating continuously."
msgstr ""
"Animation ចាប់ផ្តើមឡើងវិញពីដើមនៅពេលវាដល់ចុងបញ្ចប់ ឬពីចុងបញ្ចប់ ប្រសិនបើចាក់បញ្ច្រាស "
"ដោយធ្វើឡើងវិញជាបន្តបន្ទាប់។"

msgid ""
"The animation alternates direction each time it reaches the end or start, "
"playing forward and then in reverse repeatedly.\n"
"[b]Note:[/b] Both [AnimatedSprite2D] and [AnimatedSprite3D] play the first/"
"last frame for its duration only once at each end of the animation loop "
"(instead of twice, once per forward/backward animation direction)."
msgstr ""
"Animation ប្តូរទិសដៅឆ្លាស់គ្នារាល់ពេលដែលវាដល់ចុងបញ្ចប់ ឬចំណុចចាប់ផ្តើម ដោយចាក់ទៅមុខ "
"រួចចាក់បញ្ច្រាសឡើងវិញជាបន្តបន្ទាប់។\n"
"[b]ចំណាំ៖[/b] ទាំង [AnimatedSprite2D] និង [AnimatedSprite3D] ចាក់ frame ដំបូង/"
"ចុងក្រោយសម្រាប់ថិរវេលារបស់វាតែម្តងគត់នៅចុងបញ្ចប់នៃ animation loop នីមួយៗ (ជំនួសឱ្យការចាក់ពីរដង "
"ម្តងសម្រាប់ទិសដៅទៅមុខ/ថយក្រោយ)។"

msgid "A PBR (Physically Based Rendering) material to be used on 3D objects."
msgstr "Material ប្រភេទ PBR (Physically Based Rendering) សម្រាប់ប្រើលើវត្ថុ 3D។"

msgid ""
"[StandardMaterial3D]'s properties are inherited from [BaseMaterial3D]. "
"[StandardMaterial3D] uses separate textures for ambient occlusion, roughness "
"and metallic maps. To use a single ORM map for all 3 textures, use an "
"[ORMMaterial3D] instead."
msgstr ""
"លក្ខណៈសម្បត្តិរបស់ [StandardMaterial3D] ត្រូវបាន inherit ពី [BaseMaterial3D]។ "
"[StandardMaterial3D] ប្រើ textures ដាច់ដោយឡែកសម្រាប់ ambient occlusion, roughness "
"និង metallic maps។ ដើម្បីប្រើ ORM map តែមួយសម្រាប់ textures ទាំង 3 សូមប្រើ "
"[ORMMaterial3D] ជំនួសវិញ។"

msgid ""
"A 2D physics body that can't be moved by external forces. When moved "
"manually, it doesn't affect other bodies in its path."
msgstr ""
"2D physics body ដែលមិនអាចផ្លាស់ទីដោយកម្លាំងខាងក្រៅបានទេ។ នៅពេលផ្លាស់ទីដោយដៃ វាមិនប៉ះពាល់ដល់ "
"bodies ផ្សេងទៀតនៅក្នុងគន្លងរបស់វាទេ។"

msgid ""
"A static 2D physics body. It can't be moved by external forces or contacts, "
"but can be moved manually by other means such as code, [AnimationMixer]s "
"(with [member AnimationMixer.callback_mode_process] set to [constant "
"AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_PHYSICS]), and "
"[RemoteTransform2D].\n"
"When [StaticBody2D] is moved, it is teleported to its new position without "
"affecting other physics bodies in its path. If this is not desired, use "
"[AnimatableBody2D] instead.\n"
"[StaticBody2D] is useful for completely static objects like floors and walls, "
"as well as moving surfaces like conveyor belts and circular revolving "
"platforms (by using [member constant_linear_velocity] and [member "
"constant_angular_velocity])."
msgstr ""
"2D physics body បែបស្តាទិច (static)។ វាមិនអាចផ្លាស់ទីដោយកម្លាំងខាងក្រៅ ឬការប៉ះទង្គិចបានទេ "
"ប៉ុន្តែអាចផ្លាស់ទីដោយដៃតាមរយៈមធ្យោបាយផ្សេងទៀតដូចជា កូដ, [AnimationMixer]s (ដោយកំណត់ "
"[member AnimationMixer.callback_mode_process] ទៅជា [constant "
"AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_PHYSICS]) និង "
"[RemoteTransform2D]។\n"
"នៅពេលដែល [StaticBody2D] ត្រូវបានផ្លាស់ទី វាត្រូវបាន teleport ទៅកាន់ទីតាំងថ្មីរបស់វា "
"ដោយមិនប៉ះពាល់ដល់ physics bodies ផ្សេងទៀតនៅក្នុងគន្លងរបស់វាទេ។ ប្រសិនបើមិនចង់បានបែបនេះទេ "
"សូមប្រើ [AnimatableBody2D] ជំនួសវិញ។\n"
"[StaticBody2D] មានប្រយោជន៍សម្រាប់វត្ថុដែលស្តាទិចទាំងស្រុងដូចជា កម្រាល និងជញ្ជាំង "
"ព្រមទាំងផ្ទៃដែលផ្លាស់ទីដូចជា ខ្សែពាន (conveyor belts) និងវេទិកាមូលដែលវិល (ដោយប្រើ [member "
"constant_linear_velocity] និង [member constant_angular_velocity])។"

msgid ""
"The body's constant angular velocity. This does not rotate the body, but "
"affects touching bodies, as if it were rotating."
msgstr ""
"ល្បឿនមុំថេរ (constant angular velocity) របស់ body។ វាមិនធ្វើឱ្យ body វិលទេ "
"ប៉ុន្តែប៉ះពាល់ដល់ bodies ដែលប៉ះវា ហាក់ដូចជាវាកំពុងវិល។"

msgid ""
"The body's constant linear velocity. This does not move the body, but affects "
"touching bodies, as if it were moving."
msgstr ""
"ល្បឿនលីនេអ៊ែរថេរ (constant linear velocity) របស់ body។ វាមិនធ្វើឱ្យ body ផ្លាស់ទីទេ "
"ប៉ុន្តែប៉ះពាល់ដល់ bodies ដែលប៉ះវា ហាក់ដូចជាវាកំពុងផ្លាស់ទី។"

msgid ""
"A 3D physics body that can't be moved by external forces. When moved "
"manually, it doesn't affect other bodies in its path."
msgstr ""
"3D physics body ដែលមិនអាចផ្លាស់ទីដោយកម្លាំងខាងក្រៅបានទេ។ នៅពេលផ្លាស់ទីដោយដៃ វាមិនប៉ះពាល់ដល់ "
"bodies ផ្សេងទៀតនៅក្នុងគន្លងរបស់វាទេ។"

msgid ""
"A static 3D physics body. It can't be moved by external forces or contacts, "
"but can be moved manually by other means such as code, [AnimationMixer]s "
"(with [member AnimationMixer.callback_mode_process] set to [constant "
"AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_PHYSICS]), and "
"[RemoteTransform3D].\n"
"When [StaticBody3D] is moved, it is teleported to its new position without "
"affecting other physics bodies in its path. If this is not desired, use "
"[AnimatableBody3D] instead.\n"
"[StaticBody3D] is useful for completely static objects like floors and walls, "
"as well as moving surfaces like conveyor belts and circular revolving "
"platforms (by using [member constant_linear_velocity] and [member "
"constant_angular_velocity])."
msgstr ""
"3D physics body បែបស្តាទិច។ វាមិនអាចផ្លាស់ទីដោយកម្លាំងខាងក្រៅ ឬការប៉ះទង្គិចបានទេ "
"ប៉ុន្តែអាចផ្លាស់ទីដោយដៃតាមរយៈមធ្យោបាយផ្សេងទៀតដូចជា កូដ, [AnimationMixer]s (ដោយកំណត់ "
"[member AnimationMixer.callback_mode_process] ទៅជា [constant "
"AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_PHYSICS]) និង "
"[RemoteTransform3D]។\n"
"នៅពេលដែល [StaticBody3D] ត្រូវបានផ្លាស់ទី វាត្រូវបាន teleport ទៅកាន់ទីតាំងថ្មីរបស់វា "
"ដោយមិនប៉ះពាល់ដល់ physics bodies ផ្សេងទៀតនៅក្នុងគន្លងរបស់វាទេ។ ប្រសិនបើមិនចង់បានបែបនេះទេ "
"សូមប្រើ [AnimatableBody3D] ជំនួសវិញ។\n"
"[StaticBody3D] មានប្រយោជន៍សម្រាប់វត្ថុដែលស្តាទិចទាំងស្រុងដូចជា កម្រាល និងជញ្ជាំង "
"ព្រមទាំងផ្ទៃដែលផ្លាស់ទីដូចជា ខ្សែពាន និងវេទិកាមូលដែលវិល (ដោយប្រើ [member "
"constant_linear_velocity] និង [member constant_angular_velocity])។"

msgid ""
"Application status indicator (aka notification area icon).\n"
"[b]Note:[/b] Status indicator is implemented on macOS and Windows."
msgstr ""
"សូចនាករស្ថានភាពកម្មវិធី (ហៅម្យ៉ាងទៀតថា រូបតំណាងតំបន់ជូនដំណឹង)។\n"
"[b]ចំណាំ៖[/b] សូចនាករស្ថានភាពត្រូវបានអនុវត្តនៅលើ macOS និង Windows។"

msgid ""
"Returns the status indicator rectangle in screen coordinates. If this status "
"indicator is not visible, returns an empty [Rect2]."
msgstr ""
"ត្រឡប់ចតុកោណកែងនៃសូចនាករស្ថានភាពជាកូអរដោនេអេក្រង់។ ប្រសិនបើសូចនាករស្ថានភាពនេះមើលមិនឃើញ "
"វាត្រឡប់ [Rect2] ទទេ។"

msgid "Status indicator icon."
msgstr "រូបតំណាងសូចនាករស្ថានភាព។"

msgid ""
"Status indicator native popup menu. If this is set, the [signal pressed] "
"signal is not emitted.\n"
"[b]Note:[/b] Native popup is only supported if [NativeMenu] supports "
"[constant NativeMenu.FEATURE_POPUP_MENU] feature."
msgstr ""
"ម៉ឺនុយ popup ដើម (native) របស់សូចនាករស្ថានភាព។ ប្រសិនបើវាត្រូវបានកំណត់ [signal pressed] "
"នឹងមិនត្រូវបាន បញ្ចេញទេ។\n"
"[b]ចំណាំ៖[/b] Native popup ត្រូវបានគាំទ្រតែនៅពេលដែល [NativeMenu] គាំទ្រមុខងារ "
"[constant NativeMenu.FEATURE_POPUP_MENU] ប៉ុណ្ណោះ។"

msgid "Status indicator tooltip."
msgstr "Tooltip របស់សូចនាករស្ថានភាព។"

msgid "If [code]true[/code], the status indicator is visible."
msgstr "ប្រសិនបើ [code]true[/code] សូចនាករស្ថានភាពអាចមើលឃើញ។"

msgid "Emitted when the status indicator is pressed."
msgstr "បញ្ចេញនៅពេលដែលសូចនាករស្ថានភាពត្រូវបានចុច។"

msgid "Abstract base class for interacting with streams."
msgstr "Abstract base class សម្រាប់ធ្វើអន្តរកម្មជាមួយ streams។"

msgid "Gets a signed byte from the stream."
msgstr "ទទួលយក signed byte ពី stream។"

msgid "Gets a signed 16-bit value from the stream."
msgstr "ទទួលយកតម្លៃ signed 16-bit ពី stream។"

msgid "Gets a signed 32-bit value from the stream."
msgstr "ទទួលយកតម្លៃ signed 32-bit ពី stream។"

msgid "Gets a signed 64-bit value from the stream."
msgstr "ទទួលយកតម្លៃ signed 64-bit ពី stream។"

msgid "Returns the number of bytes this [StreamPeer] has available."
msgstr "ត្រឡប់ចំនួន bytes ដែល [StreamPeer] នេះមាន។"

msgid ""
"Returns a chunk data with the received bytes, as an [Array] containing two "
"elements: an [enum Error] constant and a [PackedByteArray]. [param bytes] is "
"the number of bytes to be received. If not enough bytes are available, the "
"function will block until the desired amount is received."
msgstr ""
"ត្រឡប់ chunk data ជាមួយ bytes ដែលបានទទួល ជា [Array] ដែលមានធាតុពីរ៖ [enum Error] "
"constant និង [PackedByteArray]។ [param bytes] គឺជាចំនួន bytes ដែលត្រូវទទួល។ "
"ប្រសិនបើមិនមាន bytes គ្រប់គ្រាន់ទេ អនុគមន៍នឹងរាំងខ្ទប់ (block) "
"រហូតទាល់តែចំនួនដែលចង់បានត្រូវបានទទួល។"

msgid "Gets a double-precision float from the stream."
msgstr "ទទួលយក double-precision float ពី stream។"

msgid "Gets a single-precision float from the stream."
msgstr "ទទួលយក single-precision float ពី stream។"

msgid "Gets a half-precision float from the stream."
msgstr "ទទួលយក half-precision float ពី stream។"

msgid ""
"Returns a chunk data with the received bytes, as an [Array] containing two "
"elements: an [enum Error] constant and a [PackedByteArray]. [param bytes] is "
"the number of bytes to be received. If not enough bytes are available, the "
"function will return how many were actually received."
msgstr ""
"ត្រឡប់ chunk data ជាមួយ bytes ដែលបានទទួល ជា [Array] ដែលមានធាតុពីរ៖ [enum Error] "
"constant និង [PackedByteArray]។ [param bytes] គឺជាចំនួន bytes ដែលត្រូវទទួល។ "
"ប្រសិនបើមិនមាន bytes គ្រប់គ្រាន់ទេ អនុគមន៍នេះនឹងត្រឡប់ចំនួនដែលបានទទួលជាក់ស្តែង។"

msgid ""
"Gets an ASCII string with byte-length [param bytes] from the stream. If "
"[param bytes] is negative (default) the length will be read from the stream "
"using the reverse process of [method put_string]."
msgstr ""
"ទទួលយក ASCII string ដែលមានប្រវែង byte [param bytes] ពី stream។ ប្រសិនបើ [param "
"bytes] អវិជ្ជមាន (លំនាំដើម) ប្រវែងនឹងត្រូវបានអានពី stream ដោយប្រើដំណើរការបញ្ច្រាសនៃ "
"[method put_string]។"

msgid "Gets an unsigned byte from the stream."
msgstr "ទទួលយក unsigned byte ពី stream។"

msgid "Gets an unsigned 16-bit value from the stream."
msgstr "ទទួលយកតម្លៃ unsigned 16-bit ពី stream។"

msgid "Gets an unsigned 32-bit value from the stream."
msgstr "ទទួលយកតម្លៃ unsigned 32-bit ពី stream។"

msgid "Gets an unsigned 64-bit value from the stream."
msgstr "ទទួលយកតម្លៃ unsigned 64-bit ពី stream។"

msgid ""
"Gets a UTF-8 string with byte-length [param bytes] from the stream (this "
"decodes the string sent as UTF-8). If [param bytes] is negative (default) the "
"length will be read from the stream using the reverse process of [method "
"put_utf8_string]."
msgstr ""
"ទទួលយក UTF-8 string ដែលមានប្រវែង byte [param bytes] ពី stream (វា decode string "
"ដែលបានផ្ញើជា UTF-8)។ ប្រសិនបើ [param bytes] អវិជ្ជមាន (លំនាំដើម) ប្រវែងនឹងត្រូវបានអានពី "
"stream ដោយប្រើដំណើរការបញ្ច្រាសនៃ [method put_utf8_string]។"

msgid ""
"Gets a Variant from the stream. If [param allow_objects] is [code]true[/"
"code], decoding objects is allowed.\n"
"Internally, this uses the same decoding mechanism as the [method "
"@GlobalScope.bytes_to_var] method.\n"
"[b]Warning:[/b] Deserialized objects can contain code which gets executed. Do "
"not use this option if the serialized object comes from untrusted sources to "
"avoid potential security threats such as remote code execution."
msgstr ""
"ទទួលយក Variant ពី stream។ ប្រសិនបើ [param allow_objects] គឺ [code]true[/code] ការ "
"decode objects ត្រូវបានអនុញ្ញាត។\n"
"ជាផ្ទៃក្នុង វាប្រើយន្តការ decode ដូចគ្នានឹងវិធីសាស្រ្ត [method "
"@GlobalScope.bytes_to_var]។\n"
"[b]ការព្រមាន៖[/b] Deserialized objects អាចមានផ្ទុកកូដដែលត្រូវបានប្រតិបត្តិ។ "
"សូមកុំប្រើជម្រើសនេះ ប្រសិនបើ serialized object មកពីប្រភពដែលមិនអាចទុកចិត្តបាន "
"ដើម្បីជៀសវាងការគំរាមកំហែងដល់សុវត្ថិភាព ដូចជាការប្រតិបត្តិកូដពីចម្ងាយ (remote code execution)។"

msgid "Puts a signed byte into the stream."
msgstr "ដាក់ signed byte ចូលទៅក្នុង stream។"

msgid "Puts a signed 16-bit value into the stream."
msgstr "ដាក់តម្លៃ signed 16-bit ចូលទៅក្នុង stream។"

msgid "Puts a signed 32-bit value into the stream."
msgstr "ដាក់តម្លៃ signed 32-bit ចូលទៅក្នុង stream។"

msgid "Puts a signed 64-bit value into the stream."
msgstr "ដាក់តម្លៃ signed 64-bit ចូលទៅក្នុង stream។"

msgid ""
"Sends a chunk of data through the connection, blocking if necessary until the "
"data is done sending. This function returns an [enum Error] code."
msgstr ""
"ផ្ញើ chunk នៃទិន្នន័យតាមរយៈការតភ្ជាប់ ដោយរាំងខ្ទប់ប្រសិនបើចាំបាច់ "
"រហូតទាល់តែការផ្ញើទិន្នន័យបានបញ្ចប់។ អនុគមន៍នេះត្រឡប់លេខកូដ [enum Error]។"

msgid "Puts a double-precision float into the stream."
msgstr "ដាក់ double-precision float ចូលទៅក្នុង stream។"

msgid "Puts a single-precision float into the stream."
msgstr "ដាក់ single-precision float ចូលទៅក្នុង stream។"

msgid "Puts a half-precision float into the stream."
msgstr "ដាក់ half-precision float ចូលទៅក្នុង stream។"

msgid ""
"Sends a chunk of data through the connection. If all the data could not be "
"sent at once, only part of it will. This function returns two values, an "
"[enum Error] code and an integer, describing how much data was actually sent."
msgstr ""
"ផ្ញើ chunk នៃទិន្នន័យតាមរយៈការតភ្ជាប់។ ប្រសិនបើទិន្នន័យទាំងអស់មិនអាចផ្ញើក្នុងពេលតែមួយបានទេ "
"នោះមានតែផ្នែកខ្លះប៉ុណ្ណោះដែលនឹងត្រូវបានផ្ញើ។ អនុគមន៍នេះត្រឡប់តម្លៃពីរ គឺលេខកូដ [enum Error] "
"និងចំនួនគត់ (integer) ដែលពិពណ៌នាអំពីចំនួនទិន្នន័យដែលបានផ្ញើជាក់ស្តែង។"

msgid ""
"Puts a zero-terminated ASCII string into the stream prepended by a 32-bit "
"unsigned integer representing its size.\n"
"[b]Note:[/b] To put an ASCII string without prepending its size, you can use "
"[method put_data]:\n"
"[codeblocks]\n"
"[gdscript]\n"
"put_data(\"Hello world\".to_ascii_buffer())\n"
"[/gdscript]\n"
"[csharp]\n"
"PutData(\"Hello World\".ToAsciiBuffer());\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"ដាក់ zero-terminated ASCII string ចូលទៅក្នុង stream ដោយបន្ថែមពីមុខនូវ 32-bit unsigned "
"integer ដែលតំណាងឱ្យទំហំរបស់វា។\n"
"[b]ចំណាំ៖[/b] ដើម្បីដាក់ ASCII string ដោយមិនបន្ថែមទំហំរបស់វាពីមុខ អ្នកអាចប្រើ [method "
"put_data]៖\n"
"[codeblocks]\n"
"[gdscript]\n"
"put_data(\"Hello world\".to_ascii_buffer())\n"
"[/gdscript]\n"
"[csharp]\n"
"PutData(\"Hello World\".ToAsciiBuffer());\n"
"[/csharp]\n"
"[/codeblocks]"

msgid "Puts an unsigned byte into the stream."
msgstr "ដាក់ unsigned byte ចូលទៅក្នុង stream។"

msgid "Puts an unsigned 16-bit value into the stream."
msgstr "ដាក់តម្លៃ unsigned 16-bit ចូលទៅក្នុង stream។"

msgid "Puts an unsigned 32-bit value into the stream."
msgstr "ដាក់តម្លៃ unsigned 32-bit ចូលទៅក្នុង stream។"

msgid "Puts an unsigned 64-bit value into the stream."
msgstr "ដាក់តម្លៃ unsigned 64-bit ចូលទៅក្នុង stream។"

msgid ""
"Puts a zero-terminated UTF-8 string into the stream prepended by a 32 bits "
"unsigned integer representing its size.\n"
"[b]Note:[/b] To put a UTF-8 string without prepending its size, you can use "
"[method put_data]:\n"
"[codeblocks]\n"
"[gdscript]\n"
"put_data(\"Hello world\".to_utf8_buffer())\n"
"[/gdscript]\n"
"[csharp]\n"
"PutData(\"Hello World\".ToUtf8Buffer());\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"ដាក់ zero-terminated UTF-8 string ចូលទៅក្នុង stream ដោយបន្ថែមពីមុខនូវ 32-bit unsigned "
"integer ដែលតំណាងឱ្យទំហំរបស់វា។\n"
"[b]ចំណាំ៖[/b] ដើម្បីដាក់ UTF-8 string ដោយមិនបន្ថែមទំហំរបស់វាពីមុខ អ្នកអាចប្រើ [method "
"put_data]៖\n"
"[codeblocks]\n"
"[gdscript]\n"
"put_data(\"Hello world\".to_utf8_buffer())\n"
"[/gdscript]\n"
"[csharp]\n"
"PutData(\"Hello World\".ToUtf8Buffer());\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Puts a Variant into the stream. If [param full_objects] is [code]true[/code] "
"encoding objects is allowed (and can potentially include code).\n"
"Internally, this uses the same encoding mechanism as the [method "
"@GlobalScope.var_to_bytes] method."
msgstr ""
"ដាក់ Variant ចូលទៅក្នុង stream។ ប្រសិនបើ [param full_objects] គឺ [code]true[/code] "
"ការ encode objects ត្រូវបានអនុញ្ញាត (ហើយអាចមានផ្ទុកកូដ)។\n"
"ជាផ្ទៃក្នុង វាប្រើយន្តការ encode ដូចគ្នានឹងវិធីសាស្រ្ត [method @GlobalScope.var_to_bytes]។"

msgid ""
"If [code]true[/code], this [StreamPeer] will using big-endian format for "
"encoding and decoding."
msgstr ""
"ប្រសិនបើ [code]true[/code] [StreamPeer] នេះនឹងប្រើទម្រង់ big-endian សម្រាប់ការ encode "
"និង decode។"

msgid "A stream peer used to handle binary data streams."
msgstr "Stream peer ដែលប្រើសម្រាប់គ្រប់គ្រង binary data streams។"

msgid ""
"A data buffer stream peer that uses a byte array as the stream. This object "
"can be used to handle binary data from network sessions. To handle binary "
"data stored in files, [FileAccess] can be used directly.\n"
"A [StreamPeerBuffer] object keeps an internal cursor which is the offset in "
"bytes to the start of the buffer. Get and put operations are performed at the "
"cursor position and will move the cursor accordingly."
msgstr ""
"Stream peer សម្រាប់ buffer ទិន្នន័យដែលប្រើអារេបៃ (byte array) ជា stream។ "
"វត្ថុនេះអាចត្រូវបានប្រើដើម្បីដោះស្រាយទិន្នន័យបែប binary ពីសម័យបណ្តាញ (network sessions)។ "
"ដើម្បីដោះស្រាយទិន្នន័យ binary ដែលរក្សាទុកក្នុងឯកសារ អ្នកអាចប្រើ [FileAccess] ដោយផ្ទាល់។\n"
"វត្ថុ [StreamPeerBuffer] រក្សាទុក cursor ខាងក្នុងមួយ ដែលជាគម្លាត (offset) គិតជា byte "
"ពីដើម buffer។ ប្រតិបត្តិការ Get និង put ត្រូវបានអនុវត្តនៅទីតាំង cursor ហើយនឹងផ្លាស់ទី cursor "
"ទៅតាមនោះ។"

msgid "Clears the [member data_array] and resets the cursor."
msgstr "សម្អាត (Clears) [member data_array] និងកំណត់ cursor ឡើងវិញ។"

msgid ""
"Returns a new [StreamPeerBuffer] with the same [member data_array] content."
msgstr "បង្វិល [StreamPeerBuffer] ថ្មីមួយដែលមានខ្លឹមសារ [member data_array] ដូចគ្នា។"

msgid "Returns the current cursor position."
msgstr "បង្វិលទីតាំង cursor បច្ចុប្បន្ន។"

msgid "Returns the size of [member data_array]."
msgstr "បង្វិលទំហំនៃ [member data_array]។"

msgid "Resizes the [member data_array]. This [i]doesn't[/i] update the cursor."
msgstr "ផ្លាស់ប្តូរទំហំ [member data_array]។ វា [i]មិន[/i] ធ្វើបច្ចុប្បន្នភាព cursor ទេ។"

msgid ""
"Moves the cursor to the specified position. [param position] must be a valid "
"index of [member data_array]."
msgstr ""
"ផ្លាស់ទី cursor ទៅកាន់ទីតាំងដែលបានបញ្ជាក់។ [param position] ត្រូវតែជា index ត្រឹមត្រូវនៃ "
"[member data_array]។"

msgid "The underlying data buffer. Setting this value resets the cursor."
msgstr "Buffer ទិន្នន័យមូលដ្ឋាន។ ការកំណត់តម្លៃនេះនឹងកំណត់ cursor ឡើងវិញ។"

msgid "A stream peer that handles GZIP and deflate compression/decompression."
msgstr ""
"Stream peer ដែលដោះស្រាយការបង្ហាប់/ពង្រីក (compression/decompression) ប្រភេទ GZIP និង "
"deflate។"

msgid ""
"This class allows to compress or decompress data using GZIP/deflate in a "
"streaming fashion. This is particularly useful when compressing or "
"decompressing files that have to be sent through the network without needing "
"to allocate them all in memory.\n"
"After starting the stream via [method start_compression] (or [method "
"start_decompression]), calling [method StreamPeer.put_partial_data] on this "
"stream will compress (or decompress) the data, writing it to the internal "
"buffer. Calling [method StreamPeer.get_available_bytes] will return the "
"pending bytes in the internal buffer, and [method "
"StreamPeer.get_partial_data] will retrieve the compressed (or decompressed) "
"bytes from it. When the stream is over, you must call [method finish] to "
"ensure the internal buffer is properly flushed (make sure to call [method "
"StreamPeer.get_available_bytes] on last time to check if more data needs to "
"be read after that)."
msgstr ""
"Class នេះអនុញ្ញាតឱ្យបង្ហាប់ ឬពង្រីកទិន្នន័យដោយប្រើ GZIP/deflate ក្នុងលក្ខណៈ streaming។ "
"នេះមានប្រយោជន៍ជាពិសេសនៅពេលបង្ហាប់ ឬពង្រីកឯកសារដែលត្រូវផ្ញើតាមបណ្តាញ "
"ដោយមិនចាំបាច់បែងចែកវាទាំងអស់ក្នុងអង្គចងចាំ។\n"
"បន្ទាប់ពីចាប់ផ្តើម stream តាមរយៈ [method start_compression] (ឬ [method "
"start_decompression]) ការហៅ [method StreamPeer.put_partial_data] លើ stream "
"នេះនឹងបង្ហាប់ (ឬពង្រីក) ទិន្នន័យ ហើយសរសេរវាទៅក្នុង buffer ខាងក្នុង។ ការហៅ [method "
"StreamPeer.get_available_bytes] នឹងបង្វិល byte ដែលកំពុងរង់ចាំក្នុង buffer ខាងក្នុង ហើយ "
"[method StreamPeer.get_partial_data] នឹងទាញយក byte ដែលបានបង្ហាប់ (ឬពង្រីក) ពីវា។ "
"នៅពេល stream បញ្ចប់ អ្នកត្រូវតែហៅ [method finish] ដើម្បីធានាថា buffer "
"ខាងក្នុងត្រូវបានជម្រះ (flushed) បានត្រឹមត្រូវ (ត្រូវប្រាកដថាហៅ [method "
"StreamPeer.get_available_bytes] ជាលើកចុងក្រោយ "
"ដើម្បីពិនិត្យមើលថាតើមានទិន្នន័យបន្ថែមដែលត្រូវអានបន្ទាប់ពីនោះឬអត់)។"

msgid "Clears this stream, resetting the internal state."
msgstr "សម្អាត stream នេះ និងកំណត់ស្ថានភាពខាងក្នុងឡើងវិញ។"

msgid ""
"Finalizes the stream, compressing any buffered chunk left.\n"
"You must call it only when you are compressing."
msgstr ""
"បញ្ចប់ stream ដោយបង្ហាប់ chunk ដែលនៅសល់ក្នុង buffer។\n"
"អ្នកត្រូវតែហៅវាតែនៅពេលដែលអ្នកកំពុងបង្ហាប់ប៉ុណ្ណោះ។"

msgid ""
"Start the stream in compression mode with the given [param buffer_size], if "
"[param use_deflate] is [code]true[/code] uses deflate instead of GZIP."
msgstr ""
"ចាប់ផ្តើម stream ក្នុងរបៀបបង្ហាប់ (compression mode) ជាមួយ [param buffer_size] "
"ដែលបានផ្តល់ឱ្យ ប្រសិនបើ [param use_deflate] គឺ [code]true[/code] នឹងប្រើ deflate "
"ជំនួសឱ្យ GZIP។"

msgid ""
"Start the stream in decompression mode with the given [param buffer_size], if "
"[param use_deflate] is [code]true[/code] uses deflate instead of GZIP."
msgstr ""
"ចាប់ផ្តើម stream ក្នុងរបៀបពង្រីក (decompression mode) ជាមួយ [param buffer_size] "
"ដែលបានផ្តល់ឱ្យ ប្រសិនបើ [param use_deflate] គឺ [code]true[/code] នឹងប្រើ deflate "
"ជំនួសឱ្យ GZIP។"

msgid "Abstract base class for interacting with socket streams."
msgstr "Base class អរូបី (Abstract) សម្រាប់ទំនាក់ទំនងជាមួយ socket streams។"

msgid ""
"StreamPeerSocket is an abstract base class that defines common behavior for "
"socket-based streams."
msgstr ""
"StreamPeerSocket គឺជា abstract base class ដែលកំណត់ឥរិយាបថរួមសម្រាប់ streams "
"ដែលផ្អែកលើ socket។"

msgid "Disconnects from host."
msgstr "ផ្តាច់ការតភ្ជាប់ពី host។"

msgid "Polls the socket, updating its state. See [method get_status]."
msgstr "Poll socket ដើម្បីធ្វើបច្ចុប្បន្នភាពស្ថានភាពរបស់វា។ សូមមើល [method get_status]។"

msgid ""
"The initial status of the [StreamPeerSocket]. This is also the status after "
"disconnecting."
msgstr ""
"ស្ថានភាពដំបូងនៃ [StreamPeerSocket]។ នេះក៏ជាស្ថានភាពបន្ទាប់ពីការផ្តាច់ការតភ្ជាប់ផងដែរ។"

msgid "A status representing a [StreamPeerSocket] that is connecting to a host."
msgstr "ស្ថានភាពដែលតំណាងឱ្យ [StreamPeerSocket] ដែលកំពុងតភ្ជាប់ទៅកាន់ host។"

msgid "A status representing a [StreamPeerSocket] that is connected to a host."
msgstr "ស្ថានភាពដែលតំណាងឱ្យ [StreamPeerSocket] ដែលបានតភ្ជាប់ទៅកាន់ host។"

msgid "A status representing a [StreamPeerSocket] in error state."
msgstr "ស្ថានភាពដែលតំណាងឱ្យ [StreamPeerSocket] ដែលស្ថិតក្នុងស្ថានភាពកំហុស។"

msgid "A stream peer that handles TCP connections."
msgstr "Stream peer ដែលដោះស្រាយការតភ្ជាប់ TCP។"

msgid ""
"Opens the TCP socket, and binds it to the specified local address.\n"
"This method is generally not needed, and only used to force the subsequent "
"call to [method connect_to_host] to use the specified [param host] and [param "
"port] as source address. This can be desired in some NAT punchthrough "
"techniques, or when forcing the source network interface."
msgstr ""
"បើក TCP socket និងភ្ជាប់ (bind) វាទៅកាន់អាសយដ្ឋាន local ដែលបានបញ្ជាក់។\n"
"វិធីសាស្រ្តនេះជាទូទៅមិនចាំបាច់ទេ ហើយត្រូវបានប្រើតែដើម្បីបង្ខំការហៅបន្តបន្ទាប់ទៅកាន់ [method "
"connect_to_host] ឱ្យប្រើ [param host] និង [param port] ដែលបានបញ្ជាក់ជាអាសយដ្ឋានប្រភព "
"(source address)។ នេះអាចជាការចង់បាននៅក្នុងបច្ចេកទេស NAT punchthrough មួយចំនួន "
"ឬនៅពេលបង្ខំ source network interface។"

msgid ""
"Connects to the specified [code]host:port[/code] pair. A hostname will be "
"resolved if valid. Returns [constant OK] on success."
msgstr ""
"តភ្ជាប់ទៅកាន់គូ [code]host:port[/code] ដែលបានបញ្ជាក់។ Hostname នឹងត្រូវបាន resolve "
"ប្រសិនបើវាត្រឹមត្រូវ។ បង្វិល [constant OK] នៅពេលជោគជ័យ។"

msgid "Returns the IP of this peer."
msgstr "បង្វិល IP របស់ peer នេះ។"

msgid "Returns the port of this peer."
msgstr "បង្វិល port របស់ peer នេះ។"

msgid ""
"If [param enabled] is [code]true[/code], packets will be sent immediately. If "
"[param enabled] is [code]false[/code] (the default), packet transfers will be "
"delayed and combined using [url=https://en.wikipedia.org/wiki/"
"Nagle%27s_algorithm]Nagle's algorithm[/url].\n"
"[b]Note:[/b] It's recommended to leave this disabled for applications that "
"send large packets or need to transfer a lot of data, as enabling this can "
"decrease the total available bandwidth."
msgstr ""
"ប្រសិនបើ [param enabled] គឺ [code]true[/code] packets នឹងត្រូវបានផ្ញើភ្លាមៗ។ ប្រសិនបើ "
"[param enabled] គឺ [code]false[/code] (លំនាំដើម) ការផ្ទេរ packet នឹងត្រូវបានពន្យារពេល "
"និងបញ្ចូលគ្នាដោយប្រើ [url=https://en.wikipedia.org/wiki/"
"Nagle%27s_algorithm]Nagle's algorithm[/url]។\n"
"[b]ចំណាំ៖[/b] គួរតែទុកវាជា disabled សម្រាប់កម្មវិធីដែលផ្ញើ packet ធំៗ "
"ឬត្រូវការផ្ទេរទិន្នន័យច្រើន ព្រោះការបើកវាអាចធ្វើឱ្យថយចុះ bandwidth សរុបដែលអាចប្រើបាន។"

msgid "A stream peer that handles TLS connections."
msgstr "Stream peer ដែលដោះស្រាយការតភ្ជាប់ TLS។"

msgid ""
"Accepts a peer connection as a server using the given [param server_options]. "
"See [method TLSOptions.server]."
msgstr ""
"ទទួលយកការតភ្ជាប់ peer ក្នុងនាមជា server ដោយប្រើ [param server_options] ដែលបានផ្តល់ឱ្យ។ "
"សូមមើល [method TLSOptions.server]។"

msgid ""
"Connects to a peer using an underlying [StreamPeer] [param stream] and "
"verifying the remote certificate is correctly signed for the given [param "
"common_name]. You can pass the optional [param client_options] parameter to "
"customize the trusted certification authorities, or disable the common name "
"verification. See [method TLSOptions.client] and [method "
"TLSOptions.client_unsafe]."
msgstr ""
"តភ្ជាប់ទៅកាន់ peer ដោយប្រើ [StreamPeer] [param stream] មូលដ្ឋាន និងផ្ទៀងផ្ទាត់ថា remote "
"certificate ត្រូវបានចុះហត្ថលេខាយ៉ាងត្រឹមត្រូវសម្រាប់ [param common_name] ដែលបានផ្តល់ឱ្យ។ "
"អ្នកអាចបញ្ជូនប៉ារ៉ាម៉ែត្រស្រេចចិត្ត [param client_options] ដើម្បីប្ដូរតាមបំណងនូវ trusted "
"certification authorities ឬបិទការផ្ទៀងផ្ទាត់ common name។ សូមមើល [method "
"TLSOptions.client] និង [method TLSOptions.client_unsafe]។"

msgid ""
"Returns the underlying [StreamPeer] connection, used in [method "
"accept_stream] or [method connect_to_stream]."
msgstr ""
"បង្វិលការតភ្ជាប់ [StreamPeer] មូលដ្ឋាន ដែលប្រើក្នុង [method accept_stream] ឬ [method "
"connect_to_stream]។"

msgid ""
"Poll the connection to check for incoming bytes. Call this right before "
"[method StreamPeer.get_available_bytes] for it to work properly."
msgstr ""
"Poll ការតភ្ជាប់ដើម្បីពិនិត្យមើល byte ដែលចូលមក។ ហៅវាភ្លាមៗមុនពេល [method "
"StreamPeer.get_available_bytes] ដើម្បីឱ្យវាដំណើរការបានត្រឹមត្រូវ។"

msgid "A status representing a [StreamPeerTLS] that is disconnected."
msgstr "ស្ថានភាពដែលតំណាងឱ្យ [StreamPeerTLS] ដែលបានផ្តាច់ការតភ្ជាប់។"

msgid "A status representing a [StreamPeerTLS] during handshaking."
msgstr "ស្ថានភាពដែលតំណាងឱ្យ [StreamPeerTLS] កំឡុងពេល handshaking។"

msgid "A status representing a [StreamPeerTLS] that is connected to a host."
msgstr "ស្ថានភាពដែលតំណាងឱ្យ [StreamPeerTLS] ដែលបានតភ្ជាប់ទៅកាន់ host។"

msgid "A status representing a [StreamPeerTLS] in error state."
msgstr "ស្ថានភាពដែលតំណាងឱ្យ [StreamPeerTLS] ដែលស្ថិតក្នុងស្ថានភាពកំហុស។"

msgid ""
"An error status that shows a mismatch in the TLS certificate domain presented "
"by the host and the domain requested for validation."
msgstr ""
"ស្ថានភាពកំហុសដែលបង្ហាញពីភាពមិនស៊ីគ្នានៃ TLS certificate domain ដែលបង្ហាញដោយ host និង "
"domain ដែលបានស្នើសុំសម្រាប់ការផ្ទៀងផ្ទាត់។"

msgid "A stream peer that handles UNIX Domain Socket (UDS) connections."
msgstr "Stream peer ដែលដោះស្រាយការតភ្ជាប់ UNIX Domain Socket (UDS)។"

msgid ""
"A stream peer that handles UNIX Domain Socket (UDS) connections. This object "
"can be used to connect to UDS servers, or also is returned by a UDS server. "
"Unix Domain Sockets provide inter-process communication on the same machine "
"using the filesystem namespace.\n"
"[b]Note:[/b] UNIX Domain Sockets are only available on UNIX-like systems "
"(Linux, macOS, etc.) and are not supported on Windows."
msgstr ""
"Stream peer ដែលដោះស្រាយការតភ្ជាប់ UNIX Domain Socket (UDS)។ "
"វត្ថុនេះអាចត្រូវបានប្រើដើម្បីតភ្ជាប់ទៅកាន់ UDS servers ឬក៏ត្រូវបានបង្វិលដោយ UDS server "
"ផងដែរ។ Unix Domain Sockets ផ្តល់នូវការទំនាក់ទំនងរវាងដំណើរការ (inter-process "
"communication) នៅលើម៉ាស៊ីនតែមួយដោយប្រើ filesystem namespace។\n"
"[b]ចំណាំ៖[/b] UNIX Domain Sockets មានតែនៅលើប្រព័ន្ធដែលដូច UNIX (Linux, macOS, ។ល។) "
"ប៉ុណ្ណោះ ហើយមិនគាំទ្រលើ Windows ទេ។"

msgid ""
"Opens the UDS socket, and binds it to the specified socket path.\n"
"This method is generally not needed, and only used to force the subsequent "
"call to [method connect_to_host] to use the specified [param path] as the "
"source address."
msgstr ""
"បើក UDS socket និងភ្ជាប់ (bind) វាទៅកាន់ socket path ដែលបានបញ្ជាក់។\n"
"វិធីសាស្រ្តនេះជាទូទៅមិនចាំបាច់ទេ ហើយត្រូវបានប្រើតែដើម្បីបង្ខំការហៅបន្តបន្ទាប់ទៅកាន់ [method "
"connect_to_host] ឱ្យប្រើ [param path] ដែលបានបញ្ជាក់ជាអាសយដ្ឋានប្រភព (source "
"address)។"

msgid ""
"Connects to the specified UNIX Domain Socket path. Returns [constant OK] on "
"success."
msgstr ""
"តភ្ជាប់ទៅកាន់ UNIX Domain Socket path ដែលបានបញ្ជាក់។ បង្វិល [constant OK] នៅពេលជោគជ័យ។"

msgid "Returns the socket path of this peer."
msgstr "បង្វិល socket path របស់ peer នេះ។"

msgid "A built-in type for strings."
msgstr "ប្រភេទដែលមានស្រាប់ (built-in type) សម្រាប់ strings។"

msgid ""
"This is the built-in string Variant type (and the one used by GDScript). "
"Strings may contain any number of Unicode characters, and expose methods "
"useful for manipulating and generating strings. Strings are reference-counted "
"and use a copy-on-write approach (every modification to a string returns a "
"new [String]), so passing them around is cheap in resources.\n"
"Some string methods have corresponding variations. Variations suffixed with "
"[code]n[/code] ([method countn], [method findn], [method replacen], etc.) are "
"[b]case-insensitive[/b] (they make no distinction between uppercase and "
"lowercase letters). Method variations prefixed with [code]r[/code] ([method "
"rfind], [method rsplit], etc.) are reversed, and start from the end of the "
"string, instead of the beginning.\n"
"To convert any [Variant] to or from a string, see [method @GlobalScope.str], "
"[method @GlobalScope.str_to_var], and [method @GlobalScope.var_to_str].\n"
"[b]Note:[/b] In a boolean context, a string will evaluate to [code]false[/"
"code] if it is empty ([code]\"\"[/code]). Otherwise, a string will always "
"evaluate to [code]true[/code]."
msgstr ""
"នេះគឺជាប្រភេទ string Variant ដែលមានស្រាប់ (និងជាប្រភេទដែលប្រើដោយ GDScript)។ Strings "
"អាចមានតួអក្សរ Unicode ចំនួនប៉ុន្មានក៏បាន ហើយបង្ហាញវិធីសាស្រ្តដែលមានប្រយោជន៍សម្រាប់ការចាត់ចែង "
"និងបង្កើត strings។ Strings ត្រូវបានរាប់ reference (reference-counted) និងប្រើវិធីសាស្រ្ត "
"copy-on-write (រាល់ការកែប្រែលើ string នឹងបង្វិល [String] ថ្មី) "
"ដូច្នេះការបញ្ជូនវាគឺចំណាយធនធានតិច។\n"
"វិធីសាស្រ្ត string មួយចំនួនមានទម្រង់បំរែបំរួលដែលត្រូវគ្នា។ ទម្រង់បំរែបំរួលដែលមានផ្នែកបន្ថែម "
"[code]n[/code] ([method countn], [method findn], [method replacen], ។ល។) គឺ "
"[b]case-insensitive[/b] (ពួកវាមិនបែងចែករវាងតួអក្សរធំ និងតូចទេ)។ "
"ទម្រង់បំរែបំរួលវិធីសាស្រ្តដែលមានបុព្វបទ [code]r[/code] ([method rfind], [method rsplit], "
"។ល។) គឺបញ្ច្រាស ហើយចាប់ផ្តើមពីចុង string ជំនួសឱ្យការចាប់ផ្តើម។\n"
"ដើម្បីបម្លែង [Variant] ណាមួយទៅជា ឬពី string សូមមើល [method @GlobalScope.str], "
"[method @GlobalScope.str_to_var], និង [method @GlobalScope.var_to_str]។\n"
"[b]ចំណាំ៖[/b] នៅក្នុងបរិបទ boolean, string នឹងវាយតម្លៃទៅជា [code]false[/code] "
"ប្រសិនបើវាទទេ ([code]\"\"[/code])។ បើពុំនោះទេ string នឹងវាយតម្លៃទៅជា [code]true[/"
"code] ជានិច្ច។"

msgid "GDScript format strings"
msgstr "ទម្រង់ strings របស់ GDScript"

msgid "Constructs an empty [String] ([code]\"\"[/code])."
msgstr "បង្កើត [String] ទទេ ([code]\"\"[/code])។"

msgid "Constructs a [String] as a copy of the given [String]."
msgstr "បង្កើត [String] ជាច្បាប់ចម្លងនៃ [String] ដែលបានផ្តល់ឱ្យ។"

msgid "Constructs a new [String] from the given [NodePath]."
msgstr "បង្កើត [String] ថ្មីពី [NodePath] ដែលបានផ្តល់ឱ្យ។"

msgid "Constructs a new [String] from the given [StringName]."
msgstr "បង្កើត [String] ថ្មីពី [StringName] ដែលបានផ្តល់ឱ្យ។"

msgid ""
"Returns [code]true[/code] if the string begins with the given [param text]. "
"See also [method ends_with]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ string ចាប់ផ្តើមដោយ [param text] ដែលបានផ្តល់ឱ្យ។ "
"សូមមើលផងដែរ [method ends_with]។"

msgid ""
"Returns an array containing the bigrams (pairs of consecutive characters) of "
"this string.\n"
"[codeblock]\n"
"print(\"Get up!\".bigrams()) # Prints [\"Ge\", \"et\", \"t \", \" u\", "
"\"up\", \"p!\"]\n"
"[/codeblock]"
msgstr ""
"បង្វិលអារេដែលមាន bigrams (គូនៃតួអក្សរជាប់គ្នា) នៃ string នេះ។\n"
"[codeblock]\n"
"print(\"Get up!\".bigrams()) # បង្ហាញ [\"Ge\", \"et\", \"t \", \" u\", \"up\", "
"\"p!\"]\n"
"[/codeblock]"

msgid ""
"Converts the string representing a binary number into an [int]. The string "
"may optionally be prefixed with [code]\"0b\"[/code], and an additional [code]-"
"[/code] prefix for negative numbers.\n"
"[codeblocks]\n"
"[gdscript]\n"
"print(\"101\".bin_to_int())   # Prints 5\n"
"print(\"0b101\".bin_to_int()) # Prints 5\n"
"print(\"-0b10\".bin_to_int()) # Prints -2\n"
"[/gdscript]\n"
"[csharp]\n"
"GD.Print(\"101\".BinToInt());   // Prints 5\n"
"GD.Print(\"0b101\".BinToInt()); // Prints 5\n"
"GD.Print(\"-0b10\".BinToInt()); // Prints -2\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"បម្លែង string ដែលតំណាងឱ្យលេខ binary ទៅជា [int]។ String អាចមានបុព្វបទ [code]\"0b\"[/"
"code] ជាជម្រើស និងបុព្វបទ [code]-[/code] បន្ថែមសម្រាប់លេខអវិជ្ជមាន។\n"
"[codeblocks]\n"
"[gdscript]\n"
"print(\"101\".bin_to_int())   # បង្ហាញ 5\n"
"print(\"0b101\".bin_to_int()) # បង្ហាញ 5\n"
"print(\"-0b10\".bin_to_int()) # បង្ហាញ -2\n"
"[/gdscript]\n"
"[csharp]\n"
"GD.Print(\"101\".BinToInt());   // បង្ហាញ 5\n"
"GD.Print(\"0b101\".BinToInt()); // បង្ហាញ 5\n"
"GD.Print(\"-0b10\".BinToInt()); // បង្ហាញ -2\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Returns a copy of the string with special characters escaped using the C "
"language standard."
msgstr "បង្វិលច្បាប់ចម្លងនៃ string ដែលតួអក្សរពិសេសត្រូវបាន escape ដោយប្រើស្តង់ដារភាសា C។"

msgid ""
"Returns a copy of the string with escaped characters replaced by their "
"meanings. Supported escape sequences are [code]\\'[/code], [code]\\\"[/code], "
"[code]\\\\[/code], [code]\\a[/code], [code]\\b[/code], [code]\\f[/code], "
"[code]\\n[/code], [code]\\r[/code], [code]\\t[/code], [code]\\v[/code].\n"
"[b]Note:[/b] Unlike the GDScript parser, this method doesn't support the "
"[code]\\uXXXX[/code] escape sequence."
msgstr ""
"បង្វិលច្បាប់ចម្លងនៃ string ដែលតួអក្សរ escaped ត្រូវបានជំនួសដោយអត្ថន័យរបស់ពួកវា។ Escape "
"sequences ដែលគាំទ្រគឺ [code]\\'[/code], [code]\\\"[/code], [code]\\\\[/code], "
"[code]\\a[/code], [code]\\b[/code], [code]\\f[/code], [code]\\n[/code], [code]"
"\\r[/code], [code]\\t[/code], [code]\\v[/code]។\n"
"[b]ចំណាំ៖[/b] ខុសពី GDScript parser វិធីសាស្រ្តនេះមិនគាំទ្រ escape sequence [code]"
"\\uXXXX[/code] ទេ។"

msgid ""
"Returns a copy of the string with changed appearance. Replaces underscores "
"([code]_[/code]) and hyphens ([code]-[/code]) with spaces, adds spaces before "
"uppercase letters in the middle of a word, converts all letters to lowercase, "
"then converts the first one and each one following a space to uppercase.\n"
"[codeblocks]\n"
"[gdscript]\n"
"\"move_local_x\".capitalize()   # Returns \"Move Local X\"\n"
"\"sceneFile_path\".capitalize() # Returns \"Scene File Path\"\n"
"\"2D, FPS, PNG\".capitalize()   # Returns \"2d, Fps, Png\"\n"
"\"example-name\".capitalize()   # Returns \"Example Name\"\n"
"[/gdscript]\n"
"[csharp]\n"
"\"move_local_x\".Capitalize();   // Returns \"Move Local X\"\n"
"\"sceneFile_path\".Capitalize(); // Returns \"Scene File Path\"\n"
"\"2D, FPS, PNG\".Capitalize();   // Returns \"2d, Fps, Png\"\n"
"\"example-name\".Capitalize();   // Returns \"Example Name\"\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"បង្វិលច្បាប់ចម្លងនៃ string ដែលមានរូបរាងផ្លាស់ប្តូរ។ ជំនួសសញ្ញា underscore ([code]_[/code]) "
"និង hyphen ([code]-[/code]) ដោយចន្លោះ បន្ថែមចន្លោះមុនតួអក្សរធំនៅកណ្តាលពាក្យ "
"បម្លែងតួអក្សរទាំងអស់ទៅជាតួអក្សរតូច រួចបម្លែងតួអក្សរដំបូង "
"និងតួអក្សរដែលនៅបន្ទាប់ពីចន្លោះនីមួយៗទៅជាតួអក្សរធំ។\n"
"[codeblocks]\n"
"[gdscript]\n"
"\"move_local_x\".capitalize()   # បង្វិល \"Move Local X\"\n"
"\"sceneFile_path\".capitalize() # បង្វិល \"Scene File Path\"\n"
"\"2D, FPS, PNG\".capitalize()   # បង្វិល \"2d, Fps, Png\"\n"
"\"example-name\".capitalize()   # បង្វិល \"Example Name\"\n"
"[/gdscript]\n"
"[csharp]\n"
"\"move_local_x\".Capitalize();   // បង្វិល \"Move Local X\"\n"
"\"sceneFile_path\".Capitalize(); // បង្វិល \"Scene File Path\"\n"
"\"2D, FPS, PNG\".Capitalize();   // បង្វិល \"2d, Fps, Png\"\n"
"\"example-name\".Capitalize();   // បង្វិល \"Example Name\"\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Performs a case-sensitive comparison to another string. Returns [code]-1[/"
"code] if less than, [code]1[/code] if greater than, or [code]0[/code] if "
"equal. \"Less than\" and \"greater than\" are determined by the [url=https://"
"en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode code points[/url] of "
"each string, which roughly matches the alphabetical order.\n"
"If the character comparison reaches the end of one string, but the other "
"string contains more characters, then it will use length as the deciding "
"factor: [code]1[/code] will be returned if this string is longer than the "
"[param to] string, or [code]-1[/code] if shorter. Note that the length of "
"empty strings is always [code]0[/code].\n"
"To get a [bool] result from a string comparison, use the [code]==[/code] "
"operator instead. See also [method nocasecmp_to], [method filecasecmp_to], "
"and [method naturalcasecmp_to]."
msgstr ""
"ធ្វើការប្រៀបធៀបដោយបែងចែកតួអក្សរធំតូច (case-sensitive) ទៅនឹង string មួយទៀត។ បង្វិល "
"[code]-1[/code] ប្រសិនបើតូចជាង, [code]1[/code] ប្រសិនបើធំជាង, ឬ [code]0[/code] "
"ប្រសិនបើស្មើ។ \"តូចជាង\" និង \"ធំជាង\" ត្រូវបានកំណត់ដោយ [url=https://en.wikipedia.org/"
"wiki/List_of_Unicode_characters]Unicode code points[/url] នៃ string នីមួយៗ "
"ដែលប្រហាក់ប្រហែលនឹងលំដាប់អក្ខរក្រម។\n"
"ប្រសិនបើការប្រៀបធៀបតួអក្សរឈានដល់ចុងបញ្ចប់នៃ string មួយ ប៉ុន្តែ string មួយទៀតមានតួអក្សរច្រើនជាង "
"នោះវានឹងប្រើប្រវែងជាកត្តាកំណត់៖ [code]1[/code] នឹងត្រូវបានបង្វិល ប្រសិនបើ string នេះវែងជាង "
"string [param to] ឬ [code]-1[/code] ប្រសិនបើខ្លីជាង។ សូមចំណាំថាប្រវែងនៃ string ទទេគឺ "
"[code]0[/code] ជានិច្ច។\n"
"ដើម្បីទទួលបានលទ្ធផល [bool] ពីការប្រៀបធៀប string សូមប្រើប្រតិបត្តិករ [code]==[/code] "
"ជំនួសវិញ។ សូមមើលផងដែរ [method nocasecmp_to], [method filecasecmp_to], និង [method "
"naturalcasecmp_to]។"

msgid ""
"Returns a single Unicode character from the integer [param code]. You may use "
"[url=https://unicodelookup.com/]unicodelookup.com[/url] or [url=https://"
"www.unicode.org/charts/]unicode.org[/url] as points of reference.\n"
"[codeblock]\n"
"print(String.chr(65))     # Prints \"A\"\n"
"print(String.chr(129302)) # Prints \"🤖\" (robot face emoji)\n"
"[/codeblock]\n"
"See also [method unicode_at], [method @GDScript.char], and [method "
"@GDScript.ord]."
msgstr ""
"បង្វិលតួអក្សរ Unicode តែមួយពីចំនួនគត់ [param code]។ អ្នកអាចប្រើ [url=https://"
"unicodelookup.com/]unicodelookup.com[/url] ឬ [url=https://www.unicode.org/"
"charts/]unicode.org[/url] ជាចំណុចយោង។\n"
"[codeblock]\n"
"print(String.chr(65))     # បង្ហាញ \"A\"\n"
"print(String.chr(129302)) # បង្ហាញ \"🤖\" (emoji មុខមនុស្សយន្ត)\n"
"[/codeblock]\n"
"សូមមើលផងដែរ [method unicode_at], [method @GDScript.char], និង [method "
"@GDScript.ord]។"

msgid ""
"Returns [code]true[/code] if the string contains [param what]. In GDScript, "
"this corresponds to the [code]in[/code] operator.\n"
"[codeblocks]\n"
"[gdscript]\n"
"print(\"Node\".contains(\"de\")) # Prints true\n"
"print(\"team\".contains(\"I\"))  # Prints false\n"
"print(\"I\" in \"team\")         # Prints false\n"
"[/gdscript]\n"
"[csharp]\n"
"GD.Print(\"Node\".Contains(\"de\")); // Prints True\n"
"GD.Print(\"team\".Contains(\"I\"));  // Prints False\n"
"[/csharp]\n"
"[/codeblocks]\n"
"If you need to know where [param what] is within the string, use [method "
"find]. See also [method containsn]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ string មានផ្ទុក [param what]។ នៅក្នុង GDScript "
"នេះត្រូវនឹងប្រតិបត្តិករ [code]in[/code]។\n"
"[codeblocks]\n"
"[gdscript]\n"
"print(\"Node\".contains(\"de\")) # បង្ហាញ true\n"
"print(\"team\".contains(\"I\"))  # បង្ហាញ false\n"
"print(\"I\" in \"team\")         # បង្ហាញ false\n"
"[/gdscript]\n"
"[csharp]\n"
"GD.Print(\"Node\".Contains(\"de\")); // បង្ហាញ True\n"
"GD.Print(\"team\".Contains(\"I\"));  // បង្ហាញ False\n"
"[/csharp]\n"
"[/codeblocks]\n"
"ប្រសិនបើអ្នកត្រូវការដឹងថា [param what] នៅត្រង់ណាក្នុង string សូមប្រើ [method find]។ "
"សូមមើលផងដែរ [method containsn]។"

msgid ""
"Returns [code]true[/code] if the string contains [param what], [b]ignoring "
"case[/b].\n"
"If you need to know where [param what] is within the string, use [method "
"findn]. See also [method contains]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ string មានផ្ទុក [param what] ដោយ "
"[b]មិនបែងចែកតួអក្សរធំតូច[/b]។\n"
"ប្រសិនបើអ្នកត្រូវការដឹងថា [param what] នៅត្រង់ណាក្នុង string សូមប្រើ [method findn]។ "
"សូមមើលផងដែរ [method contains]។"

msgid ""
"Returns the number of occurrences of the substring [param what] between "
"[param from] and [param to] positions. If [param to] is 0, the search "
"continues until the end of the string."
msgstr ""
"បង្វិលចំនួនដងនៃការកើតឡើងនៃ substring [param what] រវាងទីតាំង [param from] និង [param "
"to]។ ប្រសិនបើ [param to] គឺ 0 ការស្វែងរកនឹងបន្តរហូតដល់ចុងបញ្ចប់នៃ string។"

msgid ""
"Returns the number of occurrences of the substring [param what] between "
"[param from] and [param to] positions, [b]ignoring case[/b]. If [param to] is "
"0, the search continues until the end of the string."
msgstr ""
"បង្វិលចំនួនដងនៃការកើតឡើងនៃ substring [param what] រវាងទីតាំង [param from] និង [param "
"to] ដោយ [b]មិនបែងចែកតួអក្សរធំតូច[/b]។ ប្រសិនបើ [param to] គឺ 0 "
"ការស្វែងរកនឹងបន្តរហូតដល់ចុងបញ្ចប់នៃ string។"

msgid ""
"Returns a copy of the string with indentation (leading tabs and spaces) "
"removed. See also [method indent] to add indentation."
msgstr ""
"បង្វិលច្បាប់ចម្លងនៃ string ដែលការចូលបន្ទាត់ (indentation - tabs និង spaces នៅដើមបន្ទាត់) "
"ត្រូវបានដកចេញ។ សូមមើលផងដែរ [method indent] ដើម្បីបន្ថែមការចូលបន្ទាត់។"

msgid ""
"Returns [code]true[/code] if the string ends with the given [param text]. See "
"also [method begins_with]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ string បញ្ចប់ដោយ [param text] ដែលបានផ្តល់ឱ្យ។ "
"សូមមើលផងដែរ [method begins_with]។"

msgid ""
"Returns a string with [param chars] characters erased starting from [param "
"position]. If [param chars] goes beyond the string's length given the "
"specified [param position], fewer characters will be erased from the returned "
"string. Returns an empty string if either [param position] or [param chars] "
"is negative. Returns the original string unmodified if [param chars] is "
"[code]0[/code]."
msgstr ""
"បង្វិល string ដែលមានតួអក្សរ [param chars] ត្រូវបានលុបចេញដោយចាប់ផ្តើមពី [param "
"position]។ ប្រសិនបើ [param chars] លើសពីប្រវែងរបស់ string ដោយផ្អែកលើ [param "
"position] ដែលបានបញ្ជាក់ នោះតួអក្សរតិចជាងនេះនឹងត្រូវបានលុបចេញពី string ដែលបានបង្វិល។ បង្វិល "
"string ទទេ ប្រសិនបើ [param position] ឬ [param chars] អវិជ្ជមាន។ បង្វិល string "
"ដើមដោយមិនកែប្រែ ប្រសិនបើ [param chars] គឺ [code]0[/code]។"

msgid ""
"Like [method naturalcasecmp_to] but prioritizes strings that begin with "
"periods ([code].[/code]) and underscores ([code]_[/code]) before any other "
"character. Useful when sorting folders or file names.\n"
"To get a [bool] result from a string comparison, use the [code]==[/code] "
"operator instead. See also [method filenocasecmp_to], [method "
"naturalcasecmp_to], and [method casecmp_to]."
msgstr ""
"ដូច [method naturalcasecmp_to] ដែរ ប៉ុន្តែផ្តល់អាទិភាពដល់ strings ដែលចាប់ផ្តើមដោយសញ្ញាចុច "
"([code].[/code]) និងសញ្ញា underscore ([code]_[/code]) មុនតួអក្សរផ្សេងទៀត។ "
"មានប្រយោជន៍នៅពេលរៀបចំថត ឬឈ្មោះឯកសារ។\n"
"ដើម្បីទទួលបានលទ្ធផល [bool] ពីការប្រៀបធៀប string សូមប្រើប្រតិបត្តិករ [code]==[/code] "
"ជំនួសវិញ។ សូមមើលផងដែរ [method filenocasecmp_to], [method naturalcasecmp_to], និង "
"[method casecmp_to]។"

msgid ""
"Like [method naturalnocasecmp_to] but prioritizes strings that begin with "
"periods ([code].[/code]) and underscores ([code]_[/code]) before any other "
"character. Useful when sorting folders or file names.\n"
"To get a [bool] result from a string comparison, use the [code]==[/code] "
"operator instead. See also [method filecasecmp_to], [method "
"naturalnocasecmp_to], and [method nocasecmp_to]."
msgstr ""
"ដូច [method naturalnocasecmp_to] ដែរ ប៉ុន្តែផ្តល់អាទិភាពដល់ strings "
"ដែលចាប់ផ្តើមដោយសញ្ញាចុច ([code].[/code]) និងសញ្ញា underscore ([code]_[/code]) "
"មុនតួអក្សរផ្សេងទៀត។ មានប្រយោជន៍នៅពេលរៀបចំថត ឬឈ្មោះឯកសារ។\n"
"ដើម្បីទទួលបានលទ្ធផល [bool] ពីការប្រៀបធៀប string សូមប្រើប្រតិបត្តិករ [code]==[/code] "
"ជំនួសវិញ។ សូមមើលផងដែរ [method filecasecmp_to], [method naturalnocasecmp_to], និង "
"[method nocasecmp_to]។"

msgid ""
"Returns the index of the [b]first[/b] occurrence of [param what] in this "
"string, or [code]-1[/code] if there are none. The search's start can be "
"specified with [param from], continuing to the end of the string.\n"
"[codeblocks]\n"
"[gdscript]\n"
"print(\"Team\".find(\"I\")) # Prints -1\n"
"\n"
"print(\"Potato\".find(\"t\"))    # Prints 2\n"
"print(\"Potato\".find(\"t\", 3)) # Prints 4\n"
"print(\"Potato\".find(\"t\", 5)) # Prints -1\n"
"[/gdscript]\n"
"[csharp]\n"
"GD.Print(\"Team\".Find(\"I\")); // Prints -1\n"
"\n"
"GD.Print(\"Potato\".Find(\"t\"));    // Prints 2\n"
"GD.Print(\"Potato\".Find(\"t\", 3)); // Prints 4\n"
"GD.Print(\"Potato\".Find(\"t\", 5)); // Prints -1\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]Note:[/b] If you just want to know whether the string contains [param "
"what], use [method contains]. In GDScript, you may also use the [code]in[/"
"code] operator.\n"
"[b]Note:[/b] A negative value of [param from] is converted to a starting "
"index by counting back from the last possible index with enough space to find "
"[param what]."
msgstr ""
"បង្វិល index នៃការកើតឡើង [b]ដំបូង[/b] នៃ [param what] នៅក្នុង string នេះ ឬ "
"[code]-1[/code] ប្រសិនបើគ្មាន។ ការចាប់ផ្តើមស្វែងរកអាចត្រូវបានបញ្ជាក់ដោយ [param from] "
"ហើយបន្តរហូតដល់ចុងបញ្ចប់នៃ string។\n"
"[codeblocks]\n"
"[gdscript]\n"
"print(\"Team\".find(\"I\")) # បង្ហាញ -1\n"
"\n"
"print(\"Potato\".find(\"t\"))    # បង្ហាញ 2\n"
"print(\"Potato\".find(\"t\", 3)) # បង្ហាញ 4\n"
"print(\"Potato\".find(\"t\", 5)) # បង្ហាញ -1\n"
"[/gdscript]\n"
"[csharp]\n"
"GD.Print(\"Team\".Find(\"I\")); // បង្ហាញ -1\n"
"\n"
"GD.Print(\"Potato\".Find(\"t\"));    // បង្ហាញ 2\n"
"GD.Print(\"Potato\".Find(\"t\", 3)); // បង្ហាញ 4\n"
"GD.Print(\"Potato\".Find(\"t\", 5)); // បង្ហាញ -1\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើអ្នកគ្រាន់តែចង់ដឹងថាតើ string មានផ្ទុក [param what] ឬអត់ សូមប្រើ "
"[method contains]។ នៅក្នុង GDScript អ្នកក៏អាចប្រើប្រតិបត្តិករ [code]in[/code] ផងដែរ។\n"
"[b]ចំណាំ៖[/b] តម្លៃអវិជ្ជមាននៃ [param from] ត្រូវបានបម្លែងទៅជា index ចាប់ផ្តើម "
"ដោយរាប់ថយក្រោយពី index ចុងក្រោយដែលអាចទៅរួចដែលមានចន្លោះគ្រប់គ្រាន់ដើម្បីរក [param what]។"

msgid ""
"Returns the index of the [b]first[/b] [b]case-insensitive[/b] occurrence of "
"[param what] in this string, or [code]-1[/code] if there are none. The "
"starting search index can be specified with [param from], continuing to the "
"end of the string."
msgstr ""
"បង្វិល index នៃការកើតឡើង [b]ដំបូង[/b] ដោយ [b]មិនបែងចែកតួអក្សរធំតូច[/b] នៃ [param what] "
"នៅក្នុង string នេះ ឬ [code]-1[/code] ប្រសិនបើគ្មាន។ Index "
"ចាប់ផ្តើមស្វែងរកអាចត្រូវបានបញ្ជាក់ដោយ [param from] ហើយបន្តរហូតដល់ចុងបញ្ចប់នៃ string។"

msgid ""
"Formats the string by replacing all occurrences of [param placeholder] with "
"the elements of [param values].\n"
"[param values] can be a [Dictionary], an [Array], or an [Object]. Any "
"underscores in [param placeholder] will be replaced with the corresponding "
"keys in advance. Array elements use their index as keys.\n"
"[codeblock]\n"
"# Prints \"Waiting for Godot is a play by Samuel Beckett, and Godot Engine is "
"named after it.\"\n"
"var use_array_values = \"Waiting for {0} is a play by {1}, and {0} Engine is "
"named after it.\"\n"
"print(use_array_values.format([\"Godot\", \"Samuel Beckett\"]))\n"
"\n"
"# Prints \"User 42 is Godot.\"\n"
"print(\"User {id} is {name}.\".format({\"id\": 42, \"name\": \"Godot\"}))\n"
"[/codeblock]\n"
"Some additional handling is performed when [param values] is an [Array]. If "
"[param placeholder] does not contain an underscore, the elements of the "
"[param values] array will be used to replace one occurrence of the "
"placeholder in order; If an element of [param values] is another 2-element "
"array, it'll be interpreted as a key-value pair.\n"
"[codeblock]\n"
"# Prints \"User 42 is Godot.\"\n"
"print(\"User {} is {}.\".format([42, \"Godot\"], \"{}\"))\n"
"print(\"User {id} is {name}.\".format([[\"id\", 42], [\"name\", "
"\"Godot\"]]))\n"
"[/codeblock]\n"
"When passing an [Object], the property names from [method "
"Object.get_property_list] are used as keys.\n"
"[codeblock]\n"
"# Prints \"Visible true, position (0, 0)\"\n"
"var node = Node2D.new()\n"
"print(\"Visible {visible}, position {position}\".format(node))\n"
"[/codeblock]\n"
"See also the [url=$DOCS_URL/tutorials/scripting/gdscript/"
"gdscript_format_string.html]GDScript format string[/url] tutorial.\n"
"[b]Note:[/b] Each replacement is done sequentially for each element of [param "
"values], [b]not[/b] all at once. This means that if any element is inserted "
"and it contains another placeholder, it may be changed by the next "
"replacement. While this can be very useful, it often causes unexpected "
"results. If not necessary, make sure [param values]'s elements do not contain "
"placeholders.\n"
"[codeblock]\n"
"print(\"{0} {1}\".format([\"{1}\", \"x\"]))           # Prints \"x x\"\n"
"print(\"{0} {1}\".format([\"x\", \"{0}\"]))           # Prints \"x {0}\"\n"
"print(\"{a} {b}\".format({\"a\": \"{b}\", \"b\": \"c\"})) # Prints \"c c\"\n"
"print(\"{a} {b}\".format({\"b\": \"c\", \"a\": \"{b}\"})) # Prints \"{b} c\"\n"
"[/codeblock]\n"
"[b]Note:[/b] In C#, it's recommended to [url=https://learn.microsoft.com/en-"
"us/dotnet/csharp/language-reference/tokens/interpolated]interpolate strings "
"with \"$\"[/url], instead."
msgstr ""
"ធ្វើទម្រង់ string ដោយជំនួសការកើតឡើងទាំងអស់នៃ [param placeholder] ជាមួយធាតុនៃ [param "
"values]។\n"
"[param values] អាចជា [Dictionary], [Array], ឬ [Object]។ សញ្ញា underscore "
"ណាមួយនៅក្នុង [param placeholder] នឹងត្រូវបានជំនួសដោយ key ដែលត្រូវគ្នាជាមុន។ ធាតុ Array ប្រើ "
"index របស់ពួកវាជា key។\n"
"[codeblock]\n"
"# បង្ហាញ \"Waiting for Godot is a play by Samuel Beckett, and Godot Engine is "
"named after it.\"\n"
"var use_array_values = \"Waiting for {0} is a play by {1}, and {0} Engine is "
"named after it.\"\n"
"print(use_array_values.format([\"Godot\", \"Samuel Beckett\"]))\n"
"\n"
"# បង្ហាញ \"User 42 is Godot.\"\n"
"print(\"User {id} is {name}.\".format({\"id\": 42, \"name\": \"Godot\"}))\n"
"[/codeblock]\n"
"ការដោះស្រាយបន្ថែមមួយចំនួនត្រូវបានអនុវត្តនៅពេលដែល [param values] គឺជា [Array]។ ប្រសិនបើ "
"[param placeholder] មិនមានសញ្ញា underscore ទេ ធាតុនៃអារេ [param values] "
"នឹងត្រូវបានប្រើដើម្បីជំនួសការកើតឡើងមួយនៃ placeholder តាមលំដាប់លំដោយ។ ប្រសិនបើធាតុនៃ [param "
"values] គឺជាអារេ 2-element មួយទៀត វានឹងត្រូវបានបកស្រាយថាជា key-value pair។\n"
"[codeblock]\n"
"# បង្ហាញ \"User 42 is Godot.\"\n"
"print(\"User {} is {}.\".format([42, \"Godot\"], \"{}\"))\n"
"print(\"User {id} is {name}.\".format([[\"id\", 42], [\"name\", "
"\"Godot\"]]))\n"
"[/codeblock]\n"
"នៅពេលបញ្ជូន [Object] ឈ្មោះ property ពី [method Object.get_property_list] "
"ត្រូវបានប្រើជា key។\n"
"[codeblock]\n"
"# បង្ហាញ \"Visible true, position (0, 0)\"\n"
"var node = Node2D.new()\n"
"print(\"Visible {visible}, position {position}\".format(node))\n"
"[/codeblock]\n"
"សូមមើលផងដែរការបង្រៀន [url=$DOCS_URL/tutorials/scripting/gdscript/"
"gdscript_format_string.html]ទម្រង់ string របស់ GDScript[/url]។\n"
"[b]ចំណាំ៖[/b] ការជំនួសនីមួយៗត្រូវបានធ្វើឡើងជាលំដាប់សម្រាប់ធាតុនីមួយៗនៃ [param values] ដោយ "
"[b]មិនមែន[/b] ធ្វើព្រមគ្នាទាំងអស់ទេ។ នេះមានន័យថា ប្រសិនបើធាតុណាមួយត្រូវបានបញ្ចូល ហើយវាមានផ្ទុក "
"placeholder មួយទៀត វាអាចនឹងត្រូវបានផ្លាស់ប្តូរដោយការជំនួសបន្ទាប់។ "
"ទោះបីជាវាអាចមានប្រយោជន៍ខ្លាំងក៏ដោយ វាច្រើនតែបណ្តាលឱ្យមានលទ្ធផលដែលមិននឹកស្មានដល់។ "
"ប្រសិនបើមិនចាំបាច់ទេ សូមប្រាកដថាធាតុរបស់ [param values] មិនមានផ្ទុក placeholder ទេ។\n"
"[codeblock]\n"
"print(\"{0} {1}\".format([\"{1}\", \"x\"]))           # បង្ហាញ \"x x\"\n"
"print(\"{0} {1}\".format([\"x\", \"{0}\"]))           # បង្ហាញ \"x {0}\"\n"
"print(\"{a} {b}\".format({\"a\": \"{b}\", \"b\": \"c\"})) # បង្ហាញ \"c c\"\n"
"print(\"{a} {b}\".format({\"b\": \"c\", \"a\": \"{b}\"})) # បង្ហាញ \"{b} c\"\n"
"[/codeblock]\n"
"[b]ចំណាំ៖[/b] នៅក្នុង C#, គេណែនាំឱ្យ [url=https://learn.microsoft.com/en-us/dotnet/"
"csharp/language-reference/tokens/interpolated]interpolate strings ដោយប្រើ \"$"
"\"[/url] ជំនួសវិញ។"

msgid ""
"If the string is a valid file path, returns the base directory name.\n"
"[codeblock]\n"
"var dir_path = \"/path/to/file.txt\".get_base_dir() # dir_path is \"/path/"
"to\"\n"
"[/codeblock]"
msgstr ""
"ប្រសិនបើ string គឺជា file path ត្រឹមត្រូវ បង្វិលឈ្មោះថតមូលដ្ឋាន (base directory name)។\n"
"[codeblock]\n"
"var dir_path = \"/path/to/file.txt\".get_base_dir() # dir_path គឺ \"/path/"
"to\"\n"
"[/codeblock]"

msgid ""
"If the string is a valid file path, returns the full file path, without the "
"extension.\n"
"[codeblock]\n"
"var base = \"/path/to/file.txt\".get_basename() # base is \"/path/to/file\"\n"
"[/codeblock]"
msgstr ""
"ប្រសិនបើ string គឺជា file path ត្រឹមត្រូវ បង្វិល file path ពេញលេញ ដោយមិនមាន extension។\n"
"[codeblock]\n"
"var base = \"/path/to/file.txt\".get_basename() # base គឺ \"/path/to/file\"\n"
"[/codeblock]"

msgid ""
"If the string is a valid file name or path, returns the file extension "
"without the leading period ([code].[/code]). Otherwise, returns an empty "
"string.\n"
"[codeblock]\n"
"var a = \"/path/to/file.txt\".get_extension() # a is \"txt\"\n"
"var b = \"cool.txt\".get_extension()          # b is \"txt\"\n"
"var c = \"cool.font.tres\".get_extension()    # c is \"tres\"\n"
"var d = \".pack1\".get_extension()            # d is \"pack1\"\n"
"\n"
"var e = \"file.txt.\".get_extension()  # e is \"\"\n"
"var f = \"file.txt..\".get_extension() # f is \"\"\n"
"var g = \"txt\".get_extension()        # g is \"\"\n"
"var h = \"\".get_extension()           # h is \"\"\n"
"[/codeblock]"
msgstr ""
"ប្រសិនបើ string គឺជាឈ្មោះឯកសារ ឬ path ត្រឹមត្រូវ បង្វិល file extension ដោយមិនមានសញ្ញាចុច "
"([code].[/code]) នៅដើម។ បើពុំនោះទេ បង្វិល string ទទេ។\n"
"[codeblock]\n"
"var a = \"/path/to/file.txt\".get_extension() # a គឺ \"txt\"\n"
"var b = \"cool.txt\".get_extension()          # b គឺ \"txt\"\n"
"var c = \"cool.font.tres\".get_extension()    # c គឺ \"tres\"\n"
"var d = \".pack1\".get_extension()            # d គឺ \"pack1\"\n"
"\n"
"var e = \"file.txt.\".get_extension()  # e គឺ \"\"\n"
"var f = \"file.txt..\".get_extension() # f គឺ \"\"\n"
"var g = \"txt\".get_extension()        # g គឺ \"\"\n"
"var h = \"\".get_extension()           # h គឺ \"\"\n"
"[/codeblock]"

msgid ""
"If the string is a valid file path, returns the file name, including the "
"extension.\n"
"[codeblock]\n"
"var file = \"/path/to/icon.png\".get_file() # file is \"icon.png\"\n"
"[/codeblock]"
msgstr ""
"ប្រសិនបើ string គឺជា file path ត្រឹមត្រូវ បង្វិលឈ្មោះឯកសារ រួមទាំង extension។\n"
"[codeblock]\n"
"var file = \"/path/to/icon.png\".get_file() # file គឺ \"icon.png\"\n"
"[/codeblock]"

msgid ""
"Splits the string using a [param delimiter] and returns the substring at "
"index [param slice]. Returns the original string if [param delimiter] does "
"not occur in the string. Returns an empty string if the [param slice] does "
"not exist.\n"
"This is faster than [method split], if you only need one or two substrings.\n"
"[codeblock]\n"
"print(\"i/am/example/hi\".get_slice(\"/\", 2)) # Prints \"example\"\n"
"[/codeblock]"
msgstr ""
"បំបែក string ដោយប្រើ [param delimiter] ហើយបង្វិល substring នៅ index [param "
"slice]។ បង្វិល string ដើម ប្រសិនបើ [param delimiter] មិនមាននៅក្នុង string។ បង្វិល "
"string ទទេ ប្រសិនបើ [param slice] មិនមាន។\n"
"វិធីនេះលឿនជាង [method split] ប្រសិនបើអ្នកត្រូវការតែមួយ ឬពីរ substrings ប៉ុណ្ណោះ។\n"
"[codeblock]\n"
"print(\"i/am/example/hi\".get_slice(\"/\", 2)) # បង្ហាញ \"example\"\n"
"[/codeblock]"

msgid ""
"Returns the total number of slices when the string is split with the given "
"[param delimiter] (see [method split]).\n"
"Use [method get_slice] to extract a specific slice.\n"
"[codeblock]\n"
"print(\"i/am/example/string\".get_slice_count(\"/\")) # Prints '4'.\n"
"print(\"i am example string\".get_slice_count(\"/\")) # Prints '1'.\n"
"[/codeblock]"
msgstr ""
"បង្វិលចំនួន slices សរុបនៅពេលដែល string ត្រូវបានបំបែកដោយ [param delimiter] ដែលបានផ្តល់ឱ្យ "
"(សូមមើល [method split])។\n"
"ប្រើ [method get_slice] ដើម្បីស្រង់យក slice ជាក់លាក់មួយ។\n"
"[codeblock]\n"
"print(\"i/am/example/string\".get_slice_count(\"/\")) # បង្ហាញ '4'។\n"
"print(\"i am example string\".get_slice_count(\"/\")) # បង្ហាញ '1'។\n"
"[/codeblock]"

msgid ""
"Splits the string using a Unicode character with code [param delimiter] and "
"returns the substring at index [param slice]. Returns an empty string if the "
"[param slice] does not exist.\n"
"This is faster than [method split], if you only need one or two substrings.\n"
"This is a Unicode version of [method get_slice]."
msgstr ""
"បំបែក string ដោយប្រើតួអក្សរ Unicode ដែលមានកូដ [param delimiter] ហើយបង្វិល substring "
"នៅ index [param slice]។ បង្វិល string ទទេ ប្រសិនបើ [param slice] មិនមាន។\n"
"វិធីនេះលឿនជាង [method split] ប្រសិនបើអ្នកត្រូវការតែមួយ ឬពីរ substrings ប៉ុណ្ណោះ។\n"
"នេះគឺជាកំណែ Unicode នៃ [method get_slice]។"

msgid ""
"Returns the 32-bit hash value representing the string's contents.\n"
"[b]Note:[/b] Strings with equal hash values are [i]not[/i] guaranteed to be "
"the same, as a result of hash collisions. On the contrary, strings with "
"different hash values are guaranteed to be different."
msgstr ""
"បង្វិលតម្លៃ hash 32-bit ដែលតំណាងឱ្យខ្លឹមសាររបស់ string។\n"
"[b]ចំណាំ៖[/b] Strings ដែលមានតម្លៃ hash ស្មើគ្នា [i]មិន[/i] ត្រូវបានធានាថាដូចគ្នាទេ "
"ដោយសារតែ hash collisions។ ផ្ទុយទៅវិញ strings ដែលមានតម្លៃ hash ខុសគ្នា "
"ត្រូវបានធានាថាខុសគ្នា។"

msgid ""
"Decodes a hexadecimal string as a [PackedByteArray].\n"
"[codeblocks]\n"
"[gdscript]\n"
"var text = \"hello world\"\n"
"var encoded = text.to_utf8_buffer().hex_encode() # outputs "
"\"68656c6c6f20776f726c64\"\n"
"print(encoded.hex_decode().get_string_from_utf8())\n"
"[/gdscript]\n"
"[csharp]\n"
"var text = \"hello world\";\n"
"var encoded = text.ToUtf8Buffer().HexEncode(); // outputs "
"\"68656c6c6f20776f726c64\"\n"
"GD.Print(encoded.HexDecode().GetStringFromUtf8());\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"បកប្រែ (Decode) hexadecimal string ទៅជា [PackedByteArray]។\n"
"[codeblocks]\n"
"[gdscript]\n"
"var text = \"hello world\"\n"
"var encoded = text.to_utf8_buffer().hex_encode() # លទ្ធផល "
"\"68656c6c6f20776f726c64\"\n"
"print(encoded.hex_decode().get_string_from_utf8())\n"
"[/gdscript]\n"
"[csharp]\n"
"var text = \"hello world\";\n"
"var encoded = text.ToUtf8Buffer().HexEncode(); // លទ្ធផល "
"\"68656c6c6f20776f726c64\"\n"
"GD.Print(encoded.HexDecode().GetStringFromUtf8());\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Converts the string representing a hexadecimal number into an [int]. The "
"string may be optionally prefixed with [code]\"0x\"[/code], and an additional "
"[code]-[/code] prefix for negative numbers.\n"
"[codeblocks]\n"
"[gdscript]\n"
"print(\"0xff\".hex_to_int()) # Prints 255\n"
"print(\"ab\".hex_to_int())   # Prints 171\n"
"[/gdscript]\n"
"[csharp]\n"
"GD.Print(\"0xff\".HexToInt()); // Prints 255\n"
"GD.Print(\"ab\".HexToInt());   // Prints 171\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"បម្លែង string ដែលតំណាងឱ្យលេខ hexadecimal ទៅជា [int]។ String អាចមានបុព្វបទ [code]"
"\"0x\"[/code] ជាជម្រើស និងបុព្វបទ [code]-[/code] បន្ថែមសម្រាប់លេខអវិជ្ជមាន។\n"
"[codeblocks]\n"
"[gdscript]\n"
"print(\"0xff\".hex_to_int()) # បង្ហាញ 255\n"
"print(\"ab\".hex_to_int())   # បង្ហាញ 171\n"
"[/gdscript]\n"
"[csharp]\n"
"GD.Print(\"0xff\".HexToInt()); // បង្ហាញ 255\n"
"GD.Print(\"ab\".HexToInt());   // បង្ហាញ 171\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Converts [param size] which represents a number of bytes into a human-"
"readable form.\n"
"The result is in [url=https://en.wikipedia.org/wiki/"
"Binary_prefix#IEC_prefixes]IEC prefix format[/url], which may end in either "
"[code]\"B\"[/code], [code]\"KiB\"[/code], [code]\"MiB\"[/code], [code]"
"\"GiB\"[/code], [code]\"TiB\"[/code], [code]\"PiB\"[/code], or [code]\"EiB\"[/"
"code]."
msgstr ""
"បម្លែង [param size] ដែលតំណាងឱ្យចំនួន bytes ទៅជាទម្រង់ដែលមនុស្សអាងាយអាន។\n"
"លទ្ធផលគឺស្ថិតក្នុង [url=https://en.wikipedia.org/wiki/"
"Binary_prefix#IEC_prefixes]ទម្រង់បុព្វបទ IEC[/url] ដែលអាចបញ្ចប់ដោយ [code]\"B\"[/"
"code], [code]\"KiB\"[/code], [code]\"MiB\"[/code], [code]\"GiB\"[/code], "
"[code]\"TiB\"[/code], [code]\"PiB\"[/code], ឬ [code]\"EiB\"[/code]។"

msgid ""
"Indents every line of the string with the given [param prefix]. Empty lines "
"are not indented. See also [method dedent] to remove indentation.\n"
"For example, the string can be indented with two tabulations using [code]"
"\"\\t\\t\"[/code], or four spaces using [code]\"    \"[/code]."
msgstr ""
"ចូលបន្ទាត់ (Indent) រាល់បន្ទាត់នៃ string ដោយប្រើ [param prefix] ដែលបានផ្តល់ឱ្យ។ "
"បន្ទាត់ទទេមិនត្រូវបានចូលបន្ទាត់ទេ។ សូមមើលផងដែរ [method dedent] ដើម្បីដកការចូលបន្ទាត់ចេញ។\n"
"ឧទាហរណ៍ string អាចត្រូវបានចូលបន្ទាត់ដោយប្រើ tabulation ពីរដងដោយប្រើ [code]\"\\t\\t\"[/"
"code] ឬបួនចន្លោះដោយប្រើ [code]\"    \"[/code]។"

msgid "Inserts [param what] at the given [param position] in the string."
msgstr "បញ្ចូល [param what] នៅ [param position] ដែលបានផ្តល់ឱ្យនៅក្នុង string។"

msgid ""
"Returns [code]true[/code] if the string is a path to a file or directory, and "
"its starting point is explicitly defined. This method is the opposite of "
"[method is_relative_path].\n"
"This includes all paths starting with [code]\"res://\"[/code], [code]\"user://"
"\"[/code], [code]\"C:\\\"[/code], [code]\"/\"[/code], etc."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ string គឺជា path ទៅកាន់ឯកសារ ឬថត "
"ហើយចំណុចចាប់ផ្តើមរបស់វាត្រូវបានកំណត់យ៉ាងច្បាស់លាស់។ វិធីសាស្រ្តនេះគឺផ្ទុយពី [method "
"is_relative_path]។\n"
"នេះរួមបញ្ចូលទាំង paths ទាំងអស់ដែលចាប់ផ្តើមដោយ [code]\"res://\"[/code], [code]\"user://"
"\"[/code], [code]\"C:\\\"[/code], [code]\"/\"[/code], ។ល។"

msgid ""
"Returns [code]true[/code] if the string's length is [code]0[/code] ([code]"
"\"\"[/code]). See also [method length]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើប្រវែងរបស់ string គឺ [code]0[/code] ([code]\"\"[/"
"code])។ សូមមើលផងដែរ [method length]។"

msgid ""
"Returns [code]true[/code] if the string is a path, and its starting point is "
"dependent on context. The path could begin from the current directory, or the "
"current [Node] (if the string is derived from a [NodePath]), and may "
"sometimes be prefixed with [code]\"./\"[/code]. This method is the opposite "
"of [method is_absolute_path]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ string គឺជា path ហើយចំណុចចាប់ផ្តើមរបស់វាអាស្រ័យលើបរិបទ។ "
"Path អាចចាប់ផ្តើមពីថតបច្ចុប្បន្ន ឬ [Node] បច្ចុប្បន្ន (ប្រសិនបើ string ត្រូវបានទាញចេញពី "
"[NodePath]) ហើយជួនកាលអាចមានបុព្វបទ [code]\"./\"[/code]។ វិធីសាស្រ្តនេះគឺផ្ទុយពី [method "
"is_absolute_path]។"

msgid ""
"Returns [code]true[/code] if all characters of this string can be found in "
"[param text] in their original order. This is not the same as [method "
"contains].\n"
"[codeblock]\n"
"var text = \"Wow, incredible!\"\n"
"\n"
"print(\"inedible\".is_subsequence_of(text)) # Prints true\n"
"print(\"Word!\".is_subsequence_of(text))    # Prints true\n"
"print(\"Window\".is_subsequence_of(text))   # Prints false\n"
"print(\"\".is_subsequence_of(text))         # Prints true\n"
"[/codeblock]"
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើតួអក្សរទាំងអស់នៃ string នេះអាចត្រូវបានរកឃើញនៅក្នុង "
"[param text] តាមលំដាប់ដើមរបស់ពួកវា។ នេះមិនដូចគ្នានឹង [method contains] ទេ។\n"
"[codeblock]\n"
"var text = \"Wow, incredible!\"\n"
"\n"
"print(\"inedible\".is_subsequence_of(text)) # បង្ហាញ true\n"
"print(\"Word!\".is_subsequence_of(text))    # បង្ហាញ true\n"
"print(\"Window\".is_subsequence_of(text))   # បង្ហាញ false\n"
"print(\"\".is_subsequence_of(text))         # បង្ហាញ true\n"
"[/codeblock]"

msgid ""
"Returns [code]true[/code] if all characters of this string can be found in "
"[param text] in their original order, [b]ignoring case[/b]. This is not the "
"same as [method containsn]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើតួអក្សរទាំងអស់នៃ string នេះអាចត្រូវបានរកឃើញនៅក្នុង "
"[param text] តាមលំដាប់ដើមរបស់ពួកវា ដោយ [b]មិនបែងចែកតួអក្សរធំតូច[/b]។ នេះមិនដូចគ្នានឹង "
"[method containsn] ទេ។"

msgid ""
"Returns [code]true[/code] if this string is a valid ASCII identifier. A valid "
"ASCII identifier may contain only letters, digits, and underscores ([code]_[/"
"code]), and the first character may not be a digit.\n"
"[codeblock]\n"
"print(\"node_2d\".is_valid_ascii_identifier())    # Prints true\n"
"print(\"TYPE_FLOAT\".is_valid_ascii_identifier()) # Prints true\n"
"print(\"1st_method\".is_valid_ascii_identifier()) # Prints false\n"
"print(\"MyMethod#2\".is_valid_ascii_identifier()) # Prints false\n"
"[/codeblock]\n"
"See also [method is_valid_unicode_identifier]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ string នេះគឺជា ASCII identifier ត្រឹមត្រូវ។ ASCII "
"identifier ត្រឹមត្រូវអាចមានតែអក្សរ លេខ និងសញ្ញា underscore ([code]_[/code]) ប៉ុណ្ណោះ "
"ហើយតួអក្សរដំបូងមិនអាចជាលេខទេ។\n"
"[codeblock]\n"
"print(\"node_2d\".is_valid_ascii_identifier())    # បង្ហាញ true\n"
"print(\"TYPE_FLOAT\".is_valid_ascii_identifier()) # បង្ហាញ true\n"
"print(\"1st_method\".is_valid_ascii_identifier()) # បង្ហាញ false\n"
"print(\"MyMethod#2\".is_valid_ascii_identifier()) # បង្ហាញ false\n"
"[/codeblock]\n"
"សូមមើលផងដែរ [method is_valid_unicode_identifier]។"

msgid ""
"Returns [code]true[/code] if this string is a valid file name. A valid file "
"name cannot be empty, begin or end with space characters, or contain "
"characters that are not allowed ([code]:[/code] [code]/[/code] [code]\\[/"
"code] [code]?[/code] [code]*[/code] [code]\"[/code] [code]|[/code] [code]%[/"
"code] [code]<[/code] [code]>[/code])."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ string នេះគឺជាឈ្មោះឯកសារត្រឹមត្រូវ។ "
"ឈ្មោះឯកសារត្រឹមត្រូវមិនអាចទទេ ចាប់ផ្តើម ឬបញ្ចប់ដោយតួអក្សរចន្លោះ "
"ឬមានផ្ទុកតួអក្សរដែលមិនត្រូវបានអនុញ្ញាត ([code]:[/code] [code]/[/code] [code]\\[/code] "
"[code]?[/code] [code]*[/code] [code]\"[/code] [code]|[/code] [code]%[/code] "
"[code]<[/code] [code]>[/code])។"

msgid ""
"Returns [code]true[/code] if this string represents a valid floating-point "
"number. A valid float may contain only digits, one decimal point ([code].[/"
"code]), and the exponent letter ([code]e[/code]). It may also be prefixed "
"with a positive ([code]+[/code]) or negative ([code]-[/code]) sign. Any valid "
"integer is also a valid float (see [method is_valid_int]). See also [method "
"to_float].\n"
"[codeblock]\n"
"print(\"1.7\".is_valid_float())   # Prints true\n"
"print(\"24\".is_valid_float())    # Prints true\n"
"print(\"7e3\".is_valid_float())   # Prints true\n"
"print(\"Hello\".is_valid_float()) # Prints false\n"
"[/codeblock]"
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ string នេះតំណាងឱ្យលេខ floating-point ត្រឹមត្រូវ។ "
"Float ត្រឹមត្រូវអាចមានតែលេខ សញ្ញាចុចទសភាគមួយ ([code].[/code]) និងអក្សរស្វ័យគុណ ([code]e[/"
"code])។ វាក៏អាចមានបុព្វបទសញ្ញាវិជ្ជមាន ([code]+[/code]) ឬអវិជ្ជមាន ([code]-[/code]) "
"ផងដែរ។ ចំនួនគត់ត្រឹមត្រូវណាមួយក៏ជា float ត្រឹមត្រូវដែរ (សូមមើល [method is_valid_int])។ "
"សូមមើលផងដែរ [method to_float]។\n"
"[codeblock]\n"
"print(\"1.7\".is_valid_float())   # បង្ហាញ true\n"
"print(\"24\".is_valid_float())    # បង្ហាញ true\n"
"print(\"7e3\".is_valid_float())   # បង្ហាញ true\n"
"print(\"Hello\".is_valid_float()) # បង្ហាញ false\n"
"[/codeblock]"

msgid ""
"Returns [code]true[/code] if this string is a valid hexadecimal number. A "
"valid hexadecimal number only contains digits or letters [code]A[/code] to "
"[code]F[/code] (either uppercase or lowercase), and may be prefixed with a "
"positive ([code]+[/code]) or negative ([code]-[/code]) sign.\n"
"If [param with_prefix] is [code]true[/code], the hexadecimal number needs to "
"prefixed by [code]\"0x\"[/code] to be considered valid.\n"
"[codeblock]\n"
"print(\"A08E\".is_valid_hex_number())    # Prints true\n"
"print(\"-AbCdEf\".is_valid_hex_number()) # Prints true\n"
"print(\"2.5\".is_valid_hex_number())     # Prints false\n"
"\n"
"print(\"0xDEADC0DE\".is_valid_hex_number(true)) # Prints true\n"
"[/codeblock]"
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ string នេះគឺជាលេខ hexadecimal ត្រឹមត្រូវ។ លេខ "
"hexadecimal ត្រឹមត្រូវមានតែលេខ ឬអក្សរ [code]A[/code] ដល់ [code]F[/code] (មិនថាតួអក្សរធំ "
"ឬតូច) ហើយអាចមានបុព្វបទសញ្ញាវិជ្ជមាន ([code]+[/code]) ឬអវិជ្ជមាន ([code]-[/code])។\n"
"ប្រសិនបើ [param with_prefix] គឺ [code]true[/code] លេខ hexadecimal ត្រូវតែមានបុព្វបទ "
"[code]\"0x\"[/code] ទើបចាត់ទុកថាត្រឹមត្រូវ។\n"
"[codeblock]\n"
"print(\"A08E\".is_valid_hex_number())    # បង្ហាញ true\n"
"print(\"-AbCdEf\".is_valid_hex_number()) # បង្ហាញ true\n"
"print(\"2.5\".is_valid_hex_number())     # បង្ហាញ false\n"
"\n"
"print(\"0xDEADC0DE\".is_valid_hex_number(true)) # បង្ហាញ true\n"
"[/codeblock]"

msgid ""
"Returns [code]true[/code] if this string is a valid color in hexadecimal HTML "
"notation. The string must be a hexadecimal value (see [method "
"is_valid_hex_number]) of either 3, 4, 6 or 8 digits, and may be prefixed by a "
"hash sign ([code]#[/code]). Other HTML notations for colors, such as names or "
"[code]hsl()[/code], are not considered valid. See also [method Color.html]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ string នេះគឺជាពណ៌ត្រឹមត្រូវក្នុងទម្រង់ HTML hexadecimal។ "
"String ត្រូវតែជាតម្លៃ hexadecimal (សូមមើល [method is_valid_hex_number]) ដែលមាន 3, "
"4, 6 ឬ 8 ខ្ទង់ ហើយអាចមានបុព្វបទសញ្ញា hash ([code]#[/code])។ ទម្រង់ HTML "
"ផ្សេងទៀតសម្រាប់ពណ៌ ដូចជាឈ្មោះ ឬ [code]hsl()[/code] មិនត្រូវបានចាត់ទុកថាត្រឹមត្រូវទេ។ "
"សូមមើលផងដែរ [method Color.html]។"

msgid "Use [method is_valid_ascii_identifier] instead."
msgstr "សូមប្រើ [method is_valid_ascii_identifier] ជំនួសវិញ។"

msgid ""
"Returns [code]true[/code] if this string is a valid identifier. A valid "
"identifier may contain only letters, digits and underscores ([code]_[/code]), "
"and the first character may not be a digit.\n"
"[codeblock]\n"
"print(\"node_2d\".is_valid_identifier())    # Prints true\n"
"print(\"TYPE_FLOAT\".is_valid_identifier()) # Prints true\n"
"print(\"1st_method\".is_valid_identifier()) # Prints false\n"
"print(\"MyMethod#2\".is_valid_identifier()) # Prints false\n"
"[/codeblock]"
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ string នេះគឺជា identifier ត្រឹមត្រូវ។ Identifier "
"ត្រឹមត្រូវអាចមានតែអក្សរ លេខ និងសញ្ញា underscore ([code]_[/code]) ប៉ុណ្ណោះ "
"ហើយតួអក្សរដំបូងមិនអាចជាលេខទេ។\n"
"[codeblock]\n"
"print(\"node_2d\".is_valid_identifier())    # បង្ហាញ true\n"
"print(\"TYPE_FLOAT\".is_valid_identifier()) # បង្ហាញ true\n"
"print(\"1st_method\".is_valid_identifier()) # បង្ហាញ false\n"
"print(\"MyMethod#2\".is_valid_identifier()) # បង្ហាញ false\n"
"[/codeblock]"

msgid ""
"Returns [code]true[/code] if this string represents a valid integer. A valid "
"integer only contains digits, and may be prefixed with a positive ([code]+[/"
"code]) or negative ([code]-[/code]) sign. See also [method to_int].\n"
"[codeblock]\n"
"print(\"7\".is_valid_int())    # Prints true\n"
"print(\"1.65\".is_valid_int()) # Prints false\n"
"print(\"Hi\".is_valid_int())   # Prints false\n"
"print(\"+3\".is_valid_int())   # Prints true\n"
"print(\"-12\".is_valid_int())  # Prints true\n"
"[/codeblock]"
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ string នេះតំណាងឱ្យចំនួនគត់ (integer) ត្រឹមត្រូវ។ "
"ចំនួនគត់ត្រឹមត្រូវមានតែលេខប៉ុណ្ណោះ ហើយអាចមានបុព្វបទសញ្ញាវិជ្ជមាន ([code]+[/code]) ឬអវិជ្ជមាន "
"([code]-[/code])។ សូមមើលផងដែរ [method to_int]។\n"
"[codeblock]\n"
"print(\"7\".is_valid_int())    # បង្ហាញ true\n"
"print(\"1.65\".is_valid_int()) # បង្ហាញ false\n"
"print(\"Hi\".is_valid_int())   # បង្ហាញ false\n"
"print(\"+3\".is_valid_int())   # បង្ហាញ true\n"
"print(\"-12\".is_valid_int())  # បង្ហាញ true\n"
"[/codeblock]"

msgid ""
"Returns [code]true[/code] if this string represents a well-formatted IPv4 or "
"IPv6 address. This method considers [url=https://en.wikipedia.org/wiki/"
"Reserved_IP_addresses]reserved IP addresses[/url] such as [code]\"0.0.0.0\"[/"
"code] and [code]\"ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff\"[/code] as valid."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ string នេះតំណាងឱ្យអាសយដ្ឋាន IPv4 ឬ IPv6 "
"ដែលមានទម្រង់ត្រឹមត្រូវ។ វិធីសាស្រ្តនេះចាត់ទុក [url=https://en.wikipedia.org/wiki/"
"Reserved_IP_addresses]អាសយដ្ឋាន IP បម្រុងទុក[/url] ដូចជា [code]\"0.0.0.0\"[/code] "
"និង [code]\"ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff\"[/code] ថាត្រឹមត្រូវ។"

msgid ""
"Returns [code]true[/code] if this string is a valid Unicode identifier.\n"
"A valid Unicode identifier must begin with a Unicode character of class "
"[code]XID_Start[/code] or [code]\"_\"[/code], and may contain Unicode "
"characters of class [code]XID_Continue[/code] in the other positions.\n"
"[codeblock]\n"
"print(\"node_2d\".is_valid_unicode_identifier())      # Prints true\n"
"print(\"1st_method\".is_valid_unicode_identifier())   # Prints false\n"
"print(\"MyMethod#2\".is_valid_unicode_identifier())   # Prints false\n"
"print(\"állóképesség\".is_valid_unicode_identifier()) # Prints true\n"
"print(\"выносливость\".is_valid_unicode_identifier()) # Prints true\n"
"print(\"体力\".is_valid_unicode_identifier())         # Prints true\n"
"[/codeblock]\n"
"See also [method is_valid_ascii_identifier].\n"
"[b]Note:[/b] This method checks identifiers the same way as GDScript. See "
"[method TextServer.is_valid_identifier] for more advanced checks."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ string នេះគឺជា Unicode identifier ត្រឹមត្រូវ។\n"
"Unicode identifier ត្រឹមត្រូវត្រូវតែចាប់ផ្តើមដោយតួអក្សរ Unicode នៃ class "
"[code]XID_Start[/code] ឬ [code]\"_\"[/code] ហើយអាចមានផ្ទុកតួអក្សរ Unicode នៃ "
"class [code]XID_Continue[/code] នៅក្នុងទីតាំងផ្សេងទៀត។\n"
"[codeblock]\n"
"print(\"node_2d\".is_valid_unicode_identifier())      # បង្ហាញ true\n"
"print(\"1st_method\".is_valid_unicode_identifier())   # បង្ហាញ false\n"
"print(\"MyMethod#2\".is_valid_unicode_identifier())   # បង្ហាញ false\n"
"print(\"állóképesség\".is_valid_unicode_identifier()) # បង្ហាញ true\n"
"print(\"выносливость\".is_valid_unicode_identifier()) # បង្ហាញ true\n"
"print(\"体力\".is_valid_unicode_identifier())         # បង្ហាញ true\n"
"[/codeblock]\n"
"សូមមើលផងដែរ [method is_valid_ascii_identifier]។\n"
"[b]ចំណាំ៖[/b] វិធីសាស្រ្តនេះពិនិត្យ identifiers តាមវិធីដូចគ្នានឹង GDScript។ សូមមើល [method "
"TextServer.is_valid_identifier] សម្រាប់ការពិនិត្យកម្រិតខ្ពស់ជាងនេះ។"

msgid ""
"Returns the concatenation of [param parts]' elements, with each element "
"separated by the string calling this method. This method is the opposite of "
"[method split].\n"
"[codeblocks]\n"
"[gdscript]\n"
"var fruits = [\"Apple\", \"Orange\", \"Pear\", \"Kiwi\"]\n"
"\n"
"print(\", \".join(fruits))  # Prints \"Apple, Orange, Pear, Kiwi\"\n"
"print(\"---\".join(fruits)) # Prints \"Apple---Orange---Pear---Kiwi\"\n"
"[/gdscript]\n"
"[csharp]\n"
"string[] fruits = [\"Apple\", \"Orange\", \"Pear\", \"Kiwi\"];\n"
"\n"
"// In C#, this method is static.\n"
"GD.Print(string.Join(\", \", fruits));  // Prints \"Apple, Orange, Pear, "
"Kiwi\"\n"
"GD.Print(string.Join(\"---\", fruits)); // Prints \"Apple---Orange---Pear---"
"Kiwi\"\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"បង្វិលការតភ្ជាប់គ្នានៃធាតុរបស់ [param parts] ដោយធាតុនីមួយៗត្រូវបានបំបែកដោយ string "
"ដែលហៅវិធីសាស្រ្តនេះ។ វិធីសាស្រ្តនេះគឺផ្ទុយពី [method split]។\n"
"[codeblocks]\n"
"[gdscript]\n"
"var fruits = [\"Apple\", \"Orange\", \"Pear\", \"Kiwi\"]\n"
"\n"
"print(\", \".join(fruits))  # បង្ហាញ \"Apple, Orange, Pear, Kiwi\"\n"
"print(\"---\".join(fruits)) # បង្ហាញ \"Apple---Orange---Pear---Kiwi\"\n"
"[/gdscript]\n"
"[csharp]\n"
"string[] fruits = [\"Apple\", \"Orange\", \"Pear\", \"Kiwi\"];\n"
"\n"
"// នៅក្នុង C#, វិធីសាស្រ្តនេះគឺ static។\n"
"GD.Print(string.Join(\", \", fruits));  // បង្ហាញ \"Apple, Orange, Pear, "
"Kiwi\"\n"
"GD.Print(string.Join(\"---\", fruits)); // បង្ហាញ \"Apple---Orange---Pear---"
"Kiwi\"\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Returns a copy of the string with special characters escaped using the JSON "
"standard. Because it closely matches the C standard, it is possible to use "
"[method c_unescape] to unescape the string, if necessary."
msgstr ""
"បង្វិលច្បាប់ចម្លងនៃ string ដែលតួអក្សរពិសេសត្រូវបាន escape ដោយប្រើស្តង់ដារ JSON។ "
"ដោយសារវាស្រដៀងនឹងស្តង់ដារ C វាអាចប្រើ [method c_unescape] ដើម្បី unescape string បាន "
"ប្រសិនបើចាំបាច់។"

msgid ""
"Returns the first [param length] characters from the beginning of the string. "
"If [param length] is negative, strips the last [param length] characters from "
"the string's end.\n"
"[codeblock]\n"
"print(\"Hello World!\".left(3))  # Prints \"Hel\"\n"
"print(\"Hello World!\".left(-4)) # Prints \"Hello Wo\"\n"
"[/codeblock]"
msgstr ""
"បង្វិលតួអក្សរ [param length] ដំបូងពីដើមនៃ string។ ប្រសិនបើ [param length] អវិជ្ជមាន "
"វានឹងកាត់តួអក្សរ [param length] ចុងក្រោយចេញពីចុង string។\n"
"[codeblock]\n"
"print(\"Hello World!\".left(3))  # បង្ហាញ \"Hel\"\n"
"print(\"Hello World!\".left(-4)) # បង្ហាញ \"Hello Wo\"\n"
"[/codeblock]"

msgid ""
"Returns the number of characters in the string. Empty strings ([code]\"\"[/"
"code]) always return [code]0[/code]. See also [method is_empty]."
msgstr ""
"បង្វិលចំនួនតួអក្សរនៅក្នុង string។ String ទទេ ([code]\"\"[/code]) តែងតែបង្វិល [code]0[/"
"code]។ សូមមើលផងដែរ [method is_empty]។"

msgid ""
"Formats the string to be at least [param min_length] long by adding [param "
"character]s to the left of the string, if necessary. See also [method rpad]."
msgstr ""
"ធ្វើទម្រង់ string ឱ្យមានប្រវែងយ៉ាងតិច [param min_length] ដោយបន្ថែម [param character] "
"នៅខាងឆ្វេងនៃ string ប្រសិនបើចាំបាច់។ សូមមើលផងដែរ [method rpad]។"

msgid ""
"Removes a set of characters defined in [param chars] from the string's "
"beginning. See also [method rstrip].\n"
"[b]Note:[/b] [param chars] is not a prefix. Use [method trim_prefix] to "
"remove a single prefix, rather than a set of characters."
msgstr ""
"ដកស σύνολូតួអក្សរដែលបានកំណត់នៅក្នុង [param chars] ចេញពីដើម string។ សូមមើលផងដែរ [method "
"rstrip]។\n"
"[b]ចំណាំ៖[/b] [param chars] មិនមែនជា prefix ទេ។ ប្រើ [method trim_prefix] ដើម្បីដក "
"prefix តែមួយ ជាជាងសំណុំតួអក្សរ។"

msgid ""
"Does a simple expression match (also called \"glob\" or \"globbing\"), where "
"[code]*[/code] matches zero or more arbitrary characters and [code]?[/code] "
"matches any single character except a period ([code].[/code]). An empty "
"string or empty expression always evaluates to [code]false[/code]."
msgstr ""
"ធ្វើការផ្គូផ្គង expression សល (ហៅថា \"glob\" ឬ \"globbing\") ដែល [code]*[/code] "
"ផ្គូផ្គងតួអក្សរសូន្យ ឬច្រើន និង [code]?[/code] ផ្គូផ្គងតួអក្សរតែមួយណាក៏បាន លើកលែងតែសញ្ញាចុច "
"([code].[/code])។ String ទទេ ឬ expression ទទេតែងតែវាយតម្លៃទៅជា [code]false[/"
"code]។"

msgid ""
"Does a simple [b]case-insensitive[/b] expression match, where [code]*[/code] "
"matches zero or more arbitrary characters and [code]?[/code] matches any "
"single character except a period ([code].[/code]). An empty string or empty "
"expression always evaluates to [code]false[/code]."
msgstr ""
"ធ្វើការផ្គូផ្គង expression បែបសាមញ្ញ [b]មិនបែងចែកតួអក្សរធំតូច[/b] ដែល [code]*[/code] "
"ផ្គូផ្គងតួអក្សរសូន្យ ឬច្រើន និង [code]?[/code] ផ្គូផ្គងតួអក្សរតែមួយណាក៏បាន លើកលែងតែសញ្ញាចុច "
"([code].[/code])។ String ទទេ ឬ expression ទទេតែងតែវាយតម្លៃទៅជា [code]false[/"
"code]។"

msgid ""
"Returns the [url=https://en.wikipedia.org/wiki/MD5]MD5 hash[/url] of the "
"string as a [PackedByteArray]."
msgstr ""
"បង្វិល [url=https://en.wikipedia.org/wiki/MD5]MD5 hash[/url] នៃ string ជា "
"[PackedByteArray]។"

msgid ""
"Returns the [url=https://en.wikipedia.org/wiki/MD5]MD5 hash[/url] of the "
"string as another [String]."
msgstr ""
"បង្វិល [url=https://en.wikipedia.org/wiki/MD5]MD5 hash[/url] នៃ string ជា "
"[String] មួយទៀត។"

msgid ""
"Performs a [b]case-sensitive[/b], [i]natural order[/i] comparison to another "
"string. Returns [code]-1[/code] if less than, [code]1[/code] if greater than, "
"or [code]0[/code] if equal. \"Less than\" or \"greater than\" are determined "
"by the [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode "
"code points[/url] of each string, which roughly matches the alphabetical "
"order.\n"
"When used for sorting, natural order comparison orders sequences of numbers "
"by the combined value of each digit as is often expected, instead of the "
"single digit's value. A sorted sequence of numbered strings will be [code]"
"[\"1\", \"2\", \"3\", ...][/code], not [code][\"1\", \"10\", \"2\", "
"\"3\", ...][/code].\n"
"If the character comparison reaches the end of one string, but the other "
"string contains more characters, then it will use length as the deciding "
"factor: [code]1[/code] will be returned if this string is longer than the "
"[param to] string, or [code]-1[/code] if shorter. Note that the length of "
"empty strings is always [code]0[/code].\n"
"To get a [bool] result from a string comparison, use the [code]==[/code] "
"operator instead. See also [method naturalnocasecmp_to], [method "
"filecasecmp_to], and [method nocasecmp_to]."
msgstr ""
"ធ្វើការប្រៀបធៀប [b]បែងចែកតួអក្សរធំតូច[/b], [i]តាមលំដាប់ធម្មជាតិ[/i] ទៅនឹង string មួយទៀត។ "
"បង្វិល [code]-1[/code] ប្រសិនបើតូចជាង, [code]1[/code] ប្រសិនបើធំជាង, ឬ [code]0[/code] "
"ប្រសិនបើស្មើ។ \"តូចជាង\" ឬ \"ធំជាង\" ត្រូវបានកំណត់ដោយ [url=https://en.wikipedia.org/"
"wiki/List_of_Unicode_characters]Unicode code points[/url] នៃ string នីមួយៗ "
"ដែលប្រហាក់ប្រហែលនឹងលំដាប់អក្ខរក្រម។\n"
"នៅពេលប្រើសម្រាប់ការរៀបចំលំដាប់ ការប្រៀបធៀបតាមលំដាប់ធម្មជាតិ "
"រៀបចំលំដាប់លេខតាមតម្លៃរួមបញ្ចូលគ្នានៃលេខនីមួយៗ ដូចដែលគេរំពឹងទុកជាញឹកញាប់ ជំនួសឱ្យតម្លៃលេខខ្ទង់តែមួយ។ "
"លំដាប់ដែលបានរៀបចំនៃ strings ដែលមានលេខនឹងជា [code][\"1\", \"2\", \"3\", ...][/"
"code] មិនមែន [code][\"1\", \"10\", \"2\", \"3\", ...][/code] ទេ។\n"
"ប្រសិនបើការប្រៀបធៀបតួអក្សរឈានដល់ចុងបញ្ចប់នៃ string មួយ ប៉ុន្តែ string មួយទៀតមានតួអក្សរច្រើនជាង "
"នោះវានឹងប្រើប្រវែងជាកត្តាកំណត់៖ [code]1[/code] នឹងត្រូវបានបង្វិល ប្រសិនបើ string នេះវែងជាង "
"string [param to] ឬ [code]-1[/code] ប្រសិនបើខ្លីជាង។ សូមចំណាំថាប្រវែងនៃ string ទទេគឺ "
"[code]0[/code] ជានិច្ច។\n"
"ដើម្បីទទួលបានលទ្ធផល [bool] ពីការប្រៀបធៀប string សូមប្រើប្រតិបត្តិករ [code]==[/code] "
"ជំនួសវិញ។ សូមមើលផងដែរ [method naturalnocasecmp_to], [method filecasecmp_to], និង "
"[method nocasecmp_to]។"

msgid ""
"Performs a [b]case-insensitive[/b], [i]natural order[/i] comparison to "
"another string. Returns [code]-1[/code] if less than, [code]1[/code] if "
"greater than, or [code]0[/code] if equal. \"Less than\" or \"greater than\" "
"are determined by the [url=https://en.wikipedia.org/wiki/"
"List_of_Unicode_characters]Unicode code points[/url] of each string, which "
"roughly matches the alphabetical order. Internally, lowercase characters are "
"converted to uppercase for the comparison.\n"
"When used for sorting, natural order comparison orders sequences of numbers "
"by the combined value of each digit as is often expected, instead of the "
"single digit's value. A sorted sequence of numbered strings will be [code]"
"[\"1\", \"2\", \"3\", ...][/code], not [code][\"1\", \"10\", \"2\", "
"\"3\", ...][/code].\n"
"If the character comparison reaches the end of one string, but the other "
"string contains more characters, then it will use length as the deciding "
"factor: [code]1[/code] will be returned if this string is longer than the "
"[param to] string, or [code]-1[/code] if shorter. Note that the length of "
"empty strings is always [code]0[/code].\n"
"To get a [bool] result from a string comparison, use the [code]==[/code] "
"operator instead. See also [method naturalcasecmp_to], [method "
"filenocasecmp_to], and [method casecmp_to]."
msgstr ""
"ធ្វើការប្រៀបធៀប [b]មិនបែងចែកតួអក្សរធំតូច[/b], [i]តាមលំដាប់ធម្មជាតិ[/i] ទៅនឹង string "
"មួយទៀត។ បង្វិល [code]-1[/code] ប្រសិនបើតូចជាង, [code]1[/code] ប្រសិនបើធំជាង, ឬ "
"[code]0[/code] ប្រសិនបើស្មើ។ \"តូចជាង\" ឬ \"ធំជាង\" ត្រូវបានកំណត់ដោយ [url=https://"
"en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode code points[/url] នៃ "
"string នីមួយៗ ដែលប្រហាក់ប្រហែលនឹងលំដាប់អក្ខរក្រម។ នៅខាងក្នុង "
"តួអក្សរតូចត្រូវបានបម្លែងទៅជាតួអក្សរធំសម្រាប់ការប្រៀបធៀប។\n"
"នៅពេលប្រើសម្រាប់ការរៀបចំលំដាប់ ការប្រៀបធៀបតាមលំដាប់ធម្មជាតិ "
"រៀបចំលំដាប់លេខតាមតម្លៃរួមបញ្ចូលគ្នានៃលេខនីមួយៗ ដូចដែលគេរំពឹងទុកជាញឹកញាប់ ជំនួសឱ្យតម្លៃលេខខ្ទង់តែមួយ។ "
"លំដាប់ដែលបានរៀបចំនៃ strings ដែលមានលេខនឹងជា [code][\"1\", \"2\", \"3\", ...][/"
"code] មិនមែន [code][\"1\", \"10\", \"2\", \"3\", ...][/code] ទេ។\n"
"ប្រសិនបើការប្រៀបធៀបតួអក្សរឈានដល់ចុងបញ្ចប់នៃ string មួយ ប៉ុន្តែ string មួយទៀតមានតួអក្សរច្រើនជាង "
"នោះវានឹងប្រើប្រវែងជាកត្តាកំណត់៖ [code]1[/code] នឹងត្រូវបានបង្វិល ប្រសិនបើ string នេះវែងជាង "
"string [param to] ឬ [code]-1[/code] ប្រសិនបើខ្លីជាង។ សូមចំណាំថាប្រវែងនៃ string ទទេគឺ "
"[code]0[/code] ជានិច្ច។\n"
"ដើម្បីទទួលបានលទ្ធផល [bool] ពីការប្រៀបធៀប string សូមប្រើប្រតិបត្តិករ [code]==[/code] "
"ជំនួសវិញ។ សូមមើលផងដែរ [method naturalcasecmp_to], [method filenocasecmp_to], និង "
"[method casecmp_to]។"

msgid ""
"Performs a [b]case-insensitive[/b] comparison to another string. Returns "
"[code]-1[/code] if less than, [code]1[/code] if greater than, or [code]0[/"
"code] if equal. \"Less than\" or \"greater than\" are determined by the "
"[url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode code "
"points[/url] of each string, which roughly matches the alphabetical order. "
"Internally, lowercase characters are converted to uppercase for the "
"comparison.\n"
"If the character comparison reaches the end of one string, but the other "
"string contains more characters, then it will use length as the deciding "
"factor: [code]1[/code] will be returned if this string is longer than the "
"[param to] string, or [code]-1[/code] if shorter. Note that the length of "
"empty strings is always [code]0[/code].\n"
"To get a [bool] result from a string comparison, use the [code]==[/code] "
"operator instead. See also [method casecmp_to], [method filenocasecmp_to], "
"and [method naturalnocasecmp_to]."
msgstr ""
"ធ្វើការប្រៀបធៀប [b]មិនបែងចែកតួអក្សរធំតូច[/b] ទៅនឹង string មួយទៀត។ បង្វិល [code]-1[/code] "
"ប្រសិនបើតូចជាង, [code]1[/code] ប្រសិនបើធំជាង, ឬ [code]0[/code] ប្រសិនបើស្មើ។ \"តូចជាង\" "
"ឬ \"ធំជាង\" ត្រូវបានកំណត់ដោយ [url=https://en.wikipedia.org/wiki/"
"List_of_Unicode_characters]Unicode code points[/url] នៃ string នីមួយៗ "
"ដែលប្រហាក់ប្រហែលនឹងលំដាប់អក្ខរក្រម។ នៅខាងក្នុង "
"តួអក្សរតូចត្រូវបានបម្លែងទៅជាតួអក្សរធំសម្រាប់ការប្រៀបធៀប។\n"
"ប្រសិនបើការប្រៀបធៀបតួអក្សរឈានដល់ចុងបញ្ចប់នៃ string មួយ ប៉ុន្តែ string មួយទៀតមានតួអក្សរច្រើនជាង "
"នោះវានឹងប្រើប្រវែងជាកត្តាកំណត់៖ [code]1[/code] នឹងត្រូវបានបង្វិល ប្រសិនបើ string នេះវែងជាង "
"string [param to] ឬ [code]-1[/code] ប្រសិនបើខ្លីជាង។ សូមចំណាំថាប្រវែងនៃ string ទទេគឺ "
"[code]0[/code] ជានិច្ច។\n"
"ដើម្បីទទួលបានលទ្ធផល [bool] ពីការប្រៀបធៀប string សូមប្រើប្រតិបត្តិករ [code]==[/code] "
"ជំនួសវិញ។ សូមមើលផងដែរ [method casecmp_to], [method filenocasecmp_to], និង [method "
"naturalnocasecmp_to]។"

msgid ""
"Converts a [float] to a string representation of a decimal number, with the "
"number of decimal places specified in [param decimals].\n"
"If [param decimals] is [code]-1[/code] as by default, the string "
"representation may only have up to 14 significant digits, with digits before "
"the decimal point having priority over digits after.\n"
"Trailing zeros are not included in the string. The last digit is rounded, not "
"truncated.\n"
"[codeblock]\n"
"String.num(3.141593)     # Returns \"3.141593\"\n"
"String.num(3.141593, 3)  # Returns \"3.142\"\n"
"String.num(3.14159300)   # Returns \"3.141593\"\n"
"\n"
"# Here, the last digit will be rounded up,\n"
"# which reduces the total digit count, since trailing zeros are removed:\n"
"String.num(42.129999, 5) # Returns \"42.13\"\n"
"\n"
"# If `decimals` is not specified, the maximum number of significant digits is "
"14:\n"
"String.num(-0.0000012345432123454321)     # Returns \"-0.00000123454321\"\n"
"String.num(-10000.0000012345432123454321) # Returns \"-10000.0000012345\"\n"
"[/codeblock]"
msgstr ""
"បម្លែង [float] ទៅជាទម្រង់ string នៃលេខទសភាគ ជាមួយចំនួនខ្ទង់ទសភាគដែលបានបញ្ជាក់នៅក្នុង "
"[param decimals]។\n"
"ប្រសិនបើ [param decimals] គឺ [code]-1[/code] ដូចលំនាំដើម ទម្រង់ string អាចមានត្រឹមតែ 14 "
"ខ្ទង់ដែលមានអត្ថន័យប៉ុណ្ណោះ ដោយខ្ទង់មុនសញ្ញាចុចទសភាគមានអាទិភាពជាើខ្ទង់ក្រោយ។\n"
"លេខសូន្យនៅខាងចុងមិនត្រូវបានរាប់បញ្ចូលក្នុង string ទេ។ ខ្ទង់ចុងក្រោយត្រូវបានបង្គត់ "
"មិនមែនកាត់ចោលទេ។\n"
"[codeblock]\n"
"String.num(3.141593)     # បង្វិល \"3.141593\"\n"
"String.num(3.141593, 3)  # បង្វិល \"3.142\"\n"
"String.num(3.14159300)   # បង្វិល \"3.141593\"\n"
"\n"
"# នៅទីនេះ ខ្ទង់ចុងក្រោយនឹងត្រូវបានបង្គត់ឡើង,\n"
"# ដែលកាត់បន្ថយចំនួនខ្ទង់សរុប ដោយសារលេខសូន្យនៅខាងចុងត្រូវបានដកចេញ:\n"
"String.num(42.129999, 5) # បង្វិល \"42.13\"\n"
"\n"
"# ប្រសិនបើ `decimals` មិនត្រូវបានបញ្ជាក់ ចំនួនខ្ទង់អតិបរមាដែលមានអត្ថន័យគឺ 14:\n"
"String.num(-0.0000012345432123454321)     # បង្វិល \"-0.00000123454321\"\n"
"String.num(-10000.0000012345432123454321) # បង្វិល \"-10000.0000012345\"\n"
"[/codeblock]"

msgid ""
"Converts the given [param number] to a string representation, with the given "
"[param base].\n"
"By default, [param base] is set to decimal ([code]10[/code]). Other common "
"bases in programming include binary ([code]2[/code]), [url=https://"
"en.wikipedia.org/wiki/Octal]octal[/url] ([code]8[/code]), hexadecimal "
"([code]16[/code]).\n"
"If [param capitalize_hex] is [code]true[/code], digits higher than 9 are "
"represented in uppercase."
msgstr ""
"បម្លែង [param number] ដែលបានផ្តល់ឱ្យទៅជាទម្រង់ string ជាមួយ [param base] "
"ដែលបានផ្តល់ឱ្យ។\n"
"តាមលំនាំដើម [param base] ត្រូវបានកំណត់ទៅជាទសភាគ ([code]10[/code])។ "
"គោលធម្មតាផ្សេងទៀតនៅក្នុងការសរសេរកម្មវិធីរួមមាន គោលពីរ ([code]2[/code]), [url=https://"
"en.wikipedia.org/wiki/Octal]គោលប្រាំបី[/url] ([code]8[/code]), គោលដប់ប្រាំមួយ "
"([code]16[/code])។\n"
"ប្រសិនបើ [param capitalize_hex] គឺ [code]true[/code] លេខដែលធំជាង 9 "
"ត្រូវបានតំណាងដោយតួអក្សរធំ។"

msgid ""
"Converts the given [param number] to a string representation, in scientific "
"notation.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var n = -5.2e8\n"
"print(n)                        # Prints -520000000\n"
"print(String.num_scientific(n)) # Prints -5.2e+08\n"
"[/gdscript]\n"
"[csharp]\n"
"// This method is not implemented in C#.\n"
"// Use `string.ToString()` with \"e\" to achieve similar results.\n"
"var n = -5.2e8f;\n"
"GD.Print(n);                // Prints -520000000\n"
"GD.Print(n.ToString(\"e1\")); // Prints -5.2e+008\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]Note:[/b] In C#, this method is not implemented. To achieve similar "
"results, see C#'s [url=https://learn.microsoft.com/en-us/dotnet/standard/base-"
"types/standard-numeric-format-strings]Standard numeric format strings[/url]."
msgstr ""
"បម្លែង [param number] ដែលបានផ្តល់ឱ្យទៅជាទម្រង់ string ក្នុងទម្រង់វិទ្យាសាស្ត្រ។\n"
"[codeblocks]\n"
"[gdscript]\n"
"var n = -5.2e8\n"
"print(n)                        # បង្ហាញ -520000000\n"
"print(String.num_scientific(n)) # បង្ហាញ -5.2e+08\n"
"[/gdscript]\n"
"[csharp]\n"
"// វិធីសាស្រ្តនេះមិនត្រូវបានអនុវត្តនៅក្នុង C# ទេ។\n"
"// ប្រើ `string.ToString()` ជាមួយ \"e\" ដើម្បីទទួលបានលទ្ធផលស្រដៀងគ្នា។\n"
"var n = -5.2e8f;\n"
"GD.Print(n);                // បង្ហាញ -520000000\n"
"GD.Print(n.ToString(\"e1\")); // បង្ហាញ -5.2e+008\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]ចំណាំ៖[/b] នៅក្នុង C#, វិធីសាស្រ្តនេះមិនត្រូវបានអនុវត្តទេ។ ដើម្បីទទួលបានលទ្ធផលស្រដៀងគ្នា "
"សូមមើល [url=https://learn.microsoft.com/en-us/dotnet/standard/base-types/"
"standard-numeric-format-strings]ខ្សែអក្សរទម្រង់លេខស្តង់ដារ[/url] របស់ C#។"

msgid ""
"Converts the given unsigned [int] to a string representation, with the given "
"[param base].\n"
"By default, [param base] is set to decimal ([code]10[/code]). Other common "
"bases in programming include binary ([code]2[/code]), [url=https://"
"en.wikipedia.org/wiki/Octal]octal[/url] ([code]8[/code]), hexadecimal "
"([code]16[/code]).\n"
"If [param capitalize_hex] is [code]true[/code], digits higher than 9 are "
"represented in uppercase."
msgstr ""
"បម្លែង unsigned [int] ដែលបានផ្តល់ឱ្យទៅជាទម្រង់ string ជាមួយ [param base] "
"ដែលបានផ្តល់ឱ្យ។\n"
"តាមលំនាំដើម [param base] ត្រូវបានកំណត់ទៅជាទសភាគ ([code]10[/code])។ "
"គោលធម្មតាផ្សេងទៀតនៅក្នុងការសរសេរកម្មវិធីរួមមាន គោលពីរ ([code]2[/code]), [url=https://"
"en.wikipedia.org/wiki/Octal]គោលប្រាំបី[/url] ([code]8[/code]), គោលដប់ប្រាំមួយ "
"([code]16[/code])។\n"
"ប្រសិនបើ [param capitalize_hex] គឺ [code]true[/code] លេខដែលធំជាង 9 "
"ត្រូវបានតំណាងដោយតួអក្សរធំ។"

msgid ""
"Formats the string representing a number to have an exact number of [param "
"digits] [i]after[/i] the decimal point."
msgstr ""
"ធ្វើទម្រង់ string ដែលតំណាងឱ្យលេខ ឱ្យមានចំនួន [param digits] [i]បន្ទាប់ពី[/i] "
"សញ្ញាចុចទសភាគយ៉ាងជាក់លាក់។"

msgid ""
"Formats the string representing a number to have an exact number of [param "
"digits] [i]before[/i] the decimal point."
msgstr ""
"ធ្វើទម្រង់ string ដែលតំណាងឱ្យលេខ ឱ្យមានចំនួន [param digits] [i]មុន[/i] "
"សញ្ញាចុចទសភាគយ៉ាងជាក់លាក់។"

msgid ""
"Concatenates [param path] at the end of the string as a subpath, adding "
"[code]/[/code] if necessary.\n"
"[b]Example:[/b] [code]\"this/is\".path_join(\"path\") == \"this/is/path\"[/"
"code]."
msgstr ""
"តភ្ជាប់ [param path] នៅចុង string ជា subpath ដោយបន្ថែម [code]/[/code] "
"ប្រសិនបើចាំបាច់។\n"
"[b]ឧទាហរណ៍៖[/b] [code]\"this/is\".path_join(\"path\") == \"this/is/path\"[/"
"code]។"

msgid ""
"Removes all occurrences of the Unicode character with code [param what]. "
"Faster version of [method replace] when the key is only one character long "
"and the replacement is [code]\"\"[/code]."
msgstr ""
"ដកការកើតឡើងទាំងអស់នៃតួអក្សរ Unicode ដែលមានកូដ [param what] ចេញ។ កំណែលឿនជាងនៃ "
"[method replace] នៅពេលដែល key មានប្រវែងតែមួយតួអក្សរ ហើយការជំនួសគឺ [code]\"\"[/code]។"

msgid ""
"Removes all occurrences of the characters in [param chars]. See also [method "
"remove_char]."
msgstr ""
"ដកការកើតឡើងទាំងអស់នៃតួអក្សរនៅក្នុង [param chars]។ សូមមើលផងដែរ [method remove_char]។"

msgid ""
"Repeats this string a number of times. [param count] needs to be greater than "
"[code]0[/code]. Otherwise, returns an empty string."
msgstr ""
"បន្ត string នេះច្រើនដង។ [param count] ត្រូវតែធំជាង [code]0[/code]។ បើពុំនោះទេ បង្វិល "
"string ទទេ។"

msgid ""
"Replaces all occurrences of [param what] inside the string with the given "
"[param forwhat]."
msgstr ""
"ជំនួសការកើតឡើងទាំងអស់នៃ [param what] នៅក្នុង string ដោយ [param forwhat] ដែលបានផ្តល់ឱ្យ។"

msgid ""
"Replaces all occurrences of the Unicode character with code [param key] with "
"the Unicode character with code [param with]. Faster version of [method "
"replace] when the key is only one character long. To get a single character "
"use [code]\"X\".unicode_at(0)[/code] (note that some strings, like compound "
"letters and emoji, can be composed of multiple unicode codepoints, and will "
"not work with this method, use [method length] to make sure)."
msgstr ""
"ជំនួសការកើតឡើងទាំងអស់នៃតួអក្សរ Unicode ដែលមានកូដ [param key] ដោយតួអក្សរ Unicode "
"ដែលមានកូដ [param with]។ កំណែលឿនជាងនៃ [method replace] នៅពេលដែល key "
"មានប្រវែងតែមួយតួអក្សរ។ ដើម្បីទទួលបានតួអក្សរតែមួយ សូមប្រើ [code]\"X\".unicode_at(0)[/code] "
"(សូមចំណាំថា strings មួយចំនួន ដូចជា compound letters និង emoji អាចផ្សំឡើងដោយ unicode "
"codepoints ច្រើន ហើយនឹងមិនដំណើរការជាមួយវិធីសាស្រ្តនេះទេ សូមប្រើ [method length] "
"ដើម្បីធានា)។"

msgid ""
"Replaces any occurrence of the characters in [param keys] with the Unicode "
"character with code [param with]. See also [method replace_char]."
msgstr ""
"ជំនួសការកើតឡើងណាមួយនៃតួអក្សរនៅក្នុង [param keys] ដោយតួអក្សរ Unicode ដែលមានកូដ [param "
"with]។ សូមមើលផងដែរ [method replace_char]។"

msgid ""
"Replaces all [b]case-insensitive[/b] occurrences of [param what] inside the "
"string with the given [param forwhat]."
msgstr ""
"ជំនួសការកើតឡើងទាំងអស់នៃ [param what] ក្នុង string ដោយ [b]មិនបែងចែកតួអក្សរធំតូច[/b] ជាមួយ "
"[param forwhat] ដែលបានផ្តល់ឱ្យ។"

msgid ""
"Returns the copy of this string in reverse order. This operation works on "
"unicode codepoints, rather than sequences of codepoints, and may break things "
"like compound letters or emojis."
msgstr ""
"បង្វិលច្បាប់ចម្លងនៃ string នេះតាមលំដាប់បញ្ច្រាស។ ប្រតិបត្តិការនេះដំណើរការលើ unicode "
"codepoints ជាជាងលំដាប់នៃ codepoints ហើយអាចធ្វើឱ្យខូចអ្វីមួយដូចជា compound letters ឬ "
"emojis។"

msgid ""
"Returns the index of the [b]last[/b] occurrence of [param what] in this "
"string, or [code]-1[/code] if there are none. The search's start can be "
"specified with [param from], continuing to the beginning of the string. This "
"method is the reverse of [method find].\n"
"[b]Note:[/b] A negative value of [param from] is converted to a starting "
"index by counting back from the last possible index with enough space to find "
"[param what].\n"
"[b]Note:[/b] A value of [param from] that is greater than the last possible "
"index with enough space to find [param what] is considered out-of-bounds, and "
"returns [code]-1[/code]."
msgstr ""
"បង្វិល index នៃការកើតឡើង [b]ចុងក្រោយ[/b] នៃ [param what] នៅក្នុង string នេះ ឬ "
"[code]-1[/code] ប្រសិនបើគ្មាន។ ការចាប់ផ្តើមស្វែងរកអាចត្រូវបានបញ្ជាក់ដោយ [param from] "
"ហើយបន្តរហូតដល់ដើមនៃ string។ វិធីសាស្រ្តនេះគឺបញ្ច្រាសពី [method find]។\n"
"[b]ចំណាំ៖[/b] តម្លៃអវិជ្ជមាននៃ [param from] ត្រូវបានបម្លែងទៅជា index ចាប់ផ្តើម "
"ដោយរាប់ថយក្រោយពី index ចុងក្រោយដែលអាចទៅរួចដែលមានចន្លោះគ្រប់គ្រាន់ដើម្បីរក [param what]។\n"
"[b]ចំណាំ៖[/b] តម្លៃនៃ [param from] ដែលធំជាង index "
"ចុងក្រោយដែលអាចទៅរួចដែលមានចន្លោះគ្រប់គ្រាន់ដើម្បីរក [param what] ត្រូវបានចាត់ទុកថា out-of-"
"bounds ហើយបង្វិល [code]-1[/code]។"

msgid ""
"Returns the index of the [b]last[/b] [b]case-insensitive[/b] occurrence of "
"[param what] in this string, or [code]-1[/code] if there are none. The "
"starting search index can be specified with [param from], continuing to the "
"beginning of the string. This method is the reverse of [method findn]."
msgstr ""
"បង្វិល index នៃការកើតឡើង [b]ចុងក្រោយ[/b] ដោយ [b]មិនបែងចែកតួអក្សរធំតូច[/b] នៃ [param "
"what] នៅក្នុង string នេះ ឬ [code]-1[/code] ប្រសិនបើគ្មាន។ Index "
"ចាប់ផ្តើមស្វែងរកអាចត្រូវបានបញ្ជាក់ដោយ [param from] ហើយបន្តរហូតដល់ដើមនៃ string។ "
"វិធីសាស្រ្តនេះគឺបញ្ច្រាសពី [method findn]។"

msgid ""
"Returns the last [param length] characters from the end of the string. If "
"[param length] is negative, strips the first [param length] characters from "
"the string's beginning.\n"
"[codeblock]\n"
"print(\"Hello World!\".right(3))  # Prints \"ld!\"\n"
"print(\"Hello World!\".right(-4)) # Prints \"o World!\"\n"
"[/codeblock]"
msgstr ""
"បង្វិលតួអក្សរ [param length] ចុងក្រោយពីចុងនៃ string។ ប្រសិនបើ [param length] អវិជ្ជមាន "
"វានឹងកាត់តួអក្សរ [param length] ដំបូងចេញពីដើម string។\n"
"[codeblock]\n"
"print(\"Hello World!\".right(3))  # បង្ហាញ \"ld!\"\n"
"print(\"Hello World!\".right(-4)) # បង្ហាញ \"o World!\"\n"
"[/codeblock]"

msgid ""
"Formats the string to be at least [param min_length] long, by adding [param "
"character]s to the right of the string, if necessary. See also [method lpad]."
msgstr ""
"ធ្វើទម្រង់ string ឱ្យមានប្រវែងយ៉ាងតិច [param min_length] ដោយបន្ថែម [param character] "
"នៅខាងស្តាំនៃ string ប្រសិនបើចាំបាច់។ សូមមើលផងដែរ [method lpad]។"

msgid ""
"Splits the string using a [param delimiter] and returns an array of the "
"substrings, starting from the end of the string. The splits in the returned "
"array appear in the same order as the original string. If [param delimiter] "
"is an empty string, each substring will be a single character.\n"
"If [param allow_empty] is [code]false[/code], empty strings between adjacent "
"delimiters are excluded from the array.\n"
"If [param maxsplit] is greater than [code]0[/code], the number of splits may "
"not exceed [param maxsplit]. By default, the entire string is split, which is "
"mostly identical to [method split].\n"
"[codeblocks]\n"
"[gdscript]\n"
"var some_string = \"One,Two,Three,Four\"\n"
"var some_array = some_string.rsplit(\",\", true, 1)\n"
"\n"
"print(some_array.size()) # Prints 2\n"
"print(some_array[0])     # Prints \"One,Two,Three\"\n"
"print(some_array[1])     # Prints \"Four\"\n"
"[/gdscript]\n"
"[csharp]\n"
"// In C#, there is no String.RSplit() method.\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"បំបែក string ដោយប្រើ [param delimiter] ហើយបង្វិលអារេនៃ substrings ដោយចាប់ផ្តើមពីចុង "
"string។ ការបំបែកនៅក្នុងអារេដែលបានបង្វិល បង្ហាញក្នុងលំដាប់ដូចគ្នានឹង string ដើម។ ប្រសិនបើ "
"[param delimiter] គឺជា string ទទេ substring នីមួយៗនឹងជាតួអក្សរតែមួយ។\n"
"ប្រសិនបើ [param allow_empty] គឺ [code]false[/code] strings ទទេរវាង delimiters "
"ជាប់គ្នានឹងត្រូវបានដកចេញពីអារេ។\n"
"ប្រសិនបើ [param maxsplit] ធំជាង [code]0[/code] ចំនួននៃការបំបែកមិនអាចលើសពី [param "
"maxsplit] ទេ។ តាមលំនាំដើម string ទាំងមូលត្រូវបានបំបែក ដែលស្ទើរតែដូចគ្នានឹង [method "
"split]។\n"
"[codeblocks]\n"
"[gdscript]\n"
"var some_string = \"One,Two,Three,Four\"\n"
"var some_array = some_string.rsplit(\",\", true, 1)\n"
"\n"
"print(some_array.size()) # បង្ហាញ 2\n"
"print(some_array[0])     # បង្ហាញ \"One,Two,Three\"\n"
"print(some_array[1])     # បង្ហាញ \"Four\"\n"
"[/gdscript]\n"
"[csharp]\n"
"// នៅក្នុង C#, គ្មានវិធីសាស្រ្ត String.RSplit() ទេ។\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Removes a set of characters defined in [param chars] from the string's end. "
"See also [method lstrip].\n"
"[b]Note:[/b] [param chars] is not a suffix. Use [method trim_suffix] to "
"remove a single suffix, rather than a set of characters."
msgstr ""
"ដកសំណុំតួអក្សរដែលបានកំណត់នៅក្នុង [param chars] ចេញពីចុង string។ សូមមើលផងដែរ [method "
"lstrip]។\n"
"[b]ចំណាំ៖[/b] [param chars] មិនមែនជា suffix ទេ។ ប្រើ [method trim_suffix] ដើម្បីដក "
"suffix តែមួយ ជំនួសឱ្យសំណុំតួអក្សរ។"

msgid ""
"Returns the [url=https://en.wikipedia.org/wiki/SHA-1]SHA-1[/url] hash of the "
"string as a [PackedByteArray]."
msgstr ""
"បង្វិល [url=https://en.wikipedia.org/wiki/SHA-1]SHA-1[/url] hash នៃ string ជា "
"[PackedByteArray]។"

msgid ""
"Returns the [url=https://en.wikipedia.org/wiki/SHA-1]SHA-1[/url] hash of the "
"string as another [String]."
msgstr ""
"បង្វិល [url=https://en.wikipedia.org/wiki/SHA-1]SHA-1[/url] hash នៃ string ជា "
"[String] មួយទៀត។"

msgid ""
"Returns the [url=https://en.wikipedia.org/wiki/SHA-2]SHA-256[/url] hash of "
"the string as a [PackedByteArray]."
msgstr ""
"បង្វិល [url=https://en.wikipedia.org/wiki/SHA-2]SHA-256[/url] hash នៃ string ជា "
"[PackedByteArray]។"

msgid ""
"Returns the [url=https://en.wikipedia.org/wiki/SHA-2]SHA-256[/url] hash of "
"the string as another [String]."
msgstr ""
"បង្វិល [url=https://en.wikipedia.org/wiki/SHA-2]SHA-256[/url] hash នៃ string ជា "
"[String] មួយទៀត។"

msgid ""
"Returns the similarity index ([url=https://en.wikipedia.org/wiki/"
"S%C3%B8rensen%E2%80%93Dice_coefficient]Sørensen-Dice coefficient[/url]) of "
"this string compared to another. A result of [code]1.0[/code] means totally "
"similar, while [code]0.0[/code] means totally dissimilar.\n"
"[codeblock]\n"
"print(\"ABC123\".similarity(\"ABC123\")) # Prints 1.0\n"
"print(\"ABC123\".similarity(\"XYZ456\")) # Prints 0.0\n"
"print(\"ABC123\".similarity(\"123ABC\")) # Prints 0.8\n"
"print(\"ABC123\".similarity(\"abc123\")) # Prints 0.4\n"
"[/codeblock]"
msgstr ""
"បង្វិលសន្ទស្សន៍ភាពស្រដៀងគ្នា ([url=https://en.wikipedia.org/wiki/"
"S%C3%B8rensen%E2%80%93Dice_coefficient]មេគុណ Sørensen-Dice[/url]) នៃ string "
"នេះបើធៀបនឹង string មួយទៀត។ លទ្ធផល [code]1.0[/code] មានន័យថាស្រដៀងគ្នាទាំងស្រុង "
"ខណៈពេលដែល [code]0.0[/code] មានន័យថាខុសគ្នាទាំងស្រុង។\n"
"[codeblock]\n"
"print(\"ABC123\".similarity(\"ABC123\")) # បង្ហាញ 1.0\n"
"print(\"ABC123\".similarity(\"XYZ456\")) # បង្ហាញ 0.0\n"
"print(\"ABC123\".similarity(\"123ABC\")) # បង្ហាញ 0.8\n"
"print(\"ABC123\".similarity(\"abc123\")) # បង្ហាញ 0.4\n"
"[/codeblock]"

msgid ""
"If the string is a valid file path, converts the string into a canonical "
"path. This is the shortest possible path, without [code]\"./\"[/code], and "
"all the unnecessary [code]\"..\"[/code] and [code]\"/\"[/code].\n"
"[codeblock]\n"
"var simple_path = \"./path/to///../file\".simplify_path()\n"
"print(simple_path) # Prints \"path/file\"\n"
"[/codeblock]"
msgstr ""
"ប្រសិនបើ string គឺជា file path ត្រឹមត្រូវ បម្លែង string ទៅជា canonical path។ នេះគឺជា "
"path ដែលខ្លីបំផុតដែលអាច ទៅរួច ដោយគ្មាន [code]\"./\"[/code] និង [code]\"..\"[/code] "
"និង [code]\"/\"[/code] ដែលមិនចាំបាច់ទាំងអស់។\n"
"[codeblock]\n"
"var simple_path = \"./path/to///../file\".simplify_path()\n"
"print(simple_path) # បង្ហាញ \"path/file\"\n"
"[/codeblock]"

msgid ""
"Splits the string using a [param delimiter] and returns an array of the "
"substrings. If [param delimiter] is an empty string, each substring will be a "
"single character. This method is the opposite of [method join].\n"
"If [param allow_empty] is [code]false[/code], empty strings between adjacent "
"delimiters are excluded from the array.\n"
"If [param maxsplit] is greater than [code]0[/code], the number of splits may "
"not exceed [param maxsplit]. By default, the entire string is split.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var some_array = \"One,Two,Three,Four\".split(\",\", true, 2)\n"
"\n"
"print(some_array.size()) # Prints 3\n"
"print(some_array[0])     # Prints \"One\"\n"
"print(some_array[1])     # Prints \"Two\"\n"
"print(some_array[2])     # Prints \"Three,Four\"\n"
"[/gdscript]\n"
"[csharp]\n"
"// C#'s `Split()` does not support the `maxsplit` parameter.\n"
"var someArray = \"One,Two,Three\".Split(\",\");\n"
"\n"
"GD.Print(someArray[0]); // Prints \"One\"\n"
"GD.Print(someArray[1]); // Prints \"Two\"\n"
"GD.Print(someArray[2]); // Prints \"Three\"\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]Note:[/b] If you only need one substring from the array, consider using "
"[method get_slice] which is faster. If you need to split strings with more "
"complex rules, use the [RegEx] class instead."
msgstr ""
"បំបែក string ដោយប្រើ [param delimiter] ហើយបង្វិលអារេនៃ substrings។ ប្រសិនបើ [param "
"delimiter] គឺជា string ទទេ substring នីមួយៗនឹងជាតួអក្សរតែមួយ។ វិធីសាស្រ្តនេះគឺផ្ទុយពី "
"[method join]។\n"
"ប្រសិនបើ [param allow_empty] គឺ [code]false[/code] strings ទទេរវាង delimiters "
"ជាប់គ្នានឹងត្រូវបានដកចេញពីអារេ។\n"
"ប្រសិនបើ [param maxsplit] ធំជាង [code]0[/code] ចំនួននៃការបំបែកមិនអាចលើសពី [param "
"maxsplit] ទេ។ តាមលំនាំដើម string ទាំងមូលត្រូវបានបំបែក។\n"
"[codeblocks]\n"
"[gdscript]\n"
"var some_array = \"One,Two,Three,Four\".split(\",\", true, 2)\n"
"\n"
"print(some_array.size()) # បង្ហាញ 3\n"
"print(some_array[0])     # បង្ហាញ \"One\"\n"
"print(some_array[1])     # បង្ហាញ \"Two\"\n"
"print(some_array[2])     # បង្ហាញ \"Three,Four\"\n"
"[/gdscript]\n"
"[csharp]\n"
"// `Split()` របស់ C# មិនគាំទ្រប៉ារ៉ាម៉ែត្រ `maxsplit` ទេ។\n"
"var someArray = \"One,Two,Three\".Split(\",\");\n"
"\n"
"GD.Print(someArray[0]); // បង្ហាញ \"One\"\n"
"GD.Print(someArray[1]); // បង្ហាញ \"Two\"\n"
"GD.Print(someArray[2]); // បង្ហាញ \"Three\"\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើអ្នកត្រូវការតែមួយ substring ពីអារេ សូមពិចារណាប្រើ [method "
"get_slice] ដែលលឿនជាង។ ប្រសិនបើអ្នកត្រូវការបំបែក strings ដោយប្រើច្បាប់ស្មុគស្មាញជាងនេះ "
"សូមប្រើ class [RegEx] ជំនួសវិញ។"

msgid ""
"Splits the string into floats by using a [param delimiter] and returns a "
"[PackedFloat64Array].\n"
"If [param allow_empty] is [code]false[/code], empty or invalid [float] "
"conversions between adjacent delimiters are excluded.\n"
"[codeblock]\n"
"var a = \"1,2,4.5\".split_floats(\",\")         # a is [1.0, 2.0, 4.5]\n"
"var c = \"1| ||4.5\".split_floats(\"|\")        # c is [1.0, 0.0, 0.0, 4.5]\n"
"var b = \"1| ||4.5\".split_floats(\"|\", false) # b is [1.0, 4.5]\n"
"[/codeblock]"
msgstr ""
"បំបែក string ទៅជា floats ដោយប្រើ [param delimiter] ហើយបង្វិល "
"[PackedFloat64Array]។\n"
"ប្រសិនបើ [param allow_empty] គឺ [code]false[/code] ការបម្លែង [float] ទទេ "
"ឬមិនត្រឹមត្រូវរវាង delimiters ជាប់គ្នានឹងត្រូវបានដកចេញ។\n"
"[codeblock]\n"
"var a = \"1,2,4.5\".split_floats(\",\")         # a គឺ [1.0, 2.0, 4.5]\n"
"var c = \"1| ||4.5\".split_floats(\"|\")        # c គឺ [1.0, 0.0, 0.0, 4.5]\n"
"var b = \"1| ||4.5\".split_floats(\"|\", false) # b គឺ [1.0, 4.5]\n"
"[/codeblock]"

msgid ""
"Strips all non-printable characters from the beginning and the end of the "
"string. These include spaces, tabulations ([code]\\t[/code]), and newlines "
"([code]\\n[/code] [code]\\r[/code]).\n"
"If [param left] is [code]false[/code], ignores the string's beginning. "
"Likewise, if [param right] is [code]false[/code], ignores the string's end."
msgstr ""
"ដកតួអក្សរដែលមិនអាចបោះពុម្ពបានទាំងអស់ចេញពីដើម និងចុងនៃ string។ ទាំងនេះរួមមានចន្លោះ, "
"tabulations ([code]\\t[/code]), និង newlines ([code]\\n[/code] [code]\\r[/"
"code])។\n"
"ប្រសិនបើ [param left] គឺ [code]false[/code] មិនអើពើនឹងដើម string។ ដូចគ្នាដែរ ប្រសិនបើ "
"[param right] គឺ [code]false[/code] មិនអើពើនឹងចុង string។"

msgid ""
"Strips all escape characters from the string. These include all non-printable "
"control characters of the first page of the ASCII table (values from 0 to "
"31), such as tabulation ([code]\\t[/code]) and newline ([code]\\n[/code], "
"[code]\\r[/code]) characters, but [i]not[/i] spaces."
msgstr ""
"ដកតួអក្សរ escape ទាំងអស់ចេញពី string។ ទាំងនេះរួមមានតួអក្សរ control "
"ដែលមិនអាចបោះពុម្ពបានទាំងអស់នៃទំព័រដំបូងនៃតារាង ASCII (តម្លៃពី 0 ដល់ 31) ដូចជា tabulation "
"([code]\\t[/code]) និង newline ([code]\\n[/code], [code]\\r[/code]) ប៉ុន្តែ "
"[i]មិនមែន[/i] ចន្លោះទេ។"

msgid ""
"Returns part of the string from the position [param from] with length [param "
"len]. If [param len] is [code]-1[/code] (as by default), returns the rest of "
"the string starting from the given position."
msgstr ""
"បង្វិលផ្នែកនៃ string ពីទីតាំង [param from] ដែលមានប្រវែង [param len]។ ប្រសិនបើ [param "
"len] គឺ [code]-1[/code] (ដូចលំនាំដើម) បង្វិលផ្នែកដែលនៅសល់នៃ string "
"ដោយចាប់ផ្តើមពីទីតាំងដែលបានផ្តល់ឱ្យ។"

msgid ""
"Converts the string to an [url=https://en.wikipedia.org/wiki/ASCII]ASCII[/"
"url]/Latin-1 encoded [PackedByteArray]. This method is slightly faster than "
"[method to_utf8_buffer], but replaces all unsupported characters with spaces. "
"This is the inverse of [method PackedByteArray.get_string_from_ascii]."
msgstr ""
"បម្លែង string ទៅជា [PackedByteArray] ដែលបានអ៊ិនកូដជា [url=https://"
"en.wikipedia.org/wiki/ASCII]ASCII[/url]/Latin-1។ វិធីសាស្រ្តនេះលឿនជាង [method "
"to_utf8_buffer] បន្តិច ប៉ុន្តែជំនួសតួអក្សរដែលមិនគាំទ្រទាំងអស់ដោយចន្លោះ។ នេះគឺជាប្រតិបត្តិការផ្ទុយពី "
"[method PackedByteArray.get_string_from_ascii]។"

msgid "Returns the string converted to [code]camelCase[/code]."
msgstr "បង្វិល string ដែលបានបម្លែងទៅជា [code]camelCase[/code]។"

msgid ""
"Converts the string representing a decimal number into a [float]. This method "
"stops on the first non-number character, except the first decimal point "
"([code].[/code]) and the exponent letter ([code]e[/code]). See also [method "
"is_valid_float].\n"
"[codeblock]\n"
"var a = \"12.35\".to_float()  # a is 12.35\n"
"var b = \"1.2.3\".to_float()  # b is 1.2\n"
"var c = \"12xy3\".to_float()  # c is 12.0\n"
"var d = \"1e3\".to_float()    # d is 1000.0\n"
"var e = \"Hello!\".to_float() # e is 0.0\n"
"[/codeblock]"
msgstr ""
"បម្លែង string ដែលតំណាងឱ្យលេខទសភាគទៅជា [float]។ "
"វិធីសាស្រ្តនេះឈប់នៅលើតួអក្សរដែលមិនមែនជាលេខដំបូង លើកលែងតែសញ្ញាចុចទសភាគដំបូង ([code].[/code]) "
"និងអក្សរស្វ័យគុណ ([code]e[/code])។ សូមមើលផងដែរ [method is_valid_float]។\n"
"[codeblock]\n"
"var a = \"12.35\".to_float()  # a គឺ 12.35\n"
"var b = \"1.2.3\".to_float()  # b គឺ 1.2\n"
"var c = \"12xy3\".to_float()  # c គឺ 12.0\n"
"var d = \"1e3\".to_float()    # d គឺ 1000.0\n"
"var e = \"Hello!\".to_float() # e គឺ 0.0\n"
"[/codeblock]"

msgid ""
"Converts the string representing an integer number into an [int]. This method "
"removes any non-number character and stops at the first decimal point ([code]."
"[/code]). See also [method is_valid_int].\n"
"[codeblock]\n"
"var a = \"123\".to_int()    # a is 123\n"
"var b = \"x1y2z3\".to_int() # b is 123\n"
"var c = \"-1.2.3\".to_int() # c is -1\n"
"var d = \"Hello!\".to_int() # d is 0\n"
"[/codeblock]"
msgstr ""
"បម្លែង string ដែលតំណាងឱ្យចំនួនគត់ទៅជា [int]។ វិធីសាស្រ្តនេះដកតួអក្សរដែលមិនមែនជាលេខចេញ "
"ហើយឈប់នៅសញ្ញាចុចទសភាគដំបូង ([code].[/code])។ សូមមើលផងដែរ [method is_valid_int]។\n"
"[codeblock]\n"
"var a = \"123\".to_int()    # a គឺ 123\n"
"var b = \"x1y2z3\".to_int() # b គឺ 123\n"
"var c = \"-1.2.3\".to_int() # c គឺ -1\n"
"var d = \"Hello!\".to_int() # d គឺ 0\n"
"[/codeblock]"

msgid ""
"Returns the string converted to [code]kebab-case[/code].\n"
"[b]Note:[/b] Numbers followed by a [i]single[/i] letter are not separated in "
"the conversion to keep some words (such as \"2D\") together.\n"
"[codeblocks]\n"
"[gdscript]\n"
"\"Node2D\".to_kebab_case()               # Returns \"node-2d\"\n"
"\"2nd place\".to_kebab_case()            # Returns \"2-nd-place\"\n"
"\"Texture3DAssetFolder\".to_kebab_case() # Returns \"texture-3d-asset-"
"folder\"\n"
"[/gdscript]\n"
"[csharp]\n"
"\"Node2D\".ToKebabCase();               // Returns \"node-2d\"\n"
"\"2nd place\".ToKebabCase();            // Returns \"2-nd-place\"\n"
"\"Texture3DAssetFolder\".ToKebabCase(); // Returns \"texture-3d-asset-"
"folder\"\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"បង្វិល string ដែលបានបម្លែងទៅជា [code]kebab-case[/code]។\n"
"[b]ចំណាំ៖[/b] លេខដែលតាមពីក្រោយដោយតួអក្សរ [i]តែមួយ[/i] មិនត្រូវបានបំបែកក្នុងការបម្លែងទេ "
"ដើម្បីរក្សាពាក្យមួយចំនួន (ដូចជា \"2D\") ឱ្យនៅជាប់គ្នា។\n"
"[codeblocks]\n"
"[gdscript]\n"
"\"Node2D\".to_kebab_case()               # បង្វិល \"node-2d\"\n"
"\"2nd place\".to_kebab_case()            # បង្វិល \"2-nd-place\"\n"
"\"Texture3DAssetFolder\".to_kebab_case() # បង្វិល \"texture-3d-asset-folder\"\n"
"[/gdscript]\n"
"[csharp]\n"
"\"Node2D\".ToKebabCase();               // បង្វិល \"node-2d\"\n"
"\"2nd place\".ToKebabCase();            // បង្វិល \"2-nd-place\"\n"
"\"Texture3DAssetFolder\".ToKebabCase(); // បង្វិល \"texture-3d-asset-folder\"\n"
"[/csharp]\n"
"[/codeblocks]"

msgid "Returns the string converted to [code]lowercase[/code]."
msgstr "បង្វិល string ដែលបានបម្លែងទៅជា [code]lowercase[/code] (តួអក្សរតូច)។"

msgid ""
"Converts the string to system multibyte code page encoded [PackedByteArray]. "
"If conversion fails, empty array is returned.\n"
"The values permitted for [param encoding] are system dependent. If [param "
"encoding] is empty string, system default encoding is used.\n"
"- For Windows, see [url=https://learn.microsoft.com/en-us/windows/win32/Intl/"
"code-page-identifiers]Code Page Identifiers[/url] .NET names.\n"
"- For macOS and Linux/BSD, see [code]libiconv[/code] library documentation "
"and [code]iconv --list[/code] for a list of supported encodings."
msgstr ""
"បម្លែង string ទៅជា [PackedByteArray] ដែលបានអ៊ិនកូដទៅជា system multibyte code "
"page។ ប្រសិនបើការបម្លែងបរាជ័យ អារេទទេត្រូវបានបង្វិល។\n"
"តម្លៃដែលអនុញ្ញាតសម្រាប់ [param encoding] គឺអាស្រ័យលើប្រព័ន្ធ។ ប្រសិនបើ [param encoding] "
"គឺជា string ទទេ ការអ៊ិនកូដលំនាំដើមរបស់ប្រព័ន្ធត្រូវបានប្រើ។\n"
"- សម្រាប់ Windows សូមមើលឈ្មោះ .NET នៃ [url=https://learn.microsoft.com/en-us/"
"windows/win32/Intl/code-page-identifiers]Code Page Identifiers[/url]។\n"
"- សម្រាប់ macOS និង Linux/BSD សូមមើលឯកសារបណ្ណាល័យ [code]libiconv[/code] និង "
"[code]iconv --list[/code] សម្រាប់បញ្ជីនៃការអ៊ិនកូដដែលគាំទ្រ។"

msgid "Returns the string converted to [code]PascalCase[/code]."
msgstr "បង្វិល string ដែលបានបម្លែងទៅជា [code]PascalCase[/code]។"

msgid ""
"Returns the string converted to [code]snake_case[/code].\n"
"[b]Note:[/b] Numbers followed by a [i]single[/i] letter are not separated in "
"the conversion to keep some words (such as \"2D\") together.\n"
"[codeblocks]\n"
"[gdscript]\n"
"\"Node2D\".to_snake_case()               # Returns \"node_2d\"\n"
"\"2nd place\".to_snake_case()            # Returns \"2_nd_place\"\n"
"\"Texture3DAssetFolder\".to_snake_case() # Returns "
"\"texture_3d_asset_folder\"\n"
"[/gdscript]\n"
"[csharp]\n"
"\"Node2D\".ToSnakeCase();               // Returns \"node_2d\"\n"
"\"2nd place\".ToSnakeCase();            // Returns \"2_nd_place\"\n"
"\"Texture3DAssetFolder\".ToSnakeCase(); // Returns "
"\"texture_3d_asset_folder\"\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"បង្វិល string ដែលបានបម្លែងទៅជា [code]snake_case[/code]។\n"
"[b]ចំណាំ៖[/b] លេខដែលតាមពីក្រោយដោយតួអក្សរ [i]តែមួយ[/i] មិនត្រូវបានបំបែកក្នុងការបម្លែងទេ "
"ដើម្បីរក្សាពាក្យមួយចំនួន (ដូចជា \"2D\") ឱ្យនៅជាប់គ្នា។\n"
"[codeblocks]\n"
"[gdscript]\n"
"\"Node2D\".to_snake_case()               # បង្វិល \"node_2d\"\n"
"\"2nd place\".to_snake_case()            # បង្វិល \"2_nd_place\"\n"
"\"Texture3DAssetFolder\".to_snake_case() # បង្វិល \"texture_3d_asset_folder\"\n"
"[/gdscript]\n"
"[csharp]\n"
"\"Node2D\".ToSnakeCase();               // បង្វិល \"node_2d\"\n"
"\"2nd place\".ToSnakeCase();            // បង្វិល \"2_nd_place\"\n"
"\"Texture3DAssetFolder\".ToSnakeCase(); // បង្វិល \"texture_3d_asset_folder\"\n"
"[/csharp]\n"
"[/codeblocks]"

msgid "Returns the string converted to [code]UPPERCASE[/code]."
msgstr "បង្វិល string ដែលបានបម្លែងទៅជា [code]UPPERCASE[/code] (តួអក្សរធំ)។"

msgid ""
"Converts the string to a [url=https://en.wikipedia.org/wiki/UTF-8]UTF-8[/url] "
"encoded [PackedByteArray]. This method is slightly slower than [method "
"to_ascii_buffer], but supports all UTF-8 characters. For most cases, prefer "
"using this method. This is the inverse of [method "
"PackedByteArray.get_string_from_utf8]."
msgstr ""
"បម្លែង string ទៅជា [PackedByteArray] ដែលបានអ៊ិនកូដ [url=https://en.wikipedia.org/"
"wiki/UTF-8]UTF-8[/url]។ វិធីសាស្រ្តនេះយឺតជាង [method to_ascii_buffer] បន្តិច "
"ប៉ុន្តែគាំទ្រតួអក្សរ UTF-8 ទាំងអស់។ សម្រាប់ករណីភាគច្រើន សូមប្រើវិធីសាស្រ្តនេះ។ "
"នេះគឺជាប្រតិបត្តិការផ្ទុយពី [method PackedByteArray.get_string_from_utf8]។"

msgid ""
"Converts the string to a [url=https://en.wikipedia.org/wiki/UTF-16]UTF-16[/"
"url] encoded [PackedByteArray]. This is the inverse of [method "
"PackedByteArray.get_string_from_utf16]."
msgstr ""
"បម្លែង string ទៅជា [PackedByteArray] ដែលបានអ៊ិនកូដ [url=https://en.wikipedia.org/"
"wiki/UTF-16]UTF-16[/url]។ នេះគឺជាប្រតិបត្តិការផ្ទុយពី [method "
"PackedByteArray.get_string_from_utf16]។"

msgid ""
"Converts the string to a [url=https://en.wikipedia.org/wiki/UTF-32]UTF-32[/"
"url] encoded [PackedByteArray]. This is the inverse of [method "
"PackedByteArray.get_string_from_utf32]."
msgstr ""
"បម្លែង string ទៅជា [PackedByteArray] ដែលបានអ៊ិនកូដ [url=https://en.wikipedia.org/"
"wiki/UTF-32]UTF-32[/url]។ នេះគឺជាប្រតិបត្តិការផ្ទុយពី [method "
"PackedByteArray.get_string_from_utf32]។"

msgid ""
"Converts the string to a [url=https://en.wikipedia.org/wiki/"
"Wide_character]wide character[/url] ([code]wchar_t[/code], UTF-16 on Windows, "
"UTF-32 on other platforms) encoded [PackedByteArray]. This is the inverse of "
"[method PackedByteArray.get_string_from_wchar]."
msgstr ""
"បម្លែង string ទៅជា [PackedByteArray] ដែលបានអ៊ិនកូដ [url=https://en.wikipedia.org/"
"wiki/Wide_character]wide character[/url] ([code]wchar_t[/code], UTF-16 នៅលើ "
"Windows, UTF-32 នៅលើវេទិកាផ្សេងទៀត)។ នេះគឺជាប្រតិបត្តិការផ្ទុយពី [method "
"PackedByteArray.get_string_from_wchar]។"

msgid ""
"Removes the given [param prefix] from the start of the string, or returns the "
"string unchanged."
msgstr "ដក [param prefix] ដែលបានផ្តល់ឱ្យចេញពីដើម string ឬបង្វិល string ដោយមិនកែប្រែ។"

msgid ""
"Removes the given [param suffix] from the end of the string, or returns the "
"string unchanged."
msgstr "ដក [param suffix] ដែលបានផ្តល់ឱ្យចេញពីចុង string ឬបង្វិល string ដោយមិនកែប្រែ។"

msgid ""
"Returns the character code at position [param at].\n"
"See also [method chr], [method @GDScript.char], and [method @GDScript.ord]."
msgstr ""
"បង្វិលកូដតួអក្សរនៅទីតាំង [param at]។\n"
"សូមមើលផងដែរ [method chr], [method @GDScript.char], និង [method @GDScript.ord]។"

msgid ""
"Decodes the string from its URL-encoded format. This method is meant to "
"properly decode the parameters in a URL when receiving an HTTP request. See "
"also [method uri_encode].\n"
"[codeblocks]\n"
"[gdscript]\n"
"var url = \"$DOCS_URL/?highlight=Godot%20Engine%3%docs\"\n"
"print(url.uri_decode()) # Prints \"$DOCS_URL/?highlight=Godot Engine:docs\"\n"
"[/gdscript]\n"
"[csharp]\n"
"var url = \"$DOCS_URL/?highlight=Godot%20Engine%3%docs\"\n"
"GD.Print(url.URIDecode()) // Prints \"$DOCS_URL/?highlight=Godot "
"Engine:docs\"\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]Note:[/b] This method decodes [code]+[/code] as space."
msgstr ""
"បកប្រែ (Decode) string ចេញពីទម្រង់ដែលស់វាដែលបាន URL-encoded។ "
"វិធីសាស្រ្តនេះមានគោលបំណងបកប្រែប៉ារ៉ាម៉ែត្រនៅក្នុង URL ឱ្យបានត្រឹមត្រូវនៅពេលទទួលសំណើ HTTP។ "
"សូមមើលផងដែរ [method uri_encode]។\n"
"[codeblocks]\n"
"[gdscript]\n"
"var url = \"$DOCS_URL/?highlight=Godot%20Engine%3%docs\"\n"
"print(url.uri_decode()) # បង្ហាញ \"$DOCS_URL/?highlight=Godot Engine:docs\"\n"
"[/gdscript]\n"
"[csharp]\n"
"var url = \"$DOCS_URL/?highlight=Godot%20Engine%3%docs\"\n"
"GD.Print(url.URIDecode()) // បង្ហាញ \"$DOCS_URL/?highlight=Godot "
"Engine:docs\"\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]ចំណាំ៖[/b] វិធីសាស្រ្តនេះបកប្រែ [code]+[/code] ជាចន្លោះ។"

msgid ""
"Encodes the string to URL-friendly format. This method is meant to properly "
"encode the parameters in a URL when sending an HTTP request. See also [method "
"uri_decode].\n"
"[codeblocks]\n"
"[gdscript]\n"
"var prefix = \"$DOCS_URL/?highlight=\"\n"
"var url = prefix + \"Godot Engine:docs\".uri_encode()\n"
"\n"
"print(url) # Prints \"$DOCS_URL/?highlight=Godot%20Engine%3%docs\"\n"
"[/gdscript]\n"
"[csharp]\n"
"var prefix = \"$DOCS_URL/?highlight=\";\n"
"var url = prefix + \"Godot Engine:docs\".URIEncode();\n"
"\n"
"GD.Print(url); // Prints \"$DOCS_URL/?highlight=Godot%20Engine%3%docs\"\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"អ៊ិនកូដ string ទៅជាទម្រង់ដែលងាយស្រួលសម្រាប់ URL។ វិធីសាស្រ្តនេះមានគោលបំណងអ៊ិនកូដប៉ារ៉ាម៉ែត្រនៅក្នុង "
"URL ឱ្យបានត្រឹមត្រូវនៅពេលផ្ញើសំណើ HTTP។ សូមមើលផងដែរ [method uri_decode]។\n"
"[codeblocks]\n"
"[gdscript]\n"
"var prefix = \"$DOCS_URL/?highlight=\"\n"
"var url = prefix + \"Godot Engine:docs\".uri_encode()\n"
"\n"
"print(url) # បង្ហាញ \"$DOCS_URL/?highlight=Godot%20Engine%3%docs\"\n"
"[/gdscript]\n"
"[csharp]\n"
"var prefix = \"$DOCS_URL/?highlight=\";\n"
"var url = prefix + \"Godot Engine:docs\".URIEncode();\n"
"\n"
"GD.Print(url); // បង្ហាញ \"$DOCS_URL/?highlight=Godot%20Engine%3%docs\"\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Decodes the file path from its URL-encoded format. Unlike [method uri_decode] "
"this method leaves [code]+[/code] as is."
msgstr ""
"បកប្រែ file path ចេញពីទម្រង់ URL-encoded របស់វា។ ខុសពី [method uri_decode] "
"វិធីសាស្រ្តនេះទុក [code]+[/code] នៅដដែល។"

msgid ""
"Returns a copy of the string with all characters that are not allowed in "
"[method is_valid_filename] replaced with underscores."
msgstr ""
"បង្វិលច្បាប់ចម្លងនៃ string ដែលតួអក្សរទាំងអស់ដែលមិនត្រូវបានអនុញ្ញាតនៅក្នុង [method "
"is_valid_filename] ត្រូវបានជំនួសដោយសញ្ញា underscore។"

msgid ""
"Returns a copy of the string with all characters that are not allowed in "
"[member Node.name] ([code].[/code] [code]:[/code] [code]@[/code] [code]/[/"
"code] [code]\"[/code] [code]%[/code]) replaced with underscores."
msgstr ""
"បង្វិលច្បាប់ចម្លងនៃ string ដែលតួអក្សរទាំងអស់ដែលមិនត្រូវបានអនុញ្ញាតនៅក្នុង [member Node.name] "
"([code].[/code] [code]:[/code] [code]@[/code] [code]/[/code] [code]\"[/code] "
"[code]%[/code]) ត្រូវបានជំនួសដោយសញ្ញា underscore។"

msgid ""
"Returns a copy of the string with special characters escaped using the XML "
"standard. If [param escape_quotes] is [code]true[/code], the single quote "
"([code]'[/code]) and double quote ([code]\"[/code]) characters are also "
"escaped."
msgstr ""
"បង្វិលច្បាប់ចម្លងនៃ string ដែលតួអក្សរពិសេសត្រូវបាន escape ដោយប្រើស្តង់ដារ XML។ ប្រសិនបើ "
"[param escape_quotes] គឺ [code]true[/code] តួអក្សរ single quote ([code]'[/code]) "
"និង double quote ([code]\"[/code]) ក៏ត្រូវបាន escape ផងដែរ។"

msgid ""
"Returns a copy of the string with escaped characters replaced by their "
"meanings according to the XML standard."
msgstr ""
"បង្វិលច្បាប់ចម្លងនៃ string ដែលតួអក្សរ escaped ត្រូវបានជំនួសដោយអត្ថន័យរបស់ពួកវាទៅតាមស្តង់ដារ "
"XML។"

msgid ""
"Returns [code]true[/code] if both strings do not contain the same sequence of "
"characters."
msgstr "បង្វិល [code]true[/code] ប្រសិនបើ strings ទាំងពីរមិនមានផ្ទុកលំដាប់តួអក្សរដូចគ្នាទេ។"

msgid ""
"Returns [code]true[/code] if this [String] is not equivalent to the given "
"[StringName]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ [String] នេះមិនស្មើនឹង [StringName] ដែលបានផ្តល់ឱ្យទេ។"

msgid ""
"Formats the [String], replacing the placeholders with one or more parameters. "
"To pass multiple parameters, [param right] needs to be an [Array].\n"
"[codeblock]\n"
"print(\"I caught %d fishes!\" % 2) # Prints \"I caught 2 fishes!\"\n"
"\n"
"var my_message = \"Travelling to %s, at %2.2f km/h.\"\n"
"var location = \"Deep Valley\"\n"
"var speed = 40.3485\n"
"print(my_message % [location, speed]) # Prints \"Travelling to Deep Valley, "
"at 40.35 km/h.\"\n"
"[/codeblock]\n"
"For more information, see the [url=$DOCS_URL/tutorials/scripting/gdscript/"
"gdscript_format_string.html]GDScript format strings[/url] tutorial.\n"
"[b]Note:[/b] In C#, this operator is not available. Instead, see [url=https://"
"learn.microsoft.com/en-us/dotnet/csharp/language-reference/tokens/"
"interpolated]how to interpolate strings with \"$\"[/url]."
msgstr ""
"ធ្វើទម្រង់ [String] ដោយជំនួស placeholders ជាមួយប៉ារ៉ាម៉ែត្រមួយ ឬច្រើន។ "
"ដើម្បីបញ្ជូនប៉ារ៉ាម៉ែត្រច្រើន [param right] ត្រូវតែជា [Array]។\n"
"[codeblock]\n"
"print(\"I caught %d fishes!\" % 2) # បង្ហាញ \"I caught 2 fishes!\"\n"
"\n"
"var my_message = \"Travelling to %s, at %2.2f km/h.\"\n"
"var location = \"Deep Valley\"\n"
"var speed = 40.3485\n"
"print(my_message % [location, speed]) # បង្ហាញ \"Travelling to Deep Valley, at "
"40.35 km/h.\"\n"
"[/codeblock]\n"
"សម្រាប់ព័ត៌មានបន្ថែម សូមមើលការបង្រៀន [url=$DOCS_URL/tutorials/scripting/gdscript/"
"gdscript_format_string.html]ទម្រង់ strings របស់ GDScript[/url]។\n"
"[b]ចំណាំ៖[/b] នៅក្នុង C#, ប្រតិបត្តិករនេះមិនមានទេ។ ជំនួសមក សូមមើល [url=https://"
"learn.microsoft.com/en-us/dotnet/csharp/language-reference/tokens/"
"interpolated]របៀប interpolate strings ដោយប្រើ \"$\"[/url]។"

msgid ""
"Appends [param right] at the end of this [String], also known as a string "
"concatenation."
msgstr ""
"បន្ថែម [param right] នៅចុងបញ្ចប់នៃ [String] នេះ ដែលត្រូវបានគេស្គាល់ផងដែរថាជាការតភ្ជាប់ "
"string (string concatenation)។"

msgid ""
"Appends [param right] at the end of this [String], returning a [String]. This "
"is also known as a string concatenation."
msgstr ""
"បន្ថែម [param right] នៅចុងបញ្ចប់នៃ [String] នេះ ដោយបង្វិលជា [String]។ "
"នេះត្រូវបានគេស្គាល់ផងដែរថាជាការតភ្ជាប់ string។"

msgid ""
"Returns [code]true[/code] if the left [String] comes before [param right] in "
"[url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode order[/"
"url], which roughly matches the alphabetical order. Useful for sorting."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ [String] ខាងឆ្វេងមកមុន [param right] នៅក្នុង "
"[url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]លំដាប់ Unicode[/"
"url] ដែលប្រហាក់ប្រហែលនឹងលំដាប់អក្ខរក្រម។ មានប្រយោជន៍សម្រាប់ការរៀបចំលំដាប់។"

msgid ""
"Returns [code]true[/code] if the left [String] comes before [param right] in "
"[url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode order[/"
"url], which roughly matches the alphabetical order, or if both are equal."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ [String] ខាងឆ្វេងមកមុន [param right] នៅក្នុង "
"[url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]លំដាប់ Unicode[/"
"url] ដែលប្រហាក់ប្រហែលនឹងលំដាប់អក្ខរក្រម ឬប្រសិនបើទាំងពីរស្មើគ្នា។"

msgid ""
"Returns [code]true[/code] if both strings contain the same sequence of "
"characters."
msgstr "បង្វិល [code]true[/code] ប្រសិនបើ strings ទាំងពីរមានផ្ទុកលំដាប់តួអក្សរដូចគ្នា។"

msgid ""
"Returns [code]true[/code] if this [String] is equivalent to the given "
"[StringName]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ [String] នេះស្មើនឹង [StringName] ដែលបានផ្តល់ឱ្យ។"

msgid ""
"Returns [code]true[/code] if the left [String] comes after [param right] in "
"[url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode order[/"
"url], which roughly matches the alphabetical order. Useful for sorting."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ [String] ខាងឆ្វេងនៅក្រោយ [param right] នៅក្នុង "
"[url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]លំដាប់ Unicode[/"
"url] ដែលប្រហាក់ប្រហែលនឹងលំដាប់អក្ខរក្រម។ មានប្រយោជន៍សម្រាប់ការរៀបចំលំដាប់។"

msgid ""
"Returns [code]true[/code] if the left [String] comes after [param right] in "
"[url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode order[/"
"url], which roughly matches the alphabetical order, or if both are equal."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ [String] ខាងឆ្វេងនៅក្រោយ [param right] នៅក្នុង "
"[url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]លំដាប់ Unicode[/"
"url] ដែលប្រហាក់ប្រហែលនឹងលំដាប់អក្ខរក្រម ឬប្រសិនបើទាំងពីរស្មើគ្នា។"

msgid ""
"Returns a new [String] that only contains the character at [param index]. "
"Indices start from [code]0[/code]. If [param index] is greater or equal to "
"[code]0[/code], the character is fetched starting from the beginning of the "
"string. If [param index] is a negative value, it is fetched starting from the "
"end. Accessing a string out-of-bounds will cause a run-time error, pausing "
"the project execution if run from the editor."
msgstr ""
"បង្វិល [String] ថ្មីដែលមានផ្ទុកតែតួអក្សរនៅ [param index]។ Indices ចាប់ផ្តើមពី [code]0[/"
"code]។ ប្រសិនបើ [param index] ធំជាង ឬស្មើ [code]0[/code] "
"តួអក្សរត្រូវបានយកដោយចាប់ផ្តើមពីដើម string។ ប្រសិនបើ [param index] ជាតម្លៃអវិជ្ជមាន "
"វាត្រូវបានយកដោយចាប់ផ្តើមពីចុង។ ការចូលប្រើ string ហួសដែនកំណត់ (out-of-bounds) "
"នឹងបណ្តាលឱ្យមានកំហុសពេលដំណើរការ (run-time error) ដោយផ្អាកការដំណើរការ project "
"ប្រសិនបើដំណើរការពី editor។"

msgid "A built-in type for unique strings."
msgstr "ប្រភេទដែលមានស្រាប់ (built-in type) សម្រាប់ strings តែមួយគត់ (unique strings)។"

msgid ""
"[StringName]s are immutable strings designed for general-purpose "
"representation of unique names (also called \"string interning\"). Two "
"[StringName]s with the same value are the same object. Comparing them is "
"extremely fast compared to regular [String]s.\n"
"You will usually pass a [String] to methods expecting a [StringName] and it "
"will be automatically converted (often at compile time), but in rare cases "
"you can construct a [StringName] ahead of time with the [StringName] "
"constructor or, in GDScript, the literal syntax [code]&\"example\"[/code]. "
"Manually constructing a [StringName] allows you to control when the "
"conversion from [String] occurs or to use the literal and prevent conversions "
"entirely.\n"
"See also [NodePath], which is a similar concept specifically designed to "
"store pre-parsed scene tree paths.\n"
"All of [String]'s methods are available in this class too. They convert the "
"[StringName] into a string, and they also return a string. This is highly "
"inefficient and should only be used if the string is desired.\n"
"[b]Note:[/b] In C#, an explicit conversion to [code]System.String[/code] is "
"required to use the methods listed on this page. Use the [code]ToString()[/"
"code] method to cast a [StringName] to a string, and then use the equivalent "
"methods in [code]System.String[/code] or [code]StringExtensions[/code].\n"
"[b]Note:[/b] In a boolean context, a [StringName] will evaluate to "
"[code]false[/code] if it is empty ([code]StringName(\"\")[/code]). Otherwise, "
"a [StringName] will always evaluate to [code]true[/code]."
msgstr ""
"[StringName]s គឺជា immutable strings "
"ដែលរចនាឡើងសម្រាប់ការតំណាងឈ្មោះតែមួយគត់ក្នុងគោលបំណងទូទៅ (ហៅផងដែរថា \"string "
"interning\")។ [StringName]s ពីរដែលមានតម្លៃដូចគ្នា គឺជា object តែមួយ។ "
"ការប្រៀបធៀបពួកវាគឺលឿនខ្លាំងបើធៀបនឹង [String]s ធម្មតា។\n"
"ជាធម្មតាអ្នកនឹងបញ្ជូន [String] ទៅកាន់ methods ដែលរំពឹងទុក [StringName] "
"ហើយវានឹងត្រូវបានបម្លែងដោយស្វ័យប្រវត្តិ (ជាញឹកញាប់នៅពេល compile) ប៉ុន្តែក្នុងករណីកម្រ "
"អ្នកអាចបង្កើត [StringName] ជាមុនដោយប្រើ [StringName] constructor ឬនៅក្នុង GDScript "
"វាក្យសម្ព័ន្ធ [code]&\"example\"[/code]។ ការបង្កើត [StringName] "
"ដោយដៃអនុញ្ញាតឱ្យអ្នកគ្រប់គ្រងពេលដែលការបម្លែងពី [String] កើតឡើង "
"ឬប្រើវាក្យសម្ព័ន្ធដើម្បីការពារការបម្លែងទាំងស្រុង។\n"
"សូមមើលផងដែរ [NodePath] ដែលគឺជាគំនិតស្រដៀងគ្នាដែលរចនាឡើងជាពិសេសសម្រាប់រក្សាទុក scene tree "
"paths ដែលបាន parse ជាមុន។\n"
"វិធីសាស្រ្តរបស់ [String] ទាំងអស់ក៏មាននៅក្នុង class នេះផងដែរ។ ពួកវាបម្លែង [StringName] "
"ទៅជា string ហើយពួកវាក៏បង្វិល string ផងដែរ។ នេះគឺមិនមានប្រសិទ្ធភាពខ្លាំងណាស់ "
"ហើយគួរប្រើតែនៅពេលដែលចង់បាន string ប៉ុណ្ណោះ។\n"
"[b]ចំណាំ៖[/b] នៅក្នុង C#, ការបម្លែងដោយច្បាស់លាស់ទៅជា [code]System.String[/code] "
"គឺចាំបាច់ដើម្បីប្រើវិធីសាស្រ្តដែលបានរាយនៅលើទំព័រនេះ។ ប្រើវិធីសាស្រ្ត [code]ToString()[/code] "
"ដើម្បី cast [StringName] ទៅជា string រួចប្រើវិធីសាស្រ្តដែលស្មើគ្នានៅក្នុង "
"[code]System.String[/code] ឬ [code]StringExtensions[/code]។\n"
"[b]ចំណាំ៖[/b] នៅក្នុងបរិបទ boolean, [StringName] នឹងវាយតម្លៃទៅជា [code]false[/code] "
"ប្រសិនបើវាទទេ ([code]StringName(\"\")[/code])។ បើពុំនោះទេ [StringName] "
"នឹងវាយតម្លៃទៅជា [code]true[/code] ជានិច្ច។"

msgid "Constructs an empty [StringName]."
msgstr "បង្កើត [StringName] ទទេ។"

msgid "Constructs a [StringName] as a copy of the given [StringName]."
msgstr "បង្កើត [StringName] ជាច្បាប់ចម្លងនៃ [StringName] ដែលបានផ្តល់ឱ្យ។"

msgid ""
"Creates a new [StringName] from the given [String]. In GDScript, "
"[code]StringName(\"example\")[/code] is equivalent to [code]&\"example\"[/"
"code]."
msgstr ""
"បង្កើត [StringName] ថ្មីពី [String] ដែលបានផ្តល់ឱ្យ។ នៅក្នុង GDScript, "
"[code]StringName(\"example\")[/code] គឺស្មើនឹង [code]&\"example\"[/code]។"

msgid ""
"Changes the appearance of the string: replaces underscores ([code]_[/code]) "
"with spaces, adds spaces before uppercase letters in the middle of a word, "
"converts all letters to lowercase, then converts the first one and each one "
"following a space to uppercase.\n"
"[codeblocks]\n"
"[gdscript]\n"
"\"move_local_x\".capitalize()   # Returns \"Move Local X\"\n"
"\"sceneFile_path\".capitalize() # Returns \"Scene File Path\"\n"
"\"2D, FPS, PNG\".capitalize()   # Returns \"2d, Fps, Png\"\n"
"[/gdscript]\n"
"[csharp]\n"
"\"move_local_x\".Capitalize();   // Returns \"Move Local X\"\n"
"\"sceneFile_path\".Capitalize(); // Returns \"Scene File Path\"\n"
"\"2D, FPS, PNG\".Capitalize();   // Returns \"2d, Fps, Png\"\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"ផ្លាស់ប្តូររូបរាងរបស់ string៖ ជំនួសសញ្ញា underscore ([code]_[/code]) ដោយចន្លោះ "
"បន្ថែមចន្លោះមុនតួអក្សរធំនៅកណ្តាលពាក្យ បម្លែងតួអក្សរទាំងអស់ទៅជាតួអក្សរតូច រួចបម្លែងតួអក្សរដំបូង "
"និងតួអក្សរដែលនៅបន្ទាប់ពីចន្លោះនីមួយៗទៅជាតួអក្សរធំ។\n"
"[codeblocks]\n"
"[gdscript]\n"
"\"move_local_x\".capitalize()   # បង្វិល \"Move Local X\"\n"
"\"sceneFile_path\".capitalize() # បង្វិល \"Scene File Path\"\n"
"\"2D, FPS, PNG\".capitalize()   # បង្វិល \"2d, Fps, Png\"\n"
"[/gdscript]\n"
"[csharp]\n"
"\"move_local_x\".Capitalize();   // បង្វិល \"Move Local X\"\n"
"\"sceneFile_path\".Capitalize(); // បង្វិល \"Scene File Path\"\n"
"\"2D, FPS, PNG\".Capitalize();   // បង្វិល \"2d, Fps, Png\"\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Performs a case-sensitive comparison to another string. Returns [code]-1[/"
"code] if less than, [code]1[/code] if greater than, or [code]0[/code] if "
"equal. \"Less than\" and \"greater than\" are determined by the [url=https://"
"en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode code points[/url] of "
"each string, which roughly matches the alphabetical order.\n"
"With different string lengths, returns [code]1[/code] if this string is "
"longer than the [param to] string, or [code]-1[/code] if shorter. Note that "
"the length of empty strings is [i]always[/i] [code]0[/code].\n"
"To get a [bool] result from a string comparison, use the [code]==[/code] "
"operator instead. See also [method nocasecmp_to], [method filecasecmp_to], "
"and [method naturalcasecmp_to]."
msgstr ""
"ធ្វើការប្រៀបធៀបដោយបែងចែកតួអក្សរធំតូច (case-sensitive) ទៅនឹង string មួយទៀត។ បង្វិល "
"[code]-1[/code] ប្រសិនបើតូចជាង, [code]1[/code] ប្រសិនបើធំជាង, ឬ [code]0[/code] "
"ប្រសិនបើស្មើ។ \"តូចជាង\" និង \"ធំជាង\" ត្រូវបានកំណត់ដោយ [url=https://en.wikipedia.org/"
"wiki/List_of_Unicode_characters]Unicode code points[/url] នៃ string នីមួយៗ "
"ដែលប្រហាក់ប្រហែលនឹងលំដាប់អក្ខរក្រម។\n"
"ជាមួយនឹងប្រវែង string ខុសគ្នា បង្វិល [code]1[/code] ប្រសិនបើ string នេះវែងជាង string "
"[param to] ឬ [code]-1[/code] ប្រសិនបើខ្លីជាង។ សូមចំណាំថាប្រវែងនៃ string ទទេគឺ "
"[i]តែងតែ[/i] [code]0[/code]។\n"
"ដើម្បីទទួលបានលទ្ធផល [bool] ពីការប្រៀបធៀប string សូមប្រើប្រតិបត្តិករ [code]==[/code] "
"ជំនួសវិញ។ សូមមើលផងដែរ [method nocasecmp_to], [method filecasecmp_to], និង [method "
"naturalcasecmp_to]។"

msgid ""
"Splits the string using a [param delimiter] and returns the substring at "
"index [param slice]. Returns the original string if [param delimiter] does "
"not occur in the string. Returns an empty string if the [param slice] does "
"not exist.\n"
"This is faster than [method split], if you only need one substring.\n"
"[codeblock]\n"
"print(\"i/am/example/hi\".get_slice(\"/\", 2)) # Prints \"example\"\n"
"[/codeblock]"
msgstr ""
"បំបែក string ដោយប្រើ [param delimiter] ហើយបង្វិល substring នៅ index [param "
"slice]។ បង្វិល string ដើម ប្រសិនបើ [param delimiter] មិនមាននៅក្នុង string។ បង្វិល "
"string ទទេ ប្រសិនបើ [param slice] មិនមាន។\n"
"វិធីនេះលឿនជាង [method split] ប្រសិនបើអ្នកត្រូវការតែមួយ substring ប៉ុណ្ណោះ។\n"
"[codeblock]\n"
"print(\"i/am/example/hi\".get_slice(\"/\", 2)) # បង្ហាញ \"example\"\n"
"[/codeblock]"

msgid ""
"Returns the total number of slices when the string is split with the given "
"[param delimiter] (see [method split])."
msgstr ""
"បង្វិលចំនួន slices សរុបនៅពេលដែល string ត្រូវបានបំបែកដោយ [param delimiter] ដែលបានផ្តល់ឱ្យ "
"(សូមមើល [method split])។"

msgid ""
"Splits the string using a Unicode character with code [param delimiter] and "
"returns the substring at index [param slice]. Returns an empty string if the "
"[param slice] does not exist.\n"
"This is faster than [method split], if you only need one substring."
msgstr ""
"បំបែក string ដោយប្រើតួអក្សរ Unicode ដែលមានកូដ [param delimiter] ហើយបង្វិល substring "
"នៅ index [param slice]។ បង្វិល string ទទេ ប្រសិនបើ [param slice] មិនមាន។\n"
"វិធីនេះលឿនជាង [method split] ប្រសិនបើអ្នកត្រូវការតែមួយ substring ប៉ុណ្ណោះ។"

msgid ""
"Performs a [b]case-sensitive[/b], [i]natural order[/i] comparison to another "
"string. Returns [code]-1[/code] if less than, [code]1[/code] if greater than, "
"or [code]0[/code] if equal. \"Less than\" or \"greater than\" are determined "
"by the [url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode "
"code points[/url] of each string, which roughly matches the alphabetical "
"order.\n"
"When used for sorting, natural order comparison orders sequences of numbers "
"by the combined value of each digit as is often expected, instead of the "
"single digit's value. A sorted sequence of numbered strings will be [code]"
"[\"1\", \"2\", \"3\", ...][/code], not [code][\"1\", \"10\", \"2\", "
"\"3\", ...][/code].\n"
"With different string lengths, returns [code]1[/code] if this string is "
"longer than the [param to] string, or [code]-1[/code] if shorter. Note that "
"the length of empty strings is [i]always[/i] [code]0[/code].\n"
"To get a [bool] result from a string comparison, use the [code]==[/code] "
"operator instead. See also [method naturalnocasecmp_to], [method "
"filecasecmp_to], and [method nocasecmp_to]."
msgstr ""
"ធ្វើការប្រៀបធៀប [b]បែងចែកតួអក្សរធំតូច[/b], [i]តាមលំដាប់ធម្មជាតិ[/i] ទៅនឹង string មួយទៀត។ "
"បង្វិល [code]-1[/code] ប្រសិនបើតូចជាង, [code]1[/code] ប្រសិនបើធំជាង, ឬ [code]0[/code] "
"ប្រសិនបើស្មើ។ \"តូចជាង\" ឬ \"ធំជាង\" ត្រូវបានកំណត់ដោយ [url=https://en.wikipedia.org/"
"wiki/List_of_Unicode_characters]Unicode code points[/url] នៃ string នីមួយៗ "
"ដែលប្រហាក់ប្រហែលនឹងលំដាប់អក្ខរក្រម។\n"
"នៅពេលប្រើសម្រាប់ការរៀបចំលំដាប់ ការប្រៀបធៀបតាមលំដាប់ធម្មជាតិ "
"រៀបចំលំដាប់លេខតាមតម្លៃរួមបញ្ចូលគ្នានៃលេខនីមួយៗ ដូចដែលគេរំពឹងទុកជាញឹកញាប់ ជំនួសឱ្យតម្លៃលេខខ្ទង់តែមួយ។ "
"លំដាប់ដែលបានរៀបចំនៃ strings ដែលមានលេខនឹងជា [code][\"1\", \"2\", \"3\", ...][/"
"code] មិនមែន [code][\"1\", \"10\", \"2\", \"3\", ...][/code] ទេ។\n"
"ជាមួយនឹងប្រវែង string ខុសគ្នា បង្វិល [code]1[/code] ប្រសិនបើ string នេះវែងជាង string "
"[param to] ឬ [code]-1[/code] ប្រសិនបើខ្លីជាង។ សូមចំណាំថាប្រវែងនៃ string ទទេគឺ "
"[i]តែងតែ[/i] [code]0[/code]។\n"
"ដើម្បីទទួលបានលទ្ធផល [bool] ពីការប្រៀបធៀប string សូមប្រើប្រតិបត្តិករ [code]==[/code] "
"ជំនួសវិញ។ សូមមើលផងដែរ [method naturalnocasecmp_to], [method filecasecmp_to], និង "
"[method nocasecmp_to]។"

msgid ""
"Performs a [b]case-insensitive[/b], [i]natural order[/i] comparison to "
"another string. Returns [code]-1[/code] if less than, [code]1[/code] if "
"greater than, or [code]0[/code] if equal. \"Less than\" or \"greater than\" "
"are determined by the [url=https://en.wikipedia.org/wiki/"
"List_of_Unicode_characters]Unicode code points[/url] of each string, which "
"roughly matches the alphabetical order. Internally, lowercase characters are "
"converted to uppercase for the comparison.\n"
"When used for sorting, natural order comparison orders sequences of numbers "
"by the combined value of each digit as is often expected, instead of the "
"single digit's value. A sorted sequence of numbered strings will be [code]"
"[\"1\", \"2\", \"3\", ...][/code], not [code][\"1\", \"10\", \"2\", "
"\"3\", ...][/code].\n"
"With different string lengths, returns [code]1[/code] if this string is "
"longer than the [param to] string, or [code]-1[/code] if shorter. Note that "
"the length of empty strings is [i]always[/i] [code]0[/code].\n"
"To get a [bool] result from a string comparison, use the [code]==[/code] "
"operator instead. See also [method naturalcasecmp_to], [method "
"filenocasecmp_to], and [method casecmp_to]."
msgstr ""
"ធ្វើការប្រៀបធៀប [b]មិនបែងចែកតួអក្សរធំតូច[/b], [i]តាមលំដាប់ធម្មជាតិ[/i] ទៅនឹង string "
"មួយទៀត។ បង្វិល [code]-1[/code] ប្រសិនបើតូចជាង, [code]1[/code] ប្រសិនបើធំជាង, ឬ "
"[code]0[/code] ប្រសិនបើស្មើ។ \"តូចជាង\" ឬ \"ធំជាង\" ត្រូវបានកំណត់ដោយ [url=https://"
"en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode code points[/url] នៃ "
"string នីមួយៗ ដែលប្រហាក់ប្រហែលនឹងលំដាប់អក្ខរក្រម។ នៅខាងក្នុង "
"តួអក្សរតូចត្រូវបានបម្លែងទៅជាតួអក្សរធំសម្រាប់ការប្រៀបធៀប។\n"
"នៅពេលប្រើសម្រាប់ការរៀបចំលំដាប់ ការប្រៀបធៀបតាមលំដាប់ធម្មជាតិ "
"រៀបចំលំដាប់លេខតាមតម្លៃរួមបញ្ចូលគ្នានៃលេខនីមួយៗ ដូចដែលគេរំពឹងទុកជាញឹកញាប់ ជំនួសឱ្យតម្លៃលេខខ្ទង់តែមួយ។ "
"លំដាប់ដែលបានរៀបចំនៃ strings ដែលមានលេខនឹងជា [code][\"1\", \"2\", \"3\", ...][/"
"code] មិនមែន [code][\"1\", \"10\", \"2\", \"3\", ...][/code] ទេ។\n"
"ជាមួយនឹងប្រវែង string ខុសគ្នា បង្វិល [code]1[/code] ប្រសិនបើ string នេះវែងជាង string "
"[param to] ឬ [code]-1[/code] ប្រសិនបើខ្លីជាង។ សូមចំណាំថាប្រវែងនៃ string ទទេគឺ "
"[i]តែងតែ[/i] [code]0[/code]។\n"
"ដើម្បីទទួលបានលទ្ធផល [bool] ពីការប្រៀបធៀប string សូមប្រើប្រតិបត្តិករ [code]==[/code] "
"ជំនួសវិញ។ សូមមើលផងដែរ [method naturalcasecmp_to], [method filenocasecmp_to], និង "
"[method casecmp_to]។"

msgid ""
"Performs a [b]case-insensitive[/b] comparison to another string. Returns "
"[code]-1[/code] if less than, [code]1[/code] if greater than, or [code]0[/"
"code] if equal. \"Less than\" or \"greater than\" are determined by the "
"[url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode code "
"points[/url] of each string, which roughly matches the alphabetical order. "
"Internally, lowercase characters are converted to uppercase for the "
"comparison.\n"
"With different string lengths, returns [code]1[/code] if this string is "
"longer than the [param to] string, or [code]-1[/code] if shorter. Note that "
"the length of empty strings is [i]always[/i] [code]0[/code].\n"
"To get a [bool] result from a string comparison, use the [code]==[/code] "
"operator instead. See also [method casecmp_to], [method filenocasecmp_to], "
"and [method naturalnocasecmp_to]."
msgstr ""
"ធ្វើការប្រៀបធៀប [b]មិនបែងចែកតួអក្សរធំតូច[/b] ទៅនឹង string មួយទៀត។ បង្វិល [code]-1[/code] "
"ប្រសិនបើតូចជាង, [code]1[/code] ប្រសិនបើធំជាង, ឬ [code]0[/code] ប្រសិនបើស្មើ។ \"តូចជាង\" "
"ឬ \"ធំជាង\" ត្រូវបានកំណត់ដោយ [url=https://en.wikipedia.org/wiki/"
"List_of_Unicode_characters]Unicode code points[/url] នៃ string នីមួយៗ "
"ដែលប្រហាក់ប្រហែលនឹងលំដាប់អក្ខរក្រម។ នៅខាងក្នុង "
"តួអក្សរតូចត្រូវបានបម្លែងទៅជាតួអក្សរធំសម្រាប់ការប្រៀបធៀប។\n"
"ជាមួយនឹងប្រវែង string ខុសគ្នា បង្វិល [code]1[/code] ប្រសិនបើ string នេះវែងជាង string "
"[param to] ឬ [code]-1[/code] ប្រសិនបើខ្លីជាង។ សូមចំណាំថាប្រវែងនៃ string ទទេគឺ "
"[i]តែងតែ[/i] [code]0[/code]។\n"
"ដើម្បីទទួលបានលទ្ធផល [bool] ពីការប្រៀបធៀប string សូមប្រើប្រតិបត្តិករ [code]==[/code] "
"ជំនួសវិញ។ សូមមើលផងដែរ [method casecmp_to], [method filenocasecmp_to], និង [method "
"naturalnocasecmp_to]។"

msgid ""
"Returns the character code at position [param at].\n"
"See also [method String.chr], [method @GDScript.char], and [method "
"@GDScript.ord]."
msgstr ""
"បង្វិលកូដតួអក្សរនៅទីតាំង [param at]។\n"
"សូមមើលផងដែរ [method String.chr], [method @GDScript.char], និង [method "
"@GDScript.ord]។"

msgid ""
"Returns [code]true[/code] if this [StringName] is not equivalent to the given "
"[String]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ [StringName] នេះមិនស្មើនឹង [String] ដែលបានផ្តល់ឱ្យទេ។"

msgid ""
"Returns [code]true[/code] if the [StringName] and [param right] do not refer "
"to the same name. Comparisons between [StringName]s are much faster than "
"regular [String] comparisons."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ [StringName] និង [param right] "
"មិនសំដៅលើឈ្មោះដូចគ្នាទេ។ ការប្រៀបធៀបរវាង [StringName]s គឺលឿនជាងការប្រៀបធៀប [String] "
"ធម្មតាខ្លាំងណាស់។"

msgid ""
"Formats the [StringName], replacing the placeholders with one or more "
"parameters, returning a [String]. To pass multiple parameters, [param right] "
"needs to be an [Array].\n"
"For more information, see the [url=$DOCS_URL/tutorials/scripting/gdscript/"
"gdscript_format_string.html]GDScript format strings[/url] tutorial.\n"
"[b]Note:[/b] In C#, this operator is not available. Instead, see [url=https://"
"learn.microsoft.com/en-us/dotnet/csharp/language-reference/tokens/"
"interpolated]how to interpolate strings with \"$\"[/url]."
msgstr ""
"ធ្វើទម្រង់ [StringName] ដោយជំនួស placeholders ជាមួយប៉ារ៉ាម៉ែត្រមួយ ឬច្រើន ដោយបង្វិលជា "
"[String]។ ដើម្បីបញ្ជូនប៉ារ៉ាម៉ែត្រច្រើន [param right] ត្រូវតែជា [Array]។\n"
"សម្រាប់ព័ត៌មានបន្ថែម សូមមើលការបង្រៀន [url=$DOCS_URL/tutorials/scripting/gdscript/"
"gdscript_format_string.html]ទម្រង់ strings របស់ GDScript[/url]។\n"
"[b]ចំណាំ៖[/b] នៅក្នុង C#, ប្រតិបត្តិករនេះមិនមានទេ។ ជំនួសមក សូមមើល [url=https://"
"learn.microsoft.com/en-us/dotnet/csharp/language-reference/tokens/"
"interpolated]របៀប interpolate strings ដោយប្រើ \"$\"[/url]។"

msgid ""
"Appends [param right] at the end of this [StringName], returning a [String]. "
"This is also known as a string concatenation."
msgstr ""
"បន្ថែម [param right] នៅចុងបញ្ចប់នៃ [StringName] នេះ ដោយបង្វិលជា [String]។ "
"នេះត្រូវបានគេស្គាល់ផងដែរថាជាការតភ្ជាប់ string។"

msgid ""
"Returns [code]true[/code] if the left [StringName]'s pointer comes before "
"[param right]. Note that this will not match their [url=https://"
"en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode order[/url]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ pointer របស់ [StringName] ខាងឆ្វេងមកមុន [param "
"right]។ សូមចំណាំថានេះនឹងមិនត្រូវនឹង [url=https://en.wikipedia.org/wiki/"
"List_of_Unicode_characters]លំដាប់ Unicode[/url] របស់ពួកវាទេ។"

msgid ""
"Returns [code]true[/code] if the left [StringName]'s pointer comes before "
"[param right] or if they are the same. Note that this will not match their "
"[url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode order[/"
"url]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ pointer របស់ [StringName] ខាងឆ្វេងមកមុន [param "
"right] ឬប្រសិនបើពួកវាដូចគ្នា។ សូមចំណាំថានេះនឹងមិនត្រូវនឹង [url=https://en.wikipedia.org/"
"wiki/List_of_Unicode_characters]លំដាប់ Unicode[/url] របស់ពួកវាទេ។"

msgid ""
"Returns [code]true[/code] if this [StringName] is equivalent to the given "
"[String]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ [StringName] នេះស្មើនឹង [String] ដែលបានផ្តល់ឱ្យ។"

msgid ""
"Returns [code]true[/code] if the [StringName] and [param right] refer to the "
"same name. Comparisons between [StringName]s are much faster than regular "
"[String] comparisons."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ [StringName] និង [param right] សំដៅលើឈ្មោះដូចគ្នា។ "
"ការប្រៀបធៀបរវាង [StringName]s គឺលឿនជាងការប្រៀបធៀប [String] ធម្មតាខ្លាំងណាស់។"

msgid ""
"Returns [code]true[/code] if the left [StringName]'s pointer comes after "
"[param right]. Note that this will not match their [url=https://"
"en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode order[/url]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ pointer របស់ [StringName] ខាងឆ្វេងនៅក្រោយ [param "
"right]។ សូមចំណាំថានេះនឹងមិនត្រូវនឹង [url=https://en.wikipedia.org/wiki/"
"List_of_Unicode_characters]លំដាប់ Unicode[/url] របស់ពួកវាទេ។"

msgid ""
"Returns [code]true[/code] if the left [StringName]'s pointer comes after "
"[param right] or if they are the same. Note that this will not match their "
"[url=https://en.wikipedia.org/wiki/List_of_Unicode_characters]Unicode order[/"
"url]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ pointer របស់ [StringName] ខាងឆ្វេងនៅក្រោយ [param "
"right] ឬប្រសិនបើពួកវាដូចគ្នា។ សូមចំណាំថានេះនឹងមិនត្រូវនឹង [url=https://en.wikipedia.org/"
"wiki/List_of_Unicode_characters]លំដាប់ Unicode[/url] របស់ពួកវាទេ។"

msgid "Abstract base class for defining stylized boxes for UI elements."
msgstr ""
"Abstract base class សម្រាប់កំណត់ប្រអប់ដែលមានរចនាប័ទ្ម (stylized boxes) សម្រាប់ធាតុ UI។"

msgid ""
"[StyleBox] is an abstract base class for drawing stylized boxes for UI "
"elements. It is used for panels, buttons, [LineEdit] backgrounds, [Tree] "
"backgrounds, etc. and also for testing a transparency mask for pointer "
"signals. If mask test fails on a [StyleBox] assigned as mask to a control, "
"clicks and motion signals will go through it to the one below.\n"
"[b]Note:[/b] For control nodes that have [i]Theme Properties[/i], the "
"[code]focus[/code] [StyleBox] is displayed over the [code]normal[/code], "
"[code]hover[/code] or [code]pressed[/code] [StyleBox]. This makes the "
"[code]focus[/code] [StyleBox] more reusable across different nodes."
msgstr ""
"[StyleBox] គឺជា abstract base class សម្រាប់គូរប្រអប់ដែលមានរចនាប័ទ្មសម្រាប់ធាតុ UI។ "
"វាត្រូវបានប្រើសម្រាប់ panels, buttons, ផ្ទៃខាងក្រោយ [LineEdit], ផ្ទៃខាងក្រោយ [Tree], ។"
"ល។ ហើយក៏សម្រាប់សាកល្បង transparency mask សម្រាប់សញ្ញា pointer ផងដែរ។ ប្រសិនបើការសាកល្បង "
"mask បរាជ័យលើ [StyleBox] ដែលបានកំណត់ជា mask ទៅកាន់ control, សញ្ញាចុច "
"និងចលនានឹងឆ្លងកាត់វាទៅកាន់មួយនៅខាងក្រោម។\n"
"[b]ចំណាំ៖[/b] សម្រាប់ control nodes ដែលមាន [i]Theme Properties[/i], [StyleBox] "
"[code]focus[/code] ត្រូវបានបង្ហាញពីលើ [StyleBox] [code]normal[/code], "
"[code]hover[/code] ឬ [code]pressed[/code]។ នេះធ្វើឱ្យ [StyleBox] [code]focus[/"
"code] អាចប្រើឡើងវិញបានកាន់តែច្រើននៅទូទាំង nodes ផ្សេងៗគ្នា។"

msgid ""
"Virtual method to be implemented by the user. Returns a custom minimum size "
"that the stylebox must respect when drawing. By default [method "
"get_minimum_size] only takes content margins into account. This method can be "
"overridden to add another size restriction. A combination of the default "
"behavior and the output of this method will be used, to account for both "
"sizes."
msgstr ""
"Virtual method ដែលត្រូវអនុវត្តដោយអ្នកប្រើប្រាស់។ បង្វិលទំហំអប្បបរមាផ្ទាល់ខ្លួនដែល stylebox "
"ត្រូវតែគោរពនៅពេលគូរ។ តាមលំនាំដើម [method get_minimum_size] គិតតែពី content margins "
"ប៉ុណ្ណោះ។ វិធីសាស្រ្តនេះអាចត្រូវបាន override ដើម្បីបន្ថែមការរឹតបន្តឹងទំហំផ្សេងទៀត។ "
"ការរួមបញ្ចូលគ្នានៃឥរិយាបថលំនាំដើម និងលទ្ធផលនៃវិធីសាស្រ្តនេះនឹងត្រូវបានប្រើ ដើម្បីគិតពីទំហំទាំងពីរ។"

msgid ""
"Draws this stylebox using a canvas item identified by the given [RID].\n"
"The [RID] value can either be the result of [method "
"CanvasItem.get_canvas_item] called on an existing [CanvasItem]-derived node, "
"or directly from creating a canvas item in the [RenderingServer] with [method "
"RenderingServer.canvas_item_create]."
msgstr ""
"គូរ stylebox នេះដោយប្រើ canvas item ដែលបានកំណត់អត្តសញ្ញាណដោយ [RID] ដែលបានផ្តល់ឱ្យ។\n"
"តម្លៃ [RID] អាចជាលទ្ធផលនៃ [method CanvasItem.get_canvas_item] ដែលបានហៅលើ node "
"ដែលកើតចេញពី [CanvasItem] ឬដោយផ្ទាល់ពីការបង្កើត canvas item នៅក្នុង [RenderingServer] "
"ជាមួយ [method RenderingServer.canvas_item_create]។"

msgid "Returns the default margin of the specified [enum Side]."
msgstr "បង្វិល margin លំនាំដើមនៃ [enum Side] ដែលបានបញ្ជាក់។"

msgid ""
"Returns the [CanvasItem] that handles its [constant "
"CanvasItem.NOTIFICATION_DRAW] or [method CanvasItem._draw] callback at this "
"moment."
msgstr ""
"បង្វិល [CanvasItem] ដែលដោះស្រាយ callback [constant CanvasItem.NOTIFICATION_DRAW] "
"ឬ [method CanvasItem._draw] របស់វានៅពេលនេះ។"

msgid ""
"Returns the content margin offset for the specified [enum Side].\n"
"Positive values reduce size inwards, unlike [Control]'s margin values."
msgstr ""
"បង្វិលគម្លាត content margin សម្រាប់ [enum Side] ដែលបានបញ្ជាក់។\n"
"តម្លៃវិជ្ជមានកាត់បន្ថយទំហំចូលខាងក្នុង ខុសពីតម្លៃ margin របស់ [Control]។"

msgid "Returns the minimum size that this stylebox can be shrunk to."
msgstr "បង្វិលទំហំអប្បបរមាដែល stylebox នេះអាចបង្រួមបាន។"

msgid ""
"Returns the \"offset\" of a stylebox. This helper function returns a value "
"equivalent to [code]Vector2(style.get_margin(MARGIN_LEFT), "
"style.get_margin(MARGIN_TOP))[/code]."
msgstr ""
"បង្វិល \"offset\" នៃ stylebox។ អនុគមន៍ជំនួយនេះបង្វិលតម្លៃស្មើនឹង "
"[code]Vector2(style.get_margin(MARGIN_LEFT), style.get_margin(MARGIN_TOP))[/"
"code]។"

msgid ""
"Sets the default value of the specified [enum Side] to [param offset] pixels."
msgstr "កំណត់តម្លៃលំនាំដើមនៃ [enum Side] ដែលបានបញ្ជាក់ទៅជា [param offset] ភីកសែល។"

msgid "Sets the default margin to [param offset] pixels for all sides."
msgstr "កំណត់ margin លំនាំដើមទៅជា [param offset] ភីកសែលសម្រាប់គ្រប់ជ្រុងទាំងអស់។"

msgid "Test a position in a rectangle, return whether it passes the mask test."
msgstr "សាកល្បងទីតាំងមួយនៅក្នុងចតុកោណកែង បង្វិលថាតើវាឆ្លងកាត់ការសាកល្បង mask ឬអត់។"

msgid ""
"The bottom margin for the contents of this style box. Increasing this value "
"reduces the space available to the contents from the bottom.\n"
"If this value is negative, it is ignored and a child-specific margin is used "
"instead. For example, for [StyleBoxFlat], the border thickness (if any) is "
"used instead.\n"
"It is up to the code using this style box to decide what these contents are: "
"for example, a [Button] respects this content margin for the textual contents "
"of the button.\n"
"[method get_margin] should be used to fetch this value as consumer instead of "
"reading these properties directly. This is because it correctly respects "
"negative values and the fallback mentioned above."
msgstr ""
"Margin ខាងក្រោមសម្រាប់ខ្លឹមសារនៃ style box នេះ។ "
"ការបង្កើនតម្លៃនេះកាត់បន្ថយចន្លោះដែលមានសម្រាប់ខ្លឹមសារពីខាងក្រោម។\n"
"ប្រសិនបើតម្លៃនេះអវិជ្ជមាន វាត្រូវបានមិនអើពើ ហើយ margin ជាក់លាក់សម្រាប់ child "
"ត្រូវបានប្រើជំនួសវិញ។ ឧទាហរណ៍ សម្រាប់ [StyleBoxFlat], កម្រាស់ border (ប្រសិនបើមាន) "
"ត្រូវបានប្រើជំនួសវិញ។\n"
"វាអាស្រ័យលើកូដដែលប្រើ style box នេះដើម្បីសម្រេចថាតើខ្លឹមសារទាំងនេះជាអ្វី៖ ឧទាហរណ៍ [Button] "
"គោរព content margin នេះសម្រាប់ខ្លឹមសារអក្សរនៃ button។\n"
"[method get_margin] គួរតែត្រូវបានប្រើដើម្បីទាញយកតម្លៃនេះក្នុងនាមជា consumer "
"ជំនួសឱ្យការអាន properties ទាំងនេះដោយផ្ទាល់។ នេះគឺដោយសារតែវាគោរពតម្លៃអវិជ្ជមាន និង "
"fallback ដែលបានរៀបរាប់ខាងលើបានយ៉ាងត្រឹមត្រូវ។"

msgid ""
"The left margin for the contents of this style box. Increasing this value "
"reduces the space available to the contents from the left.\n"
"Refer to [member content_margin_bottom] for extra considerations."
msgstr ""
"Margin ខាងឆ្វេងសម្រាប់ខ្លឹមសារនៃ style box នេះ។ "
"ការបង្កើនតម្លៃនេះកាត់បន្ថយចន្លោះដែលមានសម្រាប់ខ្លឹមសារពីខាងឆ្វេង។\n"
"សូមយោងទៅ [member content_margin_bottom] សម្រាប់ការពិចារណាបន្ថែម។"

msgid ""
"The right margin for the contents of this style box. Increasing this value "
"reduces the space available to the contents from the right.\n"
"Refer to [member content_margin_bottom] for extra considerations."
msgstr ""
"Margin ខាងស្តាំសម្រាប់ខ្លឹមសារនៃ style box នេះ។ "
"ការបង្កើនតម្លៃនេះកាត់បន្ថយចន្លោះដែលមានសម្រាប់ខ្លឹមសារពីខាងស្តាំ។\n"
"សូមយោងទៅ [member content_margin_bottom] សម្រាប់ការពិចារណាបន្ថែម។"

msgid ""
"The top margin for the contents of this style box. Increasing this value "
"reduces the space available to the contents from the top.\n"
"Refer to [member content_margin_bottom] for extra considerations."
msgstr ""
"Margin ខាងលើសម្រាប់ខ្លឹមសារនៃ style box នេះ។ "
"ការបង្កើនតម្លៃនេះកាត់បន្ថយចន្លោះដែលមានសម្រាប់ខ្លឹមសារពីខាងលើ។\n"
"សូមយោងទៅ [member content_margin_bottom] សម្រាប់ការពិចារណាបន្ថែម។"

msgid "An empty [StyleBox] (does not display anything)."
msgstr "[StyleBox] ទទេ (មិនបង្ហាញអ្វីទាំងអស់)។"

msgid ""
"An empty [StyleBox] that can be used to display nothing instead of the "
"default style (e.g. it can \"disable\" [code]focus[/code] styles)."
msgstr ""
"[StyleBox] ទទេដែលអាចត្រូវបានប្រើដើម្បីបង្ហាញគ្មានអ្វីទាំងអស់ជំនួសឱ្យ style លំនាំដើម (ឧ. វាអាច "
"\"បិទ\" style [code]focus[/code])។"

msgid "A customizable [StyleBox] that doesn't use a texture."
msgstr "[StyleBox] ដែលអាចប្ដូរតាមបំណងបាន ដែលមិនប្រើ texture។"

msgid ""
"By configuring various properties of this style box, you can achieve many "
"common looks without the need of a texture. This includes optionally rounded "
"borders, antialiasing, shadows, and skew.\n"
"Setting corner radius to high values is allowed. As soon as corners overlap, "
"the stylebox will switch to a relative system:\n"
"[codeblock lang=text]\n"
"height = 30\n"
"corner_radius_top_left = 50\n"
"corner_radius_bottom_left = 100\n"
"[/codeblock]\n"
"The relative system now would take the 1:2 ratio of the two left corners to "
"calculate the actual corner width. Both corners added will [b]never[/b] be "
"more than the height. Result:\n"
"[codeblock lang=text]\n"
"corner_radius_top_left: 10\n"
"corner_radius_bottom_left: 20\n"
"[/codeblock]"
msgstr ""
"តាមរយៈការកំណត់រចនាសម្ព័ន្ធលក្ខណៈសម្បត្តិផ្សេងៗនៃ style box នេះ "
"អ្នកអាចសម្រេចបាននូវរូបរាងទូទៅជាច្រើនដោយមិនចាំបាច់ប្រើ texture។ នេះរួមបញ្ចូលទាំង borders "
"មូលជាជម្រើស, antialiasing, shadows, និង skew។\n"
"ការកំណត់ corner radius ទៅជាតម្លៃខ្ពស់ត្រូវបានអនុញ្ញាត។ នៅពេលដែល corners ត្រួតគ្នា "
"stylebox នឹងប្តូរទៅជាប្រព័ន្ធធរណីមាត្រ (relative system)៖\n"
"[codeblock lang=text]\n"
"height = 30\n"
"corner_radius_top_left = 50\n"
"corner_radius_bottom_left = 100\n"
"[/codeblock]\n"
"ឥឡូវនេះប្រព័ន្ធធរណីមាត្រនឹងយកសមាមាត្រ 1:2 នៃ corners ខាងឆ្វេងទាំងពីរដើម្បីគណនាទទឹង corner "
"ជាក់ស្តែង។ Corners ទាំងពីរបូកបញ្ចូលគ្នា [b]នឹងមិនដែល[/b] លើសពីកម្ពស់ទេ។ លទ្ធផល៖\n"
"[codeblock lang=text]\n"
"corner_radius_top_left: 10\n"
"corner_radius_bottom_left: 20\n"
"[/codeblock]"

msgid "Returns the specified [enum Side]'s border width."
msgstr "បង្វិលទទឹង border នៃ [enum Side] ដែលបានបញ្ជាក់។"

msgid "Returns the smallest border width out of all four borders."
msgstr "បង្វិលទទឹង border តូចបំផុតក្នុងចំណោម borders ទាំងបួន។"

msgid "Returns the given [param corner]'s radius."
msgstr "បង្វិលកាំ (radius) នៃ [param corner] ដែលបានផ្តល់ឱ្យ។"

msgid "Returns the size of the specified [enum Side]'s expand margin."
msgstr "បង្វិលទំហំនៃ expand margin របស់ [enum Side] ដែលបានបញ្ជាក់។"

msgid "Sets the specified [enum Side]'s border width to [param width] pixels."
msgstr "កំណត់ទទឹង border របស់ [enum Side] ដែលបានបញ្ជាក់ទៅជា [param width] ភីកសែល។"

msgid "Sets the border width to [param width] pixels for all sides."
msgstr "កំណត់ទទឹង border ទៅជា [param width] ភីកសែលសម្រាប់គ្រប់ជ្រុងទាំងអស់។"

msgid ""
"Sets the corner radius to [param radius] pixels for the given [param corner]."
msgstr ""
"កំណត់ corner radius ទៅជា [param radius] ភីកសែលសម្រាប់ [param corner] ដែលបានផ្តល់ឱ្យ។"

msgid "Sets the corner radius to [param radius] pixels for all corners."
msgstr "កំណត់ corner radius ទៅជា [param radius] ភីកសែលសម្រាប់គ្រប់ corners ទាំងអស់។"

msgid ""
"Sets the expand margin to [param size] pixels for the specified [enum Side]."
msgstr "កំណត់ expand margin ទៅជា [param size] ភីកសែលសម្រាប់ [enum Side] ដែលបានបញ្ជាក់។"

msgid "Sets the expand margin to [param size] pixels for all sides."
msgstr "កំណត់ expand margin ទៅជា [param size] ភីកសែលសម្រាប់គ្រប់ជ្រុងទាំងអស់។"

msgid ""
"Antialiasing draws a small ring around the edges, which fades to "
"transparency. As a result, edges look much smoother. This is only noticeable "
"when using rounded corners or [member skew].\n"
"[b]Note:[/b] When using beveled corners with 45-degree angles ([member "
"corner_detail] = 1), it is recommended to set [member anti_aliasing] to "
"[code]false[/code] to ensure crisp visuals and avoid possible visual glitches."
msgstr ""
"Antialiasing គូរចិញ្ចៀនតូចមួយនៅជុំវិញគែម ដែលរលាយបាត់ទៅជាថ្លា (transparency)។ ជាលទ្ធផល "
"គែមមើលទៅរលូនជាងមុន។ នេះអាចកត់សម្គាល់បានតែនៅពេលប្រើ corners មូល ឬ [member skew] "
"ប៉ុណ្ណោះ។\n"
"[b]ចំណាំ៖[/b] នៅពេលប្រើ beveled corners ជាមួយមុំ 45 ដឺក្រេ ([member corner_detail] = "
"1) ត្រូវបានណែនាំឱ្យកំណត់ [member anti_aliasing] ទៅជា [code]false[/code] "
"ដើម្បីធានាបាននូវរូបភាពច្បាស់ និងជៀសវាងកំហុសរូបភាពដែលអាចកើតមាន។"

msgid ""
"This changes the size of the antialiasing effect. [code]1.0[/code] is "
"recommended for an optimal result at 100% scale, identical to how rounded "
"rectangles are rendered in web browsers and most vector drawing software.\n"
"[b]Note:[/b] Higher values may produce a blur effect but can also create "
"undesired artifacts on small boxes with large-radius corners."
msgstr ""
"នេះផ្លាស់ប្តូរទំហំនៃផលប៉ះពាល់ antialiasing។ [code]1.0[/code] "
"ត្រូវបានណែនាំសម្រាប់លទ្ធផលល្អបំផុតនៅមាត្រដ្ឋាន 100% ដែលដូចគ្នានឹងរបៀបដែលចតុកោណកែងមូលត្រូវបាន "
"render នៅក្នុង web browsers និងកម្មវិធីគូរ vector ភាគច្រើន។\n"
"[b]ចំណាំ៖[/b] តម្លៃខ្ពស់អាចបង្កើតផលប៉ះពាល់ព្រាល ប៉ុន្តែក៏អាចបង្កើត artifacts "
"ដែលមិនចង់បាននៅលើប្រអប់តូចៗដែលមាន corners កាំធំផងដែរ។"

msgid "The background color of the stylebox."
msgstr "ពណ៌ផ្ទៃខាងក្រោយនៃ stylebox។"

msgid "If [code]true[/code], the border will fade into the background color."
msgstr "ប្រសិនបើ [code]true[/code], border នឹងរលាយចូលទៅក្នុងពណ៌ផ្ទៃខាងក្រោយ។"

msgid "Sets the color of the border."
msgstr "កំណត់ពណ៌នៃ border។"

msgid "Border width for the bottom border."
msgstr "ទទឹង border សម្រាប់ border ខាងក្រោម។"

msgid "Border width for the left border."
msgstr "ទទឹង border សម្រាប់ border ខាងឆ្វេង។"

msgid "Border width for the right border."
msgstr "ទទឹង border សម្រាប់ border ខាងស្តាំ។"

msgid "Border width for the top border."
msgstr "ទទឹង border សម្រាប់ border ខាងលើ។"

msgid ""
"This sets the number of vertices used for each corner. Higher values result "
"in rounder corners but take more processing power to compute. When choosing a "
"value, you should take the corner radius ([method set_corner_radius_all]) "
"into account.\n"
"For corner radii less than 10, [code]4[/code] or [code]5[/code] should be "
"enough. For corner radii less than 30, values between [code]8[/code] and "
"[code]12[/code] should be enough.\n"
"A corner detail of [code]1[/code] will result in chamfered corners instead of "
"rounded corners, which is useful for some artistic effects."
msgstr ""
"នេះកំណត់ចំនួន vertices ដែលប្រើសម្រាប់ corner នីមួយៗ។ តម្លៃខ្ពស់ធ្វើឱ្យ corners កាន់តែមូល "
"ប៉ុន្តែត្រូវការថាមពលដំណើរការច្រើនជាងមុនដើម្បីគណនា។ នៅពេលជ្រើសរើសតម្លៃ អ្នកគួរតែគិតពី corner "
"radius ([method set_corner_radius_all]) ផងដែរ។\n"
"សម្រាប់ corner radii តិចជាង 10, [code]4[/code] ឬ [code]5[/code] គួរតែគ្រប់គ្រាន់ហើយ។ "
"សម្រាប់ corner radii តិចជាង 30, តម្លៃចន្លោះពី [code]8[/code] និង [code]12[/code] "
"គួរតែគ្រប់គ្រាន់។\n"
"Corner detail នៃ [code]1[/code] នឹងធ្វើឱ្យមាន chamfered corners ជំនួសឱ្យ corners មូល "
"ដែលមានប្រយោជន៍សម្រាប់ផលប៉ះពាល់សិល្បៈមួយចំនួន។"

msgid ""
"The bottom-left corner's radius. If [code]0[/code], the corner is not rounded."
msgstr "កាំនៃជ្រុងខាងឆ្វេងផ្នែកខាងក្រោម។ ប្រសិនបើ [code]0[/code] ជ្រុងនេះនឹងមិនកោងទេ។"

msgid ""
"The bottom-right corner's radius. If [code]0[/code], the corner is not "
"rounded."
msgstr "កាំនៃជ្រុងខាងស្តាំផ្នែកខាងក្រោម។ ប្រសិនបើ [code]0[/code] ជ្រុងនេះនឹងមិនកោងទេ។"

msgid ""
"The top-left corner's radius. If [code]0[/code], the corner is not rounded."
msgstr "កាំនៃជ្រុងខាងឆ្វេងផ្នែកខាងលើ។ ប្រសិនបើ [code]0[/code] ជ្រុងនេះនឹងមិនកោងទេ។"

msgid ""
"The top-right corner's radius. If [code]0[/code], the corner is not rounded."
msgstr "កាំនៃជ្រុងខាងស្តាំផ្នែកខាងលើ។ ប្រសិនបើ [code]0[/code] ជ្រុងនេះនឹងមិនកោងទេ។"

msgid "Toggles drawing of the inner part of the stylebox."
msgstr "បិទ/បើកការគូរផ្នែកខាងក្នុងនៃ stylebox។"

msgid ""
"Expands the stylebox outside of the control rect on the bottom edge. Useful "
"in combination with [member border_width_bottom] to draw a border outside the "
"control rect.\n"
"[b]Note:[/b] Unlike [member StyleBox.content_margin_bottom], [member "
"expand_margin_bottom] does [i]not[/i] affect the size of the clickable area "
"for [Control]s. This can negatively impact usability if used wrong, as the "
"user may try to click an area of the StyleBox that cannot actually receive "
"clicks."
msgstr ""
"ពង្រីក stylebox ចេញក្រៅពី control rect នៅគែមខាងក្រោម។ មានប្រយោជន៍នៅពេលប្រើរួមជាមួយ "
"[member border_width_bottom] ដើម្បីគូរស៊ុម (border) នៅខាងក្រៅ control rect។\n"
"[b]ចំណាំ៖[/b] ខុសពី [member StyleBox.content_margin_bottom], [member "
"expand_margin_bottom] [i]មិន[/i]ប៉ះពាល់ដល់ទំហំនៃតំបន់ដែលអាចចុចបានសម្រាប់ [Control]s ទេ។ "
"វាអាចធ្វើឱ្យប៉ះពាល់ដល់ភាពងាយស្រួលប្រើប្រាស់ ប្រសិនបើប្រើខុស "
"ព្រោះអ្នកប្រើប្រាស់អាចនឹងព្យាយាមចុចលើផ្ទៃរបស់ StyleBox ដែលមិនអាចទទួលការចុចបានជាក់ស្តែង។"

msgid ""
"Expands the stylebox outside of the control rect on the left edge. Useful in "
"combination with [member border_width_left] to draw a border outside the "
"control rect.\n"
"[b]Note:[/b] Unlike [member StyleBox.content_margin_left], [member "
"expand_margin_left] does [i]not[/i] affect the size of the clickable area for "
"[Control]s. This can negatively impact usability if used wrong, as the user "
"may try to click an area of the StyleBox that cannot actually receive clicks."
msgstr ""
"ពង្រីក stylebox ចេញក្រៅពី control rect នៅគែមខាងឆ្វេង។ មានប្រយោជន៍នៅពេលប្រើរួមជាមួយ "
"[member border_width_left] ដើម្បីគូរស៊ុម (border) នៅខាងក្រៅ control rect។\n"
"[b]ចំណាំ៖[/b] ខុសពី [member StyleBox.content_margin_left], [member "
"expand_margin_left] [i]មិន[/i]ប៉ះពាល់ដល់ទំហំនៃតំបន់ដែលអាចចុចបានសម្រាប់ [Control]s ទេ។ "
"វាអាចធ្វើឱ្យប៉ះពាល់ដល់ភាពងាយស្រួលប្រើប្រាស់ ប្រសិនបើប្រើខុស "
"ព្រោះអ្នកប្រើប្រាស់អាចនឹងព្យាយាមចុចលើផ្ទៃរបស់ StyleBox ដែលមិនអាចទទួលការចុចបានជាក់ស្តែង។"

msgid ""
"Expands the stylebox outside of the control rect on the right edge. Useful in "
"combination with [member border_width_right] to draw a border outside the "
"control rect.\n"
"[b]Note:[/b] Unlike [member StyleBox.content_margin_right], [member "
"expand_margin_right] does [i]not[/i] affect the size of the clickable area "
"for [Control]s. This can negatively impact usability if used wrong, as the "
"user may try to click an area of the StyleBox that cannot actually receive "
"clicks."
msgstr ""
"ពង្រីក stylebox ចេញក្រៅពី control rect នៅគែមខាងស្តាំ។ មានប្រយោជន៍នៅពេលប្រើរួមជាមួយ "
"[member border_width_right] ដើម្បីគូរស៊ុម (border) នៅខាងក្រៅ control rect។\n"
"[b]ចំណាំ៖[/b] ខុសពី [member StyleBox.content_margin_right], [member "
"expand_margin_right] [i]មិន[/i]ប៉ះពាល់ដល់ទំហំនៃតំបន់ដែលអាចចុចបានសម្រាប់ [Control]s ទេ។ "
"វាអាចធ្វើឱ្យប៉ះពាល់ដល់ភាពងាយស្រួលប្រើប្រាស់ ប្រសិនបើប្រើខុស "
"ព្រោះអ្នកប្រើប្រាស់អាចនឹងព្យាយាមចុចលើផ្ទៃរបស់ StyleBox ដែលមិនអាចទទួលការចុចបានជាក់ស្តែង។"

msgid ""
"Expands the stylebox outside of the control rect on the top edge. Useful in "
"combination with [member border_width_top] to draw a border outside the "
"control rect.\n"
"[b]Note:[/b] Unlike [member StyleBox.content_margin_top], [member "
"expand_margin_top] does [i]not[/i] affect the size of the clickable area for "
"[Control]s. This can negatively impact usability if used wrong, as the user "
"may try to click an area of the StyleBox that cannot actually receive clicks."
msgstr ""
"ពង្រីក stylebox ចេញក្រៅពី control rect នៅគែមខាងលើ។ មានប្រយោជន៍នៅពេលប្រើរួមជាមួយ "
"[member border_width_top] ដើម្បីគូរស៊ុម (border) នៅខាងក្រៅ control rect។\n"
"[b]ចំណាំ៖[/b] ខុសពី [member StyleBox.content_margin_top], [member "
"expand_margin_top] [i]មិន[/i]ប៉ះពាល់ដល់ទំហំនៃតំបន់ដែលអាចចុចបានសម្រាប់ [Control]s ទេ។ "
"វាអាចធ្វើឱ្យប៉ះពាល់ដល់ភាពងាយស្រួលប្រើប្រាស់ ប្រសិនបើប្រើខុស "
"ព្រោះអ្នកប្រើប្រាស់អាចនឹងព្យាយាមចុចលើផ្ទៃរបស់ StyleBox ដែលមិនអាចទទួលការចុចបានជាក់ស្តែង។"

msgid ""
"The color of the shadow. This has no effect if [member shadow_size] is lower "
"than 1."
msgstr "ពណ៌នៃស្រមោល។ វាគ្មានឥទ្ធិពលទេ ប្រសិនបើ [member shadow_size] ទាបជាង 1។"

msgid ""
"The shadow offset in pixels. Adjusts the position of the shadow relatively to "
"the stylebox."
msgstr ""
"គម្លាតស្រមោល (shadow offset) គិតជា pixels។ កែតម្រូវទីតាំងនៃស្រមោលធៀបនឹង stylebox។"

msgid "The shadow size in pixels."
msgstr "ទំហំស្រមោលគិតជា pixels។"

msgid ""
"If set to a non-zero value on either axis, [member skew] distorts the "
"StyleBox horizontally and/or vertically. This can be used for \"futuristic\"-"
"style UIs. Positive values skew the StyleBox towards the right (X axis) and "
"upwards (Y axis), while negative values skew the StyleBox towards the left (X "
"axis) and downwards (Y axis).\n"
"[b]Note:[/b] To ensure text does not touch the StyleBox's edges, consider "
"increasing the [StyleBox]'s content margin (see [member "
"StyleBox.content_margin_bottom]). It is preferable to increase the content "
"margin instead of the expand margin (see [member expand_margin_bottom]), as "
"increasing the expand margin does not increase the size of the clickable area "
"for [Control]s."
msgstr ""
"ប្រសិនបើកំណត់ទៅជាតម្លៃមិនសូន្យលើអ័ក្សណាមួយ [member skew] នឹងធ្វើឱ្យ StyleBox "
"មើលទៅទ្រេតតាមទិសដេក និង/ឬ ទិសឈរ។ វាអាចត្រូវបានប្រើសម្រាប់ UI រចនាប័ទ្ម \"អនាគត\" "
"(futuristic)។ តម្លៃវិជ្ជមានធ្វើឱ្យ StyleBox ទ្រេតទៅខាងស្តាំ (អ័ក្ស X) និងឡើងលើ (អ័ក្ស Y) "
"ខណៈពេលដែលតម្លៃអវិជ្ជមានធ្វើឱ្យ StyleBox ទ្រេតទៅខាងឆ្វេង (អ័ក្ស X) និងចុះក្រោម (អ័ក្ស Y)។\n"
"[b]ចំណាំ៖[/b] ដើម្បីធានាថាអត្ថបទមិនប៉ះនឹងគែមរបស់ StyleBox សូមពិចារណាបង្កើន content margin "
"របស់ [StyleBox] (សូមមើល [member StyleBox.content_margin_bottom])។ "
"វាជាការប្រសើរជាងក្នុងការបង្កើន content margin ជំនួសឱ្យ expand margin (សូមមើល [member "
"expand_margin_bottom]) ព្រោះការបង្កើន expand margin "
"មិនធ្វើឱ្យទំហំនៃតំបន់ដែលអាចចុចបានសម្រាប់ [Control]s កើនឡើងទេ។"

msgid "A [StyleBox] that displays a single line of a given color and thickness."
msgstr "[StyleBox] ដែលបង្ហាញបន្ទាត់តែមួយដែលមានពណ៌ និងកម្រាស់ជាក់លាក់។"

msgid ""
"A [StyleBox] that displays a single line of a given color and thickness. The "
"line can be either horizontal or vertical. Useful for separators."
msgstr ""
"[StyleBox] ដែលបង្ហាញបន្ទាត់តែមួយដែលមានពណ៌ និងកម្រាស់ជាក់លាក់។ បន្ទាត់អាចជាទិសដេក ឬទិសឈរ។ "
"មានប្រយោជន៍សម្រាប់ធ្វើជាព្រំដែនញែក (separators)។"

msgid "The line's color."
msgstr "ពណ៌របស់បន្ទាត់។"

msgid ""
"The number of pixels the line will extend before the [StyleBoxLine]'s bounds. "
"If set to a negative value, the line will begin inside the [StyleBoxLine]'s "
"bounds."
msgstr ""
"ចំនួន pixels ដែលបន្ទាត់នឹងពង្រីកមុនព្រំដែនរបស់ [StyleBoxLine]។ ប្រសិនបើកំណត់ទៅជាតម្លៃអវិជ្ជមាន "
"បន្ទាត់នឹងចាប់ផ្តើមនៅខាងក្នុងព្រំដែនរបស់ [StyleBoxLine]។"

msgid ""
"The number of pixels the line will extend past the [StyleBoxLine]'s bounds. "
"If set to a negative value, the line will end inside the [StyleBoxLine]'s "
"bounds."
msgstr ""
"ចំនួន pixels ដែលបន្ទាត់នឹងពង្រីកហួសព្រំដែនរបស់ [StyleBoxLine]។ ប្រសិនបើកំណត់ទៅជាតម្លៃអវិជ្ជមាន "
"បន្ទាត់នឹងបញ្ចប់នៅខាងក្នុងព្រំដែនរបស់ [StyleBoxLine]។"

msgid "The line's thickness in pixels."
msgstr "កម្រាស់របស់បន្ទាត់គិតជា pixels។"

msgid ""
"If [code]true[/code], the line will be vertical. If [code]false[/code], the "
"line will be horizontal."
msgstr ""
"ប្រសិនបើ [code]true[/code] បន្ទាត់នឹងមានទិសឈរ។ ប្រសិនបើ [code]false[/code] "
"បន្ទាត់នឹងមានទិសដេក។"

msgid "A texture-based nine-patch [StyleBox]."
msgstr "[StyleBox] ប្រភេទ nine-patch ដែលផ្អែកលើ texture។"

msgid ""
"A texture-based nine-patch [StyleBox], in a way similar to [NinePatchRect]. "
"This stylebox performs a 3×3 scaling of a texture, where only the center cell "
"is fully stretched. This makes it possible to design bordered styles "
"regardless of the stylebox's size."
msgstr ""
"[StyleBox] ប្រភេទ nine-patch ដែលផ្អែកលើ texture ដែលមានលក្ខណៈស្រដៀងនឹង "
"[NinePatchRect]។ stylebox នេះធ្វើមាត្រដ្ឋាន 3×3 នៃ texture ដែលមានតែ cell "
"កណ្តាលប៉ុណ្ណោះដែលត្រូវបានពង្រីកពេញលេញ។ នេះធ្វើឱ្យអាចរចនាស្ទីលដែលមានស៊ុមបាន ដោយមិនគិតពីទំហំរបស់ "
"stylebox។"

msgid "Returns the expand margin size of the specified [enum Side]."
msgstr "បង្វិលទំហំ expand margin នៃ [enum Side] ដែលបានបញ្ជាក់។"

msgid "Returns the margin size of the specified [enum Side]."
msgstr "បង្វិលទំហំ margin នៃ [enum Side] ដែលបានបញ្ជាក់។"

msgid "Sets the margin to [param size] pixels for the specified [enum Side]."
msgstr "កំណត់ margin ទៅជា [param size] pixels សម្រាប់ [enum Side] ដែលបានបញ្ជាក់។"

msgid "Sets the margin to [param size] pixels for all sides."
msgstr "កំណត់ margin ទៅជា [param size] pixels សម្រាប់គ្រប់ជ្រុងទាំងអស់។"

msgid ""
"Controls how the stylebox's texture will be stretched or tiled horizontally."
msgstr ""
"គ្រប់គ្រងពីរបៀបដែល texture របស់ stylebox នឹងត្រូវបានពង្រីក ឬរៀបជាក្រឡា (tiled) តាមទិសដេក។"

msgid ""
"Controls how the stylebox's texture will be stretched or tiled vertically."
msgstr ""
"គ្រប់គ្រងពីរបៀបដែល texture របស់ stylebox នឹងត្រូវបានពង្រីក ឬរៀបជាក្រឡា (tiled) តាមទិសឈរ។"

msgid ""
"If [code]true[/code], the nine-patch texture's center tile will be drawn."
msgstr "ប្រសិនបើ [code]true[/code] ក្រឡាកណ្តាលនៃ nine-patch texture នឹងត្រូវបានគូរ។"

msgid ""
"Expands the bottom margin of this style box when drawing, causing it to be "
"drawn larger than requested."
msgstr ""
"ពង្រីក margin ខាងក្រោមនៃ style box នេះនៅពេលគូរ ដែលធ្វើឱ្យវាត្រូវបានគូរធំជាងទំហំដែលបានស្នើសុំ។"

msgid ""
"Expands the left margin of this style box when drawing, causing it to be "
"drawn larger than requested."
msgstr ""
"ពង្រីក margin ខាងឆ្វេងនៃ style box នេះនៅពេលគូរ ដែលធ្វើឱ្យវាត្រូវបានគូរធំជាងទំហំដែលបានស្នើសុំ។"

msgid ""
"Expands the right margin of this style box when drawing, causing it to be "
"drawn larger than requested."
msgstr ""
"ពង្រីក margin ខាងស្តាំនៃ style box នេះនៅពេលគូរ ដែលធ្វើឱ្យវាត្រូវបានគូរធំជាងទំហំដែលបានស្នើសុំ។"

msgid ""
"Expands the top margin of this style box when drawing, causing it to be drawn "
"larger than requested."
msgstr ""
"ពង្រីក margin ខាងលើនៃ style box នេះនៅពេលគូរ ដែលធ្វើឱ្យវាត្រូវបានគូរធំជាងទំហំដែលបានស្នើសុំ។"

msgid "Modulates the color of the texture when this style box is drawn."
msgstr "កែតម្រូវពណ៌ (modulate) នៃ texture នៅពេលដែល style box នេះត្រូវបានគូរ។"

msgid ""
"The region to use from the [member texture].\n"
"This is equivalent to first wrapping the [member texture] in an "
"[AtlasTexture] with the same region.\n"
"If empty ([code]Rect2(0, 0, 0, 0)[/code]), the whole [member texture] is used."
msgstr ""
"តំបន់ដែលត្រូវប្រើពី [member texture]។\n"
"នេះគឺស្មើនឹងការរុំ [member texture] ជាមុនសិននៅក្នុង [AtlasTexture] ដែលមានតំបន់ដូចគ្នា។\n"
"ប្រសិនបើទទេ ([code]Rect2(0, 0, 0, 0)[/code]) [member texture] ទាំងមូលនឹងត្រូវបានប្រើ។"

msgid "The texture to use when drawing this style box."
msgstr "texture ដែលត្រូវប្រើនៅពេលគូរ style box នេះ។"

msgid ""
"Increases the bottom margin of the 3×3 texture box.\n"
"A higher value means more of the source texture is considered to be part of "
"the bottom border of the 3×3 box.\n"
"This is also the value used as fallback for [member "
"StyleBox.content_margin_bottom] if it is negative."
msgstr ""
"បង្កើន margin ខាងក្រោមនៃប្រអប់ texture 3×3។\n"
"តម្លៃកាន់តែខ្ពស់មានន័យថា ផ្នែកកាន់តែច្រើននៃ texture "
"ប្រភពដើមត្រូវបានចាត់ទុកថាជាផ្នែកនៃស៊ុមខាងក្រោមនៃប្រអប់ 3×3។\n"
"នេះក៏ជាតម្លៃដែលប្រើជា fallback សម្រាប់ [member StyleBox.content_margin_bottom] "
"ផងដែរ ប្រសិនបើវាជាតម្លៃអវិជ្ជមាន។"

msgid ""
"Increases the left margin of the 3×3 texture box.\n"
"A higher value means more of the source texture is considered to be part of "
"the left border of the 3×3 box.\n"
"This is also the value used as fallback for [member "
"StyleBox.content_margin_left] if it is negative."
msgstr ""
"បង្កើន margin ខាងឆ្វេងនៃប្រអប់ texture 3×3។\n"
"តម្លៃកាន់តែខ្ពស់មានន័យថា ផ្នែកកាន់តែច្រើននៃ texture "
"ប្រភពដើមត្រូវបានចាត់ទុកថាជាផ្នែកនៃស៊ុមខាងឆ្វេងនៃប្រអប់ 3×3។\n"
"នេះក៏ជាតម្លៃដែលប្រើជា fallback សម្រាប់ [member StyleBox.content_margin_left] ផងដែរ "
"ប្រសិនបើវាជាតម្លៃអវិជ្ជមាន។"

msgid ""
"Increases the right margin of the 3×3 texture box.\n"
"A higher value means more of the source texture is considered to be part of "
"the right border of the 3×3 box.\n"
"This is also the value used as fallback for [member "
"StyleBox.content_margin_right] if it is negative."
msgstr ""
"បង្កើន margin ខាងស្តាំនៃប្រអប់ texture 3×3។\n"
"តម្លៃកាន់តែខ្ពស់មានន័យថា ផ្នែកកាន់តែច្រើននៃ texture "
"ប្រភពដើមត្រូវបានចាត់ទុកថាជាផ្នែកនៃស៊ុមខាងស្តាំនៃប្រអប់ 3×3។\n"
"នេះក៏ជាតម្លៃដែលប្រើជា fallback សម្រាប់ [member StyleBox.content_margin_right] "
"ផងដែរ ប្រសិនបើវាជាតម្លៃអវិជ្ជមាន។"

msgid ""
"Increases the top margin of the 3×3 texture box.\n"
"A higher value means more of the source texture is considered to be part of "
"the top border of the 3×3 box.\n"
"This is also the value used as fallback for [member "
"StyleBox.content_margin_top] if it is negative."
msgstr ""
"បង្កើន margin ខាងលើនៃប្រអប់ texture 3×3។\n"
"តម្លៃកាន់តែខ្ពស់មានន័យថា ផ្នែកកាន់តែច្រើននៃ texture "
"ប្រភពដើមត្រូវបានចាត់ទុកថាជាផ្នែកនៃស៊ុមខាងលើនៃប្រអប់ 3×3។\n"
"នេះក៏ជាតម្លៃដែលប្រើជា fallback សម្រាប់ [member StyleBox.content_margin_top] ផងដែរ "
"ប្រសិនបើវាជាតម្លៃអវិជ្ជមាន។"

msgid ""
"Stretch the stylebox's texture. This results in visible distortion unless the "
"texture size matches the stylebox's size perfectly."
msgstr ""
"ពង្រីក (stretch) texture របស់ stylebox។ នេះនឹងធ្វើឱ្យរូបភាពមើលទៅប្រែប្រួលទ្រង់ទ្រាយ "
"(distortion) លើកលែងតែទំហំ texture ត្រូវគ្នានឹងទំហំរបស់ stylebox យ៉ាងល្អឥតខ្ចោះ។"

msgid ""
"Repeats the stylebox's texture to match the stylebox's size according to the "
"nine-patch system."
msgstr ""
"ធ្វើឱ្យ texture របស់ stylebox ដដែលៗ (repeat) ដើម្បីឱ្យត្រូវនឹងទំហំរបស់ stylebox "
"យោងតាមប្រព័ន្ធ nine-patch។"

msgid ""
"Repeats the stylebox's texture to match the stylebox's size according to the "
"nine-patch system. Unlike [constant AXIS_STRETCH_MODE_TILE], the texture may "
"be slightly stretched to make the nine-patch texture tile seamlessly."
msgstr ""
"ធ្វើឱ្យ texture របស់ stylebox ដដែលៗ (repeat) ដើម្បីឱ្យត្រូវនឹងទំហំរបស់ stylebox "
"យោងតាមប្រព័ន្ធ nine-patch។ ខុសពី [constant AXIS_STRETCH_MODE_TILE] texture "
"អាចនឹងត្រូវបានពង្រីកបន្តិចបន្តួច ដើម្បីធ្វើឱ្យក្រឡានៃ nine-patch texture តភ្ជាប់គ្នាដោយរលូន "
"(seamlessly)។"

msgid "Runs a [Tween] nested within another [Tween]."
msgstr "ដំណើរការ [Tween] ដែលបានដាក់បញ្ចូលគ្នា (nested) នៅក្នុង [Tween] មួយផ្សេងទៀត។"

msgid ""
"[SubtweenTweener] is used to execute a [Tween] as one step in a sequence "
"defined by another [Tween]. See [method Tween.tween_subtween] for more usage "
"information.\n"
"[b]Note:[/b] [method Tween.tween_subtween] is the only correct way to create "
"[SubtweenTweener]. Any [SubtweenTweener] created manually will not function "
"correctly."
msgstr ""
"[SubtweenTweener] ត្រូវបានប្រើដើម្បីដំណើរការ [Tween] ជាជំហានមួយនៅក្នុងលំដាប់លំដោយ "
"(sequence) ដែលបានកំណត់ដោយ [Tween] មួយផ្សេងទៀត។ សូមមើល [method "
"Tween.tween_subtween] សម្រាប់ព័ត៌មានបន្ថែមអំពីការប្រើប្រាស់។\n"
"[b]ចំណាំ៖[/b] [method Tween.tween_subtween] គឺជាវិធីតែមួយគត់ដែលត្រឹមត្រូវក្នុងការបង្កើត "
"[SubtweenTweener]។ រាល់ [SubtweenTweener] ដែលបង្កើតដោយដៃនឹងមិនដំណើរការត្រឹមត្រូវទេ។"

msgid ""
"Sets the time in seconds after which the [SubtweenTweener] will start running "
"the subtween. By default there's no delay."
msgstr ""
"កំណត់ពេលវេលាគិតជាវិនាទី ដែលបន្ទាប់ពីនោះ [SubtweenTweener] នឹងចាប់ផ្តើមដំណើរការ subtween។ "
"តាមលំនាំដើម គឺគ្មានការពន្យារពេលទេ។"

msgid ""
"An interface to a game world that doesn't create a window or draw to the "
"screen directly."
msgstr "ចំណុចប្រទាក់ទៅកាន់ game world ដែលមិនបង្កើត window ឬគូរលើអេក្រង់ដោយផ្ទាល់។"

msgid ""
"[SubViewport] Isolates a rectangular region of a scene to be displayed "
"independently. This can be used, for example, to display UI in 3D space.\n"
"[b]Note:[/b] [SubViewport] is a [Viewport] that isn't a [Window], i.e. it "
"doesn't draw anything by itself. To display anything, [SubViewport] must have "
"a non-zero size and be either put inside a [SubViewportContainer] or assigned "
"to a [ViewportTexture].\n"
"[b]Note:[/b] [InputEvent]s are not passed to a standalone [SubViewport] by "
"default. To ensure [InputEvent] propagation, a [SubViewport] can be placed "
"inside of a [SubViewportContainer]."
msgstr ""
"[SubViewport] ញែកតំបន់ចតុកោណកែងនៃ scene មួយដើម្បីបង្ហាញដោយឯករាជ្យ។ ឧទាហរណ៍ "
"វាអាចត្រូវបានប្រើដើម្បីបង្ហាញ UI នៅក្នុងលំហ 3D។\n"
"[b]ចំណាំ៖[/b] [SubViewport] គឺជា [Viewport] ដែលមិនមែនជា [Window] "
"ពោលគឺវាមិនគូរអ្វីទាំងអស់ដោយខ្លួនឯង។ ដើម្បីបង្ហាញអ្វីមួយ [SubViewport] ត្រូវតែមានទំហំមិនសូន្យ "
"ហើយត្រូវដាក់នៅខាងក្នុង [SubViewportContainer] ឬកំណត់ទៅកាន់ [ViewportTexture]។\n"
"[b]ចំណាំ៖[/b] [InputEvent]s មិនត្រូវបានបញ្ជូនទៅកាន់ [SubViewport] "
"ដែលនៅដាច់ដោយឡែកតាមលំនាំដើមទេ។ ដើម្បីធានាការបញ្ជូនបន្តនៃ [InputEvent], [SubViewport] "
"អាចត្រូវបានដាក់នៅខាងក្នុង [SubViewportContainer]។"

msgid "Using Viewports"
msgstr "ការប្រើប្រាស់ Viewports"

msgid "3D in 2D Viewport Demo"
msgstr "សាកល្បង 3D នៅក្នុង 2D Viewport"

msgid "Screen Capture Demo"
msgstr "សាកល្បងការថតអេក្រង់ (Screen Capture)"

msgid "Dynamic Split Screen Demo"
msgstr "សាកល្បងការបំបែកអេក្រង់ឌីណាមិក (Dynamic Split Screen)"

msgid "3D Resolution Scaling Demo"
msgstr "សាកល្បងការផ្លាស់ប្តូរទំហំ Resolution 3D"

msgid ""
"The clear mode when the sub-viewport is used as a render target.\n"
"[b]Note:[/b] This property is intended for 2D usage."
msgstr ""
"របៀបសម្អាត (clear mode) នៅពេលដែល sub-viewport ត្រូវបានប្រើជា render target។\n"
"[b]ចំណាំ៖[/b] លក្ខណៈសម្បត្តិនេះត្រូវបានរៀបចំឡើងសម្រាប់ការប្រើប្រាស់ក្នុង 2D។"

msgid "The update mode when the sub-viewport is used as a render target."
msgstr ""
"របៀបធ្វើបច្ចុប្បន្នភាព (update mode) នៅពេលដែល sub-viewport ត្រូវបានប្រើជា render "
"target។"

msgid ""
"The width and height of the sub-viewport. Must be set to a value greater than "
"or equal to 2 pixels on both dimensions. Otherwise, nothing will be "
"displayed.\n"
"[b]Note:[/b] If the parent node is a [SubViewportContainer] and its [member "
"SubViewportContainer.stretch] is [code]true[/code], the viewport size cannot "
"be changed manually."
msgstr ""
"ទទឹង និងកម្ពស់នៃ sub-viewport។ ត្រូវតែកំណត់ទៅជាតម្លៃធំជាង ឬស្មើ 2 pixels លើវិមាត្រទាំងពីរ។ "
"បើមិនដូច្នេះទេ គ្មានអ្វីនឹងត្រូវបានបង្ហាញទេ។\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើ node មេគឺជា [SubViewportContainer] ហើយ [member "
"SubViewportContainer.stretch] របស់វាគឺ [code]true[/code] ទំហំ viewport "
"មិនអាចផ្លាស់ប្តូរដោយដៃបានទេ។"

msgid ""
"The 2D size override of the sub-viewport. If either the width or height is "
"[code]0[/code], the override is disabled."
msgstr ""
"ការកំណត់ជំនួសទំហំ 2D នៃ sub-viewport។ ប្រសិនបើទទឹង ឬកម្ពស់ណាមួយគឺ [code]0[/code] "
"ការកំណត់ជំនួសនេះនឹងត្រូវបានបិទ។"

msgid "If [code]true[/code], the 2D size override affects stretch as well."
msgstr ""
"ប្រសិនបើ [code]true[/code] ការកំណត់ជំនួសទំហំ 2D ក៏ប៉ះពាល់ដល់ការពង្រីក (stretch) ផងដែរ។"

msgid ""
"The number of view layers we are rendering to. Set this to [code]2[/code] to "
"enable stereo rendering."
msgstr ""
"ចំនួន view layers ដែលយើងកំពុង render ទៅ។ កំណត់វាទៅជា [code]2[/code] ដើម្បីបើក stereo "
"rendering។"

msgid "Always clear the render target before drawing."
msgstr "តែងតែសម្អាត render target មុនពេលគូរ។"

msgid "Never clear the render target."
msgstr "កុំសម្អាត render target ឡើយ។"

msgid ""
"Clear the render target on the next frame, then switch to [constant "
"CLEAR_MODE_NEVER]."
msgstr ""
"សម្អាត render target នៅលើ frame បន្ទាប់ រួចប្តូរទៅជា [constant CLEAR_MODE_NEVER]។"

msgid "Do not update the render target."
msgstr "កុំធ្វើបច្ចុប្បន្នភាព render target។"

msgid ""
"Update the render target once, then switch to [constant UPDATE_DISABLED]."
msgstr "ធ្វើបច្ចុប្បន្នភាព render target ម្តង រួចប្តូរទៅជា [constant UPDATE_DISABLED]។"

msgid ""
"Update the render target only when it is visible. This is the default value."
msgstr ""
"ធ្វើបច្ចុប្បន្នភាព render target តែនៅពេលដែលវាអាចមើលឃើញប៉ុណ្ណោះ។ នេះគឺជាតម្លៃលំនាំដើម។"

msgid "Update the render target only when its parent is visible."
msgstr "ធ្វើបច្ចុប្បន្នភាព render target តែនៅពេលដែល node មេរបស់វាអាចមើលឃើញប៉ុណ្ណោះ។"

msgid "Always update the render target."
msgstr "តែងតែធ្វើបច្ចុប្បន្នភាព render target។"

msgid "A container used for displaying the contents of a [SubViewport]."
msgstr "container ដែលប្រើសម្រាប់បង្ហាញខ្លឹមសារនៃ [SubViewport]។"

msgid ""
"Virtual method to be implemented by the user. If it returns [code]true[/"
"code], the [param event] is propagated to [SubViewport] children. Propagation "
"doesn't happen if it returns [code]false[/code]. If the function is not "
"implemented, all events are propagated to SubViewports."
msgstr ""
"វិធីសាស្ត្រនិម្មិត (virtual method) ដែលត្រូវអនុវត្តដោយអ្នកប្រើប្រាស់។ ប្រសិនបើវាបង្វិល "
"[code]true[/code], [param event] នឹងត្រូវបានបញ្ជូនបន្តទៅកាន់ children [SubViewport]។ "
"ការបញ្ជូនបន្តមិនកើតឡើងទេ ប្រសិនបើវាបង្វិល [code]false[/code]។ "
"ប្រសិនបើអនុគមន៍នេះមិនត្រូវបានអនុវត្តទេ រាល់ events ទាំងអស់នឹងត្រូវបានបញ្ជូនបន្តទៅកាន់ "
"SubViewports។"

msgid ""
"Configure, if either the [SubViewportContainer] or alternatively the "
"[Control] nodes of its [SubViewport] children should be available as targets "
"of mouse-related functionalities, like identifying the drop target in drag-"
"and-drop operations or cursor shape of hovered [Control] node.\n"
"If [code]false[/code], the [Control] nodes inside its [SubViewport] children "
"are considered as targets.\n"
"If [code]true[/code], the [SubViewportContainer] itself will be considered as "
"a target."
msgstr ""
"កំណត់រចនាសម្ព័ន្ធ ថាតើ [SubViewportContainer] ឬ nodes [Control] នៃ children "
"[SubViewport] របស់វា គួរអាចប្រើបានជាគោលដៅនៃមុខងារដែលទាក់ទងនឹង mouse ដែរឬទេ "
"ដូចជាការកំណត់គោលដៅទម្លាក់ (drop target) នៅក្នុងប្រតិបត្តិការ drag-and-drop ឬរូបរាង cursor "
"នៃ node [Control] ដែលកំពុង hover។\n"
"ប្រសិនបើ [code]false[/code], nodes [Control] នៅខាងក្នុង children [SubViewport] "
"របស់វាត្រូវបានចាត់ទុកថាជាគោលដៅ។\n"
"ប្រសិនបើ [code]true[/code], [SubViewportContainer] ខ្លួនឯងនឹងត្រូវបានចាត់ទុកថាជាគោលដៅ។"

msgid ""
"If [code]true[/code], the sub-viewport will be automatically resized to the "
"control's size.\n"
"[b]Note:[/b] If [code]true[/code], this will prohibit changing [member "
"SubViewport.size] of its children manually."
msgstr ""
"ប្រសិនបើ [code]true[/code], sub-viewport នឹងត្រូវបានផ្លាស់ប្តូរទំហំដោយស្វ័យប្រវត្តិទៅជាទំហំរបស់ "
"control។\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើ [code]true[/code] វានឹងរារាំងការផ្លាស់ប្តូរ [member "
"SubViewport.size] នៃ children របស់វាដោយដៃ។"

msgid ""
"Divides the sub-viewport's effective resolution by this value while "
"preserving its scale. This can be used to speed up rendering.\n"
"For example, a 1280×720 sub-viewport with [member stretch_shrink] set to "
"[code]2[/code] will be rendered at 640×360 while occupying the same size in "
"the container.\n"
"[b]Note:[/b] [member stretch] must be [code]true[/code] for this property to "
"work."
msgstr ""
"ចែក resolution ជាក់ស្តែងរបស់ sub-viewport នឹងតម្លៃនេះ ខណៈពេលដែលរក្សា scale របស់វា។ "
"នេះអាចត្រូវបានប្រើដើម្បីបង្កើនល្បឿន rendering។\n"
"ឧទាហរណ៍ sub-viewport 1280×720 ដែលមាន [member stretch_shrink] កំណត់ទៅជា [code]2[/"
"code] នឹងត្រូវបាន render នៅ 640×360 ខណៈពេលដែលកាន់កាប់ទំហំដូចគ្នានៅក្នុង container។\n"
"[b]ចំណាំ៖[/b] [member stretch] ត្រូវតែជា [code]true[/code] "
"ទើបលក្ខណៈសម្បត្តិនេះដំណើរការ។"

msgid "Helper tool to create geometry."
msgstr "ឧបករណ៍ជំនួយការ (Helper tool) សម្រាប់បង្កើត geometry។"

msgid ""
"The [SurfaceTool] is used to construct a [Mesh] by specifying vertex "
"attributes individually. It can be used to construct a [Mesh] from a script. "
"All properties except indices need to be added before calling [method "
"add_vertex]. For example, to add vertex colors and UVs:\n"
"[codeblocks]\n"
"[gdscript]\n"
"var st = SurfaceTool.new()\n"
"st.begin(Mesh.PRIMITIVE_TRIANGLES)\n"
"st.set_color(Color(1, 0, 0))\n"
"st.set_uv(Vector2(0, 0))\n"
"st.add_vertex(Vector3(0, 0, 0))\n"
"[/gdscript]\n"
"[csharp]\n"
"var st = new SurfaceTool();\n"
"st.Begin(Mesh.PrimitiveType.Triangles);\n"
"st.SetColor(new Color(1, 0, 0));\n"
"st.SetUV(new Vector2(0, 0));\n"
"st.AddVertex(new Vector3(0, 0, 0));\n"
"[/csharp]\n"
"[/codeblocks]\n"
"The above [SurfaceTool] now contains one vertex of a triangle which has a UV "
"coordinate and a specified [Color]. If another vertex were added without "
"calling [method set_uv] or [method set_color], then the last values would be "
"used.\n"
"Vertex attributes must be passed [b]before[/b] calling [method add_vertex]. "
"Failure to do so will result in an error when committing the vertex "
"information to a mesh.\n"
"Additionally, the attributes used before the first vertex is added determine "
"the format of the mesh. For example, if you only add UVs to the first vertex, "
"you cannot add color to any of the subsequent vertices.\n"
"See also [ArrayMesh], [ImmediateMesh] and [MeshDataTool] for procedural "
"geometry generation.\n"
"[b]Note:[/b] Godot uses clockwise [url=https://learnopengl.com/Advanced-"
"OpenGL/Face-culling]winding order[/url] for front faces of triangle primitive "
"modes."
msgstr ""
"[SurfaceTool] ត្រូវបានប្រើដើម្បីបង្កើត [Mesh] ដោយបញ្ជាក់ vertex attributes "
"នីមួយៗដាច់ដោយឡែក។ វាអាចត្រូវបានប្រើដើម្បីបង្កើត [Mesh] ពី script។ "
"លក្ខណៈសម្បត្តិទាំងអស់លើកលែងតែ indices ត្រូវតែបន្ថែមមុនពេលហៅ [method add_vertex]។ ឧទាហរណ៍ "
"ដើម្បីបន្ថែមពណ៌ vertex និង UVs៖\n"
"[codeblocks]\n"
"[gdscript]\n"
"var st = SurfaceTool.new()\n"
"st.begin(Mesh.PRIMITIVE_TRIANGLES)\n"
"st.set_color(Color(1, 0, 0))\n"
"st.set_uv(Vector2(0, 0))\n"
"st.add_vertex(Vector3(0, 0, 0))\n"
"[/gdscript]\n"
"[csharp]\n"
"var st = new SurfaceTool();\n"
"st.Begin(Mesh.PrimitiveType.Triangles);\n"
"st.SetColor(new Color(1, 0, 0));\n"
"st.SetUV(new Vector2(0, 0));\n"
"st.AddVertex(new Vector3(0, 0, 0));\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[SurfaceTool] ខាងលើឥឡូវនេះមាន vertex មួយនៃត្រីកោណដែលមានកូអរដោនេ UV និង [Color] "
"ដែលបានបញ្ជាក់។ ប្រសិនបើ vertex មួយទៀតត្រូវបានបន្ថែមដោយមិនហៅ [method set_uv] ឬ [method "
"set_color] នោះតម្លៃចុងក្រោយនឹងត្រូវបានប្រើ។\n"
"Vertex attributes ត្រូវតែបញ្ជូន [b]មុន[/b] ពេលហៅ [method add_vertex]។ "
"ការខកខានមិនធ្វើដូច្នេះនឹងបណ្តាលឱ្យមានកំហុសនៅពេល commit ព័ត៌មាន vertex ទៅកាន់ mesh។\n"
"លើសពីនេះ attributes ដែលបានប្រើមុនពេល vertex ទីមួយត្រូវបានបន្ថែម កំណត់ទម្រង់ (format) នៃ "
"mesh។ ឧទាហរណ៍ ប្រសិនបើអ្នកបន្ថែមតែ UVs ទៅកាន់ vertex ទីមួយ អ្នកមិនអាចបន្ថែមពណ៌ទៅកាន់ "
"vertices បន្តបន្ទាប់ណាមួយបានទេ។\n"
"សូមមើលផងដែរ [ArrayMesh], [ImmediateMesh] និង [MeshDataTool] សម្រាប់ការបង្កើត "
"geometry តាមនីតិវិធី (procedural)។\n"
"[b]ចំណាំ៖[/b] Godot ប្រើ [url=https://learnopengl.com/Advanced-OpenGL/Face-"
"culling]winding order[/url] ស្របទ្រនិចនាឡិកា សម្រាប់មុខខាងមុខនៃ triangle primitive "
"modes។"

msgid "Using the SurfaceTool"
msgstr "ការប្រើប្រាស់ SurfaceTool"

msgid ""
"Adds a vertex to index array if you are using indexed vertices. Does not need "
"to be called before adding vertices."
msgstr ""
"បន្ថែម vertex ទៅក្នុង index array ប្រសិនបើអ្នកកំពុងប្រើ indexed vertices។ "
"មិនចាំបាច់ហៅមុនពេលបន្ថែម vertices ទេ។"

msgid ""
"Inserts a triangle fan made of array data into [Mesh] being constructed.\n"
"Requires the primitive type be set to [constant Mesh.PRIMITIVE_TRIANGLES]."
msgstr ""
"បញ្ចូល triangle fan ដែលធ្វើពីទិន្នន័យ array ទៅក្នុង [Mesh] ដែលកំពុងត្រូវបានបង្កើត។\n"
"ទាមទារឱ្យ primitive type ត្រូវបានកំណត់ទៅជា [constant Mesh.PRIMITIVE_TRIANGLES]។"

msgid ""
"Specifies the position of current vertex. Should be called after specifying "
"other vertex properties (e.g. Color, UV)."
msgstr ""
"បញ្ជាក់ទីតាំងនៃ vertex បច្ចុប្បន្ន។ គួរតែត្រូវបានហៅបន្ទាប់ពីការបញ្ជាក់លក្ខណៈសម្បត្តិ vertex "
"ផ្សេងទៀត (ឧ. Color, UV)។"

msgid ""
"Append vertices from a given [Mesh] surface onto the current vertex array "
"with specified [Transform3D]."
msgstr ""
"បន្ថែម (append) vertices ពីផ្ទៃ (surface) នៃ [Mesh] ដែលបានផ្តល់ឱ្យ ទៅលើ vertex "
"array បច្ចុប្បន្នជាមួយនឹង [Transform3D] ដែលបានបញ្ជាក់។"

msgid ""
"Called before adding any vertices. Takes the primitive type as an argument "
"(e.g. [constant Mesh.PRIMITIVE_TRIANGLES])."
msgstr ""
"ត្រូវបានហៅមុនពេលបន្ថែម vertices ណាមួយ។ យក primitive type ជាអាគុយម៉ង់ (ឧ. [constant "
"Mesh.PRIMITIVE_TRIANGLES])។"

msgid "Clear all information passed into the surface tool so far."
msgstr "សម្អាតព័ត៌មានទាំងអស់ដែលបានបញ្ជូនទៅកាន់ surface tool រហូតមកដល់ពេលនេះ។"

msgid ""
"Returns a constructed [ArrayMesh] from current information passed in. If an "
"existing [ArrayMesh] is passed in as an argument, will add an extra surface "
"to the existing [ArrayMesh].\n"
"The [param flags] argument can be the bitwise OR of [constant "
"Mesh.ARRAY_FLAG_USE_DYNAMIC_UPDATE], [constant "
"Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS], or [constant "
"Mesh.ARRAY_FLAG_USES_EMPTY_VERTEX_ARRAY]."
msgstr ""
"បង្វិល [ArrayMesh] ដែលបានបង្កើតពីព័ត៌មានបច្ចុប្បន្នដែលបានបញ្ជូនចូល។ ប្រសិនបើ [ArrayMesh] "
"ដែលមានស្រាប់ត្រូវបានបញ្ជូនចូលជាអាគុយម៉ង់ វានឹងបន្ថែម surface បន្ថែមទៅក្នុង [ArrayMesh] "
"ដែលមានស្រាប់។\n"
"អាគុយម៉ង់ [param flags] អាចជា bitwise OR នៃ [constant "
"Mesh.ARRAY_FLAG_USE_DYNAMIC_UPDATE], [constant "
"Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS] ឬ [constant "
"Mesh.ARRAY_FLAG_USES_EMPTY_VERTEX_ARRAY]។"

msgid ""
"Commits the data to the same format used by [method "
"ArrayMesh.add_surface_from_arrays], [method ImporterMesh.add_surface], and "
"[method create_from_arrays]. This way you can further process the mesh data "
"using the [ArrayMesh] or [ImporterMesh] APIs."
msgstr ""
"commit ទិន្នន័យទៅក្នុងទម្រង់ដូចគ្នាដែលប្រើដោយ [method "
"ArrayMesh.add_surface_from_arrays], [method ImporterMesh.add_surface] និង "
"[method create_from_arrays]។ តាមវិធីនេះ អ្នកអាចដំណើរការទិន្នន័យ mesh បន្ថែមទៀតដោយប្រើ "
"APIs របស់ [ArrayMesh] ឬ [ImporterMesh]។"

msgid "Creates a vertex array from an existing [Mesh]."
msgstr "បង្កើត vertex array ពី [Mesh] ដែលមានស្រាប់។"

msgid ""
"Creates this SurfaceTool from existing vertex arrays such as returned by "
"[method commit_to_arrays], [method Mesh.surface_get_arrays], [method "
"Mesh.surface_get_blend_shape_arrays], [method "
"ImporterMesh.get_surface_arrays], and [method "
"ImporterMesh.get_surface_blend_shape_arrays]. [param primitive_type] controls "
"the type of mesh data, defaulting to [constant Mesh.PRIMITIVE_TRIANGLES]."
msgstr ""
"បង្កើត SurfaceTool នេះពី vertex arrays ដែលមានស្រាប់ ដូចជាអ្វីដែលបង្វិលដោយ [method "
"commit_to_arrays], [method Mesh.surface_get_arrays], [method "
"Mesh.surface_get_blend_shape_arrays], [method "
"ImporterMesh.get_surface_arrays] និង [method "
"ImporterMesh.get_surface_blend_shape_arrays]។ [param primitive_type] "
"គ្រប់គ្រងប្រភេទនៃទិន្នន័យ mesh ដែលមានលំនាំដើមជា [constant Mesh.PRIMITIVE_TRIANGLES]។"

msgid ""
"Creates a vertex array from the specified blend shape of an existing [Mesh]. "
"This can be used to extract a specific pose from a blend shape."
msgstr ""
"បង្កើត vertex array ពី blend shape ដែលបានបញ្ជាក់នៃ [Mesh] ដែលមានស្រាប់។ "
"នេះអាចត្រូវបានប្រើដើម្បីទាញយក pose ជាក់លាក់មួយពី blend shape។"

msgid "Removes the index array by expanding the vertex array."
msgstr "ដក index array ចេញដោយពង្រីក vertex array។"

msgid ""
"This method is unused internally, as it does not preserve normals or UVs. "
"Consider using [method ImporterMesh.generate_lods] instead."
msgstr ""
"វិធីសាស្ត្រនេះមិនត្រូវបានប្រើប្រាស់ខាងក្នុងទេ ព្រោះវាមិនរក្សាទុក normals ឬ UVs ទេ។ "
"សូមពិចារណាប្រើ [method ImporterMesh.generate_lods] ជំនួសវិញ។"

msgid ""
"Generates an LOD for a given [param nd_threshold] in linear units (square "
"root of quadric error metric), using at most [param target_index_count] "
"indices."
msgstr ""
"បង្កើត LOD សម្រាប់ [param nd_threshold] ដែលបានផ្តល់ឱ្យជាខ្នាតលីនេអ៊ែរ (ឫសការេនៃ "
"quadric error metric) ដោយប្រើយ៉ាងច្រើនបំផុត [param target_index_count] indices។"

msgid ""
"Generates normals from vertices so you do not have to do it manually. If "
"[param flip] is [code]true[/code], the resulting normals will be inverted. "
"[method generate_normals] should be called [i]after[/i] generating geometry "
"and [i]before[/i] committing the mesh using [method commit] or [method "
"commit_to_arrays]. For correct display of normal-mapped surfaces, you will "
"also have to generate tangents using [method generate_tangents].\n"
"[b]Note:[/b] [method generate_normals] only works if the primitive type is "
"set to [constant Mesh.PRIMITIVE_TRIANGLES].\n"
"[b]Note:[/b] [method generate_normals] takes smooth groups into account. To "
"generate smooth normals, set the smooth group to a value greater than or "
"equal to [code]0[/code] using [method set_smooth_group] or leave the smooth "
"group at the default of [code]0[/code]. To generate flat normals, set the "
"smooth group to [code]-1[/code] using [method set_smooth_group] prior to "
"adding vertices."
msgstr ""
"បង្កើត normals ពី vertices ដើម្បីកុំឱ្យអ្នកធ្វើវាដោយដៃ។ ប្រសិនបើ [param flip] គឺ "
"[code]true[/code], normals ដែលទទួលបាននឹងត្រូវបានប្តូរទិស (inverted)។ [method "
"generate_normals] គួរតែត្រូវបានហៅ [i]បន្ទាប់ពី[/i] ការបង្កើត geometry និង [i]មុនពេល[/"
"i] commit mesh ដោយប្រើ [method commit] ឬ [method commit_to_arrays]។ "
"សម្រាប់ការបង្ហាញផ្ទៃ normal-mapped ឱ្យបានត្រឹមត្រូវ អ្នកក៏ត្រូវបង្កើត tangents ដោយប្រើ "
"[method generate_tangents] ផងដែរ។\n"
"[b]ចំណាំ៖[/b] [method generate_normals] ដំណើរការតែនៅពេលដែល primitive type "
"ត្រូវបានកំណត់ទៅជា [constant Mesh.PRIMITIVE_TRIANGLES] ប៉ុណ្ណោះ។\n"
"[b]ចំណាំ៖[/b] [method generate_normals] យក smooth groups មកគណនាផងដែរ។ ដើម្បីបង្កើត "
"smooth normals សូមកំណត់ smooth group ទៅជាតម្លៃធំជាង ឬស្មើ [code]0[/code] ដោយប្រើ "
"[method set_smooth_group] ឬទុក smooth group នៅតម្លៃលំនាំដើម [code]0[/code]។ "
"ដើម្បីបង្កើត flat normals សូមកំណត់ smooth group ទៅជា [code]-1[/code] ដោយប្រើ [method "
"set_smooth_group] មុនពេលបន្ថែម vertices។"

msgid ""
"Generates a tangent vector for each vertex. Requires that each vertex already "
"has UVs and normals set (see [method generate_normals])."
msgstr ""
"បង្កើត tangent vector សម្រាប់ vertex នីមួយៗ។ ទាមទារឱ្យ vertex នីមួយៗមានការកំណត់ UVs និង "
"normals រួចជាស្រេច (សូមមើល [method generate_normals])។"

msgid "Returns the axis-aligned bounding box of the vertex positions."
msgstr "បង្វិល axis-aligned bounding box នៃទីតាំង vertex។"

msgid ""
"Returns the format for custom [param channel_index] (currently up to 4). "
"Returns [constant CUSTOM_MAX] if this custom channel is unused."
msgstr ""
"បង្វិលទម្រង់សម្រាប់ [param channel_index] ផ្ទាល់ខ្លួន (បច្ចុប្បន្នរហូតដល់ 4)។ បង្វិល [constant "
"CUSTOM_MAX] ប្រសិនបើ custom channel នេះមិនត្រូវបានប្រើប្រាស់។"

msgid ""
"Returns the type of mesh geometry, such as [constant "
"Mesh.PRIMITIVE_TRIANGLES]."
msgstr "បង្វិលប្រភេទនៃ mesh geometry ដូចជា [constant Mesh.PRIMITIVE_TRIANGLES]។"

msgid ""
"By default, returns [constant SKIN_4_WEIGHTS] to indicate only 4 bone "
"influences per vertex are used.\n"
"Returns [constant SKIN_8_WEIGHTS] if up to 8 influences are used.\n"
"[b]Note:[/b] This function returns an enum, not the exact number of weights."
msgstr ""
"តាមលំនាំដើម បង្វិល [constant SKIN_4_WEIGHTS] ដើម្បីបញ្ជាក់ថាមានតែឥទ្ធិពលឆ្អឹង (bone "
"influences) 4 ក្នុងមួយ vertex ប៉ុណ្ណោះដែលត្រូវបានប្រើ។\n"
"បង្វិល [constant SKIN_8_WEIGHTS] ប្រសិនបើឥទ្ធិពលរហូតដល់ 8 ត្រូវបានប្រើ។\n"
"[b]ចំណាំ៖[/b] អនុគមន៍នេះបង្វិល enum មិនមែនជាចំនួនពិតប្រាកដនៃ weights ទេ។"

msgid ""
"Shrinks the vertex array by creating an index array. This can improve "
"performance by avoiding vertex reuse."
msgstr ""
"បង្រួម vertex array ដោយបង្កើត index array។ នេះអាចកែលម្អដំណើរការដោយជៀសវាងការប្រើ "
"vertex ឡើងវិញ។"

msgid ""
"Optimizes triangle sorting for performance. Requires that [method "
"get_primitive_type] is [constant Mesh.PRIMITIVE_TRIANGLES]."
msgstr ""
"កែលម្អ (optimize) ការតម្រៀបត្រីកោណដើម្បីបង្កើនដំណើរការ។ ទាមទារឱ្យ [method "
"get_primitive_type] គឺជា [constant Mesh.PRIMITIVE_TRIANGLES]។"

msgid ""
"Specifies an array of bones to use for the [i]next[/i] vertex. [param bones] "
"must contain 4 integers."
msgstr ""
"បញ្ជាក់ array នៃឆ្អឹង (bones) ដែលត្រូវប្រើសម្រាប់ vertex [i]បន្ទាប់[/i]។ [param bones] "
"ត្រូវតែមានចំនួនគត់ 4។"

msgid ""
"Specifies a [Color] to use for the [i]next[/i] vertex. If every vertex needs "
"to have this information set and you fail to submit it for the first vertex, "
"this information may not be used at all.\n"
"[b]Note:[/b] The material must have [member "
"BaseMaterial3D.vertex_color_use_as_albedo] enabled for the vertex color to be "
"visible."
msgstr ""
"បញ្ជាក់ [Color] ដើម្បីប្រើសម្រាប់ vertex [i]បន្ទាប់[/i]។ ប្រសិនបើ vertex "
"នីមួយៗត្រូវការកំណត់ព័ត៌មាននេះ ហើយអ្នកមិនបានបញ្ជូនវាសម្រាប់ vertex ទីមួយទេ "
"ព័ត៌មាននេះអាចនឹងមិនត្រូវបានប្រើប្រាស់សោះឡើយ។\n"
"[b]ចំណាំ៖[/b] material ត្រូវតែបើក [member "
"BaseMaterial3D.vertex_color_use_as_albedo] ដើម្បីឱ្យពណ៌ vertex អាចមើលឃើញ។"

msgid ""
"Sets the custom value on this vertex for [param channel_index].\n"
"[method set_custom_format] must be called first for this [param "
"channel_index]. Formats which are not RGBA will ignore other color channels."
msgstr ""
"កំណត់តម្លៃផ្ទាល់ខ្លួនលើ vertex នេះសម្រាប់ [param channel_index]។\n"
"[method set_custom_format] ត្រូវតែត្រូវបានហៅជាមុនសិនសម្រាប់ [param channel_index] "
"នេះ។ ទម្រង់ដែលមិនមែនជា RGBA នឹងមិនអើពើនឹង color channels ផ្សេងទៀតទេ។"

msgid ""
"Sets the color format for this custom [param channel_index]. Use [constant "
"CUSTOM_MAX] to disable.\n"
"Must be invoked after [method begin] and should be set before [method commit] "
"or [method commit_to_arrays]."
msgstr ""
"កំណត់ទម្រង់ពណ៌សម្រាប់ [param channel_index] ផ្ទាល់ខ្លួននេះ។ ប្រើ [constant CUSTOM_MAX] "
"ដើម្បីបិទ។\n"
"ត្រូវតែហៅបន្ទាប់ពី [method begin] ហើយគួរតែកំណត់មុនពេល [method commit] ឬ [method "
"commit_to_arrays]។"

msgid "Sets [Material] to be used by the [Mesh] you are constructing."
msgstr "កំណត់ [Material] ដែលត្រូវប្រើដោយ [Mesh] ដែលអ្នកកំពុងបង្កើត។"

msgid ""
"Specifies a normal to use for the [i]next[/i] vertex. If every vertex needs "
"to have this information set and you fail to submit it for the first vertex, "
"this information may not be used at all."
msgstr ""
"បញ្ជាក់ normal ដើម្បីប្រើសម្រាប់ vertex [i]បន្ទាប់[/i]។ ប្រសិនបើ vertex "
"នីមួយៗត្រូវការកំណត់ព័ត៌មាននេះ ហើយអ្នកមិនបានបញ្ជូនវាសម្រាប់ vertex ទីមួយទេ "
"ព័ត៌មាននេះអាចនឹងមិនត្រូវបានប្រើប្រាស់សោះឡើយ។"

msgid ""
"Set to [constant SKIN_8_WEIGHTS] to indicate that up to 8 bone influences per "
"vertex may be used.\n"
"By default, only 4 bone influences are used ([constant SKIN_4_WEIGHTS]).\n"
"[b]Note:[/b] This function takes an enum, not the exact number of weights."
msgstr ""
"កំណត់ទៅជា [constant SKIN_8_WEIGHTS] ដើម្បីបញ្ជាក់ថាឥទ្ធិពលឆ្អឹងរហូតដល់ 8 ក្នុងមួយ vertex "
"អាចត្រូវបានប្រើ។\n"
"តាមលំនាំដើម មានតែឥទ្ធិពលឆ្អឹង 4 ប៉ុណ្ណោះដែលត្រូវបានប្រើ ([constant SKIN_4_WEIGHTS])។\n"
"[b]ចំណាំ៖[/b] អនុគមន៍នេះយក enum មិនមែនជាចំនួនពិតប្រាកដនៃ weights ទេ។"

msgid ""
"Specifies the smooth group to use for the [i]next[/i] vertex. If this is "
"never called, all vertices will have the default smooth group of [code]0[/"
"code] and will be smoothed with adjacent vertices of the same group. To "
"produce a mesh with flat normals, set the smooth group to [code]-1[/code].\n"
"[b]Note:[/b] This function actually takes a [code]uint32_t[/code], so C# "
"users should use [code]uint32.MaxValue[/code] instead of [code]-1[/code] to "
"produce a mesh with flat normals."
msgstr ""
"បញ្ជាក់ smooth group ដើម្បីប្រើសម្រាប់ vertex [i]បន្ទាប់[/i]។ ប្រសិនបើវាមិនដែលត្រូវបានហៅទេ "
"vertices ទាំងអស់នឹងមាន smooth group លំនាំដើមគឺ [code]0[/code] ហើយនឹងត្រូវបានធ្វើឱ្យរលូន "
"(smoothed) ជាមួយ vertices ដែលជាប់គ្នានៃ group ដូចគ្នា។ ដើម្បីបង្កើត mesh ដែលមាន flat "
"normals សូមកំណត់ smooth group ទៅជា [code]-1[/code]។\n"
"[b]ចំណាំ៖[/b] អនុគមន៍នេះតាមពិតយក [code]uint32_t[/code] ដូច្នេះអ្នកប្រើ C# គួរតែប្រើ "
"[code]uint32.MaxValue[/code] ជំនួសឱ្យ [code]-1[/code] ដើម្បីបង្កើត mesh ដែលមាន flat "
"normals។"

msgid ""
"Specifies a tangent to use for the [i]next[/i] vertex. If every vertex needs "
"to have this information set and you fail to submit it for the first vertex, "
"this information may not be used at all.\n"
"[b]Note:[/b] Even though [param tangent] is a [Plane], it does not directly "
"represent the tangent plane. Its [member Plane.x], [member Plane.y], and "
"[member Plane.z] represent the tangent vector and [member Plane.d] should be "
"either [code]-1[/code] or [code]1[/code]. See also [constant "
"Mesh.ARRAY_TANGENT]."
msgstr ""
"បញ្ជាក់ tangent ដើម្បីប្រើសម្រាប់ vertex [i]បន្ទាប់[/i]។ ប្រសិនបើ vertex "
"នីមួយៗត្រូវការកំណត់ព័ត៌មាននេះ ហើយអ្នកមិនបានបញ្ជូនវាសម្រាប់ vertex ទីមួយទេ "
"ព័ត៌មាននេះអាចនឹងមិនត្រូវបានប្រើប្រាស់សោះឡើយ។\n"
"[b]ចំណាំ៖[/b] ទោះបីជា [param tangent] គឺជា [Plane] ក៏ដោយ វាមិនតំណាងឱ្យ tangent plane "
"ដោយផ្ទាល់ទេ។ [member Plane.x], [member Plane.y] និង [member Plane.z] របស់វាតំណាងឱ្យ "
"tangent vector ហើយ [member Plane.d] គួរតែជា [code]-1[/code] ឬ [code]1[/code]។ "
"សូមមើលផងដែរ [constant Mesh.ARRAY_TANGENT]។"

msgid ""
"Specifies a set of UV coordinates to use for the [i]next[/i] vertex. If every "
"vertex needs to have this information set and you fail to submit it for the "
"first vertex, this information may not be used at all."
msgstr ""
"បញ្ជាក់សំណុំនៃកូអរដោនេ UV ដើម្បីប្រើសម្រាប់ vertex [i]បន្ទាប់[/i]។ ប្រសិនបើ vertex "
"នីមួយៗត្រូវការកំណត់ព័ត៌មាននេះ ហើយអ្នកមិនបានបញ្ជូនវាសម្រាប់ vertex ទីមួយទេ "
"ព័ត៌មាននេះអាចនឹងមិនត្រូវបានប្រើប្រាស់សោះឡើយ។"

msgid ""
"Specifies an optional second set of UV coordinates to use for the [i]next[/i] "
"vertex. If every vertex needs to have this information set and you fail to "
"submit it for the first vertex, this information may not be used at all."
msgstr ""
"បញ្ជាក់សំណុំនៃកូអរដោនេ UV ទីពីរជាជម្រើស ដើម្បីប្រើសម្រាប់ vertex [i]បន្ទាប់[/i]។ ប្រសិនបើ "
"vertex នីមួយៗត្រូវការកំណត់ព័ត៌មាននេះ ហើយអ្នកមិនបានបញ្ជូនវាសម្រាប់ vertex ទីមួយទេ "
"ព័ត៌មាននេះអាចនឹងមិនត្រូវបានប្រើប្រាស់សោះឡើយ។"

msgid ""
"Specifies weight values to use for the [i]next[/i] vertex. [param weights] "
"must contain 4 values. If every vertex needs to have this information set and "
"you fail to submit it for the first vertex, this information may not be used "
"at all."
msgstr ""
"បញ្ជាក់តម្លៃ weight ដើម្បីប្រើសម្រាប់ vertex [i]បន្ទាប់[/i]។ [param weights] "
"ត្រូវតែមានតម្លៃ 4។ ប្រសិនបើ vertex នីមួយៗត្រូវការកំណត់ព័ត៌មាននេះ ហើយអ្នកមិនបានបញ្ជូនវាសម្រាប់ "
"vertex ទីមួយទេ ព័ត៌មាននេះអាចនឹងមិនត្រូវបានប្រើប្រាស់សោះឡើយ។"

msgid ""
"Limits range of data passed to [method set_custom] to unsigned normalized 0 "
"to 1 stored in 8 bits per channel. See [constant "
"Mesh.ARRAY_CUSTOM_RGBA8_UNORM]."
msgstr ""
"កំណត់ដែនកំណត់នៃទិន្នន័យដែលបានបញ្ជូនទៅកាន់ [method set_custom] ទៅជា unsigned normalized "
"0 ដល់ 1 ដែលរក្សាទុកក្នុង 8 bits ក្នុងមួយ channel។ សូមមើល [constant "
"Mesh.ARRAY_CUSTOM_RGBA8_UNORM]។"

msgid ""
"Limits range of data passed to [method set_custom] to signed normalized -1 to "
"1 stored in 8 bits per channel. See [constant Mesh.ARRAY_CUSTOM_RGBA8_SNORM]."
msgstr ""
"កំណត់ដែនកំណត់នៃទិន្នន័យដែលបានបញ្ជូនទៅកាន់ [method set_custom] ទៅជា signed normalized -1 "
"ដល់ 1 ដែលរក្សាទុកក្នុង 8 bits ក្នុងមួយ channel។ សូមមើល [constant "
"Mesh.ARRAY_CUSTOM_RGBA8_SNORM]។"

msgid ""
"Stores data passed to [method set_custom] as half precision floats, and uses "
"only red and green color channels. See [constant Mesh.ARRAY_CUSTOM_RG_HALF]."
msgstr ""
"រក្សាទុកទិន្នន័យដែលបានបញ្ជូនទៅកាន់ [method set_custom] ជា half precision floats "
"ហើយប្រើតែ color channels ពណ៌ក្រហម និងបៃតងប៉ុណ្ណោះ។ សូមមើល [constant "
"Mesh.ARRAY_CUSTOM_RG_HALF]។"

msgid ""
"Stores data passed to [method set_custom] as half precision floats and uses "
"all color channels. See [constant Mesh.ARRAY_CUSTOM_RGBA_HALF]."
msgstr ""
"រក្សាទុកទិន្នន័យដែលបានបញ្ជូនទៅកាន់ [method set_custom] ជា half precision floats "
"ហើយប្រើ color channels ទាំងអស់។ សូមមើល [constant Mesh.ARRAY_CUSTOM_RGBA_HALF]។"

msgid ""
"Stores data passed to [method set_custom] as full precision floats, and uses "
"only red color channel. See [constant Mesh.ARRAY_CUSTOM_R_FLOAT]."
msgstr ""
"រក្សាទុកទិន្នន័យដែលបានបញ្ជូនទៅកាន់ [method set_custom] ជា full precision floats "
"ហើយប្រើតែ color channel ពណ៌ក្រហមប៉ុណ្ណោះ។ សូមមើល [constant "
"Mesh.ARRAY_CUSTOM_R_FLOAT]។"

msgid ""
"Stores data passed to [method set_custom] as full precision floats, and uses "
"only red and green color channels. See [constant Mesh.ARRAY_CUSTOM_RG_FLOAT]."
msgstr ""
"រក្សាទុកទិន្នន័យដែលបានបញ្ជូនទៅកាន់ [method set_custom] ជា full precision floats "
"ហើយប្រើតែ color channels ពណ៌ក្រហម និងបៃតងប៉ុណ្ណោះ។ សូមមើល [constant "
"Mesh.ARRAY_CUSTOM_RG_FLOAT]។"

msgid ""
"Stores data passed to [method set_custom] as full precision floats, and uses "
"only red, green and blue color channels. See [constant "
"Mesh.ARRAY_CUSTOM_RGB_FLOAT]."
msgstr ""
"រក្សាទុកទិន្នន័យដែលបានបញ្ជូនទៅកាន់ [method set_custom] ជា full precision floats "
"ហើយប្រើតែ color channels ពណ៌ក្រហម បៃតង និងខៀវប៉ុណ្ណោះ។ សូមមើល [constant "
"Mesh.ARRAY_CUSTOM_RGB_FLOAT]។"

msgid ""
"Stores data passed to [method set_custom] as full precision floats, and uses "
"all color channels. See [constant Mesh.ARRAY_CUSTOM_RGBA_FLOAT]."
msgstr ""
"រក្សាទុកទិន្នន័យដែលបានបញ្ជូនទៅកាន់ [method set_custom] ជា full precision floats "
"ហើយប្រើ color channels ទាំងអស់។ សូមមើល [constant Mesh.ARRAY_CUSTOM_RGBA_FLOAT]។"

msgid "Used to indicate a disabled custom channel."
msgstr "ប្រើដើម្បីបញ្ជាក់ពី custom channel ដែលបានបិទ។"

msgid "Each individual vertex can be influenced by only 4 bone weights."
msgstr "vertex នីមួយៗអាចរងឥទ្ធិពលដោយ bone weights តែ 4 ប៉ុណ្ណោះ។"

msgid "Each individual vertex can be influenced by up to 8 bone weights."
msgstr "vertex នីមួយៗអាចរងឥទ្ធិពលដោយ bone weights រហូតដល់ 8។"

msgid ""
"Base class for syntax highlighters. Provides syntax highlighting data to a "
"[TextEdit]."
msgstr ""
"class គោលសម្រាប់ syntax highlighters។ ផ្តល់ទិន្នន័យ syntax highlighting ទៅកាន់ "
"[TextEdit]។"

msgid ""
"Base class for syntax highlighters. Provides syntax highlighting data to a "
"[TextEdit]. The associated [TextEdit] will call into the [SyntaxHighlighter] "
"on an as-needed basis.\n"
"[b]Note:[/b] A [SyntaxHighlighter] instance should not be used across "
"multiple [TextEdit] nodes."
msgstr ""
"Class គោលសម្រាប់ syntax highlighters។ ផ្តល់ទិន្នន័យ syntax highlighting ទៅកាន់ "
"[TextEdit]។ [TextEdit] ដែលទាក់ទងនឹងហៅទៅកាន់ [SyntaxHighlighter] នៅពេលចាំបាច់។\n"
"[b]ចំណាំ៖[/b] ធាតុ [SyntaxHighlighter] មិនគួរត្រូវបានប្រើឆ្លងកាត់ថ្នាំង [TextEdit] "
"ជាច្រើនទេ។"

msgid "Virtual method which can be overridden to clear any local caches."
msgstr ""
"វិធីសាស្ត្រនិម្មិត (virtual method) ដែលអាចត្រូវបានកែប្រែ (overridden) ដើម្បីសម្អាត local "
"caches ណាមួយ។"

msgid ""
"Virtual method which can be overridden to return syntax highlighting data.\n"
"See [method get_line_syntax_highlighting] for more details."
msgstr ""
"វិធីសាស្ត្រនិម្មិតដែលអាចត្រូវបានកែប្រែដើម្បីបង្វិលទិន្នន័យ syntax highlighting។\n"
"សូមមើល [method get_line_syntax_highlighting] សម្រាប់ព័ត៌មានលម្អិតបន្ថែម។"

msgid "Virtual method which can be overridden to update any local caches."
msgstr "វិធីសាស្ត្រនិម្មិតដែលអាចត្រូវបានកែប្រែដើម្បីធ្វើបច្ចុប្បន្នភាព local caches ណាមួយ។"

msgid ""
"Clears all cached syntax highlighting data.\n"
"Then calls overridable method [method _clear_highlighting_cache]."
msgstr ""
"សម្អាតទិន្នន័យ syntax highlighting ដែលបាន cache ទាំងអស់។\n"
"បន្ទាប់មកហៅវិធីសាស្ត្រដែលអាចកែប្រែបាន [method _clear_highlighting_cache]។"

msgid "Returns the associated [TextEdit] node."
msgstr "បង្វិល node [TextEdit] ដែលទាក់ទង។"

msgid ""
"Clears then updates the [SyntaxHighlighter] caches. Override [method "
"_update_cache] for a callback.\n"
"[b]Note:[/b] This is called automatically when the associated [TextEdit] "
"node, updates its own cache."
msgstr ""
"សម្អាត រួចធ្វើបច្ចុប្បន្នភាព caches របស់ [SyntaxHighlighter]។ កែប្រែ (Override) "
"[method _update_cache] សម្រាប់ callback។\n"
"[b]ចំណាំ៖[/b] វាត្រូវបានហៅដោយស្វ័យប្រវត្តិនៅពេលដែល node [TextEdit] ដែលទាក់ទង "
"ធ្វើបច្ចុប្បន្នភាព cache របស់វា។"

msgid ""
"A font loaded from a system font. Falls back to a default theme font if not "
"implemented on the host OS."
msgstr ""
"font ដែលបានផ្ទុកពី system font។ ត្រឡប់ទៅប្រើ theme font លំនាំដើម ប្រសិនបើមិនបានអនុវត្តនៅលើ "
"OS ម៉ាស៊ីន។"

msgid ""
"[SystemFont] loads a font from a system font with the first matching name "
"from [member font_names].\n"
"It will attempt to match font style, but it's not guaranteed.\n"
"The returned font might be part of a font collection or be a variable font "
"with OpenType \"weight\", \"width\" and/or \"italic\" features set.\n"
"You can create [FontVariation] of the system font for precise control over "
"its features.\n"
"[b]Note:[/b] This class is implemented on iOS, Linux, macOS and Windows, on "
"other platforms it will fallback to default theme font."
msgstr ""
"[SystemFont] ផ្ទុក font ពី system font ដែលមានឈ្មោះផ្គូផ្គងដំបូងគេពី [member "
"font_names]។\n"
"វានឹងព្យាយាមផ្គូផ្គងរចនាប័ទ្ម font (font style) ប៉ុន្តែវាមិនត្រូវបានធានាទេ។\n"
"font ដែលបានបង្វិលអាចជាផ្នែកមួយនៃ font collection ឬជា variable font "
"ដែលបានកំណត់លក្ខណៈពិសេស OpenType \"weight\", \"width\" និង/ឬ \"italic\"។\n"
"អាចបង្កើត [FontVariation] នៃ system font "
"សម្រាប់ការគ្រប់គ្រងជាក់លាក់លើលក្ខណៈពិសេសរបស់វា។\n"
"[b]ចំណាំ៖[/b] class នេះត្រូវបានអនុវត្តនៅលើ iOS, Linux, macOS និង Windows "
"នៅលើវេទិកាផ្សេងទៀតវានឹងត្រឡប់ ទៅប្រើ theme font លំនាំដើម។"

msgid "If set to [code]true[/code], italic or oblique font is preferred."
msgstr ""
"ប្រសិនបើកំណត់ទៅជា [code]true[/code] font ប្រភេទ italic ឬ oblique ត្រូវបានចូលចិត្តជាង។"

msgid "Array of font family names to search, first matching font found is used."
msgstr "Array នៃឈ្មោះ font family ដើម្បីស្វែងរក font ដែលផ្គូផ្គងដំបូងគេនឹងត្រូវបានប្រើ។"

msgid ""
"Preferred font stretch amount, compared to a normal width. A percentage value "
"between [code]50%[/code] and [code]200%[/code]."
msgstr ""
"ចំនួនពង្រីក (stretch) font ដែលចូលចិត្ត បើធៀបនឹងទទឹងធម្មតា។ ជាតម្លៃភាគរយចន្លោះពី [code]50%[/"
"code] ដល់ [code]200%[/code]។"

msgid ""
"Preferred weight (boldness) of the font. A value in the [code]100...999[/"
"code] range, normal font weight is [code]400[/code], bold font weight is "
"[code]700[/code]."
msgstr ""
"ទម្ងន់ (weight / boldness) នៃ font ដែលចូលចិត្ត។ តម្លៃនៅក្នុងចន្លោះ [code]100...999[/"
"code] ទម្ងន់ font ធម្មតាគឺ [code]400[/code] ទម្ងន់ font bold គឺ [code]700[/code]។"

msgid ""
"If set to [code]true[/code], auto-hinting is supported and preferred over "
"font built-in hinting."
msgstr ""
"ប្រសិនបើកំណត់ទៅជា [code]true[/code] auto-hinting ត្រូវបានគាំទ្រ ហើយត្រូវបានចូលចិត្តជាង "
"hinting ដែលមានស្រាប់ក្នុង font។"

msgid "Font hinting mode."
msgstr "របៀប font hinting។"

msgid ""
"If set to [code]true[/code], glyphs of all sizes are rendered using single "
"multichannel signed distance field generated from the dynamic font vector "
"data."
msgstr ""
"ប្រសិនបើកំណត់ទៅជា [code]true[/code] glyphs នៃគ្រប់ទំហំទាំងអស់ត្រូវបាន render ដោយប្រើ "
"single multichannel signed distance field ដែលបង្កើតចេញពីទិន្នន័យ dynamic font "
"vector។"

msgid ""
"Font glyph subpixel positioning mode. Subpixel positioning provides shaper "
"text and better kerning for smaller font sizes, at the cost of memory usage "
"and font rasterization speed. Use [constant "
"TextServer.SUBPIXEL_POSITIONING_AUTO] to automatically enable it based on the "
"font size."
msgstr ""
"របៀបកំណត់ទីតាំង subpixel នៃ font glyph។ ការកំណត់ទីតាំង subpixel "
"ផ្តល់នូវអត្ថបទដែលមានភាពច្បាស់លាស់ជាងមុន និង kerning ល្អជាងមុនសម្រាប់ទំហំ font តូចៗ "
"ដោយចំណាយលើការប្រើប្រាស់អង្គចងចាំ និងល្បឿន font rasterization។ ប្រើ [constant "
"TextServer.SUBPIXEL_POSITIONING_AUTO] ដើម្បីបើកវាដោយស្វ័យប្រវត្តិដោយផ្អែកលើទំហំ font។"

msgid "A control that provides a horizontal bar with tabs."
msgstr "control ដែលផ្តល់នូវរបារផ្តេកដែលមាន tabs។"

msgid ""
"A control that provides a horizontal bar with tabs. Similar to [TabContainer] "
"but is only in charge of drawing tabs, not interacting with children."
msgstr ""
"control ដែលផ្តល់នូវរបារផ្តេកដែលមាន tabs។ ស្រដៀងនឹង [TabContainer] ដែរ "
"ប៉ុន្តែទទួលខុសត្រូវតែលើការគូរ tabs ប៉ុណ្ណោះ មិនមានអន្តរកម្មជាមួយ children ទេ។"

msgid "Adds a new tab."
msgstr "បន្ថែម tab ថ្មី។"

msgid "Clears all tabs."
msgstr "សម្អាត tabs ទាំងអស់។"

msgid "Moves the scroll view to make the tab visible."
msgstr "រំកិល scroll view ដើម្បីធ្វើឱ្យ tab អាចមើលឃើញ។"

msgid ""
"Returns [code]true[/code] if the offset buttons (the ones that appear when "
"there's not enough space for all tabs) are visible."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើប៊ូតុង offset "
"(ប៊ូតុងដែលលេចឡើងនៅពេលដែលមិនមានកន្លែងគ្រប់គ្រាន់សម្រាប់ tabs ទាំងអស់) អាចមើលឃើញ។"

msgid "Returns the previously active tab index."
msgstr "បង្វិល index នៃ tab ដែលសកម្មពីមុន។"

msgid ""
"Returns the icon for the right button of the tab at index [param tab_idx] or "
"[code]null[/code] if the right button has no icon."
msgstr ""
"បង្វិលរូបតំណាង (icon) សម្រាប់ប៊ូតុងខាងស្តាំនៃ tab នៅ index [param tab_idx] ឬ [code]null[/"
"code] ប្រសិនបើប៊ូតុងខាងស្តាំគ្មានរូបតំណាង។"

msgid ""
"Returns the icon for the tab at index [param tab_idx] or [code]null[/code] if "
"the tab has no icon."
msgstr ""
"បង្វិលរូបតំណាងសម្រាប់ tab នៅ index [param tab_idx] ឬ [code]null[/code] ប្រសិនបើ tab "
"គ្មានរូបតំណាង។"

msgid ""
"Returns the maximum allowed width of the icon for the tab at index [param "
"tab_idx]."
msgstr "បង្វិលទទឹងអតិបរមាដែលអនុញ្ញាតនៃរូបតំណាងសម្រាប់ tab នៅ index [param tab_idx]។"

msgid ""
"Returns the index of the tab at local coordinates [param point]. Returns "
"[code]-1[/code] if the point is outside the control boundaries or if there's "
"no tab at the queried position."
msgstr ""
"បង្វិល index នៃ tab នៅកូអរដោនេក្នុងតំបន់ (local coordinates) [param point]។ បង្វិល "
"[code]-1[/code] ប្រសិនបើចំណុចនោះនៅក្រៅព្រំដែនរបស់ control ឬប្រសិនបើគ្មាន tab "
"នៅទីតាំងដែលបានសួរ។"

msgid "Returns tab title language code."
msgstr "បង្វិលកូដភាសានៃចំណងជើង tab។"

msgid ""
"Returns the metadata value set to the tab at index [param tab_idx] using "
"[method set_tab_metadata]. If no metadata was previously set, returns "
"[code]null[/code] by default."
msgstr ""
"បង្វិលតម្លៃ metadata ដែលបានកំណត់ទៅកាន់ tab នៅ index [param tab_idx] ដោយប្រើ [method "
"set_tab_metadata]។ ប្រសិនបើគ្មាន metadata ត្រូវបានកំណត់ពីមុនទេ វាបង្វិល [code]null[/"
"code] តាមលំនាំដើម។"

msgid "Returns the number of hidden tabs offsetted to the left."
msgstr "បង្វិលចំនួន tabs ដែលលាក់ ហើយត្រូវបានរំកិលទៅខាងឆ្វេង (offsetted)។"

msgid "Returns tab [Rect2] with local position and size."
msgstr "បង្វិល [Rect2] នៃ tab ជាមួយនឹងទីតាំង និងទំហំក្នុងតំបន់ (local)។"

msgid "Returns tab title text base writing direction."
msgstr "បង្វិលទិសដៅសរសេរគោលនៃអត្ថបទចំណងជើង tab។"

msgid "Returns the title of the tab at index [param tab_idx]."
msgstr "បង្វិលចំណងជើងនៃ tab នៅ index [param tab_idx]។"

msgid "Returns the tooltip text of the tab at index [param tab_idx]."
msgstr "បង្វិលអត្ថបទ tooltip នៃ tab នៅ index [param tab_idx]។"

msgid ""
"Returns [code]true[/code] if the tab at index [param tab_idx] is disabled."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ tab នៅ index [param tab_idx] ត្រូវបានបិទ "
"(disabled)។"

msgid "Returns [code]true[/code] if the tab at index [param tab_idx] is hidden."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ tab នៅ index [param tab_idx] ត្រូវបានលាក់ (hidden)។"

msgid "Moves a tab from [param from] to [param to]."
msgstr "រំកិល tab ពី [param from] ទៅ [param to]។"

msgid "Removes the tab at index [param tab_idx]."
msgstr "ដក tab នៅ index [param tab_idx] ចេញ។"

msgid ""
"Selects the first available tab with greater index than the currently "
"selected. Returns [code]true[/code] if tab selection changed."
msgstr ""
"ជ្រើសរើស tab ដំបូងគេដែលអាចប្រើបាន ហើយមាន index ធំជាង tab ដែលកំពុងជ្រើសរើសបច្ចុប្បន្ន។ "
"បង្វិល [code]true[/code] ប្រសិនបើការជ្រើសរើស tab មានការផ្លាស់ប្តូរ។"

msgid ""
"Selects the first available tab with lower index than the currently selected. "
"Returns [code]true[/code] if tab selection changed."
msgstr ""
"ជ្រើសរើស tab ដំបូងគេដែលអាចប្រើបាន ហើយមាន index តូចជាង tab ដែលកំពុងជ្រើសរើសបច្ចុប្បន្ន។ "
"បង្វិល [code]true[/code] ប្រសិនបើការជ្រើសរើស tab មានការផ្លាស់ប្តូរ។"

msgid ""
"Sets an [param icon] for the button of the tab at index [param tab_idx] "
"(located to the right, before the close button), making it visible and "
"clickable (See [signal tab_button_pressed]). Giving it a [code]null[/code] "
"value will hide the button."
msgstr ""
"កំណត់ [param icon] សម្រាប់ប៊ូតុងនៃ tab នៅ index [param tab_idx] (ស្ថិតនៅខាងស្តាំ មុនប៊ូតុង "
"close) ធ្វើឱ្យវាអាចមើលឃើញ និងអាចចុចបាន (សូមមើល [signal tab_button_pressed])។ "
"ការផ្តល់តម្លៃ [code]null[/code] នឹងលាក់ប៊ូតុងនោះ។"

msgid ""
"If [param disabled] is [code]true[/code], disables the tab at index [param "
"tab_idx], making it non-interactable."
msgstr ""
"ប្រសិនបើ [param disabled] គឺ [code]true[/code] បិទ tab នៅ index [param tab_idx] "
"ធ្វើឱ្យវាមិនអាចធ្វើអន្តរកម្មបាន។"

msgid ""
"If [param hidden] is [code]true[/code], hides the tab at index [param "
"tab_idx], making it disappear from the tab area."
msgstr ""
"ប្រសិនបើ [param hidden] គឺ [code]true[/code] លាក់ tab នៅ index [param tab_idx] "
"ធ្វើឱ្យវាបាត់ពីតំបន់ tab។"

msgid "Sets an [param icon] for the tab at index [param tab_idx]."
msgstr "កំណត់ [param icon] សម្រាប់ tab នៅ index [param tab_idx]។"

msgid ""
"Sets the maximum allowed width of the icon for the tab at index [param "
"tab_idx]. This limit is applied on top of the default size of the icon and on "
"top of [theme_item icon_max_width]. The height is adjusted according to the "
"icon's ratio."
msgstr ""
"កំណត់ទទឹងអតិបរមាដែលអនុញ្ញាតនៃរូបតំណាងសម្រាប់ tab នៅ index [param tab_idx]។ "
"ដែនកំណត់នេះត្រូវបានអនុវត្តលើទំហំលំនាំដើមនៃរូបតំណាង និងលើ [theme_item icon_max_width]។ "
"កម្ពស់ត្រូវបានកែតម្រូវទៅតាមសមាមាត្ររបស់រូបតំណាង។"

msgid ""
"Sets the language code of the title for the tab at index [param tab_idx] to "
"[param language]. This is used for line-breaking and text shaping algorithms. "
"If [param language] is empty, the current locale is used."
msgstr ""
"កំណត់កូដភាសានៃចំណងជើងសម្រាប់ tab នៅ index [param tab_idx] ទៅជា [param language]។ "
"នេះត្រូវបានប្រើសម្រាប់ក្បួនដោះស្រាយ line-breaking និង text shaping។ ប្រសិនបើ [param "
"language] ទទេ locale បច្ចុប្បន្ននឹងត្រូវបានប្រើ។"

msgid ""
"Sets the metadata value for the tab at index [param tab_idx], which can be "
"retrieved later using [method get_tab_metadata]."
msgstr ""
"កំណត់តម្លៃ metadata សម្រាប់ tab នៅ index [param tab_idx] "
"ដែលអាចទាញយកមកវិញនៅពេលក្រោយដោយប្រើ [method get_tab_metadata]។"

msgid "Sets tab title base writing direction."
msgstr "កំណត់ទិសដៅសរសេរគោលនៃចំណងជើង tab។"

msgid "Sets a [param title] for the tab at index [param tab_idx]."
msgstr "កំណត់ [param title] សម្រាប់ tab នៅ index [param tab_idx]។"

msgid ""
"Sets a [param tooltip] for tab at index [param tab_idx].\n"
"[b]Note:[/b] By default, if the [param tooltip] is empty and the tab text is "
"truncated (not all characters fit into the tab), the title will be displayed "
"as a tooltip. To hide the tooltip, assign [code]\" \"[/code] as the [param "
"tooltip] text."
msgstr ""
"កំណត់ [param tooltip] សម្រាប់ tab នៅ index [param tab_idx]។\n"
"[b]ចំណាំ៖[/b] តាមលំនាំដើម ប្រសិនបើ [param tooltip] ទទេ ហើយអត្ថបទ tab ត្រូវបានកាត់ "
"(truncated - តួអក្សរមិនចូលគ្នាអស់ក្នុង tab) ចំណងជើងនឹងត្រូវបានបង្ហាញជា tooltip។ ដើម្បីលាក់ "
"tooltip សូមកំណត់ [code]\" \"[/code] ជាអត្ថបទ [param tooltip]។"

msgid ""
"If [code]true[/code], tabs overflowing this node's width will be hidden, "
"displaying two navigation buttons instead. Otherwise, this node's minimum "
"size is updated so that all tabs are visible."
msgstr ""
"ប្រសិនបើ [code]true[/code] tabs ដែលលើសពីទទឹងរបស់ node នេះនឹងត្រូវបានលាក់ "
"ហើយបង្ហាញប៊ូតុងរុករក (navigation buttons) ពីរជំនួសវិញ។ បើមិនដូច្នេះទេ ទំហំអប្បបរមារបស់ node "
"នេះនឹងត្រូវបានធ្វើបច្ចុប្បន្នភាព ដើម្បីឱ្យ tabs ទាំងអស់អាចមើលឃើញ។"

msgid ""
"If [code]true[/code], middle-clicking on a tab will emit the [signal "
"tab_close_pressed] signal."
msgstr ""
"ប្រសិនបើ [code]true[/code] ការចុចកណ្តាល (middle-clicking) លើ tab នឹងបញ្ជូនសញ្ញា "
"[signal tab_close_pressed]។"

msgid ""
"The index of the current selected tab. A value of [code]-1[/code] means that "
"no tab is selected and can only be set when [member deselect_enabled] is "
"[code]true[/code] or if all tabs are hidden or disabled."
msgstr ""
"index នៃ tab ដែលកំពុងត្រូវបានជ្រើសរើសបច្ចុប្បន្ន។ តម្លៃ [code]-1[/code] មានន័យថាគ្មាន tab "
"ណាត្រូវបានជ្រើសរើសទេ ហើយអាចកំណត់បានតែនៅពេលដែល [member deselect_enabled] គឺ "
"[code]true[/code] ឬប្រសិនបើ tabs ទាំងអស់ត្រូវបានលាក់ ឬបិទ (disabled)។"

msgid ""
"If [code]true[/code], all tabs can be deselected so that no tab is selected. "
"Click on the current tab to deselect it."
msgstr ""
"ប្រសិនបើ [code]true[/code] tabs ទាំងអស់អាចត្រូវបានមិនជ្រើសរើស (deselected) ដើម្បីកុំឱ្យមាន "
"tab ណាមួយត្រូវបានជ្រើសរើស។ ចុចលើ tab បច្ចុប្បន្នដើម្បីមិនជ្រើសរើសវា។"

msgid "If [code]true[/code], tabs can be rearranged with mouse drag."
msgstr "ប្រសិនបើ [code]true[/code] tabs អាចត្រូវបានរៀបចំឡើងវិញដោយការអូស mouse។"

msgid ""
"Sets the maximum width which all tabs should be limited to. Unlimited if set "
"to [code]0[/code]."
msgstr ""
"កំណត់ទទឹងអតិបរមាដែល tabs ទាំងអស់គួរតែត្រូវបានកំណត់។ គ្មានដែនកំណត់ ប្រសិនបើកំណត់ទៅជា [code]0[/"
"code]។"

msgid ""
"If [code]true[/code], the tab offset will be changed to keep the currently "
"selected tab visible."
msgstr ""
"ប្រសិនបើ [code]true[/code] គម្លាត tab (tab offset) នឹងត្រូវបានផ្លាស់ប្តូរ ដើម្បីរក្សា tab "
"ដែលកំពុងជ្រើសរើសបច្ចុប្បន្ន ឱ្យអាចមើលឃើញ។"

msgid ""
"if [code]true[/code], the mouse's scroll wheel can be used to navigate the "
"scroll view."
msgstr ""
"ប្រសិនបើ [code]true[/code] កង់រំកិលរបស់ mouse អាចត្រូវបានប្រើដើម្បីរុករក scroll view។"

msgid ""
"If [code]true[/code], enables selecting a tab with the right mouse button."
msgstr "ប្រសិនបើ [code]true[/code] បើកការជ្រើសរើស tab ដោយប្រើប៊ូតុង mouse ខាងស្តាំ។"

msgid ""
"If [code]true[/code], hovering over a tab while dragging something will "
"switch to that tab. Does not have effect when hovering another tab to "
"rearrange. The delay for when this happens is dictated by [theme_item "
"hover_switch_wait_msec]."
msgstr ""
"ប្រសិនបើ [code]true[/code] ការ hover លើ tab ខណៈពេលកំពុងអូសអ្វីមួយនឹងប្តូរទៅ tab នោះ។ "
"មិនមានឥទ្ធិពលទេនៅពេល hover លើ tab ផ្សេងទៀតដើម្បីរៀបចំឡើងវិញ។ "
"ការពន្យារពេលសម្រាប់ពេលដែលរឿងនេះកើតឡើងត្រូវបានកំណត់ដោយ [theme_item "
"hover_switch_wait_msec]។"

msgid "The horizontal alignment of the tabs."
msgstr "ការតម្រឹមផ្តេកនៃ tabs។"

msgid "When the close button will appear on the tabs."
msgstr "ពេលដែលប៊ូតុង close នឹងលេចឡើងនៅលើ tabs។"

msgid "The number of tabs currently in the bar."
msgstr "ចំនួន tabs ដែលមានបច្ចុប្បន្ននៅក្នុង bar។"

msgid ""
"If [code]true[/code], the tab at [code]index[/code] is disabled.\n"
"[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. tab_count - 1[/"
"code] range."
msgstr ""
"ប្រសិនបើ [code]true[/code], tab នៅ [code]index[/code] ត្រូវបានបិទ។\n"
"[b]ចំណាំ៖[/b] [code]index[/code] គឺជាតម្លៃនៅក្នុងចន្លោះ [code]0 .. tab_count - 1[/"
"code]។"

msgid ""
"If [code]true[/code], the tab at [code]index[/code] is hidden.\n"
"[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. tab_count - 1[/"
"code] range."
msgstr ""
"ប្រសិនបើ [code]true[/code], tab នៅ [code]index[/code] ត្រូវបានលាក់។\n"
"[b]ចំណាំ៖[/b] [code]index[/code] គឺជាតម្លៃនៅក្នុងចន្លោះ [code]0 .. tab_count - 1[/"
"code]។"

msgid ""
"The title text of the tab at [code]index[/code].\n"
"[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. tab_count - 1[/"
"code] range."
msgstr ""
"អត្ថបទចំណងជើងនៃ tab នៅ [code]index[/code]។\n"
"[b]ចំណាំ៖[/b] [code]index[/code] គឺជាតម្លៃនៅក្នុងចន្លោះ [code]0 .. tab_count - 1[/"
"code]។"

msgid ""
"The tooltip text of the tab at [code]index[/code].\n"
"[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. tab_count - 1[/"
"code] range."
msgstr ""
"អត្ថបទ tooltip នៃ tab នៅ [code]index[/code]។\n"
"[b]ចំណាំ៖[/b] [code]index[/code] គឺជាតម្លៃនៅក្នុងចន្លោះ [code]0 .. tab_count - 1[/"
"code]។"

msgid ""
"[TabBar]s with the same rearrange group ID will allow dragging the tabs "
"between them. Enable drag with [member drag_to_rearrange_enabled].\n"
"Setting this to [code]-1[/code] will disable rearranging between [TabBar]s."
msgstr ""
"[TabBar]s ដែលមាន ID ក្រុំរៀបចំឡើងវិញ (rearrange group ID) ដូចគ្នានឹងអនុញ្ញាតឱ្យអូស tabs "
"រវាងពួកវា។ បើកការអូសដោយប្រើ [member drag_to_rearrange_enabled]។\n"
"ការកំណត់វាទៅជា [code]-1[/code] នឹងបិទការរៀបចំឡើងវិញរវាង [TabBar]s។"

msgid ""
"Emitted when the active tab is rearranged via mouse drag. See [member "
"drag_to_rearrange_enabled]."
msgstr ""
"បញ្ជូនសញ្ញានៅពេលដែល tab សកម្មត្រូវបានរៀបចំឡើងវិញតាមរយៈការអូស mouse។ សូមមើល [member "
"drag_to_rearrange_enabled]។"

msgid ""
"Emitted when a tab's right button is pressed. See [method "
"set_tab_button_icon]."
msgstr ""
"បញ្ជូនសញ្ញានៅពេលដែលប៊ូតុងខាងស្តាំរបស់ tab ត្រូវបានចុច។ សូមមើល [method set_tab_button_icon]។"

msgid "Emitted when switching to another tab."
msgstr "បញ្ជូនសញ្ញានៅពេលប្តូរទៅ tab ផ្សេងទៀត។"

msgid "Emitted when a tab is clicked, even if it is the current tab."
msgstr "បញ្ជូនសញ្ញានៅពេលដែល tab ត្រូវបានចុច សូម្បីតែវាជា tab បច្ចុប្បន្នក៏ដោយ។"

msgid ""
"Emitted when a tab's close button is pressed or, if [member "
"close_with_middle_mouse] is [code]true[/code], when middle-clicking on a "
"tab.\n"
"[b]Note:[/b] Tabs are not removed automatically; this behavior needs to be "
"coded manually. For example:\n"
"[codeblocks]\n"
"[gdscript]\n"
"$TabBar.tab_close_pressed.connect($TabBar.remove_tab)\n"
"[/gdscript]\n"
"[csharp]\n"
"GetNode<TabBar>(\"TabBar\").TabClosePressed += "
"GetNode<TabBar>(\"TabBar\").RemoveTab;\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"បញ្ជូនសញ្ញានៅពេលដែលប៊ូតុង close របស់ tab ត្រូវបានចុច ឬ ប្រសិនបើ [member "
"close_with_middle_mouse] គឺ [code]true[/code] នៅពេលចុចកណ្តាលលើ tab។\n"
"[b]ចំណាំ៖[/b] Tabs មិនត្រូវបានដកចេញដោយស្វ័យប្រវត្តិទេ; ឥរិយាបថនេះត្រូវសរសេរកូដដោយដៃ។ "
"ឧទាហរណ៍៖\n"
"[codeblocks]\n"
"[gdscript]\n"
"$TabBar.tab_close_pressed.connect($TabBar.remove_tab)\n"
"[/gdscript]\n"
"[csharp]\n"
"GetNode<TabBar>(\"TabBar\").TabClosePressed += "
"GetNode<TabBar>(\"TabBar\").RemoveTab;\n"
"[/csharp]\n"
"[/codeblocks]"

msgid "Emitted when a tab is hovered by the mouse."
msgstr "បញ្ជូនសញ្ញានៅពេលដែល tab ត្រូវបាន hover ដោយ mouse។"

msgid "Emitted when a tab is right-clicked."
msgstr "បញ្ជូនសញ្ញានៅពេលដែល tab ត្រូវបានចុច mouse ខាងស្តាំ។"

msgid ""
"Emitted when a tab is selected via click, directional input, or script, even "
"if it is the current tab."
msgstr ""
"បញ្ជូនសញ្ញានៅពេលដែល tab ត្រូវបានជ្រើសរើសតាមរយៈការចុច ការបញ្ចូលទិសដៅ ឬ script សូម្បីតែវាជា "
"tab បច្ចុប្បន្នក៏ដោយ។"

msgid "Aligns tabs to the left."
msgstr "តម្រឹម tabs ទៅខាងឆ្វេង។"

msgid "Aligns tabs in the middle."
msgstr "តម្រឹម tabs នៅកណ្តាល។"

msgid "Aligns tabs to the right."
msgstr "តម្រឹម tabs ទៅខាងស្តាំ។"

msgid "Represents the size of the [enum AlignmentMode] enum."
msgstr "តំណាងឱ្យទំហំនៃ [enum AlignmentMode] enum។"

msgid "Never show the close buttons."
msgstr "កុំបង្ហាញប៊ូតុង close ឡើយ។"

msgid "Only show the close button on the currently active tab."
msgstr "បង្ហាញប៊ូតុង close តែនៅលើ tab ដែលកំពុងសកម្មបច្ចុប្បន្នប៉ុណ្ណោះ។"

msgid "Show the close button on all tabs."
msgstr "បង្ហាញប៊ូតុង close នៅលើ tabs ទាំងអស់។"

msgid "Represents the size of the [enum CloseButtonDisplayPolicy] enum."
msgstr "តំណាងឱ្យទំហំនៃ [enum CloseButtonDisplayPolicy] enum។"

msgid "Modulation color for the [theme_item drop_mark] icon."
msgstr "ពណ៌ modulation សម្រាប់រូបតំណាង [theme_item drop_mark]។"

msgid "Font color of disabled tabs."
msgstr "ពណ៌ Font នៃ tabs ដែលបានបិទ (disabled)។"

msgid ""
"Font color of the currently hovered tab. Does not apply to the selected tab."
msgstr "ពណ៌ Font នៃ tab ដែលកំពុង hover បច្ចុប្បន្ន។ មិនអនុវត្តចំពោះ tab ដែលបានជ្រើសរើសទេ។"

msgid "The tint of text outline of the tab name."
msgstr "ពណ៌ (tint) នៃគំនូសវាស (outline) អត្ថបទនៃឈ្មោះ tab។"

msgid "Font color of the currently selected tab."
msgstr "ពណ៌ Font នៃ tab ដែលកំពុងត្រូវបានជ្រើសរើសបច្ចុប្បន្ន។"

msgid "Font color of the other, unselected tabs."
msgstr "ពណ៌ Font នៃ tabs ផ្សេងទៀតដែលមិនបានជ្រើសរើស។"

msgid "Icon color of disabled tabs."
msgstr "ពណ៌រូបតំណាងនៃ tabs ដែលបានបិទ (disabled)។"

msgid ""
"Icon color of the currently hovered tab. Does not apply to the selected tab."
msgstr "ពណ៌រូបតំណាងនៃ tab ដែលកំពុង hover បច្ចុប្បន្ន។ មិនអនុវត្តចំពោះ tab ដែលបានជ្រើសរើសទេ។"

msgid "Icon color of the currently selected tab."
msgstr "ពណ៌រូបតំណាងនៃ tab ដែលកំពុងត្រូវបានជ្រើសរើសបច្ចុប្បន្ន។"

msgid "Icon color of the other, unselected tabs."
msgstr "ពណ៌រូបតំណាងនៃ tabs ផ្សេងទៀតដែលមិនបានជ្រើសរើស។"

msgid "The horizontal separation between the elements inside tabs."
msgstr "គម្លាតផ្តេករវាងធាតុនៅខាងក្នុង tabs។"

msgid ""
"During a drag-and-drop, this is how many milliseconds to wait before "
"switching the tab."
msgstr "ក្នុងអំឡុងពេល drag-and-drop នេះគឺជាចំនួន milliseconds ដែលត្រូវរង់ចាំមុនពេលប្តូរ tab។"

msgid ""
"The maximum allowed width of the tab's icon. This limit is applied on top of "
"the default size of the icon, but before the value set with [method "
"set_tab_icon_max_width]. The height is adjusted according to the icon's ratio."
msgstr ""
"ទទឹងអតិបរមាដែលអនុញ្ញាតនៃរូបតំណាងរបស់ tab។ ដែនកំណត់នេះត្រូវបានអនុវត្តលើទំហំលំនាំដើមនៃរូបតំណាង "
"ប៉ុន្តែមុនពេលតម្លៃដែលបានកំណត់ជាមួយ [method set_tab_icon_max_width]។ "
"កម្ពស់ត្រូវបានកែតម្រូវទៅតាមសមាមាត្ររបស់រូបតំណាង។"

msgid ""
"The size of the tab text outline.\n"
"[b]Note:[/b] If using a font with [member "
"FontFile.multichannel_signed_distance_field] enabled, its [member "
"FontFile.msdf_pixel_range] must be set to at least [i]twice[/i] the value of "
"[theme_item outline_size] for outline rendering to look correct. Otherwise, "
"the outline may appear to be cut off earlier than intended."
msgstr ""
"ទំហំនៃគំនូសវាស (outline) អត្ថបទ tab។\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើប្រើ font ដែលបើក [member "
"FontFile.multichannel_signed_distance_field], [member "
"FontFile.msdf_pixel_range] របស់វាត្រូវតែកំណត់យ៉ាងហោចណាស់ [i]ពីរដង[/i] នៃតម្លៃ "
"[theme_item outline_size] ដើម្បីឱ្យការ render outline មើលទៅត្រឹមត្រូវ។ បើមិនដូច្នេះទេ "
"outline អាចនឹងមើលទៅដូចជាត្រូវបានកាត់មុនពេលដែលបានចេតនា។"

msgid "The space between tabs in the tab bar."
msgstr "ចន្លោះរវាង tabs នៅក្នុង tab bar។"

msgid "The font used to draw tab names."
msgstr "font ដែលប្រើដើម្បីគូរឈ្មោះ tab។"

msgid "Font size of the tab names."
msgstr "ទំហំ Font នៃឈ្មោះ tab។"

msgid "The icon for the close button (see [member tab_close_display_policy])."
msgstr "រូបតំណាងសម្រាប់ប៊ូតុង close (សូមមើល [member tab_close_display_policy])។"

msgid ""
"Icon for the left arrow button that appears when there are too many tabs to "
"fit in the container width. When the button is disabled (i.e. the first tab "
"is visible), it appears semi-transparent."
msgstr ""
"រូបតំណាងសម្រាប់ប៊ូតុងព្រួញខាងឆ្វេង ដែលលេចឡើងនៅពេលដែលមាន tabs ច្រើនពេកមិនអាចដាក់ចូលគ្នាក្នុងទទឹង "
"container បាន។ នៅពេលដែលប៊ូតុងត្រូវបានបិទ (ឧ. tab ទីមួយអាចមើលឃើញ) វាលេចឡើងពាក់កណ្តាលថ្លា "
"(semi-transparent)។"

msgid ""
"Icon for the left arrow button that appears when there are too many tabs to "
"fit in the container width. Used when the button is being hovered with the "
"cursor."
msgstr ""
"រូបតំណាងសម្រាប់ប៊ូតុងព្រួញខាងឆ្វេង ដែលលេចឡើងនៅពេលដែលមាន tabs ច្រើនពេកមិនអាចដាក់ចូលគ្នាក្នុងទទឹង "
"container បាន។ ប្រើនៅពេលដែលប៊ូតុងកំពុងត្រូវបាន hover ដោយ cursor។"

msgid ""
"Icon shown to indicate where a dragged tab will be dropped (see [member "
"drag_to_rearrange_enabled])."
msgstr ""
"រូបតំណាងដែលបង្ហាញដើម្បីបញ្ជាក់ថា tab ដែលបានអូសនឹងត្រូវទម្លាក់នៅត្រង់ណា (សូមមើល [member "
"drag_to_rearrange_enabled])។"

msgid ""
"Icon for the right arrow button that appears when there are too many tabs to "
"fit in the container width. When the button is disabled (i.e. the last tab is "
"visible) it appears semi-transparent."
msgstr ""
"រូបតំណាងសម្រាប់ប៊ូតុងព្រួញខាងស្តាំ ដែលលេចឡើងនៅពេលដែលមាន tabs ច្រើនពេកមិនអាចដាក់ចូលគ្នាក្នុងទទឹង "
"container បាន។ នៅពេលដែលប៊ូតុងត្រូវបានបិទ (ឧ. tab ចុងក្រោយអាចមើលឃើញ) "
"វាលេចឡើងពាក់កណ្តាលថ្លា (semi-transparent)។"

msgid ""
"Icon for the right arrow button that appears when there are too many tabs to "
"fit in the container width. Used when the button is being hovered with the "
"cursor."
msgstr ""
"រូបតំណាងសម្រាប់ប៊ូតុងព្រួញខាងស្តាំ ដែលលេចឡើងនៅពេលដែលមាន tabs ច្រើនពេកមិនអាចដាក់ចូលគ្នាក្នុងទទឹង "
"container បាន។ ប្រើនៅពេលដែលប៊ូតុងកំពុងត្រូវបាន hover ដោយ cursor។"

msgid ""
"Background of the tab and close buttons when they're being hovered with the "
"cursor."
msgstr "ផ្ទៃខាងក្រោយនៃ tab និងប៊ូតុង close នៅពេលដែលពួកវាកំពុងត្រូវបាន hover ដោយ cursor។"

msgid "Background of the tab and close buttons when it's being pressed."
msgstr "ផ្ទៃខាងក្រោយនៃ tab និងប៊ូតុង close នៅពេលដែលវាកំពុងត្រូវបានចុច។"

msgid "The style of disabled tabs."
msgstr "ស្ទីលនៃ tabs ដែលបានបិទ (disabled)។"

msgid ""
"[StyleBox] used when the [TabBar] is focused. The [theme_item tab_focus] "
"[StyleBox] is displayed [i]over[/i] the base [StyleBox] of the selected tab, "
"so a partially transparent [StyleBox] should be used to ensure the base "
"[StyleBox] remains visible. A [StyleBox] that represents an outline or an "
"underline works well for this purpose. To disable the focus visual effect, "
"assign a [StyleBoxEmpty] resource. Note that disabling the focus visual "
"effect will harm keyboard/controller navigation usability, so this is not "
"recommended for accessibility reasons."
msgstr ""
"[StyleBox] ដែលប្រើនៅពេលដែល [TabBar] ត្រូវបាន focus។ [theme_item tab_focus] "
"[StyleBox] ត្រូវបានបង្ហាញ [i]ពីលើ[/i] base [StyleBox] នៃ tab ដែលបានជ្រើសរើស ដូច្នេះ "
"[StyleBox] ដែលថ្លាមួយផ្នែកគួរតែត្រូវបានប្រើដើម្បីធានាថា base [StyleBox] នៅតែអាចមើលឃើញ។ "
"[StyleBox] ដែលតំណាងឱ្យ outline ឬ underline ដំណើរការបានល្អសម្រាប់គោលបំណងនេះ។ "
"ដើម្បីបិទឥទ្ធិពលមើលឃើញនៃ focus សូមកំណត់ធនធាន [StyleBoxEmpty]។ "
"សូមចំណាំថាការបិទឥទ្ធិពលមើលឃើញនៃ focus នឹងធ្វើឱ្យប៉ះពាល់ដល់ភាពងាយស្រួលក្នុងការរុករកតាម keyboard/"
"controller ដូច្នេះវាមិនត្រូវបានណែនាំសម្រាប់ហេតុផល accessibility ទេ។"

msgid ""
"The style of the currently hovered tab. Does not apply to the selected tab.\n"
"[b]Note:[/b] This style will be drawn with the same width as [theme_item "
"tab_unselected] at minimum."
msgstr ""
"ស្ទីលនៃ tab ដែលកំពុង hover បច្ចុប្បន្ន។ មិនអនុវត្តចំពោះ tab ដែលបានជ្រើសរើសទេ។\n"
"[b]ចំណាំ៖[/b] ស្ទីលនេះនឹងត្រូវបានគូរដោយមានទទឹងដូចគ្នានឹង [theme_item tab_unselected] "
"យ៉ាងតិចបំផុត។"

msgid "The style of the currently selected tab."
msgstr "ស្ទីលនៃ tab ដែលកំពុងត្រូវបានជ្រើសរើសបច្ចុប្បន្ន។"

msgid "The style of the other, unselected tabs."
msgstr "ស្ទីលនៃ tabs ផ្សេងទៀតដែលមិនបានជ្រើសរើស។"

msgid ""
"A container that creates a tab for each child control, displaying only the "
"active tab's control."
msgstr ""
"container ដែលបង្កើត tab សម្រាប់ child control នីមួយៗ ដោយបង្ហាញតែ control របស់ tab "
"សកម្មប៉ុណ្ណោះ។"

msgid ""
"Arranges child controls into a tabbed view, creating a tab for each one. The "
"active tab's corresponding control is made visible, while all other child "
"controls are hidden. Ignores non-control children.\n"
"[b]Note:[/b] The drawing of the clickable tabs is handled by this node; "
"[TabBar] is not needed."
msgstr ""
"រៀបចំ child controls ទៅជាទម្រង់ tabbed view ដោយបង្កើត tab សម្រាប់ child នីមួយៗ។ "
"control ដែលត្រូវគ្នានឹង tab សកម្មត្រូវបានធ្វើឱ្យអាចមើលឃើញ ខណៈពេលដែល child controls "
"ផ្សេងទៀតទាំងអស់ត្រូវបានលាក់។ មិនអើពើនឹង children ដែលមិនមែនជា control ទេ។\n"
"[b]ចំណាំ៖[/b] ការគូរ tabs ដែលអាចចុចបានត្រូវបានគ្រប់គ្រងដោយ node នេះ; មិនត្រូវការ [TabBar] "
"ទេ។"

msgid "Returns the child [Control] node located at the active tab index."
msgstr "បង្វិល node child [Control] ដែលស្ថិតនៅ index នៃ tab សកម្ម។"

msgid ""
"Returns the [Popup] node instance if one has been set already with [method "
"set_popup].\n"
"[b]Warning:[/b] This is a required internal node, removing and freeing it may "
"cause a crash. If you wish to hide it or any of its children, use their "
"[member Window.visible] property."
msgstr ""
"បង្វិលធាតុ node [Popup] ប្រសិនបើមួយត្រូវបានកំណត់រួចហើយដោយប្រើ [method set_popup]។\n"
"[b]ការព្រមាន៖[/b] នេះគឺជា internal node ដែលទាមទារឱ្យមាន ការដកវាចេញ និងលុបវាចោល "
"(freeing) អាចបណ្តាលឱ្យគាំងកម្មវិធី (crash)។ ប្រសិនបើអ្នកចង់លាក់វា ឬ children ណាមួយរបស់វា "
"សូមប្រើលក្ខណៈសម្បត្តិ [member Window.visible] របស់ពួកវា។"

msgid ""
"Returns the [TabBar] contained in this container.\n"
"[b]Warning:[/b] This is a required internal node, removing and freeing it or "
"editing its tabs may cause a crash. If you wish to edit the tabs, use the "
"methods provided in [TabContainer]."
msgstr ""
"បង្វិល [TabBar] ដែលមាននៅក្នុង container នេះ។\n"
"[b]ការព្រមាន៖[/b] នេះគឺជា internal node ដែលទាមទារឱ្យមាន ការដកវាចេញ លុបវាចោល "
"ឬកែសម្រួល tabs របស់វាអាចបណ្តាលឱ្យគាំងកម្មវិធី (crash)។ ប្រសិនបើអ្នកចង់កែសម្រួល tabs "
"សូមប្រើវិធីសាស្ត្រដែលមានផ្តល់ជូននៅក្នុង [TabContainer]។"

msgid "Returns the button icon from the tab at index [param tab_idx]."
msgstr "បង្វិលរូបតំណាងប៊ូតុងពី tab នៅ index [param tab_idx]។"

msgid "Returns the [Control] node from the tab at index [param tab_idx]."
msgstr "បង្វិល node [Control] ពី tab នៅ index [param tab_idx]។"

msgid "Returns the number of tabs."
msgstr "បង្វិលចំនួន tabs។"

msgid ""
"Returns the [Texture2D] for the tab at index [param tab_idx] or [code]null[/"
"code] if the tab has no [Texture2D]."
msgstr ""
"បង្វិល [Texture2D] សម្រាប់ tab នៅ index [param tab_idx] ឬ [code]null[/code] "
"ប្រសិនបើ tab គ្មាន [Texture2D]។"

msgid ""
"Returns the index of the tab tied to the given [param control]. The control "
"must be a child of the [TabContainer]."
msgstr ""
"បង្វិល index នៃ tab ដែលភ្ជាប់ទៅនឹង [param control] ដែលបានផ្តល់ឱ្យ។ control ត្រូវតែជា "
"child នៃ [TabContainer]។"

msgid ""
"Returns the title of the tab at index [param tab_idx]. Tab titles default to "
"the name of the indexed child node, but this can be overridden with [method "
"set_tab_title]."
msgstr ""
"បង្វិលចំណងជើងនៃ tab នៅ index [param tab_idx]។ ចំណងជើង tab មានលំនាំដើមជាឈ្មោះរបស់ "
"child node ដែលមាន index ប៉ុន្តែវាអាចត្រូវបានកែប្រែ (overridden) ដោយប្រើ [method "
"set_tab_title]។"

msgid ""
"If set on a [Popup] node instance, a popup menu icon appears in the top-right "
"corner of the [TabContainer] (setting it to [code]null[/code] will make it go "
"away). Clicking it will expand the [Popup] node."
msgstr ""
"ប្រសិនបើកំណត់លើធាតុ node [Popup] រូបតំណាង popup menu នឹងលេចឡើងនៅជ្រុងខាងលើផ្នែកខាងស្តាំនៃ "
"[TabContainer] (ការកំណត់វាទៅជា [code]null[/code] នឹងធ្វើឱ្យវាបាត់)។ ការចុចលើវានឹងពង្រីក "
"node [Popup]។"

msgid "Sets the button icon from the tab at index [param tab_idx]."
msgstr "កំណត់រូបតំណាងប៊ូតុងពី tab នៅ index [param tab_idx]។"

msgid "Sets an icon for the tab at index [param tab_idx]."
msgstr "កំណត់រូបតំណាងសម្រាប់ tab នៅ index [param tab_idx]។"

msgid ""
"Sets a custom title for the tab at index [param tab_idx] (tab titles default "
"to the name of the indexed child node). Set it back to the child's name to "
"make the tab default to it again."
msgstr ""
"កំណត់ចំណងជើងផ្ទាល់ខ្លួន (custom title) សម្រាប់ tab នៅ index [param tab_idx] (ចំណងជើង "
"tab មានលំនាំដើមជាឈ្មោះរបស់ child node ដែលមាន index)។ កំណត់វាត្រឡប់ទៅជាឈ្មោះរបស់ child "
"វិញ ដើម្បីធ្វើឱ្យ tab ត្រឡប់ទៅរកលំនាំដើមវិញ។"

msgid ""
"Sets a custom tooltip text for tab at index [param tab_idx].\n"
"[b]Note:[/b] By default, if the [param tooltip] is empty and the tab text is "
"truncated (not all characters fit into the tab), the title will be displayed "
"as a tooltip. To hide the tooltip, assign [code]\" \"[/code] as the [param "
"tooltip] text."
msgstr ""
"កំណត់អត្ថបទ tooltip ផ្ទាល់ខ្លួនសម្រាប់ tab នៅ index [param tab_idx]។\n"
"[b]ចំណាំ៖[/b] តាមលំនាំដើម ប្រសិនបើ [param tooltip] ទទេ ហើយអត្ថបទ tab ត្រូវបានកាត់ "
"(truncated) ចំណងជើងនឹងត្រូវបានបង្ហាញជា tooltip។ ដើម្បីលាក់ tooltip សូមកំណត់ [code]\" \"[/"
"code] ជាអត្ថបទ [param tooltip]។"

msgid ""
"Due to internal changes this doesn't do anything anymore, as they're always "
"in front."
msgstr "ដោយសារការផ្លាស់ប្តូរខាងក្នុង វាមិនធ្វើអ្វីទៀតទេ ព្រោះពួកវាតែងតែនៅខាងមុខជានិច្ច។"

msgid "This doesn't do anything."
msgstr "វាមិនធ្វើអ្វីទាំងអស់។"

msgid ""
"If [code]true[/code], all tabs can be deselected so that no tab is selected. "
"Click on the [member current_tab] to deselect it.\n"
"Only the tab header will be shown if no tabs are selected."
msgstr ""
"ប្រសិនបើ [code]true[/code] tabs ទាំងអស់អាចត្រូវបានមិនជ្រើសរើស (deselected) ដើម្បីកុំឱ្យមាន "
"tab ណាមួយត្រូវបាន ជ្រើសរើស។ ចុចលើ [member current_tab] ដើម្បីមិនជ្រើសរើសវា។\n"
"មានតែក្បាល tab (tab header) ប៉ុណ្ណោះនឹងត្រូវបានបង្ហាញ ប្រសិនបើគ្មាន tabs ត្រូវបានជ្រើសរើស។"

msgid ""
"If [code]true[/code], hovering over a tab while dragging something will "
"switch to that tab. Does not have effect when hovering another tab to "
"rearrange."
msgstr ""
"ប្រសិនបើ [code]true[/code] ការ hover លើ tab ខណៈពេលកំពុងអូសអ្វីមួយនឹងប្តូរទៅ tab នោះ។ "
"មិនមានឥទ្ធិពលទេនៅពេល hover លើ tab ផ្សេងទៀតដើម្បីរៀបចំឡើងវិញ។"

msgid "The position at which tabs will be placed."
msgstr "ទីតាំងដែល tabs នឹងត្រូវបានដាក់។"

msgid "The focus access mode for the internal [TabBar] node."
msgstr "របៀបចូលប្រើ focus សម្រាប់ node [TabBar] ខាងក្នុង។"

msgid ""
"If [code]true[/code], the tab at [code]index[/code] is disabled.\n"
"[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. get_tab_count() "
"- 1[/code] range."
msgstr ""
"ប្រសិនបើ [code]true[/code], tab នៅ [code]index[/code] ត្រូវបានបិទ។\n"
"[b]ចំណាំ៖[/b] [code]index[/code] គឺជាតម្លៃនៅក្នុងចន្លោះ [code]0 .. get_tab_count() - "
"1[/code]។"

msgid ""
"If [code]true[/code], the tab at [code]index[/code] is hidden.\n"
"[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. get_tab_count() "
"- 1[/code] range."
msgstr ""
"ប្រសិនបើ [code]true[/code], tab នៅ [code]index[/code] ត្រូវបានលាក់។\n"
"[b]ចំណាំ៖[/b] [code]index[/code] គឺជាតម្លៃនៅក្នុងចន្លោះ [code]0 .. get_tab_count() - "
"1[/code]។"

msgid ""
"The title text of the tab at [code]index[/code].\n"
"[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. get_tab_count() "
"- 1[/code] range."
msgstr ""
"អត្ថបទចំណងជើងនៃ tab នៅ [code]index[/code]។\n"
"[b]ចំណាំ៖[/b] [code]index[/code] គឺជាតម្លៃនៅក្នុងចន្លោះ [code]0 .. get_tab_count() - "
"1[/code]។"

msgid ""
"The tooltip text of the tab at [code]index[/code].\n"
"[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. get_tab_count() "
"- 1[/code] range."
msgstr ""
"អត្ថបទ tooltip នៃ tab នៅ [code]index[/code]។\n"
"[b]ចំណាំ៖[/b] [code]index[/code] គឺជាតម្លៃនៅក្នុងចន្លោះ [code]0 .. get_tab_count() - "
"1[/code]។"

msgid ""
"[TabContainer]s with the same rearrange group ID will allow dragging the tabs "
"between them. Enable drag with [member drag_to_rearrange_enabled].\n"
"Setting this to [code]-1[/code] will disable rearranging between "
"[TabContainer]s."
msgstr ""
"[TabContainer]s ដែលមាន ID ក្រុំរៀបចំឡើងវិញដូចគ្នានឹងអនុញ្ញាតឱ្យអូស tabs រវាងពួកវា។ "
"បើកការអូសដោយប្រើ [member drag_to_rearrange_enabled]។\n"
"ការកំណត់វាទៅជា [code]-1[/code] នឹងបិទការរៀបចំឡើងវិញរវាង [TabContainer]s។"

msgid ""
"If [code]true[/code], tabs are visible. If [code]false[/code], tabs' content "
"and titles are hidden."
msgstr ""
"ប្រសិនបើ [code]true[/code] tabs អាចមើលឃើញ។ ប្រសិនបើ [code]false[/code] ខ្លឹមសារ "
"និងចំណងជើងរបស់ tabs ត្រូវបានលាក់។"

msgid ""
"If [code]true[/code], child [Control] nodes that are hidden have their "
"minimum size take into account in the total, instead of only the currently "
"visible one."
msgstr ""
"ប្រសិនបើ [code]true[/code] child [Control] nodes ដែលត្រូវបានលាក់ "
"នឹងយកទំហំអប្បបរមារបស់ពួកវាមកគណនាបញ្ចូលក្នុងទំហំសរុប ជំនួសឱ្យតែទំហំដែលអាចមើលឃើញបច្ចុប្បន្ន។"

msgid ""
"Emitted when the [TabContainer]'s [Popup] button is clicked. See [method "
"set_popup] for details."
msgstr ""
"បញ្ជូនសញ្ញានៅពេលដែលប៊ូតុង [Popup] របស់ [TabContainer] ត្រូវបានចុច។ សូមមើល [method "
"set_popup] សម្រាប់ព័ត៌មានលម្អិត។"

msgid "Emitted when the user clicks on the button icon on this tab."
msgstr "បញ្ជូនសញ្ញានៅពេលដែលអ្នកប្រើប្រាស់ចុចលើរូបតំណាងប៊ូតុងនៅលើ tab នេះ។"

msgid "Places the tab bar at the top."
msgstr "ដាក់ tab bar នៅខាងលើ។"

msgid ""
"Places the tab bar at the bottom. The tab bar's [StyleBox] will be flipped "
"vertically."
msgstr ""
"ដាក់ tab bar នៅខាងក្រោម។ [StyleBox] របស់ tab bar នឹងត្រូវបានត្រឡប់ (flipped) តាមទិសឈរ។"

msgid "Represents the size of the [enum TabPosition] enum."
msgstr "តំណាងឱ្យទំហំនៃ [enum TabPosition] enum។"

msgid ""
"The maximum allowed width of the tab's icon. This limit is applied on top of "
"the default size of the icon, but before the value set with [method "
"TabBar.set_tab_icon_max_width]. The height is adjusted according to the "
"icon's ratio."
msgstr ""
"ទទឹងអតិបរមាដែលអនុញ្ញាតនៃរូបតំណាងរបស់ tab។ ដែនកំណត់នេះត្រូវបានអនុវត្តលើទំហំលំនាំដើមនៃរូបតំណាង "
"ប៉ុន្តែមុនពេលតម្លៃដែលបានកំណត់ជាមួយ [method TabBar.set_tab_icon_max_width]។ "
"កម្ពស់ត្រូវបានកែតម្រូវទៅតាមសមាមាត្ររបស់រូបតំណាង។"

msgid "Space between tab's name and its icon."
msgstr "ចន្លោះរវាងឈ្មោះរបស់ tab និងរូបតំណាងរបស់វា។"

msgid ""
"The space at the left or right edges of the tab bar, accordingly with the "
"current [member tab_alignment].\n"
"The margin is ignored with [constant TabBar.ALIGNMENT_RIGHT] if the tabs are "
"clipped (see [member clip_tabs]) or a popup has been set (see [method "
"set_popup]). The margin is always ignored with [constant "
"TabBar.ALIGNMENT_CENTER]."
msgstr ""
"ចន្លោះនៅគែមខាងឆ្វេង ឬខាងស្តាំនៃ tab bar យោងទៅតាម [member tab_alignment] បច្ចុប្បន្ន។\n"
"margin ត្រូវបានមិនអើពើជាមួយ [constant TabBar.ALIGNMENT_RIGHT] ប្រសិនបើ tabs "
"ត្រូវបានកាត់ (clipped - សូមមើល [member clip_tabs]) ឬ popup ត្រូវបានកំណត់ (សូមមើល "
"[method set_popup])។ margin តែងតែត្រូវបានមិនអើពើជាមួយ [constant "
"TabBar.ALIGNMENT_CENTER]។"

msgid "The icon for the menu button (see [method set_popup])."
msgstr "រូបតំណាងសម្រាប់ប៊ូតុង menu (សូមមើល [method set_popup])។"

msgid ""
"The icon for the menu button (see [method set_popup]) when it's being hovered "
"with the cursor."
msgstr ""
"រូបតំណាងសម្រាប់ប៊ូតុង menu (សូមមើល [method set_popup]) នៅពេលដែលវាកំពុងត្រូវបាន hover ដោយ "
"cursor។"

msgid "The style for the background fill."
msgstr "ស្ទីលសម្រាប់ការបំពេញផ្ទៃខាងក្រោយ (background fill)។"

msgid ""
"The style of the currently hovered tab.\n"
"[b]Note:[/b] This style will be drawn with the same width as [theme_item "
"tab_unselected] at minimum."
msgstr ""
"ស្ទីលនៃ tab ដែលកំពុង hover បច្ចុប្បន្ន។\n"
"[b]ចំណាំ៖[/b] ស្ទីលនេះនឹងត្រូវបានគូរដោយមានទទឹងដូចគ្នានឹង [theme_item tab_unselected] "
"យ៉ាងតិចបំផុត។"

msgid "The style for the background fill of the [TabBar] area."
msgstr "ស្ទីលសម្រាប់ការបំពេញផ្ទៃខាងក្រោយនៃតំបន់ [TabBar]។"

msgid "A TCP server."
msgstr "ម៉ាស៊ីនមេ (server) TCP។"

msgid "Returns the local port this server is listening to."
msgstr "បង្វិល port ក្នុងតំបន់ (local port) ដែលម៉ាស៊ីនមេនេះកំពុងស្តាប់។"

msgid ""
"Listen on the [param port] binding to [param bind_address].\n"
"If [param bind_address] is set as [code]\"*\"[/code] (default), the server "
"will listen on all available addresses (both IPv4 and IPv6).\n"
"If [param bind_address] is set as [code]\"0.0.0.0\"[/code] (for IPv4) or "
"[code]\"::\"[/code] (for IPv6), the server will listen on all available "
"addresses matching that IP type.\n"
"If [param bind_address] is set to any valid address (e.g. [code]"
"\"192.168.1.101\"[/code], [code]\"::1\"[/code], etc.), the server will only "
"listen on the interface with that address (or fail if no interface with the "
"given address exists)."
msgstr ""
"ស្តាប់នៅលើ [param port] ដោយភ្ជាប់ (binding) ទៅកាន់ [param bind_address]។\n"
"ប្រសិនបើ [param bind_address] ត្រូវបានកំណត់ជា [code]\"*\"[/code] (លំនាំដើម) "
"ម៉ាស៊ីនមេនឹងស្តាប់នៅលើអាសយដ្ឋានដែលអាចប្រើបានទាំងអស់ (ទាំង IPv4 និង IPv6)។\n"
"ប្រសិនបើ [param bind_address] ត្រូវបានកំណត់ជា [code]\"0.0.0.0\"[/code] (សម្រាប់ IPv4) "
"ឬ [code]\"::\"[/code] (សម្រាប់ IPv6) "
"ម៉ាស៊ីនមេនឹងស្តាប់នៅលើអាសយដ្ឋានដែលអាចប្រើបានទាំងអស់ដែលត្រូវគ្នានឹងប្រភេទ IP នោះ។\n"
"ប្រសិនបើ [param bind_address] ត្រូវបានកំណត់ទៅជាអាសយដ្ឋានដែលត្រឹមត្រូវណាមួយ (ឧ. [code]"
"\"192.168.1.101\"[/code], [code]\"::1\"[/code] ជាដើម) ម៉ាស៊ីនមេនឹងស្តាប់តែនៅលើ "
"interface ដែលមានអាសយដ្ឋាននោះប៉ុណ្ណោះ (ឬបរាជ័យ ប្រសិនបើគ្មាន interface "
"ដែលមានអាសយដ្ឋានដែលបានផ្តល់ឱ្យ)។"

msgid ""
"If a connection is available, returns a StreamPeerTCP with the connection."
msgstr "ប្រសិនបើការតភ្ជាប់អាចប្រើបាន បង្វិល StreamPeerTCP ជាមួយនឹងការតភ្ជាប់នោះ។"

msgid "A multiline text editor."
msgstr "កម្មវិធីកែសម្រួលអត្ថបទច្រើនបន្ទាត់ (multiline text editor)។"

msgid ""
"Override this method to define what happens when the user presses the "
"backspace key."
msgstr ""
"កែប្រែ (Override) វិធីសាស្ត្រនេះដើម្បីកំណត់ថាតើអ្វីនឹងកើតឡើងនៅពេលអ្នកប្រើប្រាស់ចុចគ្រាប់ចុច "
"backspace។"

msgid ""
"Override this method to define what happens when the user performs a copy "
"operation."
msgstr "កែប្រែវិធីសាស្ត្រនេះដើម្បីកំណត់ថាតើអ្វីនឹងកើតឡើងនៅពេលអ្នកប្រើប្រាស់ធ្វើប្រតិបត្តិការ copy។"

msgid ""
"Override this method to define what happens when the user performs a cut "
"operation."
msgstr "កែប្រែវិធីសាស្ត្រនេះដើម្បីកំណត់ថាតើអ្វីនឹងកើតឡើងនៅពេលអ្នកប្រើប្រាស់ធ្វើប្រតិបត្តិការ cut។"

msgid ""
"Override this method to define what happens when the user types in the "
"provided key [param unicode_char]."
msgstr ""
"កែប្រែវិធីសាស្ត្រនេះដើម្បីកំណត់ថាតើអ្វីនឹងកើតឡើងនៅពេលអ្នកប្រើប្រាស់វាយគ្រាប់ចុច [param "
"unicode_char] ដែលបានផ្តល់ឱ្យ។"

msgid ""
"Override this method to define what happens when the user performs a paste "
"operation."
msgstr "កែប្រែវិធីសាស្ត្រនេះដើម្បីកំណត់ថាតើអ្វីនឹងកើតឡើងនៅពេលអ្នកប្រើប្រាស់ធ្វើប្រតិបត្តិការ paste។"

msgid ""
"Override this method to define what happens when the user performs a paste "
"operation with middle mouse button.\n"
"[b]Note:[/b] This method is only implemented on Linux."
msgstr ""
"កែប្រែវិធីសាស្ត្រនេះដើម្បីកំណត់ថាតើអ្វីនឹងកើតឡើងនៅពេលអ្នកប្រើប្រាស់ធ្វើប្រតិបត្តិការ paste "
"ដោយប្រើប៊ូតុង mouse កណ្តាល។\n"
"[b]ចំណាំ៖[/b] វិធីសាស្ត្រនេះត្រូវបានអនុវត្តតែនៅលើ Linux ប៉ុណ្ណោះ។"

msgid ""
"Adds a new caret at the given location. Returns the index of the new caret, "
"or [code]-1[/code] if the location is invalid."
msgstr ""
"បន្ថែម caret ថ្មីនៅទីតាំងដែលបានផ្តល់ឱ្យ។ បង្វិល index នៃ caret ថ្មី ឬ [code]-1[/code] "
"ប្រសិនបើទីតាំងមិនត្រឹមត្រូវ។"

msgid ""
"Adds an additional caret above or below every caret. If [param below] is "
"[code]true[/code] the new caret will be added below and above otherwise."
msgstr ""
"បន្ថែម caret បន្ថែមនៅពីលើ ឬពីក្រោម caret នីមួយៗ។ ប្រសិនបើ [param below] គឺ [code]true[/"
"code] caret ថ្មីនឹងត្រូវបានបន្ថែមនៅខាងក្រោម ហើយបើមិនដូច្នោះទេគឺនៅខាងលើ។"

msgid ""
"Register a new gutter to this [TextEdit]. Use [param at] to have a specific "
"gutter order. A value of [code]-1[/code] appends the gutter to the right."
msgstr ""
"ចុះឈ្មោះ gutter ថ្មីទៅក្នុង [TextEdit] នេះ។ ប្រើ [param at] ដើម្បីកំណត់លំដាប់ gutter "
"ជាក់លាក់។ តម្លៃ [code]-1[/code] នឹងបន្ថែម gutter នៅខាងស្តាំ។"

msgid ""
"Adds a selection and a caret for the next occurrence of the current "
"selection. If there is no active selection, selects word under caret."
msgstr ""
"បន្ថែម selection និង caret សម្រាប់ការកើតឡើងបន្ទាប់នៃ selection បច្ចុប្បន្ន។ ប្រសិនបើគ្មាន "
"selection សកម្មទេ វាជ្រើសរើសពាក្យនៅក្រោម caret។"

msgid "No longer necessary since methods now adjust carets themselves."
msgstr "លែងចាំបាច់ទៀតហើយ ចាប់តាំងពីវិធីសាស្ត្រឥឡូវនេះកែតម្រូវ carets ដោយខ្លួនឯង។"

msgid "Adjust the viewport so the caret is visible."
msgstr "កែតម្រូវ viewport ដើម្បីឱ្យ caret អាចមើលឃើញ។"

msgid ""
"Applies text from the [url=https://en.wikipedia.org/wiki/Input_method]Input "
"Method Editor[/url] (IME) to each caret and closes the IME if it is open."
msgstr ""
"អនុវត្តអត្ថបទពី [url=https://en.wikipedia.org/wiki/Input_method]Input Method "
"Editor[/url] (IME) ទៅកាន់ caret នីមួយៗ ហើយបិទ IME ប្រសិនបើវាកំពុងបើក។"

msgid ""
"Called when the user presses the backspace key. Can be overridden with "
"[method _backspace]."
msgstr ""
"ត្រូវបានហៅនៅពេលដែលអ្នកប្រើប្រាស់ចុចគ្រាប់ចុច backspace។ អាចត្រូវបានកែប្រែ (overridden) "
"ដោយប្រើ [method _backspace]។"

msgid ""
"Starts a multipart edit. All edits will be treated as one action until "
"[method end_complex_operation] is called."
msgstr ""
"ចាប់ផ្តើមការកែសម្រួលច្រើនផ្នែក (multipart edit)។ "
"ការកែសម្រួលទាំងអស់នឹងត្រូវបានចាត់ទុកថាជាសកម្មភាពតែមួយ រហូតទាល់តែ [method "
"end_complex_operation] ត្រូវបានហៅ។"

msgid ""
"Starts an edit for multiple carets. The edit must be ended with [method "
"end_multicaret_edit]. Multicaret edits can be used to edit text at multiple "
"carets and delay merging the carets until the end, so the caret indexes "
"aren't affected immediately. [method begin_multicaret_edit] and [method "
"end_multicaret_edit] can be nested, and the merge will happen at the last "
"[method end_multicaret_edit].\n"
"[codeblock]\n"
"begin_complex_operation()\n"
"begin_multicaret_edit()\n"
"for i in range(get_caret_count()):\n"
"\tif multicaret_edit_ignore_caret(i):\n"
"\t\tcontinue\n"
"\t# Logic here.\n"
"end_multicaret_edit()\n"
"end_complex_operation()\n"
"[/codeblock]"
msgstr ""
"ចាប់ផ្តើមការកែសម្រួលសម្រាប់ carets ជាច្រើន។ ការកែសម្រួលត្រូវតែបញ្ចប់ដោយប្រើ [method "
"end_multicaret_edit]។ ការកែសម្រួល Multicaret អាចត្រូវបានប្រើដើម្បីកែសម្រួលអត្ថបទនៅ "
"carets ជាច្រើន និងពន្យារពេលការបញ្ចូលគ្នានៃ carets រហូតដល់ចប់ ដើម្បីកុំឱ្យ caret indexes "
"រងផលប៉ះពាល់ភ្លាមៗ។ [method begin_multicaret_edit] និង [method "
"end_multicaret_edit] អាចដាក់បញ្ចូលគ្នា (nested) បាន ហើយការបញ្ចូលគ្នានឹងកើតឡើងនៅពេល "
"[method end_multicaret_edit] ចុងក្រោយ។\n"
"[codeblock]\n"
"begin_complex_operation()\n"
"begin_multicaret_edit()\n"
"for i in range(get_caret_count()):\n"
"\tif multicaret_edit_ignore_caret(i):\n"
"\t\tcontinue\n"
"\t# Logic here.\n"
"end_multicaret_edit()\n"
"end_complex_operation()\n"
"[/codeblock]"

msgid ""
"Centers the viewport on the line the editing caret is at. This also resets "
"the [member scroll_horizontal] value to [code]0[/code]."
msgstr ""
"ដាក់ viewport ឱ្យនៅកណ្តាលនៃបន្ទាត់ដែល editing caret កំពុងស្ថិតនៅ។ នេះក៏កំណត់តម្លៃ [member "
"scroll_horizontal] ទៅជា [code]0[/code] ផងដែរ។"

msgid "Clears the undo history."
msgstr "សម្អាតប្រវត្តិ undo។"

msgid ""
"Collapse all carets in the given range to the [param from_line] and [param "
"from_column] position.\n"
"[param inclusive] applies to both ends.\n"
"If [method is_in_mulitcaret_edit] is [code]true[/code], carets that are "
"collapsed will be [code]true[/code] for [method "
"multicaret_edit_ignore_caret].\n"
"[method merge_overlapping_carets] will be called if any carets were collapsed."
msgstr ""
"បង្រួម (collapse) carets ទាំងអស់នៅក្នុងចន្លោះដែលបានផ្តល់ឱ្យទៅកាន់ទីតាំង [param from_line] "
"និង [param from_column]។\n"
"[param inclusive] អនុវត្តចំពោះចុងទាំងពីរ។\n"
"ប្រសិនបើ [method is_in_mulitcaret_edit] គឺ [code]true[/code] carets "
"ដែលត្រូវបានបង្រួមនឹងមានតម្លៃ [code]true[/code] សម្រាប់ [method "
"multicaret_edit_ignore_caret]។\n"
"[method merge_overlapping_carets] នឹងត្រូវបានហៅ ប្រសិនបើ carets ណាមួយត្រូវបានបង្រួម។"

msgid ""
"Copies the current text selection. Can be overridden with [method _copy]."
msgstr ""
"ចម្លង (copy) អត្ថបទដែលកំពុងជ្រើសរើសបច្ចុប្បន្ន។ អាចត្រូវបានកែប្រែដោយប្រើ [method _copy]។"

msgid "Deletes the selected text."
msgstr "លុបអត្ថបទដែលបានជ្រើសរើស។"

msgid "Deselects the current selection."
msgstr "មិនជ្រើសរើស (deselect) អត្ថបទដែលកំពុងជ្រើសរើសបច្ចុប្បន្ន។"

msgid ""
"Marks the end of steps in the current action started with [method "
"start_action]."
msgstr ""
"សម្គាល់ការបញ្ចប់នៃជំហាននៅក្នុងសកម្មភាពបច្ចុប្បន្នដែលបានចាប់ផ្តើមដោយ [method start_action]។"

msgid ""
"Ends a multipart edit, started with [method begin_complex_operation]. If "
"called outside a complex operation, the current operation is pushed onto the "
"undo/redo stack."
msgstr ""
"បញ្ចប់ការកែសម្រួលច្រើនផ្នែក ដែលបានចាប់ផ្តើមដោយ [method begin_complex_operation]។ "
"ប្រសិនបើហៅនៅខាងក្រៅ complex operation ប្រតិបត្តិការបច្ចុប្បន្ននឹងត្រូវបានរុញទៅលើ undo/redo "
"stack។"

msgid ""
"Ends an edit for multiple carets, that was started with [method "
"begin_multicaret_edit]. If this was the last [method end_multicaret_edit] and "
"[method merge_overlapping_carets] was called, carets will be merged."
msgstr ""
"បញ្ចប់ការកែសម្រួលសម្រាប់ carets ជាច្រើន ដែលបានចាប់ផ្តើមដោយ [method "
"begin_multicaret_edit]។ ប្រសិនបើនេះជា [method end_multicaret_edit] ចុងក្រោយ ហើយ "
"[method merge_overlapping_carets] ត្រូវបានហៅ carets នឹងត្រូវបានបញ្ចូលគ្នា។"

msgid "Returns the column the editing caret is at."
msgstr "បង្វិល column ដែល editing caret កំពុងស្ថិតនៅ។"

msgid "Returns the number of carets in this [TextEdit]."
msgstr "បង្វិលចំនួន carets នៅក្នុង [TextEdit] នេះ។"

msgid "Returns the caret pixel draw position."
msgstr "បង្វិលទីតាំងគូរគិតជា pixel នៃ caret។"

msgid ""
"Carets no longer need to be edited in any specific order. If the carets need "
"to be sorted, use [method get_sorted_carets] instead."
msgstr ""
"Carets លែងត្រូវការកែសម្រួលតាមលំដាប់លំដោយជាក់លាក់ណាមួយទៀតហើយ។ ប្រសិនបើ carets ត្រូវការតម្រៀប "
"សូមប្រើ [method get_sorted_carets] ជំនួសវិញ។"

msgid ""
"Returns a list of caret indexes in their edit order, this done from bottom to "
"top. Edit order refers to the way actions such as [method "
"insert_text_at_caret] are applied."
msgstr ""
"បង្វិលបញ្ជីនៃ caret indexes តាមលំដាប់លំដោយនៃការកែសម្រួលរបស់ពួកវា ដែលធ្វើឡើងពីក្រោមទៅលើ។ "
"លំដាប់លំដោយនៃការកែសម្រួលសំដៅលើវិធីដែលសកម្មភាពដូចជា [method insert_text_at_caret] "
"ត្រូវបានអនុវត្ត។"

msgid "Returns the line the editing caret is on."
msgstr "បង្វិលបន្ទាត់ដែល editing caret កំពុងស្ថិតនៅ។"

msgid "Returns the wrap index the editing caret is on."
msgstr "បង្វិល wrap index ដែល editing caret កំពុងស្ថិតនៅ។"

msgid ""
"Returns the first column containing a non-whitespace character on the given "
"line. If there is only whitespace, returns the number of characters."
msgstr ""
"បង្វិល column ទីមួយដែលមានតួអក្សរមិនមែនជាចន្លោះទទេ (non-whitespace) "
"នៅលើបន្ទាត់ដែលបានផ្តល់ឱ្យ។ ប្រសិនបើមានតែចន្លោះទទេ វាបង្វិលចំនួនតួអក្សរ។"

msgid "Returns the first visible line."
msgstr "បង្វិលបន្ទាត់ទីមួយដែលអាចមើលឃើញ។"

msgid "Returns the number of gutters registered."
msgstr "បង្វិលចំនួន gutters ដែលបានចុះឈ្មោះ។"

msgid "Returns the name of the gutter at the given index."
msgstr "បង្វិលឈ្មោះនៃ gutter នៅ index ដែលបានផ្តល់ឱ្យ។"

msgid ""
"Returns the type of the gutter at the given index. Gutters can contain icons, "
"text, or custom visuals."
msgstr ""
"បង្វិលប្រភេទនៃ gutter នៅ index ដែលបានផ្តល់ឱ្យ។ Gutters អាចមានផ្ទុករូបតំណាង អត្ថបទ "
"ឬរូបភាពផ្ទាល់ខ្លួន (custom visuals)។"

msgid "Returns the width of the gutter at the given index."
msgstr "បង្វិលទទឹងនៃ gutter នៅ index ដែលបានផ្តល់ឱ្យ។"

msgid "Returns the [HScrollBar] used by [TextEdit]."
msgstr "បង្វិល [HScrollBar] ដែលប្រើដោយ [TextEdit]។"

msgid ""
"Returns the indent level of the given line. This is the number of spaces and "
"tabs at the beginning of the line, with the tabs taking the tab size into "
"account (see [method get_tab_size])."
msgstr ""
"បង្វិលកម្រិត indent នៃបន្ទាត់ដែលបានផ្តល់ឱ្យ។ នេះគឺជាចំនួននៃចន្លោះ (spaces) និង tabs "
"នៅដើមបន្ទាត់ ដោយ tabs ត្រូវបានគណនាទៅតាមទំហំ tab (សូមមើល [method get_tab_size])។"

msgid ""
"Returns the last visible line. Use [method "
"get_last_full_visible_line_wrap_index] for the wrap index."
msgstr ""
"បង្វិលបន្ទាត់ចុងក្រោយដែលអាចមើលឃើញ។ ប្រើ [method "
"get_last_full_visible_line_wrap_index] សម្រាប់ wrap index។"

msgid "Returns the last visible wrap index of the last visible line."
msgstr "បង្វិល wrap index ចុងក្រោយដែលអាចមើលឃើញនៃបន្ទាត់ចុងក្រោយដែលអាចមើលឃើញ។"

msgid "Returns the last unhidden line in the entire [TextEdit]."
msgstr "បង្វិលបន្ទាត់ចុងក្រោយដែលមិនបានលាក់នៅក្នុង [TextEdit] ទាំងមូល។"

msgid "Returns the text of a specific line."
msgstr "បង្វិលអត្ថបទនៃបន្ទាត់ជាក់លាក់មួយ។"

msgid ""
"Returns the custom background color of the given line. If no color is set, "
"returns [code]Color(0, 0, 0, 0)[/code]."
msgstr ""
"បង្វិលពណ៌ផ្ទៃខាងក្រោយផ្ទាល់ខ្លួន (custom background color) នៃបន្ទាត់ដែលបានផ្តល់ឱ្យ។ "
"ប្រសិនបើគ្មានពណ៌ត្រូវបានកំណត់ទេ វាបង្វិល [code]Color(0, 0, 0, 0)[/code]។"

msgid ""
"Returns the line and column at the given position. In the returned vector, "
"[code]x[/code] is the column and [code]y[/code] is the line.\n"
"If [param clamp_line] is [code]false[/code] and [param position] is below the "
"last line, [code]Vector2i(-1, -1)[/code] is returned.\n"
"If [param clamp_column] is [code]false[/code] and [param position] is outside "
"the column range of the line, [code]Vector2i(-1, -1)[/code] is returned."
msgstr ""
"បង្វិលបន្ទាត់ និង column នៅទីតាំងដែលបានផ្តល់ឱ្យ។ នៅក្នុង vector ដែលបានបង្វិល [code]x[/code] "
"គឺជា column ហើយ [code]y[/code] គឺជាបន្ទាត់។\n"
"ប្រសិនបើ [param clamp_line] គឺ [code]false[/code] ហើយ [param position] "
"នៅក្រោមបន្ទាត់ចុងក្រោយ [code]Vector2i(-1, -1)[/code] ត្រូវបានបង្វិល។\n"
"ប្រសិនបើ [param clamp_column] គឺ [code]false[/code] ហើយ [param position] "
"នៅក្រៅចន្លោះ column នៃបន្ទាត់ [code]Vector2i(-1, -1)[/code] ត្រូវបានបង្វិល។"

msgid "Returns the number of lines in the text."
msgstr "បង្វិលចំនួនបន្ទាត់នៅក្នុងអត្ថបទ។"

msgid ""
"Returns the icon currently in [param gutter] at [param line]. This only works "
"when the gutter type is [constant GUTTER_TYPE_ICON] (see [method "
"set_gutter_type])."
msgstr ""
"បង្វិលរូបតំណាងដែលមានបច្ចុប្បន្ននៅក្នុង [param gutter] នៅត្រង់ [param line]។ "
"នេះដំណើរការតែនៅពេលដែលប្រភេទ gutter គឺជា [constant GUTTER_TYPE_ICON] (សូមមើល "
"[method set_gutter_type])។"

msgid "Returns the color currently in [param gutter] at [param line]."
msgstr "បង្វិលពណ៌ដែលមានបច្ចុប្បន្ននៅក្នុង [param gutter] នៅត្រង់ [param line]។"

msgid "Returns the metadata currently in [param gutter] at [param line]."
msgstr "បង្វិល metadata ដែលមានបច្ចុប្បន្ននៅក្នុង [param gutter] នៅត្រង់ [param line]។"

msgid ""
"Returns the text currently in [param gutter] at [param line]. This only works "
"when the gutter type is [constant GUTTER_TYPE_STRING] (see [method "
"set_gutter_type])."
msgstr ""
"បង្វិលអត្ថបទដែលមានបច្ចុប្បន្ននៅក្នុង [param gutter] នៅត្រង់ [param line]។ "
"នេះដំណើរការតែនៅពេលដែលប្រភេទ gutter គឺជា [constant GUTTER_TYPE_STRING] (សូមមើល "
"[method set_gutter_type])។"

msgid ""
"Returns the maximum value of the line height among all lines.\n"
"[b]Note:[/b] The return value is influenced by [theme_item line_spacing] and "
"[theme_item font_size]. And it will not be less than [code]1[/code]."
msgstr ""
"បង្វិលតម្លៃអតិបរមានៃកម្ពស់បន្ទាត់ក្នុងចំណោមបន្ទាត់ទាំងអស់។\n"
"[b]ចំណាំ៖[/b] តម្លៃបង្វិលរងឥទ្ធិពលដោយ [theme_item line_spacing] និង [theme_item "
"font_size]។ ហើយវានឹងមិនទាបជាង [code]1[/code] ទេ។"

msgid ""
"Returns an [Array] of line ranges where [code]x[/code] is the first line and "
"[code]y[/code] is the last line. All lines within these ranges will have a "
"caret on them or be part of a selection. Each line will only be part of one "
"line range, even if it has multiple carets on it.\n"
"If a selection's end column ([method get_selection_to_column]) is at column "
"[code]0[/code], that line will not be included. If a selection begins on the "
"line after another selection ends and [param merge_adjacent] is [code]true[/"
"code], or they begin and end on the same line, one line range will include "
"both selections."
msgstr ""
"បង្វិល [Array] នៃចន្លោះបន្ទាត់ (line ranges) ដែល [code]x[/code] គឺជាបន្ទាត់ទីមួយ ហើយ "
"[code]y[/code] គឺជាបន្ទាត់ចុងក្រោយ។ បន្ទាត់ទាំងអស់នៅក្នុងចន្លោះទាំងនេះនឹងមាន caret នៅលើពួកវា "
"ឬជាផ្នែកមួយនៃ selection។ បន្ទាត់នីមួយៗនឹងជាផ្នែកមួយនៃចន្លោះបន្ទាត់តែមួយប៉ុណ្ណោះ ទោះបីជាវាមាន "
"carets ជាច្រើននៅលើវាក៏ដោយ។\n"
"ប្រសិនបើ column ចុងក្រោយនៃ selection ([method get_selection_to_column]) នៅត្រង់ "
"column [code]0[/code] បន្ទាត់នោះនឹងមិនត្រូវបានរាប់បញ្ចូលទេ។ ប្រសិនបើ selection "
"ចាប់ផ្តើមនៅលើបន្ទាត់បន្ទាប់ពី selection មួយទៀតបញ្ចប់ ហើយ [param merge_adjacent] គឺ "
"[code]true[/code] ឬពួកវាចាប់ផ្តើម និងបញ្ចប់នៅលើបន្ទាត់តែមួយ ចន្លោះបន្ទាត់មួយនឹងរាប់បញ្ចូល "
"selections ទាំងពីរ។"

msgid "Returns the width in pixels of the [param wrap_index] on [param line]."
msgstr "បង្វិលទទឹងគិតជា pixels នៃ [param wrap_index] នៅលើ [param line]។"

msgid ""
"Returns line text as it is currently displayed, including IME composition "
"string."
msgstr "បង្វិលអត្ថបទបន្ទាត់ដូចដែលវាកំពុងបង្ហាញបច្ចុប្បន្ន រួមទាំង IME composition string។"

msgid "Returns the number of times the given line is wrapped."
msgstr "បង្វិលចំនួនដងដែលបន្ទាត់ដែលបានផ្តល់ឱ្យត្រូវបានរុំ (wrapped)។"

msgid ""
"Returns the wrap index of the given column on the given line. This ranges "
"from [code]0[/code] to [method get_line_wrap_count]."
msgstr ""
"បង្វិល wrap index នៃ column ដែលបានផ្តល់ឱ្យនៅលើបន្ទាត់ដែលបានផ្តល់ឱ្យ។ វាមានចន្លោះពី "
"[code]0[/code] ដល់ [method get_line_wrap_count]។"

msgid "Returns an array of [String]s representing each wrapped index."
msgstr "បង្វិល array នៃ [String]s ដែលតំណាងឱ្យ wrapped index នីមួយៗ។"

msgid "Returns the local mouse position adjusted for the text direction."
msgstr "បង្វិលទីតាំង mouse ក្នុងតំបន់ ដែលបានកែតម្រូវទៅតាមទិសដៅអត្ថបទ។"

msgid ""
"Returns the [PopupMenu] of this [TextEdit]. By default, this menu is "
"displayed when right-clicking on the [TextEdit].\n"
"You can add custom menu items or remove standard ones. Make sure your IDs "
"don't conflict with the standard ones (see [enum MenuItems]). For example:\n"
"[codeblocks]\n"
"[gdscript]\n"
"func _ready():\n"
"\tvar menu = get_menu()\n"
"\t# Remove all items after \"Redo\".\n"
"\tmenu.item_count = menu.get_item_index(MENU_REDO) + 1\n"
"\t# Add custom items.\n"
"\tmenu.add_separator()\n"
"\tmenu.add_item(\"Insert Date\", MENU_MAX + 1)\n"
"\t# Connect callback.\n"
"\tmenu.id_pressed.connect(_on_item_pressed)\n"
"\n"
"func _on_item_pressed(id):\n"
"\tif id == MENU_MAX + 1:\n"
"\t\tinsert_text_at_caret(Time.get_date_string_from_system())\n"
"[/gdscript]\n"
"[csharp]\n"
"public override void _Ready()\n"
"{\n"
"\tvar menu = GetMenu();\n"
"\t// Remove all items after \"Redo\".\n"
"\tmenu.ItemCount = menu.GetItemIndex(TextEdit.MenuItems.Redo) + 1;\n"
"\t// Add custom items.\n"
"\tmenu.AddSeparator();\n"
"\tmenu.AddItem(\"Insert Date\", TextEdit.MenuItems.Max + 1);\n"
"\t// Add event handler.\n"
"\tmenu.IdPressed += OnItemPressed;\n"
"}\n"
"\n"
"public void OnItemPressed(int id)\n"
"{\n"
"\tif (id == TextEdit.MenuItems.Max + 1)\n"
"\t{\n"
"\t\tInsertTextAtCaret(Time.GetDateStringFromSystem());\n"
"\t}\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]Warning:[/b] This is a required internal node, removing and freeing it may "
"cause a crash. If you wish to hide it or any of its children, use their "
"[member Window.visible] property."
msgstr ""
"បង្វិល [PopupMenu] នៃ [TextEdit] នេះ។ តាមលំនាំដើម ម៉ឺនុយនេះត្រូវបានបង្ហាញនៅពេលចុច mouse "
"ខាងស្តាំលើ [TextEdit]។\n"
"អ្នកអាចបន្ថែមធាតុម៉ឺនុយផ្ទាល់ខ្លួន ឬដកធាតុស្តង់ដារចេញ។ សូមប្រាកដថា IDs "
"របស់អ្នកមិនប៉ះទង្គិចជាមួយធាតុស្តង់ដារ (សូមមើល [enum MenuItems])។ ឧទាហរណ៍៖\n"
"[codeblocks]\n"
"[gdscript]\n"
"func _ready():\n"
"\tvar menu = get_menu()\n"
"\t# Remove all items after \"Redo\".\n"
"\tmenu.item_count = menu.get_item_index(MENU_REDO) + 1\n"
"\t# Add custom items.\n"
"\tmenu.add_separator()\n"
"\tmenu.add_item(\"Insert Date\", MENU_MAX + 1)\n"
"\t# Connect callback.\n"
"\tmenu.id_pressed.connect(_on_item_pressed)\n"
"\n"
"func _on_item_pressed(id):\n"
"\tif id == MENU_MAX + 1:\n"
"\t\tinsert_text_at_caret(Time.get_date_string_from_system())\n"
"[/gdscript]\n"
"[csharp]\n"
"public override void _Ready()\n"
"{\n"
"\tvar menu = GetMenu();\n"
"\t// Remove all items after \"Redo\".\n"
"\tmenu.ItemCount = menu.GetItemIndex(TextEdit.MenuItems.Redo) + 1;\n"
"\t// Add custom items.\n"
"\tmenu.AddSeparator();\n"
"\tmenu.AddItem(\"Insert Date\", TextEdit.MenuItems.Max + 1);\n"
"\t// Add event handler.\n"
"\tmenu.IdPressed += OnItemPressed;\n"
"}\n"
"\n"
"public void OnItemPressed(int id)\n"
"{\n"
"\tif (id == TextEdit.MenuItems.Max + 1)\n"
"\t{\n"
"\t\tInsertTextAtCaret(Time.GetDateStringFromSystem());\n"
"\t}\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]ការព្រមាន៖[/b] នេះគឺជា internal node ដែលទាមទារឱ្យមាន ការដកវាចេញ និងលុបវាចោល "
"(freeing) អាចបណ្តាលឱ្យគាំងកម្មវិធី (crash)។ ប្រសិនបើអ្នកចង់លាក់វា ឬ children ណាមួយរបស់វា "
"សូមប្រើលក្ខណៈសម្បត្តិ [member Window.visible] របស់ពួកវា។"

msgid "Returns the equivalent minimap line at [param position]."
msgstr "បង្វិលបន្ទាត់ minimap ដែលស្មើគ្នានៅត្រង់ [param position]។"

msgid "Returns the number of lines that may be drawn on the minimap."
msgstr "បង្វិលចំនួនបន្ទាត់ដែលអាចគូរបាននៅលើ minimap។"

msgid ""
"Returns the correct column at the end of a composite character like ❤️‍🩹 "
"(mending heart; Unicode: [code]U+2764 U+FE0F U+200D U+1FA79[/code]) which is "
"comprised of more than one Unicode code point, if the caret is at the start "
"of the composite character. Also returns the correct column with the caret at "
"mid grapheme and for non-composite characters.\n"
"[b]Note:[/b] To check at caret location use "
"[code]get_next_composite_character_column(get_caret_line(), "
"get_caret_column())[/code]"
msgstr ""
"បង្វិល column ដែលត្រឹមត្រូវនៅចុងបញ្ចប់នៃតួអក្សរផ្សំ (composite character) ដូចជា ❤️‍🩹 "
"(mending heart; Unicode: [code]U+2764 U+FE0F U+200D U+1FA79[/code]) ដែលមាន "
"Unicode code point ច្រើនជាងមួយ ប្រសិនបើ caret នៅដើមតួអក្សរផ្សំ។ ក៏បង្វិល column "
"ដែលត្រឹមត្រូវនៅពេល caret នៅកណ្តាល grapheme និងសម្រាប់តួអក្សរមិនមែនផ្សំផងដែរ។\n"
"[b]ចំណាំ៖[/b] ដើម្បីពិនិត្យមើលទីតាំង caret សូមប្រើ "
"[code]get_next_composite_character_column(get_caret_line(), "
"get_caret_column())[/code]"

msgid ""
"Similar to [method get_next_visible_line_offset_from], but takes into account "
"the line wrap indexes. In the returned vector, [code]x[/code] is the line, "
"[code]y[/code] is the wrap index."
msgstr ""
"ស្រដៀងនឹង [method get_next_visible_line_offset_from] ដែរ ប៉ុន្តែយក line wrap "
"indexes មកគណនាផងដែរ។ នៅក្នុង vector ដែលបានបង្វិល [code]x[/code] គឺជាបន្ទាត់ ហើយ "
"[code]y[/code] គឺជា wrap index។"

msgid ""
"Returns the count to the next visible line from [param line] to [code]line + "
"visible_amount[/code]. Can also count backwards. For example if a [TextEdit] "
"has 5 lines with lines 2 and 3 hidden, calling this with [code]line = 1, "
"visible_amount = 1[/code] would return 3."
msgstr ""
"បង្វិលចំនួនរាប់ទៅកាន់បន្ទាត់ដែលអាចមើលឃើញបន្ទាប់ពី [param line] ទៅ [code]line + "
"visible_amount[/code]។ ក៏អាចរាប់ថយក្រោយផងដែរ។ ឧទាហរណ៍ ប្រសិនបើ [TextEdit] មាន 5 "
"បន្ទាត់ ហើយបន្ទាត់ទី 2 និងទី 3 ត្រូវបានលាក់ ការហៅវាដោយប្រើ [code]line = 1, "
"visible_amount = 1[/code] នឹងបង្វិល 3។"

msgid ""
"Returns the local position for the given [param line] and [param column]. If "
"[code]x[/code] or [code]y[/code] of the returned vector equal [code]-1[/"
"code], the position is outside of the viewable area of the control.\n"
"[b]Note:[/b] The Y position corresponds to the bottom side of the line. Use "
"[method get_rect_at_line_column] to get the top side position."
msgstr ""
"បង្វិលទីតាំងក្នុងតំបន់សម្រាប់ [param line] និង [param column] ដែលបានផ្តល់ឱ្យ។ ប្រសិនបើ "
"[code]x[/code] ឬ [code]y[/code] នៃ vector ដែលបានបង្វិលស្មើនឹង [code]-1[/code] "
"ទីតាំងនោះគឺនៅខាងក្រៅតំបន់ដែលអាចមើលឃើញរបស់ control។\n"
"[b]ចំណាំ៖[/b] ទីតាំង Y ត្រូវគ្នានឹងផ្នែកខាងក្រោមនៃបន្ទាត់។ ប្រើ [method "
"get_rect_at_line_column] ដើម្បីទទួលបានទីតាំងផ្នែកខាងលើ។"

msgid ""
"Returns the correct column at the start of a composite character like ❤️‍🩹 "
"(mending heart; Unicode: [code]U+2764 U+FE0F U+200D U+1FA79[/code]) which is "
"comprised of more than one Unicode code point, if the caret is at the end of "
"the composite character. Also returns the correct column with the caret at "
"mid grapheme and for non-composite characters.\n"
"[b]Note:[/b] To check at caret location use "
"[code]get_previous_composite_character_column(get_caret_line(), "
"get_caret_column())[/code]"
msgstr ""
"បង្វិល column ដែលត្រឹមត្រូវនៅដើមតួអក្សរផ្សំ (composite character) ដូចជា ❤️‍🩹 (mending "
"heart; Unicode: [code]U+2764 U+FE0F U+200D U+1FA79[/code]) ដែលមាន Unicode "
"code point ច្រើនជាងមួយ ប្រសិនបើ caret នៅចុងបញ្ចប់នៃតួអក្សរផ្សំ។ ក៏បង្វិល column "
"ដែលត្រឹមត្រូវនៅពេល caret នៅកណ្តាល grapheme និងសម្រាប់តួអក្សរមិនមែនផ្សំផងដែរ។\n"
"[b]ចំណាំ៖[/b] ដើម្បីពិនិត្យមើលទីតាំង caret សូមប្រើ "
"[code]get_previous_composite_character_column(get_caret_line(), "
"get_caret_column())[/code]"

msgid ""
"Returns the local position and size for the grapheme at the given [param "
"line] and [param column]. If [code]x[/code] or [code]y[/code] position of the "
"returned rect equal [code]-1[/code], the position is outside of the viewable "
"area of the control.\n"
"[b]Note:[/b] The Y position of the returned rect corresponds to the top side "
"of the line, unlike [method get_pos_at_line_column] which returns the bottom "
"side."
msgstr ""
"បង្វិលទីតាំង និងទំហំក្នុងតំបន់សម្រាប់ grapheme នៅត្រង់ [param line] និង [param column] "
"ដែលបានផ្តល់ឱ្យ។ ប្រសិនបើទីតាំង [code]x[/code] ឬ [code]y[/code] នៃ rect "
"ដែលបានបង្វិលស្មើនឹង [code]-1[/code] ទីតាំងនោះគឺនៅខាងក្រៅតំបន់ដែលអាចមើលឃើញរបស់ control។\n"
"[b]ចំណាំ៖[/b] ទីតាំង Y នៃ rect ដែលបានបង្វិលត្រូវគ្នានឹងផ្នែកខាងលើនៃបន្ទាត់ ខុសពី [method "
"get_pos_at_line_column] ដែលបង្វិលផ្នែកខាងក្រោម។"

msgid "Returns the last tagged saved version from [method tag_saved_version]."
msgstr "បង្វិល version ដែលបានរក្សាទុក និងដាក់ស្លាកចុងក្រោយពី [method tag_saved_version]។"

msgid "Returns the scroll position for [param wrap_index] of [param line]."
msgstr "បង្វិលទីតាំងរំកិល (scroll position) សម្រាប់ [param wrap_index] នៃ [param line]។"

msgid ""
"Returns the text inside the selection of a caret, or all the carets if [param "
"caret_index] is its default value [code]-1[/code]."
msgstr ""
"បង្វិលអត្ថបទនៅខាងក្នុង selection នៃ caret ឬ carets ទាំងអស់ ប្រសិនបើ [param "
"caret_index] គឺជាតម្លៃលំនាំដើមរបស់វា [code]-1[/code]។"

msgid ""
"Returns the caret index of the selection at the given [param line] and [param "
"column], or [code]-1[/code] if there is none.\n"
"If [param include_edges] is [code]false[/code], the position must be inside "
"the selection and not at either end. If [param only_selections] is "
"[code]false[/code], carets without a selection will also be considered."
msgstr ""
"បង្វិល caret index នៃ selection នៅត្រង់ [param line] និង [param column] "
"ដែលបានផ្តល់ឱ្យ ឬ [code]-1[/code] ប្រសិនបើគ្មាន។\n"
"ប្រសិនបើ [param include_edges] គឺ [code]false[/code] ទីតាំងត្រូវតែនៅខាងក្នុង selection "
"ហើយមិនមែននៅចុងសងខាងណាមួយទេ។ ប្រសិនបើ [param only_selections] គឺ [code]false[/code] "
"carets ដែលគ្មាន selection ក៏នឹងត្រូវបានយកមកគណនាផងដែរ។"

msgid "Use [method get_selection_origin_column] instead."
msgstr "សូមប្រើ [method get_selection_origin_column] ជំនួសវិញ។"

msgid "Returns the original start column of the selection."
msgstr "បង្វិល column ចាប់ផ្តើមដើមនៃ selection។"

msgid ""
"Returns the selection begin column. Returns the caret column if there is no "
"selection."
msgstr ""
"បង្វិល column ចាប់ផ្តើមនៃ selection។ បង្វិល caret column ប្រសិនបើគ្មាន selection។"

msgid ""
"Returns the selection begin line. Returns the caret line if there is no "
"selection."
msgstr "បង្វិលបន្ទាត់ចាប់ផ្តើមនៃ selection។ បង្វិល caret line ប្រសិនបើគ្មាន selection។"

msgid "Use [method get_selection_origin_line] instead."
msgstr "សូមប្រើ [method get_selection_origin_line] ជំនួសវិញ។"

msgid "Returns the original start line of the selection."
msgstr "បង្វិលបន្ទាត់ចាប់ផ្តើមដើមនៃ selection។"

msgid "Returns the current selection mode."
msgstr "បង្វិលរបៀបជ្រើសរើស (selection mode) បច្ចុប្បន្ន។"

msgid ""
"Returns the origin column of the selection. This is the opposite end from the "
"caret."
msgstr "បង្វិល column ដើម (origin) នៃ selection។ នេះគឺជាចុងម្ខាងទៀតពី caret។"

msgid ""
"Returns the origin line of the selection. This is the opposite end from the "
"caret."
msgstr "បង្វិលបន្ទាត់ដើម (origin) នៃ selection។ នេះគឺជាចុងម្ខាងទៀតពី caret។"

msgid ""
"Returns the selection end column. Returns the caret column if there is no "
"selection."
msgstr "បង្វិល column ចុងបញ្ចប់នៃ selection។ បង្វិល caret column ប្រសិនបើគ្មាន selection។"

msgid ""
"Returns the selection end line. Returns the caret line if there is no "
"selection."
msgstr "បង្វិលបន្ទាត់ចុងបញ្ចប់នៃ selection។ បង្វិល caret line ប្រសិនបើគ្មាន selection។"

msgid ""
"Returns the carets sorted by selection beginning from lowest line and column "
"to highest (from top to bottom of text).\n"
"If [param include_ignored_carets] is [code]false[/code], carets from [method "
"multicaret_edit_ignore_caret] will be ignored."
msgstr ""
"បង្វិល carets ដែលបានតម្រៀបតាមការចាប់ផ្តើម selection ពីបន្ទាត់ និង column "
"ទាបបំផុតទៅខ្ពស់បំផុត (ពីលើចុះក្រោមនៃអត្ថបទ)។\n"
"ប្រសិនបើ [param include_ignored_carets] គឺ [code]false[/code] carets ពី [method "
"multicaret_edit_ignore_caret] នឹងត្រូវបានមិនអើពើ។"

msgid "Returns the total width of all gutters and internal padding."
msgstr "បង្វិលទទឹងសរុបនៃ gutters ទាំងអស់ និង internal padding។"

msgid ""
"Returns the total number of lines in the text. This includes wrapped lines "
"and excludes folded lines. If [member wrap_mode] is set to [constant "
"LINE_WRAPPING_NONE] and no lines are folded (see [method "
"CodeEdit.is_line_folded]) then this is equivalent to [method get_line_count]. "
"See [method get_visible_line_count_in_range] for a limited range of lines."
msgstr ""
"បង្វិលចំនួនបន្ទាត់សរុបនៅក្នុងអត្ថបទ។ នេះរាប់បញ្ចូលទាំងបន្ទាត់ដែលរុំ (wrapped lines) "
"និងមិនរាប់បញ្ចូលបន្ទាត់ដែលបត់ (folded lines)។ ប្រសិនបើ [member wrap_mode] ត្រូវបានកំណត់ទៅជា "
"[constant LINE_WRAPPING_NONE] ហើយគ្មានបន្ទាត់ត្រូវបានបត់ (សូមមើល [method "
"CodeEdit.is_line_folded]) នោះវាស្មើនឹង [method get_line_count]។ សូមមើល [method "
"get_visible_line_count_in_range] សម្រាប់ចន្លោះបន្ទាត់ដែលមានកំណត់។"

msgid "Returns the [VScrollBar] of the [TextEdit]."
msgstr "បង្វិល [VScrollBar] របស់ [TextEdit]។"

msgid ""
"Returns the current version of the [TextEdit]. The version is a count of "
"recorded operations by the undo/redo history."
msgstr ""
"បង្វិល version បច្ចុប្បន្ននៃ [TextEdit]។ version "
"គឺជាការរាប់ចំនួនប្រតិបត្តិការដែលបានកត់ត្រាដោយប្រវត្តិ undo/redo។"

msgid ""
"Returns the number of lines that can visually fit, rounded down, based on "
"this control's height."
msgstr ""
"បង្វិលចំនួនបន្ទាត់ដែលអាចដាក់ចូលគ្នាបានដោយមើលឃើញ ដោយបង្គត់ចុះក្រោម ដោយផ្អែកលើកម្ពស់របស់ control "
"នេះ។"

msgid ""
"Returns the total number of lines between [param from_line] and [param "
"to_line] (inclusive) in the text. This includes wrapped lines and excludes "
"folded lines. If the range covers all lines it is equivalent to [method "
"get_total_visible_line_count]."
msgstr ""
"បង្វិលចំនួនបន្ទាត់សរុបរវាង [param from_line] និង [param to_line] (រាប់បញ្ចូលទាំងពីរ) "
"នៅក្នុងអត្ថបទ។ នេះរាប់បញ្ចូលទាំងបន្ទាត់ដែលរុំ និងមិនរាប់បញ្ចូលបន្ទាត់ដែលបត់។ "
"ប្រសិនបើចន្លោះនេះគ្របដណ្តប់លើបន្ទាត់ទាំងអស់ វាស្មើនឹង [method "
"get_total_visible_line_count]។"

msgid "Returns a [String] text with the word under the caret's location."
msgstr "បង្វិលអត្ថបទ [String] ដែលមានពាក្យនៅក្រោមទីតាំងរបស់ caret។"

msgid "Inserts a new line with [param text] at [param line]."
msgstr "បញ្ចូលបន្ទាត់ថ្មីជាមួយ [param text] នៅត្រង់ [param line]។"

msgid ""
"Inserts the [param text] at [param line] and [param column].\n"
"If [param before_selection_begin] is [code]true[/code], carets and selections "
"that begin at [param line] and [param column] will moved to the end of the "
"inserted text, along with all carets after it.\n"
"If [param before_selection_end] is [code]true[/code], selections that end at "
"[param line] and [param column] will be extended to the end of the inserted "
"text. These parameters can be used to insert text inside of or outside of "
"selections."
msgstr ""
"បញ្ចូល [param text] នៅត្រង់ [param line] និង [param column]។\n"
"ប្រសិនបើ [param before_selection_begin] គឺ [code]true[/code] carets និង "
"selections ដែលចាប់ផ្តើមនៅត្រង់ [param line] និង [param column] "
"នឹងត្រូវបានរំកិលទៅចុងបញ្ចប់នៃអត្ថបទដែលបានបញ្ចូល រួមជាមួយ carets ទាំងអស់ដែលនៅបន្ទាប់ពីវា។\n"
"ប្រសិនបើ [param before_selection_end] គឺ [code]true[/code] selections "
"ដែលបញ្ចប់នៅត្រង់ [param line] និង [param column] "
"នឹងត្រូវបានពង្រីកទៅដល់ចុងបញ្ចប់នៃអត្ថបទដែលបានបញ្ចូល។ "
"ប៉ារ៉ាម៉ែត្រទាំងនេះអាចត្រូវបានប្រើដើម្បីបញ្ចូលអត្ថបទនៅខាងក្នុង ឬខាងក្រៅ selections។"

msgid "Insert the specified text at the caret position."
msgstr "បញ្ចូលអត្ថបទដែលបានបញ្ជាក់នៅទីតាំង caret។"

msgid ""
"Returns [code]true[/code] if the caret of the selection is after the "
"selection origin. This can be used to determine the direction of the "
"selection."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ caret នៃ selection នៅបន្ទាប់ពី selection origin។ "
"នេះអាចត្រូវបានប្រើដើម្បីកំណត់ទិសដៅនៃ selection។"

msgid ""
"Returns [code]true[/code] if the caret is visible, [code]false[/code] "
"otherwise. A caret will be considered hidden if it is outside the scrollable "
"area when scrolling is enabled.\n"
"[b]Note:[/b] [method is_caret_visible] does not account for a caret being off-"
"screen if it is still within the scrollable area. It will return [code]true[/"
"code] even if the caret is off-screen as long as it meets [TextEdit]'s own "
"conditions for being visible. This includes uses of [member "
"scroll_fit_content_width] and [member scroll_fit_content_height] that cause "
"the [TextEdit] to expand beyond the viewport's bounds.\n"
"[b]Note:[/b] This method does [i]not[/i] guarantee an accurate visibility "
"check immediately after setting the caret position. The correct value may "
"only be available in the next frame after the [TextEdit] has finished "
"drawing. This also applies to any operation that causes the [TextEdit] to "
"change in size."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ caret អាចមើលឃើញ បើមិនដូច្នេះទេបង្វិល [code]false[/"
"code]។ caret នឹងត្រូវបានចាត់ទុកថាលាក់ ប្រសិនបើវានៅខាងក្រៅតំបន់ដែលអាចរំកិលបាន (scrollable "
"area) នៅពេលដែលការរំកិលត្រូវបានបើក។\n"
"[b]ចំណាំ៖[/b] [method is_caret_visible] មិនគិតពី caret ដែលនៅក្រៅអេក្រង់ទេ "
"ប្រសិនបើវានៅតែស្ថិតនៅក្នុងតំបន់ដែលអាចរំកិលបាន។ វានឹងបង្វិល [code]true[/code] ទោះបីជា caret "
"នៅក្រៅអេក្រង់ក៏ដោយ ដរាបណាវាបំពេញលក្ខខណ្ឌផ្ទាល់ខ្លួនរបស់ [TextEdit] សម្រាប់ការមើលឃើញ។ "
"នេះរួមបញ្ចូលទាំងការប្រើប្រាស់ [member scroll_fit_content_width] និង [member "
"scroll_fit_content_height] ដែលធ្វើឱ្យ [TextEdit] ពង្រីកហួសពីព្រំដែនរបស់ viewport។\n"
"[b]ចំណាំ៖[/b] វិធីសាស្ត្រនេះ [i]មិន[/i] "
"ធានាពីការពិនិត្យមើលភាពមើលឃើញដែលត្រឹមត្រូវភ្លាមៗបន្ទាប់ពីការកំណត់ទីតាំង caret ទេ។ "
"តម្លៃដែលត្រឹមត្រូវអាចនឹងអាចប្រើបានតែនៅក្នុង frame បន្ទាប់ប៉ុណ្ណោះ បន្ទាប់ពី [TextEdit] "
"បានបញ្ចប់ការគូរ។ នេះក៏អនុវត្តចំពោះប្រតិបត្តិការណាមួយដែលធ្វើឱ្យ [TextEdit] ផ្លាស់ប្តូរទំហំផងដែរ។"

msgid ""
"Returns [code]true[/code] if the user is dragging their mouse for scrolling, "
"selecting, or text dragging."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើអ្នកប្រើប្រាស់កំពុងអូស mouse របស់ពួកគេដើម្បីរំកិល ជ្រើសរើស "
"ឬអូសអត្ថបទ។"

msgid ""
"Returns [code]true[/code] if the gutter at the given index is clickable. See "
"[method set_gutter_clickable]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ gutter នៅ index ដែលបានផ្តល់ឱ្យអាចចុចបាន។ សូមមើល "
"[method set_gutter_clickable]។"

msgid ""
"Returns [code]true[/code] if the gutter at the given index is currently "
"drawn. See [method set_gutter_draw]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ gutter នៅ index ដែលបានផ្តល់ឱ្យកំពុងត្រូវបានគូរបច្ចុប្បន្ន។ "
"សូមមើល [method set_gutter_draw]។"

msgid ""
"Returns [code]true[/code] if the gutter at the given index is overwritable. "
"See [method set_gutter_overwritable]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ gutter នៅ index ដែលបានផ្តល់ឱ្យអាចសរសេរជាន់ពីលើបាន "
"(overwritable)។ សូមមើល [method set_gutter_overwritable]។"

msgid ""
"Returns [code]true[/code] if a [method begin_multicaret_edit] has been called "
"and [method end_multicaret_edit] has not yet been called."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ [method begin_multicaret_edit] ត្រូវបានហើយ ហើយ "
"[method end_multicaret_edit] មិនទាន់ត្រូវបានហៅនៅឡើយ។"

msgid ""
"Returns [code]true[/code] if the gutter at the given index on the given line "
"is clickable. See [method set_line_gutter_clickable]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ gutter នៅ index "
"ដែលបានផ្តល់ឱ្យនៅលើបន្ទាត់ដែលបានផ្តល់ឱ្យអាចចុចបាន។ សូមមើល [method "
"set_line_gutter_clickable]។"

msgid ""
"Returns [code]true[/code] if the given line is within the scope of the "
"scrollable area of the viewport."
msgstr ""
"បង្វិល [code]true[/code] "
"ប្រសិនបើបន្ទាត់ដែលបានផ្តល់ឱ្យស្ថិតនៅក្នុងដែនកំណត់នៃតំបន់ដែលអាចរំកិលបានរបស់ viewport។"

msgid "Returns if the given line is wrapped."
msgstr "បង្វិលថាតើបន្ទាត់ដែលបានផ្តល់ឱ្យត្រូវបានរុំ (wrapped) ឬអត់។"

msgid ""
"Returns [code]true[/code] if the menu is visible. Use this instead of "
"[code]get_menu().visible[/code] to improve performance (so the creation of "
"the menu is avoided). See [method get_menu]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើម៉ឺនុយអាចមើលឃើញ។ ប្រើវាជំនួសឱ្យ "
"[code]get_menu().visible[/code] ដើម្បីកែលម្អដំណើរការ (ដើម្បីជៀសវាងការបង្កើតម៉ឺនុយ)។ "
"សូមមើល [method get_menu]។"

msgid ""
"Returns [code]true[/code] if the mouse is over a selection. If [param edges] "
"is [code]true[/code], the edges are considered part of the selection."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ mouse នៅលើ selection។ ប្រសិនបើ [param edges] គឺ "
"[code]true[/code] គែមទាំងនោះត្រូវបានចាត់ទុកថាជាផ្នែកមួយនៃ selection។"

msgid ""
"Returns [code]true[/code] if overtype mode is enabled. See [method "
"set_overtype_mode_enabled]."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើរបៀប overtype (សរសេរជាន់ពីលើ) ត្រូវបានបើក។ សូមមើល "
"[method set_overtype_mode_enabled]។"

msgid ""
"Merge the gutters from [param from_line] into [param to_line]. Only "
"overwritable gutters will be copied. See [method set_gutter_overwritable]."
msgstr ""
"បញ្ចូល gutters ពី [param from_line] ទៅក្នុង [param to_line]។ មានតែ gutters "
"ដែលអាចសរសេរជាន់ពីលើបានប៉ុណ្ណោះដែលនឹងត្រូវបានចម្លង។ សូមមើល [method "
"set_gutter_overwritable]។"

msgid ""
"Merges any overlapping carets. Will favor the newest caret, or the caret with "
"a selection.\n"
"If [method is_in_mulitcaret_edit] is [code]true[/code], the merge will be "
"queued to happen at the end of the multicaret edit. See [method "
"begin_multicaret_edit] and [method end_multicaret_edit].\n"
"[b]Note:[/b] This is not called when a caret changes position but after "
"certain actions, so it is possible to get into a state where carets overlap."
msgstr ""
"បញ្ចូល carets ដែលត្រួតគ្នា (overlapping)។ នឹងផ្តល់អាទិភាពដល់ caret ដែលថ្មីបំផុត ឬ caret "
"ដែលមាន selection។\n"
"ប្រសិនបើ [method is_in_mulitcaret_edit] គឺ [code]true[/code] "
"ការបញ្ចូលគ្នានឹងត្រូវបានរៀបចំឱ្យកើតឡើងនៅចុងបញ្ចប់នៃ multicaret edit។ សូមមើល [method "
"begin_multicaret_edit] និង [method end_multicaret_edit]។\n"
"[b]ចំណាំ៖[/b] វាមិនត្រូវបានហៅនៅពេលដែល caret ផ្លាស់ប្តូរទីតាំងទេ "
"ប៉ុន្តែបន្ទាប់ពីសកម្មភាពជាក់លាក់មួយចំនួន ដូច្នេះវាអាចទៅរួចដែល carets ត្រួតគ្នា។"

msgid ""
"Returns [code]true[/code] if the given [param caret_index] should be ignored "
"as part of a multicaret edit. See [method begin_multicaret_edit] and [method "
"end_multicaret_edit]. Carets that should be ignored are ones that were part "
"of removed text and will likely be merged at the end of the edit, or carets "
"that were added during the edit.\n"
"It is recommended to [code]continue[/code] within a loop iterating on "
"multiple carets if a caret should be ignored."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ [param caret_index] ដែលបានផ្តល់ឱ្យគួរតែត្រូវបានមិនអើពើ "
"ជាផ្នែកមួយនៃ multicaret edit។ សូមមើល [method begin_multicaret_edit] និង [method "
"end_multicaret_edit]។ Carets ដែលគួរត្រូវបានមិនអើពើ គឺជា carets "
"ដែលជាផ្នែកមួយនៃអត្ថបទដែលបានលុប ហើយទំនងជានឹងត្រូវបានបញ្ចូលគ្នានៅចុងបញ្ចប់នៃការកែសម្រួល ឬ "
"carets ដែលត្រូវបានបន្ថែមក្នុងអំឡុងពេលកែសម្រួល។\n"
"វាត្រូវបានណែនាំឱ្យប្រើ [code]continue[/code] នៅក្នុង loop ដែលកំពុងធ្វើ iteration លើ "
"carets ជាច្រើន ប្រសិនបើ caret គួរតែត្រូវបានមិនអើពើ។"

msgid "Paste at the current location. Can be overridden with [method _paste]."
msgstr "បិទភ្ជាប់ (paste) នៅទីតាំងបច្ចុប្បន្ន។ អាចត្រូវបានកែប្រែដោយប្រើ [method _paste]។"

msgid "Pastes the primary clipboard."
msgstr "បិទភ្ជាប់ primary clipboard។"

msgid "Perform redo operation."
msgstr "អនុវត្តប្រតិបត្តិការ redo។"

msgid ""
"Removes the given caret index.\n"
"[b]Note:[/b] This can result in adjustment of all other caret indices."
msgstr ""
"ដក caret index ដែលបានផ្តល់ឱ្យចេញ។\n"
"[b]ចំណាំ៖[/b] នេះអាចបណ្តាលឱ្យមានការកែតម្រូវនៃ caret indices ផ្សេងទៀតទាំងអស់។"

msgid "Removes the gutter at the given index."
msgstr "ដក gutter នៅ index ដែលបានផ្តល់ឱ្យចេញ។"

msgid ""
"Removes the line of text at [param line]. Carets on this line will attempt to "
"match their previous visual x position.\n"
"If [param move_carets_down] is [code]true[/code] carets will move to the next "
"line down, otherwise carets will move up."
msgstr ""
"លុបបន្ទាត់អត្ថបទនៅត្រង់ [param line]។ Carets នៅលើបន្ទាត់នេះនឹងព្យាយាមផ្គូផ្គងទីតាំង x "
"ដែលមើលឃើញពីមុនរបស់ពួកវា។\n"
"ប្រសិនបើ [param move_carets_down] គឺ [code]true[/code] carets "
"នឹងរំកិលទៅបន្ទាត់បន្ទាប់ចុះក្រោម បើមិនដូច្នោះទេ carets នឹងរំកិលឡើងលើ។"

msgid "Removes all additional carets."
msgstr "ដក carets បន្ថែមទាំងអស់ចេញ។"

msgid "Removes text between the given positions."
msgstr "លុបអត្ថបទរវាងទីតាំងដែលបានផ្តល់ឱ្យ។"

msgid ""
"Perform a search inside the text. Search flags can be specified in the [enum "
"SearchFlags] enum.\n"
"In the returned vector, [code]x[/code] is the column, [code]y[/code] is the "
"line. If no results are found, both are equal to [code]-1[/code].\n"
"[codeblocks]\n"
"[gdscript]\n"
"var result = search(\"print\", SEARCH_WHOLE_WORDS, 0, 0)\n"
"if result.x != -1:\n"
"\t# Result found.\n"
"\tvar line_number = result.y\n"
"\tvar column_number = result.x\n"
"[/gdscript]\n"
"[csharp]\n"
"Vector2I result = Search(\"print\", (uint)TextEdit.SearchFlags.WholeWords, 0, "
"0);\n"
"if (result.X != -1)\n"
"{\n"
"\t// Result found.\n"
"\tint lineNumber = result.Y;\n"
"\tint columnNumber = result.X;\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"ធ្វើការស្វែងរកនៅក្នុងអត្ថបទ។ ទង់ស្វែងរក (Search flags) អាចត្រូវបានបញ្ជាក់នៅក្នុង [enum "
"SearchFlags] enum។\n"
"នៅក្នុង vector ដែលបានត្រឡប់មកវិញ [code]x[/code] គឺជាជួរឈរ [code]y[/code] គឺជាជួរផ្តេក "
"(line)។ ប្រសិនបើរកមិនឃើញលទ្ធផល តម្លៃទាំងពីរនឹងស្មើនឹង [code]-1[/code]។\n"
"[codeblocks]\n"
"[gdscript]\n"
"var result = search(\"print\", SEARCH_WHOLE_WORDS, 0, 0)\n"
"if result.x != -1:\n"
"\t# Result found.\n"
"\tvar line_number = result.y\n"
"\tvar column_number = result.x\n"
"[/gdscript]\n"
"[csharp]\n"
"Vector2I result = Search(\"print\", (uint)TextEdit.SearchFlags.WholeWords, 0, "
"0);\n"
"if (result.X != -1)\n"
"{\n"
"\t// Result found.\n"
"\tint lineNumber = result.Y;\n"
"\tint columnNumber = result.X;\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Selects text from [param origin_line] and [param origin_column] to [param "
"caret_line] and [param caret_column] for the given [param caret_index]. This "
"moves the selection origin and the caret. If the positions are the same, the "
"selection will be deselected.\n"
"If [member selecting_enabled] is [code]false[/code], no selection will "
"occur.\n"
"[b]Note:[/b] If supporting multiple carets this will not check for any "
"overlap. See [method merge_overlapping_carets]."
msgstr ""
"ជ្រើសរើសអត្ថបទពី [param origin_line] និង [param origin_column] ទៅកាន់ [param "
"caret_line] និង [param caret_column] សម្រាប់ [param caret_index] ដែលបានផ្តល់ឱ្យ។ "
"សកម្មភាពនេះផ្លាស់ទីប្រភពដើមនៃការជ្រើសរើស និង caret។ ប្រសិនបើទីតាំងដូចគ្នា "
"ការជ្រើសរើសនឹងត្រូវបានលុបចោល។\n"
"ប្រសិនបើ [member selecting_enabled] គឺ [code]false[/code] "
"នោះគ្មានការជ្រើសរើសណាមួយនឹងកើតឡើងទេ។\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើគាំទ្រ caret ច្រើន វានឹងមិនពិនិត្យមើលការត្រួតគ្នាទេ។ សូមមើល [method "
"merge_overlapping_carets]។"

msgid ""
"Select all the text.\n"
"If [member selecting_enabled] is [code]false[/code], no selection will occur."
msgstr ""
"ជ្រើសរើសអត្ថបទទាំងអស់។\n"
"ប្រសិនបើ [member selecting_enabled] គឺ [code]false[/code] "
"នោះគ្មានការជ្រើសរើសណាមួយនឹងកើតឡើងទេ។"

msgid "Selects the word under the caret."
msgstr "ជ្រើសរើសពាក្យនៅក្រោម caret។"

msgid ""
"Moves the caret to the specified [param column] index.\n"
"If [param adjust_viewport] is [code]true[/code], the viewport will center at "
"the caret position after the move occurs.\n"
"[b]Note:[/b] If supporting multiple carets this will not check for any "
"overlap. See [method merge_overlapping_carets]."
msgstr ""
"ផ្លាស់ទី caret ទៅកាន់លិបិក្រម [param column] ដែលបានបញ្ជាក់។\n"
"ប្រសិនបើ [param adjust_viewport] គឺ [code]true[/code] viewport នឹងតម្រឹមកណ្តាលនៅទីតាំង "
"caret បន្ទាប់ពីការផ្លាស់ទី។\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើគាំទ្រ caret ច្រើន វានឹងមិនពិនិត្យមើលការត្រួតគ្នាទេ។ សូមមើល [method "
"merge_overlapping_carets]។"

msgid ""
"Moves the caret to the specified [param line] index. The caret column will be "
"moved to the same visual position it was at the last time [method "
"set_caret_column] was called, or clamped to the end of the line.\n"
"If [param adjust_viewport] is [code]true[/code], the viewport will center at "
"the caret position after the move occurs.\n"
"If [param can_be_hidden] is [code]true[/code], the specified [param line] can "
"be hidden.\n"
"If [param wrap_index] is [code]-1[/code], the caret column will be clamped to "
"the [param line]'s length. If [param wrap_index] is greater than [code]-1[/"
"code], the column will be moved to attempt to match the visual x position on "
"the line's [param wrap_index] to the position from the last time [method "
"set_caret_column] was called.\n"
"[b]Note:[/b] If supporting multiple carets this will not check for any "
"overlap. See [method merge_overlapping_carets]."
msgstr ""
"ផ្លាស់ទី caret ទៅកាន់លិបិក្រម [param line] ដែលបានបញ្ជាក់។ ជួរឈររបស់ caret "
"នឹងត្រូវបានផ្លាស់ទីទៅកាន់ទីតាំងដែលមើលឃើញដូចគ្នានឹងពេលដែល [method set_caret_column] "
"ត្រូវបានហៅចុងក្រោយ ឬកំណត់ព្រំដែន (clamped) ទៅចុងបញ្ចប់នៃជួរ។\n"
"ប្រសិនបើ [param adjust_viewport] គឺ [code]true[/code] viewport នឹងតម្រឹមកណ្តាលនៅទីតាំង "
"caret បន្ទាប់ពីការផ្លាស់ទី។\n"
"ប្រសិនបើ [param can_be_hidden] គឺ [code]true[/code] [param line] "
"ដែលបានបញ្ជាក់អាចត្រូវបានលាក់។\n"
"ប្រសិនបើ [param wrap_index] គឺ [code]-1[/code] ជួរឈររបស់ caret "
"នឹងត្រូវបានកំណត់ព្រំដែនទៅតាមប្រវែងរបស់ [param line]។ ប្រសិនបើ [param wrap_index] ធំជាង "
"[code]-1[/code] ជួរឈរនឹងត្រូវបានផ្លាស់ទីដើម្បីព្យាយាមផ្គូផ្គងទីតាំង x ដែលមើលឃើញនៅលើ [param "
"wrap_index] របស់ជួរ ទៅនឹងទីតាំងពីលើកចុងក្រោយដែល [method set_caret_column] ត្រូវបានហៅ។\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើគាំទ្រ caret ច្រើន វានឹងមិនពិនិត្យមើលការត្រួតគ្នាទេ។ សូមមើល [method "
"merge_overlapping_carets]។"

msgid ""
"If [code]true[/code], the mouse cursor will change to a pointing hand "
"([constant Control.CURSOR_POINTING_HAND]) when hovering over the gutter at "
"the given index. See [method is_gutter_clickable] and [method "
"set_line_gutter_clickable]."
msgstr ""
"ប្រសិនបើ [code]true[/code] ទស្សន៍ទ្រនិចកណ្តុរនឹងប្តូរទៅជាដៃចង្អុល ([constant "
"Control.CURSOR_POINTING_HAND]) នៅពេលអូសពីលើ gutter នៅលិបិក្រមដែលបានផ្តល់ឱ្យ។ សូមមើល "
"[method is_gutter_clickable] និង [method set_line_gutter_clickable]។"

msgid ""
"Set a custom draw callback for the gutter at the given index. [param "
"draw_callback] must take the following arguments: A line index [int], a "
"gutter index [int], and an area [Rect2]. This callback only works when the "
"gutter type is [constant GUTTER_TYPE_CUSTOM] (see [method set_gutter_type])."
msgstr ""
"កំណត់ draw callback ផ្ទាល់ខ្លួនសម្រាប់ gutter នៅលិបិក្រមដែលបានផ្តល់ឱ្យ។ [param "
"draw_callback] ត្រូវតែយកអាគុយម៉ង់ដូចខាងក្រោម៖ លិបិក្រមជួរ [int], លិបិក្រម gutter [int], "
"និងផ្ទៃ [Rect2]។ Callback នេះដំណើរការតែនៅពេលដែលប្រភេទ gutter គឺ [constant "
"GUTTER_TYPE_CUSTOM] (សូមមើល [method set_gutter_type])។"

msgid ""
"If [code]true[/code], the gutter at the given index is drawn. The gutter type "
"([method set_gutter_type]) determines how it is drawn. See [method "
"is_gutter_drawn]."
msgstr ""
"ប្រសិនបើ [code]true[/code] gutter នៅលិបិក្រមដែលបានផ្តល់ឱ្យត្រូវបានគូរ។ ប្រភេទ gutter "
"([method set_gutter_type]) កំណត់ពីរបៀបដែលវាត្រូវបានគូរ។ សូមមើល [method "
"is_gutter_drawn]។"

msgid "Sets the name of the gutter at the given index."
msgstr "កំណត់ឈ្មោះរបស់ gutter នៅលិបិក្រមដែលបានផ្តល់ឱ្យ។"

msgid ""
"If [code]true[/code], the line data of the gutter at the given index can be "
"overridden when using [method merge_gutters]. See [method "
"is_gutter_overwritable]."
msgstr ""
"ប្រសិនបើ [code]true[/code] ទិន្នន័យជួរនៃ gutter នៅលិបិក្រមដែលបានផ្តល់ឱ្យអាចត្រូវបានសរសេរជាន់ "
"(overridden) នៅពេលប្រើ [method merge_gutters]។ សូមមើល [method "
"is_gutter_overwritable]។"

msgid ""
"Sets the type of gutter at the given index. Gutters can contain icons, text, "
"or custom visuals."
msgstr ""
"កំណត់ប្រភេទនៃ gutter នៅលិបិក្រមដែលបានផ្តល់ឱ្យ។ Gutters អាចមានរូបតំណាង អត្ថបទ "
"ឬរូបភាពផ្ទាល់ខ្លួន។"

msgid "Set the width of the gutter at the given index."
msgstr "កំណត់ទទឹងរបស់ gutter នៅលិបិក្រមដែលបានផ្តល់ឱ្យ។"

msgid ""
"Sets the text for a specific [param line].\n"
"Carets on the line will attempt to keep their visual x position."
msgstr ""
"កំណត់អត្ថបទសម្រាប់ [param line] ជាក់លាក់មួយ។\n"
"Carets នៅលើជួរនឹងព្យាយាមរក្សាទីតាំង x ដែលមើលឃើញរបស់ពួកវា។"

msgid ""
"Positions the [param wrap_index] of [param line] at the center of the "
"viewport."
msgstr "ដាក់ទីតាំង [param wrap_index] នៃ [param line] នៅកណ្តាលនៃ viewport។"

msgid ""
"Positions the [param wrap_index] of [param line] at the top of the viewport."
msgstr "ដាក់ទីតាំង [param wrap_index] នៃ [param line] នៅផ្នែកខាងលើនៃ viewport។"

msgid ""
"Positions the [param wrap_index] of [param line] at the bottom of the "
"viewport."
msgstr "ដាក់ទីតាំង [param wrap_index] នៃ [param line] នៅផ្នែកខាងក្រោមនៃ viewport។"

msgid ""
"Sets the custom background color of the given line. If transparent, this "
"color is applied on top of the default background color (See [theme_item "
"background_color]). If set to [code]Color(0, 0, 0, 0)[/code], no additional "
"color is applied."
msgstr ""
"កំណត់ពណ៌ផ្ទៃខាងក្រោយផ្ទាល់ខ្លួនសម្រាប់ជួរដែលបានផ្តល់ឱ្យ។ ប្រសិនបើថ្លា (transparent) "
"ពណ៌នេះនឹងត្រូវបានអនុវត្តពីលើពណ៌ផ្ទៃខាងក្រោយលំនាំដើម (សូមមើល [theme_item "
"background_color])។ ប្រសិនបើកំណត់ទៅជា [code]Color(0, 0, 0, 0)[/code] "
"នោះគ្មានពណ៌បន្ថែមណាមួយត្រូវបានអនុវត្តទេ។"

msgid ""
"If [param clickable] is [code]true[/code], makes the [param gutter] on the "
"given [param line] clickable. This is like [method set_gutter_clickable], but "
"for a single line. If [method is_gutter_clickable] is [code]true[/code], this "
"will not have any effect. See [method is_line_gutter_clickable] and [signal "
"gutter_clicked]."
msgstr ""
"ប្រសិនបើ [param clickable] គឺ [code]true[/code] ធ្វើឱ្យ [param gutter] នៅលើ [param "
"line] ដែលបានផ្តល់ឱ្យអាចចុចបាន។ នេះដូចគ្នានឹង [method set_gutter_clickable] ដែរ "
"ប៉ុន្តែសម្រាប់តែជួរមួយប៉ុណ្ណោះ។ ប្រសិនបើ [method is_gutter_clickable] គឺ [code]true[/code] "
"នេះនឹងគ្មានផលប៉ះពាល់អ្វីទេ។ សូមមើល [method is_line_gutter_clickable] និង [signal "
"gutter_clicked]។"

msgid ""
"Sets the icon for [param gutter] on [param line] to [param icon]. This only "
"works when the gutter type is [constant GUTTER_TYPE_ICON] (see [method "
"set_gutter_type])."
msgstr ""
"កំណត់រូបតំណាងសម្រាប់ [param gutter] នៅលើ [param line] ទៅជា [param icon]។ "
"នេះដំណើរការតែនៅពេលដែលប្រភេទ gutter គឺ [constant GUTTER_TYPE_ICON] (សូមមើល [method "
"set_gutter_type])។"

msgid "Sets the color for [param gutter] on [param line] to [param color]."
msgstr "កំណត់ពណ៌សម្រាប់ [param gutter] នៅលើ [param line] ទៅជា [param color]។"

msgid ""
"Sets the metadata for [param gutter] on [param line] to [param metadata]."
msgstr ""
"កំណត់ metadata សម្រាប់ [param gutter] នៅលើ [param line] ទៅជា [param metadata]។"

msgid ""
"Sets the text for [param gutter] on [param line] to [param text]. This only "
"works when the gutter type is [constant GUTTER_TYPE_STRING] (see [method "
"set_gutter_type])."
msgstr ""
"កំណត់អត្ថបទសម្រាប់ [param gutter] នៅលើ [param line] ទៅជា [param text]។ "
"នេះដំណើរការតែនៅពេលដែលប្រភេទ gutter គឺ [constant GUTTER_TYPE_STRING] (សូមមើល "
"[method set_gutter_type])។"

msgid ""
"If [code]true[/code], enables overtype mode. In this mode, typing overrides "
"existing text instead of inserting text. The [member ProjectSettings.input/"
"ui_text_toggle_insert_mode] action toggles overtype mode. See [method "
"is_overtype_mode_enabled]."
msgstr ""
"ប្រសិនបើ [code]true[/code] បើកដំណើរការរបៀប overtype (សរសេរជាន់លើ)។ នៅក្នុងរបៀបនេះ "
"ការវាយអក្សរនឹងសរសេរជាន់លើអត្ថបទដែលមានស្រាប់ ជំនួសឱ្យការបញ្ចូលអត្ថបទថ្មី។ សកម្មភាព [member "
"ProjectSettings.input/ui_text_toggle_insert_mode] ប្តូររបៀប overtype។ សូមមើល "
"[method is_overtype_mode_enabled]។"

msgid ""
"Sets the search [param flags]. This is used with [method set_search_text] to "
"highlight occurrences of the searched text. Search flags can be specified "
"from the [enum SearchFlags] enum."
msgstr ""
"កំណត់ [param flags] ស្វែងរក។ នេះត្រូវបានប្រើជាមួយ [method set_search_text] "
"ដើម្បីបន្លិចការកើតឡើងនៃអត្ថបទដែលបានស្វែងរក។ ទង់ស្វែងរកអាចត្រូវបានបញ្ជាក់ពី [enum "
"SearchFlags] enum។"

msgid "Sets the search text. See [method set_search_flags]."
msgstr "កំណត់អត្ថបទស្វែងរក។ សូមមើល [method set_search_flags]។"

msgid "Sets the current selection mode."
msgstr "កំណត់របៀបជ្រើសរើសបច្ចុប្បន្ន។"

msgid ""
"Sets the selection origin column to the [param column] for the given [param "
"caret_index]. If the selection origin is moved to the caret position, the "
"selection will deselect."
msgstr ""
"កំណត់ជួរឈរដើមនៃការជ្រើសរើសទៅជា [param column] សម្រាប់ [param caret_index] "
"ដែលបានផ្តល់ឱ្យ។ ប្រសិនបើប្រភពដើមនៃការជ្រើសរើសត្រូវបានផ្លាស់ទីទៅកាន់ទីតាំង caret "
"នោះការជ្រើសរើសនឹងត្រូវបានលុបចោល។"

msgid ""
"Sets the selection origin line to the [param line] for the given [param "
"caret_index]. If the selection origin is moved to the caret position, the "
"selection will deselect.\n"
"If [param can_be_hidden] is [code]false[/code], The line will be set to the "
"nearest unhidden line below or above.\n"
"If [param wrap_index] is [code]-1[/code], the selection origin column will be "
"clamped to the [param line]'s length. If [param wrap_index] is greater than "
"[code]-1[/code], the column will be moved to attempt to match the visual x "
"position on the line's [param wrap_index] to the position from the last time "
"[method set_selection_origin_column] or [method select] was called."
msgstr ""
"កំណត់ជួរដើមនៃការជ្រើសរើសទៅជា [param line] សម្រាប់ [param caret_index] ដែលបានផ្តល់ឱ្យ។ "
"ប្រសិនបើប្រភពដើមនៃការជ្រើសរើសត្រូវបានផ្លាស់ទីទៅកាន់ទីតាំង caret "
"នោះការជ្រើសរើសនឹងត្រូវបានលុបចោល។\n"
"ប្រសិនបើ [param can_be_hidden] គឺ [code]false[/code] "
"ជួរនឹងត្រូវបានកំណត់ទៅជាជួរដែលមិនបានលាក់ដែលនៅជិតបំផុតនៅខាងក្រោម ឬខាងលើ។\n"
"ប្រសិនបើ [param wrap_index] គឺ [code]-1[/code] "
"ជួរឈរដើមនៃការជ្រើសរើសនឹងត្រូវបានកំណត់ព្រំដែនទៅតាមប្រវែងរបស់ [param line]។ ប្រសិនបើ [param "
"wrap_index] ធំជាង [code]-1[/code] ជួរឈរនឹងត្រូវបានផ្លាស់ទីដើម្បីព្យាយាមផ្គូផ្គងទីតាំង x "
"ដែលមើលឃើញនៅលើ [param wrap_index] របស់ជួរ ទៅនឹងទីតាំងពីលើកចុងក្រោយដែល [method "
"set_selection_origin_column] ឬ [method select] ត្រូវបានហៅ។"

msgid "Sets the tab size for the [TextEdit] to use."
msgstr "កំណត់ទំហំ tab សម្រាប់ [TextEdit] ដើម្បីប្រើប្រាស់។"

msgid ""
"Provide custom tooltip text. The callback method must take the following "
"args: [code]hovered_word: String[/code]."
msgstr ""
"ផ្តល់អត្ថបទ tooltip ផ្ទាល់ខ្លួន។ វិធីសាស្រ្ត callback ត្រូវតែយកអាគុយម៉ង់ដូចខាងក្រោម៖ "
"[code]hovered_word: String[/code]។"

msgid ""
"Moves a selection and a caret for the next occurrence of the current "
"selection. If there is no active selection, moves to the next occurrence of "
"the word under caret."
msgstr ""
"ផ្លាស់ទីការជ្រើសរើស និង caret សម្រាប់ការកើតឡើងបន្ទាប់នៃការជ្រើសរើសបច្ចុប្បន្ន។ "
"ប្រសិនបើគ្មានការជ្រើសរើសសកម្មទេ វានឹងផ្លាស់ទីទៅកាន់ការកើតឡើងបន្ទាប់នៃពាក្យនៅក្រោម caret។"

msgid ""
"Starts an action, will end the current action if [param action] is "
"different.\n"
"An action will also end after a call to [method end_action], after [member "
"ProjectSettings.gui/timers/text_edit_idle_detect_sec] is triggered or a new "
"undoable step outside the [method start_action] and [method end_action] calls."
msgstr ""
"ចាប់ផ្តើមសកម្មភាព ហើយនឹងបញ្ចប់សកម្មភាពបច្ចុប្បន្ន ប្រសិនបើ [param action] ខុសគ្នា។\n"
"សកម្មភាពក៏នឹងបញ្ចប់ផងដែរ បន្ទាប់ពីការហៅទៅកាន់ [method end_action], បន្ទាប់ពី [member "
"ProjectSettings.gui/timers/text_edit_idle_detect_sec] ត្រូវបានកេះ ឬជំហានដែលអាច "
"undo ថ្មីនៅក្រៅការហៅ [method start_action] និង [method end_action]។"

msgid "Swaps the two lines. Carets will be swapped with the lines."
msgstr "ប្តូរជួរទាំងពីរ។ Carets នឹងត្រូវបានប្តូរទៅតាមជួរ។"

msgid "Tag the current version as saved."
msgstr "ដាក់ស្លាកកំណែបច្ចុប្បន្នថាបានរក្សាទុក។"

msgid "Perform undo operation."
msgstr "ធ្វើប្រតិបត្តិការ undo (មិនធ្វើវិញ)។"

msgid ""
"If [member wrap_mode] is set to [constant LINE_WRAPPING_BOUNDARY], sets text "
"wrapping mode."
msgstr ""
"ប្រសិនបើ [member wrap_mode] ត្រូវបានកំណត់ទៅជា [constant LINE_WRAPPING_BOUNDARY] "
"នោះវាកំណត់របៀបរុំអត្ថបទ (text wrapping mode)។"

msgid ""
"If [code]true[/code], caret will be visible when [member editable] is "
"disabled."
msgstr ""
"ប្រសិនបើ [code]true[/code] caret នឹងមើលឃើញនៅពេលដែល [member editable] ត្រូវបានបិទ។"

msgid ""
"If [code]true[/code], a right-click moves the caret at the mouse position "
"before displaying the context menu.\n"
"If [code]false[/code], the context menu ignores mouse location."
msgstr ""
"ប្រសិនបើ [code]true[/code] ការចុចកណ្តុរខាងស្តាំនឹងផ្លាស់ទី caret ទៅកាន់ទីតាំងកណ្តុរ "
"មុនពេលបង្ហាញម៉ឺនុយបរិបទ (context menu)។\n"
"ប្រសិនបើ [code]false[/code] ម៉ឺនុយបរិបទនឹងមិនអើពើនឹងទីតាំងកណ្តុរទេ។"

msgid ""
"If [code]true[/code], multiple carets are allowed. Left-clicking with "
"[kbd]Alt[/kbd] adds a new caret. See [method add_caret] and [method "
"get_caret_count]."
msgstr ""
"ប្រសិនបើ [code]true[/code] អនុញ្ញាតឱ្យមាន caret ច្រើន។ ការចុចកណ្តុរឆ្វេងជាមួយ [kbd]Alt[/"
"kbd] បន្ថែម caret ថ្មី។ សូមមើល [method add_caret] និង [method get_caret_count]។"

msgid "Set the type of caret to draw."
msgstr "កំណត់ប្រភេទ caret ដើម្បីគូរ។"

msgid ""
"The characters to consider as word delimiters if [member "
"use_custom_word_separators] is [code]true[/code]. The characters should be "
"defined without separation, for example [code]#_![/code]."
msgstr ""
"តួអក្សរដែលត្រូវចាត់ទុកថាជាព្រំដែនពាក្យ (word delimiters) ប្រសិនបើ [member "
"use_custom_word_separators] គឺ [code]true[/code]។ "
"តួអក្សរគួរតែត្រូវបានកំណត់ដោយគ្មានការបំបែក ឧទាហរណ៍ [code]#_![/code]។"

msgid ""
"If [code]true[/code], allow drag and drop of selected text. Text can still be "
"dropped from other sources."
msgstr ""
"ប្រសិនបើ [code]true[/code] អនុញ្ញាតឱ្យអូស និងទម្លាក់ (drag and drop) "
"អត្ថបទដែលបានជ្រើសរើស។ អត្ថបទនៅតែអាចត្រូវបានទម្លាក់ពីប្រភពផ្សេងទៀត។"

msgid ""
"If [code]true[/code], the \"space\" character will have a visible "
"representation."
msgstr "ប្រសិនបើ [code]true[/code] តួអក្សរ \"space\" នឹងមានការបង្ហាញដែលមើលឃើញ។"

msgid ""
"If [code]true[/code], the \"tab\" character will have a visible "
"representation."
msgstr "ប្រសិនបើ [code]true[/code] តួអក្សរ \"tab\" នឹងមានការបង្ហាញដែលមើលឃើញ។"

msgid ""
"If [code]true[/code], all occurrences of the selected text will be "
"highlighted."
msgstr "ប្រសិនបើ [code]true[/code] រាល់ការកើតឡើងនៃអត្ថបទដែលបានជ្រើសរើសនឹងត្រូវបានបន្លិច។"

msgid "If [code]true[/code], the line containing the cursor is highlighted."
msgstr "ប្រសិនបើ [code]true[/code] ជួរដែលមាន cursor ត្រូវបានបន្លិច។"

msgid ""
"If [code]true[/code], a minimap is shown, providing an outline of your source "
"code. The minimap uses a fixed-width text size."
msgstr ""
"ប្រសិនបើ [code]true[/code] minimap ត្រូវបានបង្ហាញ ដោយផ្តល់នូវគ្រោងនៃកូដប្រភព (source "
"code) របស់អ្នក។ Minimap ប្រើទំហំអត្ថបទទទឹងថេរ។"

msgid "The width, in pixels, of the minimap."
msgstr "ទទឹងគិតជាភីកសែលនៃ minimap។"

msgid ""
"Text shown when the [TextEdit] is empty. It is [b]not[/b] the [TextEdit]'s "
"default value (see [member text])."
msgstr ""
"អត្ថបទដែលបង្ហាញនៅពេលដែល [TextEdit] ទទេ។ វា [b]មិនមែន[/b] ជាតម្លៃលំនាំដើមរបស់ "
"[TextEdit] ទេ (សូមមើល [member text])។"

msgid ""
"If [code]true[/code], [TextEdit] fits its minimum height to the number of "
"visible lines instead of scrolling vertically. If a maximum height is set "
"(for example via [member Control.custom_maximum_size]) and content exceeds "
"it, a vertical scrollbar is shown."
msgstr ""
"ប្រសិនបើ [code]true[/code] [TextEdit] កំណត់កម្ពស់អប្បបរមារបស់វាឱ្យសមនឹងចំនួនជួរដែលមើលឃើញ "
"ជំនួសឱ្យការរមូរទៅលើ ឬចុះក្រោម។ ប្រសិនបើកម្ពស់អតិបរមាត្រូវបានកំណត់ (ឧទាហរណ៍តាមរយៈ [member "
"Control.custom_maximum_size]) ហើយខ្លឹមសារលើសពីនោះ របាររមូរបញ្ឈរនឹងត្រូវបានបង្ហាញ។"

msgid ""
"If [code]true[/code], [TextEdit] fits its minimum width to the widest line "
"instead of scrolling horizontally. If a maximum width is set (for example via "
"[member Control.custom_maximum_size]) and content exceeds it, a horizontal "
"scrollbar is shown."
msgstr ""
"ប្រសិនបើ [code]true[/code] [TextEdit] កំណត់ទទឹងអប្បបរមារបស់វាឱ្យសមនឹងជួរដែលទូលាយបំផុត "
"ជំនួសឱ្យការរមូរទៅឆ្វេង ឬស្តាំ។ ប្រសិនបើទទឹងអតិបរមាត្រូវបានកំណត់ (ឧទាហរណ៍តាមរយៈ [member "
"Control.custom_maximum_size]) ហើយខ្លឹមសារលើសពីនោះ របាររមូរផ្តេកនឹងត្រូវបានបង្ហាញ។"

msgid ""
"If there is a horizontal scrollbar, this determines the current horizontal "
"scroll value in pixels."
msgstr "ប្រសិនបើមានរបាររមូរផ្តេក នេះកំណត់តម្លៃរមូរផ្តេកបច្ចុប្បន្នគិតជាភីកសែល។"

msgid "Allow scrolling past the last line into \"virtual\" space."
msgstr "អនុញ្ញាតឱ្យរមូរហួសជួរចុងក្រោយទៅក្នុងលំហ \"virtual\"។"

msgid "Scroll smoothly over the text rather than jumping to the next location."
msgstr "រមូរដោយរលូនលើអត្ថបទ ជាជាងលោតទៅកាន់ទីតាំងបន្ទាប់។"

msgid ""
"Sets the scroll speed with the minimap or when [member scroll_smooth] is "
"enabled."
msgstr "កំណត់ល្បឿនរមូរជាមួយ minimap ឬនៅពេលដែល [member scroll_smooth] ត្រូវបានបើក។"

msgid ""
"If there is a vertical scrollbar, this determines the current vertical scroll "
"value in line numbers, starting at 0 for the top line."
msgstr ""
"ប្រសិនបើមានរបាររមូរបញ្ឈរ នេះកំណត់តម្លៃរមូរបញ្ឈរបច្ចុប្បន្នគិតជាលេខជួរ ដោយចាប់ផ្តើមពី 0 "
"សម្រាប់ជួរកំពូល។"

msgid ""
"If [code]true[/code], text can be selected.\n"
"If [code]false[/code], text can not be selected by the user or by the [method "
"select] or [method select_all] methods."
msgstr ""
"ប្រសិនបើ [code]true[/code] អត្ថបទអាចត្រូវបានជ្រើសរើស។\n"
"ប្រសិនបើ [code]false[/code] អត្ថបទមិនអាចត្រូវបានជ្រើសរើសដោយអ្នកប្រើប្រាស់ ឬដោយវិធីសាស្រ្ត "
"[method select] ឬ [method select_all] ទេ។"

msgid ""
"The syntax highlighter to use.\n"
"[b]Note:[/b] A [SyntaxHighlighter] instance should not be used across "
"multiple [TextEdit] nodes."
msgstr ""
"syntax highlighter ដែលត្រូវប្រើ។\n"
"[b]ចំណាំ៖[/b] instance [SyntaxHighlighter] មិនគួរត្រូវបានប្រើឆ្លងកាត់ node [TextEdit] "
"ច្រើនទេ។"

msgid ""
"If [code]true[/code], [member ProjectSettings.input/ui_text_indent] input "
"[code]Tab[/code] character, otherwise it moves keyboard focus to the next "
"[Control] in the scene."
msgstr ""
"ប្រសិនបើ [code]true[/code] [member ProjectSettings.input/ui_text_indent] "
"នឹងបញ្ចូលតួអក្សរ [code]Tab[/code] បើមិនដូច្នេះទេ វាផ្លាស់ទី keyboard focus ទៅកាន់ "
"[Control] បន្ទាប់នៅក្នុង scene។"

msgid "String value of the [TextEdit]."
msgstr "តម្លៃ String នៃ [TextEdit]។"

msgid ""
"If [code]false[/code], using [kbd]Ctrl + Left[/kbd] or [kbd]Ctrl + Right[/"
"kbd] ([kbd]Cmd + Left[/kbd] or [kbd]Cmd + Right[/kbd] on macOS) bindings will "
"use the behavior of [member use_default_word_separators]. If [code]true[/"
"code], it will also stop the caret if a character within [member "
"custom_word_separators] is detected. Useful for subword moving. This behavior "
"also will be applied to the behavior of text selection."
msgstr ""
"ប្រសិនបើ [code]false[/code] ការប្រើប្រាស់ [kbd]Ctrl + Left[/kbd] ឬ [kbd]Ctrl + "
"Right[/kbd] ([kbd]Cmd + Left[/kbd] ឬ [kbd]Cmd + Right[/kbd] នៅលើ macOS) "
"bindings នឹងប្រើឥរិយាបថរបស់ [member use_default_word_separators]។ ប្រសិនបើ "
"[code]true[/code] វាក៏នឹងបញ្ឈប់ caret ផងដែរ ប្រសិនបើតួអក្សរនៅក្នុង [member "
"custom_word_separators] ត្រូវបានរកឃើញ។ មានប្រយោជន៍សម្រាប់ការផ្លាស់ទី subword។ "
"ឥរិយាបថនេះក៏នឹងត្រូវបានអនុវត្តចំពោះឥរិយាបថនៃការជ្រើសរើសអត្ថបទផងដែរ។"

msgid ""
"If [code]false[/code], using [kbd]Ctrl + Left[/kbd] or [kbd]Ctrl + Right[/"
"kbd] ([kbd]Cmd + Left[/kbd] or [kbd]Cmd + Right[/kbd] on macOS) bindings will "
"stop moving caret only if a space or punctuation is detected. If [code]true[/"
"code], it will also stop the caret if a character is part of [code]!\"#$"
"%&'()*+,-./:;<=>?@[\\]^`{|}~[/code], the Unicode General Punctuation table, "
"or the Unicode CJK Punctuation table. Useful for subword moving. This "
"behavior also will be applied to the behavior of text selection."
msgstr ""
"ប្រសិនបើ [code]false[/code] ការប្រើប្រាស់ [kbd]Ctrl + Left[/kbd] ឬ [kbd]Ctrl + "
"Right[/kbd] ([kbd]Cmd + Left[/kbd] ឬ [kbd]Cmd + Right[/kbd] នៅលើ macOS) "
"bindings នឹងបញ្ឈប់ការផ្លាស់ទី caret លុះត្រាតែចន្លោះ ឬសញ្ញាវាក្យ (punctuation) "
"ត្រូវបានរកឃើញ។ ប្រសិនបើ [code]true[/code] វាក៏នឹងបញ្ឈប់ caret ផងដែរ "
"ប្រសិនបើតួអក្សរជាផ្នែកមួយនៃ [code]!\"#$%&'()*+,-./:;<=>?@[\\]^`{|}~[/code], តារាង "
"Unicode General Punctuation ឬតារាង Unicode CJK Punctuation។ "
"មានប្រយោជន៍សម្រាប់ការផ្លាស់ទី subword។ "
"ឥរិយាបថនេះក៏នឹងត្រូវបានអនុវត្តចំពោះឥរិយាបថនៃការជ្រើសរើសអត្ថបទផងដែរ។"

msgid "Sets the line wrapping mode to use."
msgstr "កំណត់របៀបរុំជួរ (line wrapping mode) ដែលត្រូវប្រើ។"

msgid "Emitted when any caret changes position."
msgstr "បញ្ជូនសញ្ញា (Emitted) នៅពេលដែល caret ណាមួយផ្លាស់ប្តូរទីតាំង។"

msgid "Emitted when a gutter is added."
msgstr "បញ្ជូនសញ្ញានៅពេលដែល gutter ត្រូវបានបន្ថែម។"

msgid "Emitted when a gutter is clicked."
msgstr "បញ្ជូនសញ្ញានៅពេលដែល gutter ត្រូវបានចុច។"

msgid "Emitted when a gutter is removed."
msgstr "បញ្ជូនសញ្ញានៅពេលដែល gutter ត្រូវបានដកចេញ។"

msgid ""
"Emitted immediately when the text changes.\n"
"When text is added [param from_line] will be less than [param to_line]. On a "
"remove [param to_line] will be less than [param from_line]."
msgstr ""
"បញ្ជូនសញ្ញាភ្លាមៗនៅពេលដែលអត្ថបទផ្លាស់ប្តូរ។\n"
"នៅពេលដែលអត្ថបទត្រូវបានបន្ថែម [param from_line] នឹងតូចជាង [param to_line]។ "
"នៅពេលដកចេញ [param to_line] នឹងតូចជាង [param from_line]។"

msgid "Emitted when [method clear] is called or [member text] is set."
msgstr "បញ្ជូនសញ្ញានៅពេលដែល [method clear] ត្រូវបានហៅ ឬ [member text] ត្រូវបានកំណត់។"

msgid ""
"Pastes the clipboard text over the selected text (or at the cursor's "
"position)."
msgstr ""
"បិទភ្ជាប់ (Paste) អត្ថបទ clipboard ពីលើអត្ថបទដែលបានជ្រើសរើស (ឬនៅទីតាំងរបស់ cursor)។"

msgid "Erases the whole [TextEdit] text."
msgstr "លុបអត្ថបទ [TextEdit] ទាំងអស់។"

msgid "Selects the whole [TextEdit] text."
msgstr "ជ្រើសរើសអត្ថបទ [TextEdit] ទាំងអស់។"

msgid "Redoes the previous action."
msgstr "ធ្វើវិញ (Redo) សកម្មភាពមុន។"

msgid "No current action."
msgstr "គ្មានសកម្មភាពបច្ចុប្បន្ន។"

msgid "A typing action."
msgstr "សកម្មភាពវាយអក្សរ។"

msgid "A backwards delete action."
msgstr "សកម្មភាពលុបថយក្រោយ។"

msgid "A forward delete action."
msgstr "សកម្មភាពលុបទៅមុខ។"

msgid "Match case when searching."
msgstr "ផ្គូផ្គងអក្សរធំ/តូច (Match case) នៅពេលស្វែងរក។"

msgid "Match whole words when searching."
msgstr "ផ្គូផ្គងពាក្យពេញ នៅពេលស្វែងរក។"

msgid "Search from end to beginning."
msgstr "ស្វែងរកពីចុងទៅដើម។"

msgid "Vertical line caret."
msgstr "Caret បន្ទាត់បញ្ឈរ។"

msgid "Block caret."
msgstr "Caret ប្លុក។"

msgid "Not selecting."
msgstr "មិនកំពុងជ្រើសរើស។"

msgid "Select as if [code]shift[/code] is pressed."
msgstr "ជ្រើសរើសដូចជា [code]shift[/code] ត្រូវបានចុច។"

msgid "Select single characters as if the user single clicked."
msgstr "ជ្រើសរើសតួអក្សរទោល ដូចជាអ្នកប្រើប្រាស់ចុចម្តង។"

msgid "Select whole words as if the user double clicked."
msgstr "ជ្រើសរើសពាក្យពេញ ដូចជាអ្នកប្រើប្រាស់ចុចពីរដង (double clicked)។"

msgid "Select whole lines as if the user triple clicked."
msgstr "ជ្រើសរើសជួរពេញ ដូចជាអ្នកប្រើប្រាស់ចុចបីដង (triple clicked)។"

msgid "Line wrapping is disabled."
msgstr "ការរុំជួរ (Line wrapping) ត្រូវបានបិទ។"

msgid ""
"Line wrapping occurs at the control boundary, beyond what would normally be "
"visible."
msgstr "ការរុំជួរកើតឡើងនៅព្រំដែននៃ control ហួសពីអ្វីដែលជាធម្មតាអាចមើលឃើញ។"

msgid ""
"When a gutter is set to string using [method set_gutter_type], it is used to "
"contain text set via the [method set_line_gutter_text] method."
msgstr ""
"នៅពេលដែល gutter ត្រូវបានកំណត់ទៅជា string ដោយប្រើ [method set_gutter_type] "
"វាត្រូវបានប្រើដើម្បីផ្ទុកអត្ថបទដែលបានកំណត់តាមរយៈវិធីសាស្រ្ត [method set_line_gutter_text]។"

msgid ""
"When a gutter is set to icon using [method set_gutter_type], it is used to "
"contain an icon set via the [method set_line_gutter_icon] method."
msgstr ""
"នៅពេលដែល gutter ត្រូវបានកំណត់ទៅជា icon ដោយប្រើ [method set_gutter_type] "
"វាត្រូវបានប្រើដើម្បីផ្ទុក icon ដែលបានកំណត់តាមរយៈវិធីសាស្រ្ត [method set_line_gutter_icon]។"

msgid ""
"When a gutter is set to custom using [method set_gutter_type], it is used to "
"contain custom visuals controlled by a callback method set via the [method "
"set_gutter_custom_draw] method."
msgstr ""
"នៅពេលដែល gutter ត្រូវបានកំណត់ទៅជា custom ដោយប្រើ [method set_gutter_type] "
"វាត្រូវបានប្រើដើម្បីផ្ទុករូបភាពផ្ទាល់ខ្លួនដែលគ្រប់គ្រងដោយវិធីសាស្រ្ត callback "
"ដែលបានកំណត់តាមរយៈវិធីសាស្រ្ត [method set_gutter_custom_draw]។"

msgid ""
"Assign a [StyleBoxFlat] to [theme_item normal] instead, and set [member "
"StyleBoxFlat.bg_color] to the desired background color."
msgstr ""
"កំណត់ [StyleBoxFlat] ទៅកាន់ [theme_item normal] ជំនួសវិញ ហើយកំណត់ [member "
"StyleBoxFlat.bg_color] ទៅជាពណ៌ផ្ទៃខាងក្រោយដែលចង់បាន។"

msgid "Sets the background [Color] of this [TextEdit]."
msgstr "កំណត់ [Color] ផ្ទៃខាងក្រោមនៃ [TextEdit] នេះ។"

msgid "[Color] of the text behind the caret when using a block caret."
msgstr "[Color] នៃអត្ថបទនៅពីក្រោយ caret នៅពេលប្រើ block caret។"

msgid ""
"[Color] of the caret. This can be set to a fully transparent color to hide "
"the caret entirely."
msgstr "[Color] នៃ caret។ នេះអាចត្រូវបានកំណត់ទៅជាពណ៌ថ្លាទាំងស្រុង ដើម្បីលាក់ caret ទាំងស្រុង។"

msgid "Background [Color] of the line containing the caret."
msgstr "[Color] ផ្ទៃខាងក្រោយនៃជួរដែលមាន caret។"

msgid "Sets the font [Color]."
msgstr "កំណត់ [Color] ពុម្ពអក្សរ។"

msgid "The tint of text outline of the [TextEdit]."
msgstr "ពណ៌ជ្រលក់ (tint) នៃគ្រោងអត្ថបទ (text outline) របស់ [TextEdit]។"

msgid "Sets the font [Color] when [member editable] is disabled."
msgstr "កំណត់ [Color] ពុម្ពអក្សរ នៅពេលដែល [member editable] ត្រូវបានបិទ។"

msgid ""
"Sets the [Color] of the selected text. If equal to [code]Color(0, 0, 0, 0)[/"
"code], it will be ignored."
msgstr ""
"កំណត់ [Color] នៃអត្ថបទដែលបានជ្រើសរើស។ ប្រសិនបើស្មើនឹង [code]Color(0, 0, 0, 0)[/code] "
"វានឹងត្រូវបានមិនអើពើ។"

msgid "[Color] of the border around text that matches the search query."
msgstr "[Color] នៃស៊ុមជុំវិញអត្ថបទដែលផ្គូផ្គងនឹងសំណួរស្វែងរក។"

msgid "[Color] behind the text that matches the search query."
msgstr "[Color] នៅពីក្រោយអត្ថបទដែលផ្គូផ្គងនឹងសំណួរស្វែងរក។"

msgid "Sets the highlight [Color] of text selections."
msgstr "កំណត់ [Color] បន្លិចនៃការជ្រើសរើសអត្ថបទ។"

msgid ""
"Sets the highlight [Color] of multiple occurrences. [member "
"highlight_all_occurrences] has to be enabled."
msgstr ""
"កំណត់ [Color] បន្លិចនៃការកើតឡើងច្រើនដង។ [member highlight_all_occurrences] "
"ត្រូវតែត្រូវបានបើក។"

msgid ""
"The caret's width in pixels. Greater values can be used to improve "
"accessibility by ensuring the caret is easily visible, or to ensure "
"consistency with a large font size. If set to [code]0[/code] or lower, the "
"caret width is automatically set to 1 pixel and multiplied by the display "
"scaling factor."
msgstr ""
"ទទឹងរបស់ caret គិតជាភីកសែល។ តម្លៃធំជាងអាចត្រូវបានប្រើដើម្បីកែលម្អភាពងាយស្រួលប្រើប្រាស់ "
"(accessibility) ដោយធានាថា caret មើលឃើញយ៉ាងងាយស្រួល "
"ឬដើម្បីធានាភាពស៊ីសង្វាក់គ្នាជាមួយទំហំពុម្ពអក្សរធំ។ ប្រសិនបើកំណត់ទៅជា [code]0[/code] ឬទាបជាងនេះ "
"ទទឹង caret នឹងត្រូវបានកំណត់ដោយស្វ័យប្រវត្តិទៅជា 1 ភីកសែល ហើយគុណនឹងកត្តាមាត្រដ្ឋានបង្ហាញ "
"(display scaling factor)។"

msgid "Sets an additional margin for line wrapping width."
msgstr "កំណត់រឹមបន្ថែមសម្រាប់ទទឹងរុំជួរ (line wrapping width)។"

msgid "Sets the default [Font]."
msgstr "កំណត់ [Font] លំនាំដើម។"

msgid "Sets default font size."
msgstr "កំណត់ទំហំពុម្ពអក្សរលំនាំដើម។"

msgid "Sets a custom [Texture2D] for space text characters."
msgstr "កំណត់ [Texture2D] ផ្ទាល់ខ្លួនសម្រាប់តួអក្សរ space។"

msgid "Sets a custom [Texture2D] for tab text characters."
msgstr "កំណត់ [Texture2D] ផ្ទាល់ខ្លួនសម្រាប់តួអក្សរ tab។"

msgid ""
"Sets the [StyleBox] when in focus. The [theme_item focus] [StyleBox] is "
"displayed [i]over[/i] the base [StyleBox], so a partially transparent "
"[StyleBox] should be used to ensure the base [StyleBox] remains visible. A "
"[StyleBox] that represents an outline or an underline works well for this "
"purpose. To disable the focus visual effect, assign a [StyleBoxEmpty] "
"resource. Note that disabling the focus visual effect will harm keyboard/"
"controller navigation usability, so this is not recommended for accessibility "
"reasons."
msgstr ""
"កំណត់ [StyleBox] នៅពេលកំពុង focus។ [theme_item focus] [StyleBox] ត្រូវបានបង្ហាញ "
"[i]ពីលើ[/i] [StyleBox] គោល ដូច្នេះ [StyleBox] ដែលថ្លាមួយផ្នែកគួរតែត្រូវបានប្រើ "
"ដើម្បីធានាថា [StyleBox] គោលនៅតែមើលឃើញ។ [StyleBox] ដែលតំណាងឱ្យគ្រោង ឬបន្ទាត់ពីក្រោម "
"ដំណើរការបានល្អសម្រាប់គោលបំណងនេះ។ ដើម្បីបិទឥទ្ធិពលផ្លើលឃើញ focus សូមកំណត់ធនធាន "
"[StyleBoxEmpty]។ សូមចំណាំថាការបិទឥទ្ធិពលផ្លើលឃើញ focus "
"នឹងធ្វើឱ្យប៉ះពាល់ដល់ភាពងាយស្រួលក្នុងការរុករកតាម keyboard/controller "
"ដូច្នេះវាមិនត្រូវបានណែនាំសម្រាប់ហេតុផល accessibility ទេ។"

msgid "Sets the [StyleBox] of this [TextEdit]."
msgstr "កំណត់ [StyleBox] នៃ [TextEdit] នេះ។"

msgid ""
"Sets the [StyleBox] of this [TextEdit] when [member editable] is disabled."
msgstr "កំណត់ [StyleBox] នៃ [TextEdit] នេះ នៅពេលដែល [member editable] ត្រូវបានបិទ។"

msgid "Holds a line of text."
msgstr "ផ្ទុកជួរនៃអត្ថបទ។"

msgid "Abstraction over [TextServer] for handling a single line of text."
msgstr "abstraction លើ [TextServer] សម្រាប់ដោះស្រាយជួរអត្ថបទតែមួយ។"

msgid ""
"Adds inline object to the text buffer, [param key] must be unique. In the "
"text, object is represented as [param length] object replacement characters."
msgstr ""
"បន្ថែម inline object ទៅក្នុង text buffer, [param key] ត្រូវតែមានលក្ខណៈពិសេស "
"(unique)។ នៅក្នុងអត្ថបទ វត្ថុត្រូវបានតំណាងដោយតួអក្សរជំនួសវត្ថុចំនួន [param length]។"

msgid "Adds text span and font to draw it."
msgstr "បន្ថែម text span និងពុម្ពអក្សរដើម្បីគូរវា។"

msgid "Clears text line (removes text and inline objects)."
msgstr "សម្អាតជួរអត្ថបទ (ដកអត្ថបទ និង inline objects ចេញ)។"

msgid ""
"Draw text into a canvas item at a given position, with [param color]. [param "
"pos] specifies the top left corner of the bounding box. If [param "
"oversampling] is greater than zero, it is used as font oversampling factor, "
"otherwise viewport oversampling settings are used."
msgstr ""
"គូរអត្ថបទទៅក្នុង canvas item នៅទីតាំងដែលបានផ្តល់ឱ្យ ជាមួយ [param color]។ [param pos] "
"បញ្ជាក់ពីជ្រុងខាងឆ្វេងផ្នែកខាងលើនៃ bounding box។ ប្រសិនបើ [param oversampling] ធំជាងសូន្យ "
"វាត្រូវបានប្រើជាកត្តា oversampling របស់ពុម្ពអក្សរ បើមិនដូច្នេះទេ ការកំណត់ oversampling របស់ "
"viewport ត្រូវបានប្រើ។"

msgid "Duplicates this [TextLine]."
msgstr "ចម្លង (Duplicates) [TextLine] នេះ។"

msgid "Returns the text writing direction inferred by the BiDi algorithm."
msgstr "ត្រឡប់ទិសដៅសរសេរអត្ថបទដែលបានសន្និដ្ឋានដោយក្បួនដោះស្រាយ BiDi។"

msgid ""
"Returns the text ascent (number of pixels above the baseline for horizontal "
"layout or to the left of baseline for vertical)."
msgstr ""
"ត្រឡប់ text ascent (ចំនួនភីកសែលនៅពីលើ baseline សម្រាប់ប្លង់ផ្តេក ឬនៅខាងឆ្វេងនៃ baseline "
"សម្រាប់ប្លង់បញ្ឈរ)។"

msgid ""
"Returns the text descent (number of pixels below the baseline for horizontal "
"layout or to the right of baseline for vertical)."
msgstr ""
"ត្រឡប់ text descent (ចំនួនភីកសែលនៅខាងក្រោម baseline សម្រាប់ប្លង់ផ្តេក ឬនៅខាងស្តាំនៃ "
"baseline សម្រាប់ប្លង់បញ្ឈរ)។"

msgid "Returns thickness of the underline."
msgstr "ត្រឡប់កម្រាស់នៃបន្ទាត់ពីក្រោម (underline)។"

msgid ""
"Returns width (for horizontal layout) or height (for vertical) of the text."
msgstr "ត្រឡប់ទទឹង (សម្រាប់ប្លង់ផ្តេក) ឬកម្ពស់ (សម្រាប់ប្លង់បញ្ឈរ) នៃអត្ថបទ។"

msgid "Returns bounding rectangle of the inline object."
msgstr "ត្រឡប់ចតុកោណកែងកំណត់ព្រំដែន (bounding rectangle) នៃ inline object។"

msgid "Returns array of inline objects."
msgstr "ត្រឡប់ array នៃ inline objects។"

msgid "Returns TextServer buffer RID."
msgstr "ត្រឡប់ RID របស់ buffer TextServer។"

msgid "Returns size of the bounding box of the text."
msgstr "ត្រឡប់ទំហំនៃ bounding box របស់អត្ថបទ។"

msgid ""
"Returns [code]true[/code] if an object with [param key] is embedded in this "
"line."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើវត្ថុដែលមាន [param key] ត្រូវបានបង្កប់នៅក្នុងជួរនេះ។"

msgid ""
"Returns caret character offset at the specified pixel offset at the baseline. "
"This function always returns a valid position."
msgstr ""
"ត្រឡប់ character offset របស់ caret នៅ pixel offset ដែលបានបញ្ជាក់នៅត្រង់ baseline។ "
"អនុគមន៍នេះតែងតែត្រឡប់ទីតាំងដែលត្រឹមត្រូវ។"

msgid "Sets new size and alignment of embedded object."
msgstr "កំណត់ទំហំ និងការតម្រឹមថ្មីនៃវត្ថុដែលបានបង្កប់។"

msgid ""
"Overrides BiDi for the structured text.\n"
"Override ranges should cover full source text without overlaps. BiDi "
"algorithm will be used on each range separately."
msgstr ""
"សរសេរជាន់ (Overrides) BiDi សម្រាប់អត្ថបទដែលមានរចនាសម្ព័ន្ធ។\n"
"ចន្លោះដែលសរសេរជាន់គួរតែគ្របដណ្តប់អត្ថបទប្រភពទាំងមូលដោយគ្មានការត្រួតគ្នា។ ក្បួនដោះស្រាយ BiDi "
"នឹងត្រូវបានប្រើលើចន្លោះនីមួយៗដាច់ដោយឡែក។"

msgid "Sets text alignment within the line as if the line was horizontal."
msgstr "កំណត់ការតម្រឹមអត្ថបទនៅក្នុងជួរ ដូចជាជួរនោះជាផ្តេក។"

msgid "Text writing direction."
msgstr "ទិសដៅសរសេរអត្ថបទ។"

msgid "Line alignment rules. For more info see [TextServer]."
msgstr "ច្បាប់តម្រឹមជួរ។ សម្រាប់ព័ត៌មានបន្ថែមសូមមើល [TextServer]។"

msgid "Text orientation."
msgstr "ទិសដៅអត្ថបទ (Text orientation)។"

msgid "If set to [code]true[/code] text will display control characters."
msgstr ""
"ប្រសិនបើកំណត់ទៅជា [code]true[/code] អត្ថបទនឹងបង្ហាញតួអក្សរគ្រប់គ្រង (control characters)។"

msgid "If set to [code]true[/code] text will display invalid characters."
msgstr ""
"ប្រសិនបើកំណត់ទៅជា [code]true[/code] អត្ថបទនឹងបង្ហាញតួអក្សរមិនត្រឹមត្រូវ (invalid "
"characters)។"

msgid "The clipping behavior when the text exceeds the text line's set width."
msgstr "ឥរិយាបថកាត់ត (clipping behavior) នៅពេលដែលអត្ថបទលើសពីទទឹងដែលបានកំណត់របស់ជួរអត្ថបទ។"

msgid "Text line width."
msgstr "ទទឹងជួរអត្ថបទ។"

msgid "Generate a [PrimitiveMesh] from the text."
msgstr "បង្កើត [PrimitiveMesh] ពីអត្ថបទ។"

msgid ""
"Generate a [PrimitiveMesh] from the text.\n"
"TextMesh can be generated only when using dynamic fonts with vector glyph "
"contours. Bitmap fonts (including bitmap data in the TrueType/OpenType "
"containers, like color emoji fonts) are not supported.\n"
"The UV layout is arranged in 4 horizontal strips, top to bottom: 40% of the "
"height for the front face, 40% for the back face, 10% for the outer edges and "
"10% for the inner edges."
msgstr ""
"បង្កើត [PrimitiveMesh] ពីអត្ថបទ។\n"
"TextMesh អាចត្រូវបានបង្កើតតែនៅពេលប្រើ dynamic fonts ជាមួយ vector glyph contours "
"ប៉ុណ្ណោះ។ Bitmap fonts (រួមទាំងទិន្នន័យ bitmap នៅក្នុងធុង TrueType/OpenType ដូចជាពុម្ពអក្សរ "
"emoji ពណ៌) មិនត្រូវបានគាំទ្រទេ។\n"
"ប្លង់ UV ត្រូវបានរៀបចំជា 4 ឆ្នូតផ្តេក ពីលើចុះក្រោម៖ 40% នៃកម្ពស់សម្រាប់មុខខាងមុខ, 40% "
"សម្រាប់មុខខាងក្រោយ, 10% សម្រាប់គែមខាងក្រៅ និង 10% សម្រាប់គែមខាងក្នុង។"

msgid ""
"Step (in pixels) used to approximate Bézier curves. Lower values result in "
"smoother curves, but is slower to generate and render. Consider adjusting "
"this according to the font size and the typical viewing distance.\n"
"[b]Note:[/b] Changing this property will regenerate the mesh, which is a slow "
"operation, especially with large font sizes and long texts."
msgstr ""
"ជំហាន (គិតជាភីកសែល) ដែលប្រើដើម្បីប៉ាន់ស្មានខ្សែកោង Bézier។ តម្លៃទាបបណ្តាលឱ្យខ្សែកោងរលូនជាងមុន "
"ប៉ុន្តែយឺតក្នុងការបង្កើត និង render។ សូមពិចារណាកែសម្រួលវាទៅតាមទំហំពុម្ពអក្សរ និងចម្ងាយមើលជាទូទៅ។\n"
"[b]ចំណាំ៖[/b] ការផ្លាស់ប្តូរ property នេះនឹងបង្កើត mesh ឡើងវិញ ដែលជាប្រតិបត្តិការយឺត "
"ជាពិសេសជាមួយទំហំពុម្ពអក្សរធំ និងអត្ថបទវែង។"

msgid ""
"Depths of the mesh, if set to [code]0.0[/code] only front surface, is "
"generated, and UV layout is changed to use full texture for the front face "
"only."
msgstr ""
"ជម្រៅនៃ mesh ប្រសិនបើកំណត់ទៅជា [code]0.0[/code] មានតែផ្ទៃខាងមុខប៉ុណ្ណោះដែលត្រូវបានបង្កើត "
"ហើយប្លង់ UV ត្រូវបានផ្លាស់ប្តូរដើម្បីប្រើ texture ពេញសម្រាប់តែមុខខាងមុខប៉ុណ្ណោះ។"

msgid ""
"Font size of the [TextMesh]'s text. This property works in tandem with "
"[member pixel_size]. Higher values will result in a more detailed font, "
"regardless of [member curve_step] and [member pixel_size]. Consider keeping "
"this value below 63 (inclusive) for good performance, and adjust [member "
"pixel_size] as needed to enlarge text.\n"
"[b]Note:[/b] Changing this property will regenerate the mesh, which is a slow "
"operation, especially with large font sizes and long texts. To change the "
"text's size in real-time efficiently, change the node's [member Node3D.scale] "
"instead."
msgstr ""
"ទំហំពុម្ពអក្សរនៃអត្ថបទរបស់ [TextMesh]។ Property នេះដំណើរការជាមួយគ្នាជាមួយ [member "
"pixel_size]។ តម្លៃខ្ពស់នឹងបណ្តាលឱ្យពុម្ពអក្សរមានភាពលម្អិតជាងមុន ដោយមិនគិតពី [member "
"curve_step] និង [member pixel_size]។ សូមពិចារណារក្សាតម្លៃនេះឱ្យនៅក្រោម 63 "
"(រាប់បញ្ចូលទាំង 63) សម្រាប់ដំណើរការល្អ ហើយកែសម្រួល [member pixel_size] "
"តាមតម្រូវការដើម្បីពង្រីកអត្ថបទ។\n"
"[b]ចំណាំ៖[/b] ការផ្លាស់ប្តូរ property នេះនឹងបង្កើត mesh ឡើងវិញ ដែលជាប្រតិបត្តិការយឺត "
"ជាពិសេសជាមួយទំហំពុម្ពអក្សរធំ និងអត្ថបទវែង។ ដើម្បីផ្លាស់ប្តូរទំហំអត្ថបទក្នុងពេលជាក់ស្តែង (real-time) "
"ប្រកបដោយប្រសិទ្ធភាព សូមផ្លាស់ប្តូរ [member Node3D.scale] របស់ node ជំនួសវិញ។"

msgid ""
"The text drawing offset (in pixels).\n"
"[b]Note:[/b] Changing this property will regenerate the mesh, which is a slow "
"operation. To change the text's position in real-time efficiently, change the "
"node's [member Node3D.position] instead."
msgstr ""
"គម្លាតគូរអត្ថបទ (គិតជាភីកសែល)។\n"
"[b]ចំណាំ៖[/b] ការផ្លាស់ប្តូរ property នេះនឹងបង្កើត mesh ឡើងវិញ ដែលជាប្រតិបត្តិការយឺត។ "
"ដើម្បីផ្លាស់ប្តូរទីតាំងអត្ថបទក្នុងពេលជាក់ស្តែងប្រកបដោយប្រសិទ្ធភាព សូមផ្លាស់ប្តូរ [member "
"Node3D.position] របស់ node ជំនួសវិញ។"

msgid ""
"The size of one pixel's width on the text to scale it in 3D. This property "
"works in tandem with [member font_size].\n"
"[b]Note:[/b] Changing this property will regenerate the mesh, which is a slow "
"operation, especially with large font sizes and long texts. To change the "
"text's size in real-time efficiently, change the node's [member Node3D.scale] "
"instead."
msgstr ""
"ទំហំទទឹងនៃមួយភីកសែលនៅលើអត្ថបទ ដើម្បីធ្វើមាត្រដ្ឋានវាក្នុង 3D។ Property "
"នេះដំណើរការជាមួយគ្នាជាមួយ [member font_size]។\n"
"[b]ចំណាំ៖[/b] ការផ្លាស់ប្តូរ property នេះនឹងបង្កើត mesh ឡើងវិញ ដែលជាប្រតិបត្តិការយឺត "
"ជាពិសេសជាមួយទំហំពុម្ពអក្សរធំ និងអត្ថបទវែង។ "
"ដើម្បីផ្លាស់ប្តូរទំហំអត្ថបទក្នុងពេលជាក់ស្តែងប្រកបដោយប្រសិទ្ធភាព សូមផ្លាស់ប្តូរ [member "
"Node3D.scale] របស់ node ជំនួសវិញ។"

msgid ""
"The text to generate mesh from.\n"
"[b]Note:[/b] Due to being a [Resource], it doesn't follow the rules of "
"[member Node.auto_translate_mode]. If disabling translation is desired, it "
"should be done manually with [method Object.set_message_translation]."
msgstr ""
"អត្ថបទដើម្បីបង្កើត mesh។\n"
"[b]ចំណាំ៖[/b] ដោយសារវាជា [Resource] វាមិនអនុវត្តតាមច្បាប់របស់ [member "
"Node.auto_translate_mode] ទេ។ ប្រសិនបើចង់បិទការបកប្រែ វាគួរតែត្រូវបានធ្វើដោយដៃជាមួយ "
"[method Object.set_message_translation]។"

msgid "Text width (in pixels), used for fill alignment."
msgstr "ទទឹងអត្ថបទ (គិតជាភីកសែល) ប្រើសម្រាប់ការតម្រឹមបំពេញ (fill alignment)។"

msgid "Holds a paragraph of text."
msgstr "ផ្ទុកកថាខណ្ឌនៃអត្ថបទ។"

msgid "Abstraction over [TextServer] for handling a single paragraph of text."
msgstr "Abstraction លើ [TextServer] សម្រាប់ដោះស្រាយកថាខណ្ឌអត្ថបទតែមួយ។"

msgid "Clears text paragraph (removes text and inline objects)."
msgstr "សម្អាតកថាខណ្ឌអត្ថបទ (ដកអត្ថបទ និង inline objects ចេញ)។"

msgid "Removes dropcap."
msgstr "ដក dropcap (តួអក្សរធំដើមប្រយោគ) ចេញ។"

msgid ""
"Draw all lines of the text and drop cap into a canvas item at a given "
"position, with [param color]. [param pos] specifies the top left corner of "
"the bounding box. If [param oversampling] is greater than zero, it is used as "
"font oversampling factor, otherwise viewport oversampling settings are used."
msgstr ""
"គូរជួរទាំងអស់នៃអត្ថបទ និង drop cap ទៅក្នុង canvas item នៅទីតាំងដែលបានផ្តល់ឱ្យ ជាមួយ [param "
"color]។ [param pos] បញ្ជាក់ពីជ្រុងខាងឆ្វេងផ្នែកខាងលើនៃ bounding box។ ប្រសិនបើ [param "
"oversampling] ធំជាងសូន្យ វាត្រូវបានប្រើជាកត្តា oversampling របស់ពុម្ពអក្សរ បើមិនដូច្នេះទេ "
"ការកំណត់ oversampling របស់ viewport ត្រូវបានប្រើ។"

msgid ""
"Draw drop cap into a canvas item at a given position, with [param color]. "
"[param pos] specifies the top left corner of the bounding box. If [param "
"oversampling] is greater than zero, it is used as font oversampling factor, "
"otherwise viewport oversampling settings are used."
msgstr ""
"គូរ drop cap ទៅក្នុង canvas item នៅទីតាំងដែលបានផ្តល់ឱ្យ ជាមួយ [param color]។ [param "
"pos] បញ្ជាក់ពីជ្រុងខាងឆ្វេងផ្នែកខាងលើនៃ bounding box។ ប្រសិនបើ [param oversampling] "
"ធំជាងសូន្យ វាត្រូវបានប្រើជាកត្តា oversampling របស់ពុម្ពអក្សរ បើមិនដូច្នេះទេ ការកំណត់ "
"oversampling របស់ viewport ត្រូវបានប្រើ។"

msgid ""
"Draw drop cap outline into a canvas item at a given position, with [param "
"color]. [param pos] specifies the top left corner of the bounding box. If "
"[param oversampling] is greater than zero, it is used as font oversampling "
"factor, otherwise viewport oversampling settings are used."
msgstr ""
"គូរគ្រោង drop cap ទៅក្នុង canvas item នៅទីតាំងដែលបានផ្តល់ឱ្យ ជាមួយ [param color]។ "
"[param pos] បញ្ជាក់ពីជ្រុងខាងឆ្វេងផ្នែកខាងលើនៃ bounding box។ ប្រសិនបើ [param "
"oversampling] ធំជាងសូន្យ វាត្រូវបានប្រើជាកត្តា oversampling របស់ពុម្ពអក្សរ បើមិនដូច្នេះទេ "
"ការកំណត់ oversampling របស់ viewport ត្រូវបានប្រើ។"

msgid ""
"Draw single line of text into a canvas item at a given position, with [param "
"color]. [param pos] specifies the top left corner of the bounding box. If "
"[param oversampling] is greater than zero, it is used as font oversampling "
"factor, otherwise viewport oversampling settings are used."
msgstr ""
"គូរជួរអត្ថបទតែមួយទៅក្នុង canvas item នៅទីតាំងដែលបានផ្តល់ឱ្យ ជាមួយ [param color]។ [param "
"pos] បញ្ជាក់ពីជ្រុងខាងឆ្វេងផ្នែកខាងលើនៃ bounding box។ ប្រសិនបើ [param oversampling] "
"ធំជាងសូន្យ វាត្រូវបានប្រើជាកត្តា oversampling របស់ពុម្ពអក្សរ បើមិនដូច្នេះទេ ការកំណត់ "
"oversampling របស់ viewport ត្រូវបានប្រើ។"

msgid ""
"Draw outline of the single line of text into a canvas item at a given "
"position, with [param color]. [param pos] specifies the top left corner of "
"the bounding box. If [param oversampling] is greater than zero, it is used as "
"font oversampling factor, otherwise viewport oversampling settings are used."
msgstr ""
"គូរគ្រោងនៃជួរអត្ថបទតែមួយទៅក្នុង canvas item នៅទីតាំងដែលបានផ្តល់ឱ្យ ជាមួយ [param color]។ "
"[param pos] បញ្ជាក់ពីជ្រុងខាងឆ្វេងផ្នែកខាងលើនៃ bounding box។ ប្រសិនបើ [param "
"oversampling] ធំជាងសូន្យ វាត្រូវបានប្រើជាកត្តា oversampling របស់ពុម្ពអក្សរ បើមិនដូច្នេះទេ "
"ការកំណត់ oversampling របស់ viewport ត្រូវបានប្រើ។"

msgid ""
"Draw outlines of all lines of the text and drop cap into a canvas item at a "
"given position, with [param color]. [param pos] specifies the top left corner "
"of the bounding box. If [param oversampling] is greater than zero, it is used "
"as font oversampling factor, otherwise viewport oversampling settings are "
"used."
msgstr ""
"គូរគ្រោងនៃជួរទាំងអស់នៃអត្ថបទ និង drop cap ទៅក្នុង canvas item នៅទីតាំងដែលបានផ្តល់ឱ្យ ជាមួយ "
"[param color]។ [param pos] បញ្ជាក់ពីជ្រុងខាងឆ្វេងផ្នែកខាងលើនៃ bounding box។ ប្រសិនបើ "
"[param oversampling] ធំជាងសូន្យ វាត្រូវបានប្រើជាកត្តា oversampling របស់ពុម្ពអក្សរ "
"បើមិនដូច្នេះទេ ការកំណត់ oversampling របស់ viewport ត្រូវបានប្រើ។"

msgid "Duplicates this [TextParagraph]."
msgstr "ចម្លង [TextParagraph] នេះ។"

msgid "Returns number of lines used by dropcap."
msgstr "ត្រឡប់ចំនួនជួរដែលប្រើដោយ dropcap។"

msgid "Returns drop cap text buffer RID."
msgstr "ត្រឡប់ RID របស់ buffer អត្ថបទ drop cap។"

msgid "Returns drop cap bounding box size."
msgstr "ត្រឡប់ទំហំ bounding box របស់ drop cap។"

msgid ""
"Returns the text line ascent (number of pixels above the baseline for "
"horizontal layout or to the left of baseline for vertical)."
msgstr ""
"ត្រឡប់ text line ascent (ចំនួនភីកសែលនៅពីលើ baseline សម្រាប់ប្លង់ផ្តេក ឬនៅខាងឆ្វេងនៃ "
"baseline សម្រាប់ប្លង់បញ្ឈរ)។"

msgid "Returns number of lines in the paragraph."
msgstr "ត្រឡប់ចំនួនជួរនៅក្នុងកថាខណ្ឌ។"

msgid ""
"Returns the text line descent (number of pixels below the baseline for "
"horizontal layout or to the right of baseline for vertical)."
msgstr ""
"ត្រឡប់ text line descent (ចំនួនភីកសែលនៅខាងក្រោម baseline សម្រាប់ប្លង់ផ្តេក ឬនៅខាងស្តាំនៃ "
"baseline សម្រាប់ប្លង់បញ្ឈរ)។"

msgid "Returns array of inline objects in the line."
msgstr "ត្រឡប់ array នៃ inline objects នៅក្នុងជួរ។"

msgid "Returns character range of the line."
msgstr "ត្រឡប់ចន្លោះតួអក្សរនៃជួរ។"

msgid "Returns TextServer line buffer RID."
msgstr "ត្រឡប់ RID របស់ buffer ជួរ TextServer។"

msgid ""
"Returns size of the bounding box of the line of text. Returned size is "
"rounded up."
msgstr "ត្រឡប់ទំហំនៃ bounding box របស់ជួរអត្ថបទ។ ទំហំដែលបានត្រឡប់ត្រូវបានបង្គត់ឡើង។"

msgid ""
"Returns width (for horizontal layout) or height (for vertical) of the line of "
"text."
msgstr "ត្រឡប់ទទឹង (សម្រាប់ប្លង់ផ្តេក) ឬកម្ពស់ (សម្រាប់ប្លង់បញ្ឈរ) នៃជួរអត្ថបទ។"

msgid ""
"Returns the size of the bounding box of the paragraph, without line breaks."
msgstr "ត្រឡប់ទំហំនៃ bounding box របស់កថាខណ្ឌ ដោយគ្មានការបំបែកជួរ។"

msgid "Returns the character range of the paragraph."
msgstr "ត្រឡប់ចន្លោះតួអក្សរនៃកថាខណ្ឌ។"

msgid "Returns TextServer full string buffer RID."
msgstr "ត្រឡប់ RID របស់ buffer ខ្សែអក្សរពេញលេញរបស់ TextServer។"

msgid "Returns the size of the bounding box of the paragraph."
msgstr "ត្រឡប់ទំហំនៃ bounding box របស់កថាខណ្ឌ។"

msgid ""
"Returns [code]true[/code] if an object with [param key] is embedded in this "
"shaped text buffer."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើវត្ថុដែលមាន [param key] ត្រូវបានបង្កប់នៅក្នុង shaped "
"text buffer នេះ។"

msgid ""
"Returns caret character offset at the specified coordinates. This function "
"always returns a valid position."
msgstr ""
"ត្រឡប់ character offset របស់ caret នៅកូអរដោនេដែលបានបញ្ជាក់។ "
"អនុគមន៍នេះតែងតែត្រឡប់ទីតាំងដែលត្រឹមត្រូវ។"

msgid ""
"Sets drop cap, overrides previously set drop cap. Drop cap (dropped capital) "
"is a decorative element at the beginning of a paragraph that is larger than "
"the rest of the text."
msgstr ""
"កំណត់ drop cap សរសេរជាន់លើ drop cap ដែលបានកំណត់ពីមុន។ Drop cap (dropped capital) "
"គឺជាធាតុតុបតែងនៅដើមកថាខណ្ឌ ដែលធំជាងអត្ថបទដែលនៅសល់។"

msgid "Aligns paragraph to the given tab-stops."
msgstr "តម្រឹមកថាខណ្ឌទៅកាន់ tab-stops ដែលបានផ្តល់ឱ្យ។"

msgid "Paragraph horizontal alignment."
msgstr "ការតម្រឹមផ្តេកនៃកថាខណ្ឌ។"

msgid "Line breaking rules. For more info see [TextServer]."
msgstr "ច្បាប់បំបែកជួរ។ សម្រាប់ព័ត៌មានបន្ថែមសូមមើល [TextServer]។"

msgid ""
"Custom punctuation character list, used for word breaking. If set to empty "
"string, server defaults are used."
msgstr ""
"បញ្ជីតួអក្សរសញ្ញាវាក្យផ្ទាល់ខ្លួន ប្រើសម្រាប់ការបំបែកពាក្យ។ ប្រសិនបើកំណត់ទៅជាខ្សែអក្សរទទេ "
"លំនាំដើមរបស់ម៉ាស៊ីនមេត្រូវបានប្រើ។"

msgid "Limits the lines of text shown."
msgstr "កំណត់ដែនកំណត់ជួរនៃអត្ថបទដែលបានបង្ហាញ។"

msgid "The clipping behavior when the text exceeds the paragraph's set width."
msgstr "ឥរិយាបថកាត់តនៅពេលដែលអត្ថបទលើសពីទទឹងដែលបានកំណត់របស់កថាខណ្ឌ។"

msgid "Paragraph width."
msgstr "ទទឹងកថាខណ្ឌ។"

msgid "A server interface for font management and text rendering."
msgstr "ចំណុចប្រទាក់ម៉ាស៊ីនមេសម្រាប់ការគ្រប់គ្រងពុម្ពអក្សរ និងការ render អត្ថបទ។"

msgid ""
"[TextServer] is the API backend for managing fonts and rendering text.\n"
"[b]Note:[/b] This is a low-level API, consider using [TextLine], "
"[TextParagraph], and [Font] classes instead.\n"
"This is an abstract class, so to get the currently active [TextServer] "
"instance, use the following code:\n"
"[codeblocks]\n"
"[gdscript]\n"
"var ts = TextServerManager.get_primary_interface()\n"
"[/gdscript]\n"
"[csharp]\n"
"var ts = TextServerManager.GetPrimaryInterface();\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"[TextServer] គឺជា API backend សម្រាប់ការគ្រប់គ្រងពុម្ពអក្សរ និងការ render អត្ថបទ។\n"
"[b]ចំណាំ៖[/b] នេះគឺជា API កម្រិតទាប សូមពិចារណាប្រើថ្នាក់ [TextLine], [TextParagraph], "
"និង [Font] ជំនួសវិញ។\n"
"នេះគឺជា abstract class ដូច្នេះដើម្បីទទួលបាន instance [TextServer] ដែលកំពុងសកម្មបច្ចុប្បន្ន "
"សូមប្រើកូដខាងក្រោម៖\n"
"[codeblocks]\n"
"[gdscript]\n"
"var ts = TextServerManager.get_primary_interface()\n"
"[/gdscript]\n"
"[csharp]\n"
"var ts = TextServerManager.GetPrimaryInterface();\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Creates a new, empty font cache entry resource. To free the resulting "
"resource, use the [method free_rid] method."
msgstr ""
"បង្កើតធនធាន font cache entry ថ្មីដែលទទេ។ ដើម្បីដោះលែង (free) ធនធានដែលទទួលបាន "
"សូមប្រើវិធីសាស្រ្ត [method free_rid]។"

msgid ""
"Creates a new variation existing font which is reusing the same glyph cache "
"and font data. To free the resulting resource, use the [method free_rid] "
"method."
msgstr ""
"បង្កើត variation ថ្មីនៃពុម្ពអក្សរដែលមានស្រាប់ ដែលកំពុងប្រើប្រាស់ glyph cache "
"និងទិន្នន័យពុម្ពអក្សរដូចគ្នា។ ដើម្បីដោះលែងធនធានដែលទទួលបាន សូមប្រើវិធីសាស្រ្ត [method free_rid]។"

msgid ""
"Creates a new buffer for complex text layout, with the given [param "
"direction] and [param orientation]. To free the resulting buffer, use [method "
"free_rid] method.\n"
"[b]Note:[/b] Direction is ignored if server does not support [constant "
"FEATURE_BIDI_LAYOUT] feature (supported by [TextServerAdvanced]).\n"
"[b]Note:[/b] Orientation is ignored if server does not support [constant "
"FEATURE_VERTICAL_LAYOUT] feature (supported by [TextServerAdvanced])."
msgstr ""
"បង្កើត buffer ថ្មីសម្រាប់ប្លង់អត្ថបទស្មុគស្មាញ ជាមួយ [param direction] និង [param "
"orientation] ដែលបានផ្តល់ឱ្យ។ ដើម្បីដោះលែង buffer ដែលទទួលបាន សូមប្រើវិធីសាស្រ្ត [method "
"free_rid]។\n"
"[b]ចំណាំ៖[/b] Direction ត្រូវបានមិនអើពើ ប្រសិនបើម៉ាស៊ីនមេមិនគាំទ្រមុខងារ [constant "
"FEATURE_BIDI_LAYOUT] (គាំទ្រដោយ [TextServerAdvanced])។\n"
"[b]ចំណាំ៖[/b] Orientation ត្រូវបានមិនអើពើ ប្រសិនបើម៉ាស៊ីនមេមិនគាំទ្រមុខងារ [constant "
"FEATURE_VERTICAL_LAYOUT] (គាំទ្រដោយ [TextServerAdvanced])។"

msgid ""
"Draws box displaying character hexadecimal code. Used for replacing missing "
"characters."
msgstr ""
"គូរប្រអប់ដែលបង្ហាញកូដគោលដប់ប្រាំមួយ (hexadecimal code) របស់តួអក្សរ។ "
"ប្រើសម្រាប់ជំនួសតួអក្សរដែលបាត់។"

msgid ""
"Removes all rendered glyph information from the cache entry.\n"
"[b]Note:[/b] This function will not remove textures associated with the "
"glyphs, use [method font_remove_texture] to remove them manually."
msgstr ""
"ដកព័ត៌មាន glyph ដែលបាន render ទាំងអស់ចេញពី cache entry។\n"
"[b]ចំណាំ៖[/b] អនុគមន៍នេះនឹងមិនដក textures ដែលទាក់ទងនឹង glyphs ទេ សូមប្រើ [method "
"font_remove_texture] ដើម្បីដកវាចេញដោយដៃ។"

msgid "Frees all automatically loaded system fonts."
msgstr "ដោះលែង (Frees) ពុម្ពអក្សរប្រព័ន្ធដែលបានផ្ទុកដោយស្វ័យប្រវត្តិទាំងអស់។"

msgid ""
"Removes all textures from font cache entry.\n"
"[b]Note:[/b] This function will not remove glyphs associated with the "
"texture, use [method font_remove_glyph] to remove them manually."
msgstr ""
"ដក textures ទាំងអស់ចេញពី font cache entry។\n"
"[b]ចំណាំ៖[/b] អនុគមន៍នេះនឹងមិនដក glyphs ដែលទាក់ទងនឹង texture ទេ សូមប្រើ [method "
"font_remove_glyph] ដើម្បីដកវាចេញដោយដៃ។"

msgid ""
"Draws single glyph into a canvas item at the position, using [param font_rid] "
"at the size [param size]. If [param oversampling] is greater than zero, it is "
"used as font oversampling factor, otherwise viewport oversampling settings "
"are used.\n"
"[b]Note:[/b] Glyph index is specific to the font, use glyphs indices returned "
"by [method shaped_text_get_glyphs] or [method font_get_glyph_index].\n"
"[b]Note:[/b] If there are pending glyphs to render, calling this function "
"might trigger the texture cache update."
msgstr ""
"គូរ glyph តែមួយទៅក្នុង canvas item នៅទីតាំង ដោយប្រើ [param font_rid] នៅទំហំ [param "
"size]។ ប្រសិនបើ [param oversampling] ធំជាងសូន្យ វាត្រូវបានប្រើជាកត្តា oversampling "
"របស់ពុម្ពអក្សរ បើមិនដូច្នេះទេ ការកំណត់ oversampling របស់ viewport ត្រូវបានប្រើ។\n"
"[b]ចំណាំ៖[/b] Glyph index គឺជាក់លាក់ចំពោះពុម្ពអក្សរ សូមប្រើ indices របស់ glyphs "
"ដែលបានត្រឡប់ដោយ [method shaped_text_get_glyphs] ឬ [method "
"font_get_glyph_index]។\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើមាន glyphs ដែលកំពុងរង់ចាំ render "
"ការហៅអនុគមន៍នេះអាចកេះឱ្យមានការធ្វើបច្ចុប្បន្នភាព texture cache។"

msgid ""
"Draws single glyph outline of size [param outline_size] into a canvas item at "
"the position, using [param font_rid] at the size [param size]. If [param "
"oversampling] is greater than zero, it is used as font oversampling factor, "
"otherwise viewport oversampling settings are used.\n"
"[b]Note:[/b] Glyph index is specific to the font, use glyphs indices returned "
"by [method shaped_text_get_glyphs] or [method font_get_glyph_index].\n"
"[b]Note:[/b] If there are pending glyphs to render, calling this function "
"might trigger the texture cache update."
msgstr ""
"គូរគ្រោង glyph តែមួយនៃទំហំ [param outline_size] ទៅក្នុង canvas item នៅទីតាំង ដោយប្រើ "
"[param font_rid] នៅទំហំ [param size]។ ប្រសិនបើ [param oversampling] ធំជាងសូន្យ "
"វាត្រូវបានប្រើជាកត្តា oversampling របស់ពុម្ពអក្សរ បើមិនដូច្នេះទេ ការកំណត់ oversampling របស់ "
"viewport ត្រូវបានប្រើ។\n"
"[b]ចំណាំ៖[/b] Glyph index គឺជាក់លាក់ចំពោះពុម្ពអក្សរ សូមប្រើ indices របស់ glyphs "
"ដែលបានត្រឡប់ដោយ [method shaped_text_get_glyphs] ឬ [method "
"font_get_glyph_index]។\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើមាន glyphs ដែលកំពុងរង់ចាំ render "
"ការហៅអនុគមន៍នេះអាចកេះឱ្យមានការធ្វើបច្ចុប្បន្នភាព texture cache។"

msgid "Returns font anti-aliasing mode."
msgstr "ត្រឡប់របៀប anti-aliasing របស់ពុម្ពអក្សរ។"

msgid ""
"Returns character code associated with [param glyph_index], or [code]0[/code] "
"if [param glyph_index] is invalid. See [method font_get_glyph_index]."
msgstr ""
"ត្រឡប់កូដតួអក្សរដែលទាក់ទងនឹង [param glyph_index] ឬ [code]0[/code] ប្រសិនបើ [param "
"glyph_index] មិនត្រឹមត្រូវ។ សូមមើល [method font_get_glyph_index]។"

msgid "Returns whether the font's embedded bitmap loading is disabled."
msgstr "ត្រឡប់ថាតើការផ្ទុក bitmap ដែលបានបង្កប់របស់ពុម្ពអក្សរត្រូវបានបិទឬអត់។"

msgid "Returns font embolden strength."
msgstr "ត្រឡប់កម្រិតធ្វើឱ្យដិត (embolden strength) របស់ពុម្ពអក្សរ។"

msgid "Returns bitmap font fixed size."
msgstr "ត្រឡប់ទំហំថេរនៃពុម្ពអក្សរ bitmap។"

msgid "Returns bitmap font scaling mode."
msgstr "ត្រឡប់របៀបធ្វើមាត្រដ្ឋាននៃពុម្ពអក្សរ bitmap។"

msgid "Returns [code]true[/code] if font texture mipmap generation is enabled."
msgstr "ត្រឡប់ [code]true[/code] ប្រសិនបើការបង្កើត mipmap នៃ font texture ត្រូវបានបើក។"

msgid ""
"Use [Viewport] oversampling, or the [code skip-lint]oversampling[/code] "
"argument of the [code skip-lint]draw_*[/code] methods instead."
msgstr ""
"ប្រើ [Viewport] oversampling ឬអាគុយម៉ង់ [code skip-lint]oversampling[/code] "
"នៃវិធីសាស្រ្ត [code skip-lint]draw_*[/code] ជំនួសវិញ។"

msgid "This method does nothing and always returns [code]1.0[/code]."
msgstr "វិធីសាស្រ្តនេះមិនធ្វើអ្វីទាំងអស់ ហើយតែងតែត្រឡប់ [code]1.0[/code]។"

msgid ""
"Returns outline contours of the glyph as a [Dictionary] with the following "
"contents:\n"
"[code]points[/code]         - [PackedVector3Array], containing outline "
"points. [code]x[/code] and [code]y[/code] are point coordinates. [code]z[/"
"code] is the type of the point, using the [enum ContourPointTag] values.\n"
"[code]contours[/code]       - [PackedInt32Array], containing indices the end "
"points of each contour.\n"
"[code]orientation[/code]    - [bool], contour orientation. If [code]true[/"
"code], clockwise contours must be filled.\n"
"- Two successive [constant CONTOUR_CURVE_TAG_ON] points indicate a line "
"segment.\n"
"- One [constant CONTOUR_CURVE_TAG_OFF_CONIC] point between two [constant "
"CONTOUR_CURVE_TAG_ON] points indicates a single conic (quadratic) Bézier "
"arc.\n"
"- Two [constant CONTOUR_CURVE_TAG_OFF_CUBIC] points between two [constant "
"CONTOUR_CURVE_TAG_ON] points indicate a single cubic Bézier arc.\n"
"- Two successive [constant CONTOUR_CURVE_TAG_OFF_CONIC] points indicate two "
"successive conic (quadratic) Bézier arcs with a virtual [constant "
"CONTOUR_CURVE_TAG_ON] point at their middle.\n"
"- Each contour is closed. The last point of a contour uses the first point of "
"a contour as its next point, and vice versa. The first point can be [constant "
"CONTOUR_CURVE_TAG_OFF_CONIC] point."
msgstr ""
"ត្រឡប់គ្រោងខាងក្រៅ (outline contours) នៃ glyph ជា [Dictionary] "
"ជាមួយខ្លឹមសារដូចខាងក្រោម៖\n"
"[code]points[/code]         - [PackedVector3Array], ផ្ទុកចំណុចគ្រោង។ [code]x[/"
"code] និង [code]y[/code] គឺជាកូអរដោនេចំណុច។ [code]z[/code] គឺជាប្រភេទនៃចំណុច "
"ដោយប្រើតម្លៃ [enum ContourPointTag]។\n"
"[code]contours[/code]       - [PackedInt32Array], ផ្ទុក indices នៃចំណុចបញ្ចប់នៃ "
"contour នីមួយៗ។\n"
"[code]orientation[/code]    - [bool], ទិសដៅ contour។ ប្រសិនបើ [code]true[/code], "
"contours ស្របទ្រនិចនាឡិកាត្រូវតែបំពេញ។\n"
"- ចំណុច [constant CONTOUR_CURVE_TAG_ON] ពីរបន្តបន្ទាប់គ្នា បង្ហាញពីអង្កត់បន្ទាត់។\n"
"- ចំណុច [constant CONTOUR_CURVE_TAG_OFF_CONIC] មួយនៅចន្លោះចំណុច [constant "
"CONTOUR_CURVE_TAG_ON] ពីរ បង្ហាញពីធ្នូ Bézier conic (quadratic) តែមួយ។\n"
"- ចំណុច [constant CONTOUR_CURVE_TAG_OFF_CUBIC] ពីរនៅចន្លោះចំណុច [constant "
"CONTOUR_CURVE_TAG_ON] ពីរ បង្ហាញពីធ្នូ Bézier cubic តែមួយ។\n"
"- ចំណុច [constant CONTOUR_CURVE_TAG_OFF_CONIC] ពីរបន្តបន្ទាប់គ្នា បង្ហាញពីធ្នូ Bézier "
"conic (quadratic) ពីរបន្តបន្ទាប់គ្នា ជាមួយនឹងចំណុច [constant CONTOUR_CURVE_TAG_ON] "
"និម្មិតនៅចំកណ្តាលរបស់ពួកវា។\n"
"- Contour នីមួយៗត្រូវបានបិទ។ ចំណុចចុងក្រោយនៃ contour ប្រើចំណុចដំបូងនៃ contour "
"ជាចំណុចបន្ទាប់របស់វា ហើយផ្ទុយមកវិញ។ ចំណុចដំបូងអាចជាចំណុច [constant "
"CONTOUR_CURVE_TAG_OFF_CONIC]។"

msgid ""
"Returns the glyph index of a [param char], optionally modified by the [param "
"variation_selector]. See [method font_get_char_from_glyph_index]."
msgstr ""
"ត្រឡប់ glyph index នៃ [param char] ដែលអាចត្រូវបានកែប្រែដោយ [param "
"variation_selector] ជាជម្រើស។ សូមមើល [method font_get_char_from_glyph_index]។"

msgid "Returns size of the glyph."
msgstr "ត្រឡប់ទំហំនៃ glyph។"

msgid ""
"Returns resource ID of the cache texture containing the glyph.\n"
"[b]Note:[/b] If there are pending glyphs to render, calling this function "
"might trigger the texture cache update."
msgstr ""
"ត្រឡប់ resource ID នៃ cache texture ដែលផ្ទុក glyph។\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើមាន glyphs ដែលកំពុងរង់ចាំ render "
"ការហៅអនុគមន៍នេះអាចកេះឱ្យមានការធ្វើបច្ចុប្បន្នភាព texture cache។"

msgid ""
"Returns size of the cache texture containing the glyph.\n"
"[b]Note:[/b] If there are pending glyphs to render, calling this function "
"might trigger the texture cache update."
msgstr ""
"ត្រឡប់ទំហំនៃ cache texture ដែលផ្ទុក glyph។\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើមាន glyphs ដែលកំពុងរង់ចាំ render "
"ការហៅអនុគមន៍នេះអាចកេះឱ្យមានការធ្វើបច្ចុប្បន្នភាព texture cache។"

msgid "Returns the font hinting mode. Used by dynamic fonts only."
msgstr "ត្រឡប់របៀប hinting របស់ពុម្ពអក្សរ។ ប្រើសម្រាប់តែ dynamic fonts ប៉ុណ្ណោះ។"

msgid ""
"Returns glyph position rounding behavior. If set to [code]true[/code], when "
"aligning glyphs to the pixel boundaries rounding remainders are accumulated "
"to ensure more uniform glyph distribution. This setting has no effect if "
"subpixel positioning is enabled."
msgstr ""
"ត្រឡប់ឥរិយាបថបង្គត់ទីតាំង glyph។ ប្រសិនបើកំណត់ទៅជា [code]true[/code] នៅពេលតម្រឹម glyphs "
"ទៅកាន់ព្រំដែនភីកសែល ផលសល់នៃការបង្គត់ត្រូវបានប្រមូលផ្តុំ ដើម្បីធានាបាននូវការចែកចាយ glyph "
"ដែលមានភាពស្មើគ្នាជាងមុន។ ការកំណត់នេះគ្មានឥទ្ធិពលទេ ប្រសិនបើ subpixel positioning "
"ត្រូវបានបើក។"

msgid ""
"Returns the width of the range around the shape between the minimum and "
"maximum representable signed distance."
msgstr "ត្រឡប់ទទឹងនៃចន្លោះជុំវិញរាងរវាងចម្ងាយ signed អប្បបរមា និងអតិបរមាដែលអាចតំណាងបាន។"

msgid "Returns source font size used to generate MSDF textures."
msgstr "ត្រឡប់ទំហំពុម្ពអក្សរប្រភពដែលប្រើដើម្បីបង្កើត MSDF textures។"

msgid "Returns font OpenType feature set override."
msgstr "ត្រឡប់ការសរសេរជាន់នៃសំណុំមុខងារ OpenType របស់ពុម្ពអក្សរ។"

msgid ""
"Returns oversampling factor override. If set to a positive value, overrides "
"the oversampling factor of the viewport this font is used in. See [member "
"Viewport.oversampling]. This value doesn't override the [code skip-"
"lint]oversampling[/code] parameter of [code skip-lint]draw_*[/code] methods. "
"Used by dynamic fonts only."
msgstr ""
"ត្រឡប់ការសរសេរជាន់នៃកត្តា oversampling។ ប្រសិនបើកំណត់ទៅជាតម្លៃវិជ្ជមាន "
"វានឹងសរសេរជាន់លើកត្តា oversampling នៃ viewport ដែលពុម្ពអក្សរនេះត្រូវបានប្រើ។ សូមមើល "
"[member Viewport.oversampling]។ តម្លៃនេះមិនសរសេរជាន់លើប៉ារ៉ាម៉ែត្រ [code skip-"
"lint]oversampling[/code] នៃវិធីសាស្រ្ត [code skip-lint]draw_*[/code] ទេ។ "
"ប្រើសម្រាប់តែ dynamic fonts ប៉ុណ្ណោះ។"

msgid ""
"Returns the array in the predefined color palette at [param index]. Palette "
"contains all colors used to render font glyphs. Each palette has the same "
"number of colors. Colors can be overridden using [method "
"font_set_palette_custom_colors]."
msgstr ""
"ត្រឡប់ array នៅក្នុងក្តារពណ៌ដែលបានកំណត់ជាមុននៅ [param index]។ ក្តារពណ៌ (Palette) "
"ផ្ទុកពណ៌ទាំងអស់ដែលប្រើដើម្បី render font glyphs។ ក្តារពណ៌នីមួយៗមានចំនួនពណ៌ដូចគ្នា។ "
"ពណ៌អាចត្រូវបានសរសេរជាន់ដោយប្រើ [method font_set_palette_custom_colors]។"

msgid "Returns array of custom colors to override predefined palette."
msgstr "ត្រឡប់ array នៃពណ៌ផ្ទាល់ខ្លួន ដើម្បីសរសេរជាន់លើក្តារពណ៌ដែលបានកំណត់ជាមុន។"

msgid ""
"Returns font cache information, each entry contains the following fields: "
"[code]Vector2i size_px[/code] - font size in pixels, [code]float "
"viewport_oversampling[/code] - viewport oversampling factor, [code]int "
"glyphs[/code] - number of rendered glyphs, [code]int textures[/code] - number "
"of used textures, [code]int textures_size[/code] - size of texture data in "
"bytes."
msgstr ""
"ត្រឡប់ព័ត៌មាន font cache, ធាតុនីមួយៗផ្ទុកវាលដូចខាងក្រោម៖ [code]Vector2i size_px[/code] - "
"ទំហំពុម្ពអក្សរគិតជាភីកសែល, [code]float viewport_oversampling[/code] - កត្តា "
"oversampling របស់ viewport, [code]int glyphs[/code] - ចំនួន glyphs ដែលបាន "
"render, [code]int textures[/code] - ចំនួន textures ដែលបានប្រើ, [code]int "
"textures_size[/code] - ទំហំទិន្នន័យ texture គិតជា bytes។"

msgid ""
"Returns the spacing for [param spacing] in pixels (not relative to the font "
"size)."
msgstr "ត្រឡប់គម្លាតសម្រាប់ [param spacing] គិតជាភីកសែល (មិនធៀបនឹងទំហំពុម្ពអក្សរទេ)។"

msgid "Returns font subpixel glyph positioning mode."
msgstr "ត្រឡប់របៀបកំណត់ទីតាំង glyph subpixel របស់ពុម្ពអក្សរ។"

msgid "Returns a string containing all the characters available in the font."
msgstr "ត្រឡប់ខ្សែអក្សរដែលផ្ទុកតួអក្សរទាំងអស់ដែលមាននៅក្នុងពុម្ពអក្សរ។"

msgid "Returns an array containing all glyph indices in the font."
msgstr "ត្រឡប់ array ដែលផ្ទុក glyph indices ទាំងអស់នៅក្នុងពុម្ពអក្សរ។"

msgid "Returns font cache texture image data."
msgstr "ត្រឡប់ទិន្នន័យរូបភាព font cache texture។"

msgid "Returns array containing glyph packing data."
msgstr "ត្រឡប់ array ដែលផ្ទុកទិន្នន័យ glyph packing។"

msgid "Returns 2D transform applied to the font outlines."
msgstr "ត្រឡប់ 2D transform ដែលបានអនុវត្តទៅលើ font outlines។"

msgid "Returns used palette index."
msgstr "ត្រឡប់ palette index ដែលបានប្រើ។"

msgid ""
"Returns variation coordinates for the specified font cache entry. See [method "
"font_supported_variation_list] for more info."
msgstr ""
"ត្រឡប់ variation coordinates សម្រាប់ font cache entry ដែលបានបញ្ជាក់។ សូមមើល [method "
"font_supported_variation_list] សម្រាប់ព័ត៌មានបន្ថែម។"

msgid ""
"Returns [code]true[/code] if system fonts can be automatically used as "
"fallbacks."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើពុម្ពអក្សរប្រព័ន្ធអាចត្រូវបានប្រើជា fallbacks ដោយស្វ័យប្រវត្តិ។"

msgid ""
"Returns [code]true[/code] if auto-hinting is supported and preferred over "
"font built-in hinting. Used by dynamic fonts only."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ auto-hinting ត្រូវបានគាំទ្រ ហើយត្រូវបានចូលចិត្តជាង font "
"built-in hinting។ ប្រើសម្រាប់តែ dynamic fonts ប៉ុណ្ណោះ។"

msgid ""
"Returns [code]true[/code] if color modulation is applied when drawing the "
"font's colored glyphs."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ color modulation ត្រូវបានអនុវត្តនៅពេលគូរ glyphs "
"ដែលមានពណ៌របស់ពុម្ពអក្សរ។"

msgid ""
"Returns [code]true[/code] if glyphs of all sizes are rendered using single "
"multichannel signed distance field generated from the dynamic font vector "
"data."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ glyphs នៃគ្រប់ទំហំត្រូវបាន render ដោយប្រើ multichannel "
"signed distance field តែមួយ ដែលបានបង្កើតពីទិន្នន័យ vector នៃ dynamic font។"

msgid ""
"Removes specified rendered glyph information from the cache entry.\n"
"[b]Note:[/b] This function will not remove textures associated with the "
"glyphs, use [method font_remove_texture] to remove them manually."
msgstr ""
"ដកព័ត៌មាន glyph ដែលបាន render ជាក់លាក់ចេញពី cache entry។\n"
"[b]ចំណាំ៖[/b] អនុគមន៍នេះនឹងមិនដក textures ដែលទាក់ទងនឹង glyphs ទេ សូមប្រើ [method "
"font_remove_texture] ដើម្បីដកវាចេញដោយដៃ។"

msgid ""
"Removes specified texture from the cache entry.\n"
"[b]Note:[/b] This function will not remove glyphs associated with the "
"texture, remove them manually, using [method font_remove_glyph]."
msgstr ""
"ដក texture ជាក់លាក់ចេញពី cache entry។\n"
"[b]ចំណាំ៖[/b] អនុគមន៍នេះនឹងមិនដក glyphs ដែលទាក់ទងនឹង texture ទេ សូមដកវាចេញដោយដៃ ដោយប្រើ "
"[method font_remove_glyph]។"

msgid "Sets font anti-aliasing mode."
msgstr "កំណត់របៀប anti-aliasing របស់ពុម្ពអក្សរ។"

msgid "Sets font source data, e.g contents of the dynamic font source file."
msgstr "កំណត់ទិន្នន័យប្រភពពុម្ពអក្សរ ឧ. ខ្លឹមសារនៃឯកសារប្រភព dynamic font។"

msgid ""
"Sets font embolden strength. If [param strength] is not equal to zero, "
"emboldens the font outlines. Negative values reduce the outline thickness."
msgstr ""
"កំណត់កម្រិត embolden របស់ពុម្ពអក្សរ។ ប្រសិនបើ [param strength] មិនស្មើនឹងសូន្យទេ វានឹងធ្វើឱ្យ "
"font outlines កាន់តែដិត។ តម្លៃអវិជ្ជមានកាត់បន្ថយកម្រាស់ outline។"

msgid ""
"Sets bitmap font fixed size. If set to value greater than zero, same cache "
"entry will be used for all font sizes."
msgstr ""
"កំណត់ទំហំថេរនៃពុម្ពអក្សរ bitmap។ ប្រសិនបើកំណត់ទៅជាតម្លៃធំជាងសូន្យ cache entry "
"ដូចគ្នានឹងត្រូវបានប្រើសម្រាប់គ្រប់ទំហំពុម្ពអក្សរ។"

msgid ""
"Sets bitmap font scaling mode. This property is used only if "
"[code]fixed_size[/code] is greater than zero."
msgstr ""
"កំណត់របៀបធ្វើមាត្រដ្ឋាននៃពុម្ពអក្សរ bitmap។ Property នេះត្រូវបានប្រើតែនៅពេលដែល "
"[code]fixed_size[/code] ធំជាងសូន្យប៉ុណ្ណោះ។"

msgid ""
"If set to [code]true[/code] auto-hinting is preferred over font built-in "
"hinting."
msgstr ""
"ប្រសិនបើកំណត់ទៅជា [code]true[/code] auto-hinting ត្រូវបានចូលចិត្តជាង font built-in "
"hinting។"

msgid "If set to [code]true[/code] font texture mipmap generation is enabled."
msgstr ""
"ប្រសិនបើកំណត់ទៅជា [code]true[/code] ការបង្កើត mipmap នៃ font texture ត្រូវបានបើក។"

msgid "Sets size of the glyph."
msgstr "កំណត់ទំហំនៃ glyph។"

msgid "Sets font hinting mode. Used by dynamic fonts only."
msgstr "កំណត់របៀប hinting របស់ពុម្ពអក្សរ។ ប្រើសម្រាប់តែ dynamic fonts ប៉ុណ្ណោះ។"

msgid ""
"Sets glyph position rounding behavior. If set to [code]true[/code], when "
"aligning glyphs to the pixel boundaries rounding remainders are accumulated "
"to ensure more uniform glyph distribution. This setting has no effect if "
"subpixel positioning is enabled."
msgstr ""
"កំណត់ឥរិយាបថបង្គត់ទីតាំង glyph។ ប្រសិនបើកំណត់ទៅជា [code]true[/code] នៅពេលតម្រឹម glyphs "
"ទៅកាន់ព្រំដែនភីកសែល ផលសល់នៃការបង្គត់ត្រូវបានប្រមូលផ្តុំ ដើម្បីធានាបាននូវការចែកចាយ glyph "
"ដែលមានភាពស្មើគ្នាជាងមុន។ ការកំណត់នេះគ្មានឥទ្ធិពលទេ ប្រសិនបើ subpixel positioning "
"ត្រូវបានបើក។"

msgid "Adds override for [method font_is_language_supported]."
msgstr "បន្ថែមការសរសេរជាន់សម្រាប់ [method font_is_language_supported]។"

msgid ""
"Sets the width of the range around the shape between the minimum and maximum "
"representable signed distance."
msgstr "កំណត់ទទឹងនៃចន្លោះជុំវិញរាងរវាងចម្ងាយ signed អប្បបរមា និងអតិបរមាដែលអាចតំណាងបាន។"

msgid "Sets source font size used to generate MSDF textures."
msgstr "កំណត់ទំហំពុម្ពអក្សរប្រភពដែលប្រើដើម្បីបង្កើត MSDF textures។"

msgid ""
"If set to [code]true[/code], glyphs of all sizes are rendered using single "
"multichannel signed distance field generated from the dynamic font vector "
"data. MSDF rendering allows displaying the font at any scaling factor without "
"blurriness, and without incurring a CPU cost when the font size changes "
"(since the font no longer needs to be rasterized on the CPU). As a downside, "
"font hinting is not available with MSDF. The lack of font hinting may result "
"in less crisp and less readable fonts at small sizes.\n"
"[b]Note:[/b] MSDF font rendering does not render glyphs with overlapping "
"shapes correctly. Overlapping shapes are not valid per the OpenType standard, "
"but are still commonly found in many font files, especially those converted "
"by Google Fonts. To avoid issues with overlapping glyphs, consider "
"downloading the font file directly from the type foundry instead of relying "
"on Google Fonts."
msgstr ""
"ប្រសិនបើកំណត់ទៅជា [code]true[/code] glyphs នៃគ្រប់ទំហំត្រូវបាន render ដោយប្រើ "
"multichannel signed distance field តែមួយ ដែលបានបង្កើតពីទិន្នន័យ vector នៃ dynamic "
"font។ ការ render MSDF អនុញ្ញាតឱ្យបង្ហាញពុម្ពអក្សរនៅកត្តាមាត្រដ្ឋានណាមួយដោយគ្មានភាពព្រាល "
"ហើយដោយគ្មានការចំណាយ CPU នៅពេលដែលទំហំពុម្ពអក្សរផ្លាស់ប្តូរ (ដោយសារពុម្ពអក្សរលែងត្រូវការ "
"rasterized នៅលើ CPU)។ ជាគុណវិបត្តិ font hinting មិនមានទេជាមួយ MSDF។ កង្វះ font "
"hinting អាចបណ្តាលឱ្យពុម្ពអក្សរមិនសូវច្បាស់ និងពិបាកអាននៅទំហំតូច។\n"
"[b]ចំណាំ៖[/b] ការ render ពុម្ពអក្សរ MSDF មិន render glyphs "
"ដែលមានរាងត្រួតគ្នាបានត្រឹមត្រូវទេ។ រាងត្រួតគ្នាមិនត្រឹមត្រូវតាមស្តង់ដារ OpenType ទេ "
"ប៉ុន្តែនៅតែអាចរកឃើញជាទូទៅនៅក្នុងឯកសារពុម្ពអក្សរជាច្រើន ជាពិសេស那些ដែលបានបម្លែងដោយ Google "
"Fonts។ ដើម្បីជៀសវាងបញ្ហាជាមួយ glyphs ត្រួតគ្នា សូមពិចារណាទាញយកឯកសារពុម្ពអក្សរដោយផ្ទាល់ពី "
"type foundry ជំនួសឱ្យការពឹងផ្អែកលើ Google Fonts។"

msgid "Sets the font family name."
msgstr "កំណត់ឈ្មោះគ្រួសារពុម្ពអក្សរ (font family name)។"

msgid "Sets font OpenType feature set override."
msgstr "កំណត់ការសរសេរជាន់នៃសំណុំមុខងារ OpenType របស់ពុម្ពអក្សរ។"

msgid ""
"If set to a positive value, overrides the oversampling factor of the viewport "
"this font is used in. See [member Viewport.oversampling]. This value doesn't "
"override the [code skip-lint]oversampling[/code] parameter of [code skip-"
"lint]draw_*[/code] methods. Used by dynamic fonts only."
msgstr ""
"ប្រសិនបើកំណត់ទៅជាតម្លៃវិជ្ជមាន វានឹងសរសេរជាន់លើកត្តា oversampling នៃ viewport "
"ដែលពុម្ពអក្សរនេះត្រូវបានប្រើ។ សូមមើល [member Viewport.oversampling]។ "
"តម្លៃនេះមិនសរសេរជាន់លើប៉ារ៉ាម៉ែត្រ [code skip-lint]oversampling[/code] នៃវិធីសាស្រ្ត "
"[code skip-lint]draw_*[/code] ទេ។ ប្រើសម្រាប់តែ dynamic fonts ប៉ុណ្ណោះ។"

msgid ""
"Sets array of custom colors to override predefined palette. Set to empty "
"array to reset overrides. Use [code]Color(0, 0, 0, 0)[/code], to keep "
"predefined palette color at specific position."
msgstr ""
"កំណត់ array នៃពណ៌ផ្ទាល់ខ្លួន ដើម្បីសរសេរជាន់លើក្តារពណ៌ដែលបានកំណត់ជាមុន។ កំណត់ទៅជា array ទទេ "
"ដើម្បីកំណត់ការសរសេរជាន់ឡើងវិញ។ ប្រើ [code]Color(0, 0, 0, 0)[/code] "
"ដើម្បីរក្សាពណ៌ក្តារពណ៌ដែលបានកំណត់ជាមុននៅទីតាំងជាក់លាក់។"

msgid "Adds override for [method font_is_script_supported]."
msgstr "បន្ថែមការសរសេរជាន់សម្រាប់ [method font_is_script_supported]។"

msgid ""
"Sets font stretch amount, compared to a normal width. A percentage value "
"between [code]50%[/code] and [code]200%[/code].\n"
"[b]Note:[/b] This value is used for font matching only and will not affect "
"font rendering. Use [method font_set_face_index], [method "
"font_set_variation_coordinates], or [method font_set_transform] instead."
msgstr ""
"កំណត់ចំនួន stretch របស់ពុម្ពអក្សរ ធៀបនឹងទទឹងធម្មតា។ តម្លៃភាគរយរវាង [code]50%[/code] និង "
"[code]200%[/code]។\n"
"[b]ចំណាំ៖[/b] តម្លៃនេះត្រូវបានប្រើសម្រាប់តែការផ្គូផ្គងពុម្ពអក្សរ ហើយនឹងមិនប៉ះពាល់ដល់ការ render "
"ពុម្ពអក្សរទេ។ សូមប្រើ [method font_set_face_index], [method "
"font_set_variation_coordinates], ឬ [method font_set_transform] ជំនួសវិញ។"

msgid ""
"Sets the font style flags.\n"
"[b]Note:[/b] This value is used for font matching only and will not affect "
"font rendering. Use [method font_set_face_index], [method "
"font_set_variation_coordinates], [method font_set_embolden], or [method "
"font_set_transform] instead."
msgstr ""
"កំណត់ flags រចនាប័ទ្មពុម្ពអក្សរ។\n"
"[b]ចំណាំ៖[/b] តម្លៃនេះត្រូវបានប្រើសម្រាប់តែការផ្គូផ្គងពុម្ពអក្សរ ហើយនឹងមិនប៉ះពាល់ដល់ការ render "
"ពុម្ពអក្សរទេ។ សូមប្រើ [method font_set_face_index], [method "
"font_set_variation_coordinates], [method font_set_embolden], ឬ [method "
"font_set_transform] ជំនួសវិញ។"

msgid "Sets the font style name."
msgstr "កំណត់ឈ្មោះរចនាប័ទ្មពុម្ពអក្សរ។"

msgid "Sets font subpixel glyph positioning mode."
msgstr "កំណត់របៀបកំណត់ទីតាំង glyph subpixel របស់ពុម្ពអក្សរ។"

msgid "Sets font cache texture image data."
msgstr "កំណត់ទិន្នន័យរូបភាព font cache texture។"

msgid ""
"Sets 2D transform, applied to the font outlines, can be used for slanting, "
"flipping, and rotating glyphs.\n"
"For example, to simulate italic typeface by slanting, apply the following "
"transform [code]Transform2D(1.0, slant, 0.0, 1.0, 0.0, 0.0)[/code]."
msgstr ""
"កំណត់ 2D transform ដែលអនុវត្តទៅលើ font outlines អាចត្រូវបានប្រើសម្រាប់ការធ្វើឱ្យទ្រេត "
"ត្រឡប់ និងបង្វិល glyphs។\n"
"ឧទាហរណ៍ ដើម្បីក្លែងធ្វើអក្សរទ្រេត (italic typeface) ដោយការធ្វើឱ្យទ្រេត សូមអនុវត្ត "
"transform ខាងក្រោម [code]Transform2D(1.0, slant, 0.0, 1.0, 0.0, 0.0)[/code]។"

msgid "Sets used palette index."
msgstr "កំណត់ palette index ដែលបានប្រើ។"

msgid ""
"Sets variation coordinates for the specified font cache entry. See [method "
"font_supported_variation_list] for more info."
msgstr ""
"កំណត់ variation coordinates សម្រាប់ font cache entry ដែលបានបញ្ជាក់។ សូមមើល [method "
"font_supported_variation_list] សម្រាប់ព័ត៌មានបន្ថែម។"

msgid ""
"Sets weight (boldness) of the font. A value in the [code]100...999[/code] "
"range, normal font weight is [code]400[/code], bold font weight is [code]700[/"
"code].\n"
"[b]Note:[/b] This value is used for font matching only and will not affect "
"font rendering. Use [method font_set_face_index], [method "
"font_set_variation_coordinates], or [method font_set_embolden] instead."
msgstr ""
"កំណត់ weight (ភាពដិត) របស់ពុម្ពអក្សរ។ តម្លៃនៅក្នុងចន្លោះ [code]100...999[/code] "
"ទំងន់ពុម្ពអក្សរធម្មតាគឺ [code]400[/code] ទំងន់ពុម្ពអក្សរដិតគឺ [code]700[/code]។\n"
"[b]ចំណាំ៖[/b] តម្លៃនេះត្រូវបានប្រើសម្រាប់តែការផ្គូផ្គងពុម្ពអក្សរ ហើយនឹងមិនប៉ះពាល់ដល់ការ render "
"ពុម្ពអក្សរទេ។ សូមប្រើ [method font_set_face_index], [method "
"font_set_variation_coordinates], ឬ [method font_set_embolden] ជំនួសវិញ។"

msgid "Returns the dictionary of the supported OpenType features."
msgstr "ត្រឡប់ dictionary នៃមុខងារ OpenType ដែលបានគាំទ្រ។"

msgid "Returns the dictionary of the supported OpenType variation coordinates."
msgstr "ត្រឡប់ dictionary នៃ variation coordinates OpenType ដែលបានគាំទ្រ។"

msgid "Use [method TranslationServer.format_number] instead."
msgstr "សូមប្រើ [method TranslationServer.format_number] ជំនួសវិញ។"

msgid ""
"Converts a number from Western Arabic (0..9) to the numeral system used in "
"the given [param language].\n"
"If [param language] is an empty string, the active locale will be used."
msgstr ""
"បម្លែងលេខពី Western Arabic (0..9) ទៅជាប្រព័ន្ធលេខដែលប្រើក្នុង [param language] "
"ដែលបានផ្តល់ឱ្យ។\n"
"ប្រសិនបើ [param language] គឺជាខ្សែអក្សរទទេ locale សកម្មនឹងត្រូវបានប្រើ។"

msgid "Frees an object created by this [TextServer]."
msgstr "ដោះលែង (Frees) វត្ថុដែលបានបង្កើតដោយ [TextServer] នេះ។"

msgid "Returns text server features, see [enum Feature]."
msgstr "ត្រឡប់មុខងារ text server, សូមមើល [enum Feature]។"

msgid ""
"Returns size of the replacement character (box with character hexadecimal "
"code that is drawn in place of invalid characters)."
msgstr ""
"ត្រឡប់ទំហំនៃតួអក្សរជំនួស (ប្រអប់ដែលមានកូដគោលដប់ប្រាំមួយរបស់តួអក្សរ ដែលត្រូវបានគូរជំនួសតួអក្សរមិនត្រឹមត្រូវ)។"

msgid "Returns the name of the server interface."
msgstr "ត្រឡប់ឈ្មោះនៃចំណុចប្រទាក់ម៉ាស៊ីនមេ។"

msgid ""
"Returns default TextServer database (e.g. ICU break iterators and "
"dictionaries)."
msgstr ""
"ត្រឡប់មូលដ្ឋានទិន្នន័យ TextServer លំនាំដើម (ឧ. ICU break iterators និង dictionaries)។"

msgid ""
"Returns default TextServer database (e.g. ICU break iterators and "
"dictionaries) filename."
msgstr ""
"ត្រឡប់ឈ្មោះឯកសារនៃមូលដ្ឋានទិន្នន័យ TextServer លំនាំដើម (ឧ. ICU break iterators និង "
"dictionaries)។"

msgid ""
"Returns TextServer database (e.g. ICU break iterators and dictionaries) "
"description."
msgstr ""
"ត្រឡប់ការពិពណ៌នាអំពីមូលដ្ឋានទិន្នន័យ TextServer (ឧ. ICU break iterators និង dictionaries)។"

msgid ""
"Returns [code]true[/code] if [param rid] is valid resource owned by this text "
"server."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ [param rid] គឺជាធនធានត្រឹមត្រូវដែលកាន់កាប់ដោយ text "
"server នេះ។"

msgid "Returns [code]true[/code] if the server supports a feature."
msgstr "ត្រឡប់ [code]true[/code] ប្រសិនបើម៉ាស៊ីនមេគាំទ្រមុខងារណាមួយ។"

msgid ""
"Returns index of the first string in [param dict] which is visually "
"confusable with the [param string], or [code]-1[/code] if none is found.\n"
"[b]Note:[/b] This method doesn't detect invisible characters, for spoof "
"detection use it in combination with [method spoof_check].\n"
"[b]Note:[/b] Always returns [code]-1[/code] if the server does not support "
"the [constant FEATURE_UNICODE_SECURITY] feature."
msgstr ""
"ត្រឡប់ index នៃខ្សែអក្សរដំបូងនៅក្នុង [param dict] ដែលអាចច្រឡំមើលឃើញជាមួយ [param string] "
"ឬ [code]-1[/code] ប្រសិនបើរកមិនឃើញ។\n"
"[b]ចំណាំ៖[/b] វិធីសាស្រ្តនេះមិនរកឃើញតួអក្សរដែលមើលមិនឃើញទេ សម្រាប់ការរកឃើញការក្លែងបន្លំ "
"(spoof detection) សូមប្រើវារួមគ្នាជាមួយ [method spoof_check]។\n"
"[b]ចំណាំ៖[/b] តែងតែត្រឡប់ [code]-1[/code] ប្រសិនបើម៉ាស៊ីនមេមិនគាំទ្រមុខងារ [constant "
"FEATURE_UNICODE_SECURITY]។"

msgid "Returns [code]true[/code] if locale is right-to-left."
msgstr "ត្រឡប់ [code]true[/code] ប្រសិនបើ locale គឺពីស្តាំទៅឆ្វេង។"

msgid ""
"Returns [code]true[/code] if the locale requires text server support data for "
"line/word breaking."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ locale ត្រូវការទិន្នន័យគាំទ្រ text server "
"សម្រាប់ការបំបែកជួរ/ពាក្យ។"

msgid ""
"Returns [code]true[/code] if [param string] is a valid identifier.\n"
"If the text server supports the [constant FEATURE_UNICODE_IDENTIFIERS] "
"feature, a valid identifier must:\n"
"- Conform to normalization form C.\n"
"- Begin with a Unicode character of class XID_Start or [code]\"_\"[/code].\n"
"- May contain Unicode characters of class XID_Continue in the other "
"positions.\n"
"- Use UAX #31 recommended scripts only (mixed scripts are allowed).\n"
"If the [constant FEATURE_UNICODE_IDENTIFIERS] feature is not supported, a "
"valid identifier must:\n"
"- Begin with a Unicode character of class XID_Start or [code]\"_\"[/code].\n"
"- May contain Unicode characters of class XID_Continue in the other positions."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ [param string] គឺជា identifier ត្រឹមត្រូវ។\n"
"ប្រសិនបើ text server គាំទ្រមុខងារ [constant FEATURE_UNICODE_IDENTIFIERS] "
"identifier ត្រឹមត្រូវត្រូវតែ៖\n"
"- ស្របតាម normalization form C។\n"
"- ចាប់ផ្តើមដោយតួអក្សរ Unicode នៃ class XID_Start ឬ [code]\"_\"[/code]។\n"
"- អាចផ្ទុកតួអក្សរ Unicode នៃ class XID_Continue នៅទីតាំងផ្សេងទៀត។\n"
"- ប្រើតែ scripts ដែលបានណែនាំ UAX #31 ប៉ុណ្ណោះ (scripts លាយគ្នាត្រូវបានអនុញ្ញាត)។\n"
"ប្រសិនបើមុខងារ [constant FEATURE_UNICODE_IDENTIFIERS] មិនត្រូវបានគាំទ្រទេ identifier "
"ត្រឹមត្រូវត្រូវតែ៖\n"
"- ចាប់ផ្តើមដោយតួអក្សរ Unicode នៃ class XID_Start ឬ [code]\"_\"[/code]។\n"
"- អាចផ្ទុកតួអក្សរ Unicode នៃ class XID_Continue នៅទីតាំងផ្សេងទៀត។"

msgid ""
"Returns [code]true[/code] if the given code point is a valid letter, i.e. it "
"belongs to the Unicode category \"L\"."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ code point ដែលបានផ្តល់ឱ្យគឺជាអក្សរត្រឹមត្រូវ "
"ពោលគឺវាស្ថិតនៅក្នុងប្រភេទ Unicode \"L\"។"

msgid ""
"Loads optional TextServer database (e.g. ICU break iterators and "
"dictionaries).\n"
"[b]Note:[/b] This function should be called before any other TextServer "
"functions used, otherwise it won't have any effect."
msgstr ""
"ផ្ទុកមូលដ្ឋានទិន្នន័យ TextServer ជាជម្រើស (ឧ. ICU break iterators និង dictionaries)។\n"
"[b]ចំណាំ៖[/b] អនុគមន៍នេះគួរតែត្រូវបានហៅមុនពេលមុខងារ TextServer ផ្សេងទៀតត្រូវបានប្រើ "
"បើមិនដូច្នេះទេវានឹងគ្មានឥទ្ធិពលអ្វីទេ។"

msgid ""
"Converts the given readable name of a feature, variation, script, or language "
"to an OpenType tag."
msgstr "បម្លែងឈ្មោះដែលអាចអានបាននៃមុខងារ variation script ឬភាសា ទៅជា OpenType tag។"

msgid "Use [method TranslationServer.parse_number] instead."
msgstr "សូមប្រើ [method TranslationServer.parse_number] ជំនួសវិញ។"

msgid ""
"Converts [param number] from the numeral system used in the given [param "
"language] to Western Arabic (0..9).\n"
"If [param language] is an empty string, the active locale will be used."
msgstr ""
"បម្លែង [param number] ពីប្រព័ន្ធលេខដែលប្រើក្នុង [param language] ដែលបានផ្តល់ឱ្យ ទៅជា "
"Western Arabic (0..9)។\n"
"ប្រសិនបើ [param language] គឺជាខ្សែអក្សរទទេ locale សកម្មនឹងត្រូវបានប្រើ។"

msgid "Default implementation of the BiDi algorithm override function."
msgstr "ការអនុវត្តលំនាំដើមនៃអនុគមន៍សរសេរជាន់ក្បួនដោះស្រាយ BiDi។"

msgid "Use [method TranslationServer.get_percent_sign] instead."
msgstr "សូមប្រើ [method TranslationServer.get_percent_sign] ជំនួសវិញ។"

msgid ""
"Returns the percent sign used in the given [param language].\n"
"If [param language] is an empty string, the active locale will be used."
msgstr ""
"ត្រឡប់សញ្ញាភាគរយដែលប្រើក្នុង [param language] ដែលបានផ្តល់ឱ្យ។\n"
"ប្រសិនបើ [param language] គឺជាខ្សែអក្សរទទេ locale សកម្មនឹងត្រូវបានប្រើ។"

msgid ""
"Saves optional TextServer database (e.g. ICU break iterators and "
"dictionaries) to the file.\n"
"[b]Note:[/b] This function is used by during project export, to include "
"TextServer database."
msgstr ""
"រក្សាទុកមូលដ្ឋានទិន្នន័យ TextServer ជាជម្រើស (ឧ. ICU break iterators និង dictionaries) "
"ទៅក្នុងឯកសារ។\n"
"[b]ចំណាំ៖[/b] អនុគមន៍នេះត្រូវបានប្រើក្នុងអំឡុងពេល export គម្រោង ដើម្បីរួមបញ្ចូលមូលដ្ឋានទិន្នន័យ "
"TextServer។"

msgid "Returns the number of uniform text runs in the buffer."
msgstr "ត្រឡប់ចំនួននៃ uniform text runs នៅក្នុង buffer។"

msgid "Returns the direction of the [param index] text run (in visual order)."
msgstr "ត្រឡប់ទិសដៅនៃ [param index] text run (តាមលំដាប់ដែលមើលឃើញ)។"

msgid "Returns the font RID of the [param index] text run (in visual order)."
msgstr "ត្រឡប់ font RID នៃ [param index] text run (តាមលំដាប់ដែលមើលឃើញ)។"

msgid "Returns the font size of the [param index] text run (in visual order)."
msgstr "ត្រឡប់ទំហំពុម្ពអក្សរនៃ [param index] text run (តាមលំដាប់ដែលមើលឃើញ)។"

msgid "Returns the glyph range of the [param index] text run (in visual order)."
msgstr "ត្រឡប់ចន្លោះ glyph នៃ [param index] text run (តាមលំដាប់ដែលមើលឃើញ)។"

msgid "Returns the language of the [param index] text run (in visual order)."
msgstr "ត្រឡប់ភាសានៃ [param index] text run (តាមលំដាប់ដែលមើលឃើញ)។"

msgid ""
"Returns the embedded object of the [param index] text run (in visual order)."
msgstr "ត្រឡប់វត្ថុដែលបានបង្កប់នៃ [param index] text run (តាមលំដាប់ដែលមើលឃើញ)។"

msgid ""
"Returns the source text range of the [param index] text run (in visual order)."
msgstr "ត្រឡប់ចន្លោះអត្ថបទប្រភពនៃ [param index] text run (តាមលំដាប់ដែលមើលឃើញ)។"

msgid "Returns the source text of the [param index] text run (in visual order)."
msgstr "ត្រឡប់អត្ថបទប្រភពនៃ [param index] text run (តាមលំដាប់ដែលមើលឃើញ)។"

msgid ""
"Returns number of text spans added using [method shaped_text_add_string] or "
"[method shaped_text_add_object]."
msgstr ""
"ត្រឡប់ចំនួន text spans ដែលបានបន្ថែមដោយប្រើ [method shaped_text_add_string] ឬ "
"[method shaped_text_add_object]។"

msgid "Returns text embedded object key."
msgstr "ត្រឡប់ key វត្ថុដែលបានបង្កប់ក្នុងអត្ថបទ។"

msgid "Returns text span metadata."
msgstr "ត្រឡប់ metadata នៃ text span។"

msgid "Returns the text span embedded object key."
msgstr "ត្រឡប់ key វត្ថុដែលបានបង្កប់ក្នុង text span។"

msgid "Returns the text span source text."
msgstr "ត្រឡប់អត្ថបទប្រភពនៃ text span។"

msgid ""
"Returns the text buffer source text, including object replacement characters."
msgstr "ត្រឡប់អត្ថបទប្រភព text buffer រួមទាំងតួអក្សរជំនួសវត្ថុ។"

msgid ""
"Changes text span font, font size, and OpenType features, without changing "
"the text."
msgstr "ផ្លាស់ប្តូរពុម្ពអក្សរ text span ទំហំពុម្ពអក្សរ និងមុខងារ OpenType ដោយមិនផ្លាស់ប្តូរអត្ថបទ។"

msgid "Adds text span and font to draw it to the text buffer."
msgstr "បន្ថែម text span និងពុម្ពអក្សរដើម្បីគូរវាទៅក្នុង text buffer។"

msgid "Clears text buffer (removes text and inline objects)."
msgstr "សម្អាត text buffer (ដកអត្ថបទ និង inline objects ចេញ)។"

msgid "Returns composite character position closest to the [param pos]."
msgstr "ត្រឡប់ទីតាំង composite character ដែលនៅជិត [param pos] បំផុត។"

msgid ""
"Draw shaped text into a canvas item at a given position, with [param color]. "
"[param pos] specifies the leftmost point of the baseline (for horizontal "
"layout) or topmost point of the baseline (for vertical layout). If [param "
"oversampling] is greater than zero, it is used as font oversampling factor, "
"otherwise viewport oversampling settings are used.\n"
"[param clip_l] and [param clip_r] are offsets relative to [param pos], going "
"to the right in horizontal layout and downward in vertical layout. If [param "
"clip_l] is not negative, glyphs starting before the offset are clipped. If "
"[param clip_r] is not negative, glyphs ending after the offset are clipped."
msgstr ""
"គូរ shaped text ទៅក្នុង canvas item នៅទីតាំងដែលបានផ្តល់ឱ្យ ជាមួយ [param color]។ [param "
"pos] បញ្ជាក់ពីចំណុចខាងឆ្វេងបំផុតនៃ baseline (សម្រាប់ប្លង់ផ្តេក) ឬចំណុចខាងលើបំផុតនៃ baseline "
"(សម្រាប់ប្លង់បញ្ឈរ)។ ប្រសិនបើ [param oversampling] ធំជាងសូន្យ វាត្រូវបានប្រើជាកត្តា "
"oversampling របស់ពុម្ពអក្សរ បើមិនដូច្នេះទេ ការកំណត់ oversampling របស់ viewport "
"ត្រូវបានប្រើ។\n"
"[param clip_l] និង [param clip_r] គឺជាគម្លាតធៀបនឹង [param pos] ទៅខាងស្តាំក្នុងប្លង់ផ្តេក "
"និងចុះក្រោមក្នុងប្លង់បញ្ឈរ។ ប្រសិនបើ [param clip_l] មិនអវិជ្ជមានទេ glyphs "
"ដែលចាប់ផ្តើមមុនគម្លាតនឹងត្រូវបានកាត់ត។ ប្រសិនបើ [param clip_r] មិនអវិជ្ជមានទេ glyphs "
"ដែលបញ្ចប់បន្ទាប់ពីគម្លាតនឹងត្រូវបានកាត់ត។"

msgid ""
"Draw the outline of the shaped text into a canvas item at a given position, "
"with [param color]. [param pos] specifies the leftmost point of the baseline "
"(for horizontal layout) or topmost point of the baseline (for vertical "
"layout). If [param oversampling] is greater than zero, it is used as font "
"oversampling factor, otherwise viewport oversampling settings are used.\n"
"[param clip_l] and [param clip_r] are offsets relative to [param pos], going "
"to the right in horizontal layout and downward in vertical layout. If [param "
"clip_l] is not negative, glyphs starting before the offset are clipped. If "
"[param clip_r] is not negative, glyphs ending after the offset are clipped."
msgstr ""
"គូរគ្រោងនៃ shaped text ទៅក្នុង canvas item នៅទីតាំងដែលបានផ្តល់ឱ្យ ជាមួយ [param color]។ "
"[param pos] បញ្ជាក់ពីចំណុចខាងឆ្វេងបំផុតនៃ baseline (សម្រាប់ប្លង់ផ្តេក) ឬចំណុចខាងលើបំផុតនៃ "
"baseline (សម្រាប់ប្លង់បញ្ឈរ)។ ប្រសិនបើ [param oversampling] ធំជាងសូន្យ "
"វាត្រូវបានប្រើជាកត្តា oversampling របស់ពុម្ពអក្សរ បើមិនដូច្នេះទេ ការកំណត់ oversampling របស់ "
"viewport ត្រូវបានប្រើ។\n"
"[param clip_l] និង [param clip_r] គឺជាគម្លាតធៀបនឹង [param pos] ទៅខាងស្តាំក្នុងប្លង់ផ្តេក "
"និងចុះក្រោមក្នុងប្លង់បញ្ឈរ។ ប្រសិនបើ [param clip_l] មិនអវិជ្ជមានទេ glyphs "
"ដែលចាប់ផ្តើមមុនគម្លាតនឹងត្រូវបានកាត់ត។ ប្រសិនបើ [param clip_r] មិនអវិជ្ជមានទេ glyphs "
"ដែលបញ្ចប់បន្ទាប់ពីគម្លាតនឹងត្រូវបានកាត់ត។"

msgid "Duplicates shaped text buffer."
msgstr "ចម្លង shaped text buffer។"

msgid "Adjusts text width to fit to specified width, returns new text width."
msgstr "កែសម្រួលទទឹងអត្ថបទឱ្យសមនឹងទទឹងដែលបានបញ្ជាក់ ត្រឡប់ទទឹងអត្ថបទថ្មី។"

msgid ""
"Returns the text ascent (number of pixels above the baseline for horizontal "
"layout or to the left of baseline for vertical).\n"
"[b]Note:[/b] Overall ascent can be higher than font ascent, if some glyphs "
"are displaced from the baseline."
msgstr ""
"ត្រឡប់ text ascent (ចំនួនភីកសែលនៅពីលើ baseline សម្រាប់ប្លង់ផ្តេក ឬនៅខាងឆ្វេងនៃ baseline "
"សម្រាប់ប្លង់បញ្ឈរ)។\n"
"[b]ចំណាំ៖[/b] Overall ascent អាចខ្ពស់ជាង font ascent ប្រសិនបើ glyphs "
"មួយចំនួនត្រូវបានផ្លាស់ទីពី baseline។"

msgid ""
"Returns shapes of the carets corresponding to the character offset [param "
"position] in the text. Returned caret shape is 1 pixel wide rectangle."
msgstr ""
"ត្រឡប់រាងនៃ carets ដែលត្រូវនឹង character offset [param position] នៅក្នុងអត្ថបទ។ រាង "
"caret ដែលបានត្រឡប់គឺជាចតុកោណកែងទទឹង 1 ភីកសែល។"

msgid "Returns array of the composite character boundaries."
msgstr "ត្រឡប់ array នៃព្រំដែន composite character។"

msgid "Returns ellipsis character used for text clipping."
msgstr "ត្រឡប់តួអក្សរ ellipsis ដែលប្រើសម្រាប់ការកាត់តអត្ថបទ។"

msgid ""
"Returns custom punctuation character list, used for word breaking. If set to "
"empty string, server defaults are used."
msgstr ""
"ត្រឡប់បញ្ជីតួអក្សរសញ្ញាវាក្យផ្ទាល់ខ្លួន ដែលប្រើសម្រាប់ការបំបែកពាក្យ។ ប្រសិនបើកំណត់ទៅជាខ្សែអក្សរទទេ "
"លំនាំដើមរបស់ម៉ាស៊ីនមេត្រូវបានប្រើ។"

msgid ""
"Returns the text descent (number of pixels below the baseline for horizontal "
"layout or to the right of baseline for vertical).\n"
"[b]Note:[/b] Overall descent can be higher than font descent, if some glyphs "
"are displaced from the baseline."
msgstr ""
"ត្រឡប់ text descent (ចំនួនភីកសែលនៅខាងក្រោម baseline សម្រាប់ប្លង់ផ្តេក ឬនៅខាងស្តាំនៃ "
"baseline សម្រាប់ប្លង់បញ្ឈរ)។\n"
"[b]ចំណាំ៖[/b] Overall descent អាចខ្ពស់ជាង font descent ប្រសិនបើ glyphs "
"មួយចំនួនត្រូវបានផ្លាស់ទីពី baseline។"

msgid "Returns direction of the text."
msgstr "ត្រឡប់ទិសដៅនៃអត្ថបទ។"

msgid "Returns dominant direction of in the range of text."
msgstr "ត្រឡប់ទិសដៅសំខាន់នៅក្នុងចន្លោះនៃអត្ថបទ។"

msgid "Returns number of glyphs in the ellipsis."
msgstr "ត្រឡប់ចំនួន glyphs នៅក្នុង ellipsis។"

msgid "Returns array of the glyphs in the ellipsis."
msgstr "ត្រឡប់ array នៃ glyphs នៅក្នុង ellipsis។"

msgid "Returns position of the ellipsis."
msgstr "ត្រឡប់ទីតាំងនៃ ellipsis។"

msgid "Returns number of glyphs in the buffer."
msgstr "ត្រឡប់ចំនួន glyphs នៅក្នុង buffer។"

msgid "Returns an array of glyphs in the visual order."
msgstr "ត្រឡប់ array នៃ glyphs តាមលំដាប់ដែលមើលឃើញ។"

msgid ""
"Returns composite character's bounds as offsets from the start of the line."
msgstr "ត្រឡប់ព្រំដែនរបស់ composite character ជាគម្លាតពីការចាប់ផ្តើមនៃជួរ។"

msgid "Returns direction of the text, inferred by the BiDi algorithm."
msgstr "ត្រឡប់ទិសដៅនៃអត្ថបទ ដែលបានសន្និដ្ឋានដោយក្បួនដោះស្រាយ BiDi។"

msgid "Breaks text to the lines and returns character ranges for each line."
msgstr "បំបែកអត្ថបទទៅជាជួរ ហើយត្រឡប់ចន្លោះតួអក្សរសម្រាប់ជួរនីមួយៗ។"

msgid ""
"Breaks text to the lines and columns. Returns character ranges for each "
"segment."
msgstr "បំបែកអត្ថបទទៅជាជួរ និងជួរឈរ។ ត្រឡប់ចន្លោះតួអក្សរសម្រាប់ segment នីមួយៗ។"

msgid "Returns the glyph index of the inline object."
msgstr "ត្រឡប់ glyph index នៃ inline object។"

msgid "Returns the character range of the inline object."
msgstr "ត្រឡប់ចន្លោះតួអក្សរនៃ inline object។"

msgid "Returns text orientation."
msgstr "ត្រឡប់ text orientation។"

msgid "Returns the parent buffer from which the substring originates."
msgstr "ត្រឡប់ buffer មេដែល substring មានប្រភពចេញពី đó។"

msgid ""
"Returns [code]true[/code] if text buffer is configured to display control "
"characters."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ text buffer ត្រូវបានកំណត់រចនាសម្ព័ន្ធដើម្បីបង្ហាញ control "
"characters។"

msgid ""
"Returns [code]true[/code] if text buffer is configured to display hexadecimal "
"codes in place of invalid characters.\n"
"[b]Note:[/b] If set to [code]false[/code], nothing is displayed in place of "
"invalid characters."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ text buffer "
"ត្រូវបានកំណត់រចនាសម្ព័ន្ធដើម្បីបង្ហាញកូដគោលដប់ប្រាំមួយជំនួសតួអក្សរមិនត្រឹមត្រូវ។\n"
"[b]ចំណាំ៖[/b] ប្រសិនបើកំណត់ទៅជា [code]false[/code] "
"គ្មានអ្វីត្រូវបានបង្ហាញជំនួសតួអក្សរមិនត្រឹមត្រូវទេ។"

msgid "Returns substring buffer character range in the parent buffer."
msgstr "ត្រឡប់ចន្លោះតួអក្សរ buffer substring នៅក្នុង buffer មេ។"

msgid "Returns selection rectangles for the specified character range."
msgstr "ត្រឡប់ចតុកោណកែងជ្រើសរើសសម្រាប់ចន្លោះតួអក្សរដែលបានបញ្ជាក់។"

msgid "Returns size of the text."
msgstr "ត្រឡប់ទំហំនៃអត្ថបទ។"

msgid "Returns extra spacing added between glyphs or lines in pixels."
msgstr "ត្រឡប់គម្លាតបន្ថែមដែលបានបន្ថែមរវាង glyphs ឬជួរគិតជាភីកសែល។"

msgid "Returns the position of the overrun trim."
msgstr "ត្រឡប់ទីតាំងនៃការកាត់ត overrun។"

msgid ""
"Breaks text into words and returns array of character ranges. Use [param "
"grapheme_flags] to set what characters are used for breaking."
msgstr ""
"បំបែកអត្ថបទទៅជាពាក្យ ហើយត្រឡប់ array នៃចន្លោះតួអក្សរ។ ប្រើ [param grapheme_flags] "
"ដើម្បីកំណត់ថាតួអក្សរណាខ្លះត្រូវបានប្រើសម្រាប់ការបំបែក។"

msgid ""
"Returns [code]true[/code] if text buffer contains any visible characters."
msgstr "ត្រឡប់ [code]true[/code] ប្រសិនបើ text buffer ផ្ទុកតួអក្សរដែលមើលឃើញណាមួយ។"

msgid ""
"Returns grapheme index at the specified pixel offset at the baseline, or "
"[code]-1[/code] if none is found."
msgstr ""
"ត្រឡប់ grapheme index នៅ pixel offset ដែលបានបញ្ជាក់នៅត្រង់ baseline ឬ [code]-1[/"
"code] ប្រសិនបើរកមិនឃើញ។"

msgid "Returns [code]true[/code] if buffer is successfully shaped."
msgstr "ត្រឡប់ [code]true[/code] ប្រសិនបើ buffer ត្រូវបាន shaped ដោយជោគជ័យ។"

msgid "Returns composite character end position closest to the [param pos]."
msgstr "ត្រឡប់ទីតាំងបញ្ចប់ composite character ដែលនៅជិត [param pos] បំផុត។"

msgid "Returns grapheme end position closest to the [param pos]."
msgstr "ត្រឡប់ទីតាំងបញ្ចប់ grapheme ដែលនៅជិត [param pos] បំផុត។"

msgid "Trims text if it exceeds the given width."
msgstr "កាត់តអត្ថបទ ប្រសិនបើវាលើសពីទទឹងដែលបានផ្តល់ឱ្យ។"

msgid "Returns composite character start position closest to the [param pos]."
msgstr "ត្រឡប់ទីតាំងចាប់ផ្តើម composite character ដែលនៅជិត [param pos] បំផុត។"

msgid "Returns grapheme start position closest to the [param pos]."
msgstr "ត្រឡប់ទីតាំងចាប់ផ្តើម grapheme ដែលនៅជិត [param pos] បំផុត។"

msgid "Sets ellipsis character used for text clipping."
msgstr "កំណត់តួអក្សរ ellipsis ដែលប្រើសម្រាប់ការកាត់តអត្ថបទ។"

msgid ""
"Sets custom punctuation character list, used for word breaking. If set to "
"empty string, server defaults are used."
msgstr ""
"កំណត់បញ្ជីតួអក្សរសញ្ញាវាក្យផ្ទាល់ខ្លួន ដែលប្រើសម្រាប់ការបំបែកពាក្យ។ ប្រសិនបើកំណត់ទៅជាខ្សែអក្សរទទេ "
"លំនាំដើមរបស់ម៉ាស៊ីនមេត្រូវបានប្រើ។"

msgid ""
"Sets desired text direction. If set to [constant DIRECTION_AUTO], direction "
"will be detected based on the buffer contents and current locale.\n"
"[b]Note:[/b] Direction is ignored if server does not support [constant "
"FEATURE_BIDI_LAYOUT] feature (supported by [TextServerAdvanced])."
msgstr ""
"កំណត់ទិសដៅអត្ថបទដែលចង់បាន។ ប្រសិនបើកំណត់ទៅជា [constant DIRECTION_AUTO] "
"ទិសដៅនឹងត្រូវបានរកឃើញដោយផ្អែកលើខ្លឹមសារ buffer និង locale បច្ចុប្បន្ន។\n"
"[b]ចំណាំ៖[/b] Direction ត្រូវបានមិនអើពើ ប្រសិនបើម៉ាស៊ីនមេមិនគាំទ្រមុខងារ [constant "
"FEATURE_BIDI_LAYOUT] (គាំទ្រដោយ [TextServerAdvanced])។"

msgid ""
"Sets desired text orientation.\n"
"[b]Note:[/b] Orientation is ignored if server does not support [constant "
"FEATURE_VERTICAL_LAYOUT] feature (supported by [TextServerAdvanced])."
msgstr ""
"កំណត់ text orientation ដែលចង់បាន។\n"
"[b]ចំណាំ៖[/b] Orientation ត្រូវបានមិនអើពើ ប្រសិនបើម៉ាស៊ីនមេមិនគាំទ្រមុខងារ [constant "
"FEATURE_VERTICAL_LAYOUT] (គាំទ្រដោយ [TextServerAdvanced])។"

msgid "If set to [code]true[/code] text buffer will display control characters."
msgstr "ប្រសិនបើកំណត់ទៅជា [code]true[/code] text buffer នឹងបង្ហាញ control characters។"

msgid ""
"If set to [code]true[/code] text buffer will display invalid characters as "
"hexadecimal codes, otherwise nothing is displayed."
msgstr ""
"ប្រសិនបើកំណត់ទៅជា [code]true[/code] text buffer "
"នឹងបង្ហាញតួអក្សរមិនត្រឹមត្រូវជាកូដគោលដប់ប្រាំមួយ បើមិនដូច្នេះទេគ្មានអ្វីត្រូវបានបង្ហាញទេ។"

msgid "Sets extra spacing added between glyphs or lines in pixels."
msgstr "កំណត់គម្លាតបន្ថែមដែលបានបន្ថែមរវាង glyphs ឬជួរគិតជាភីកសែល។"

msgid ""
"Shapes buffer if it's not shaped. Returns [code]true[/code] if the string is "
"shaped successfully.\n"
"[b]Note:[/b] It is not necessary to call this function manually, buffer will "
"be shaped automatically as soon as any of its output data is requested."
msgstr ""
"Shapes buffer ប្រសិនបើវាមិនទាន់ shaped។ ត្រឡប់ [code]true[/code] "
"ប្រសិនបើខ្សែអក្សរត្រូវបាន shaped ដោយជោគជ័យ។\n"
"[b]ចំណាំ៖[/b] មិនចាំបាច់ហៅអនុគមន៍នេះដោយដៃទេ buffer នឹងត្រូវបាន shaped "
"ដោយស្វ័យប្រវត្តិភ្លាមៗនៅពេលដែលទិន្នន័យ output ណាមួយរបស់វាត្រូវបានស្នើសុំ។"

msgid "Returns text glyphs in the logical order."
msgstr "ត្រឡប់ text glyphs តាមលំដាប់ឡូជីខល។"

msgid ""
"Returns text buffer for the substring of the text in the [param shaped] text "
"buffer (including inline objects)."
msgstr ""
"ត្រឡប់ text buffer សម្រាប់ substring នៃអត្ថបទនៅក្នុង [param shaped] text buffer "
"(រួមទាំង inline objects)។"

msgid "Aligns shaped text to the given tab-stops."
msgstr "តម្រឹម shaped text ទៅកាន់ tab-stops ដែលបានផ្តល់ឱ្យ។"

msgid ""
"Returns [code]true[/code] if [param string] is likely to be an attempt at "
"confusing the reader.\n"
"[b]Note:[/b] Always returns [code]false[/code] if the server does not support "
"the [constant FEATURE_UNICODE_SECURITY] feature."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ [param string] "
"ទំនងជាការព្យាយាមធ្វើឱ្យអ្នកអានមានការភាន់ច្រឡំ។\n"
"[b]ចំណាំ៖[/b] តែងតែត្រឡប់ [code]false[/code] ប្រសិនបើម៉ាស៊ីនមេមិនគាំទ្រមុខងារ [constant "
"FEATURE_UNICODE_SECURITY]។"

msgid ""
"Returns array of the composite character boundaries.\n"
"[codeblock]\n"
"var ts = TextServerManager.get_primary_interface()\n"
"print(ts.string_get_character_breaks(\"Test ❤️‍🔥 Test\")) # Prints [1, 2, 3, "
"4, 5, 9, 10, 11, 12, 13, 14]\n"
"[/codeblock]"
msgstr ""
"ត្រឡប់ array នៃព្រំដែន composite character។\n"
"[codeblock]\n"
"var ts = TextServerManager.get_primary_interface()\n"
"print(ts.string_get_character_breaks(\"Test ❤️‍🔥 Test\")) # Prints [1, 2, 3, "
"4, 5, 9, 10, 11, 12, 13, 14]\n"
"[/codeblock]"

msgid ""
"Returns an array of the word break boundaries. Elements in the returned array "
"are the offsets of the start and end of words. Therefore the length of the "
"array is always even.\n"
"When [param chars_per_line] is greater than zero, line break boundaries are "
"returned instead.\n"
"[codeblock]\n"
"var ts = TextServerManager.get_primary_interface()\n"
"# Corresponds to the substrings \"The\", \"Godot\", \"Engine\", and \"4\".\n"
"print(ts.string_get_word_breaks(\"The Godot Engine, 4\")) # Prints [0, 3, 4, "
"9, 10, 16, 18, 19]\n"
"# Corresponds to the substrings \"The\", \"Godot\", \"Engin\", and \"e, 4\".\n"
"print(ts.string_get_word_breaks(\"The Godot Engine, 4\", \"en\", 5)) # Prints "
"[0, 3, 4, 9, 10, 15, 15, 19]\n"
"# Corresponds to the substrings \"The Godot\" and \"Engine, 4\".\n"
"print(ts.string_get_word_breaks(\"The Godot Engine, 4\", \"en\", 10)) # "
"Prints [0, 9, 10, 19]\n"
"[/codeblock]"
msgstr ""
"ត្រឡប់ array នៃព្រំដែនបំបែកពាក្យ។ ធាតុនៅក្នុង array ដែលបានត្រឡប់គឺជាគម្លាតនៃការចាប់ផ្តើម "
"និងការបញ្ចប់នៃពាក្យ។ ដូច្នេះប្រវែងនៃ array តែងតែជាលេខគូ។\n"
"នៅពេលដែល [param chars_per_line] ធំជាងសូន្យ ព្រំដែនបំបែកជួរត្រូវបានត្រឡប់ជំនួសវិញ។\n"
"[codeblock]\n"
"var ts = TextServerManager.get_primary_interface()\n"
"# Corresponds to the substrings \"The\", \"Godot\", \"Engine\", and \"4\".\n"
"print(ts.string_get_word_breaks(\"The Godot Engine, 4\")) # Prints [0, 3, 4, "
"9, 10, 16, 18, 19]\n"
"# Corresponds to the substrings \"The\", \"Godot\", \"Engin\", and \"e, 4\".\n"
"print(ts.string_get_word_breaks(\"The Godot Engine, 4\", \"en\", 5)) # Prints "
"[0, 3, 4, 9, 10, 15, 15, 19]\n"
"# Corresponds to the substrings \"The Godot\" and \"Engine, 4\".\n"
"print(ts.string_get_word_breaks(\"The Godot Engine, 4\", \"en\", 10)) # "
"Prints [0, 9, 10, 19]\n"
"[/codeblock]"

msgid ""
"Returns the string converted to [code]lowercase[/code].\n"
"[b]Note:[/b] Casing is locale dependent and context sensitive if server "
"support [constant FEATURE_CONTEXT_SENSITIVE_CASE_CONVERSION] feature "
"(supported by [TextServerAdvanced]).\n"
"[b]Note:[/b] The result may be longer or shorter than the original."
msgstr ""
"ត្រឡប់ខ្សែអក្សរដែលបានបម្លែងទៅជា [code]lowercase[/code]។\n"
"[b]ចំណាំ៖[/b] Casing អាស្រ័យលើ locale និងបរិបទ ប្រសិនបើម៉ាស៊ីនមេគាំទ្រមុខងារ [constant "
"FEATURE_CONTEXT_SENSITIVE_CASE_CONVERSION] (គាំទ្រដោយ [TextServerAdvanced])។\n"
"[b]ចំណាំ៖[/b] លទ្ធផលអាចវែងជាង ឬខ្លីជាងដើម។"

msgid ""
"Returns the string converted to [code]Title Case[/code].\n"
"[b]Note:[/b] Casing is locale dependent and context sensitive if server "
"support [constant FEATURE_CONTEXT_SENSITIVE_CASE_CONVERSION] feature "
"(supported by [TextServerAdvanced]).\n"
"[b]Note:[/b] The result may be longer or shorter than the original."
msgstr ""
"ត្រឡប់ខ្សែអក្សរដែលបានបម្លែងទៅជា [code]Title Case[/code]។\n"
"[b]ចំណាំ៖[/b] Casing អាស្រ័យលើ locale និងបរិបទ ប្រសិនបើម៉ាស៊ីនមេគាំទ្រមុខងារ [constant "
"FEATURE_CONTEXT_SENSITIVE_CASE_CONVERSION] (គាំទ្រដោយ [TextServerAdvanced])។\n"
"[b]ចំណាំ៖[/b] លទ្ធផលអាចវែងជាង ឬខ្លីជាងដើម។"

msgid ""
"Returns the string converted to [code]UPPERCASE[/code].\n"
"[b]Note:[/b] Casing is locale dependent and context sensitive if server "
"support [constant FEATURE_CONTEXT_SENSITIVE_CASE_CONVERSION] feature "
"(supported by [TextServerAdvanced]).\n"
"[b]Note:[/b] The result may be longer or shorter than the original."
msgstr ""
"ត្រឡប់ខ្សែអក្សរដែលបានបម្លែងទៅជា [code]UPPERCASE[/code]។\n"
"[b]ចំណាំ៖[/b] Casing អាស្រ័យលើ locale និងបរិបទ ប្រសិនបើម៉ាស៊ីនមេគាំទ្រមុខងារ [constant "
"FEATURE_CONTEXT_SENSITIVE_CASE_CONVERSION] (គាំទ្រដោយ [TextServerAdvanced])។\n"
"[b]ចំណាំ៖[/b] លទ្ធផលអាចវែងជាង ឬខ្លីជាងដើម។"

msgid ""
"Strips diacritics from the string.\n"
"[b]Note:[/b] The result may be longer or shorter than the original."
msgstr ""
"ដកសញ្ញា diacritics ចេញពីខ្សែអក្សរ។\n"
"[b]ចំណាំ៖[/b] លទ្ធផលអាចវែងជាង ឬខ្លីជាងដើម។"

msgid ""
"Converts the given OpenType tag to the readable name of a feature, variation, "
"script, or language."
msgstr ""
"បម្លែង OpenType tag ដែលបានផ្តល់ឱ្យ ទៅជាឈ្មោះដែលអាចអានបាននៃមុខងារ variation script "
"ឬភាសា។"

msgid "Font glyphs are rasterized as 1-bit bitmaps."
msgstr "Font glyphs ត្រូវបាន rasterized ជា 1-bit bitmaps។"

msgid "Font glyphs are rasterized as 8-bit grayscale anti-aliased bitmaps."
msgstr "Font glyphs ត្រូវបាន rasterized ជា 8-bit grayscale anti-aliased bitmaps។"

msgid ""
"Font glyphs are rasterized for LCD screens.\n"
"LCD subpixel layout is determined by the value of the [member "
"ProjectSettings.gui/theme/lcd_subpixel_layout] setting.\n"
"LCD subpixel anti-aliasing mode is suitable only for rendering horizontal, "
"unscaled text in 2D."
msgstr ""
"Font glyphs ត្រូវបាន rasterized សម្រាប់អេក្រង់ LCD។\n"
"ប្លង់ subpixel LCD ត្រូវបានកំណត់ដោយតម្លៃនៃការកំណត់ [member ProjectSettings.gui/theme/"
"lcd_subpixel_layout]។\n"
"របៀប LCD subpixel anti-aliasing គឺសមស្របតែសម្រាប់ការ render អត្ថបទផ្តេក "
"ដែលមិនបានធ្វើមាត្រដ្ឋានក្នុង 2D ប៉ុណ្ណោះ។"

msgid ""
"Unknown or unsupported subpixel layout, LCD subpixel antialiasing is disabled."
msgstr "ប្លង់ subpixel មិនស្គាល់ ឬមិនគាំទ្រ LCD subpixel antialiasing ត្រូវបានបិទ។"

msgid "Horizontal RGB subpixel layout."
msgstr "ប្លង់ subpixel RGB ផ្តេក។"

msgid "Horizontal BGR subpixel layout."
msgstr "ប្លង់ subpixel BGR ផ្តេក។"

msgid "Vertical RGB subpixel layout."
msgstr "ប្លង់ subpixel RGB បញ្ឈរ។"

msgid "Vertical BGR subpixel layout."
msgstr "ប្លង់ subpixel BGR បញ្ឈរ។"

msgid "Represents the size of the [enum FontLCDSubpixelLayout] enum."
msgstr "តំណាងឱ្យទំហំនៃ [enum FontLCDSubpixelLayout] enum។"

msgid "Text direction is determined based on contents and current locale."
msgstr "ទិសដៅអត្ថបទត្រូវបានកំណត់ដោយផ្អែកលើខ្លឹមសារ និង locale បច្ចុប្បន្ន។"

msgid "Text is written from left to right."
msgstr "អត្ថបទត្រូវបានសរសេរពីឆ្វេងទៅស្តាំ។"

msgid "Text is written from right to left."
msgstr "អត្ថបទត្រូវបានសរសេរពីស្តាំទៅឆ្វេង។"

msgid ""
"Text writing direction is the same as base string writing direction. Used for "
"BiDi override only."
msgstr ""
"ទិសដៅសរសេរអត្ថបទគឺដូចគ្នានឹងទិសដៅសរសេរខ្សែអក្សរគោល។ ប្រើសម្រាប់តែការសរសេរជាន់ BiDi ប៉ុណ្ណោះ។"

msgid "Text is written horizontally."
msgstr "អត្ថបទត្រូវបានសរសេរជាផ្តេក។"

msgid ""
"Left to right text is written vertically from top to bottom.\n"
"Right to left text is written vertically from bottom to top."
msgstr ""
"អត្ថបទពីឆ្វេងទៅស្តាំត្រូវបានសរសេរជាបញ្ឈរពីលើចុះក្រោម។\n"
"អត្ថបទពីស្តាំទៅឆ្វេងត្រូវបានសរសេរជាបញ្ឈរពីក្រោមឡើងលើ។"

msgid "Do not justify text."
msgstr "កុំតម្រឹមអត្ថបទ (justify)។"

msgid "Justify text by adding and removing kashidas."
msgstr "តម្រឹមអត្ថបទដោយបន្ថែម និងដក kashidas។"

msgid "Justify text by changing width of the spaces between the words."
msgstr "តម្រឹមអត្ថបទដោយផ្លាស់ប្តូរទទឹងនៃចន្លោះរវាងពាក្យ។"

msgid "Remove trailing and leading spaces from the justified text."
msgstr "ដកចន្លោះនៅខាងចុង និងខាងដើមចេញពីអត្ថបទដែលបានតម្រឹម។"

msgid "Only apply justification to the part of the text after the last tab."
msgstr "អនុវត្តការតម្រឹមតែទៅលើផ្នែកនៃអត្ថបទបន្ទាប់ពី tab ចុងក្រោយប៉ុណ្ណោះ។"

msgid "Apply justification to the trimmed line with ellipsis."
msgstr "អនុវត្តការតម្រឹមទៅលើជួរដែលបានកាត់តជាមួយ ellipsis។"

msgid "Do not apply justification to the last line of the paragraph."
msgstr "កុំអនុវត្តការតម្រឹមទៅលើជួរចុងក្រោយនៃកថាខណ្ឌ។"

msgid ""
"Do not apply justification to the last line of the paragraph with visible "
"characters (takes precedence over [constant JUSTIFICATION_SKIP_LAST_LINE])."
msgstr ""
"កុំអនុវត្តការតម្រឹមទៅលើជួរចុងក្រោយនៃកថាខណ្ឌដែលមានតួអក្សរមើលឃើញ (មានអាទិភាពលើ [constant "
"JUSTIFICATION_SKIP_LAST_LINE])។"

msgid ""
"Always apply justification to the paragraphs with a single line ([constant "
"JUSTIFICATION_SKIP_LAST_LINE] and [constant "
"JUSTIFICATION_SKIP_LAST_LINE_WITH_VISIBLE_CHARS] are ignored)."
msgstr ""
"តែងតែអនុវត្តការតម្រឹមទៅលើកថាខណ្ឌដែលមានជួរតែមួយ ([constant "
"JUSTIFICATION_SKIP_LAST_LINE] និង [constant "
"JUSTIFICATION_SKIP_LAST_LINE_WITH_VISIBLE_CHARS] ត្រូវបានមិនអើពើ)។"

msgid "Autowrap is disabled."
msgstr "Autowrap ត្រូវបានបិទ។"

msgid ""
"Wraps the text inside the node's bounding rectangle by allowing to break "
"lines at arbitrary positions, which is useful when very limited space is "
"available."
msgstr ""
"រុំអត្ថបទនៅខាងក្នុងចតុកោណកែងកំណត់ព្រំដែនរបស់ node ដោយអនុញ្ញាតឱ្យបំបែកជួរនៅទីតាំងណាមួយក៏បាន "
"ដែលមានប្រយោជន៍នៅពេលដែលមានទំហំកំណត់ខ្លាំង។"

msgid ""
"Wraps the text inside the node's bounding rectangle by soft-breaking between "
"words."
msgstr ""
"រុំអត្ថបទនៅខាងក្នុងចតុកោណកែងកំណត់ព្រំដែនរបស់ node ដោយបំបែកទន់ (soft-breaking) រវាងពាក្យ។"

msgid ""
"Behaves similarly to [constant AUTOWRAP_WORD], but force-breaks a word if "
"that single word does not fit in one line."
msgstr ""
"មានឥរិយាបថស្រដៀងនឹង [constant AUTOWRAP_WORD] ដែរ ប៉ុន្តែបង្ខំឱ្យបំបែកពាក្យ "
"ប្រសិនបើពាក្យតែមួយនោះមិនអាចដាក់ក្នុងជួរតែមួយបាន។"

msgid "Do not break the line."
msgstr "កុំបំបែកជួរ។"

msgid ""
"Break the line at the line mandatory break characters (e.g. [code]\"\\n\"[/"
"code])."
msgstr "បំបែកជួរនៅត្រង់តួអក្សរបំបែកជួរដែលចាំបាច់ (ឧ. [code]\"\\n\"[/code])។"

msgid "Break the line between the words."
msgstr "បំបែកជួររវាងពាក្យ។"

msgid "Break the line between any unconnected graphemes."
msgstr "បំបែកជួររវាង graphemes ដែលមិនបានភ្ជាប់ណាមួយ។"

msgid ""
"Should be used only in conjunction with [constant BREAK_WORD_BOUND], break "
"the line between any unconnected graphemes, if it's impossible to break it "
"between the words."
msgstr ""
"គួរតែត្រូវបានប្រើតែជាមួយ [constant BREAK_WORD_BOUND] បំបែកជួររវាង graphemes "
"ដែលមិនបានភ្ជាប់ណាមួយ ប្រសិនបើវាមិនអាចទៅរួចក្នុងការបំបែកវារវាងពាក្យ។"

msgid ""
"Use [code]BREAK_TRIM_START_EDGE_SPACES | BREAK_TRIM_END_EDGE_SPACES[/code] "
"instead."
msgstr ""
"សូមប្រើ [code]BREAK_TRIM_START_EDGE_SPACES | BREAK_TRIM_END_EDGE_SPACES[/code] "
"ជំនួសវិញ។"

msgid "Remove edge spaces from the broken line segments."
msgstr "ដកចន្លោះគែមចេញពី segment ជួរដែលបានបំបែក។"

msgid ""
"Subtract first line indentation width from all lines after the first one."
msgstr "ដកទទឹងការចូលបន្ទាត់ (indentation) នៃជួរដំបូងចេញពីជួរទាំងអស់បន្ទាប់ពីជួរដំបូង។"

msgid ""
"Remove spaces and line break characters from the start of broken line "
"segments.\n"
"E.g, after line breaking, the second segment of the following text "
"[code]test  \\n  next[/code], is [code]next[/code] if the flag is set, and "
"[code]  next[/code] if it is not."
msgstr ""
"ដកចន្លោះ និងតួអក្សរបំបែកជួរចេញពីការចាប់ផ្តើមនៃ segment ជួរដែលបានបំបែក។\n"
"ឧ. បន្ទាប់ពីបំបែកជួរ segment ទីពីរនៃអត្ថបទខាងក្រោម [code]test  \\n  next[/code] គឺ "
"[code]next[/code] ប្រសិនបើ flag ត្រូវបានកំណត់ ហើយ [code]  next[/code] "
"ប្រសិនបើវាមិនត្រូវបានកំណត់។"

msgid ""
"Remove spaces and line break characters from the end of broken line "
"segments.\n"
"E.g, after line breaking, the first segment of the following text [code]test  "
"\\n  next[/code], is [code]test[/code] if the flag is set, and [code]test  "
"\\n[/code] if it is not."
msgstr ""
"ដកចន្លោះ និងតួអក្សរបំបែកជួរចេញពីចុងបញ្ចប់នៃ segment ជួរដែលបានបំបែក។\n"
"ឧ. បន្ទាប់ពីបំបែកជួរ segment ដំបូងនៃអត្ថបទខាងក្រោម [code]test  \\n  next[/code] គឺ "
"[code]test[/code] ប្រសិនបើ flag ត្រូវបានកំណត់ ហើយ [code]test  \\n[/code] "
"ប្រសិនបើវាមិនត្រូវបានកំណត់។"

msgid ""
"Trims text before the shaping. e.g, increasing [member "
"Label.visible_characters] or [member RichTextLabel.visible_characters] value "
"is visually identical to typing the text.\n"
"[b]Note:[/b] In this mode, trimmed text is not processed at all. It is not "
"accounted for in line breaking and size calculations."
msgstr ""
"កាត់តអត្ថបទមុនពេល shaping។ ឧ. ការបង្កើនតម្លៃ [member Label.visible_characters] ឬ "
"[member RichTextLabel.visible_characters] គឺមើលទៅដូចគ្នានឹងការវាយអត្ថបទដែរ។\n"
"[b]ចំណាំ៖[/b] នៅក្នុងរបៀបនេះ អត្ថបទដែលបានកាត់តមិនត្រូវបានដំណើរការទាល់តែសោះ។ "
"វាមិនត្រូវបានរាប់បញ្ចូលក្នុងការបំបែកជួរ និងការគណនាទំហំទេ។"

msgid ""
"Displays glyphs that are mapped to the first [member "
"Label.visible_characters] or [member RichTextLabel.visible_characters] "
"characters from the beginning of the text."
msgstr ""
"បង្ហាញ glyphs ដែលត្រូវបាន map ទៅកាន់តួអក្សរ [member Label.visible_characters] ឬ "
"[member RichTextLabel.visible_characters] ដំបូងគេពីការចាប់ផ្តើមនៃអត្ថបទ។"

msgid ""
"Displays [member Label.visible_ratio] or [member RichTextLabel.visible_ratio] "
"glyphs, starting from the left or from the right, depending on [member "
"Control.layout_direction] value."
msgstr ""
"បង្ហាញ glyphs [member Label.visible_ratio] ឬ [member "
"RichTextLabel.visible_ratio] ដោយចាប់ផ្តើមពីឆ្វេង ឬពីស្តាំ អាស្រ័យលើតម្លៃ [member "
"Control.layout_direction]។"

msgid ""
"Displays [member Label.visible_ratio] or [member RichTextLabel.visible_ratio] "
"glyphs, starting from the left."
msgstr ""
"បង្ហាញ glyphs [member Label.visible_ratio] ឬ [member "
"RichTextLabel.visible_ratio] ដោយចាប់ផ្តើមពីខាងឆ្វេង។"

msgid ""
"Displays [member Label.visible_ratio] or [member RichTextLabel.visible_ratio] "
"glyphs, starting from the right."
msgstr ""
"បង្ហាញ glyphs [member Label.visible_ratio] ឬ [member "
"RichTextLabel.visible_ratio] ដោយចាប់ផ្តើមពីខាងស្តាំ។"

msgid "No text trimming is performed."
msgstr "គ្មានការកាត់តអត្ថបទត្រូវបានអនុវត្តទេ។"

msgid "Trims the text per character."
msgstr "កាត់តអត្ថបទក្នុងមួយតួអក្សរ។"

msgid "Trims the text per word."
msgstr "កាត់តអត្ថបទក្នុងមួយពាក្យ។"

msgid ""
"Trims the text per character and adds an ellipsis to indicate that parts are "
"hidden if trimmed text is 6 characters or longer."
msgstr ""
"កាត់តអត្ថបទក្នុងមួយតួអក្សរ ហើយបន្ថែម ellipsis ដើម្បីបង្ហាញថាផ្នែកខ្លះត្រូវបានលាក់ "
"ប្រសិនបើអត្ថបទដែលបានកាត់តមាន 6 តួអក្សរ ឬវែងជាងនេះ។"

msgid ""
"Trims the text per word and adds an ellipsis to indicate that parts are "
"hidden if trimmed text is 6 characters or longer."
msgstr ""
"កាត់តអត្ថបទក្នុងមួយពាក្យ ហើយបន្ថែម ellipsis ដើម្បីបង្ហាញថាផ្នែកខ្លះត្រូវបានលាក់ "
"ប្រសិនបើអត្ថបទដែលបានកាត់តមាន 6 តួអក្សរ ឬវែងជាងនេះ។"

msgid ""
"Trims the text per character and adds an ellipsis to indicate that parts are "
"hidden regardless of trimmed text length."
msgstr ""
"កាត់តអត្ថបទក្នុងមួយតួអក្សរ ហើយបន្ថែម ellipsis ដើម្បីបង្ហាញថាផ្នែកខ្លះត្រូវបានលាក់ "
"ដោយមិនគិតពីប្រវែងអត្ថបទដែលបានកាត់ត។"

msgid ""
"Trims the text per word and adds an ellipsis to indicate that parts are "
"hidden regardless of trimmed text length."
msgstr ""
"កាត់តអត្ថបទក្នុងមួយពាក្យ ហើយបន្ថែម ellipsis ដើម្បីបង្ហាញថាផ្នែកខ្លះត្រូវបានលាក់ "
"ដោយមិនគិតពីប្រវែងអត្ថបទដែលបានកាត់ត។"

msgid "No trimming is performed."
msgstr "គ្មានការកាត់តត្រូវបានអនុវត្តទេ។"

msgid "Trims the text when it exceeds the given width."
msgstr "កាត់តអត្ថបទនៅពេលដែលវាលើសពីទទឹងដែលបានផ្តល់ឱ្យ។"

msgid "Trims the text per word instead of per grapheme."
msgstr "កាត់តអត្ថបទក្នុងមួយពាក្យ ជំនួសឱ្យក្នុងមួយ grapheme។"

msgid "Determines whether an ellipsis should be added at the end of the text."
msgstr "កំណត់ថាតើ ellipsis គួរត្រូវបានបន្ថែមនៅចុងបញ្ចប់នៃអត្ថបទឬអត់។"

msgid ""
"Determines whether the ellipsis at the end of the text is enforced and may "
"not be hidden."
msgstr "កំណត់ថាតើ ellipsis នៅចុងបញ្ចប់នៃអត្ថបទត្រូវបានបង្ខំ ហើយមិនអាចលាក់បានឬអត់។"

msgid ""
"Accounts for the text being justified before attempting to trim it (see [enum "
"JustificationFlag])."
msgstr ""
"គិតគូរពីអត្ថបទដែលកំពុងត្រូវបានតម្រឹម មុនពេលព្យាយាមកាត់តវា (សូមមើល [enum JustificationFlag])។"

msgid ""
"Determines whether the ellipsis should be added regardless of the string "
"length, otherwise it is added only if the string is 6 characters or longer."
msgstr ""
"កំណត់ថាតើ ellipsis គួរត្រូវបានបន្ថែមដោយមិនគិតពីប្រវែងខ្សែអក្សរឬអត់ "
"បើមិនដូច្នេះទេវាត្រូវបានបន្ថែមតែនៅពេលដែលខ្សែអក្សរមាន 6 តួអក្សរ ឬវែងជាងនេះប៉ុណ្ណោះ។"

msgid "Grapheme is supported by the font, and can be drawn."
msgstr "Grapheme ត្រូវបានគាំទ្រដោយពុម្ពអក្សរ ហើយអាចត្រូវបានគូរ។"

msgid "Grapheme is part of right-to-left or bottom-to-top run."
msgstr "Grapheme គឺជាផ្នែកមួយនៃការរត់ពីស្តាំទៅឆ្វេង ឬពីក្រោមឡើងលើ។"

msgid ""
"Grapheme is not part of source text, it was added by justification process."
msgstr ""
"Grapheme មិនមែនជាផ្នែកនៃអត្ថបទប្រភពទេ វាត្រូវបានបន្ថែមដោយដំណើរការតម្រឹម (justification "
"process)។"

msgid "Grapheme is whitespace."
msgstr "Grapheme គឺជាចន្លោះ (whitespace)។"

msgid "Grapheme is mandatory break point (e.g. [code]\"\\n\"[/code])."
msgstr "Grapheme គឺជាចំណុចបំបែកដែលចាំបាច់ (ឧ. [code]\"\\n\"[/code])។"

msgid "Grapheme is optional break point (e.g. space)."
msgstr "Grapheme គឺជាចំណុចបំបែកជាជម្រើស (ឧ. ចន្លោះ)។"

msgid "Grapheme is the tabulation character."
msgstr "Grapheme គឺជាតួអក្សរ tabulation។"

msgid "Grapheme is kashida."
msgstr "Grapheme គឺជា kashida។"

msgid "Grapheme is punctuation character."
msgstr "Grapheme គឺជាតួអក្សរសញ្ញាវាក្យ។"

msgid "Grapheme is underscore character."
msgstr "Grapheme គឺជាតួអក្សរ underscore។"

msgid ""
"Grapheme is connected to the previous grapheme. Breaking line before this "
"grapheme is not safe."
msgstr ""
"Grapheme ត្រូវបានភ្ជាប់ទៅនឹង grapheme មុន។ ការបំបែកជួរមុន grapheme នេះមិនមានសុវត្ថិភាពទេ។"

msgid "It is safe to insert a U+0640 before this grapheme for elongation."
msgstr "វាមានសុវត្ថិភាពក្នុងការបញ្ចូល U+0640 មុន grapheme នេះសម្រាប់ការពន្លាត។"

msgid "Grapheme is an object replacement character for the embedded object."
msgstr "Grapheme គឺជាតួអក្សរជំនួសវត្ថុសម្រាប់វត្ថុដែលបានបង្កប់។"

msgid "Grapheme is a soft hyphen."
msgstr "Grapheme គឺជា soft hyphen។"

msgid "Disables font hinting (smoother but less crisp)."
msgstr "បិទ font hinting (រលូនជាងមុន ប៉ុន្តែមិនសូវច្បាស់)។"

msgid "Use the light font hinting mode."
msgstr "ប្រើរបៀប font hinting ស្រាល (light)។"

msgid ""
"Use the default font hinting mode (crisper but less smooth).\n"
"[b]Note:[/b] This hinting mode changes both horizontal and vertical glyph "
"metrics. If applied to monospace font, some glyphs might have different width."
msgstr ""
"ប្រើរបៀប font hinting លំនាំដើម (ច្បាស់ជាងមុន ប៉ុន្តែមិនសូវរលូន)។\n"
"[b]ចំណាំ៖[/b] របៀប hinting នេះផ្លាស់ប្តូរទាំងរង្វាស់ glyph ផ្តេក និងបញ្ឈរ។ "
"ប្រសិនបើអនុវត្តទៅលើពុម្ពអក្សរ monospace glyphs មួយចំនួនអាចមានទទឹងខុសគ្នា។"

msgid ""
"Glyph horizontal position is rounded to the whole pixel size, each glyph is "
"rasterized once."
msgstr ""
"ទីតាំងផ្តេករបស់ Glyph ត្រូវបានបង្គត់ទៅជាទំហំភីកសែលពេញលេញ glyph នីមួយៗត្រូវបាន rasterized ម្តង។"

msgid ""
"Glyph horizontal position is rounded based on font size.\n"
"- To one quarter of the pixel size if font size is smaller or equal to "
"[constant SUBPIXEL_POSITIONING_ONE_QUARTER_MAX_SIZE].\n"
"- To one half of the pixel size if font size is smaller or equal to [constant "
"SUBPIXEL_POSITIONING_ONE_HALF_MAX_SIZE].\n"
"- To the whole pixel size for larger fonts."
msgstr ""
"ទីតាំងផ្តេករបស់ Glyph ត្រូវបានបង្គត់ដោយផ្អែកលើទំហំពុម្ពអក្សរ។\n"
"- ទៅមួយភាគបួននៃទំហំភីកសែល ប្រសិនបើទំហំពុម្ពអក្សរតូចជាង ឬស្មើនឹង [constant "
"SUBPIXEL_POSITIONING_ONE_QUARTER_MAX_SIZE]។\n"
"- ទៅពាក់កណ្តាលនៃទំហំភីកសែល ប្រសិនបើទំហំពុម្ពអក្សរតូចជាង ឬស្មើនឹង [constant "
"SUBPIXEL_POSITIONING_ONE_HALF_MAX_SIZE]។\n"
"- ទៅជាទំហំភីកសែលពេញលេញសម្រាប់ពុម្ពអក្សរធំជាង។"

msgid ""
"Glyph horizontal position is rounded to one half of the pixel size, each "
"glyph is rasterized up to two times."
msgstr ""
"ទីតាំងផ្តេករបស់ Glyph ត្រូវបានបង្គត់ទៅជាពាក់កណ្តាលនៃទំហំភីកសែល glyph នីមួយៗត្រូវបាន rasterized "
"រហូតដល់ពីរដង។"

msgid ""
"Glyph horizontal position is rounded to one quarter of the pixel size, each "
"glyph is rasterized up to four times."
msgstr ""
"ទីតាំងផ្តេករបស់ Glyph ត្រូវបានបង្គត់ទៅជាមួយភាគបួននៃទំហំភីកសែល glyph នីមួយៗត្រូវបាន rasterized "
"រហូតដល់បួនដង។"

msgid ""
"Maximum font size which will use \"one half of the pixel\" subpixel "
"positioning in [constant SUBPIXEL_POSITIONING_AUTO] mode."
msgstr ""
"ទំហំពុម្ពអក្សរអតិបរមាដែលនឹងប្រើការកំណត់ទីតាំង subpixel \"ពាក់កណ្តាលនៃភីកសែល\" នៅក្នុងរបៀប "
"[constant SUBPIXEL_POSITIONING_AUTO]។"

msgid ""
"Maximum font size which will use \"one quarter of the pixel\" subpixel "
"positioning in [constant SUBPIXEL_POSITIONING_AUTO] mode."
msgstr ""
"ទំហំពុម្ពអក្សរអតិបរមាដែលនឹងប្រើការកំណត់ទីតាំង subpixel \"មួយភាគបួននៃភីកសែល\" នៅក្នុងរបៀប "
"[constant SUBPIXEL_POSITIONING_AUTO]។"

msgid "TextServer supports simple text layouts."
msgstr "TextServer គាំទ្រប្លង់អត្ថបទសាមញ្ញ។"

msgid "TextServer supports bidirectional text layouts."
msgstr "TextServer គាំទ្រប្លង់អត្ថបទទ្វេទិស (bidirectional)។"

msgid "TextServer supports vertical layouts."
msgstr "TextServer គាំទ្រប្លង់បញ្ឈរ។"

msgid "TextServer supports complex text shaping."
msgstr "TextServer គាំទ្រការ shaping អត្ថបទស្មុគស្មាញ។"

msgid "TextServer supports justification using kashidas."
msgstr "TextServer គាំទ្រការតម្រឹមដោយប្រើ kashidas។"

msgid ""
"TextServer supports complex line/word breaking rules (e.g. dictionary based)."
msgstr "TextServer គាំទ្រច្បាប់បំបែកជួរ/ពាក្យស្មុគស្មាញ (ឧ. ផ្អែកលើ dictionary)។"

msgid "TextServer supports loading bitmap fonts."
msgstr "TextServer គាំទ្រការផ្ទុកពុម្ពអក្សរ bitmap។"

msgid "TextServer supports loading dynamic (TrueType, OpeType, etc.) fonts."
msgstr "TextServer គាំទ្រការផ្ទុកពុម្ពអក្សរ dynamic (TrueType, OpeType, ។ល។)។"

msgid ""
"TextServer supports multichannel signed distance field dynamic font rendering."
msgstr ""
"TextServer គាំទ្រការ render ពុម្ពអក្សរ dynamic multichannel signed distance field។"

msgid "TextServer supports loading system fonts."
msgstr "TextServer គាំទ្រការផ្ទុកពុម្ពអក្សរប្រព័ន្ធ។"

msgid "TextServer supports variable fonts."
msgstr "TextServer គាំទ្រពុម្ពអក្សរ variable (variable fonts)។"

msgid ""
"TextServer supports locale dependent and context sensitive case conversion."
msgstr ""
"TextServer គាំទ្រការបម្លែងអក្សរធំ/តូច (case conversion) ដែលអាស្រ័យលើ locale និងបរិបទ។"

msgid ""
"TextServer require external data file for some features, see [method "
"load_support_data]."
msgstr ""
"TextServer ត្រូវការឯកសារទិន្នន័យខាងក្រៅសម្រាប់មុខងារមួយចំនួន សូមមើល [method "
"load_support_data]។"

msgid ""
"TextServer supports UAX #31 identifier validation, see [method "
"is_valid_identifier]."
msgstr ""
"TextServer គាំទ្រការផ្ទៀងផ្ទាត់ identifier តាមស្តង់ដារ UAX #31 សូមមើល [method "
"is_valid_identifier]។"

msgid ""
"TextServer supports [url=https://unicode.org/reports/tr36/]Unicode Technical "
"Report #36[/url] and [url=https://unicode.org/reports/tr39/]Unicode Technical "
"Standard #39[/url] based spoof detection features."
msgstr ""
"TextServer គាំទ្រមុខងាររកឃើញការក្លែងបន្លំ (spoof detection) ដែលផ្អែកលើ [url=https://"
"unicode.org/reports/tr36/]Unicode Technical Report #36[/url] និង [url=https://"
"unicode.org/reports/tr39/]Unicode Technical Standard #39[/url]។"

msgid "Contour point is on the curve."
msgstr "ចំណុចគន្លង (Contour point) ស្ថិតនៅលើខ្សែកោង។"

msgid ""
"Contour point isn't on the curve, but serves as a control point for a conic "
"(quadratic) Bézier arc."
msgstr ""
"ចំណុចគន្លងមិនស្ថិតនៅលើខ្សែកោងទេ ប៉ុន្តែដើរតួជាចំណុចគ្រប់គ្រង (control point) សម្រាប់ធ្នូ conic "
"(quadratic) Bézier។"

msgid ""
"Contour point isn't on the curve, but serves as a control point for a cubic "
"Bézier arc."
msgstr "ចំណុចគន្លងមិនស្ថិតនៅលើខ្សែកោងទេ ប៉ុន្តែដើរតួជាចំណុចគ្រប់គ្រងសម្រាប់ធ្នូ cubic Bézier។"

msgid "Spacing for each glyph."
msgstr "គម្លាតសម្រាប់ glyph នីមួយៗ។"

msgid "Spacing for the space character."
msgstr "គម្លាតសម្រាប់តួអក្សរ space (ចន្លោះ)។"

msgid "Spacing at the top of the line."
msgstr "គម្លាតនៅផ្នែកខាងលើនៃបន្ទាត់។"

msgid "Spacing at the bottom of the line."
msgstr "គម្លាតនៅផ្នែកខាងក្រោមនៃបន្ទាត់។"

msgid "Represents the size of the [enum SpacingType] enum."
msgstr "តំណាងឱ្យទំហំនៃ [enum SpacingType] enum។"

msgid "Font is bold."
msgstr "ពុម្ពអក្សរមានលក្ខណៈដិត (bold)។"

msgid "Font is italic or oblique."
msgstr "ពុម្ពអក្សរមានលក្ខណៈទ្រេត (italic ឬ oblique)។"

msgid "Font has fixed-width characters (also known as monospace)."
msgstr "ពុម្ពអក្សរមានតួអក្សរទទឹងថេរ (fixed-width ឬ monospace)។"

msgid "Use default Unicode BiDi algorithm."
msgstr "ប្រើក្បួនដោះស្រាយ Unicode BiDi លំនាំដើម។"

msgid "BiDi override for URI."
msgstr "ការកំណត់ជំនួស BiDi សម្រាប់ URI។"

msgid "BiDi override for file path."
msgstr "ការកំណត់ជំនួស BiDi សម្រាប់ file path (ផ្លូវឯកសារ)។"

msgid "BiDi override for email."
msgstr "ការកំណត់ជំនួស BiDi សម្រាប់ email។"

msgid ""
"BiDi override for lists. Structured text options: list separator [String]."
msgstr ""
"ការកំណត់ជំនួស BiDi សម្រាប់បញ្ជី (lists)។ ជម្រើសអត្ថបទមានរចនាសម្ព័ន្ធ៖ list separator "
"[String]។"

msgid "BiDi override for GDScript."
msgstr "ការកំណត់ជំនួស BiDi សម្រាប់ GDScript។"

msgid "User defined structured text BiDi override function."
msgstr "អនុគមន៍កំណត់ជំនួស BiDi សម្រាប់អត្ថបទមានរចនាសម្ព័ន្ធ ដែលកំណត់ដោយអ្នកប្រើប្រាស់។"

msgid "Bitmap font is not scaled."
msgstr "ពុម្ពអក្សរ Bitmap មិនត្រូវបានធ្វើមាត្រដ្ឋាន (scaled) ទេ។"

msgid ""
"Bitmap font is scaled to the closest integer multiple of the font's fixed "
"size. This is the recommended option for pixel art fonts."
msgstr ""
"ពុម្ពអក្សរ Bitmap ត្រូវបានធ្វើមាត្រដ្ឋានទៅជាពហុគុណចំនួនគត់ដែលជិតបំផុតនៃទំហំថេររបស់ពុម្ពអក្សរ។ "
"នេះគឺជាជម្រើសដែលណែនាំសម្រាប់ពុម្ពអក្សរ pixel art។"

msgid ""
"Bitmap font is scaled to an arbitrary (fractional) size. This is the "
"recommended option for non-pixel art fonts."
msgstr ""
"ពុម្ពអក្សរ Bitmap ត្រូវបានធ្វើមាត្រដ្ឋានទៅជាទំហំណាមួយ (fractional)។ "
"នេះគឺជាជម្រើសដែលណែនាំសម្រាប់ពុម្ពអក្សរដែលមិនមែនជា pixel art។"

msgid ""
"An advanced text server with support for BiDi, complex text layout, and "
"contextual OpenType features. Used in Godot by default."
msgstr ""
"ម៉ាស៊ីនមេអត្ថបទកម្រិតខ្ពស់ ដែលគាំទ្រ BiDi, ការរៀបចំអត្ថបទស្មុគស្មាញ និងមុខងារ OpenType "
"តាមបរិបទ។ ត្រូវបានប្រើជាលំនាំដើមនៅក្នុង Godot។"

msgid ""
"An implementation of [TextServer] that uses HarfBuzz, ICU and SIL Graphite to "
"support BiDi, complex text layouts and contextual OpenType features. This is "
"Godot's default primary [TextServer] interface."
msgstr ""
"ការអនុវត្តនៃ [TextServer] ដែលប្រើ HarfBuzz, ICU និង SIL Graphite ដើម្បីគាំទ្រ BiDi, "
"ការរៀបចំអត្ថបទស្មុគស្មាញ និងមុខងារ OpenType តាមបរិបទ។ នេះគឺជា interface ចម្បងលំនាំដើមរបស់ "
"[TextServer] ក្នុង Godot។"

msgid "A dummy text server that can't render text or manage fonts."
msgstr "ម៉ាស៊ីនមេអត្ថបទ dummy ដែលមិនអាច render អត្ថបទ ឬគ្រប់គ្រងពុម្ពអក្សរបានទេ។"

msgid ""
"A dummy [TextServer] interface that doesn't do anything. Useful for freeing "
"up memory when rendering text is not needed, as text servers are resource-"
"intensive. It can also be used for performance comparisons in complex GUIs to "
"check the impact of text rendering.\n"
"A dummy text server is always available at the start of a project. Here's how "
"to access it:\n"
"[codeblock]\n"
"var dummy_text_server = TextServerManager.find_interface(\"Dummy\")\n"
"if dummy_text_server != null:\n"
"\tTextServerManager.set_primary_interface(dummy_text_server)\n"
"\t# If the other text servers are unneeded, they can be removed:\n"
"\tfor i in TextServerManager.get_interface_count():\n"
"\t\tvar text_server = TextServerManager.get_interface(i)\n"
"\t\tif text_server != dummy_text_server:\n"
"\t\t\tTextServerManager.remove_interface(text_server)\n"
"[/codeblock]\n"
"The command line argument [code]--text-driver Dummy[/code] (case-sensitive) "
"can be used to force the \"Dummy\" [TextServer] on any project."
msgstr ""
"interface [TextServer] dummy ដែលមិនធ្វើអ្វីសោះ។ "
"មានប្រយោជន៍សម្រាប់រំដោះអង្គចងចាំនៅពេលមិនចាំបាច់ render អត្ថបទ ព្រោះ text servers "
"ប្រើប្រាស់ធនធានច្រើន។ វាក៏អាចត្រូវបានប្រើសម្រាប់ការប្រៀបធៀបដំណើរការនៅក្នុង GUI ស្មុគស្មាញ "
"ដើម្បីពិនិត្យមើលផលប៉ះពាល់នៃការ render អត្ថបទ។\n"
"ម៉ាស៊ីនមេអត្ថបទ dummy តែងតែមាននៅពេលចាប់ផ្តើមគម្រោង។ នេះជារបៀបចូលប្រើវា៖\n"
"[codeblock]\n"
"var dummy_text_server = TextServerManager.find_interface(\"Dummy\")\n"
"if dummy_text_server != null:\n"
"\tTextServerManager.set_primary_interface(dummy_text_server)\n"
"\t# If the other text servers are unneeded, they can be removed:\n"
"\tfor i in TextServerManager.get_interface_count():\n"
"\t\tvar text_server = TextServerManager.get_interface(i)\n"
"\t\tif text_server != dummy_text_server:\n"
"\t\t\tTextServerManager.remove_interface(text_server)\n"
"[/codeblock]\n"
"អាគុយម៉ង់ command line [code]--text-driver Dummy[/code] (ប្រកាន់អក្សរធំតូច) "
"អាចត្រូវបានប្រើដើម្បីបង្ខំឱ្យប្រើ [TextServer] \"Dummy\" លើគម្រោងណាមួយ។"

msgid "Base class for custom [TextServer] implementations (plugins)."
msgstr "Class មូលដ្ឋានសម្រាប់ការអនុវត្ត [TextServer] ផ្ទាល់ខ្លួន (plugins)។"

msgid "External [TextServer] implementations should inherit from this class."
msgstr "ការអនុវត្ត [TextServer] ខាងក្រៅគួរតែ inherit ពី class នេះ។"

msgid "This method is called before text server is unregistered."
msgstr "វិធីសាស្រ្តនេះត្រូវបានហៅមុនពេល text server ត្រូវបានលុបឈ្មោះចេញ (unregistered)។"

msgid "Creates a new, empty font cache entry resource."
msgstr "បង្កើតធនធាន font cache entry ថ្មីដែលទទេ។"

msgid ""
"Optional, implement if font supports extra spacing or baseline offset.\n"
"Creates a new variation existing font which is reusing the same glyph cache "
"and font data."
msgstr ""
"ជាជម្រើស សូមអនុវត្តប្រសិនបើពុម្ពអក្សរគាំទ្រគម្លាតបន្ថែម ឬ baseline offset។\n"
"បង្កើត variation ថ្មីនៃពុម្ពអក្សរដែលមានស្រាប់ ដែលកំពុងប្រើប្រាស់ glyph cache "
"និងទិន្នន័យពុម្ពអក្សរដដែល។"

msgid ""
"Creates a new buffer for complex text layout, with the given [param "
"direction] and [param orientation]."
msgstr ""
"បង្កើត buffer ថ្មីសម្រាប់ការរៀបចំអត្ថបទស្មុគស្មាញ ជាមួយនឹង [param direction] និង [param "
"orientation] ដែលបានផ្តល់ឱ្យ។"

msgid "Draws box displaying character hexadecimal code."
msgstr "គូរប្រអប់ដែលបង្ហាញកូដ hexadecimal នៃតួអក្សរ។"

msgid "Removes all rendered glyph information from the cache entry."
msgstr "លុបព័ត៌មាន glyph ដែលបាន render ទាំងអស់ចេញពី cache entry។"

msgid "Removes all textures from font cache entry."
msgstr "លុប texture ទាំងអស់ចេញពី font cache entry។"

msgid ""
"Draws single glyph into a canvas item at the position, using [param font_rid] "
"at the size [param size]. If [param oversampling] is greater than zero, it is "
"used as font oversampling factor, otherwise viewport oversampling settings "
"are used."
msgstr ""
"គូរ glyph តែមួយចូលទៅក្នុង canvas item នៅទីតាំងដែលបានកំណត់ ដោយប្រើ [param font_rid] "
"ក្នុងទំហំ [param size]។ ប្រសិនបើ [param oversampling] ធំជាងសូន្យ វានឹងត្រូវបានប្រើជាកត្តា "
"oversampling របស់ពុម្ពអក្សរ បើមិនដូច្នេះទេ ការកំណត់ oversampling របស់ viewport "
"នឹងត្រូវបានប្រើ។"

msgid ""
"Draws single glyph outline of size [param outline_size] into a canvas item at "
"the position, using [param font_rid] at the size [param size]. If [param "
"oversampling] is greater than zero, it is used as font oversampling factor, "
"otherwise viewport oversampling settings are used."
msgstr ""
"គូរគន្លង (outline) នៃ glyph តែមួយក្នុងទំហំ [param outline_size] ចូលទៅក្នុង canvas item "
"នៅទីតាំងដែលបានកំណត់ ដោយប្រើ [param font_rid] ក្នុងទំហំ [param size]។ ប្រសិនបើ [param "
"oversampling] ធំជាងសូន្យ វានឹងត្រូវបានប្រើជាកត្តា oversampling របស់ពុម្ពអក្សរ បើមិនដូច្នេះទេ "
"ការកំណត់ oversampling របស់ viewport នឹងត្រូវបានប្រើ។"

msgid ""
"Returns character code associated with [param glyph_index], or [code]0[/code] "
"if [param glyph_index] is invalid."
msgstr ""
"បង្វិលកូដតួអក្សរដែលទាក់ទងនឹង [param glyph_index] ឬ [code]0[/code] ប្រសិនបើ [param "
"glyph_index] មិនត្រឹមត្រូវ។"

msgid ""
"Returns the font oversampling factor, shared by all fonts in the TextServer."
msgstr ""
"បង្វិលកត្តា oversampling របស់ពុម្ពអក្សរ ដែលប្រើរួមគ្នាដោយពុម្ពអក្សរទាំងអស់នៅក្នុង TextServer។"

msgid "Returns glyph advance (offset of the next glyph)."
msgstr "បង្វិល glyph advance (គម្លាតទៅកាន់ glyph បន្ទាប់)។"

msgid "Returns outline contours of the glyph."
msgstr "បង្វិលគន្លងកោង (outline contours) នៃ glyph។"

msgid "Returns resource ID of the cache texture containing the glyph."
msgstr "បង្វិល resource ID នៃ cache texture ដែលផ្ទុក glyph។"

msgid "Returns size of the cache texture containing the glyph."
msgstr "បង្វិលទំហំនៃ cache texture ដែលផ្ទុក glyph។"

msgid ""
"Returns the array in the predefined color palette at [param index]. Palette "
"contains all colors used to render font glyphs. Each palette has the same "
"number of colors. Colors can be overridden using [method "
"_font_set_palette_custom_colors]."
msgstr ""
"បង្វិល array នៅក្នុង color palette ដែលបានកំណត់ជាមុននៅ [param index]។ Palette "
"ផ្ទុកពណ៌ទាំងអស់ដែលប្រើសម្រាប់ render font glyphs។ Palette នីមួយៗមានចំនួនពណ៌ដូចគ្នា។ "
"ពណ៌អាចត្រូវបានកំណត់ជំនួសដោយប្រើ [method _font_set_palette_custom_colors]។"

msgid "Returns variation coordinates for the specified font cache entry."
msgstr "បង្វិលកូអរដោនេ variation សម្រាប់ font cache entry ដែលបានបញ្ជាក់។"

msgid ""
"Returns [code]true[/code] if auto-hinting is supported and preferred over "
"font built-in hinting."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ auto-hinting ត្រូវបានគាំទ្រ ហើយត្រូវបានពេញចិត្តជាង font "
"built-in hinting។"

msgid "Removes specified rendered glyph information from the cache entry."
msgstr "លុបព័ត៌មាន glyph ដែលបាន render និងបានបញ្ជាក់ ចេញពី cache entry។"

msgid "Removes specified texture from the cache entry."
msgstr "លុប texture ដែលបានបញ្ជាក់ចេញពី cache entry។"

msgid ""
"Sets pointer to the font source data, e.g contents of the dynamic font source "
"file."
msgstr ""
"កំណត់ pointer ទៅកាន់ទិន្នន័យប្រភពពុម្ពអក្សរ ឧទាហរណ៍ ខ្លឹមសារនៃឯកសារប្រភព dynamic font។"

msgid "If set to [code]true[/code], embedded font bitmap loading is disabled."
msgstr "ប្រសិនបើកំណត់ទៅជា [code]true[/code] ការផ្ទុក embedded font bitmap នឹងត្រូវបានបិទ។"

msgid "Sets oversampling factor, shared by all font in the TextServer."
msgstr "កំណត់កត្តា oversampling ដែលប្រើរួមគ្នាដោយពុម្ពអក្សរទាំងអស់នៅក្នុង TextServer។"

msgid "Sets glyph advance (offset of the next glyph)."
msgstr "កំណត់ glyph advance (គម្លាតទៅកាន់ glyph បន្ទាប់)។"

msgid "Adds override for [method _font_is_language_supported]."
msgstr "បន្ថែមការកំណត់ជំនួស (override) សម្រាប់ [method _font_is_language_supported]។"

msgid ""
"If set to [code]true[/code], glyphs of all sizes are rendered using single "
"multichannel signed distance field generated from the dynamic font vector "
"data. MSDF rendering allows displaying the font at any scaling factor without "
"blurriness, and without incurring a CPU cost when the font size changes "
"(since the font no longer needs to be rasterized on the CPU). As a downside, "
"font hinting is not available with MSDF. The lack of font hinting may result "
"in less crisp and less readable fonts at small sizes."
msgstr ""
"ប្រសិនបើកំណត់ទៅជា [code]true[/code] glyphs គ្រប់ទំហំនឹងត្រូវបាន render ដោយប្រើ single "
"multichannel signed distance field ដែលបង្កើតចេញពីទិន្នន័យ vector នៃ dynamic font។ "
"ការ render បែប MSDF អនុញ្ញាតឱ្យបង្ហាញពុម្ពអក្សរក្នុងកត្តាមាត្រដ្ឋានណាមួយដោយមិនព្រាល "
"ហើយមិនប្រើប្រាស់ធនធាន CPU នៅពេលទំហំពុម្ពអក្សរផ្លាស់ប្តូរ (ព្រោះពុម្ពអក្សរលែងត្រូវការ rasterize "
"លើ CPU ទៀតហើយ)។ ចំណុចខ្វះខាតគឺ font hinting មិនអាចប្រើបានជាមួយ MSDF ទេ។ កង្វះ font "
"hinting អាចធ្វើឱ្យពុម្ពអក្សរមិនសូវច្បាស់ និងពិបាកអាននៅទំហំតូច។"

msgid "Adds override for [method _font_is_script_supported]."
msgstr "បន្ថែមការកំណត់ជំនួសសម្រាប់ [method _font_is_script_supported]។"

msgid ""
"Sets font stretch amount, compared to a normal width. A percentage value "
"between [code]50%[/code] and [code]200%[/code]."
msgstr ""
"កំណត់ចំនួនលាតសន្ធឹងនៃពុម្ពអក្សរ បើធៀបនឹងទទឹងធម្មតា។ ជាតម្លៃភាគរយចន្លោះពី [code]50%[/code] និង "
"[code]200%[/code]។"

msgid "Sets the font style flags."
msgstr "កំណត់ flags នៃរចនាប័ទ្មពុម្ពអក្សរ។"

msgid "Sets variation coordinates for the specified font cache entry."
msgstr "កំណត់កូអរដោនេ variation សម្រាប់ font cache entry ដែលបានបញ្ជាក់។"

msgid ""
"Sets weight (boldness) of the font. A value in the [code]100...999[/code] "
"range, normal font weight is [code]400[/code], bold font weight is [code]700[/"
"code]."
msgstr ""
"កំណត់ weight (កម្រាស់ដិត) នៃពុម្ពអក្សរ។ តម្លៃនៅក្នុងចន្លោះ [code]100...999[/code] ដែល "
"weight ធម្មតាគឺ [code]400[/code] និង weight ដិតគឺ [code]700[/code]។"

msgid "Returns text server features, see [enum TextServer.Feature]."
msgstr "បង្វិលមុខងាររបស់ text server សូមមើល [enum TextServer.Feature]។"

msgid ""
"Returns index of the first string in [param dict] which is visually "
"confusable with the [param string], or [code]-1[/code] if none is found."
msgstr ""
"បង្វិល index នៃ string ដំបូងគេនៅក្នុង [param dict] ដែលមើលទៅដូចនឹង [param string] "
"(visually confusable) ឬ [code]-1[/code] ប្រសិនបើរកមិនឃើញ។"

msgid "Returns [code]true[/code] if [param string] is a valid identifier."
msgstr "បង្វិល [code]true[/code] ប្រសិនបើ [param string] គឺជា identifier ត្រឹមត្រូវ។"

msgid ""
"Loads optional TextServer database (e.g. ICU break iterators and "
"dictionaries)."
msgstr ""
"ផ្ទុកមូលដ្ឋានទិន្នន័យ TextServer ជាជម្រើស (ឧ. ICU break iterators និង dictionaries)។"

msgid "Returns percent sign used in the given [param language]."
msgstr "បង្វិលសញ្ញាភាគរយដែលប្រើក្នុង [param language] ដែលបានផ្តល់ឱ្យ។"

msgid ""
"Increases the reference count of the specified oversampling level. This "
"method is called by [Viewport], and should not be used directly."
msgstr ""
"បង្កើនចំនួន reference count នៃកម្រិត oversampling ដែលបានបញ្ជាក់។ "
"វិធីសាស្រ្តនេះត្រូវបានហៅដោយ [Viewport] ហើយមិនគួរប្រើដោយផ្ទាល់ទេ។"

msgid ""
"Saves optional TextServer database (e.g. ICU break iterators and "
"dictionaries) to the file."
msgstr ""
"រក្សាទុកមូលដ្ឋានទិន្នន័យ TextServer ជាជម្រើស (ឧ. ICU break iterators និង dictionaries) "
"ទៅក្នុងឯកសារ។"

msgid ""
"Returns number of text spans added using [method _shaped_text_add_string] or "
"[method _shaped_text_add_object]."
msgstr ""
"បង្វិលចំនួន text spans ដែលបានបន្ថែមដោយប្រើ [method _shaped_text_add_string] ឬ "
"[method _shaped_text_add_object]។"

msgid ""
"Draw shaped text into a canvas item at a given position, with [param color]. "
"[param pos] specifies the leftmost point of the baseline (for horizontal "
"layout) or topmost point of the baseline (for vertical layout). If [param "
"oversampling] is greater than zero, it is used as font oversampling factor, "
"otherwise viewport oversampling settings are used."
msgstr ""
"គូរ shaped text ចូលទៅក្នុង canvas item នៅទីតាំងដែលបានផ្តល់ឱ្យ ជាមួយនឹង [param color]។ "
"[param pos] បញ្ជាក់ពីចំណុចខាងឆ្វេងបំផុតនៃ baseline (សម្រាប់ការរៀបចំផ្តេក) ឬចំណុចខាងលើបំផុតនៃ "
"baseline (សម្រាប់ការរៀបចំបញ្ឈរ)។ ប្រសិនបើ [param oversampling] ធំជាងសូន្យ "
"វានឹងត្រូវបានប្រើជាកត្តា oversampling របស់ពុម្ពអក្សរ បើមិនដូច្នេះទេ ការកំណត់ oversampling "
"របស់ viewport នឹងត្រូវបានប្រើ។"

msgid ""
"Draw the outline of the shaped text into a canvas item at a given position, "
"with [param color]. [param pos] specifies the leftmost point of the baseline "
"(for horizontal layout) or topmost point of the baseline (for vertical "
"layout). If [param oversampling] is greater than zero, it is used as font "
"oversampling factor, otherwise viewport oversampling settings are used."
msgstr ""
"គូរគន្លង (outline) នៃ shaped text ចូលទៅក្នុង canvas item នៅទីតាំងដែលបានផ្តល់ឱ្យ ជាមួយនឹង "
"[param color]។ [param pos] បញ្ជាក់ពីចំណុចខាងឆ្វេងបំផុតនៃ baseline (សម្រាប់ការរៀបចំផ្តេក) "
"ឬចំណុចខាងលើបំផុតនៃ baseline (សម្រាប់ការរៀបចំបញ្ឈរ)។ ប្រសិនបើ [param oversampling] "
"ធំជាងសូន្យ វានឹងត្រូវបានប្រើជាកត្តា oversampling របស់ពុម្ពអក្សរ បើមិនដូច្នេះទេ ការកំណត់ "
"oversampling របស់ viewport នឹងត្រូវបានប្រើ។"

msgid ""
"Returns [code]true[/code] if text buffer is configured to display hexadecimal "
"codes in place of invalid characters."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ text buffer ត្រូវបានកំណត់ឱ្យបង្ហាញកូដ hexadecimal "
"ជំនួសឱ្យតួអក្សរដែលមិនត្រឹមត្រូវ។"

msgid "Overrides BiDi for the structured text."
msgstr "កំណត់ជំនួស BiDi សម្រាប់អត្ថបទមានរចនាសម្ព័ន្ធ។"

msgid ""
"Sets desired text direction. If set to [constant TextServer.DIRECTION_AUTO], "
"direction will be detected based on the buffer contents and current locale."
msgstr ""
"កំណត់ទិសដៅអត្ថបទដែលចង់បាន។ ប្រសិនបើកំណត់ទៅជា [constant TextServer.DIRECTION_AUTO] "
"ទិសដៅនឹងត្រូវបានរកឃើញដោយផ្អែកលើខ្លឹមសារ buffer និង locale បច្ចុប្បន្ន។"

msgid "Sets desired text orientation."
msgstr "កំណត់ការតម្រង់ទិសអត្ថបទ (orientation) ដែលចង់បាន។"

msgid ""
"Shapes buffer if it's not shaped. Returns [code]true[/code] if the string is "
"shaped successfully."
msgstr ""
"ធ្វើ shape buffer ប្រសិនបើវាមិនទាន់ shaped។ បង្វិល [code]true[/code] ប្រសិនបើ string "
"ត្រូវបាន shaped ដោយជោគជ័យ។"

msgid ""
"Updates break points in the shaped text. This method is called by default "
"implementation of text breaking functions."
msgstr ""
"ធ្វើបច្ចុប្បន្នភាពចំណុចបំបែក (break points) នៅក្នុង shaped text។ "
"វិធីសាស្រ្តនេះត្រូវបានហៅដោយការអនុវត្តលំនាំដើមនៃអនុគមន៍បំបែកអត្ថបទ។"

msgid ""
"Updates justification points in the shaped text. This method is called by "
"default implementation of text justification functions."
msgstr ""
"ធ្វើបច្ចុប្បន្នភាពចំណុច justification នៅក្នុង shaped text។ "
"វិធីសាស្រ្តនេះត្រូវបានហៅដោយការអនុវត្តលំនាំដើមនៃអនុគមន៍ text justification។"

msgid ""
"Returns [code]true[/code] if [param string] is likely to be an attempt at "
"confusing the reader."
msgstr ""
"បង្វិល [code]true[/code] ប្រសិនបើ [param string] "
"ទំនងជាការប៉ុនប៉ងធ្វើឱ្យអ្នកអានមានការភាន់ច្រឡំ។"

msgid ""
"Returns an array of the word break boundaries. Elements in the returned array "
"are the offsets of the start and end of words. Therefore the length of the "
"array is always even."
msgstr ""
"បង្វិល array នៃព្រំដែនបំបែកពាក្យ (word break boundaries)។ ធាតុនៅក្នុង array ដែលបានបង្វិល "
"គឺជាគម្លាត (offsets) នៃការចាប់ផ្តើម និងការបញ្ចប់នៃពាក្យ។ ដូច្នេះប្រវែងនៃ array "
"តែងតែជាចំនួនគូ។"

msgid "Returns the string converted to [code]Title Case[/code]."
msgstr "បង្វិល string ដែលបានបម្លែងទៅជា [code]Title Case[/code]។"

msgid "Strips diacritics from the string."
msgstr "លុបសញ្ញា diacritics ចេញពី string។"

msgid ""
"Decreases the reference count of the specified oversampling level, and frees "
"the font cache for oversampling level when the reference count reaches zero. "
"This method is called by [Viewport], and should not be used directly."
msgstr ""
"បន្ថយ reference count នៃកម្រិត oversampling ដែលបានបញ្ជាក់ ហើយរំដោះ font cache "
"សម្រាប់កម្រិត oversampling នៅពេល reference count ឈានដល់សូន្យ។ វិធីសាស្រ្តនេះត្រូវបានហៅដោយ "
"[Viewport] ហើយមិនគួរប្រើដោយផ្ទាល់ទេ។"

msgid ""
"A fallback implementation of Godot's text server, without support for BiDi "
"and complex text layout."
msgstr ""
"ការអនុវត្ត fallback នៃ text server របស់ Godot ដោយគ្មានការគាំទ្រសម្រាប់ BiDi "
"និងការរៀបចំអត្ថបទស្មុគស្មាញ។"

msgid ""
"A fallback implementation of Godot's text server. This fallback is faster "
"than [TextServerAdvanced] for processing a lot of text, but it does not "
"support BiDi and complex text layout.\n"
"[b]Note:[/b] This text server is not part of official Godot binaries. If you "
"want to use it, compile the engine with the option "
"[code]module_text_server_fb_enabled=yes[/code]. When building with "
"[TextServerFallback], consider also disabling [TextServerAdvanced] with "
"[code]module_text_server_adv_enabled=no[/code] to reduce binary size."
msgstr ""
"ការអនុវត្ត fallback នៃ text server របស់ Godot។ Fallback នេះលឿនជាង "
"[TextServerAdvanced] សម្រាប់ការដំណើរការអត្ថបទច្រើន ប៉ុន្តែវាមិនគាំទ្រ BiDi "
"និងការរៀបចំអត្ថបទស្មុគស្មាញទេ។\n"
"[b]ចំណាំ៖[/b] Text server នេះមិនមែនជាផ្នែកមួយនៃ Godot binaries ផ្លូវការទេ។ "
"ប្រសិនបើអ្នកចង់ប្រើវា សូម compile engine ជាមួយនឹងជម្រើស "
"[code]module_text_server_fb_enabled=yes[/code]។ នៅពេល build ជាមួយ "
"[TextServerFallback] សូមពិចារណាបិទ [TextServerAdvanced] ផងដែរដោយប្រើ "
"[code]module_text_server_adv_enabled=no[/code] ដើម្បីកាត់បន្ថយទំហំ binary។"

msgid "A singleton for managing [TextServer] implementations."
msgstr "singleton សម្រាប់គ្រប់គ្រងការអនុវត្ត [TextServer]។"

msgid ""
"[TextServerManager] is the API backend for loading, enumerating, and "
"switching [TextServer]s.\n"
"[b]Note:[/b] Switching text server at runtime is possible, but will "
"invalidate all fonts and text buffers. Make sure to unload all controls, "
"fonts, and themes before doing so."
msgstr ""
"[TextServerManager] គឺជា API backend សម្រាប់ផ្ទុក, រាប់ និងប្តូរ [TextServer]s។\n"
"[b]ចំណាំ៖[/b] ការប្តូរ text server នៅពេល runtime គឺអាចធ្វើទៅបាន ប៉ុន្តែនឹងធ្វើឱ្យ fonts "
"និង text buffers ទាំងអស់លែងមានសុពលភាព។ សូមប្រាកដថា unload controls, fonts និង themes "
"ទាំងអស់មុននឹងធ្វើដូច្នេះ។"

msgid "Registers a [TextServer] interface."
msgstr "ចុះឈ្មោះ interface [TextServer]។"

msgid "Finds an interface by its [param name]."
msgstr "ស្វែងរក interface តាមរយៈ [param name] របស់វា។"

msgid "Returns the interface registered at a given index."
msgstr "បង្វិល interface ដែលបានចុះឈ្មោះនៅ index ដែលបានផ្តល់ឱ្យ។"

msgid "Returns the number of interfaces currently registered."
msgstr "បង្វិលចំនួន interfaces ដែលបានចុះឈ្មោះបច្ចុប្បន្ន។"

msgid ""
"Returns a list of available interfaces, with the index and name of each "
"interface."
msgstr "បង្វិលបញ្ជី interfaces ដែលមាន ព្រមទាំង index និងឈ្មោះនៃ interface នីមួយៗ។"

msgid "Returns the primary [TextServer] interface currently in use."
msgstr "បង្វិល interface [TextServer] ចម្បងដែលកំពុងប្រើប្រាស់បច្ចុប្បន្ន។"

msgid ""
"Removes an interface. All fonts and shaped text caches should be freed before "
"removing an interface."
msgstr ""
"លុប interface ចេញ។ fonts និង shaped text caches ទាំងអស់គួរតែត្រូវបានរំដោះ (freed) "
"មុនពេលលុប interface។"

msgid "Sets the primary [TextServer] interface."
msgstr "កំណត់ interface [TextServer] ចម្បង។"

msgid "Emitted when a new interface has been added."
msgstr "បញ្ជូនសញ្ញា (Emitted) នៅពេលដែល interface ថ្មីត្រូវបានបន្ថែម។"

msgid "Emitted when an interface is removed."
msgstr "បញ្ជូនសញ្ញានៅពេលដែល interface ត្រូវបានលុបចេញ។"

msgid "Base class for all texture types."
msgstr "Class មូលដ្ឋានសម្រាប់គ្រប់ប្រភេទ texture។"

msgid ""
"[Texture] is the base class for all texture types. Common texture types are "
"[Texture2D] and [ImageTexture]. See also [Image]."
msgstr ""
"[Texture] គឺជា class មូលដ្ឋានសម្រាប់គ្រប់ប្រភេទ texture។ ប្រភេទ texture ទូទៅគឺ "
"[Texture2D] និង [ImageTexture]។ សូមមើលផងដែរ [Image]។"

msgid "Texture for 2D and 3D."
msgstr "Texture សម្រាប់ 2D និង 3D។"

msgid ""
"A texture works by registering an image in the video hardware, which then can "
"be used in 3D models or 2D [Sprite2D] or GUI [Control].\n"
"Textures are often created by loading them from a file. See [method "
"@GDScript.load].\n"
"[Texture2D] is a base for other resources. It cannot be used directly.\n"
"[b]Note:[/b] The maximum texture size is 16384×16384 pixels due to graphics "
"hardware limitations. Larger textures may fail to import."
msgstr ""
"Texture ដំណើរការដោយចុះឈ្មោះរូបភាពនៅក្នុង video hardware ដែលបន្ទាប់មកអាចត្រូវបានប្រើនៅក្នុង "
"3D models, 2D [Sprite2D] ឬ GUI [Control]។\n"
"Textures ជាញឹកញាប់ត្រូវបានបង្កើតឡើងដោយផ្ទុកវាពីឯកសារ។ សូមមើល [method @GDScript.load]។\n"
"[Texture2D] គឺជាមូលដ្ឋានសម្រាប់ធនធានផ្សេងទៀត។ វាមិនអាចត្រូវបានប្រើដោយផ្ទាល់ទេ។\n"
"[b]ចំណាំ៖[/b] ទំហំ texture អតិបរមាគឺ 16384×16384 pixels ដោយសារដែនកំណត់នៃ graphics "
"hardware។ Textures ធំជាងនេះអាចនឹងបរាជ័យក្នុងការ import។"

msgid ""
"Called when the entire [Texture2D] is requested to be drawn over a "
"[CanvasItem], with the top-left offset specified in [param pos]. [param "
"modulate] specifies a multiplier for the colors being drawn, while [param "
"transpose] specifies whether drawing should be performed in column-major "
"order instead of row-major order (resulting in 90-degree clockwise "
"rotation).\n"
"[b]Note:[/b] This is only used in 2D rendering, not 3D."
msgstr ""
"ត្រូវបានហៅនៅពេលដែល [Texture2D] ទាំងមូលត្រូវបានស្នើសុំឱ្យគូរលើ [CanvasItem] "
"ជាមួយនឹងគម្លាតខាងលើឆ្វេងដែលបានបញ្ជាក់នៅក្នុង [param pos]។ [param modulate] "
"បញ្ជាក់ពីកត្តាគុណសម្រាប់ពណ៌ដែលកំពុងត្រូវបានគូរ ខណៈពេលដែល [param transpose] "
"បញ្ជាក់ថាតើការគូរគួរតែត្រូវបានអនុវត្តក្នុងលំដាប់ column-major ជំនួសឱ្យលំដាប់ row-major "
"(ដែលបណ្តាលឱ្យមានការបង្វិល 90 ដឺក្រេតាមទ្រនិចនាឡិកា)។\n"
"[b]ចំណាំ៖[/b] នេះត្រូវបានប្រើតែក្នុងការ render 2D ប៉ុណ្ណោះ មិនមែន 3D ទេ។"

msgid ""
"Called when the [Texture2D] is requested to be drawn onto [CanvasItem]'s "
"specified [param rect]. [param modulate] specifies a multiplier for the "
"colors being drawn, while [param transpose] specifies whether drawing should "
"be performed in column-major order instead of row-major order (resulting in "
"90-degree clockwise rotation).\n"
"[b]Note:[/b] This is only used in 2D rendering, not 3D."
msgstr ""
"ត្រូវបានហៅនៅពេលដែល [Texture2D] ត្រូវបានស្នើសុំឱ្យគូរលើ [param rect] ដែលបានបញ្ជាក់របស់ "
"[CanvasItem]។ [param modulate] បញ្ជាក់ពីកត្តាគុណសម្រាប់ពណ៌ដែលកំពុងត្រូវបានគូរ ខណៈពេលដែល "
"[param transpose] បញ្ជាក់ថាតើការគូរគួរតែត្រូវបានអនុវត្តក្នុងលំដាប់ column-major ជំនួសឱ្យលំដាប់ "
"row-major (ដែលបណ្តាលឱ្យមានការបង្វិល 90 ដឺក្រេតាមទ្រនិចនាឡិកា)។\n"
"[b]ចំណាំ៖[/b] នេះត្រូវបានប្រើតែក្នុងការ render 2D ប៉ុណ្ណោះ មិនមែន 3D ទេ។"

msgid ""
"Called when a part of the [Texture2D] specified by [param src_rect]'s "
"coordinates is requested to be drawn onto [CanvasItem]'s specified [param "
"rect]. [param modulate] specifies a multiplier for the colors being drawn, "
"while [param transpose] specifies whether drawing should be performed in "
"column-major order instead of row-major order (resulting in 90-degree "
"clockwise rotation).\n"
"[b]Note:[/b] This is only used in 2D rendering, not 3D."
msgstr ""
"ត្រូវបានហៅនៅពេលដែលផ្នែកមួយនៃ [Texture2D] ដែលបានបញ្ជាក់ដោយកូអរដោនេរបស់ [param "
"src_rect] ត្រូវបានស្នើសុំឱ្យគូរលើ [param rect] ដែលបានបញ្ជាក់របស់ [CanvasItem]។ [param "
"modulate] បញ្ជាក់ពីកត្តាគុណសម្រាប់ពណ៌ដែលកំពុងត្រូវបានគូរ ខណៈពេលដែល [param transpose] "
"បញ្ជាក់ថាតើការគូរគួរតែត្រូវបានអនុវត្តក្នុងលំដាប់ column-major ជំនួសឱ្យលំដាប់ row-major "
"(ដែលបណ្តាលឱ្យមានការបង្វិល 90 ដឺក្រេតាមទ្រនិចនាឡិកា)។\n"
"[b]ចំណាំ៖[/b] នេះត្រូវបានប្រើតែក្នុងការ render 2D ប៉ុណ្ណោះ មិនមែន 3D ទេ។"

msgid "Called when [method get_format] is called."
msgstr "ត្រូវបានហៅនៅពេលដែល [method get_format] ត្រូវបានហៅ។"

msgid "Called when the [Texture2D]'s height is queried."
msgstr "ត្រូវបានហៅនៅពេលដែលកម្ពស់របស់ [Texture2D] ត្រូវបានសាកសួរ។"

msgid "Called when [method get_image] is called."
msgstr "ត្រូវបានហៅនៅពេលដែល [method get_image] ត្រូវបានហៅ។"

msgid "Called when [method get_mipmap_count] is called."
msgstr "ត្រូវបានហៅនៅពេលដែល [method get_mipmap_count] ត្រូវបានហៅ។"

msgid "Called when the [Texture2D]'s width is queried."
msgstr "ត្រូវបានហៅនៅពេលដែលទទឹងរបស់ [Texture2D] ត្រូវបានសាកសួរ។"

msgid ""
"Called when the presence of an alpha channel in the [Texture2D] is queried."
msgstr "ត្រូវបានហៅនៅពេលដែលវត្តមាននៃ alpha channel នៅក្នុង [Texture2D] ត្រូវបានសាកសួរ។"

msgid "Called when [method has_mipmaps] is called."
msgstr "ត្រូវបានហៅនៅពេលដែល [method has_mipmaps] ត្រូវបានហៅ។"

msgid ""
"Called when a pixel's opaque state in the [Texture2D] is queried at the "
"specified [code](x, y)[/code] position."
msgstr ""
"ត្រូវបានហៅនៅពេលដែលស្ថានភាព opaque របស់ pixel នៅក្នុង [Texture2D] ត្រូវបានសាកសួរនៅទីតាំង "
"[code](x, y)[/code] ដែលបានបញ្ជាក់។"

msgid "Creates a placeholder version of this resource ([PlaceholderTexture2D])."
msgstr "បង្កើតកំណែ placeholder នៃធនធាននេះ ([PlaceholderTexture2D])។"

msgid ""
"Draws the texture using a [CanvasItem] with the [RenderingServer] API at the "
"specified [param position]."
msgstr ""
"គូរ texture ដោយប្រើ [CanvasItem] ជាមួយនឹង API [RenderingServer] នៅ [param "
"position] ដែលបានបញ្ជាក់។"

msgid "Draws the texture using a [CanvasItem] with the [RenderingServer] API."
msgstr "គូរ texture ដោយប្រើ [CanvasItem] ជាមួយនឹង API [RenderingServer]។"

msgid ""
"Draws a part of the texture using a [CanvasItem] with the [RenderingServer] "
"API."
msgstr "គូរផ្នែកមួយនៃ texture ដោយប្រើ [CanvasItem] ជាមួយនឹង API [RenderingServer]។"

msgid "Returns the image format of the texture."
msgstr "បង្វិលទម្រង់រូបភាព (image format) នៃ texture។"

msgid "Returns the texture height in pixels."
msgstr "បង្វិលកម្ពស់ texture គិតជា pixels។"

msgid ""
"Returns an [Image] that is a copy of data from this [Texture2D] (a new "
"[Image] is created each time). [Image]s can be accessed and manipulated "
"directly.\n"
"[b]Note:[/b] This will return [code]null[/code] if this [Texture2D] is "
"invalid.\n"
"[b]Note:[/b] This will fetch the texture data from the GPU, which might cause "
"performance problems when overused. Avoid calling [method get_image] every "
"frame, especially on large textures."
msgstr ""
"បង្វិល [Image] ដែលជាច្បាប់ចម្លងនៃទិន្នន័យពី [Texture2D] នេះ ([Image] "
"ថ្មីត្រូវបានបង្កើតរាល់ពេល)។ [Image]s អាចត្រូវបានចូលប្រើ និងកែប្រែដោយផ្ទាល់។\n"
"[b]ចំណាំ៖[/b] វានឹងបង្វិល [code]null[/code] ប្រសិនបើ [Texture2D] នេះមិនត្រឹមត្រូវ "
"(invalid)។\n"
"[b]ចំណាំ៖[/b] វានឹងទាញយកទិន្នន័យ texture ពី GPU "
"ដែលអាចបណ្តាលឱ្យមានបញ្ហាដំណើរការនៅពេលប្រើប្រាស់ច្រើនពេក។ សូមជៀសវាងការហៅ [method "
"get_image] រាល់ frame ជាពិសេសលើ textures ធំៗ។"

msgid "Returns the number of mipmaps of the texture."
msgstr "បង្វិលចំនួន mipmaps នៃ texture។"

msgid "Returns the texture size in pixels."
msgstr "បង្វិលទំហំ texture គិតជា pixels។"

msgid "Returns the texture width in pixels."
msgstr "បង្វិលទទឹង texture គិតជា pixels។"

msgid "Returns [code]true[/code] if this [Texture2D] has an alpha channel."
msgstr "បង្វិល [code]true[/code] ប្រសិនបើ [Texture2D] នេះមាន alpha channel។"

msgid "Returns [code]true[/code] if the texture has mipmaps."
msgstr "បង្វិល [code]true[/code] ប្រសិនបើ texture មាន mipmaps។"

msgid ""
"A single texture resource which consists of multiple, separate images. Each "
"image has the same dimensions and number of mipmap levels."
msgstr ""
"ធនធាន texture តែមួយដែលមានរូបភាពដាច់ដោយឡែកពីគ្នាជាច្រើន។ រូបភាពនីមួយៗមានវិមាត្រ និងចំនួនកម្រិត "
"mipmap ដូចគ្នា។"

msgid ""
"A Texture2DArray is different from a Texture3D: The Texture2DArray does not "
"support trilinear interpolation between the [Image]s, i.e. no blending. See "
"also [Cubemap] and [CubemapArray], which are texture arrays with specialized "
"cubemap functions.\n"
"A Texture2DArray is also different from an [AtlasTexture]: In a "
"Texture2DArray, all images are treated separately. In an atlas, the regions "
"(i.e. the single images) can be of different sizes. Furthermore, you usually "
"need to add a padding around the regions, to prevent accidental UV mapping to "
"more than one region. The same goes for mipmapping: Mipmap chains are handled "
"separately for each layer. In an atlas, the slicing has to be done manually "
"in the fragment shader.\n"
"To create such a texture file yourself, reimport your image files using the "
"Godot Editor import presets. To create a Texture2DArray from code, use "
"[method ImageTextureLayered.create_from_images] on an instance of the "
"Texture2DArray class."
msgstr ""
"Texture2DArray ខុសពី Texture3D៖ Texture2DArray មិនគាំទ្រ trilinear interpolation "
"រវាង [Image]s ទេ ពោលគឺគ្មានការ pha ពណ៌ (blending)។ សូមមើលផងដែរ [Cubemap] និង "
"[CubemapArray] ដែលជា texture arrays ជាមួយនឹងមុខងារ cubemap ពិសេស។\n"
"Texture2DArray ក៏ខុសពី [AtlasTexture] ដែរ៖ នៅក្នុង Texture2DArray "
"រូបភាពទាំងអស់ត្រូវបានដោះស្រាយដាច់ដោយឡែកពីគ្នា។ នៅក្នុង atlas តំបន់នានា (ពោលគឺរូបភាពនីមួយៗ) "
"អាចមានទំហំខុសគ្នា។ លើសពីនេះ ជាធម្មតាអ្នកត្រូវបន្ថែម padding នៅជុំវិញតំបន់នានា ដើម្បីការពារការ "
"UV mapping ដោយចៃដន្យទៅលើតំបន់លើសពីមួយ។ ចំពោះ mipmapping ក៏ដូចគ្នាដែរ៖ Mipmap chains "
"ត្រូវបានដោះស្រាយដាច់ដោយឡែកសម្រាប់ layer នីមួយៗ។ នៅក្នុង atlas ការកាត់ (slicing) "
"ត្រូវធ្វើដោយដៃនៅក្នុង fragment shader។\n"
"ដើម្បីបង្កើតឯកសារ texture បែបនេះដោយខ្លួនឯង សូម reimport ឯកសាររូបភាពរបស់អ្នកដោយប្រើ "
"Godot Editor import presets។ ដើម្បីបង្កើត Texture2DArray ពីកូដ សូមប្រើ [method "
"ImageTextureLayered.create_from_images] លើ instance នៃ class Texture2DArray។"

msgid ""
"Creates a placeholder version of this resource ([PlaceholderTexture2DArray])."
msgstr "បង្កើតកំណែ placeholder នៃធនធាននេះ ([PlaceholderTexture2DArray])។"

msgid ""
"Texture Array for 2D that is bound to a texture created on the "
"[RenderingDevice]."
msgstr ""
"Texture Array សម្រាប់ 2D ដែលភ្ជាប់ទៅនឹង texture ដែលបានបង្កើតលើ [RenderingDevice]។"

msgid ""
"This texture array class allows you to use a 2D array texture created "
"directly on the [RenderingDevice] as a texture for materials, meshes, etc.\n"
"[b]Note:[/b] [Texture2DArrayRD] is intended for low-level usage with "
"[RenderingDevice]. For most use cases, use [Texture2DArray] instead."
msgstr ""
"Class texture array នេះអនុញ្ញាតឱ្យអ្នកប្រើ 2D array texture ដែលបានបង្កើតដោយផ្ទាល់លើ "
"[RenderingDevice] ជា texture សម្រាប់ materials, meshes ។ល។\n"
"[b]ចំណាំ៖[/b] [Texture2DArrayRD] ត្រូវបានបម្រុងទុកសម្រាប់ការប្រើប្រាស់កម្រិតទាប (low-level) "
"ជាមួយ [RenderingDevice]។ សម្រាប់ករណីប្រើប្រាស់ភាគច្រើន សូមប្រើ [Texture2DArray] ជំនួសវិញ។"

msgid "Compute Texture demo"
msgstr "គម្រោងគំរូ Compute Texture"

msgid ""
"Texture for 2D that is bound to a texture created on the [RenderingDevice]."
msgstr "Texture សម្រាប់ 2D ដែលភ្ជាប់ទៅនឹង texture ដែលបានបង្កើតលើ [RenderingDevice]។"

msgid ""
"This texture class allows you to use a 2D texture created directly on the "
"[RenderingDevice] as a texture for materials, meshes, etc.\n"
"[b]Note:[/b] [Texture2DRD] is intended for low-level usage with "
"[RenderingDevice]. For most use cases, use [Texture2D] instead."
msgstr ""
"Class texture នេះអនុញ្ញាតឱ្យអ្នកប្រើ 2D texture ដែលបានបង្កើតដោយផ្ទាល់លើ "
"[RenderingDevice] ជា texture សម្រាប់ materials, meshes ។ល។\n"
"[b]ចំណាំ៖[/b] [Texture2DRD] ត្រូវបានបម្រុងទុកសម្រាប់ការប្រើប្រាស់កម្រិតទាបជាមួយ "
"[RenderingDevice]។ សម្រាប់ករណីប្រើប្រាស់ភាគច្រើន សូមប្រើ [Texture2D] ជំនួសវិញ។"

msgid "The RID of the texture object created on the [RenderingDevice]."
msgstr "RID នៃ texture object ដែលបានបង្កើតលើ [RenderingDevice]។"

msgid "Base class for 3-dimensional textures."
msgstr "Class មូលដ្ឋានសម្រាប់ textures 3 វិមាត្រ។"

msgid ""
"Base class for [ImageTexture3D] and [CompressedTexture3D]. Cannot be used "
"directly, but contains all the functions necessary for accessing the derived "
"resource types. [Texture3D] is the base class for all 3-dimensional texture "
"types. See also [TextureLayered].\n"
"All images need to have the same width, height and number of mipmap levels.\n"
"To create such a texture file yourself, reimport your image files using the "
"Godot Editor import presets."
msgstr ""
"Class មូលដ្ឋានសម្រាប់ [ImageTexture3D] និង [CompressedTexture3D]។ "
"មិនអាចប្រើដោយផ្ទាល់បានទេ ប៉ុន្តែមានអនុគមន៍ចាំបាច់ទាំងអស់សម្រាប់ការចូលប្រើប្រភេទធនធានដែលទាញចេញ "
"(derived resource types)។ [Texture3D] គឺជា class មូលដ្ឋានសម្រាប់គ្រប់ប្រភេទ texture 3 "
"វិមាត្រ។ សូមមើលផងដែរ [TextureLayered]។\n"
"រូបភាពទាំងអស់ត្រូវមានទទឹង កម្ពស់ និងចំនួនកម្រិត mipmap ដូចគ្នា។\n"
"ដើម្បីបង្កើតឯកសារ texture បែបនេះដោយខ្លួនឯង សូម reimport ឯកសាររូបភាពរបស់អ្នកដោយប្រើ "
"Godot Editor import presets។"

msgid "Called when the [Texture3D]'s data is queried."
msgstr "ត្រូវបានហៅនៅពេលដែលទិន្នន័យរបស់ [Texture3D] ត្រូវបានសាកសួរ។"

msgid "Called when the [Texture3D]'s depth is queried."
msgstr "ត្រូវបានហៅនៅពេលដែលជម្រៅរបស់ [Texture3D] ត្រូវបានសាកសួរ។"

msgid "Called when the [Texture3D]'s format is queried."
msgstr "ត្រូវបានហៅនៅពេលដែលទម្រង់របស់ [Texture3D] ត្រូវបានសាកសួរ។"

msgid "Called when the [Texture3D]'s height is queried."
msgstr "ត្រូវបានហៅនៅពេលដែលកម្ពស់របស់ [Texture3D] ត្រូវបានសាកសួរ។"

msgid "Called when the [Texture3D]'s width is queried."
msgstr "ត្រូវបានហៅនៅពេលដែលទទឹងរបស់ [Texture3D] ត្រូវបានសាកសួរ។"

msgid "Called when the presence of mipmaps in the [Texture3D] is queried."
msgstr "ត្រូវបានហៅនៅពេលដែលវត្តមាននៃ mipmaps នៅក្នុង [Texture3D] ត្រូវបានសាកសួរ។"

msgid "Creates a placeholder version of this resource ([PlaceholderTexture3D])."
msgstr "បង្កើតកំណែ placeholder នៃធនធាននេះ ([PlaceholderTexture3D])។"

msgid ""
"Returns the [Texture3D]'s data as an array of [Image]s. Each [Image] "
"represents a [i]slice[/i] of the [Texture3D], with different slices mapping "
"to different depth (Z axis) levels."
msgstr ""
"បង្វិលទិន្នន័យរបស់ [Texture3D] ជា array នៃ [Image]s។ [Image] នីមួយៗតំណាងឱ្យ [i]slice[/"
"i] នៃ [Texture3D] ដែល slices ផ្សេងគ្នាត្រូវនឹងកម្រិតជម្រៅ (អ័ក្ស Z) ផ្សេងគ្នា។"

msgid ""
"Returns the [Texture3D]'s depth in pixels. Depth is typically represented by "
"the Z axis (a dimension not present in [Texture2D])."
msgstr ""
"បង្វិលជម្រៅរបស់ [Texture3D] គិតជា pixels។ ជម្រៅជាធម្មតាត្រូវបានតំណាងដោយអ័ក្ស Z "
"(វិមាត្រដែលមិនមាននៅក្នុង [Texture2D])។"

msgid "Returns the current format being used by this texture."
msgstr "បង្វិលទម្រង់បច្ចុប្បន្នដែលកំពុងត្រូវបានប្រើដោយ texture នេះ។"

msgid ""
"Returns the [Texture3D]'s height in pixels. Width is typically represented by "
"the Y axis."
msgstr "បង្វិលកម្ពស់របស់ [Texture3D] គិតជា pixels។ កម្ពស់ជាធម្មតាត្រូវបានតំណាងដោយអ័ក្ស Y។"

msgid ""
"Returns the [Texture3D]'s width in pixels. Width is typically represented by "
"the X axis."
msgstr "បង្វិលទទឹងរបស់ [Texture3D] គិតជា pixels។ ទទឹងជាធម្មតាត្រូវបានតំណាងដោយអ័ក្ស X។"

msgid "Returns [code]true[/code] if the [Texture3D] has generated mipmaps."
msgstr "បង្វិល [code]true[/code] ប្រសិនបើ [Texture3D] បានបង្កើត mipmaps។"

msgid ""
"Texture for 3D that is bound to a texture created on the [RenderingDevice]."
msgstr "Texture សម្រាប់ 3D ដែលភ្ជាប់ទៅនឹង texture ដែលបានបង្កើតលើ [RenderingDevice]។"

msgid ""
"This texture class allows you to use a 3D texture created directly on the "
"[RenderingDevice] as a texture for materials, meshes, etc.\n"
"[b]Note:[/b] [Texture3DRD] is intended for low-level usage with "
"[RenderingDevice]. For most use cases, use [Texture3D] instead."
msgstr ""
"Class texture នេះអនុញ្ញាតឱ្យអ្នកប្រើ 3D texture ដែលបានបង្កើតដោយផ្ទាល់លើ "
"[RenderingDevice] ជា texture សម្រាប់ materials, meshes ។ល។\n"
"[b]ចំណាំ៖[/b] [Texture3DRD] ត្រូវបានបម្រុងទុកសម្រាប់ការប្រើប្រាស់កម្រិតទាបជាមួយ "
"[RenderingDevice]។ សម្រាប់ករណីប្រើប្រាស់ភាគច្រើន សូមប្រើ [Texture3D] ជំនួសវិញ។"

msgid ""
"Texture-based button. Supports Pressed, Hover, Disabled and Focused states."
msgstr "ប៊ូតុងផ្អែកលើ Texture។ គាំទ្រស្ថានភាព Pressed, Hover, Disabled និង Focused។"

msgid ""
"[TextureButton] has the same functionality as [Button], except it uses "
"sprites instead of Godot's [Theme] resource. It is faster to create, but it "
"doesn't support localization like more complex [Control]s.\n"
"See also [BaseButton] which contains common properties and methods associated "
"with this node.\n"
"[b]Note:[/b] Setting a texture for the \"normal\" state ([member "
"texture_normal]) is recommended. If [member texture_normal] is not set, the "
"[TextureButton] will still receive input events and be clickable, but the "
"user will not be able to see it unless they activate another one of its "
"states with a texture assigned (e.g., hover over it to show [member "
"texture_hover])."
msgstr ""
"[TextureButton] មានមុខងារដូចគ្នានឹង [Button] លើកលែងតែវាប្រើ sprites ជំនួសឱ្យធនធាន "
"[Theme] របស់ Godot។ វាអាចបង្កើតបានលឿនជាង ប៉ុន្តែវាមិនគាំទ្រការធ្វើមូលដ្ឋានីយកម្ម "
"(localization) ដូច [Control]s ដែលស្មុគស្មាញជាងនេះទេ។\n"
"សូមមើលផងដែរ [BaseButton] ដែលផ្ទុកលក្ខណៈសម្បត្តិ និងវិធីសាស្រ្តទូទៅដែលទាក់ទងនឹង node នេះ។\n"
"[b]ចំណាំ៖[/b] ការកំណត់ texture សម្រាប់ស្ថានភាព \"normal\" ([member texture_normal]) "
"ត្រូវបានណែនាំ។ ប្រសិនបើ [member texture_normal] មិនត្រូវបានកំណត់ទេ [TextureButton] "
"នៅតែទទួលព្រឹត្តិការណ៍បញ្ចូល (input events) ហើយអាចចុចបាន "
"ប៉ុន្តែអ្នកប្រើប្រាស់នឹងមិនអាចមើលឃើញវាទេ "
"លុះត្រាតែពួកគេដាក់ឱ្យដំណើរការស្ថានភាពផ្សេងទៀតដែលមានកំណត់ texture (ឧទាហរណ៍ ដាក់ mouse "
"ពីលើដើម្បីបង្ហាញ [member texture_hover])។"

msgid ""
"If [code]true[/code], the size of the texture won't be considered for minimum "
"size calculation, so the [TextureButton] can be shrunk down past the texture "
"size."
msgstr ""
"ប្រសិនបើ [code]true[/code] ទំហំរបស់ texture នឹងមិនត្រូវបានយកមកគណនាសម្រាប់ទំហំអប្បបរមាទេ "
"ដូច្នេះ [TextureButton] អាចត្រូវបានបង្រួមឱ្យតូចជាងទំហំ texture បាន។"

msgid ""
"Controls the texture's behavior when you resize the node's bounding "
"rectangle. See the [enum StretchMode] constants for available options."
msgstr ""
"គ្រប់គ្រងឥរិយាបថរបស់ texture នៅពេលដែលអ្នកផ្លាស់ប្តូរទំហំ bounding rectangle របស់ node។ "
"សូមមើលថេរ [enum StretchMode] សម្រាប់ជម្រើសដែលមាន។"

msgid ""
"Pure black and white [BitMap] image to use for click detection. On the mask, "
"white pixels represent the button's clickable area. Use it to create buttons "
"with curved shapes."
msgstr ""
"រូបភាព [BitMap] ពណ៌ខ្មៅ និងសសុទ្ធ ដើម្បីប្រើសម្រាប់ការរកឃើញការចុច (click detection)។ នៅលើ "
"mask ភីកសែលពណ៌សតំណាងឱ្យតំបន់ដែលអាចចុចបានរបស់ប៊ូតុង។ ប្រើវាដើម្បីបង្កើតប៊ូតុងដែលមានរាងកោង។"

msgid ""
"Texture to display when the node is disabled. See [member "
"BaseButton.disabled]. If not assigned, the [TextureButton] displays [member "
"texture_normal] instead."
msgstr ""
"Texture ដែលត្រូវបង្ហាញនៅពេលដែល node ត្រូវបានបិទ (disabled)។ សូមមើល [member "
"BaseButton.disabled]។ ប្រសិនបើមិនបានកំណត់ទេ [TextureButton] នឹងបង្ហាញ [member "
"texture_normal] ជំនួសវិញ។"

msgid ""
"Texture to [i]overlay on the base texture[/i] when the node has mouse or "
"keyboard focus. Because [member texture_focused] is displayed on top of the "
"base texture, a partially transparent texture should be used to ensure the "
"base texture remains visible. A texture that represents an outline or an "
"underline works well for this purpose. To disable the focus visual effect, "
"assign a fully transparent texture of any size. Note that disabling the focus "
"visual effect will harm keyboard/controller navigation usability, so this is "
"not recommended for accessibility reasons."
msgstr ""
"Texture ត្រូវ [i]ដាក់ត្រួតពីលើ base texture[/i] នៅពេលដែល node ទទួលបាន focus ពី mouse "
"ឬ keyboard។ ដោយសារ [member texture_focused] ត្រូវបានបង្ហាញពីលើ base texture គួរប្រើ "
"texture ដែលមានភាពថ្លា (transparent) ខ្លះៗ ដើម្បីធានាថា base texture "
"នៅតែអាចមើលឃើញ។ Texture ដែលតំណាងឱ្យគន្លង (outline) ឬបន្ទាត់គូសពីក្រោម (underline) "
"ដំណើរការបានល្អសម្រាប់គោលបំណងនេះ។ ដើម្បីបិទបែបផែនមើលឃើញពេល focus សូមកំណត់ texture "
"ថ្លាទាំងស្រុងក្នុងទំហំណាមួយ។ សូមចំណាំថាការបិទបែបផែនមើលឃើញពេល focus "
"នឹងធ្វើឱ្យប៉ះពាល់ដល់ភាពងាយស្រួលក្នុងការរុករកតាម keyboard/controller "
"ដូច្នេះវាមិនត្រូវបានណែនាំដោយសារមូលហេតុនៃភាពងាយស្រួលប្រើប្រាស់ (accessibility) ទេ។"

msgid ""
"Texture to display when the mouse hovers over the node. If not assigned, the "
"[TextureButton] displays [member texture_normal] instead when hovered over."
msgstr ""
"Texture ដែលត្រូវបង្ហាញនៅពេលដែល mouse ដាក់ពីលើ node។ ប្រសិនបើមិនបានកំណត់ទេ "
"[TextureButton] នឹងបង្ហាញ [member texture_normal] ជំនួសវិញនៅពេលដាក់ mouse ពីលើ។"

msgid ""
"Texture to display by default, when the node is [b]not[/b] in the disabled, "
"hover or pressed state. This texture is still displayed in the focused state, "
"with [member texture_focused] drawn on top."
msgstr ""
"Texture ដែលត្រូវបង្ហាញជាលំនាំដើម នៅពេលដែល node [b]មិនមែន[/b] ស្ថិតក្នុងស្ថានភាព "
"disabled, hover ឬ pressed។ Texture នេះនៅតែត្រូវបានបង្ហាញក្នុងស្ថានភាព focused "
"ដោយមាន [member texture_focused] គូរពីលើ។"

msgid ""
"Texture to display on mouse down over the node, if the node has keyboard "
"focus and the player presses the Enter key or if the player presses the "
"[member BaseButton.shortcut] key. If not assigned, the [TextureButton] "
"displays [member texture_hover] instead when pressed."
msgstr ""
"Texture ដែលត្រូវបង្ហាញនៅពេលចុច mouse លើ node ប្រសិនបើ node មាន keyboard focus "
"ហើយអ្នកលេងចុចគ្រាប់ចុច Enter ឬប្រសិនបើអ្នកលេងចុចគ្រាប់ចុច [member BaseButton.shortcut]។ "
"ប្រសិនបើមិនបានកំណត់ទេ [TextureButton] នឹងបង្ហាញ [member texture_hover] ជំនួសវិញនៅពេលចុច។"

msgid "Scale to fit the node's bounding rectangle."
msgstr "ធ្វើមាត្រដ្ឋានឱ្យសមនឹង bounding rectangle របស់ node។"

msgid "Tile inside the node's bounding rectangle."
msgstr "រៀបជាក្រឡា (Tile) នៅខាងក្នុង bounding rectangle របស់ node។"

msgid ""
"The texture keeps its original size and stays in the bounding rectangle's top-"
"left corner."
msgstr "Texture រក្សាទំហំដើមរបស់វា និងស្ថិតនៅជ្រុងខាងលើឆ្វេងនៃ bounding rectangle។"

msgid ""
"The texture keeps its original size and stays centered in the node's bounding "
"rectangle."
msgstr "Texture រក្សាទំហំដើមរបស់វា និងស្ថិតនៅចំកណ្តាលនៃ bounding rectangle របស់ node។"

msgid ""
"Scale the texture to fit the node's bounding rectangle, but maintain the "
"texture's aspect ratio."
msgstr ""
"ធ្វើមាត្រដ្ឋាន texture ឱ្យសមនឹង bounding rectangle របស់ node ប៉ុន្តែរក្សាសមាមាត្រ "
"(aspect ratio) របស់ texture។"

msgid ""
"Scale the texture to fit the node's bounding rectangle, center it, and "
"maintain its aspect ratio."
msgstr ""
"ធ្វើមាត្រដ្ឋាន texture ឱ្យសមនឹង bounding rectangle របស់ node ដាក់វាឱ្យនៅចំកណ្តាល "
"និងរក្សាសមាមាត្ររបស់វា។"

msgid ""
"Scale the texture so that the shorter side fits the bounding rectangle. The "
"other side clips to the node's limits."
msgstr ""
"ធ្វើមាត្រដ្ឋាន texture ដើម្បីឱ្យផ្នែកខ្លីសមនឹង bounding rectangle។ "
"ផ្នែកម្ខាងទៀតនឹងត្រូវបានកាត់ (clips) ត្រឹមព្រំដែនរបស់ node។"

msgid ""
"Texture Array for Cubemaps that is bound to a texture created on the "
"[RenderingDevice]."
msgstr ""
"Texture Array សម្រាប់ Cubemaps ដែលភ្ជាប់ទៅនឹង texture ដែលបានបង្កើតលើ "
"[RenderingDevice]។"

msgid ""
"This texture class allows you to use a cubemap array texture created directly "
"on the [RenderingDevice] as a texture for materials, meshes, etc.\n"
"[b]Note:[/b] [TextureCubemapArrayRD] is intended for low-level usage with "
"[RenderingDevice]. For most use cases, use [CubemapArray] instead."
msgstr ""
"Class texture នេះអនុញ្ញាតឱ្យអ្នកប្រើ cubemap array texture ដែលបានបង្កើតដោយផ្ទាល់លើ "
"[RenderingDevice] ជា texture សម្រាប់ materials, meshes ។ល។\n"
"[b]ចំណាំ៖[/b] [TextureCubemapArrayRD] ត្រូវបានបម្រុងទុកសម្រាប់ការប្រើប្រាស់កម្រិតទាបជាមួយ "
"[RenderingDevice]។ សម្រាប់ករណីប្រើប្រាស់ភាគច្រើន សូមប្រើ [CubemapArray] ជំនួសវិញ។"

msgid ""
"Texture for Cubemap that is bound to a texture created on the "
"[RenderingDevice]."
msgstr ""
"Texture សម្រាប់ Cubemap ដែលភ្ជាប់ទៅនឹង texture ដែលបានបង្កើតលើ [RenderingDevice]។"

msgid ""
"This texture class allows you to use a cubemap texture created directly on "
"the [RenderingDevice] as a texture for materials, meshes, etc.\n"
"[b]Note:[/b] [TextureCubemapRD] is intended for low-level usage with "
"[RenderingDevice]. For most use cases, use [Cubemap] instead."
msgstr ""
"Class texture នេះអនុញ្ញាតឱ្យអ្នកប្រើ cubemap texture ដែលបានបង្កើតដោយផ្ទាល់លើ "
"[RenderingDevice] ជា texture សម្រាប់ materials, meshes ។ល។\n"
"[b]ចំណាំ៖[/b] [TextureCubemapRD] ត្រូវបានបម្រុងទុកសម្រាប់ការប្រើប្រាស់កម្រិតទាបជាមួយ "
"[RenderingDevice]។ សម្រាប់ករណីប្រើប្រាស់ភាគច្រើន សូមប្រើ [Cubemap] ជំនួសវិញ។"

msgid ""
"Base class for texture types which contain the data of multiple [Image]s. "
"Each image is of the same size and format."
msgstr ""
"Class មូលដ្ឋានសម្រាប់ប្រភេទ texture ដែលផ្ទុកទិន្នន័យនៃ [Image]s ជាច្រើន។ រូបភាពនីមួយៗមានទំហំ "
"និងទម្រង់ដូចគ្នា។"

msgid ""
"Base class for [ImageTextureLayered] and [CompressedTextureLayered]. Cannot "
"be used directly, but contains all the functions necessary for accessing the "
"derived resource types. See also [Texture3D].\n"
"Data is set on a per-layer basis. For [Texture2DArray]s, the layer specifies "
"the array layer.\n"
"All images need to have the same width, height and number of mipmap levels.\n"
"A [TextureLayered] can be loaded with [method ResourceLoader.load].\n"
"Internally, Godot maps these files to their respective counterparts in the "
"target rendering driver (Vulkan, OpenGL3)."
msgstr ""
"Class មូលដ្ឋានសម្រាប់ [ImageTextureLayered] និង [CompressedTextureLayered]។ "
"មិនអាចប្រើដោយផ្ទាល់បានទេ ប៉ុន្តែមានអនុគមន៍ចាំបាច់ទាំងអស់សម្រាប់ការចូលប្រើប្រភេទធនធានដែលទាញចេញ។ "
"សូមមើលផងដែរ [Texture3D]។\n"
"ទិន្នន័យត្រូវបានកំណត់លើមូលដ្ឋាន layer នីមួយៗ។ សម្រាប់ [Texture2DArray]s, layer បញ្ជាក់ពី "
"array layer។\n"
"រូបភាពទាំងអស់ត្រូវមានទទឹង កម្ពស់ និងចំនួនកម្រិត mipmap ដូចគ្នា។\n"
"[TextureLayered] អាចត្រូវបានផ្ទុកដោយប្រើ [method ResourceLoader.load]។\n"
"ជាផ្ទៃក្នុង Godot ធ្វើការ map ឯកសារទាំងនេះទៅកាន់ដៃគូរៀងៗខ្លួនរបស់ពួកវានៅក្នុង target "
"rendering driver (Vulkan, OpenGL3)។"

msgid "Called when the [TextureLayered]'s format is queried."
msgstr "ត្រូវបានហៅនៅពេលដែលទម្រង់របស់ [TextureLayered] ត្រូវបានសាកសួរ។"

msgid "Called when the [TextureLayered]'s height is queried."
msgstr "ត្រូវបានហៅនៅពេលដែលកម្ពស់របស់ [TextureLayered] ត្រូវបានសាកសួរ។"

msgid "Called when the data for a layer in the [TextureLayered] is queried."
msgstr "ត្រូវបានហៅនៅពេលដែលទិន្នន័យសម្រាប់ layer នៅក្នុង [TextureLayered] ត្រូវបានសាកសួរ។"

msgid "Called when the layers' type in the [TextureLayered] is queried."
msgstr "ត្រូវបានហៅនៅពេលដែលប្រភេទ layers នៅក្នុង [TextureLayered] ត្រូវបានសាកសួរ។"

msgid "Called when the number of layers in the [TextureLayered] is queried."
msgstr "ត្រូវបានហៅនៅពេលដែលចំនួន layers នៅក្នុង [TextureLayered] ត្រូវបានសាកសួរ។"

msgid "Called when the [TextureLayered]'s width queried."
msgstr "ត្រូវបានហៅនៅពេលដែលទទឹងរបស់ [TextureLayered] ត្រូវបានសាកសួរ។"

msgid "Called when the presence of mipmaps in the [TextureLayered] is queried."
msgstr "ត្រូវបានហៅនៅពេលដែលវត្តមាននៃ mipmaps នៅក្នុង [TextureLayered] ត្រូវបានសាកសួរ។"

msgid ""
"Returns the height of the texture in pixels. Height is typically represented "
"by the Y axis."
msgstr "បង្វិលកម្ពស់របស់ texture គិតជា pixels។ កម្ពស់ជាធម្មតាត្រូវបានតំណាងដោយអ័ក្ស Y។"

msgid "Returns an [Image] resource with the data from specified [param layer]."
msgstr "បង្វិលធនធាន [Image] ជាមួយនឹងទិន្នន័យពី [param layer] ដែលបានបញ្ជាក់។"

msgid ""
"Returns the [TextureLayered]'s type. The type determines how the data is "
"accessed, with cubemaps having special types."
msgstr ""
"បង្វិលប្រភេទរបស់ [TextureLayered]។ ប្រភេទកំណត់ពីរបៀបដែលទិន្នន័យត្រូវបានចូលប្រើ ដែល cubemaps "
"មានប្រភេទពិសេស។"

msgid "Returns the number of referenced [Image]s."
msgstr "បង្វិលចំនួននៃ [Image]s ដែលបានយោង។"

msgid ""
"Returns the width of the texture in pixels. Width is typically represented by "
"the X axis."
msgstr "បង្វិលទទឹងរបស់ texture គិតជា pixels។ ទទឹងជាធម្មតាត្រូវបានតំណាងដោយអ័ក្ស X។"

msgid "Returns [code]true[/code] if the layers have generated mipmaps."
msgstr "បង្វិល [code]true[/code] ប្រសិនបើ layers បានបង្កើត mipmaps។"

msgid "Texture is a generic [Texture2DArray]."
msgstr "Texture គឺជា [Texture2DArray] ទូទៅ។"

msgid "Texture is a [Cubemap], with each side in its own layer (6 in total)."
msgstr "Texture គឺជា [Cubemap] ដែលផ្នែកនីមួយៗស្ថិតនៅក្នុង layer ផ្ទាល់ខ្លួន (សរុប 6)។"

msgid "Texture is a [CubemapArray], with each cubemap being made of 6 layers."
msgstr "Texture គឺជា [CubemapArray] ដែល cubemap នីមួយៗបង្កើតឡើងពី 6 layers។"

msgid "Abstract base class for layered texture RD types."
msgstr "Abstract base class សម្រាប់ប្រភេទ layered texture RD។"

msgid ""
"Base class for [Texture2DArrayRD], [TextureCubemapRD] and "
"[TextureCubemapArrayRD]. Cannot be used directly, but contains all the "
"functions necessary for accessing the derived resource types.\n"
"[b]Note:[/b] [TextureLayeredRD] is intended for low-level usage with "
"[RenderingDevice]. For most use cases, use [TextureLayered] instead."
msgstr ""
"Class មូលដ្ឋានសម្រាប់ [Texture2DArrayRD], [TextureCubemapRD] និង "
"[TextureCubemapArrayRD]។ មិនអាចប្រើដោយផ្ទាល់បានទេ "
"ប៉ុន្តែមានអនុគមន៍ចាំបាច់ទាំងអស់សម្រាប់ការចូលប្រើប្រភេទធនធានដែលទាញចេញ។\n"
"[b]ចំណាំ៖[/b] [TextureLayeredRD] ត្រូវបានបម្រុងទុកសម្រាប់ការប្រើប្រាស់កម្រិតទាបជាមួយ "
"[RenderingDevice]។ សម្រាប់ករណីប្រើប្រាស់ភាគច្រើន សូមប្រើ [TextureLayered] ជំនួសវិញ។"

msgid ""
"Texture-based progress bar. Useful for loading screens and life or stamina "
"bars."
msgstr ""
"របាដំណើរការ (progress bar) ផ្អែកលើ Texture។ មានប្រយោជន៍សម្រាប់អេក្រង់ផ្ទុក (loading "
"screens) និងរបាជីវិត ឬកម្លាំង (stamina bars)។"

msgid ""
"TextureProgressBar works like [ProgressBar], but uses up to 3 textures "
"instead of Godot's [Theme] resource. It can be used to create horizontal, "
"vertical and radial progress bars."
msgstr ""
"TextureProgressBar ដំណើរការដូច [ProgressBar] ប៉ុន្តែប្រើរហូតដល់ 3 textures ជំនួសឱ្យធនធាន "
"[Theme] របស់ Godot។ វាអាចត្រូវបានប្រើដើម្បីបង្កើតរបាដំណើរការផ្តេក បញ្ឈរ និងរង្វង់ (radial)។"

msgid ""
"Returns the stretch margin with the specified index. See [member "
"stretch_margin_bottom] and related properties."
msgstr ""
"បង្វិល stretch margin ជាមួយនឹង index ដែលបានបញ្ជាក់។ សូមមើល [member "
"stretch_margin_bottom] និងលក្ខណៈសម្បត្តិដែលពាក់ព័ន្ធ។"

msgid ""
"Sets the stretch margin with the specified index. See [member "
"stretch_margin_bottom] and related properties."
msgstr ""
"កំណត់ stretch margin ជាមួយនឹង index ដែលបានបញ្ជាក់។ សូមមើល [member "
"stretch_margin_bottom] និងលក្ខណៈសម្បត្តិដែលពាក់ព័ន្ធ។"

msgid ""
"If [code]true[/code], Godot treats the bar's textures like in "
"[NinePatchRect]. Use the [code]stretch_margin_*[/code] properties like "
"[member stretch_margin_bottom] to set up the nine patch's 3×3 grid. When "
"using a radial [member fill_mode], this setting will only enable stretching "
"for [member texture_progress], while [member texture_under] and [member "
"texture_over] will be treated like in [NinePatchRect]."
msgstr ""
"ប្រសិនបើ [code]true[/code] Godot ចាត់ទុក textures របស់របាដូចទៅនឹងក្នុង "
"[NinePatchRect]។ ប្រើលក្ខណៈសម្បត្តិ [code]stretch_margin_*[/code] ដូចជា [member "
"stretch_margin_bottom] ដើម្បីរៀបចំក្រឡា 3×3 របស់ nine patch។ នៅពេលប្រើ radial "
"[member fill_mode] ការកំណត់នេះនឹងអនុញ្ញាតឱ្យលាតសន្ធឹង (stretching) តែសម្រាប់ [member "
"texture_progress] ប៉ុណ្ណោះ ខណៈពេលដែល [member texture_under] និង [member "
"texture_over] នឹងត្រូវបានចាត់ទុកដូចក្នុង [NinePatchRect]។"

msgid ""
"Offsets [member texture_progress] if [member fill_mode] is [constant "
"FILL_CLOCKWISE], [constant FILL_COUNTER_CLOCKWISE], or [constant "
"FILL_CLOCKWISE_AND_COUNTER_CLOCKWISE].\n"
"[b]Note:[/b] The effective radial center always stays within the [member "
"texture_progress] bounds. If you need to move it outside the texture's "
"bounds, modify the [member texture_progress] to contain additional empty "
"space where needed."
msgstr ""
"រុញទី (Offsets) [member texture_progress] ប្រសិនបើ [member fill_mode] គឺជា "
"[constant FILL_CLOCKWISE], [constant FILL_COUNTER_CLOCKWISE], ឬ [constant "
"FILL_CLOCKWISE_AND_COUNTER_CLOCKWISE]។\n"
"[b]ចំណាំ៖[/b] ចំណុចកណ្តាលរង្វង់ជាក់ស្តែង (effective radial center) "
"តែងតែស្ថិតនៅក្នុងព្រំដែនរបស់ [member texture_progress]។ "
"ប្រសិនបើអ្នកត្រូវការផ្លាស់ទីវាទៅក្រៅព្រំដែនរបស់ texture សូមកែប្រែ [member texture_progress] "
"ដើម្បីឱ្យមានចន្លោះទទេបន្ថែមនៅកន្លែងដែលចាំបាច់។"

msgid ""
"Upper limit for the fill of [member texture_progress] if [member fill_mode] "
"is [constant FILL_CLOCKWISE], [constant FILL_COUNTER_CLOCKWISE], or [constant "
"FILL_CLOCKWISE_AND_COUNTER_CLOCKWISE]. When the node's [code]value[/code] is "
"equal to its [code]max_value[/code], the texture fills up to this angle.\n"
"See [member Range.value], [member Range.max_value]."
msgstr ""
"ដែនកំណត់ខាងលើសម្រាប់ការបំពេញរបស់ [member texture_progress] ប្រសិនបើ [member "
"fill_mode] គឺជា [constant FILL_CLOCKWISE], [constant FILL_COUNTER_CLOCKWISE], "
"ឬ [constant FILL_CLOCKWISE_AND_COUNTER_CLOCKWISE]។ នៅពេលដែល [code]value[/"
"code] របស់ node ស្មើនឹង [code]max_value[/code] របស់វា texture នឹងបំពេញរហូតដល់មុំនេះ។\n"
"សូមមើល [member Range.value], [member Range.max_value]។"

msgid ""
"Starting angle for the fill of [member texture_progress] if [member "
"fill_mode] is [constant FILL_CLOCKWISE], [constant FILL_COUNTER_CLOCKWISE], "
"or [constant FILL_CLOCKWISE_AND_COUNTER_CLOCKWISE]. When the node's "
"[code]value[/code] is equal to its [code]min_value[/code], the texture "
"doesn't show up at all. When the [code]value[/code] increases, the texture "
"fills and tends towards [member radial_fill_degrees].\n"
"[b]Note:[/b] [member radial_initial_angle] is wrapped between [code]0[/code] "
"and [code]360[/code] degrees (inclusive)."
msgstr ""
"មុំចាប់ផ្តើមសម្រាប់ការបំពេញរបស់ [member texture_progress] ប្រសិនបើ [member fill_mode] "
"គឺជា [constant FILL_CLOCKWISE], [constant FILL_COUNTER_CLOCKWISE], ឬ [constant "
"FILL_CLOCKWISE_AND_COUNTER_CLOCKWISE]។ នៅពេលដែល [code]value[/code] របស់ node "
"ស្មើនឹង [code]min_value[/code] របស់វា texture នឹងមិនបង្ហាញខ្លួនសោះ។ នៅពេលដែល "
"[code]value[/code] កើនឡើង texture នឹងបំពេញ និងមានទំនោរទៅរក [member "
"radial_fill_degrees]។\n"
"[b]ចំណាំ៖[/b] [member radial_initial_angle] ត្រូវបានរុំ (wrapped) ចន្លោះពី [code]0[/"
"code] និង [code]360[/code] ដឺក្រេ (រាប់បញ្ចូលទាំងពីរ)។"

msgid ""
"The height of the 9-patch's bottom row. A margin of 16 means the 9-slice's "
"bottom corners and side will have a height of 16 pixels. You can set all 4 "
"margin values individually to create panels with non-uniform borders. Only "
"effective if [member nine_patch_stretch] is [code]true[/code]."
msgstr ""
"កម្ពស់នៃជួរខាងក្រោមរបស់ 9-patch។ Margin 16 មានន័យថាជ្រុង និងចំហៀងខាងក្រោមរបស់ 9-slice "
"នឹងមានកម្ពស់ 16 pixels។ អ្នកអាចកំណត់តម្លៃ margin ទាំង 4 ដោយឡែកពីគ្នា ដើម្បីបង្កើត panels "
"ដែលមានគែមមិនស្មើគ្នា។ មានប្រសិទ្ធភាពតែនៅពេលដែល [member nine_patch_stretch] គឺ "
"[code]true[/code] ប៉ុណ្ណោះ។"

msgid ""
"The width of the 9-patch's left column. Only effective if [member "
"nine_patch_stretch] is [code]true[/code]."
msgstr ""
"ទទឹងនៃជួរឈរខាងឆ្វេងរបស់ 9-patch។ មានប្រសិទ្ធភាពតែនៅពេលដែល [member "
"nine_patch_stretch] គឺ [code]true[/code] ប៉ុណ្ណោះ។"

msgid ""
"The width of the 9-patch's right column. Only effective if [member "
"nine_patch_stretch] is [code]true[/code]."
msgstr ""
"ទទឹងនៃជួរឈរខាងស្តាំរបស់ 9-patch។ មានប្រសិទ្ធភាពតែនៅពេលដែល [member nine_patch_stretch] "
"គឺ [code]true[/code] ប៉ុណ្ណោះ។"

msgid ""
"The height of the 9-patch's top row. Only effective if [member "
"nine_patch_stretch] is [code]true[/code]."
msgstr ""
"កម្ពស់នៃជួរខាងលើរបស់ 9-patch។ មានប្រសិទ្ធភាពតែនៅពេលដែល [member nine_patch_stretch] គឺ "
"[code]true[/code] ប៉ុណ្ណោះ។"

msgid ""
"[Texture2D] that draws over the progress bar. Use it to add highlights or an "
"upper-frame that hides part of [member texture_progress]."
msgstr ""
"[Texture2D] ដែលគូរពីលើ progress bar។ ប្រើវាដើម្បីបន្ថែម highlights ឬ frame "
"ខាងលើដែលលាក់ផ្នែកខ្លះនៃ [member texture_progress]។"

msgid ""
"[Texture2D] that clips based on the node's [code]value[/code] and [member "
"fill_mode]. As [code]value[/code] increased, the texture fills up. It shows "
"entirely when [code]value[/code] reaches [code]max_value[/code]. It doesn't "
"show at all if [code]value[/code] is equal to [code]min_value[/code].\n"
"The [code]value[/code] property comes from [Range]. See [member Range.value], "
"[member Range.min_value], [member Range.max_value]."
msgstr ""
"[Texture2D] ដែលកាត់ (clips) ដោយផ្អែកលើ [code]value[/code] របស់ node និង [member "
"fill_mode]។ នៅពេលដែល [code]value[/code] កើនឡើង texture នឹងបំពេញ។ "
"វាបង្ហាញទាំងស្រុងនៅពេលដែល [code]value[/code] ឈានដល់ [code]max_value[/code]។ "
"វាមិនបង្ហាញសោះ ប្រសិនបើ [code]value[/code] ស្មើនឹង [code]min_value[/code]។\n"
"លក្ខណៈសម្បត្តិ [code]value[/code] បានមកពី [Range]។ សូមមើល [member Range.value], "
"[member Range.min_value], [member Range.max_value]។"

msgid ""
"The offset of [member texture_progress]. Useful for [member texture_over] and "
"[member texture_under] with fancy borders, to avoid transparent margins in "
"your progress texture."
msgstr ""
"គម្លាត (offset) របស់ [member texture_progress]។ មានប្រយោជន៍សម្រាប់ [member "
"texture_over] និង [member texture_under] ដែលមានគែមស្អាត ដើម្បីជៀសវាងគែមថ្លា "
"(transparent margins) នៅក្នុង progress texture របស់អ្នក។"

msgid "[Texture2D] that draws under the progress bar. The bar's background."
msgstr "[Texture2D] ដែលគូរនៅខាងក្រោម progress bar។ ជាផ្ទៃខាងក្រោយរបស់របា។"

msgid ""
"Multiplies the color of the bar's [member texture_over] texture. The effect "
"is similar to [member CanvasItem.modulate], except it only affects this "
"specific texture instead of the entire node."
msgstr ""
"គុណពណ៌នៃ texture [member texture_over] របស់របា។ ឥទ្ធិពលគឺស្រដៀងនឹង [member "
"CanvasItem.modulate] លើកលែងតែវាជះឥទ្ធិពលតែលើ texture ជាក់លាក់នេះប៉ុណ្ណោះ ជំនួសឱ្យ node "
"ទាំងមូល។"

msgid "Multiplies the color of the bar's [member texture_progress] texture."
msgstr "គុណពណ៌នៃ texture [member texture_progress] របស់របា។"

msgid "Multiplies the color of the bar's [member texture_under] texture."
msgstr "គុណពណ៌នៃ texture [member texture_under] របស់របា។"

msgid "The [member texture_progress] fills from left to right."
msgstr "[member texture_progress] បំពេញពីឆ្វេងទៅស្តាំ។"

msgid "The [member texture_progress] fills from right to left."
msgstr "[member texture_progress] បំពេញពីស្តាំទៅឆ្វេង។"

msgid "The [member texture_progress] fills from top to bottom."
msgstr "[member texture_progress] បំពេញពីលើចុះក្រោម។"

msgid "The [member texture_progress] fills from bottom to top."
msgstr "[member texture_progress] បំពេញពីក្រោមឡើងលើ។"

msgid ""
"Turns the node into a radial bar. The [member texture_progress] fills "
"clockwise. See [member radial_center_offset], [member radial_initial_angle] "
"and [member radial_fill_degrees] to control the way the bar fills up."
msgstr ""
"ប្រែ node ទៅជារបារង្វង់ (radial bar)។ [member texture_progress] "
"បំពេញតាមទ្រនិចនាឡិកា។ សូមមើល [member radial_center_offset], [member "
"radial_initial_angle] និង [member radial_fill_degrees] "
"ដើម្បីគ្រប់គ្រងរបៀបដែលរបាបំពេញ។"

msgid ""
"Turns the node into a radial bar. The [member texture_progress] fills "
"counterclockwise. See [member radial_center_offset], [member "
"radial_initial_angle] and [member radial_fill_degrees] to control the way the "
"bar fills up."
msgstr ""
"ប្រែ node ទៅជារបារង្វង់។ [member texture_progress] បំពេញបញ្ច្រាសទ្រនិចនាឡិកា។ សូមមើល "
"[member radial_center_offset], [member radial_initial_angle] និង [member "
"radial_fill_degrees] ដើម្បីគ្រប់គ្រងរបៀបដែលរបាបំពេញ។"

msgid ""
"The [member texture_progress] fills from the center, expanding both towards "
"the left and the right."
msgstr "[member texture_progress] បំពេញពីចំណុចកណ្តាល ដោយរីកទៅរកទាំងខាងឆ្វេង និងខាងស្តាំ។"

msgid ""
"The [member texture_progress] fills from the center, expanding both towards "
"the top and the bottom."
msgstr "[member texture_progress] បំពេញពីចំណុចកណ្តាល ដោយរីកទៅរកទាំងខាងលើ និងខាងក្រោម។"

msgid ""
"Turns the node into a radial bar. The [member texture_progress] fills "
"radially from the center, expanding both clockwise and counterclockwise. See "
"[member radial_center_offset], [member radial_initial_angle] and [member "
"radial_fill_degrees] to control the way the bar fills up."
msgstr ""
"ប្រែ node ទៅជារបារង្វង់។ [member texture_progress] បំពេញជារង្វង់ពីចំណុចកណ្តាល "
"ដោយរីកទាំងតាមទ្រនិចនាឡិកា និងបញ្ច្រាសទ្រនិចនាឡិកា។ សូមមើល [member radial_center_offset], "
"[member radial_initial_angle] និង [member radial_fill_degrees] "
"ដើម្បីគ្រប់គ្រងរបៀបដែលរបាបំពេញ។"

msgid "A control that displays a texture."
msgstr "Control ដែលបង្ហាញ texture។"

msgid ""
"A control that displays a texture, for example an icon inside a GUI. The "
"texture's placement can be controlled with the [member stretch_mode] "
"property. It can scale, tile, or stay centered inside its bounding rectangle."
msgstr ""
"Control ដែលបង្ហាញ texture ឧទាហរណ៍ icon នៅខាងក្នុង GUI។ ការដាក់របស់ texture "
"អាចត្រូវបានគ្រប់គ្រងជាមួយនឹងលក្ខណៈសម្បត្តិ [member stretch_mode]។ វាអាចធ្វើមាត្រដ្ឋាន "
"រៀបជាក្រឡា ឬស្ថិតនៅចំកណ្តាលខាងក្នុង bounding rectangle របស់វា។"

msgid ""
"Using [constant EXPAND_FIT_WIDTH], [constant EXPAND_FIT_WIDTH_PROPORTIONAL], "
"[constant EXPAND_FIT_HEIGHT], or [constant EXPAND_FIT_HEIGHT_PROPORTIONAL] "
"may result in unstable behavior in some [Container] controls. This behavior "
"may be re-evaluated and changed in the future."
msgstr ""
"ការប្រើ [constant EXPAND_FIT_WIDTH], [constant EXPAND_FIT_WIDTH_PROPORTIONAL], "
"[constant EXPAND_FIT_HEIGHT], ឬ [constant EXPAND_FIT_HEIGHT_PROPORTIONAL] "
"អាចបណ្តាលឱ្យមានឥរិយាបថមិនច្បាស់លាស់នៅក្នុង [Container] controls មួយចំនួន។ "
"ឥរិយាបថនេះអាចនឹងត្រូវបានវាយតម្លៃ និងផ្លាស់ប្តូរនៅពេលអនាគត។"

msgid "Defines how minimum size is determined based on the texture's size."
msgstr "កំណត់ពីរបៀបដែលទំហំអប្បបរមាត្រូវបានកំណត់ដោយផ្អែកលើទំហំរបស់ texture។"

msgid ""
"Controls the texture's behavior when resizing the node's bounding rectangle."
msgstr "គ្រប់គ្រងឥរិយាបថរបស់ texture នៅពេលផ្លាស់ប្តូរទំហំ bounding rectangle របស់ node។"

msgid "The node's [Texture2D] resource."
msgstr "ធនធាន [Texture2D] របស់ node។"

msgid ""
"The minimum size will be equal to texture size, i.e. [TextureRect] can't be "
"smaller than the texture."
msgstr "ទំហំអប្បបរមានឹងស្មើនឹងទំហំ texture ពោលគឺ [TextureRect] មិនអាចតូចជាង texture បានទេ។"

msgid ""
"The size of the texture won't be considered for minimum size calculation, so "
"the [TextureRect] can be shrunk down past the texture size."
msgstr ""
"ទំហំរបស់ texture នឹងមិនត្រូវបានយកមកគណនាសម្រាប់ទំហំអប្បបរមាទេ ដូច្នេះ [TextureRect] "
"អាចត្រូវបានបង្រួមឱ្យតូចជាងទំហំ texture បាន។"

msgid ""
"The height of the texture will be ignored. Minimum width will be equal to the "
"current height. Useful for horizontal layouts, e.g. inside [HBoxContainer]."
msgstr ""
"កម្ពស់របស់ texture នឹងត្រូវបានមិនអើពើ។ ទទឹងអប្បបរមានឹងស្មើនឹងកម្ពស់បច្ចុប្បន្ន។ "
"មានប្រយោជន៍សម្រាប់ការរៀបចំផ្តេក ឧទាហរណ៍ នៅខាងក្នុង [HBoxContainer]។"

msgid "Same as [constant EXPAND_FIT_WIDTH], but keeps texture's aspect ratio."
msgstr "ដូចគ្នានឹង [constant EXPAND_FIT_WIDTH] ដែរ ប៉ុន្តែរក្សាសមាមាត្ររបស់ texture។"

msgid ""
"The width of the texture will be ignored. Minimum height will be equal to the "
"current width. Useful for vertical layouts, e.g. inside [VBoxContainer]."
msgstr ""
"ទទឹងរបស់ texture នឹងត្រូវបានមិនអើពើ។ កម្ពស់អប្បបរមានឹងស្មើនឹងទទឹងបច្ចុប្បន្ន។ "
"មានប្រយោជន៍សម្រាប់ការរៀបចំបញ្ឈរ ឧទាហរណ៍ នៅខាងក្នុង [VBoxContainer]។"

msgid "Same as [constant EXPAND_FIT_HEIGHT], but keeps texture's aspect ratio."
msgstr "ដូចគ្នានឹង [constant EXPAND_FIT_HEIGHT] ដែរ ប៉ុន្តែរក្សាសមាមាត្ររបស់ texture។"

msgid ""
"Tile inside the node's bounding rectangle.\n"
"[b]Note:[/b] [constant STRETCH_TILE] mode is not supported for [member "
"texture] set to an [AtlasTexture] with non-zero [member AtlasTexture.margin]."
msgstr ""
"រៀបជាក្រឡានៅខាងក្នុង bounding rectangle របស់ node។\n"
"[b]ចំណាំ៖[/b] របៀប [constant STRETCH_TILE] មិនត្រូវបានគាំទ្រទេសម្រាប់ [member texture] "
"ដែលបានកំណត់ទៅជា [AtlasTexture] ជាមួយនឹង [member AtlasTexture.margin] មិនស្មើសូន្យ។"

msgid ""
"Scale the texture to fit the node's bounding rectangle, center it and "
"maintain its aspect ratio."
msgstr ""
"ធ្វើមាត្រដ្ឋាន texture ឱ្យសមនឹង bounding rectangle របស់ node ដាក់វាឱ្យនៅចំកណ្តាល "
"និងរក្សាសមាមាត្ររបស់វា។"

msgid "A resource used for styling/skinning [Control]s and [Window]s."
msgstr "ធនធានដែលប្រើសម្រាប់ styling/skinning [Control]s និង [Window]s។"

msgid ""
"A resource used for styling/skinning [Control] and [Window] nodes. While "
"individual controls can be styled using their local theme overrides (see "
"[method Control.add_theme_color_override]), theme resources allow you to "
"store and apply the same settings across all controls sharing the same type "
"(e.g. style all [Button]s the same). One theme resource can be used for the "
"entire project, but you can also set a separate theme resource to a branch of "
"control nodes. A theme resource assigned to a control applies to the control "
"itself, as well as all of its direct and indirect children (as long as a "
"chain of controls is uninterrupted).\n"
"Use [member ProjectSettings.gui/theme/custom] to set up a project-scope theme "
"that will be available to every control in your project.\n"
"Use [member Control.theme] of any control node to set up a theme that will be "
"available to that control and all of its direct and indirect children."
msgstr ""
"ធនធានដែលប្រើសម្រាប់ styling/skinning nodes [Control] និង [Window]។ ខណៈពេលដែល "
"controls នីមួយៗអាចត្រូវបាន styling ដោយប្រើ local theme overrides របស់ពួកវា (សូមមើល "
"[method Control.add_theme_color_override]) ធនធាន theme អនុញ្ញាតឱ្យអ្នករក្សាទុក "
"និងអនុវត្តការកំណត់ដូចគ្នានៅលើ controls ទាំងអស់ដែលមានប្រភេទដូចគ្នា (ឧ. style គ្រប់ [Button]s "
"ឱ្យដូចគ្នា)។ ធនធាន theme មួយអាចត្រូវបានប្រើសម្រាប់គម្រោងទាំងមូល ប៉ុន្តែអ្នកក៏អាចកំណត់ធនធាន theme "
"ដាច់ដោយឡែកទៅកាន់ branch នៃ control nodes ផងដែរ។ ធនធាន theme ដែលបានកំណត់ទៅ control "
"នឹងអនុវត្តចំពោះ control ខ្លួនឯង ក៏ដូចជា children ផ្ទាល់ និងមិនផ្ទាល់របស់វាទាំងអស់ (ដរាបណា "
"chain នៃ controls មិនត្រូវបានកាត់ផ្តាច់)។\n"
"ប្រើ [member ProjectSettings.gui/theme/custom] ដើម្បីរៀបចំ theme កម្រិតគម្រោង "
"ដែលនឹងអាចប្រើបានសម្រាប់គ្រប់ control នៅក្នុងគម្រោងរបស់អ្នក។\n"
"ប្រើ [member Control.theme] នៃ control node ណាមួយ ដើម្បីរៀបចំ theme "
"ដែលនឹងអាចប្រើបានសម្រាប់ control នោះ និង children ផ្ទាល់ និងមិនផ្ទាល់របស់វាទាំងអស់។"

msgid "GUI skinning"
msgstr "ការតុបតែង GUI (GUI skinning)"

msgid "Using the theme editor"
msgstr "ការប្រើប្រាស់កម្មវិធីកែសម្រួល theme"

msgid ""
"Adds an empty theme type for every valid data type.\n"
"[b]Note:[/b] Empty types are not saved with the theme. This method only "
"exists to perform in-memory changes to the resource. Use available "
"[code]set_*[/code] methods to add theme items."
msgstr ""
"បន្ថែមប្រភេទ theme ទទេសម្រាប់គ្រប់ប្រភេទទិន្នន័យដែលត្រឹមត្រូវ។\n"
"[b]ចំណាំ៖[/b] ប្រភេទទទេមិនត្រូវបានរក្សាទុកជាមួយ theme ទេ។ "
"វិធីសាស្រ្តនេះមានតែដើម្បីធ្វើការផ្លាស់ប្តូរក្នុងអង្គចងចាំទៅលើធនធានប៉ុណ្ណោះ។ ប្រើវិធីសាស្រ្ត "
"[code]set_*[/code] ដែលមានដើម្បីបន្ថែម theme items។"

msgid "Removes all the theme properties defined on the theme resource."
msgstr "លុបលក្ខណៈសម្បត្តិ theme ទាំងអស់ដែលបានកំណត់លើធនធាន theme។"

msgid ""
"Removes the [Color] property defined by [param name] and [param theme_type], "
"if it exists.\n"
"Fails if it doesn't exist. Use [method has_color] to check for existence."
msgstr ""
"លុបលក្ខណៈសម្បត្តិ [Color] ដែលបានកំណត់ដោយ [param name] និង [param theme_type] "
"ប្រសិនបើវាមាន។\n"
"នឹងបរាជ័យ ប្រសិនបើវាមិនមាន។ ប្រើ [method has_color] ដើម្បីពិនិត្យមើលវត្តមាន។"

msgid ""
"Removes the constant property defined by [param name] and [param theme_type], "
"if it exists.\n"
"Fails if it doesn't exist. Use [method has_constant] to check for existence."
msgstr ""
"លុបលក្ខណៈសម្បត្តិ constant ដែលបានកំណត់ដោយ [param name] និង [param theme_type] "
"ប្រសិនបើវាមាន។\n"
"នឹងបរាជ័យ ប្រសិនបើវាមិនមាន។ ប្រើ [method has_constant] ដើម្បីពិនិត្យមើលវត្តមាន។"

msgid ""
"Removes the [Font] property defined by [param name] and [param theme_type], "
"if it exists.\n"
"Fails if it doesn't exist. Use [method has_font] to check for existence."
msgstr ""
"លុបលក្ខណៈសម្បត្តិ [Font] ដែលបានកំណត់ដោយ [param name] និង [param theme_type] "
"ប្រសិនបើវាមាន។\n"
"នឹងបរាជ័យ ប្រសិនបើវាមិនមាន។ ប្រើ [method has_font] ដើម្បីពិនិត្យមើលវត្តមាន។"

msgid ""
"Removes the font size property defined by [param name] and [param "
"theme_type], if it exists.\n"
"Fails if it doesn't exist. Use [method has_font_size] to check for existence."
msgstr ""
"លុបលក្ខណៈសម្បត្តិទំហំពុម្ពអក្សរ (font size) ដែលបានកំណត់ដោយ [param name] និង [param "
"theme_type] ប្រសិនបើវាមាន។\n"
"នឹងបរាជ័យ ប្រសិនបើវាមិនមាន។ ប្រើ [method has_font_size] ដើម្បីពិនិត្យមើលវត្តមាន។"

msgid ""
"Removes the icon property defined by [param name] and [param theme_type], if "
"it exists.\n"
"Fails if it doesn't exist. Use [method has_icon] to check for existence."
msgstr ""
"លុបលក្ខណៈសម្បត្តិ icon ដែលបានកំណត់ដោយ [param name] និង [param theme_type] "
"ប្រសិនបើវាមាន។\n"
"នឹងបរាជ័យ ប្រសិនបើវាមិនមាន។ ប្រើ [method has_icon] ដើម្បីពិនិត្យមើលវត្តមាន។"

msgid ""
"Removes the [StyleBox] property defined by [param name] and [param "
"theme_type], if it exists.\n"
"Fails if it doesn't exist. Use [method has_stylebox] to check for existence."
msgstr ""
"លុបលក្ខណៈសម្បត្តិ [StyleBox] ដែលបានកំណត់ដោយ [param name] និង [param theme_type] "
"ប្រសិនបើវាមាន។\n"
"នឹងបរាជ័យ ប្រសិនបើវាមិនមាន។ ប្រើ [method has_stylebox] ដើម្បីពិនិត្យមើលវត្តមាន។"

msgid ""
"Removes the theme property of [param data_type] defined by [param name] and "
"[param theme_type], if it exists.\n"
"Fails if it doesn't exist. Use [method has_theme_item] to check for "
"existence.\n"
"[b]Note:[/b] This method is analogous to calling the corresponding data type "
"specific method, but can be used for more generalized logic."
msgstr ""
"លុបលក្ខណៈសម្បត្តិ theme នៃ [param data_type] ដែលបានកំណត់ដោយ [param name] និង [param "
"theme_type] ប្រសិនបើវាមាន។\n"
"នឹងបរាជ័យ ប្រសិនបើវាមិនមាន។ ប្រើ [method has_theme_item] ដើម្បីពិនិត្យមើលវត្តមាន។\n"
"[b]ចំណាំ៖[/b] វិធីសាស្រ្តនេះស្រដៀងនឹងការហៅវិធីសាស្រ្តជាក់លាក់នៃប្រភេទទិន្នន័យដែលត្រូវគ្នា "
"ប៉ុន្តែអាចត្រូវបានប្រើសម្រាប់តក្កវិជ្ជាទូទៅជាងនេះ។"

msgid ""
"Unmarks [param theme_type] as being a variation of another theme type. See "
"[method set_type_variation]."
msgstr ""
"លុបសម្គាល់ [param theme_type] ថាជា variation នៃប្រភេទ theme ផ្សេងទៀត។ សូមមើល "
"[method set_type_variation]។"

msgid ""
"Returns the [Color] property defined by [param name] and [param theme_type], "
"if it exists.\n"
"Returns the default color value if the property doesn't exist. Use [method "
"has_color] to check for existence."
msgstr ""
"បង្វិលលក្ខណៈសម្បត្តិ [Color] ដែលបានកំណត់ដោយ [param name] និង [param theme_type] "
"ប្រសិនបើវាមាន។\n"
"បង្វិលតម្លៃពណ៌លំនាំដើម ប្រសិនបើលក្ខណៈសម្បត្តិនេះមិនមាន។ ប្រើ [method has_color] "
"ដើម្បីពិនិត្យមើលវត្តមាន។"

msgid ""
"Returns a list of names for [Color] properties defined with [param "
"theme_type]. Use [method get_color_type_list] to get a list of possible theme "
"type names."
msgstr ""
"បង្វិលបញ្ជីឈ្មោះសម្រាប់លក្ខណៈសម្បត្តិ [Color] ដែលបានកំណត់ជាមួយ [param theme_type]។ ប្រើ "
"[method get_color_type_list] ដើម្បីទទួលបានបញ្ជីឈ្មោះប្រភេទ theme ដែលអាចមាន។"

msgid ""
"Returns a list of all unique theme type names for [Color] properties. Use "
"[method get_type_list] to get a list of all unique theme types."
msgstr ""
"បង្វិលបញ្ជីឈ្មោះប្រភេទ theme ប្លែកៗទាំងអស់សម្រាប់លក្ខណៈសម្បត្តិ [Color]។ ប្រើ [method "
"get_type_list] ដើម្បីទទួលបានបញ្ជីប្រភេទ theme ប្លែកៗទាំងអស់។"

msgid ""
"Returns the constant property defined by [param name] and [param theme_type], "
"if it exists.\n"
"Returns [code]0[/code] if the property doesn't exist. Use [method "
"has_constant] to check for existence."
msgstr ""
"បង្វិលលក្ខណៈសម្បត្តិ constant ដែលបានកំណត់ដោយ [param name] និង [param theme_type] "
"ប្រសិនបើវាមាន។\n"
"បង្វិល [code]0[/code] ប្រសិនបើលក្ខណៈសម្បត្តិនេះមិនមាន។ ប្រើ [method has_constant] "
"ដើម្បីពិនិត្យមើលវត្តមាន។"

msgid ""
"Returns a list of names for constant properties defined with [param "
"theme_type]. Use [method get_constant_type_list] to get a list of possible "
"theme type names."
msgstr ""
"បង្វិលបញ្ជីឈ្មោះសម្រាប់លក្ខណៈសម្បត្តិ constant ដែលបានកំណត់ជាមួយ [param theme_type]។ ប្រើ "
"[method get_constant_type_list] ដើម្បីទទួលបានបញ្ជីឈ្មោះប្រភេទ theme ដែលអាចមាន។"

msgid ""
"Returns a list of all unique theme type names for constant properties. Use "
"[method get_type_list] to get a list of all unique theme types."
msgstr ""
"បង្វិលបញ្ជីឈ្មោះប្រភេទ theme ប្លែកៗទាំងអស់សម្រាប់លក្ខណៈសម្បត្តិ constant។ ប្រើ [method "
"get_type_list] ដើម្បីទទួលបានបញ្ជីប្រភេទ theme ប្លែកៗទាំងអស់។"

msgid ""
"Returns the [Font] property defined by [param name] and [param theme_type], "
"if it exists.\n"
"Returns the default theme font if the property doesn't exist and the default "
"theme font is set up (see [member default_font]). Use [method has_font] to "
"check for existence of the property and [method has_default_font] to check "
"for existence of the default theme font.\n"
"Returns the engine fallback font value, if neither exist (see [member "
"ThemeDB.fallback_font])."
msgstr ""
"បង្វិលលក្ខណៈសម្បត្តិ [Font] ដែលបានកំណត់ដោយ [param name] និង [param theme_type] "
"ប្រសិនបើវាមាន។\n"
"បង្វិលពុម្ពអក្សរ theme លំនាំដើម ប្រសិនបើលក្ខណៈសម្បត្តិនេះមិនមាន ហើយពុម្ពអក្សរ theme "
"លំនាំដើមត្រូវបានកំណត់ (សូមមើល [member default_font])។ ប្រើ [method has_font] "
"ដើម្បីពិនិត្យមើលវត្តមាននៃលក្ខណៈសម្បត្តិ និង [method has_default_font] "
"ដើម្បីពិនិត្យមើលវត្តមាននៃពុម្ពអក្សរ theme លំនាំដើម។\n"
"បង្វិលតម្លៃពុម្ពអក្សរ fallback របស់ engine ប្រសិនបើទាំងពីរមិនមាន (សូមមើល [member "
"ThemeDB.fallback_font])។"

msgid ""
"Returns a list of names for [Font] properties defined with [param "
"theme_type]. Use [method get_font_type_list] to get a list of possible theme "
"type names."
msgstr ""
"ត្រឡប់បញ្ជីឈ្មោះសម្រាប់លក្ខណៈសម្បត្តិ [Font] ដែលបានកំណត់ជាមួយ [param theme_type]។ ប្រើ "
"[method get_font_type_list] ដើម្បីទទួលបានបញ្ជីឈ្មោះប្រភេទ theme ដែលអាចមាន។"

msgid ""
"Returns the font size property defined by [param name] and [param "
"theme_type], if it exists.\n"
"Returns the default theme font size if the property doesn't exist and the "
"default theme font size is set up (see [member default_font_size]). Use "
"[method has_font_size] to check for existence of the property and [method "
"has_default_font_size] to check for existence of the default theme font.\n"
"Returns the engine fallback font size value, if neither exist (see [member "
"ThemeDB.fallback_font_size])."
msgstr ""
"ត្រឡប់លក្ខណៈសម្បត្តិ font size ដែលកំណត់ដោយ [param name] និង [param theme_type] "
"ប្រសិនបើវាមាន។\n"
"ត្រឡប់ font size លំនាំដើមរបស់ theme ប្រសិនបើលក្ខណៈសម្បត្តិនេះមិនមាន ហើយ font size "
"លំនាំដើមរបស់ theme ត្រូវបានកំណត់ (សូមមើល [member default_font_size])។ ប្រើ [method "
"has_font_size] ដើម្បីពិនិត្យមើលភាពមាននៃលក្ខណៈសម្បត្តិ និង [method "
"has_default_font_size] ដើម្បីពិនិត្យមើលភាពមាននៃ font លំនាំដើមរបស់ theme។\n"
"ត្រឡប់តម្លៃ font size fallback របស់ engine ប្រសិនបើទាំងពីរមិនមាន (សូមមើល [member "
"ThemeDB.fallback_font_size])។"

msgid ""
"Returns a list of names for font size properties defined with [param "
"theme_type]. Use [method get_font_size_type_list] to get a list of possible "
"theme type names."
msgstr ""
"ត្រឡប់បញ្ជីឈ្មោះសម្រាប់លក្ខណៈសម្បត្តិ font size ដែលបានកំណត់ជាមួយ [param theme_type]។ ប្រើ "
"[method get_font_size_type_list] ដើម្បីទទួលបានបញ្ជីឈ្មោះប្រភេទ theme ដែលអាចមាន។"

msgid ""
"Returns a list of all unique theme type names for font size properties. Use "
"[method get_type_list] to get a list of all unique theme types."
msgstr ""
"ត្រឡប់បញ្ជីឈ្មោះប្រភេទ theme ប្លែកៗទាំងអស់សម្រាប់លក្ខណៈសម្បត្តិ font size។ ប្រើ [method "
"get_type_list] ដើម្បីទទួលបានបញ្ជីប្រភេទ theme ប្លែកៗទាំងអស់។"

msgid ""
"Returns a list of all unique theme type names for [Font] properties. Use "
"[method get_type_list] to get a list of all unique theme types."
msgstr ""
"ត្រឡប់បញ្ជីឈ្មោះប្រភេទ theme ប្លែកៗទាំងអស់សម្រាប់លក្ខណៈសម្បត្តិ [Font]។ ប្រើ [method "
"get_type_list] ដើម្បីទទួលបានបញ្ជីប្រភេទ theme ប្លែកៗទាំងអស់។"

msgid ""
"Returns the icon property defined by [param name] and [param theme_type], if "
"it exists.\n"
"Returns the engine fallback icon value if the property doesn't exist (see "
"[member ThemeDB.fallback_icon]). Use [method has_icon] to check for existence."
msgstr ""
"ត្រឡប់លក្ខណៈសម្បត្តិ icon ដែលកំណត់ដោយ [param name] និង [param theme_type] "
"ប្រសិនបើវាមាន។\n"
"ត្រឡប់តម្លៃ icon fallback របស់ engine ប្រសិនបើលក្ខណៈសម្បត្តិនេះមិនមាន (សូមមើល [member "
"ThemeDB.fallback_icon])។ ប្រើ [method has_icon] ដើម្បីពិនិត្យមើលភាពមាន។"

msgid ""
"Returns a list of names for icon properties defined with [param theme_type]. "
"Use [method get_icon_type_list] to get a list of possible theme type names."
msgstr ""
"ត្រឡប់បញ្ជីឈ្មោះសម្រាប់លក្ខណៈសម្បត្តិ icon ដែលបានកំណត់ជាមួយ [param theme_type]។ ប្រើ [method "
"get_icon_type_list] ដើម្បីទទួលបានបញ្ជីឈ្មោះប្រភេទ theme ដែលអាចមាន។"

msgid ""
"Returns a list of all unique theme type names for icon properties. Use "
"[method get_type_list] to get a list of all unique theme types."
msgstr ""
"ត្រឡប់បញ្ជីឈ្មោះប្រភេទ theme ប្លែកៗទាំងអស់សម្រាប់លក្ខណៈសម្បត្តិ icon។ ប្រើ [method "
"get_type_list] ដើម្បីទទួលបានបញ្ជីប្រភេទ theme ប្លែកៗទាំងអស់។"

msgid ""
"Returns the [StyleBox] property defined by [param name] and [param "
"theme_type], if it exists.\n"
"Returns the engine fallback stylebox value if the property doesn't exist (see "
"[member ThemeDB.fallback_stylebox]). Use [method has_stylebox] to check for "
"existence."
msgstr ""
"ត្រឡប់លក្ខណៈសម្បត្តិ [StyleBox] ដែលកំណត់ដោយ [param name] និង [param theme_type] "
"ប្រសិនបើវាមាន។\n"
"ត្រឡប់តម្លៃ stylebox fallback របស់ engine ប្រសិនបើលក្ខណៈសម្បត្តិនេះមិនមាន (សូមមើល [member "
"ThemeDB.fallback_stylebox])។ ប្រើ [method has_stylebox] ដើម្បីពិនិត្យមើលភាពមាន។"

msgid ""
"Returns a list of names for [StyleBox] properties defined with [param "
"theme_type]. Use [method get_stylebox_type_list] to get a list of possible "
"theme type names."
msgstr ""
"ត្រឡប់បញ្ជីឈ្មោះសម្រាប់លក្ខណៈសម្បត្តិ [StyleBox] ដែលបានកំណត់ជាមួយ [param theme_type]។ ប្រើ "
"[method get_stylebox_type_list] ដើម្បីទទួលបានបញ្ជីឈ្មោះប្រភេទ theme ដែលអាចមាន។"

msgid ""
"Returns a list of all unique theme type names for [StyleBox] properties. Use "
"[method get_type_list] to get a list of all unique theme types."
msgstr ""
"ត្រឡប់បញ្ជីឈ្មោះប្រភេទ theme ប្លែកៗទាំងអស់សម្រាប់លក្ខណៈសម្បត្តិ [StyleBox]។ ប្រើ [method "
"get_type_list] ដើម្បីទទួលបានបញ្ជីប្រភេទ theme ប្លែកៗទាំងអស់។"

msgid ""
"Returns the theme property of [param data_type] defined by [param name] and "
"[param theme_type], if it exists.\n"
"Returns the engine fallback value if the property doesn't exist (see "
"[ThemeDB]). Use [method has_theme_item] to check for existence.\n"
"[b]Note:[/b] This method is analogous to calling the corresponding data type "
"specific method, but can be used for more generalized logic."
msgstr ""
"ត្រឡប់លក្ខណៈសម្បត្តិ theme នៃ [param data_type] ដែលកំណត់ដោយ [param name] និង [param "
"theme_type] ប្រសិនបើវាមាន។\n"
"ត្រឡប់តម្លៃ fallback របស់ engine ប្រសិនបើលក្ខណៈសម្បត្តិនេះមិនមាន (សូមមើល [ThemeDB])។ ប្រើ "
"[method has_theme_item] ដើម្បីពិនិត្យមើលភាពមាន។\n"
"[b]ចំណាំ៖[/b] វិធីសាស្រ្តនេះស្រដៀងនឹងការហៅវិធីសាស្រ្តជាក់លាក់នៃប្រភេទទិន្នន័យដែលត្រូវគ្នា "
"ប៉ុន្តែអាចត្រូវបានប្រើសម្រាប់ logic ដែលមានលក្ខណៈទូទៅជាង។"

msgid ""
"Returns a list of names for properties of [param data_type] defined with "
"[param theme_type]. Use [method get_theme_item_type_list] to get a list of "
"possible theme type names.\n"
"[b]Note:[/b] This method is analogous to calling the corresponding data type "
"specific method, but can be used for more generalized logic."
msgstr ""
"ត្រឡប់បញ្ជីឈ្មោះសម្រាប់លក្ខណៈសម្បត្តិនៃ [param data_type] ដែលបានកំណត់ជាមួយ [param "
"theme_type]។ ប្រើ [method get_theme_item_type_list] ដើម្បីទទួលបានបញ្ជីឈ្មោះប្រភេទ "
"theme ដែលអាចមាន។\n"
"[b]ចំណាំ៖[/b] វិធីសាស្រ្តនេះស្រដៀងនឹងការហៅវិធីសាស្រ្តជាក់លាក់នៃប្រភេទទិន្នន័យដែលត្រូវគ្នា "
"ប៉ុន្តែអាចត្រូវបានប្រើសម្រាប់ logic ដែលមានលក្ខណៈទូទៅជាង។"

msgid ""
"Returns a list of all unique theme type names for [param data_type] "
"properties. Use [method get_type_list] to get a list of all unique theme "
"types.\n"
"[b]Note:[/b] This method is analogous to calling the corresponding data type "
"specific method, but can be used for more generalized logic."
msgstr ""
"ត្រឡប់បញ្ជីឈ្មោះប្រភេទ theme ប្លែកៗទាំងអស់សម្រាប់លក្ខណៈសម្បត្តិ [param data_type]។ ប្រើ "
"[method get_type_list] ដើម្បីទទួលបានបញ្ជីប្រភេទ theme ប្លែកៗទាំងអស់។\n"
"[b]ចំណាំ៖[/b] វិធីសាស្រ្តនេះស្រដៀងនឹងការហៅវិធីសាស្រ្តជាក់លាក់នៃប្រភេទទិន្នន័យដែលត្រូវគ្នា "
"ប៉ុន្តែអាចត្រូវបានប្រើសម្រាប់ logic ដែលមានលក្ខណៈទូទៅជាង។"

msgid ""
"Returns a list of all unique theme type names. Use the appropriate "
"[code]get_*_type_list[/code] method to get a list of unique theme types for a "
"single data type."
msgstr ""
"ត្រឡប់បញ្ជីឈ្មោះប្រភេទ theme ប្លែកៗទាំងអស់។ ប្រើវិធីសាស្រ្ត [code]get_*_type_list[/code] "
"ដែលសមស្រប ដើម្បីទទួលបានបញ្ជីប្រភេទ theme ប្លែកៗសម្រាប់ប្រភេទទិន្នន័យតែមួយ។"

msgid ""
"Returns the name of the base theme type if [param theme_type] is a valid "
"variation type. Returns an empty string otherwise."
msgstr ""
"ត្រឡប់ឈ្មោះនៃប្រភេទ theme មូលដ្ឋាន (base theme type) ប្រសិនបើ [param theme_type] "
"គឺជាប្រភេទ variation ដែលត្រឹមត្រូវ។ ត្រឡប់ string ទទេ ប្រសិនបើមិនមែន។"

msgid "Returns a list of all type variations for the given [param base_type]."
msgstr "ត្រឡប់បញ្ជីនៃ type variations ទាំងអស់សម្រាប់ [param base_type] ដែលបានផ្តល់ឱ្យ។"

msgid ""
"Returns [code]true[/code] if the [Color] property defined by [param name] and "
"[param theme_type] exists.\n"
"Returns [code]false[/code] if it doesn't exist. Use [method set_color] to "
"define it."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើលក្ខណៈសម្បត្តិ [Color] ដែលកំណត់ដោយ [param name] និង "
"[param theme_type] មាន។\n"
"ត្រឡប់ [code]false[/code] ប្រសិនបើវាមិនមាន។ ប្រើ [method set_color] ដើម្បីកំណត់វា។"

msgid ""
"Returns [code]true[/code] if the constant property defined by [param name] "
"and [param theme_type] exists.\n"
"Returns [code]false[/code] if it doesn't exist. Use [method set_constant] to "
"define it."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើលក្ខណៈសម្បត្តិ constant ដែលកំណត់ដោយ [param name] និង "
"[param theme_type] មាន។\n"
"ត្រឡប់ [code]false[/code] ប្រសិនបើវាមិនមាន។ ប្រើ [method set_constant] ដើម្បីកំណត់វា។"

msgid ""
"Returns [code]true[/code] if [member default_base_scale] has a valid value.\n"
"Returns [code]false[/code] if it doesn't. The value must be greater than "
"[code]0.0[/code] to be considered valid."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ [member default_base_scale] មានតម្លៃត្រឹមត្រូវ។\n"
"ត្រឡប់ [code]false[/code] ប្រសិនបើវាមិនមាន។ តម្លៃត្រូវតែធំជាង [code]0.0[/code] "
"ទើបចាត់ទុកថាត្រឹមត្រូវ។"

msgid ""
"Returns [code]true[/code] if [member default_font] has a valid value.\n"
"Returns [code]false[/code] if it doesn't."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ [member default_font] មានតម្លៃត្រឹមត្រូវ។\n"
"ត្រឡប់ [code]false[/code] ប្រសិនបើវាមិនមាន។"

msgid ""
"Returns [code]true[/code] if [member default_font_size] has a valid value.\n"
"Returns [code]false[/code] if it doesn't. The value must be greater than "
"[code]0[/code] to be considered valid."
msgstr ""
"ត្រឡប់ [code]true[/code] ប្រសិនបើ [member default_font_size] មានតម្លៃត្រឹមត្រូវ។\n"
"ត្រឡប់ [code]false[/code] ប្រសិនបើវាមិនមាន។ តម្លៃត្រូវតែធំជាង [code]0[/code] "
"ទើបចាត់ទុកថាត្រឹមត្រូវ។"

msgid ""
