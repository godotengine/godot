msgid ""
"Bit mask with all bits enabled except for modifier keys. Apply it to remove "
"modifiers.\n"
"[codeblock]\n"
"var keycode = KEY_A | KEY_MASK_SHIFT\n"
"keycode = keycode & KEY_CODE_MASK\n"
"print(keycode) # KEY_A\n"
"[/codeblock]"
msgstr ""
"ប៊ីតម៉ាស (Bit mask) ដែលបើកប៊ីតទាំងអស់ លើកលែងតែគ្រាប់ចុចបន្ថែម (modifier keys)។ "
"ប្រើវាដើម្បីយកគ្រាប់ចុចបន្ថែមចេញ។\n"
"[codeblock]\n"
"var keycode = KEY_A | KEY_MASK_SHIFT\n"
"keycode = keycode & KEY_CODE_MASK\n"
"print(keycode) # KEY_A\n"
"[/codeblock]"

msgid ""
"Bit mask with all modifier bits enabled. Apply it to isolate modifiers.\n"
"[codeblock]\n"
"var keycode = KEY_A | KEY_MASK_SHIFT\n"
"keycode = keycode & KEY_MODIFIER_MASK\n"
"print(keycode) # KEY_MASK_SHIFT\n"
"[/codeblock]"
msgstr ""
"ប៊ីតម៉ាស (Bit mask) ដែលបើកប៊ីតបន្ថែមទាំងអស់។ ប្រើវាដើម្បីញែកគ្រាប់ចុចបន្ថែម។\n"
"[codeblock]\n"
"var keycode = KEY_A | KEY_MASK_SHIFT\n"
"keycode = keycode & KEY_MODIFIER_MASK\n"
"print(keycode) # KEY_MASK_SHIFT\n"
"[/codeblock]"

msgid ""
"Automatically remapped to [constant KEY_META] on macOS and [constant "
"KEY_CTRL] on other platforms, this mask is never set in the actual events, "
"and should be used for key mapping only."
msgstr ""
"វាត្រូវបានប្ដូរទៅ [constant KEY_META] ដោយស្វ័យប្រវត្តិនៅលើ macOS និង [constant "
"KEY_CTRL] នៅលើវេទិកាផ្សេងទៀត។ ម៉ាសនេះមិនត្រូវបានកំណត់ក្នុងព្រឹត្តិការណ៍ជាក់ស្ដែងទេ "
"ហើយគួរប្រើវាសម្រាប់តែការគូសផែនទីគ្រាប់ចុចប៉ុណ្ណោះ។"

