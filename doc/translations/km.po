msgstr ""
"តម្រឹមទីតាំងរបស់វត្ថុ inline (ឧ. រូបភាព, តារាង) ដែលបានកំណត់ដោយថេរ "
"[code]INLINE_ALIGNMENT_*_TO[/code] ទៅផ្នែកខាងលើនៃអត្ថបទ។"

msgid ""
"Aligns the position of the inline object (e.g. image, table) specified by "
"[code]INLINE_ALIGNMENT_*_TO[/code] constant to the center of the text."
msgstr ""
"តម្រឹមទីតាំងរបស់វត្ថុ inline (ឧ. រូបភាព, តារាង) ដែលបានកំណត់ដោយថេរ "
"[code]INLINE_ALIGNMENT_*_TO[/code] ទៅផ្នែកកណ្ដាលនៃអត្ថបទ។"

msgid ""
"Aligns the position of the inline object (e.g. image, table) specified by "
"[code]INLINE_ALIGNMENT_*_TO[/code] constant to the baseline of the text."
msgstr ""
"តម្រឹមទីតាំងរបស់វត្ថុ inline (ឧ. រូបភាព, តារាង) ដែលបានកំណត់ដោយថេរ "
"[code]INLINE_ALIGNMENT_*_TO[/code] ទៅបន្ទាត់គោលនៃអត្ថបទ។"

msgid "Aligns inline object (e.g. image, table) to the bottom of the text."
msgstr "តម្រឹមវត្ថុ inline (ឧ. រូបភាព, តារាង) ទៅផ្នែកខាងក្រោមនៃអត្ថបទ។"

msgid ""
"Aligns top of the inline object (e.g. image, table) to the top of the text. "
"Equivalent to [code]INLINE_ALIGNMENT_TOP_TO | INLINE_ALIGNMENT_TO_TOP[/code]."
msgstr ""
"តម្រឹមផ្នែកខាងលើរបស់វត្ថុ inline (ឧ. រូបភាព, តារាង) ទៅផ្នែកខាងលើនៃអត្ថបទ។ ស្មើនឹង "
"[code]INLINE_ALIGNMENT_TOP_TO | INLINE_ALIGNMENT_TO_TOP[/code]។"

msgid ""
"Aligns center of the inline object (e.g. image, table) to the center of the "
"text. Equivalent to [code]INLINE_ALIGNMENT_CENTER_TO | "
"INLINE_ALIGNMENT_TO_CENTER[/code]."
msgstr ""
"តម្រឹមផ្នែកកណ្ដាលរបស់វត្ថុ inline (ឧ. រូបភាព, តារាង) ទៅផ្នែកកណ្ដាលនៃអត្ថបទ។ ស្មើនឹង "
"[code]INLINE_ALIGNMENT_CENTER_TO | INLINE_ALIGNMENT_TO_CENTER[/code]។"

msgid ""
"Aligns bottom of the inline object (e.g. image, table) to the bottom of the "
"text. Equivalent to [code]INLINE_ALIGNMENT_BOTTOM_TO | "
"INLINE_ALIGNMENT_TO_BOTTOM[/code]."
msgstr ""
"តម្រឹមផ្នែកខាងក្រោមរបស់វត្ថុ inline (ឧ. រូបភាព, តារាង) ទៅផ្នែកខាងក្រោមនៃអត្ថបទ។ ស្មើនឹង "
"[code]INLINE_ALIGNMENT_BOTTOM_TO | INLINE_ALIGNMENT_TO_BOTTOM[/code]។"

msgid "A bit mask for [code]INLINE_ALIGNMENT_*_TO[/code] alignment constants."
msgstr "របាំងប៊ីតសម្រាប់ថេរការតម្រឹម [code]INLINE_ALIGNMENT_*_TO[/code]។"

msgid "A bit mask for [code]INLINE_ALIGNMENT_TO_*[/code] alignment constants."
msgstr "របាំងប៊ីតសម្រាប់ថេរការតម្រឹម [code]INLINE_ALIGNMENT_TO_*[/code]។"

msgid ""
"Specifies that Euler angles should be in intrinsic XYZ order. When composing, "
"the rotations happen around the local X, Y, and Z axes, in that order. When "
"decomposing, the order is reversed, first Z, then Y, and X last."
msgstr ""
"កំណត់ថាមុំ Euler គួរស្ថិតក្នុងលំដាប់ intrinsic XYZ។ ពេល compose, ការបង្វិលកើតឡើងជុំវិញអ័ក្ស "
"local X, Y និង Z តាមលំដាប់នោះ។ ពេល decompose, លំដាប់ត្រូវបានបញ្ច្រាស ដំបូង Z បន្ទាប់ Y និង "
"X ចុងក្រោយ។"

