"\n"
"func _get_importer_name (): \n"
"\"My.special.plugin\" ஐத் திரும்புக \n"
"\n"
"func _get_visible_name (): \n"
"\"சிறப்பு கண்ணி\" திரும்பவும் \n"
"\n"
"func _get_reccensed_extensions (): \n"
"திரும்ப [\"சிறப்பு\", \"ச்பெக்\"] \n"
"\n"
"func _get_save_extension (): \n"
"\"மெச்\" திரும்பவும் \n"
"\n"
"func _get_resource_type (): \n"
"\"மெச்\" திரும்பவும் \n"
"\n"
"func _get_preset_count (): \n"
"திரும்ப 1 \n"
"\n"
"func _get_preset_name (முன்னரே_இண்டெக்ச்): \n"
"\"இயல்புநிலை\" திரும்பவும் \n"
"\n"
