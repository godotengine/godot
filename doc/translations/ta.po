"\n"
"func _import (source_file, save_path, விருப்பங்கள், இயங்குதளம்_வாரியர்கள், "
"gen_files): \n"
"var கோப்பு = fileaccess.open (source_file, fileaccess.read) \n"
"கோப்பு == சுழியம் என்றால்: \n"
"திரும்பவும் தோல்வியடைந்தது \n"
"var mesh = arraymesh.new () \n"
"# \"கோப்பு\" இல் படித்த தரவுகளுடன் கண்ணி நிரப்பவும், வாசகருக்கு ஒரு பயிற்சியாக "
