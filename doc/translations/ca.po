msgstr "Netegeu el primer fitxer adjunt de color."

msgid "Clear the second color attachment."
msgstr "Netegeu el segon adjunt de color."

msgid "Clear the third color attachment."
msgstr "Netegeu el fitxer adjunt del tercer color."

msgid "Clear the fourth color attachment."
msgstr "Esborra el fitxer adjunt del quart color."

msgid "Clear the fifth color attachment."
msgstr "Netegeu el fitxer adjunt del cinquè color."

msgid "Clear the sixth color attachment."
msgstr "Netegeu el fitxer adjunt del sisè color."

msgid "Clear the seventh color attachment."
msgstr "Netegeu l'adjunt del setè color."

msgid "Clear the eighth color attachment."
msgstr "Netegeu l'adjunt del vuitè color."

msgid "Mask for clearing all color attachments."
