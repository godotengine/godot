msgid "Represents the size of the [enum DataFormat] enum."
msgstr "Представляет размер перечисления [enum DataFormat]."

msgid "Vertex shader barrier mask."
msgstr "Барьерная маска вершинного шейдера."

msgid "Fragment shader barrier mask."
msgstr "Маска барьера фрагментного шейдера."

msgid "Compute barrier mask."
msgstr "Вычислить барьерную маску."

msgid "Transfer barrier mask."
msgstr "Перенос барьерной маски."

msgid ""
"Raster barrier mask (vertex and fragment). Equivalent to "
"[code]BARRIER_MASK_VERTEX | BARRIER_MASK_FRAGMENT[/code]."
msgstr ""
"Маска растрового барьера (вершина и фрагмент). Эквивалентно "
"[code]BARRIER_MASK_VERTEX | BARRIER_MASK_FRAGMENT[/code]."

msgid "Barrier mask for all types (vertex, fragment, compute, transfer)."
msgstr ""
"Барьерная маска для всех типов (вершинная, фрагментная, вычислительная, "
"трансферная)."

msgid "No barrier for any type."
msgstr "Никаких барьеров для любого типа."

msgid "1-dimensional texture."
msgstr "Одномерная текстура."

msgid "2-dimensional texture."
msgstr "2-мерная текстура."

msgid "3-dimensional texture."
msgstr "3-мерная текстура."

msgid "[Cubemap] texture."
msgstr "Текстура [Cubemap]."

msgid "Array of 1-dimensional textures."
msgstr "Массив одномерных текстур."

msgid "Array of 2-dimensional textures."
msgstr "Массив двумерных текстур."

msgid "Array of [Cubemap] textures."
msgstr "Массив текстур [Cubemap]."

msgid "Represents the size of the [enum TextureType] enum."
msgstr "Представляет размер перечисления [enum TextureType]."

msgid ""
"Perform 1 texture sample (this is the fastest but lowest-quality for "
"antialiasing)."
msgstr ""
"Выполнить 1 выборку текстуры (это самый быстрый, но и самый низкокачественный "
"способ сглаживания)."

msgid "Perform 2 texture samples."
msgstr "Выполните 2 образца текстуры."

msgid "Perform 4 texture samples."
msgstr "Выполните 4 образца текстуры."

msgid ""
"Perform 8 texture samples. Not supported on mobile GPUs (including Apple "
"Silicon)."
msgstr ""
"Выполнить 8 выборок текстур. Не поддерживается на мобильных GPU (включая "
"Apple Silicon)."

msgid ""
"Perform 16 texture samples. Not supported on mobile GPUs and many desktop "
"GPUs."
msgstr ""
"Выполнить 16 выборок текстур. Не поддерживается на мобильных GPU и многих "
"настольных GPU."

msgid "Perform 32 texture samples. Not supported on most GPUs."
msgstr ""
"Выполнить 32 выборки текстур. Не поддерживается большинством графических "
"процессоров."

msgid ""
"Perform 64 texture samples (this is the slowest but highest-quality for "
"antialiasing). Not supported on most GPUs."
msgstr ""
"Выполнить 64 выборки текстур (это самый медленный, но самый качественный "
"способ сглаживания). Не поддерживается большинством графических процессоров."

msgid "Represents the size of the [enum TextureSamples] enum."
msgstr "Представляет размер перечисления [enum TextureSamples]."

msgid "Texture can be sampled."
msgstr "Текстуру можно отобрать (взять на пробу)."

msgid "Texture can be used as a color attachment in a framebuffer."
msgstr ""
"Текстуру можно использовать в качестве цветового приложения в буфере кадра."

msgid "Texture can be used as a depth/stencil attachment in a framebuffer."
msgstr ""
"Текстуру можно использовать в качестве глубинного/трафаретного приложения в "
"буфере кадра."

msgid ""
"Texture can be used as a depth/stencil resolve attachment in a framebuffer."
msgstr ""
"Текстуру можно использовать в качестве параметра разрешения глубины/трафарета "
"в буфере кадров."

msgid ""
"Texture can be used as a [url=https://registry.khronos.org/vulkan/specs/1.3-"
"extensions/html/vkspec.html#descriptorsets-storageimage]storage image[/url]."
msgstr ""
"Текстуру можно использовать как [url=https://registry.khronos.org/vulkan/"
"specs/1.3-extensions/html/vkspec.html#descriptorsets-storageimage]образ для "
"хранения[/url]."

msgid ""
"Texture can be used as a [url=https://registry.khronos.org/vulkan/specs/1.3-"
"extensions/html/vkspec.html#descriptorsets-storageimage]storage image[/url] "
"with support for atomic operations."
msgstr ""
"Текстуру можно использовать как [url=https://registry.khronos.org/vulkan/"
"specs/1.3-extensions/html/vkspec.html#descriptorsets-storageimage]образ "
"хранилища[/url] с поддержкой атомарных операций."

msgid ""
"Texture can be read back on the CPU using [method texture_get_data] faster "
"than without this bit, since it is always kept in the system memory."
msgstr ""
"Текстуру можно считать обратно на ЦП с помощью [method texture_get_data] "
"быстрее, чем без этого бита, поскольку она всегда хранится в системной памяти."

msgid "Texture can be updated using [method texture_update]."
msgstr "Текстуру можно обновить с помощью [method texture_update]."

msgid "Texture can be a source for [method texture_copy]."
msgstr "Текстура может быть источником для [method texture_copy]."

msgid "Texture can be a destination for [method texture_copy]."
msgstr "Текстура может быть местом назначения для [method texture_copy]."

msgid ""
"Texture can be used as a [url=https://registry.khronos.org/vulkan/specs/1.3-"
"extensions/html/vkspec.html#descriptorsets-inputattachment]input attachment[/"
"url] in a framebuffer."
msgstr ""
"Текстуру можно использовать как [url=https://registry.khronos.org/vulkan/"
"specs/1.3-extensions/html/vkspec.html#descriptorsets-inputattachment]входное "
"вложение[/url] в буфере кадра."

msgid "Return the sampled value as-is."
msgstr "Верните выбранное значение как есть."

msgid "Always return [code]0.0[/code] when sampling."
msgstr "Всегда возвращайте [code]0.0[/code] при выборке."

msgid "Always return [code]1.0[/code] when sampling."
msgstr "Всегда возвращайте [code]1.0[/code] при выборке."

msgid "Sample the red color channel."
msgstr "Возьмите образец красного цветового канала."

msgid "Sample the green color channel."
msgstr "Возьмите образец зеленого цветового канала."

msgid "Sample the blue color channel."
msgstr "Возьмите образец синего цветового канала."

msgid "Sample the alpha channel."
msgstr "Образец альфа-канала."

msgid "Represents the size of the [enum TextureSwizzle] enum."
msgstr "Представляет размер перечисления [enum TextureSwizzle]."

msgid "2-dimensional texture slice."
msgstr "Двухмерный срез текстуры."

msgid "Cubemap texture slice."
msgstr "Кусочек текстуры кубической карты."

msgid "3-dimensional texture slice."
msgstr "Трехмерный срез текстуры."

msgid ""
"Nearest-neighbor sampler filtering. Sampling at higher resolutions than the "
"source will result in a pixelated look."
msgstr ""
"Фильтрация сэмплера ближайшего соседа. Выборка с более высоким разрешением, "
"чем у источника, приведет к пикселизированному виду."

msgid ""
"Bilinear sampler filtering. Sampling at higher resolutions than the source "
"will result in a blurry look."
msgstr ""
"Фильтрация билинейного сэмплера. Выборка с более высоким разрешением, чем у "
"источника, приведет к размытому виду."

msgid "Sample with repeating enabled."
msgstr "Образец с включенным повторением."

msgid ""
"Sample with mirrored repeating enabled. When sampling outside the [code][0.0, "
"1.0][/code] range, return a mirrored version of the sampler. This mirrored "
"version is mirrored again if sampling further away, with the pattern "
"repeating indefinitely."
msgstr ""
"Сэмпл с включенным зеркальным повторением. При сэмплировании за пределами "
"диапазона [code][0.0, 1.0][/code] возвращает зеркальную версию сэмплера. Эта "
"зеркальная версия зеркалируется снова, если сэмплирование происходит дальше, "
"при этом шаблон повторяется бесконечно."

msgid ""
"Sample with repeating disabled. When sampling outside the [code][0.0, 1.0][/"
"code] range, return the color of the last pixel on the edge."
msgstr ""
"Образец с отключенным повторением. При выборке за пределами диапазона [code]"
"[0.0, 1.0][/code] вернуть цвет последнего пикселя на краю."

msgid ""
"Sample with repeating disabled. When sampling outside the [code][0.0, 1.0][/"
"code] range, return the specified [member RDSamplerState.border_color]."
msgstr ""
"Образец с отключенным повторением. При выборке за пределами диапазона [code]"
"[0.0, 1.0][/code] верните указанный элемент [member "
"RDSamplerState.border_color]."

msgid ""
"Sample with mirrored repeating enabled, but only once. When sampling in the "
"[code][-1.0, 0.0][/code] range, return a mirrored version of the sampler. "
"When sampling outside the [code][-1.0, 1.0][/code] range, return the color of "
"the last pixel on the edge."
msgstr ""
"Выборка с включенным зеркальным повторением, но только один раз. При выборке "
"в диапазоне [code][-1.0, 0.0][/code] вернуть зеркальную версию выборки. При "
"выборке за пределами диапазона [code][-1.0, 1.0][/code] вернуть цвет "
"последнего пикселя на краю."

msgid "Represents the size of the [enum SamplerRepeatMode] enum."
msgstr "Представляет размер перечисления [enum SamplerRepeatMode]."

msgid ""
"Return a floating-point transparent black color when sampling outside the "
"[code][0.0, 1.0][/code] range. Only effective if the sampler repeat mode is "
"[constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr ""
"Возвращает прозрачный черный цвет с плавающей точкой при выборке за пределами "
"диапазона [code][0.0, 1.0][/code]. Эффективно только в том случае, если режим "
"повтора сэмплера равен [constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."

msgid ""
"Return an integer transparent black color when sampling outside the [code]"
"[0.0, 1.0][/code] range. Only effective if the sampler repeat mode is "
"[constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr ""
"Возвращает целочисленный прозрачный чёрный цвет при сэмплировании вне "
"диапазона [code][0.0, 1.0][/code]. Действует только если режим повторения "
"сэмплера — [constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."

msgid ""
"Return a floating-point opaque black color when sampling outside the [code]"
"[0.0, 1.0][/code] range. Only effective if the sampler repeat mode is "
"[constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr ""
"Возвращает непрозрачный черный цвет с плавающей точкой при выборке за "
"пределами диапазона [code][0.0, 1.0][/code]. Эффективно только в том случае, "
"если режим повтора сэмплера равен [constant "
"SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."

msgid ""
"Return an integer opaque black color when sampling outside the [code][0.0, "
"1.0][/code] range. Only effective if the sampler repeat mode is [constant "
"SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr ""
"Возвращает целочисленный непрозрачный чёрный цвет при выборке за пределами "
"диапазона [code][0.0, 1.0][/code]. Действует только если режим повторения "
"сэмплера — [constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."

msgid ""
"Return a floating-point opaque white color when sampling outside the [code]"
"[0.0, 1.0][/code] range. Only effective if the sampler repeat mode is "
"[constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr ""
"Возвращает непрозрачный белый цвет с плавающей точкой при выборке за "
"пределами диапазона [code][0.0, 1.0][/code]. Эффективно только в том случае, "
"если режим повтора сэмплера равен [constant "
"SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."

msgid ""
"Return an integer opaque white color when sampling outside the [code][0.0, "
"1.0][/code] range. Only effective if the sampler repeat mode is [constant "
"SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr ""
"Возвращает целочисленный непрозрачный белый цвет при выборке за пределами "
"диапазона [code][0.0, 1.0][/code]. Действует только если режим повторения "
"сэмплера — [constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."

msgid "Represents the size of the [enum SamplerBorderColor] enum."
msgstr "Представляет размер перечисления [enum SamplerBorderColor]."

msgid ""
"Vertex attribute addressing is a function of the vertex. This is used to "
"specify the rate at which vertex attributes are pulled from buffers."
msgstr ""
"Адресация атрибутов вершин является функцией вершины. Это используется для "
"указания скорости, с которой атрибуты вершин извлекаются из буферов."

msgid ""
"Vertex attribute addressing is a function of the instance index. This is used "
"to specify the rate at which vertex attributes are pulled from buffers."
msgstr ""
"Адресация атрибутов вершин является функцией индекса экземпляра. Это "
"используется для указания скорости, с которой атрибуты вершин извлекаются из "
"буферов."

msgid ""
"Index buffer in 16-bit unsigned integer format. This limits the maximum index "
"that can be specified to [code]65535[/code]."
msgstr ""
"Буфер индекса в формате 16-битного целого числа без знака. Это ограничивает "
"максимальный индекс, который может быть указан, до [code]65535[/code]."

msgid ""
"Index buffer in 32-bit unsigned integer format. This limits the maximum index "
"that can be specified to [code]4294967295[/code]."
msgstr ""
"Буфер индекса в формате 32-битного целого числа без знака. Это ограничивает "
"максимальный индекс, который может быть указан, до [code]4294967295[/code]."

msgid ""
"Optionally, set this flag if you wish to use [method "
"buffer_get_device_address] functionality. You must first check the GPU "
"supports it:\n"
"[codeblocks]\n"
"[gdscript]\n"
"rd = RenderingServer.get_rendering_device()\n"
"\n"
"if rd.has_feature(RenderingDevice.SUPPORTS_BUFFER_DEVICE_ADDRESS):\n"
"\tstorage_buffer = rd.storage_buffer_create(bytes.size(), bytes, "
"RenderingDevice.STORAGE_BUFFER_USAGE_SHADER_DEVICE_ADDRESS)\n"
"\tstorage_buffer_address = rd.buffer_get_device_address(storage_buffer)\n"
"[/gdscript]\n"
"[/codeblocks]"
msgstr ""
"При желании установите этот флаг, если хотите использовать функционал [method "
"buffer_get_device_address]. Сначала необходимо проверить, поддерживает ли его "
"графический процессор:\n"
"[codeblocks]\n"
"[gdscript]\n"
"rd = RenderingServer.get_rendering_device()\n"
"\n"
"if rd.has_feature(RenderingDevice.SUPPORTS_BUFFER_DEVICE_ADDRESS):\n"
"\tstorage_buffer = rd.storage_buffer_create(bytes.size(), bytes, "
"RenderingDevice.STORAGE_BUFFER_USAGE_SHADER_DEVICE_ADDRESS)\n"
"\tstorage_buffer_address = rd.buffer_get_device_address(storage_buffer)\n"
"[/gdscript]\n"
"[/codeblocks]"

msgid ""
"Set this flag so that it is created as storage. This is useful if Compute "
"Shaders need access (for reading or writing) to the buffer, e.g. skeletal "
"animations are processed in Compute Shaders which need access to vertex "
"buffers, to be later consumed by vertex shaders as part of the regular "
"rasterization pipeline."
msgstr ""
"Установите этот флаг, чтобы он был создан как хранилище. Это полезно, если "
"Compute Shaders требуется доступ (для чтения или записи) к буферу, например, "
"скелетные анимации обрабатываются в Compute Shaders, которым требуется доступ "
"к вершинным буферам, чтобы впоследствии использоваться вершинными шейдерами "
"как часть обычного конвейера растеризации."

msgid "Sampler uniform."
msgstr "Образец униформы."

msgid "Sampler uniform with a texture."
msgstr "Образец униформы с текстурой."

msgid "Texture uniform."
msgstr "Текстура однородная."

msgid "Image uniform."
msgstr "Изображение однородное."

msgid "Texture buffer uniform."
msgstr "Текстурный буфер равномерный."

msgid "Sampler uniform with a texture buffer."
msgstr "Униформа сэмплера с текстурным буфером."

msgid "Image buffer uniform."
msgstr "Буфер изображения равномерный."

msgid "Uniform buffer uniform."
msgstr "Унифицированная буферная униформа."

msgid ""
"[url=https://vkguide.dev/docs/chapter-4/storage_buffers/]Storage buffer[/url] "
"uniform."
msgstr ""
"[url=https://vkguide.dev/docs/chapter-4/storage_buffers/]Буфер хранения[/url] "
"униформа."

msgid "Input attachment uniform."
msgstr "вставка для ввода униформы."

msgid ""
"Same as UNIFORM_TYPE_UNIFORM_BUFFER but for buffers created with "
"BUFFER_CREATION_DYNAMIC_PERSISTENT_BIT.\n"
"[b]Note:[/b] This flag is not available to GD users due to being too "
"dangerous (i.e. wrong usage can result in visual glitches).\n"
"It's exposed in case GD users receive a buffer created with such flag from "
"Godot."
msgstr ""
"Аналогично UNIFORM_TYPE_UNIFORM_BUFFER, но для буферов, созданных с помощью "
"BUFFER_CREATION_DYNAMIC_PERSISTENT_BIT.\n"
"[b]Примечание:[/b] Этот флаг недоступен пользователям GD из-за его чрезмерной "
"опасности (т.е. неправильное использование может привести к визуальным "
"сбоям).\n"
"Он доступен в случае, если пользователи GD получают от Godot буфер, созданный "
"с таким флагом."

msgid ""
"Same as UNIFORM_TYPE_STORAGE_BUFFER but for buffers created with "
"BUFFER_CREATION_DYNAMIC_PERSISTENT_BIT.\n"
"[b]Note:[/b] This flag is not available to GD users due to being too "
"dangerous (i.e. wrong usage can result in visual glitches).\n"
"It's exposed in case GD users receive a buffer created with such flag from "
"Godot."
msgstr ""
"Аналогично UNIFORM_TYPE_STORAGE_BUFFER, но для буферов, созданных с помощью "
"BUFFER_CREATION_DYNAMIC_PERSISTENT_BIT.\n"
"[b]Примечание:[/b] Этот флаг недоступен пользователям GD из-за его чрезмерной "
"опасности (т.е. неправильное использование может привести к визуальным "
"сбоям).\n"
"Он отображается в случае, если пользователи GD получают от Godot буфер, "
"созданный с таким флагом."

msgid "Represents the size of the [enum UniformType] enum."
msgstr "Представляет размер перечисления [enum UniformType]."

msgid ""
"Point rendering primitive (with constant size, regardless of distance from "
"camera)."
msgstr ""
"Примитив рендеринга точки (с постоянным размером, независимо от расстояния до "
"камеры)."

msgid ""
"Line list rendering primitive. Lines are drawn separated from each other."
msgstr ""
"Примитив рендеринга списка линий. Линии рисуются отдельно друг от друга."

msgid ""
"[url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/"
"vkspec.html#drawing-line-lists-with-adjacency]Line list rendering primitive "
"with adjacency.[/url]\n"
"[b]Note:[/b] Adjacency is only useful with geometry shaders, which Godot does "
"not expose."
msgstr ""
"[url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/"
"vkspec.html#drawing-line-lists-with-adjacency]Примитив рендеринга списка "
"линий с соседством.[/url]\n"
"[b]Примечание:[/b] Смежность полезна только с геометрическими шейдерами, "
"которые Godot не раскрывает."

msgid ""
"Line strip rendering primitive. Lines drawn are connected to the previous "
"vertex."
msgstr ""
"Примитив рендеринга полосовой линии. Нарисованные линии соединяются с "
"предыдущей вершиной."

msgid ""
"[url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/"
"vkspec.html#drawing-line-strips-with-adjacency]Line strip rendering primitive "
"with adjacency.[/url]\n"
"[b]Note:[/b] Adjacency is only useful with geometry shaders, which Godot does "
"not expose."
msgstr ""
"[url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/"
"vkspec.html#drawing-line-strips-with-adjacency]Примитив рендеринга полос "
"линий с соседством.[/url]\n"
"[b]Примечание:[/b] Смежность полезна только с геометрическими шейдерами, "
"которые Godot не раскрывает."

msgid ""
"Triangle list rendering primitive. Triangles are drawn separated from each "
"other."
msgstr ""
"Примитив рендеринга списка треугольников. Треугольники рисуются отдельно друг "
"от друга."

msgid ""
"[url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/"
"vkspec.html#drawing-triangle-lists-with-adjacency]Triangle list rendering "
"primitive with adjacency.[/url]\n"
"[b]Note:[/b] Adjacency is only useful with geometry shaders, which Godot does "
"not expose."
msgstr ""
"[url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/"
"vkspec.html#drawing-triangle-lists-with-adjacency]Примитив рендеринга списка "
"треугольников с соседством.[/url]\n"
"[b]Примечание:[/b] Смежность полезна только с геометрическими шейдерами, "
"которые Godot не раскрывает."

msgid ""
"Triangle strip rendering primitive. Triangles drawn are connected to the "
"previous triangle."
msgstr ""
"Примитив рендеринга полосы треугольника. Нарисованные треугольники "
"соединяются с предыдущим треугольником."

msgid ""
"[url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/"
"vkspec.html#drawing-triangle-strips-with-adjacency]Triangle strip rendering "
"primitive with adjacency.[/url]\n"
"[b]Note:[/b] Adjacency is only useful with geometry shaders, which Godot does "
"not expose."
msgstr ""
"[url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/"
"vkspec.html#drawing-triangle-strips-with-adjacency]Примитив рендеринга "
"полоски треугольника с соседством.[/url]\n"
"[b]Примечание:[/b] Смежность полезна только с геометрическими шейдерами, "
"которые Godot не раскрывает."

msgid ""
"Triangle strip rendering primitive with [i]primitive restart[/i] enabled. "
"Triangles drawn are connected to the previous triangle, but a primitive "
"restart index can be specified before drawing to create a second triangle "
"strip after the specified index.\n"
"[b]Note:[/b] Only compatible with indexed draws."
msgstr ""
"Примитив рендеринга полосы треугольников с включенным [i]перезапуском "
"примитива[/i]. Нарисованные треугольники связаны с предыдущим треугольником, "
"но индекс перезапуска примитива может быть указан перед рисованием, чтобы "
"создать вторую полосу треугольников после указанного индекса.\n"
"[b]Примечание:[/b] Совместимо только с индексированными рисунками."

msgid ""
"Tessellation patch rendering primitive. Only useful with tessellation "
"shaders, which can be used to deform these patches."
msgstr ""
"Примитив рендеринга патчей тесселяции. Полезно только с шейдерами тесселяции, "
"которые можно использовать для деформации этих патчей."

msgid "Represents the size of the [enum RenderPrimitive] enum."
msgstr "Представляет размер перечисления [enum RenderPrimitive]."

msgid "Do not use polygon front face or backface culling."
msgstr "Не используйте отбраковку передней или задней поверхности полигона."

msgid ""
"Use polygon frontface culling (faces pointing towards the camera are hidden)."
msgstr ""
"Использовать отсечение фронтальных граней полигонов (грани, направленные в "
"сторону камеры, скрыты)."

msgid ""
"Use polygon backface culling (faces pointing away from the camera are hidden)."
msgstr ""
"Использовать отсечение обратных граней полигонов (грани, направленные в "
"сторону от камеры, скрыты)."

msgid ""
"Clockwise winding order to determine which face of a polygon is its front "
"face."
msgstr ""
"Порядок поворота по часовой стрелке позволяет определить, какая грань "
"многоугольника является его передней гранью."

msgid ""
"Counter-clockwise winding order to determine which face of a polygon is its "
"front face."
msgstr ""
"Порядок вращения против часовой стрелки для определения того, какая грань "
"многоугольника является его передней гранью."

msgid "Keep the current stencil value."
msgstr "Сохранить текущее значение трафарета."

msgid "Set the stencil value to [code]0[/code]."
msgstr "Установите значение трафарета на [code]0[/code]."

msgid "Replace the existing stencil value with the new one."
msgstr "Замените существующее значение трафарета новым."

msgid ""
"Increment the existing stencil value and clamp to the maximum representable "
"unsigned value if reached. Stencil bits are considered as an unsigned integer."
msgstr ""
"Увеличить существующее значение трафарета и зафиксировать его на максимально "
"представимом беззнаковом значении, если оно достигнуто. Биты трафарета "
"рассматриваются как беззнаковое целое число."

msgid ""
"Decrement the existing stencil value and clamp to the minimum value if "
"reached. Stencil bits are considered as an unsigned integer."
msgstr ""
"Уменьшить существующее значение трафарета и зафиксировать его на минимальном "
"значении, если оно достигнуто. Биты трафарета рассматриваются как беззнаковое "
"целое число."

msgid "Bitwise-invert the existing stencil value."
msgstr "Побитовое инвертирование существующего значения трафарета."

msgid ""
"Increment the stencil value and wrap around to [code]0[/code] if reaching the "
"maximum representable unsigned. Stencil bits are considered as an unsigned "
"integer."
msgstr ""
"Увеличить значение трафарета и перейти к [code]0[/code] при достижении "
"максимального представимого беззнакового значения. Биты трафарета "
"рассматриваются как беззнаковое целое число."

msgid ""
"Decrement the stencil value and wrap around to the maximum representable "
"unsigned if reaching the minimum. Stencil bits are considered as an unsigned "
"integer."
msgstr ""
"Уменьшить значение трафарета и вернуться к максимально представимому "
"беззнаковому значению, если достигнуто минимум. Биты трафарета "
"рассматриваются как беззнаковое целое число."

msgid "Represents the size of the [enum StencilOperation] enum."
msgstr "Представляет размер перечисления [enum StencilOperation]."

msgid "\"Never\" comparison (opposite of [constant COMPARE_OP_ALWAYS])."
msgstr "Сравнение «Никогда» (противоположно [constant COMPARE_OP_ALWAYS])."

msgid "\"Less than\" comparison."
msgstr "Сравнение \"меньше, чем\"."

msgid "\"Equal\" comparison."
msgstr "\"Равноценное\" сравнение."

msgid "\"Less than or equal\" comparison."
msgstr "Сравнение \"меньше или равно\"."

msgid "\"Greater than\" comparison."
msgstr "Сравнение \"больше, чем\"."

msgid "\"Not equal\" comparison."
msgstr "Сравнение \"Не равно\"."

msgid "\"Greater than or equal\" comparison."
msgstr "Сравнение «больше или равно»."

msgid "\"Always\" comparison (opposite of [constant COMPARE_OP_NEVER])."
msgstr "Сравнение «Всегда» (противоположно [constant COMPARE_OP_NEVER])."

msgid "Represents the size of the [enum CompareOperator] enum."
msgstr "Представляет размер перечисления [enum CompareOperator]."

msgid ""
"Clear logic operation (result is always [code]0[/code]). See also [constant "
"LOGIC_OP_SET]."
msgstr ""
"Очистить логическую операцию (результат всегда [code]0[/code]). См. также "
"[constant LOGIC_OP_SET]."

msgid "AND logic operation."
msgstr "Логическая операция И."

msgid ""
"AND logic operation with the [i]destination[/i] operand being inverted. See "
"also [constant LOGIC_OP_AND_INVERTED]."
msgstr ""
"Логическая операция И с инвертируемым операндом [i]destination[/i] "
"(назначение). См. также [constant LOGIC_OP_AND_INVERTED]."

msgid ""
"Copy logic operation (keeps the [i]source[/i] value as-is). See also "
"[constant LOGIC_OP_COPY_INVERTED] and [constant LOGIC_OP_NO_OP]."
msgstr ""
"Операция копирования логики (сохраняет значение [i]source[/i] (источник) как "
"есть). См. также [constant LOGIC_OP_COPY_INVERTED] и [constant "
"LOGIC_OP_NO_OP]."

msgid ""
"AND logic operation with the [i]source[/i] operand being inverted. See also "
"[constant LOGIC_OP_AND_REVERSE]."
msgstr ""
"Логическая операция И с инвертируемым операндом [i]source[/i]. См. также "
"[constant LOGIC_OP_AND_REVERSE]."

msgid ""
"No-op logic operation (keeps the [i]destination[/i] value as-is). See also "
"[constant LOGIC_OP_COPY]."
msgstr ""
"Логическая операция без операции (сохраняет значение [i]destination[/i] как "
"есть). См. также [constant LOGIC_OP_COPY]."

msgid "Exclusive or (XOR) logic operation."
msgstr "Логическая операция «исключающее ИЛИ» (XOR)."

msgid "OR logic operation."
msgstr "Логическая операция ИЛИ."

msgid "Not-OR (NOR) logic operation."
msgstr "Логическая операция «НЕ-ИЛИ» (NOR)."

msgid "Not-XOR (XNOR) logic operation."
msgstr "Логическая операция «не-исключающее ИЛИ» (XNOR)."

msgid "Invert logic operation."
msgstr "Инвертировать логическую операцию."

msgid ""
"OR logic operation with the [i]destination[/i] operand being inverted. See "
"also [constant LOGIC_OP_OR_REVERSE]."
msgstr ""
"Логическая операция ИЛИ с инвертируемым операндом [i]destination[/i]. См. "
"также [constant LOGIC_OP_OR_REVERSE]."

msgid ""
"NOT logic operation (inverts the value). See also [constant LOGIC_OP_COPY]."
msgstr ""
"Логическая операция НЕ (инвертирует значение). См. также [constant "
"LOGIC_OP_COPY]."

msgid ""
"OR logic operation with the [i]source[/i] operand being inverted. See also "
"[constant LOGIC_OP_OR_REVERSE]."
msgstr ""
"Логическая операция ИЛИ с инвертируемым операндом [i]source[/i]. См. также "
"[constant LOGIC_OP_OR_REVERSE]."

msgid "Not-AND (NAND) logic operation."
msgstr "Логическая операция НЕ-И (NAND)."

msgid ""
"SET logic operation (result is always [code]1[/code]). See also [constant "
"LOGIC_OP_CLEAR]."
msgstr ""
"Логическая операция SET (результат всегда [code]1[/code]). См. также "
"[constant LOGIC_OP_CLEAR]."

msgid "Represents the size of the [enum LogicOperation] enum."
msgstr "Представляет размер перечисления [enum LogicOperation]."

msgid "Constant [code]0.0[/code] blend factor."
msgstr "Постоянный коэффициент смешивания [code]0,0[/code]."

msgid "Constant [code]1.0[/code] blend factor."
msgstr "Постоянный коэффициент смешивания [code]1.0[/code]."

msgid ""
"Color blend factor is [code]source color[/code]. Alpha blend factor is "
"[code]source alpha[/code]."
msgstr ""
"Коэффициент смешивания цветов — это [code]source color[/code]. Фактор альфа-"
"смешивания — это [code]source alpha[/code]."

msgid ""
"Color blend factor is [code]1.0 - source color[/code]. Alpha blend factor is "
"[code]1.0 - source alpha[/code]."
msgstr ""
"Коэффициент смешивания цветов составляет [code]1,0 - source color[/code]. "
"Коэффициент смешивания альфа составляет [code]1,0 - source alpha[/code]."

msgid ""
"Color blend factor is [code]destination color[/code]. Alpha blend factor is "
"[code]destination alpha[/code]."
msgstr ""
"Коэффициент смешивания цветов — [code]destination color[/code]. Коэффициент "
"смешивания альфа — [code]destination alpha[/code]."

msgid ""
"Color blend factor is [code]1.0 - destination color[/code]. Alpha blend "
"factor is [code]1.0 - destination alpha[/code]."
msgstr ""
"Коэффициент смешивания цветов составляет[code]1.0 - destination color[/code]. "
"Коэффициент смешивания альфа составляет [code]1.0 - destination alpha[/code]."

msgid "Color and alpha blend factor is [code]source alpha[/code]."
msgstr ""
"Коэффициент смешивания цвета и альфа-канала — [code]source alpha[/code]."

msgid "Color and alpha blend factor is [code]1.0 - source alpha[/code]."
msgstr ""
"Коэффициент смешивания цвета и альфа-канала составляет [code]1.0 - source "
"alpha[/code]."

msgid "Color and alpha blend factor is [code]destination alpha[/code]."
msgstr ""
"Коэффициент смешивания цвета и альфа-канала — [code]destination alpha[/code]."

msgid "Color and alpha blend factor is [code]1.0 - destination alpha[/code]."
msgstr ""
"Коэффициент смешивания цвета и альфа-канала составляет [code]1.0 - "
"destination alpha[/code]."

msgid ""
"Color blend factor is [code]blend constant color[/code]. Alpha blend factor "
"is [code]blend constant alpha[/code] (see [method "
"draw_list_set_blend_constants])."
msgstr ""
"Фактор смешивания цветов — [code]blend constant color[/code].. Фактор "
"смешивания альфа —[code]blend constant alpha[/code] (см. [method "
"draw_list_set_blend_constants])."

msgid ""
"Color blend factor is [code]1.0 - blend constant color[/code]. Alpha blend "
"factor is [code]1.0 - blend constant alpha[/code] (see [method "
"draw_list_set_blend_constants])."
msgstr ""
"Коэффициент смешивания цветов равен [code]1.0 - blend constant color[/code]. "
"Коэффициент смешивания альфа равен [code]1.0 - blend constant alpha[/code] "
"(см. [method draw_list_set_blend_constants])."

msgid ""
"Color and alpha blend factor is [code]blend constant alpha[/code] (see "
"[method draw_list_set_blend_constants])."
msgstr ""
"Коэффициент смешивания цвета и альфа-канала — [code]blend constant alpha[/"
"code] (см. [method draw_list_set_blend_constants])."

msgid ""
"Color and alpha blend factor is [code]1.0 - blend constant alpha[/code] (see "
"[method draw_list_set_blend_constants])."
msgstr ""
"Коэффициент смешивания цвета и альфа-канала равен [code]1.0 - blend constant "
"alpha[/code] (см. [method draw_list_set_blend_constants])."

msgid ""
"Color blend factor is [code]min(source alpha, 1.0 - destination alpha)[/"
"code]. Alpha blend factor is [code]1.0[/code]."
msgstr ""
"Коэффициент смешивания цветов равен [code]min(source alpha, 1.0 - destination "
"alpha)[/code]. Коэффициент смешивания альфа равен [code]1.0[/code]."

msgid ""
"Color blend factor is [code]second source color[/code]. Alpha blend factor is "
"[code]second source alpha[/code]. Only relevant for dual-source blending."
msgstr ""
"Фактор смешивания цветов — [code]second source color[/code]. Фактор "
"смешивания альфа — [code]second source alpha[/code]. Актуально только для "
"смешивания двух источников."

msgid ""
"Color blend factor is [code]1.0 - second source color[/code]. Alpha blend "
"factor is [code]1.0 - second source alpha[/code]. Only relevant for dual-"
"source blending."
msgstr ""
"Коэффициент смешивания цветов равен [code]1.0 - second source color[/code]. "
"Коэффициент смешивания альфа равен [code]1.0 - second source alpha[/code]. "
"Актуально только для смешивания двух источников."

msgid ""
"Color and alpha blend factor is [code]second source alpha[/code]. Only "
"relevant for dual-source blending."
msgstr ""
"Фактор смешивания цвета и альфа-канала — [code]second source alpha[/code]. "
"Актуально только для смешивания двух источников."

msgid ""
"Color and alpha blend factor is [code]1.0 - second source alpha[/code]. Only "
"relevant for dual-source blending."
msgstr ""
"Коэффициент смешивания цвета и альфа-канала составляет [code]1.0 - second "
"source alpha[/code]. Актуально только для смешивания двух источников."

msgid "Represents the size of the [enum BlendFactor] enum."
msgstr "Представляет размер перечисления [enum BlendFactor]."

msgid "Additive blending operation ([code]source + destination[/code])."
msgstr "Операция аддитивного смешивания ([code]source + destination[/code])."

msgid "Subtractive blending operation ([code]source - destination[/code])."
msgstr "Операция субтрактивного смешивания ([code]source - destination[/code])."

msgid ""
"Reverse subtractive blending operation ([code]destination - source[/code])."
msgstr ""
"Операция обратного вычитающего смешивания([code]destination - source[/code])."

msgid "Minimum blending operation (keep the lowest value of the two)."
msgstr ""
"Минимальная операция смешивания (сохранить наименьшее значение из двух)."

msgid "Maximum blending operation (keep the highest value of the two)."
msgstr "Максимальное смешивание (сохранить наибольшее значение из двух)."

msgid "Represents the size of the [enum BlendOperation] enum."
msgstr "Представляет размер перечисления [enum BlendOperation]."

msgid "Allows dynamically changing the width of rendering lines."
msgstr "Позволяет динамически изменять ширину линий рендеринга."

msgid "Allows dynamically changing the depth bias."
msgstr "Позволяет динамически изменять смещение глубины."

msgid "Initial actions are solved automatically by RenderingDevice."
msgstr ""
"Первоначальные действия выполняются автоматически с помощью RenderingDevice."

msgid "Load the previous contents of the framebuffer."
msgstr "Загрузите предыдущее содержимое буфера кадра."

msgid "Clear the whole framebuffer or its specified region."
msgstr "Очистить весь буфер кадра или его указанную область."

msgid ""
"Ignore the previous contents of the framebuffer. This is the fastest option "
"if you'll overwrite all of the pixels and don't need to read any of them."
msgstr ""
"Игнорировать предыдущее содержимое буфера кадра. Это самый быстрый вариант, "
"если вы перезапишете все пиксели и вам не нужно их считывать."

msgid "Represents the size of the [enum InitialAction] enum."
msgstr "Представляет размер перечисления [enum InitialAction]."

msgid "Final actions are solved automatically by RenderingDevice."
msgstr ""
"Окончательные действия выполняются автоматически с помощью RenderingDevice."

msgid ""
"Store the result of the draw list in the framebuffer. This is generally what "
"you want to do."
msgstr ""
"Сохраните результат списка отрисовки в буфере кадра. Это то, что вы обычно "
"хотите сделать."

msgid ""
"Discard the contents of the framebuffer. This is the fastest option if you "
"don't need to use the results of the draw list."
msgstr ""
"Отменить содержимое буфера кадра. Это самый быстрый вариант, если вам не "
"нужно использовать результаты списка розыгрыша."

msgid "Represents the size of the [enum FinalAction] enum."
msgstr "Представляет размер перечисления [enum FinalAction]."

msgid ""
"Vertex shader stage. This can be used to manipulate vertices from a shader "
"(but not create new vertices)."
msgstr ""
"Стадия вершинного шейдера. Это можно использовать для манипулирования "
"вершинами из шейдера (но не для создания новых вершин)."

msgid ""
"Fragment shader stage (called \"pixel shader\" in Direct3D). This can be used "
"to manipulate pixels from a shader."
msgstr ""
"Этап фрагментного шейдера (называемый «пиксельным шейдером» в Direct3D). Его "
"можно использовать для манипулирования пикселями из шейдера."

msgid ""
"Tessellation control shader stage. This can be used to create additional "
"geometry from a shader."
msgstr ""
"Этап шейдера управления тесселяцией. Это можно использовать для создания "
"дополнительной геометрии из шейдера."

msgid ""
"Tessellation evaluation shader stage. This can be used to create additional "
"geometry from a shader."
msgstr ""
"Этап шейдера оценки тесселяции. Это можно использовать для создания "
"дополнительной геометрии из шейдера."

msgid ""
"Compute shader stage. This can be used to run arbitrary computing tasks in a "
"shader, performing them on the GPU instead of the CPU."
msgstr ""
"Этап вычислительного шейдера. Это может быть использовано для запуска "
"произвольных вычислительных задач в шейдере, выполняя их на GPU вместо CPU."

msgid "Represents the size of the [enum ShaderStage] enum."
msgstr "Представляет размер перечисления [enum ShaderStage]."

msgid "Vertex shader stage bit (see also [constant SHADER_STAGE_VERTEX])."
msgstr ""
"Бит этапа вершинного шейдера (см. также [constant SHADER_STAGE_VERTEX])."

msgid "Fragment shader stage bit (see also [constant SHADER_STAGE_FRAGMENT])."
msgstr ""
"Бит этапа фрагментного шейдера (см. также [constant SHADER_STAGE_FRAGMENT])."

msgid ""
"Tessellation control shader stage bit (see also [constant "
"SHADER_STAGE_TESSELATION_CONTROL])."
msgstr ""
"Бит этапа шейдера управления тесселяцией (см. также [constant "
"SHADER_STAGE_TESSELATION_CONTROL])."

msgid ""
"Tessellation evaluation shader stage bit (see also [constant "
"SHADER_STAGE_TESSELATION_EVALUATION])."
msgstr ""
"Бит этапа шейдера оценки тесселяции (см. также [constant "
"SHADER_STAGE_TESSELATION_EVALUATION])."

msgid "Compute shader stage bit (see also [constant SHADER_STAGE_COMPUTE])."
msgstr ""
"Вычислить бит этапа шейдера (см. также [constant SHADER_STAGE_COMPUTE])."

msgid ""
"Khronos' GLSL shading language (used natively by OpenGL and Vulkan). This is "
"the language used for core Godot shaders."
msgstr ""
"Язык шейдеров Khronos GLSL (используется изначально OpenGL и Vulkan). Это "
"язык, используемый для основных шейдеров Godot."

msgid ""
"Microsoft's High-Level Shading Language (used natively by Direct3D, but can "
"also be used in Vulkan)."
msgstr ""
"Язык шейдеров высокого уровня от Microsoft (используется изначально в "
"Direct3D, но может также использоваться в Vulkan)."

msgid "Boolean specialization constant."
msgstr "Константа логической специализации."

msgid "Integer specialization constant."
msgstr "Целочисленная константа специализации."

msgid "Floating-point specialization constant."
msgstr "Константа специализации с плавающей точкой."

msgid "Support for MetalFX spatial upscaling."
msgstr "Поддержка пространственного (spatial) увеличения разрешения MetalFX."

msgid "Support for MetalFX temporal upscaling."
msgstr "Поддержка MetalFX temporal upscaling."

msgid "Features support for buffer device address extension."
msgstr "Поддерживает расширение адреса буферного устройства."

msgid "Support for 32-bit image atomic operations."
msgstr "Поддержка 32-разрядных атомных операций изображения."

msgid "Maximum number of uniform sets that can be bound at a given time."
msgstr ""
"Максимальное количество комплектов униформы, которые можно связать "
"одновременно."

msgid ""
"Maximum number of color framebuffer attachments that can be used at a given "
"time."
msgstr ""
"Максимальное количество подключений цветного кадрового буфера, которые можно "
"использовать одновременно."

msgid "Maximum number of textures that can be used per uniform set."
msgstr ""
"Максимальное количество текстур, которые можно использовать в одном наборе "
"униформы."

msgid "Maximum number of samplers that can be used per uniform set."
msgstr ""
"Максимальное количество пробоотборников, которые можно использовать в одном "
"наборе."

msgid ""
"Maximum number of [url=https://vkguide.dev/docs/chapter-4/"
"storage_buffers/]storage buffers[/url] per uniform set."
msgstr ""
"Максимальное количество [url=https://vkguide.dev/docs/chapter-4/"
"storage_buffers/]буферов хранения[/url] на унифицированный набор."

msgid "Maximum number of storage images per uniform set."
msgstr ""
"Максимальное количество хранимых изображений на один унифицированный набор."

msgid "Maximum number of uniform buffers per uniform set."
msgstr "Максимальное количество однородных буферов на однородный набор."

msgid "Maximum index for an indexed draw command."
msgstr "Максимальный индекс для индексированной команды рисования."

msgid "Maximum height of a framebuffer (in pixels)."
msgstr "Максимальная высота буфера кадра (в пикселях)."

msgid "Maximum width of a framebuffer (in pixels)."
msgstr "Максимальная ширина буфера кадра (в пикселях)."

msgid "Maximum number of texture array layers."
msgstr "Максимальное количество слоев массива текстур."

msgid ""
"Maximum supported 1-dimensional texture size (in pixels on a single axis)."
msgstr ""
"Максимальный поддерживаемый размер одномерной текстуры (в пикселях по одной "
"оси)."

msgid ""
"Maximum supported 2-dimensional texture size (in pixels on a single axis)."
msgstr ""
"Максимальный поддерживаемый размер двумерной текстуры (в пикселях по одной "
"оси)."

msgid ""
"Maximum supported 3-dimensional texture size (in pixels on a single axis)."
msgstr ""
"Максимальный поддерживаемый размер трёхмерной текстуры (в пикселях по одной "
"оси)."

msgid ""
"Maximum supported cubemap texture size (in pixels on a single axis of a "
"single face)."
msgstr ""
"Максимальный поддерживаемый размер текстуры cubemap (в пикселях на одной оси "
"одной грани)."

msgid "Maximum number of textures per shader stage."
msgstr "Максимальное количество текстур на этап шейдера."

msgid "Maximum number of samplers per shader stage."
msgstr "Максимальное количество сэмплеров на одну стадию шейдера."

msgid ""
"Maximum number of [url=https://vkguide.dev/docs/chapter-4/"
"storage_buffers/]storage buffers[/url] per shader stage."
msgstr ""
"Максимальное количество [url=https://vkguide.dev/docs/chapter-4/"
"storage_buffers/]буферов хранения[/url] на этап шейдера."

msgid "Maximum number of storage images per shader stage."
msgstr "Максимальное количество хранимых изображений на каждом этапе шейдера."

msgid ""
"Maximum size of a push constant. A lot of devices are limited to 128 bytes, "
"so try to avoid exceeding 128 bytes in push constants to ensure compatibility "
"even if your GPU is reporting a higher value."
msgstr ""
"Максимальный размер константы push. Многие устройства ограничены 128 байтами, "
"поэтому старайтесь избегать превышения 128 байт в константах push, чтобы "
"обеспечить совместимость, даже если ваш графический процессор сообщает более "
"высокое значение."

msgid "Maximum size of a uniform buffer."
msgstr "Максимальный размер равномерного буфера."

msgid "Maximum vertex input attribute offset."
msgstr "Максимальное смещение атрибута входной вершины."

msgid "Maximum number of vertex input attributes."
msgstr "Максимальное количество входных атрибутов вершин."

msgid "Maximum number of vertex input bindings."
msgstr "Максимальное количество входных привязок вершин."

msgid "Maximum vertex input binding stride."
msgstr "Максимальный шаг привязки входных вершин."

msgid "Minimum uniform buffer offset alignment."
msgstr "Минимальное равномерное выравнивание смещения буфера."

msgid "Maximum shared memory size for compute shaders."
msgstr "Максимальный размер разделяемой памяти для вычислительных шейдеров."

msgid "Maximum number of workgroups for compute shaders on the X axis."
msgstr ""
