"ProjectSettings.layer_names/3d_navigation/layer_1].\n"
"See also [constant PROPERTY_HINT_LAYERS_3D_NAVIGATION].\n"
"[codeblock]\n"
"@export_flags_3d_navigation var navigation_layers: int\n"
