"[csharp]\n"
"var color = new Color(1.0f, 0.5f, 0.2f);\n"
"GD.Print(color.ToArgb32()); // Imprime 4294934323\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Returns the color converted to a 64-bit integer in ARGB format (each "
