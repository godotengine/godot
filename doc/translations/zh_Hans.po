msgstr "将 [param index] 处的设备从已发现的设备列表中设置为 [param device]。"

msgid "If [code]true[/code], IPv6 is used for [UPNPDevice] discovery."
msgstr "如果为 [code]true[/code]，则 IPv6 用于 [UPNPDevice] 发现。"

msgid ""
