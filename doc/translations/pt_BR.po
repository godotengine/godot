msgstr "Retorna a escala de pose do osso em [param bone_idx]."

msgid "Returns the rest transform for a bone [param bone_idx]."
msgstr "Retorna a transformação de repouso para um osso [param bone_idx]."

msgid ""
"Returns [code]true[/code] if the bone at index [param bone_idx] has metadata "
"with the given [param key]."
msgstr ""
"Retorna [code]true[/code] se o osso no índice [param bone_idx] tiver "
"metadados com a [param key] dada."

msgid "Sets the bone pose to rest for [param bone_idx]."
msgstr "Define a pose do osso para repouso para [param bone_idx]."

msgid ""
"Sets the metadata with the given [param key] to [param value] for the bone at "
"index [param bone_idx]."
msgstr ""
"Define os metadados com a [param key] dada para [param value] para o osso no "
"índice [param bone_idx]."

msgid "Sets the bone name, [param name], for the bone at [param bone_idx]."
msgstr "Define o nome do osso, [param name], para o osso em [param bone_idx]."

msgid "Sets the pose transform, [param pose], for the bone at [param bone_idx]."
msgstr ""
"Define a transformação de pose, [param pose], para o osso em [param bone_idx]."

msgid "Sets the pose scale of the bone at [param bone_idx] to [param scale]."
msgstr "Define a escala de pose do osso em [param bone_idx] para [param scale]."

msgid "Sets the rest transform for bone [param bone_idx]."
msgstr "Define a transformação de repouso para o osso [param bone_idx]."

msgid "Returns the magnet position vector for the joint at [param joint_idx]."
msgstr "Retorna o vetor de posição do ímã para a junta em [param joint_idx]."

msgid "Sets the magnet position vector for the joint at [param joint_idx]."
msgstr "Define o vetor de posição do ímã para a junta em [param joint_idx]."

msgid "Returns the stiffness of the Jiggle joint at [param joint_idx]."
msgstr "Retorna a rigidez da junta Jiggle em [param joint_idx]."

msgid ""
"Returns the [SkeletonModification2D] at the passed-in index, [param mod_idx]."
msgstr "Retorna o [SkeletonModification2D] no índice passado, [param mod_idx]."

msgid ""
"Returns the name of the bone which is the tail of the bone at [param "
