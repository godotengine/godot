msgstr "Retorna o nome do osso que é a cauda do osso em [param bone_idx]."

msgid "Returns the group of the bone at [param bone_idx]."
msgstr "Retorna o grupo do osso em [param bone_idx]."

msgid "Returns the reference pose transform for bone [param bone_idx]."
msgstr ""
"Retorna a transformação de pose de referência para o osso [param bone_idx]."

msgid "Returns the tail direction of the bone at [param bone_idx]."
msgstr "Retorna a direção da cauda do osso em [param bone_idx]."

msgid "Sets the group of the bone at [param bone_idx]."
msgstr "Define o grupo do osso em [param bone_idx]."

msgid "Sets the reference pose transform for bone [param bone_idx]."
msgstr ""
"Define a transformação de pose de referência para o osso [param bone_idx]."

msgid "Sets the required status for bone [param bone_idx] to [param required]."
msgstr ""
"Define o status obrigatório para o osso [param bone_idx] para [param "
