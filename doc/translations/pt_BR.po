msgid "A shortcut for binding input."
msgstr "Um atalho para vincular entrada."

msgid "Returns the shortcut's first valid [InputEvent] as a [String]."
msgstr "Retorna o primeiro [InputEvent] válido do atalho como uma [String]."

msgid "Returns whether [member events] contains an [InputEvent] which is valid."
msgstr "Retorna se [member events] contém um [InputEvent] que é válido."

msgid ""
