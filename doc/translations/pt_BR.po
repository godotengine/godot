msgid "Helper class to implement a UDP server."
msgstr "Classe auxiliar para implementar um servidor UDP."

msgid ""
"A simple server that opens a UDP socket and returns connected [PacketPeerUDP] "
"upon receiving new packets. See also [method PacketPeerUDP.connect_to_host].\n"
"After starting the server ([method listen]), you will need to [method poll] "
"it at regular intervals (e.g. inside [method Node._process]) for it to "
"process new packets, delivering them to the appropriate [PacketPeerUDP], and "
"taking new connections.\n"
"Below a small example of how it can be used:\n"
"[codeblocks]\n"
"[gdscript]\n"
"# server_node.gd\n"
"class_name ServerNode\n"
"extends Node\n"
"\n"
"var server = UDPServer.new()\n"
"var peers = []\n"
"\n"
"func _ready():\n"
"\tserver.listen(4242)\n"
"\n"
"func _process(delta):\n"
"\tserver.poll() # Important!\n"
"\tif server.is_connection_available():\n"
"\t\tvar peer = server.take_connection()\n"
"\t\tvar packet = peer.get_packet()\n"
"\t\tprint(\"Accepted peer: %s:%s\" % [peer.get_packet_ip(), "
"peer.get_packet_port()])\n"
"\t\tprint(\"Received data: %s\" % [packet.get_string_from_utf8()])\n"
"\t\t# Reply so it knows we received the message.\n"
"\t\tpeer.put_packet(packet)\n"
"\t\t# Keep a reference so we can keep contacting the remote peer.\n"
"\t\tpeers.append(peer)\n"
"\n"
"\tfor i in range(0, peers.size()):\n"
"\t\tpass # Do something with the connected peers.\n"
"[/gdscript]\n"
"[csharp]\n"
"// ServerNode.cs\n"
"using Godot;\n"
"using System.Collections.Generic;\n"
"\n"
"public partial class ServerNode : Node\n"
"{\n"
"\tprivate UdpServer _server = new UdpServer();\n"
"\tprivate List<PacketPeerUdp> _peers  = new List<PacketPeerUdp>();\n"
"\n"
"\tpublic override void _Ready()\n"
"\t{\n"
"\t\t_server.Listen(4242);\n"
"\t}\n"
"\n"
"\tpublic override void _Process(double delta)\n"
"\t{\n"
"\t\t_server.Poll(); // Important!\n"
"\t\tif (_server.IsConnectionAvailable())\n"
"\t\t{\n"
"\t\t\tPacketPeerUdp peer = _server.TakeConnection();\n"
"\t\t\tbyte[] packet = peer.GetPacket();\n"
"\t\t\tGD.Print($\"Accepted Peer: {peer.GetPacketIP()}:{peer.GetPacketPort()}"
"\");\n"
"\t\t\tGD.Print($\"Received Data: {packet.GetStringFromUtf8()}\");\n"
"\t\t\t// Reply so it knows we received the message.\n"
"\t\t\tpeer.PutPacket(packet);\n"
"\t\t\t// Keep a reference so we can keep contacting the remote peer.\n"
"\t\t\t_peers.Add(peer);\n"
"\t\t}\n"
"\t\tforeach (var peer in _peers)\n"
"\t\t{\n"
"\t\t\t// Do something with the peers.\n"
"\t\t}\n"
"\t}\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[codeblocks]\n"
"[gdscript]\n"
"# client_node.gd\n"
"class_name ClientNode\n"
"extends Node\n"
"\n"
"var udp = PacketPeerUDP.new()\n"
"var connected = false\n"
"\n"
"func _ready():\n"
"\tudp.connect_to_host(\"127.0.0.1\", 4242)\n"
"\n"
"func _process(delta):\n"
"\tif !connected:\n"
"\t\t# Try to contact server\n"
"\t\tudp.put_packet(\"The answer is... 42!\".to_utf8_buffer())\n"
"\tif udp.get_available_packet_count() > 0:\n"
"\t\tprint(\"Connected: %s\" % udp.get_packet().get_string_from_utf8())\n"
"\t\tconnected = true\n"
"[/gdscript]\n"
"[csharp]\n"
"// ClientNode.cs\n"
"using Godot;\n"
"\n"
"public partial class ClientNode : Node\n"
"{\n"
"\tprivate PacketPeerUdp _udp = new PacketPeerUdp();\n"
"\tprivate bool _connected = false;\n"
"\n"
"\tpublic override void _Ready()\n"
"\t{\n"
"\t\t_udp.ConnectToHost(\"127.0.0.1\", 4242);\n"
"\t}\n"
"\n"
"\tpublic override void _Process(double delta)\n"
"\t{\n"
"\t\tif (!_connected)\n"
"\t\t{\n"
"\t\t\t// Try to contact server\n"
"\t\t\t_udp.PutPacket(\"The Answer Is..42!\".ToUtf8Buffer());\n"
"\t\t}\n"
"\t\tif (_udp.GetAvailablePacketCount() > 0)\n"
"\t\t{\n"
"\t\t\tGD.Print($\"Connected: {_udp.GetPacket().GetStringFromUtf8()}\");\n"
"\t\t\t_connected = true;\n"
"\t\t}\n"
"\t}\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"Um servidor simples que abre um soquete UDP e retorna um [PacketPeerUDP] "
"conectado ao receber novos pacotes. Veja também [method "
"PacketPeerUDP.connect_to_host].\n"
"Após iniciar o servidor ([method listen]), você precisará fazer o polling "
"dele ([method poll]) em intervalos regulares (por exemplo, dentro de [method "
"Node._process]) para que ele processe novos pacotes, entregando-os ao "
"[PacketPeerUDP] apropriado e aceitando novas conexões.\n"
"Abaixo está um pequeno exemplo de como ele pode ser usado:\n"
"[codeblocks]\n"
"[gdscript]\n"
"# server_node.gd\n"
"class_name ServerNode\n"
"extends Node\n"
"\n"
"var server = UDPServer.new()\n"
"var peers = []\n"
"\n"
"func _ready():\n"
"\tserver.listen(4242)\n"
"\n"
"func _process(delta):\n"
"\tserver.poll() # Importante!\n"
"\tif server.is_connection_available():\n"
"\t\tvar peer = server.take_connection()\n"
"\t\tvar packet = peer.get_packet()\n"
"\t\tprint(\"Parceiro aceito: %s:%s\" % [peer.get_packet_ip(), "
"peer.get_packet_port()])\n"
"\t\tprint(\"Dados recebidos: %s\" % [packet.get_string_from_utf8()])\n"
"\t\t# Responde para que ele saiba que recebemos a mensagem.\n"
"\t\tpeer.put_packet(packet)\n"
"\t\t# Mantém uma referência para podermos continuar contatando o parceiro "
"remoto.\n"
"\t\tpeers.append(peer)\n"
"\n"
"\tfor i in range(0, peers.size()):\n"
"\t\tpass # Faça algo com os parceiros conectados.\n"
"[/gdscript]\n"
"[csharp]\n"
"// ServerNode.cs\n"
"using Godot;\n"
"using System.Collections.Generic;\n"
"\n"
"public partial class ServerNode : Node\n"
"{\n"
"\tprivate UdpServer _server = new UdpServer();\n"
"\tprivate List<PacketPeerUdp> _peers  = new List<PacketPeerUdp>();\n"
"\n"
"\tpublic override void _Ready()\n"
"\t{\n"
"\t\t_server.Listen(4242);\n"
"\t}\n"
"\n"
"\tpublic override void _Process(double delta)\n"
"\t{\n"
"\t\t_server.Poll(); // Importante!\n"
"\t\tif (_server.IsConnectionAvailable())\n"
"\t\t{\n"
"\t\t\tPacketPeerUdp peer = _server.TakeConnection();\n"
"\t\t\tbyte[] packet = peer.GetPacket();\n"
"\t\t\tGD.Print($\"Parceiro Aceito: {peer.GetPacketIP()}:{peer.GetPacketPort()}"
"\");\n"
"\t\t\tGD.Print($\"Dados Recebidos: {packet.GetStringFromUtf8()}\");\n"
"\t\t\t// Responde para que ele saiba que recebemos a mensagem.\n"
"\t\t\tpeer.PutPacket(packet);\n"
"\t\t\t// Mantém uma referência para podermos continuar contatando o parceiro "
"remoto.\n"
"\t\t\t_peers.Add(peer);\n"
"\t\t}\n"
"\t\tforeach (var peer in _peers)\n"
"\t\t{\n"
"\t\t\t// Faça algo com os parceiros.\n"
"\t\t}\n"
"\t}\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[codeblocks]\n"
"[gdscript]\n"
"# client_node.gd\n"
"class_name ClientNode\n"
"extends Node\n"
"\n"
"var udp = PacketPeerUDP.new()\n"
"var connected = false\n"
"\n"
"func _ready():\n"
"\tudp.connect_to_host(\"127.0.0.1\", 4242)\n"
"\n"
"func _process(delta):\n"
"\tif !connected:\n"
"\t\t# Tenta contatar o servidor\n"
"\t\tudp.put_packet(\"The answer is... 42!\".to_utf8_buffer())\n"
"\tif udp.get_available_packet_count() > 0:\n"
"\t\tprint(\"Conectado: %s\" % udp.get_packet().get_string_from_utf8())\n"
"\t\tconnected = true\n"
"[/gdscript]\n"
"[csharp]\n"
"// ClientNode.cs\n"
"using Godot;\n"
"\n"
"public partial class ClientNode : Node\n"
"{\n"
"\tprivate PacketPeerUdp _udp = new PacketPeerUdp();\n"
"\tprivate bool _connected = false;\n"
"\n"
"\tpublic override void _Ready()\n"
"\t{\n"
"\t\t_udp.ConnectToHost(\"127.0.0.1\", 4242);\n"
"\t}\n"
"\n"
"\tpublic override void _Process(double delta)\n"
"\t{\n"
"\t\tif (!_connected)\n"
"\t\t{\n"
"\t\t\t// Tenta contatar o servidor\n"
"\t\t\t_udp.PutPacket(\"The Answer Is..42!\".ToUtf8Buffer());\n"
"\t\t}\n"
"\t\tif (_udp.GetAvailablePacketCount() > 0)\n"
"\t\t{\n"
"\t\t\tGD.Print($\"Conectado: {_udp.GetPacket().GetStringFromUtf8()}\");\n"
"\t\t\t_connected = true;\n"
"\t\t}\n"
"\t}\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Returns [code]true[/code] if a packet with a new address/port combination was "
"received on the socket."
msgstr ""
"Retorna [code]true[/code] se um pacote com uma nova combinação de endereço/"
"porta foi recebido no socket."

msgid "Returns [code]true[/code] if the socket is open and listening on a port."
msgstr ""
"Retorna [code]true[/code] se o socket estiver aberto e ouvindo em uma porta."

msgid ""
"Starts the server by opening a UDP socket listening on the given [param "
"port]. You can optionally specify a [param bind_address] to only listen for "
"packets sent to that address. See also [method PacketPeerUDP.bind]."
msgstr ""
"Inicia o servidor abrindo um socket UDP que escuta na [param port] fornecida. "
"Opcionalmente, você pode especificar um [param bind_address] para escutar "
"apenas pacotes enviados para esse endereço. Veja também [method "
"PacketPeerUDP.bind]."

msgid ""
"Call this method at regular intervals (e.g. inside [method Node._process]) to "
"process new packets. Any packet from a known address/port pair will be "
"delivered to the appropriate [PacketPeerUDP], while any packet received from "
"an unknown address/port pair will be added as a pending connection (see "
"[method is_connection_available] and [method take_connection]). The maximum "
"number of pending connections is defined via [member max_pending_connections]."
msgstr ""
"Chame este método em intervalos regulares (por exemplo, dentro de [method "
"Node._process]) para processar novos pacotes. Qualquer pacote de um par de "
"endereço/porta conhecido será entregue ao [PacketPeerUDP] apropriado, "
"enquanto qualquer pacote recebido de um par de endereço/porta desconhecido "
"será adicionado como uma conexão pendente (veja [method "
"is_connection_available] e [method take_connection]). O número máximo de "
"conexões pendentes é definido via [member max_pending_connections]."

msgid ""
"Stops the server, closing the UDP socket if open. Will close all connected "
"[PacketPeerUDP] accepted via [method take_connection] (remote peers will not "
"be notified)."
msgstr ""
"Para o servidor, fechando o socket UDP se estiver aberto. Fechará todos os "
"[PacketPeerUDP] conectados aceitos via [method take_connection] (peers "
"remotos não serão notificados)."

msgid ""
"Returns the first pending connection (connected to the appropriate address/"
"port). Will return [code]null[/code] if no new connection is available. See "
"also [method is_connection_available], [method PacketPeerUDP.connect_to_host]."
msgstr ""
"Retorna a primeira conexão pendente (conectada ao endereço/porta apropriado). "
"Retornará [code]null[/code] se nenhuma nova conexão estiver disponível. Veja "
"também [method is_connection_available], [method "
"PacketPeerUDP.connect_to_host]."

msgid ""
"Define the maximum number of pending connections, during [method poll], any "
"new pending connection exceeding that value will be automatically dropped. "
"Setting this value to [code]0[/code] effectively prevents any new pending "
"connection to be accepted (e.g. when all your players have connected)."
msgstr ""
"Define o número máximo de conexões pendentes; durante [method poll], qualquer "
"nova conexão pendente que exceda esse valor será descartada automaticamente. "
"Definir este valor como [code]0[/code] efetivamente impede que qualquer nova "
"conexão pendente seja aceita (por exemplo, quando todos os seus jogadores se "
"conectarem)."

msgid "A Unix Domain Socket (UDS) server."
msgstr "Um servidor Unix Domain Socket (UDS)."

msgid ""
"If a connection is available, returns a StreamPeerUDS with the connection."
msgstr ""
"Se uma conexão estiver disponível, retorna um StreamPeerUDS com a conexão."

msgid ""
"Provides a high-level interface for implementing undo and redo operations."
msgstr ""
"Fornece uma interface de alto nível para implementar operações de desfazer e "
"refazer."

msgid ""
"UndoRedo works by registering methods and property changes inside "
"\"actions\". You can create an action, then provide ways to do and undo this "
"action using function calls and property changes, then commit the action.\n"
"When an action is committed, all of the [code]do_*[/code] methods will run. "
"If the [method undo] method is used, the [code]undo_*[/code] methods will "
"run. If the [method redo] method is used, once again, all of the [code]do_*[/"
"code] methods will run.\n"
"Here's an example on how to add an action:\n"
"[codeblocks]\n"
"[gdscript]\n"
"var undo_redo = UndoRedo.new()\n"
"\n"
"func do_something():\n"
"\tpass # Put your code here.\n"
"\n"
"func undo_something():\n"
"\tpass # Put here the code that reverts what's done by \"do_something()\".\n"
"\n"
"func _on_my_button_pressed():\n"
"\tvar node = get_node(\"MyNode2D\")\n"
"\tundo_redo.create_action(\"Move the node\")\n"
"\tundo_redo.add_do_method(do_something)\n"
"\tundo_redo.add_undo_method(undo_something)\n"
"\tundo_redo.add_do_property(node, \"position\", Vector2(100, 100))\n"
"\tundo_redo.add_undo_property(node, \"position\", node.position)\n"
"\tundo_redo.commit_action()\n"
"[/gdscript]\n"
"[csharp]\n"
"private UndoRedo _undoRedo;\n"
"\n"
"public override void _Ready()\n"
"{\n"
"\t_undoRedo = new UndoRedo();\n"
"}\n"
"\n"
"public void DoSomething()\n"
"{\n"
"\t// Put your code here.\n"
"}\n"
"\n"
"public void UndoSomething()\n"
"{\n"
"\t// Put here the code that reverts what's done by \"DoSomething()\".\n"
"}\n"
"\n"
"private void OnMyButtonPressed()\n"
"{\n"
"\tvar node = GetNode<Node2D>(\"MyNode2D\");\n"
"\t_undoRedo.CreateAction(\"Move the node\");\n"
"\t_undoRedo.AddDoMethod(new Callable(this, MethodName.DoSomething));\n"
"\t_undoRedo.AddUndoMethod(new Callable(this, MethodName.UndoSomething));\n"
"\t_undoRedo.AddDoProperty(node, \"position\", new Vector2(100, 100));\n"
"\t_undoRedo.AddUndoProperty(node, \"position\", node.Position);\n"
"\t_undoRedo.CommitAction();\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]\n"
"Before calling any of the [code]add_(un)do_*[/code] methods, you need to "
"first call [method create_action]. Afterwards you need to call [method "
"commit_action].\n"
"If you don't need to register a method, you can leave [method add_do_method] "
"and [method add_undo_method] out; the same goes for properties. You can also "
"register more than one method/property.\n"
"If you are making an [EditorPlugin] and want to integrate into the editor's "
"undo history, use [EditorUndoRedoManager] instead.\n"
"If you are registering multiple properties/method which depend on one "
"another, be aware that by default undo operation are called in the same order "
"they have been added. Therefore instead of grouping do operation with their "
"undo operations it is better to group do on one side and undo on the other as "
"shown below.\n"
"[codeblocks]\n"
"[gdscript]\n"
"undo_redo.create_action(\"Add object\")\n"
"\n"
"# DO\n"
"undo_redo.add_do_method(_create_object)\n"
"undo_redo.add_do_method(_add_object_to_singleton)\n"
"\n"
"# UNDO\n"
"undo_redo.add_undo_method(_remove_object_from_singleton)\n"
"undo_redo.add_undo_method(_destroy_that_object)\n"
"\n"
"undo_redo.commit_action()\n"
"[/gdscript]\n"
"[csharp]\n"
"_undo_redo.CreateAction(\"Add object\");\n"
"\n"
"// DO\n"
"_undo_redo.AddDoMethod(new Callable(this, MethodName.CreateObject));\n"
"_undo_redo.AddDoMethod(new Callable(this, MethodName.AddObjectToSingleton));\n"
"\n"
"// UNDO\n"
"_undo_redo.AddUndoMethod(new Callable(this, "
"MethodName.RemoveObjectFromSingleton));\n"
"_undo_redo.AddUndoMethod(new Callable(this, MethodName.DestroyThatObject));\n"
"\n"
"_undo_redo.CommitAction();\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"UndoRedo funciona registrando métodos e alterações de propriedades dentro de "
"\"ações\". Você pode criar uma ação, fornecer maneiras de realizar e desfazer "
"essa ação usando chamadas de função e alterações de propriedade e, em "
"seguida, confirmar a ação.\n"
"Quando uma ação é confirmada, todos os métodos [code]do_*[/code] serão "
"executados. Se o método [method undo] for usado, os métodos [code]undo_*[/"
"code] serão executados. Se o método [method redo] for usado, mais uma vez, "
"todos os métodos [code]do_*[/code] serão executados.\n"
"Aqui está um exemplo de como adicionar uma ação:\n"
"[codeblocks]\n"
"[gdscript]\n"
"var undo_redo = UndoRedo.new()\n"
"\n"
"func do_something():\n"
"\tpass # Coloque seu código aqui.\n"
"\n"
"func undo_something():\n"
"\tpass # Coloque aqui o código que reverte o que foi feito por "
"\"do_something()\".\n"
"\n"
"func _on_my_button_pressed():\n"
"\tvar node = get_node(\"MyNode2D\")\n"
"\tundo_redo.create_action(\"Mover o nó\")\n"
"\tundo_redo.add_do_method(do_something)\n"
"\tundo_redo.add_undo_method(undo_something)\n"
"\tundo_redo.add_do_property(node, \"position\", Vector2(100, 100))\n"
"\tundo_redo.add_undo_property(node, \"position\", node.position)\n"
"\tundo_redo.commit_action()\n"
"[/gdscript]\n"
"[csharp]\n"
"private UndoRedo _undoRedo;\n"
"\n"
"public override void _Ready()\n"
"{\n"
"\t_undoRedo = new UndoRedo();\n"
"}\n"
"\n"
"public void DoSomething()\n"
"{\n"
"\t// Coloque seu código aqui.\n"
"}\n"
"\n"
"public void UndoSomething()\n"
"{\n"
"\t// Coloque aqui o código que reverte o que foi feito por \"DoSomething()"
"\".\n"
"}\n"
"\n"
"private void OnMyButtonPressed()\n"
"{\n"
"\tvar node = GetNode<Node2D>(\"MyNode2D\");\n"
"\t_undoRedo.CreateAction(\"Mover o nó\");\n"
"\t_undoRedo.AddDoMethod(new Callable(this, MethodName.DoSomething));\n"
"\t_undoRedo.AddUndoMethod(new Callable(this, MethodName.UndoSomething));\n"
"\t_undoRedo.AddDoProperty(node, \"position\", new Vector2(100, 100));\n"
"\t_undoRedo.AddUndoProperty(node, \"position\", node.Position);\n"
"\t_undoRedo.CommitAction();\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]\n"
"Antes de chamar qualquer um dos métodos [code]add_(un)do_*[/code], você "
"precisa primeiro chamar [method create_action]. Depois, você precisa chamar "
"[method commit_action].\n"
"Se você não precisar registrar um método, poderá omitir [method "
"add_do_method] e [method add_undo_method]; o mesmo vale para propriedades. "
"Você também pode registrar mais de um método/propriedade.\n"
"Se você estiver criando um [EditorPlugin] e quiser se integrar ao histórico "
"de desfazer do editor, use [EditorUndoRedoManager] em vez disso.\n"
"Se você estiver registrando várias propriedades/métodos que dependem umas dos "
"outros, esteja ciente de que, por padrão, as operações de desfazer são "
"chamadas na mesma ordem em que foram adicionadas. Portanto, em vez de agrupar "
"a operação de execução (\"do\") com suas operações de desfazer "
"correspondentes, é melhor agrupar as execuções de um lado e as operações de "
"desfazer do outro, conforme mostrado abaixo.\n"
"[codeblocks]\n"
"[gdscript]\n"
"undo_redo.create_action(\"Adicionar objeto\")\n"
"\n"
"# FAZER (DO)\n"
"undo_redo.add_do_method(_create_object)\n"
"undo_redo.add_do_method(_add_object_to_singleton)\n"
"\n"
"# DESFAZER (UNDO)\n"
"undo_redo.add_undo_method(_remove_object_from_singleton)\n"
"undo_redo.add_undo_method(_destroy_that_object)\n"
"\n"
"undo_redo.commit_action()\n"
"[/gdscript]\n"
"[csharp]\n"
"_undo_redo.CreateAction(\"Adicionar objeto\");\n"
"\n"
"// FAZER (DO)\n"
"_undo_redo.AddDoMethod(new Callable(this, MethodName.CreateObject));\n"
"_undo_redo.AddDoMethod(new Callable(this, MethodName.AddObjectToSingleton));\n"
"\n"
"// DESFAZER (UNDO)\n"
"_undo_redo.AddUndoMethod(new Callable(this, "
"MethodName.RemoveObjectFromSingleton));\n"
"_undo_redo.AddUndoMethod(new Callable(this, MethodName.DestroyThatObject));\n"
"\n"
"_undo_redo.CommitAction();\n"
"[/csharp]\n"
"[/codeblocks]"

msgid "Register a [Callable] that will be called when the action is committed."
msgstr "Registra um [Callable] que será chamado quando a ação for efetivada."

msgid ""
"Register a [param property] that would change its value to [param value] when "
"the action is committed."
msgstr ""
"Registra uma [param property] que teria seu valor alterado para [param value] "
"quando a ação for confirmada."

msgid "Register a [Callable] that will be called when the action is undone."
msgstr "Registra um [Callable] que será chamado quando a ação for desfeita."

msgid ""
"Register a [param property] that would change its value to [param value] when "
"the action is undone."
msgstr ""
"Registra uma [param property] que teria seu valor alterado para [param value] "
"quando a ação for desfeita."

msgid ""
"Commit the action. If [param execute] is [code]true[/code] (which it is by "
"default), all \"do\" methods/properties are called/set when this function is "
"called."
msgstr ""
"Confirma a ação. Se [param execute] for [code]true[/code] (o que é por "
"padrão), todos os métodos/propriedades \"do\" são chamados/definidos quando "
"esta função é chamada."

msgid ""
"Stops marking operations as to be processed even if the action gets merged "
"with another in the [constant MERGE_ENDS] mode. See [method "
"start_force_keep_in_merge_ends]."
msgstr ""
"Para de marcar operações para serem processadas, mesmo que a ação seja "
"mesclada com outra no modo [constant MERGE_ENDS]. Veja [method "
"start_force_keep_in_merge_ends]."

msgid "Gets the action name from its index."
msgstr "Obtém o nome da ação a partir do seu índice."

msgid "Gets the index of the current action."
msgstr "Obtém o índice da ação atual."

msgid ""
"Gets the name of the current action, equivalent to "
"[code]get_action_name(get_current_action())[/code]."
msgstr ""
"Obtém o nome da ação atual, equivalente a "
"[code]get_action_name(get_current_action())[/code]."

msgid "Returns how many elements are in the history."
msgstr "Retorna quantos elementos estão no histórico."

msgid ""
"Returns [code]true[/code] if the [UndoRedo] is currently committing the "
"action, i.e. running its \"do\" method or property change (see [method "
"commit_action])."
msgstr ""
"Retorna [code]true[/code] se o [UndoRedo] estiver confirmando a ação no "
"momento, ou seja, executando seu método \"do\" ou alteração de propriedade "
"(consulte [method commit_action])."

msgid ""
"Redo the last action. Returns [code]false[/code] if there was no action to "
"redo."
msgstr ""
"Refaz a última ação. Retorna [code]false[/code] se não houver ação para "
"refazer."

msgid ""
"Marks the next \"do\" and \"undo\" operations to be processed even if the "
"action gets merged with another in the [constant MERGE_ENDS] mode. Return to "
"normal operation using [method end_force_keep_in_merge_ends]."
msgstr ""
"Marca as próximas operações \"do\" e \"undo\" para serem processadas mesmo se "
"a ação for mesclada com outra no modo [constant MERGE_ENDS]. Retorne à "
"operação normal usando [method end_force_keep_in_merge_ends]."

msgid ""
"Undo the last action. Returns [code]false[/code] if there was no action to "
"undo."
msgstr ""
"Desfaz a última ação. Retorna [code]false[/code] se não houver ação para "
"desfazer."

msgid ""
"The maximum number of steps that can be stored in the undo/redo history. If "
"the number of stored steps exceeds this limit, older steps are removed from "
"history and can no longer be reached by calling [method undo]. A value of "
"[code]0[/code] or lower means no limit."
msgstr ""
"O número máximo de etapas que podem ser armazenadas no histórico de desfazer/"
"refazer. Se o número de etapas armazenadas exceder esse limite, as etapas "
"mais antigas serão removidas do histórico e não poderão mais ser alcançadas "
"chamando [method undo]. Um valor de [code]0[/code] ou menor significa sem "
"limite."

msgid "Called when [method undo] or [method redo] was called."
msgstr "Chamado quando [method undo] ou [method redo] foi chamado."

msgid "Makes \"do\"/\"undo\" operations stay in separate actions."
msgstr ""
"Faz com que as operações de \"fazer\"/\"desfazer\" permaneçam em ações "
"separadas."

msgid ""
"Merges this action with the previous one if they have the same name. Keeps "
"only the first action's \"undo\" operations and the last action's \"do\" "
"operations. Useful for sequential changes to a single value."
msgstr ""
"Mescla esta ação com a anterior se elas tiverem o mesmo nome. Mantém apenas "
"as operações de \"desfazer\" (undo) da primeira ação e as operações de "
"\"refazer\" (do) da última ação. Útil para alterações sequenciais em um único "
"valor."

msgid "Merges this action with the previous one if they have the same name."
msgstr "Mescla esta ação com a anterior se elas tiverem o mesmo nome."

msgid "Uniform set cache manager for Rendering Device based renderers."
msgstr ""
"Gerenciador de cache de conjunto de uniformes para renderizadores baseados em "
"RenderingDevice."

msgid ""
"Uniform set cache manager for [RenderingDevice]-based renderers. Provides a "
"way to create a uniform set and reuse it in subsequent calls for as long as "
"the uniform set exists. Uniform set will automatically be cleaned up when "
"dependent objects are freed."
msgstr ""
"Gerenciador de cache de conjuntos de uniformes para renderizadores baseados "
"em [RenderingDevice]. Fornece uma maneira de criar um conjunto de uniformes e "
"reutilizá-lo em chamadas subsequentes enquanto o conjunto de uniformes "
"existir. O conjunto de uniformes será limpo automaticamente quando os objetos "
"dependentes forem liberados."

msgid ""
"Creates/returns a cached uniform set based on the provided uniforms for a "
"given shader."
msgstr ""
"Cria/retorna um conjunto uniforme em cache com base nos uniformes fornecidos "
"para um determinado shader."

msgid ""
"Universal Plug and Play (UPnP) functions for network device discovery, "
"querying and port forwarding."
msgstr ""
"Funções de Universal Plug and Play (UPnP) para descoberta de dispositivos de "
"rede, consulta e encaminhamento de portas."

msgid ""
"This class can be used to discover compatible [UPNPDevice]s on the local "
"network and execute commands on them, like managing port mappings (for port "
"forwarding/NAT traversal) and querying the local and remote network IP "
"address. Note that methods on this class are synchronous and block the "
"calling thread.\n"
"To forward a specific port (here [code]7777[/code], note both [method "
"discover] and [method add_port_mapping] can return errors that should be "
"checked):\n"
"[codeblock]\n"
"var upnp = UPNP.new()\n"
"upnp.discover()\n"
"upnp.add_port_mapping(7777)\n"
"[/codeblock]\n"
"To close a specific port (e.g. after you have finished using it):\n"
"[codeblock]\n"
"upnp.delete_port_mapping(port)\n"
"[/codeblock]\n"
"[b]Note:[/b] UPnP discovery blocks the current thread. To perform discovery "
"without blocking the main thread, use [Thread]s like this:\n"
"[codeblock]\n"
"# Emitted when UPnP port mapping setup is completed (regardless of success or "
"failure).\n"
"signal upnp_completed(error)\n"
"\n"
"# Replace this with your own server port number between 1024 and 65535.\n"
"const SERVER_PORT = 3928\n"
"var thread = null\n"
"\n"
"func _upnp_setup(server_port):\n"
"\t# UPNP queries take some time.\n"
"\tvar upnp = UPNP.new()\n"
"\tvar err = upnp.discover()\n"
"\n"
"\tif err != UPNP.UPNP_RESULT_SUCCESS:\n"
"\t\tpush_error(str(err))\n"
"\t\tupnp_completed.emit(err)\n"
"\t\treturn\n"
"\n"
"\tif upnp.get_gateway() and upnp.get_gateway().is_valid_gateway():\n"
"\t\tupnp.add_port_mapping(server_port, server_port, "
"ProjectSettings.get_setting(\"application/config/name\"), \"UDP\")\n"
"\t\tupnp.add_port_mapping(server_port, server_port, "
"ProjectSettings.get_setting(\"application/config/name\"), \"TCP\")\n"
"\t\tupnp_completed.emit(UPNP.UPNP_RESULT_SUCCESS)\n"
"\n"
"func _ready():\n"
"\tthread = Thread.new()\n"
"\tthread.start(_upnp_setup.bind(SERVER_PORT))\n"
"\n"
"func _exit_tree():\n"
"\t# Wait for thread finish here to handle game exit while the thread is "
"running.\n"
"\tthread.wait_to_finish()\n"
"[/codeblock]\n"
"[b]Terminology:[/b] In the context of UPnP networking, \"gateway\" (or "
"\"internet gateway device\", short IGD) refers to network devices that allow "
"computers in the local network to access the internet (\"wide area network\", "
"WAN). These gateways are often also called \"routers\".\n"
"[b]Pitfalls:[/b]\n"
"- As explained above, these calls are blocking and shouldn't be run on the "
"main thread, especially as they can block for multiple seconds at a time. Use "
"threading!\n"
"- Networking is physical and messy. Packets get lost in transit or get "
"filtered, addresses, free ports and assigned mappings change, and devices may "
"leave or join the network at any time. Be mindful of this, be diligent when "
"checking and handling errors, and handle these gracefully if you can: add "
"clear error UI, timeouts and re-try handling.\n"
"- Port mappings may change (and be removed) at any time, and the remote/"
"external IP address of the gateway can change likewise. You should consider "
"re-querying the external IP and try to update/refresh the port mapping "
"periodically (for example, every 5 minutes and on networking failures).\n"
"- Not all devices support UPnP, and some users disable UPnP support. You need "
"to handle this (e.g. documenting and requiring the user to manually forward "
"ports, or adding alternative methods of NAT traversal, like a relay/mirror "
"server, or NAT hole punching, STUN/TURN, etc.).\n"
"- Consider what happens on mapping conflicts. Maybe multiple users on the "
"same network would like to play your game at the same time, or maybe another "
"application uses the same port. Make the port configurable, and optimally "
"choose a port automatically (re-trying with a different port on failure).\n"
"[b]Further reading:[/b] If you want to know more about UPnP (and the Internet "
"Gateway Device (IGD) and Port Control Protocol (PCP) specifically), "
"[url=https://en.wikipedia.org/wiki/Universal_Plug_and_Play]Wikipedia[/url] is "
"a good first stop, the specification can be found at the [url=https://"
"openconnectivity.org/developer/specifications/upnp-resources/upnp/]Open "
"Connectivity Foundation[/url] and Godot's implementation is based on the "
"[url=https://github.com/miniupnp/miniupnp]MiniUPnP client[/url]."
msgstr ""
"Esta classe pode ser usada para descobrir [UPNPDevice]s compatíveis na rede "
"local e executar comandos neles, como gerenciar mapeamentos de portas (para "
"encaminhamento de porta/travessia NAT) e consultar o endereço IP da rede "
"local e remota. Observe que os métodos nesta classe são síncronos e bloqueiam "
"a thread chamadora.\n"
"Para encaminhar uma porta específica (aqui [code]7777[/code], note que tanto "
"[method discover] quanto [method add_port_mapping] podem retornar erros que "
"devem ser verificados):\n"
"[codeblock]\n"
"var upnp = UPNP.new()\n"
"upnp.discover()\n"
"upnp.add_port_mapping(7777)\n"
"[/codeblock]\n"
"Para fechar uma porta específica (por exemplo, após terminar de usá-la):\n"
"[codeblock]\n"
"upnp.delete_port_mapping(port)\n"
"[/codeblock]\n"
"[b]Nota:[/b] A descoberta de UPnP bloqueia a thread atual. Para realizar a "
"descoberta sem bloquear a thread principal, use [Thread]s como esta:\n"
"[codeblock]\n"
"# Emitido quando a configuração de mapeamento de porta UPnP é concluída "
"(independentemente de sucesso ou falha).\n"
"signal upnp_completed(error)\n"
"\n"
"# Substitua este pelo número da porta do seu próprio servidor entre 1024 e "
"65535.\n"
"const SERVER_PORT = 3928\n"
"var thread = null\n"
"\n"
"func _upnp_setup(server_port):\n"
"# As consultas UPNP levam algum tempo.\n"
"var upnp = UPNP.new()\n"
"var err = upnp.discover()\n"
"\n"
"if err != UPNP.UPNP_RESULT_SUCCESS:\n"
"push_error(str(err))\n"
"upnp_completed.emit(err)\n"
"return\n"
"\n"
"if upnp.get_gateway() and upnp.get_gateway().is_valid_gateway():\n"
"upnp.add_port_mapping(server_port, server_port, "
"ProjectSettings.get_setting(\"application/config/name\"), \"UDP\")\n"
"upnp.add_port_mapping(server_port, server_port, "
"ProjectSettings.get_setting(\"application/config/name\"), \"TCP\")\n"
"upnp_completed.emit(UPNP.UPNP_RESULT_SUCCESS)\n"
"\n"
"func _ready():\n"
"thread = Thread.new()\n"
"thread.start(_upnp_setup.bind(SERVER_PORT))\n"
"\n"
"func _exit_tree():\n"
"# Aguarde a conclusão da thread aqui para lidar com a saída do jogo enquanto "
"a thread estiver em execução.\n"
"thread.wait_to_finish()\n"
"[/codeblock]\n"
"[b]Terminologia:[/b] No contexto de redes UPnP, \"gateway\" (ou \"internet "
"gateway device\", abreviado como IGD) refere-se a dispositivos de rede que "
"permitem que computadores na rede local acessem a internet (\"wide area "
"network\", WAN). Esses gateways também são frequentemente chamados de "
"\"roteadores\".\n"
"[b]Armadilhas:[/b]\n"
"- Conforme explicado acima, essas chamadas são bloqueantes e não devem ser "
"executadas na thread principal, especialmente porque podem bloquear por "
"vários segundos de cada vez. Use threads!\n"
"- A rede é física e instável. Pacotes são perdidos em trânsito ou filtrados, "
"endereços, portas livres e mapeamentos atribuídos mudam, e dispositivos podem "
"sair ou entrar na rede a qualquer momento. Tenha isso em mente, seja "
"diligente ao verificar e tratar erros, e lide com eles de forma graciosa se "
"puder: adicione uma interface de usuário de erro clara, tempos limite e "
"tratamento de nova tentativa.\n"
"- Os mapeamentos de portas podem mudar (e ser removidos) a qualquer momento, "
"e o endereço IP remoto/externo do gateway também pode mudar. Você deve "
"considerar consultar novamente o IP externo e tentar atualizar/recarregar o "
"mapeamento de portas periodicamente (por exemplo, a cada 5 minutos e em "
"falhas de rede).\n"
"- Nem todos os dispositivos suportam UPnP, e alguns usuários desativam o "
"suporte a UPnP. Você precisa lidar com isso (por exemplo, documentando e "
"exigindo que o usuário encaminhe as portas manualmente, ou adicionando "
"métodos alternativos de travessia NAT, como um servidor de relay/espelho, ou "
"NAT hole punching, STUN/TURN, etc.).\n"
"- Considere o que acontece em conflitos de mapeamento. Talvez vários usuários "
"na mesma rede queiram jogar seu jogo ao mesmo tempo, ou talvez outro "
"aplicativo use a mesma porta. Torne a porta configurável e, idealmente, "
"escolha uma porta automaticamente (tentando novamente com uma porta diferente "
"em caso de falha).\n"
"[b]Leitura adicional:[/b] Se você quiser saber mais sobre UPnP (e "
"especificamente sobre o Internet Gateway Device (IGD) e o Port Control "
"Protocol (PCP)), a [url=https://en.wikipedia.org/wiki/"
"Universal_Plug_and_Play]Wikipedia[/url] é um bom primeiro ponto de parada, a "
"especificação pode ser encontrada na [url=https://openconnectivity.org/"
"developer/specifications/upnp-resources/upnp/]Open Connectivity Foundation[/"
"url] e a implementação do Godot é baseada no [url=https://github.com/miniupnp/"
"miniupnp]cliente MiniUPnP[/url]."

msgid "Adds the given [UPNPDevice] to the list of discovered devices."
msgstr "Adiciona o [UPNPDevice] fornecido à lista de dispositivos descobertos."

msgid ""
"Adds a mapping to forward the external [param port] (between 1 and 65535, "
"although recommended to use port 1024 or above) on the default gateway (see "
"[method get_gateway]) to the [param port_internal] on the local machine for "
"the given protocol [param proto] (either [code]\"TCP\"[/code] or [code]"
"\"UDP\"[/code], with UDP being the default). If a port mapping for the given "
"port and protocol combination already exists on that gateway device, this "
"method tries to overwrite it. If that is not desired, you can retrieve the "
"gateway manually with [method get_gateway] and call [method add_port_mapping] "
"on it, if any. Note that forwarding a well-known port (below 1024) with UPnP "
"may fail depending on the device.\n"
"Depending on the gateway device, if a mapping for that port already exists, "
"it will either be updated or it will refuse this command due to that "
"conflict, especially if the existing mapping for that port wasn't created via "
"UPnP or points to a different network address (or device) than this one.\n"
"If [param port_internal] is [code]0[/code] (the default), the same port "
"number is used for both the external and the internal port (the [param port] "
"value).\n"
"The description ([param desc]) is shown in some routers management UIs and "
"can be used to point out which application added the mapping.\n"
"The mapping's lease [param duration] can be limited by specifying a duration "
"in seconds. The default of [code]0[/code] means no duration, i.e. a permanent "
"lease and notably some devices only support these permanent leases. Note that "
"whether permanent or not, this is only a request and the gateway may still "
"decide at any point to remove the mapping (which usually happens on a reboot "
"of the gateway, when its external IP address changes, or on some models when "
"it detects a port mapping has become inactive, i.e. had no traffic for "
"multiple minutes). If not [code]0[/code] (permanent), the allowed range "
"according to spec is between [code]120[/code] (2 minutes) and [code]86400[/"
"code] seconds (24 hours).\n"
"See [enum UPNPResult] for possible return values."
msgstr ""
"Adiciona um mapeamento para encaminhar a [param port] externa (entre 1 e "
"65535, embora seja recomendado usar a porta 1024 ou superior) no gateway "
"padrão (consulte [method get_gateway]) para a [param port_internal] na "
"máquina local para o protocolo fornecido [param proto] (seja [code]\"TCP\"[/"
"code] ou [code]\"UDP\"[/code], sendo o UDP o padrão). Se um mapeamento de "
"porta para a combinação de porta e protocolo fornecida já existir nesse "
"dispositivo de gateway, este método tenta substituí-lo. Se isso não for "
"desejado, você pode recuperar o gateway manualmente com [method get_gateway] "
"e chamar [method add_port_mapping] nele, se houver. Observe que o "
"encaminhamento de uma porta bem conhecida (abaixo de 1024) com UPnP pode "
"falhar dependendo do dispositivo.\n"
"Dependendo do dispositivo de gateway, se já existir um mapeamento para essa "
"porta, ele será atualizado ou recusará este comando devido a esse conflito, "
"especialmente se o mapeamento existente para essa porta não tiver sido criado "
"via UPnP ou apontar para um endereço de rede (ou dispositivo) diferente "
"deste.\n"
"Se [param port_internal] for [code]0[/code] (o padrão), o mesmo número de "
"porta será usado para a porta externa e interna (o valor de [param port]).\n"
"A descrição ([param desc]) é exibida nas interfaces de gerenciamento de "
"alguns roteadores e pode ser usada para indicar qual aplicativo adicionou o "
"mapeamento.\n"
"A [param duration] de concessão (lease) do mapeamento pode ser limitada "
"especificando uma duração em segundos. O padrão de [code]0[/code] significa "
"sem duração, ou seja, uma concessão permanente e, notavelmente, alguns "
"dispositivos suportam apenas essas concessões permanentes. Observe que, sendo "
"permanente ou não, isso é apenas uma solicitação e o gateway ainda pode "
"decidir a qualquer momento remover o mapeamento (o que geralmente acontece em "
"uma reinicialização do gateway, quando seu endereço IP externo muda ou, em "
"alguns modelos, quando ele detecta que um mapeamento de porta ficou inativo, "
"ou seja, não teve tráfego por vários minutos). Se não for [code]0[/code] "
"(permanente), o intervalo permitido de acordo com a especificação é entre "
"[code]120[/code] (2 minutos) e [code]86400[/code] segundos (24 horas).\n"
"Consulte [enum UPNPResult] para ver os possíveis valores de retorno."

msgid "Clears the list of discovered devices."
msgstr "Limpa a lista de dispositivos descobertos."

msgid ""
"Deletes the port mapping for the given port and protocol combination on the "
"default gateway (see [method get_gateway]) if one exists. [param port] must "
"be a valid port between 1 and 65535, [param proto] can be either [code]"
"\"TCP\"[/code] or [code]\"UDP\"[/code]. May be refused for mappings pointing "
"to addresses other than this one, for well-known ports (below 1024), or for "
"mappings not added via UPnP. See [enum UPNPResult] for possible return values."
msgstr ""
"Exclui o mapeamento de porta para a combinação de porta e protocolo fornecida "
"no gateway padrão (veja [method get_gateway]) se houver um. [param port] deve "
"ser uma porta válida entre 1 e 65535, [param proto] pode ser [code]\"TCP\"[/"
"code] ou [code]\"UDP\"[/code]. Pode ser recusado para mapeamentos que apontam "
"para endereços diferentes deste, para portas bem conhecidas (abaixo de 1024) "
"ou para mapeamentos não adicionados via UPnP. Veja [enum UPNPResult] para "
"possíveis valores de retorno."

msgid "Returns the [UPNPDevice] at the given [param index]."
msgstr "Retorna o [UPNPDevice] no [param index] fornecido."

msgid "Returns the number of discovered [UPNPDevice]s."
msgstr "Retorna o número de [UPNPDevice]s descobertos."

msgid ""
"Returns the default gateway. That is the first discovered [UPNPDevice] that "
"is also a valid IGD (InternetGatewayDevice)."
msgstr ""
"Retorna o gateway padrão. Esse é o primeiro [UPNPDevice] descoberto que "
"também é um IGD (InternetGatewayDevice) válido."

msgid ""
"Returns the external [IP] address of the default gateway (see [method "
"get_gateway]) as string. Returns an empty string on error."
msgstr ""
"Retorna o endereço [IP] externo do gateway padrão (veja [method get_gateway]) "
"como string. Retorna uma string vazia em caso de erro."

msgid "Removes the device at [param index] from the list of discovered devices."
msgstr ""
"Remove o dispositivo no índice [param index] da lista de dispositivos "
"descobertos."

msgid ""
"Sets the device at [param index] from the list of discovered devices to "
"[param device]."
msgstr ""
"Define o dispositivo em [param index] na lista de dispositivos descobertos "
"como [param device]."

msgid "If [code]true[/code], IPv6 is used for [UPNPDevice] discovery."
msgstr "Se [code]true[/code], o IPv6 é usado para a descoberta de [UPNPDevice]."

msgid ""
"If [code]0[/code], the local port to use for discovery is chosen "
"automatically by the system. If [code]1[/code], discovery will be done from "
"the source port 1900 (same as destination port). Otherwise, the value will be "
"used as the port."
msgstr ""
"Se [code]0[/code], a porta local a ser usada para descoberta é escolhida "
"automaticamente pelo sistema. Se [code]1[/code], a descoberta será feita a "
"partir da porta de origem 1900 (mesma que a porta de destino). Caso "
"contrário, o valor será usado como a porta."

msgid ""
"Multicast interface to use for discovery. Uses the default multicast "
"interface if empty."
msgstr ""
"Interface multicast a ser usada para descoberta. Usa a interface multicast "
"padrão se estiver vazia."

msgid "UPNP command or discovery was successful."
msgstr "O comando ou descoberta UPNP foi bem-sucedido."

msgid ""
"Not authorized to use the command on the [UPNPDevice]. May be returned when "
"the user disabled UPNP on their router."
msgstr ""
"Não autorizado a usar o comando no [UPNPDevice]. Pode ser retornado quando o "
"usuário desativou o UPNP em seu roteador."

msgid ""
"No port mapping was found for the given port, protocol combination on the "
"given [UPNPDevice]."
msgstr ""
"Nenhum mapeamento de porta foi encontrado para a combinação de porta e "
"protocolo fornecida no [UPNPDevice] fornecido."

msgid "Inconsistent parameters."
msgstr "Parâmetros inconsistentes."

msgid ""
"No such entry in array. May be returned if a given port, protocol combination "
"is not found on a [UPNPDevice]."
msgstr ""
"Nenhuma entrada correspondente no array. Pode ser retornado se uma "
"determinada combinação de porta e protocolo não for encontrada em um "
"[UPNPDevice]."

msgid "The action failed."
msgstr "A ação falhou."

msgid ""
"The [UPNPDevice] does not allow wildcard values for the source IP address."
msgstr ""
"O [UPNPDevice] não permite valores curinga para o endereço IP de origem."

msgid "The [UPNPDevice] does not allow wildcard values for the external port."
msgstr "O [UPNPDevice] não permite valores curinga para a porta externa."

msgid "The [UPNPDevice] does not allow wildcard values for the internal port."
msgstr "O [UPNPDevice] não permite valores curinga para a porta interna."

msgid "The remote host value must be a wildcard."
msgstr "O valor do host remoto deve ser um caractere curinga."

msgid "The external port value must be a wildcard."
msgstr "O valor da porta externa deve ser um caractere curinga."

msgid ""
"No port maps are available. May also be returned if port mapping "
"functionality is not available."
msgstr ""
"Nenhum mapa de portas está disponível. Também pode ser retornado se a "
"funcionalidade de mapeamento de portas não estiver disponível."

msgid ""
"Conflict with other mechanism. May be returned instead of [constant "
"UPNP_RESULT_CONFLICT_WITH_OTHER_MAPPING] if a port mapping conflicts with an "
"existing one."
msgstr ""
"Conflito com outro mecanismo. Pode ser retornado em vez de [constant "
"UPNP_RESULT_CONFLICT_WITH_OTHER_MAPPING] se um mapeamento de porta entrar em "
"conflito com um existente."

msgid "Conflict with an existing port mapping."
msgstr "Conflito com um mapeamento de porta existente."

msgid "External and internal port values must be the same."
msgstr "Os valores das portas externa e interna devem ser os mesmos."

msgid ""
"Only permanent leases are supported. Do not use the [code]duration[/code] "
"parameter when adding port mappings."
msgstr ""
"Apenas concessões permanentes são suportadas. Não use o parâmetro "
"[code]duration[/code] ao adicionar mapeamentos de porta."

msgid "Invalid gateway."
msgstr "Gateway inválida."

msgid "Invalid port."
msgstr "Porta inválida."

msgid "Invalid protocol."
msgstr "Protocolo inválido."

msgid "Invalid duration."
msgstr "Duração inválida."

msgid "Invalid arguments."
msgstr "Argumentos inválidos."

