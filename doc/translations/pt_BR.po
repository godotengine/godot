msgid "Returns the end bone name."
msgstr "Retorna o nome do osso final."

msgid "Returns the middle bone index."
msgstr "Retorna o índice do osso do meio."

msgid "Returns the middle bone name."
msgstr "Retorna o nome do osso do meio."

msgid "Returns the pole direction."
msgstr "Retorna a direção do polo."

