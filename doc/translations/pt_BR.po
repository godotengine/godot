msgstr ""
"Retorna o índice de slot correspondente da porta de entrada com o [param "
"port_idx] dado."

msgid "Returns the type of the input port with the given [param port_idx]."
msgstr "Retorna o tipo da porta de entrada com o [param port_idx] dado."

