msgstr "Esqueletos 2D"

msgid "Returns the local pose override transform for [param bone_idx]."
msgstr ""
"Retorna a transformação de substituição de pose local para [param bone_idx]."

msgid "Clear all the bones in this skeleton."
msgstr "Limpa todos os ossos neste esqueleto."

msgid ""
"Returns an array containing the bone indexes of all the child node of the "
"passed in bone, [param bone_idx]."
msgstr ""
"Retorna uma matriz contendo os índices de ossos de todos os nós filhos do "
