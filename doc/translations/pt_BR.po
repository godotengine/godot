msgid "Returns the root bone index."
msgstr "Retorna o índice do osso raiz."

msgid "Returns the root bone name."
msgstr "Retorna o nome do osso raiz."

msgid ""
"Returns [code]true[/code] if the end bone is extended from the middle bone as "
