msgid ""
"Returns the maximum allowed width of the icon for the tab at index [param "
"tab_idx]."
msgstr ""
"Retorna a largura máxima permitida do ícone para a aba no índice [param "
"tab_idx]."

msgid "Returns the title of the tab at index [param tab_idx]."
msgstr "Retorna o título da aba no índice [param tab_idx]."

msgid "Returns the tooltip text of the tab at index [param tab_idx]."
msgstr "Retorna o texto da dica de ferramenta da aba no índice [param tab_idx]."

msgid ""
"Returns [code]true[/code] if the tab at index [param tab_idx] is disabled."
msgstr ""
"Retorna [code]true[/code] se a aba no índice [param tab_idx] estiver "
"desabilitada."

msgid "Returns [code]true[/code] if the tab at index [param tab_idx] is hidden."
msgstr ""
"Retorna [code]true[/code] se a aba no índice [param tab_idx] estiver oculta."

msgid "Removes the tab at index [param tab_idx]."
msgstr "Remove a aba no índice [param tab_idx]."

msgid "Sets an [param icon] for the tab at index [param tab_idx]."
msgstr "Define um [param icon] para a aba no índice [param tab_idx]."

msgid "Sets a [param title] for the tab at index [param tab_idx]."
msgstr "Define um [param title] para a aba no índice [param tab_idx]."

msgid "When the close button will appear on the tabs."
msgstr "Quando o botão de fechar aparecerá nas abas."

msgid "Emitted when switching to another tab."
msgstr "Emitido quando mudando para outra aba."

msgid "Returns the button icon from the tab at index [param tab_idx]."
msgstr "Retorna o ícone do botão da aba no índice [param tab_idx]."

msgid "Returns the [Control] node from the tab at index [param tab_idx]."
msgstr "Retorna o nó [Control] da aba no índice [param tab_idx]."

msgid ""
"Returns the [Texture2D] for the tab at index [param tab_idx] or [code]null[/"
"code] if the tab has no [Texture2D]."
msgstr ""
"Retorna a [Texture2D] para a aba no índice [param tab_idx] ou [code]null[/"
"code] se a aba não tiver [Texture2D]."

msgid "Sets the button icon from the tab at index [param tab_idx]."
msgstr "Define o ícone do botão da aba no índice [param tab_idx]."

