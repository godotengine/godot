msgstr "ປຸ່ມ Z."

msgid "Backslash ([code]\\[/code]) key."
msgstr "ປຸ່ມແບັກສະແລຊ ([code]\\[/code])."

msgid "Caret ([code]^[/code]) key."
msgstr "ປຸ່ມເຄື່ອງໝາຍຄາເຣັດ ([code]^[/code])."

msgid "Underscore ([code]_[/code]) key."
msgstr "ປຸ່ມເຄື່ອງໝາຍຂີດກ້ອງ ([code]_[/code])."

msgid "Backtick ([code]`[/code]) key."
msgstr "ປຸ່ມເຄື່ອງໝາຍແບັກທິກ ([code]`[/code])."

msgid "Left brace ([code]{[/code]) key."
msgstr "ປຸ່ມວົງເລັບປີກກາເປີດ ([code]{[/code])."

msgid "Vertical bar or [i]pipe[/i] ([code]|[/code]) key."
msgstr "ປຸ່ມເສັ້ນຕັ້ງ ຫຼື [i]pipe[/i] ([code]|[/code])."

msgid "Right brace ([code]}[/code]) key."
msgstr "ປຸ່ມວົງເລັບປີກກາປິດ ([code]}[/code])."

msgid "Tilde ([code]~[/code]) key."
msgstr "ປຸ່ມເຄື່ອງໝາຍທິລເດ ([code]~[/code])."

msgid "Yen symbol ([code]¥[/code]) key."
msgstr "ປຸ່ມເຄື່ອງໝາຍເງິນເຢນ ([code]¥[/code])."

msgid "Section sign ([code]§[/code]) key."
msgstr "ປຸ່ມເຄື່ອງໝາຍມາດຕາ ([code]§[/code])."

msgid ""
"Bit mask with all bits enabled except for modifier keys. Apply it to remove "
"modifiers.\n"
"[codeblock]\n"
"var keycode = KEY_A | KEY_MASK_SHIFT\n"
"keycode = keycode & KEY_CODE_MASK\n"
"print(keycode) # KEY_A\n"
"[/codeblock]"
msgstr ""
"ບິດມາດ (Bit mask) ທີ່ເປີດໃຊ້ທຸກບິດ ຍົກເວັ້ນປຸ່ມປັບປ່ຽນ (modifier keys). "
"ໃຊ້ເພື່ອເອົາປຸ່ມປັບປ່ຽນອອກ.\n"
"[codeblock]\n"
"var keycode = KEY_A | KEY_MASK_SHIFT\n"
"keycode = keycode & KEY_CODE_MASK\n"
"print(keycode) # KEY_A\n"
"[/codeblock]"

msgid ""
"Bit mask with all modifier bits enabled. Apply it to isolate modifiers.\n"
"[codeblock]\n"
"var keycode = KEY_A | KEY_MASK_SHIFT\n"
"keycode = keycode & KEY_MODIFIER_MASK\n"
"print(keycode) # KEY_MASK_SHIFT\n"
"[/codeblock]"
msgstr ""
"ບິດມາດ (Bit mask) ທີ່ເປີດໃຊ້ບິດປຸ່ມປັບປ່ຽນ (modifier) ທັງໝົດ. ໃຊ້ເພື່ອແຍກປຸ່ມປັບປ່ຽນ.\n"
"[codeblock]\n"
"var keycode = KEY_A | KEY_MASK_SHIFT\n"
"keycode = keycode & KEY_MODIFIER_MASK\n"
"print(keycode) # KEY_MASK_SHIFT\n"
"[/codeblock]"

msgid ""
"Automatically remapped to [constant KEY_META] on macOS and [constant "
"KEY_CTRL] on other platforms, this mask is never set in the actual events, "
"and should be used for key mapping only."
msgstr ""
"ຈະຖືກປ່ຽນເປັນ [constant KEY_META] ໃນ macOS ແລະ [constant KEY_CTRL] "
"ໃນລະບົບອື່ນໆໂດຍອັດຕະໂນມັດ, ມາດນີ້ຈະບໍ່ຖືກຕັ້ງໃນເຫດການຕົວຈິງ ແລະ ຄວນໃຊ້ສຳລັບການຈັບຄູ່ປຸ່ມ (key "
"mapping) ເທົ່ານັ້ນ."

msgid "Shift key mask."
msgstr "ມາດປຸ່ມ Shift."

msgid "Alt or Option (on macOS) key mask."
msgstr "ມາດປຸ່ມ Alt ຫຼື Option (ໃນ macOS)."

msgid "Command (on macOS) or Meta/Windows key mask."
msgstr "ມາດປຸ່ມ Command (ໃນ macOS) ຫຼື Meta/Windows."

msgid "Control key mask."
msgstr "ມາດປຸ່ມ Control."

msgid "Keypad key mask."
msgstr "ມາດປຸ່ມ Keypad (ແຖບຕົວເລກ)."

msgid "Group Switch key mask."
msgstr "ມາດປຸ່ມປ່ຽນກຸ່ມ (Group Switch)."

msgid ""
"Used for keys which only appear once, or when a comparison doesn't need to "
"differentiate the [code]LEFT[/code] and [code]RIGHT[/code] versions.\n"
"For example, when using [method InputEvent.is_match], an event which has "
"[constant KEY_LOCATION_UNSPECIFIED] will match any [enum KeyLocation] on the "
"passed event."
msgstr ""
"ໃຊ້ສຳລັບປຸ່ມທີ່ມີພຽງອັນດຽວ, ຫຼື ເມື່ອການປຽບທຽບບໍ່ຈຳເປັນຕ້ອງແຍກລະຫວ່າງເບື້ອງ [code]ຊ້າຍ (LEFT)[/"
"code] ແລະ [code]ຂວາ (RIGHT)[/code].\n"
"ຕົວຢ່າງ, ເມື່ອໃຊ້ [method InputEvent.is_match], ເຫດການທີ່ມີ [constant "
"KEY_LOCATION_UNSPECIFIED] ຈະກົງກັບ [enum KeyLocation] ໃດກໍໄດ້ໃນເຫດການທີ່ສົ່ງມາ."

msgid "A key which is to the left of its twin."
msgstr "ປຸ່ມທີ່ຢູ່ເບື້ອງຊ້າຍຂອງຄູ່ຂອງມັນ."

msgid "A key which is to the right of its twin."
msgstr "ປຸ່ມທີ່ຢູ່ເບື້ອງຂວາຂອງຄູ່ຂອງມັນ."

msgid ""
"Enum value which doesn't correspond to any mouse button. This is used to "
"initialize [enum MouseButton] properties with a generic state."
msgstr ""
"ຄ່າ Enum ທີ່ບໍ່ກົງກັບປຸ່ມເມົາສ໌ໃດໆ. ໃຊ້ເພື່ອຕັ້ງຄ່າເລີ່ມຕົ້ນໃຫ້ກັບຄຸນສົມບັດ [enum MouseButton] "
"ດ້ວຍສະຖານະທົ່ວໄປ."

msgid "Primary mouse button, usually assigned to the left button."
msgstr "ປຸ່ມເມົາສ໌ຫຼັກ, ປົກກະຕິແມ່ນປຸ່ມຊ້າຍ."

msgid "Secondary mouse button, usually assigned to the right button."
msgstr "ປຸ່ມເມົາສ໌ສຳຮອງ, ປົກກະຕິແມ່ນປຸ່ມຂວາ."

msgid "Middle mouse button."
msgstr "ປຸ່ມເມົາສ໌ກາງ."

msgid "Mouse wheel scrolling up."
msgstr "ລໍ້ເມົາສ໌ເລື່ອນຂຶ້ນ."

msgid "Mouse wheel scrolling down."
msgstr "ລໍ້ເມົາສ໌ເລື່ອນລົງ."

msgid "Mouse wheel left button (only present on some mice)."
msgstr "ປຸ່ມລໍ້ເມົາສ໌ໄປທາງຊ້າຍ (ມີສະເພາະໃນເມົາສ໌ບາງລຸ້ນ)."

msgid "Mouse wheel right button (only present on some mice)."
msgstr "ປຸ່ມລໍ້ເມົາສ໌ໄປທາງຂວາ (ມີສະເພາະໃນເມົາສ໌ບາງລຸ້ນ)."

msgid ""
"Extra mouse button 1. This is sometimes present, usually to the sides of the "
"mouse."
msgstr "ປຸ່ມເມົາສ໌ພິເສດ 1. ບາງຄັ້ງຈະມີຢູ່, ປົກກະຕິແມ່ນຢູ່ຂ້າງໆຂອງເມົາສ໌."

msgid ""
"Extra mouse button 2. This is sometimes present, usually to the sides of the "
"mouse."
msgstr "ປຸ່ມເມົາສ໌ພິເສດ 2. ບາງຄັ້ງຈະມີຢູ່, ປົກກະຕິແມ່ນຢູ່ຂ້າງໆຂອງເມົາສ໌."

msgid "Primary mouse button mask, usually for the left button."
msgstr "ມາດປຸ່ມເມົາສ໌ຫຼັກ, ປົກກະຕິແມ່ນສຳລັບປຸ່ມຊ້າຍ."

msgid "Secondary mouse button mask, usually for the right button."
msgstr "ມາດປຸ່ມເມົາສ໌ສຳຮອງ, ປົກກະຕິແມ່ນສຳລັບປຸ່ມຂວາ."

msgid "Middle mouse button mask."
msgstr "ມາດປຸ່ມເມົາສ໌ກາງ."

msgid "Extra mouse button 1 mask."
msgstr "ມາດປຸ່ມເມົາສ໌ພິເສດ 1."

msgid "Extra mouse button 2 mask."
msgstr "ມາດປຸ່ມເມົາສ໌ພິເສດ 2."

msgid "An invalid game controller button."
msgstr "ປຸ່ມຄອນໂທຣລເລີເກມທີ່ບໍ່ຖືກຕ້ອງ."

msgid ""
"Game controller SDL button A. Corresponds to the bottom action button: Sony "
"Cross, Xbox A, Nintendo B."
msgstr ""
"ປຸ່ມ A ຂອງຄອນໂທຣລເລີເກມ (SDL). ກົງກັບປຸ່ມຄຳສັ່ງລຸ່ມ: Sony Cross (ກາກະບາດ), Xbox A, "
"Nintendo B."

msgid ""
"Game controller SDL button B. Corresponds to the right action button: Sony "
"Circle, Xbox B, Nintendo A."
msgstr ""
"ປຸ່ມ B ຂອງຄອນໂທຣລເລີເກມ (SDL). ກົງກັບປຸ່ມຄຳສັ່ງຂວາ: Sony Circle (ວົງມົນ), Xbox B, "
"Nintendo A."

msgid ""
"Game controller SDL button X. Corresponds to the left action button: Sony "
"Square, Xbox X, Nintendo Y."
msgstr ""
"ປຸ່ມ X ຂອງຄອນໂທຣລເລີເກມ (SDL). ກົງກັບປຸ່ມຄຳສັ່ງຊ້າຍ: Sony Square (ສີ່ຫຼ່ຽມ), Xbox X, "
"Nintendo Y."

msgid ""
"Game controller SDL button Y. Corresponds to the top action button: Sony "
"Triangle, Xbox Y, Nintendo X."
msgstr ""
"ປຸ່ມ Y ຂອງຄອນໂທຣລເລີເກມ (SDL). ກົງກັບປຸ່ມຄຳສັ່ງເທິງ: Sony Triangle (ສາມຫຼ່ຽມ), Xbox Y, "
"Nintendo X."

msgid ""
"Game controller SDL back button. Corresponds to the Sony Select, Xbox Back, "
"Nintendo - button."
msgstr ""
"ປຸ່ມ Back ຂອງຄອນໂທຣລເລີເກມ (SDL). ກົງກັບປຸ່ມ Sony Select, Xbox Back, Nintendo -."

msgid ""
"Game controller SDL guide button. Corresponds to the Sony PS, Xbox Home "
"button."
msgstr "ປຸ່ມ Guide ຂອງຄອນໂທຣລເລີເກມ (SDL). ກົງກັບປຸ່ມ Sony PS, Xbox Home."

msgid ""
"Game controller SDL start button. Corresponds to the Sony Options, Xbox Menu, "
"Nintendo + button."
msgstr ""
"ປຸ່ມ Start ຂອງຄອນໂທຣລເລີເກມ (SDL). ກົງກັບປຸ່ມ Sony Options, Xbox Menu, Nintendo +."

msgid ""
"Game controller SDL left stick button. Corresponds to the Sony L3, Xbox L/LS "
"button."
msgstr ""
"ປຸ່ມຄັນບັງຄັບຊ້າຍ (Left stick) ຂອງຄອນໂທຣລເລີເກມ (SDL). ກົງກັບປຸ່ມ Sony L3, Xbox L/LS."

msgid ""
"Game controller SDL right stick button. Corresponds to the Sony R3, Xbox R/RS "
"button."
msgstr ""
"ປຸ່ມຄັນບັງຄັບຂວາ (Right stick) ຂອງຄອນໂທຣລເລີເກມ (SDL). ກົງກັບປຸ່ມ Sony R3, Xbox R/RS."

msgid ""
"Game controller SDL left shoulder button. Corresponds to the Sony L1, Xbox LB "
"button."
msgstr "ປຸ່ມບ່າຊ້າຍ (Left shoulder) ຂອງຄອນໂທຣລເລີເກມ (SDL). ກົງກັບປຸ່ມ Sony L1, Xbox LB."

msgid ""
"Game controller SDL right shoulder button. Corresponds to the Sony R1, Xbox "
"RB button."
msgstr ""
"ປຸ່ມບ່າຂວາ (Right shoulder) ຂອງຄອນໂທຣລເລີເກມ (SDL). ກົງກັບປຸ່ມ Sony R1, Xbox RB."

msgid "Game controller D-pad up button."
msgstr "ປຸ່ມ D-pad ຂຶ້ນ."

msgid "Game controller D-pad down button."
msgstr "ປຸ່ມ D-pad ລົງ."

msgid "Game controller D-pad left button."
msgstr "ປຸ່ມ D-pad ຊ້າຍ."

msgid "Game controller D-pad right button."
msgstr "ປຸ່ມ D-pad ຂວາ."

msgid ""
"Game controller SDL miscellaneous button. Corresponds to Xbox share button, "
"PS5 microphone button, Nintendo Switch capture button."
msgstr ""
"ປຸ່ມອື່ນໆຂອງຄອນໂທຣລເລີເກມ (SDL). ກົງກັບປຸ່ມ Share ຂອງ Xbox, ປຸ່ມໄມໂຄຣໂຟນ PS5, ປຸ່ມ Capture "
"ຂອງ Nintendo Switch."

msgid "Game controller SDL paddle 1 button."
msgstr "ປຸ່ມ Paddle 1 ຂອງຄອນໂທຣລເລີເກມ (SDL)."

msgid "Game controller SDL paddle 2 button."
msgstr "ປຸ່ມ Paddle 2 ຂອງຄອນໂທຣລເລີເກມ (SDL)."

msgid "Game controller SDL paddle 3 button."
msgstr "ປຸ່ມ Paddle 3 ຂອງຄອນໂທຣລເລີເກມ (SDL)."

msgid "Game controller SDL paddle 4 button."
msgstr "ປຸ່ມ Paddle 4 ຂອງຄອນໂທຣລເລີເກມ (SDL)."

msgid "Game controller SDL touchpad button."
msgstr "ປຸ່ມ Touchpad ຂອງຄອນໂທຣລເລີເກມ (SDL)."

msgid ""
"Game controller SDL miscellaneous button. Used by Nintendo Switch 2 Pro "
"Controller and Horipad Steam controllers."
msgstr ""
"ປຸ່ມອື່ນໆຂອງຄອນໂທຣລເລີເກມ (SDL). ໃຊ້ໂດຍ Nintendo Switch 2 Pro Controller ແລະ "
"Horipad Steam controllers."

msgid "Game controller SDL miscellaneous button."
msgstr "ປຸ່ມອື່ນໆຂອງຄອນໂທຣລເລີເກມ (SDL)."

msgid "The number of SDL game controller buttons."
msgstr "ຈຳນວນປຸ່ມຂອງຄອນໂທຣລເລີເກມ SDL."

msgid ""
"The maximum number of game controller buttons supported by the engine. The "
"actual limit may be lower on specific platforms:\n"
"- [b]Android:[/b] Up to 36 buttons.\n"
"- [b]Linux:[/b] Up to 80 buttons.\n"
"- [b]Windows[/b] and [b]macOS:[/b] Up to 128 buttons."
msgstr ""
"ຈຳນວນປຸ່ມສູງສຸດຂອງຄອນໂທຣລເລີເກມທີ່ເອນຈິນຮອງຮັບ. ຂີດຈຳກັດຕົວຈິງອາດຕ່ຳກວ່າໃນບາງແພລັດຟອມ:\n"
"- [b]Android:[/b] ສູງສຸດ 36 ປຸ່ມ.\n"
"- [b]Linux:[/b] ສູງສຸດ 80 ປຸ່ມ.\n"
"- [b]Windows[/b] ແລະ [b]macOS:[/b] ສູງສຸດ 128 ປຸ່ມ."

msgid "An invalid game controller axis."
msgstr "ແກນ (Axis) ຂອງຄອນໂທຣລເລີເກມທີ່ບໍ່ຖືກຕ້ອງ."

msgid "Game controller left joystick x-axis."
msgstr "ແກນ X ຂອງຄັນບັງຄັບຊ້າຍ."

msgid "Game controller left joystick y-axis."
msgstr "ແກນ Y ຂອງຄັນບັງຄັບຊ້າຍ."

msgid "Game controller right joystick x-axis."
msgstr "ແກນ X ຂອງຄັນບັງຄັບຂວາ."

msgid "Game controller right joystick y-axis."
msgstr "ແກນ Y ຂອງຄັນບັງຄັບຂວາ."

msgid "Game controller left trigger axis."
msgstr "ແກນຂອງປຸ່ມກົດ (Trigger) ຊ້າຍ."

msgid "Game controller right trigger axis."
msgstr "ແກນຂອງປຸ່ມກົດ (Trigger) ຂວາ."

msgid "The number of SDL game controller axes."
msgstr "ຈຳນວນແກນຂອງຄອນໂທຣລເລີເກມ SDL."

msgid ""
"The maximum number of game controller axes: OpenVR supports up to 5 Joysticks "
"making a total of 10 axes."
msgstr ""
"ຈຳນວນແກນສູງສຸດຂອງຄອນໂທຣລເລີເກມ: OpenVR ຮອງຮັບສູງສຸດ 5 Joysticks ເຊິ່ງລວມທັງໝົດເປັນ 10 "
"ແກນ."

msgid ""
"Does not correspond to any MIDI message. This is the default value of [member "
"InputEventMIDI.message]."
msgstr "ບໍ່ກົງກັບຂໍ້ຄວາມ MIDI ໃດໆ. ນີ້ແມ່ນຄ່າເລີ່ມຕົ້ນຂອງ [member InputEventMIDI.message]."

msgid ""
"MIDI message sent when a note is released.\n"
"[b]Note:[/b] Not all MIDI devices send this message; some may send [constant "
"MIDI_MESSAGE_NOTE_ON] with [member InputEventMIDI.velocity] set to [code]0[/"
"code]."
msgstr ""
"ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກເມື່ອມີການປ່ອຍໂນ້ດ.\n"
"[b]ໝາຍເຫດ:[/b] ບໍ່ແມ່ນທຸກອຸປະກອນ MIDI ທີ່ຈະສົ່ງຂໍ້ຄວາມນີ້; ບາງອັນອາດຈະສົ່ງ [constant "
"MIDI_MESSAGE_NOTE_ON] ໂດຍຕັ້ງຄ່າ [member InputEventMIDI.velocity] ເປັນ [code]0[/"
"code]."

msgid "MIDI message sent when a note is pressed."
msgstr "ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກເມື່ອມີການກົດໂນ້ດ."

msgid ""
"MIDI message sent to indicate a change in pressure while a note is being "
"pressed down, also called aftertouch."
msgstr ""
"ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກເພື່ອບອກເຖິງການປ່ຽນແປງຂອງແຮງກົດໃນຂະນະທີ່ກຳລັງກົດໂນ້ດຢູ່, ຫຼື ເອີ້ນວ່າ "
"aftertouch."

msgid ""
"MIDI message sent when a controller value changes. In a MIDI device, a "
"controller is any input that doesn't play notes. These may include sliders "
"for volume, balance, and panning, as well as switches and pedals. See the "
"[url=https://en.wikipedia.org/wiki/General_MIDI#Controller_events]General "
"MIDI specification[/url] for a small list."
msgstr ""
"ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກເມື່ອຄ່າຂອງຕົວຄວບຄຸມ (controller) ມີການປ່ຽນແປງ. ໃນອຸປະກອນ MIDI, "
"ຕົວຄວບຄຸມຄືທຸກອິນພຸດທີ່ບໍ່ແມ່ນການຫຼິ້ນໂນ້ດ. ອາດລວມເຖິງແຖບເລື່ອນສຽງ (slider), ປຸ່ມປັບສົມດຸນ "
"(balance), ປຸ່ມແຍກສຽງ (panning), ລວມເຖິງສະວິດ ແລະ ແປ້ນຢຽບ (pedal). "
"ເບິ່ງລາຍການເພີ່ມເຕີມໄດ້ທີ່ [url=https://en.wikipedia.org/wiki/"
"General_MIDI#Controller_events]General MIDI specification[/url]."

msgid ""
"MIDI message sent when the MIDI device changes its current instrument (also "
"called [i]program[/i] or [i]preset[/i])."
msgstr ""
"ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກເມື່ອອຸປະກອນ MIDI ປ່ຽນເຄື່ອງດົນຕີ (ຫຼື ເອີ້ນວ່າ [i]program[/i] ຫຼື "
"[i]preset[/i])."

msgid ""
"MIDI message sent to indicate a change in pressure for the whole channel. "
"Some MIDI devices may send this instead of [constant MIDI_MESSAGE_AFTERTOUCH]."
msgstr ""
"ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກເພື່ອບອກເຖິງການປ່ຽນແປງຂອງແຮງກົດສຳລັບທັງຊ່ອງສັນຍານ (channel). ອຸປະກອນ "
"MIDI ບາງອັນອາດສົ່ງຂໍ້ຄວາມນີ້ແທນ [constant MIDI_MESSAGE_AFTERTOUCH]."

msgid ""
"MIDI message sent when the value of the pitch bender changes, usually a wheel "
"on the MIDI device."
msgstr ""
"ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກເມື່ອຄ່າຂອງ pitch bender (ຕົວປັບລະດັບສຽງ) ປ່ຽນແປງ, "
"ປົກກະຕິແມ່ນເປັນລໍ້ເລື່ອນໃນອຸປະກອນ MIDI."

msgid ""
"MIDI system exclusive (SysEx) message. This type of message is not "
"standardized and it's highly dependent on the MIDI device sending it.\n"
"[b]Note:[/b] Getting this message's data from [InputEventMIDI] is not "
"implemented."
msgstr ""
"ຂໍ້ຄວາມ MIDI system exclusive (SysEx). ຂໍ້ຄວາມປະເພດນີ້ບໍ່ໄດ້ມີມາດຕະຖານຕາຍຕົວ ແລະ "
"ຂຶ້ນກັບອຸປະກອນ MIDI ທີ່ສົ່ງມາ.\n"
"[b]ໝາຍເຫດ:[/b] ການດຶງຂໍ້ມູນຂໍ້ຄວາມນີ້ຈາກ [InputEventMIDI] ແມ່ນຍັງບໍ່ທັນຖືກພັດທະນາ."

msgid ""
"MIDI message sent every quarter frame to keep connected MIDI devices "
"synchronized. Related to [constant MIDI_MESSAGE_TIMING_CLOCK].\n"
"[b]Note:[/b] Getting this message's data from [InputEventMIDI] is not "
"implemented."
msgstr ""
"ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກທຸກໆ quarter frame ເພື່ອໃຫ້ອຸປະກອນ MIDI ທີ່ເຊື່ອມຕໍ່ຢູ່ເຮັດວຽກພ້ອມກັນ "
"(synchronize). ກ່ຽວຂ້ອງກັບ [constant MIDI_MESSAGE_TIMING_CLOCK].\n"
"[b]ໝາຍເຫດ:[/b] ການດຶງຂໍ້ມູນຂໍ້ຄວາມນີ້ຈາກ [InputEventMIDI] ແມ່ນຍັງບໍ່ທັນຖືກພັດທະນາ."

msgid ""
"MIDI message sent to jump onto a new position in the current sequence or "
"song.\n"
"[b]Note:[/b] Getting this message's data from [InputEventMIDI] is not "
"implemented."
msgstr ""
"ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກເພື່ອໂດດໄປຍັງຕຳແໜ່ງໃໝ່ໃນລຳດັບ (sequence) ຫຼື ເພງທີ່ກຳລັງຫຼິ້ນ.\n"
"[b]ໝາຍເຫດ:[/b] ການດຶງຂໍ້ມູນຂໍ້ຄວາມນີ້ຈາກ [InputEventMIDI] ແມ່ນຍັງບໍ່ທັນຖືກພັດທະນາ."

msgid ""
"MIDI message sent to select a sequence or song to play.\n"
"[b]Note:[/b] Getting this message's data from [InputEventMIDI] is not "
"implemented."
msgstr ""
"ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກເພື່ອເລືອກລຳດັບ (sequence) ຫຼື ເພງທີ່ຈະຫຼິ້ນ.\n"
"[b]ໝາຍເຫດ:[/b] ການດຶງຂໍ້ມູນຂໍ້ຄວາມນີ້ຈາກ [InputEventMIDI] ແມ່ນຍັງບໍ່ທັນຖືກພັດທະນາ."

msgid ""
"MIDI message sent to request a tuning calibration. Used on analog "
"synthesizers. Most modern MIDI devices do not need this message."
msgstr ""
"ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກເພື່ອຮ້ອງຂໍການປັບຈູນສຽງ (tuning calibration). "
"ໃຊ້ໃນເຄື່ອງສັງເຄາະສຽງອານາລັອກ (analog synthesizers). ອຸປະກອນ MIDI "
"ສະໄໝໃໝ່ສ່ວນຫຼາຍບໍ່ຈຳເປັນຕ້ອງໃຊ້ຂໍ້ຄວາມນີ້."

msgid ""
"MIDI message sent 24 times after [constant MIDI_MESSAGE_QUARTER_FRAME], to "
"keep connected MIDI devices synchronized."
msgstr ""
"ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກ 24 ຄັ້ງ ຫຼັງຈາກ [constant MIDI_MESSAGE_QUARTER_FRAME] "
"ເພື່ອໃຫ້ອຸປະກອນ MIDI ທີ່ເຊື່ອມຕໍ່ຢູ່ເຮັດວຽກພ້ອມກັນ."

msgid ""
"MIDI message sent to start the current sequence or song from the beginning."
msgstr "ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກເພື່ອເລີ່ມຫຼິ້ນລຳດັບ ຫຼື ເພງໃໝ່ແຕ່ຕົ້ນ."

msgid ""
"MIDI message sent to resume from the point the current sequence or song was "
"paused."
msgstr "ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກເພື່ອຫຼິ້ນຕໍ່ຈາກຈຸດທີ່ລຳດັບ ຫຼື ເພງຖືກຢຸດຊົ່ວຄາວ."

msgid "MIDI message sent to pause the current sequence or song."
msgstr "ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກເພື່ອຢຸດລຳດັບ ຫຼື ເພງໄວ້ຊົ່ວຄາວ."

msgid ""
"MIDI message sent repeatedly while the MIDI device is idle, to tell the "
"receiver that the connection is alive. Most MIDI devices do not send this "
"message."
msgstr ""
"ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກຊ້ຳໆໃນຂະນະທີ່ອຸປະກອນ MIDI ວ່າງຢູ່, ເພື່ອບອກຕົວຮັບວ່າການເຊື່ອມຕໍ່ຍັງປົກກະຕິ. "
"ອຸປະກອນ MIDI ສ່ວນຫຼາຍບໍ່ສົ່ງຂໍ້ຄວາມນີ້."

msgid ""
"MIDI message sent to reset a MIDI device to its default state, as if it was "
"just turned on. It should not be sent when the MIDI device is being turned on."
msgstr ""
"ຂໍ້ຄວາມ MIDI ທີ່ສົ່ງອອກເພື່ອຕັ້ງຄ່າອຸປະກອນ MIDI ກັບໄປເປັນຄ່າເລີ່ມຕົ້ນ, ຄືກັບຕອນທີ່ຫາກໍເປີດເຄື່ອງໃໝ່. "
"ບໍ່ຄວນສົ່ງຂໍ້ຄວາມນີ້ໃນຂະນະທີ່ອຸປະກອນກຳລັງເປີດຢູ່."

msgid ""
"Methods that return [enum Error] return [constant OK] when no error "
"occurred.\n"
"Since [constant OK] has value [code]0[/code], and all other error constants "
"are positive integers, it can also be used in boolean checks.\n"
"[codeblock]\n"
"var error = method_that_returns_error()\n"
"if error != OK:\n"
"\tprinterr(\"Failure!\")\n"
"\n"
"# Or, alternatively:\n"
"if error:\n"
"\tprinterr(\"Still failing!\")\n"
"[/codeblock]\n"
"[b]Note:[/b] Many functions do not return an error code, but will print error "
"messages to standard output."
msgstr ""
"ເມັດທອດ (Methods) ທີ່ສົ່ງຄືນ [enum Error] ຈະສົ່ງຄືນ [constant OK] ເມື່ອບໍ່ມີຂໍ້ຜິດພາດເກີດຂຶ້ນ.\n"
"ເນື່ອງຈາກ [constant OK] ມີຄ່າເປັນ [code]0[/code], ແລະ "
"ຄ່າຄົງທີ່ຂອງຂໍ້ຜິດພາດອື່ນໆແມ່ນເປັນເລກຈຳນວນເຕັມບວກ, ມັນຈຶ່ງສາມາດໃຊ້ໃນການກວດສອບຄ່າ boolean ໄດ້.\n"
"[codeblock]\n"
"var error = method_that_returns_error()\n"
"if error != OK:\n"
"\tprinterr(\"Failure!\")\n"
"\n"
"# ຫຼື ອີກແບບໜຶ່ງ:\n"
"if error:\n"
"\tprinterr(\"Still failing!\")\n"
"[/codeblock]\n"
"[b]ໝາຍເຫດ:[/b] ຫຼາຍໆຟັງຊັນບໍ່ໄດ້ສົ່ງຄືນລະຫັດຂໍ້ຜິດພາດ, ແຕ່ຈະສະແດງຂໍ້ຄວາມຜິດພາດອອກທາງ standard "
"output."

msgid "Generic error."
msgstr "ຂໍ້ຜິດພາດທົ່ວໄປ."

msgid "Unavailable error."
msgstr "ຂໍ້ຜິດພາດ: ບໍ່ສາມາດໃຊ້ງານໄດ້."

msgid "Unconfigured error."
msgstr "ຂໍ້ຜິດພາດ: ຍັງບໍ່ທັນໄດ້ຕັ້ງຄ່າ."

msgid "Unauthorized error."
msgstr "ຂໍ້ຜິດພາດ: ບໍ່ໄດ້ຮັບອະນຸຍາດ."

msgid "Parameter range error."
msgstr "ຂໍ້ຜິດພາດ: ຊ່ວງຂອງພາລາມິເຕີບໍ່ຖືກຕ້ອງ."

msgid "Out of memory (OOM) error."
msgstr "ຂໍ້ຜິດພາດ: ໜ່ວຍຄວາມຈຳເຕັມ (OOM)."

msgid "File: Not found error."
msgstr "ໄຟລ໌: ຂໍ້ຜິດພາດບໍ່ພົບໄຟລ໌."

msgid "File: Bad drive error."
msgstr "ໄຟລ໌: ຂໍ້ຜິດພາດໄດຣຟ໌ບໍ່ດີ."

msgid "File: Bad path error."
msgstr "ໄຟລ໌: ຂໍ້ຜິດພາດເສັ້ນທາງ (path) ບໍ່ຖືກຕ້ອງ."

msgid "File: No permission error."
msgstr "ໄຟລ໌: ຂໍ້ຜິດພາດບໍ່ມີສິດເຂົ້າເຖິງ."

msgid "File: Already in use error."
msgstr "ໄຟລ໌: ຂໍ້ຜິດພາດໄຟລ໌ກຳລັງຖືກໃຊ້ງານຢູ່."

msgid "File: Can't open error."
msgstr "ໄຟລ໌: ຂໍ້ຜິດພາດບໍ່ສາມາດເປີດໄດ້."

msgid "File: Can't write error."
msgstr "ໄຟລ໌: ຂໍ້ຜິດພາດບໍ່ສາມາດຂຽນໄດ້."

msgid "File: Can't read error."
msgstr "ໄຟລ໌: ຂໍ້ຜິດພາດບໍ່ສາມາດອ່ານໄດ້."

msgid "File: Unrecognized error."
msgstr "ຂໍ້ຜິດພາດໄຟລ໌: ບໍ່ຮູ້ຈັກປະເພດ."

msgid "File: Corrupt error."
msgstr "ໄຟລ໌: ຂໍ້ຜິດພາດໄຟລ໌ເສຍຫາຍ."

msgid "File: Missing dependencies error."
msgstr "ໄຟລ໌: ຂໍ້ຜິດພາດຂາດໄຟລ໌ທີ່ຈຳເປັນ (dependencies)."

msgid "File: End of file (EOF) error."
msgstr "ໄຟລ໌: ຂໍ້ຜິດພາດສິ້ນສຸດໄຟລ໌ (EOF)."

msgid "Can't open error."
msgstr "ຂໍ້ຜິດພາດ: ບໍ່ສາມາດເປີດໄດ້."

msgid "Can't create error."
msgstr "ຂໍ້ຜິດພາດ: ບໍ່ສາມາດສ້າງໄດ້."

msgid "Query failed error."
msgstr "ຂໍ້ຜິດພາດ: ການສອບຖາມ (query) ລົ້ມເຫຼວ."

msgid "Already in use error."
msgstr "ຂໍ້ຜິດພາດ: ກຳລັງຖືກໃຊ້ງານຢູ່."

msgid "Locked error."
msgstr "ຂໍ້ຜິດພາດ: ຖືກລັອກ."

msgid "Timeout error."
msgstr "ຂໍ້ຜິດພາດ: ໝົດເວລາ (Timeout)."

msgid "Can't connect error."
msgstr "ຂໍ້ຜິດພາດ: ບໍ່ສາມາດເຊື່ອມຕໍ່ໄດ້."

msgid "Can't resolve error."
msgstr "ຂໍ້ຜິດພາດ: ບໍ່ສາມາດຊອກຫາທີ່ຢູ່ (resolve) ໄດ້."

msgid "Connection error."
msgstr "ຂໍ້ຜິດພາດໃນການເຊື່ອມຕໍ່."

msgid "Can't acquire resource error."
msgstr "ຂໍ້ຜິດພາດ: ບໍ່ສາມາດດຶງຊັບພະຍາກອນ (resource) ມາໃຊ້ໄດ້."

msgid "Can't fork process error."
msgstr "ຂໍ້ຜິດພາດ: ບໍ່ສາມາດແຍກໂປຣເຊສ (fork process) ໄດ້."

msgid "Invalid data error."
msgstr "ຂໍ້ຜິດພາດ: ຂໍ້ມູນບໍ່ຖືກຕ້ອງ."

msgid "Invalid parameter error."
msgstr "ຂໍ້ຜິດພາດ: ພາລາມິເຕີບໍ່ຖືກຕ້ອງ."

msgid "Already exists error."
msgstr "ຂໍ້ຜິດພາດ: ມີຢູ່ແລ້ວ."

msgid "Does not exist error."
msgstr "ຂໍ້ຜິດພາດ: ບໍ່ມີຢູ່."

msgid "Database: Read error."
msgstr "ຖານຂໍ້ມູນ: ຂໍ້ຜິດພາດໃນການອ່ານ."

msgid "Database: Write error."
msgstr "ຖານຂໍ້ມູນ: ຂໍ້ຜິດພາດໃນການຂຽນ."

msgid "Compilation failed error."
msgstr "ຂໍ້ຜິດພາດ: ການຄອມໄພລ໌ (compilation) ລົ້ມເຫຼວ."

msgid "Method not found error."
msgstr "ຂໍ້ຜິດພາດ: ບໍ່ພົບເມັດທອດ (method)."

msgid "Linking failed error."
msgstr "ຂໍ້ຜິດພາດ: ການເຊື່ອມໂຍງ (linking) ລົ້ມເຫຼວ."

msgid "Script failed error."
msgstr "ຂໍ້ຜິດພາດ: ສະຄຣິບ (script) ເຮັດວຽກລົ້ມເຫຼວ."

msgid "Cycling link (import cycle) error."
msgstr "ຂໍ້ຜິດພາດ: ການເຊື່ອມໂຍງແບບວົນຊ້ຳ (import cycle)."

msgid "Invalid declaration error."
msgstr "ຂໍ້ຜິດພາດ: ການປະກາດ (declaration) ບໍ່ຖືກຕ້ອງ."

msgid "Duplicate symbol error."
msgstr "ຂໍ້ຜິດພາດ: ຊື່ສັນຍະລັກ (symbol) ຊ້ຳກັນ."

msgid "Parse error."
msgstr "ຂໍ້ຜິດພາດໃນການວິເຄາະ (parse)."

msgid "Busy error."
msgstr "ຂໍ້ຜິດພາດ: ລະບົບກຳລັງບໍ່ວ່າງ (busy)."

msgid "Skip error."
msgstr "ຂໍ້ຜິດພາດ: ໃຫ້ຂ້າມ."

msgid ""
"Help error. Used internally when passing [code]--version[/code] or [code]--"
"help[/code] as executable options."
msgstr ""
"ຂໍ້ຜິດພາດການຊ່ວຍເຫຼືອ. ໃຊ້ພາຍໃນເມື່ອມີການສົ່ງ [code]--version[/code] ຫຼື [code]--help[/"
"code] ເປັນຕົວເລືອກໃນການສັ່ງລັນໂປຣແກຣມ."

msgid ""
"Bug error, caused by an implementation issue in the method.\n"
"[b]Note:[/b] If a built-in method returns this code, please open an issue on "
"[url=https://github.com/godotengine/godot/issues]the GitHub Issue Tracker[/"
"url]."
msgstr ""
"ຂໍ້ຜິດພາດຈາກບັກ (bug), ເກີດຈາກບັນຫາໃນການຂຽນຄຳສັ່ງພາຍໃນເມັດທອດ.\n"
"[b]ໝາຍເຫດ:[/b] ຖ້າເມັດທອດມາດຕະຖານສົ່ງຄືນລະຫັດນີ້, ກະລຸນາແຈ້ງບັນຫາໄດ້ທີ່ [url=https://"
"github.com/godotengine/godot/issues]GitHub Issue Tracker[/url]."

msgid ""
"Printer on fire error (this is an easter egg, no built-in methods return this "
"error code)."
msgstr ""
"ຂໍ້ຜິດພາດ: ເຄື່ອງພິມກຳລັງໄໝ້ (ນີ້ແມ່ນອີສເຕີເອັກ (easter egg), "
"ບໍ່ມີເມັດທອດມາດຕະຖານໃດທີ່ຈະສົ່ງຄືນລະຫັດນີ້)."

msgid ""
"The property has no hint for the editor. However, the hint string is still "
"read, which can be used to specify a suffix for a property that has no range "
"limit (see [constant PROPERTY_HINT_RANGE]'s description)."
msgstr ""
"ຄຸນສົມບັດນີ້ບໍ່ມີຄຳໃບ້ (hint) ສຳລັບຕົວແກ້ໄຂ. ຢ່າງໃດກໍຕາມ, ຂໍ້ຄວາມຄຳໃບ້ຍັງຄົງຖືກອ່ານຢູ່, "
"ເຊິ່ງສາມາດໃຊ້ເພື່ອລະບົບຄຳຕໍ່ທ້າຍ (suffix) ໃຫ້ກັບຄຸນສົມບັດທີ່ບໍ່ມີຂີດຈຳກັດຊ່ວງ (ເບິ່ງຄຳອະທິບາຍຂອງ "
"[constant PROPERTY_HINT_RANGE])."

msgid ""
"Hints that an [int], [float], or packed/typed [Array] property containing "
"[int] or [float] types should be within a range specified via the hint string "
"[code]\"min,max\"[/code] or [code]\"min,max,step\"[/code]. The hint string "
"can optionally include [code]\"or_greater\"[/code] and/or [code]\"or_less\"[/"
"code] to allow manual input going respectively above the max or below the min "
"values.\n"
"[b]Example:[/b] [code]\"-360,360,1,or_greater,or_less\"[/code].\n"
"Additionally, other keywords can be included: [code]\"exp\"[/code] for "
"exponential range editing, [code]\"radians_as_degrees\"[/code] for editing "
"radian angles in degrees (the range values are also in degrees), [code]"
"\"degrees\"[/code] to hint at an angle, [code]\"prefer_slider\"[/code] to "
"show the slider for integers, [code]\"hide_control\"[/code] to hide the "
"slider or up-down arrows, and [code]\"suffix:px/s\"[/code] to display a "
"suffix indicating the value's unit (e.g. [code]px/s[/code] for pixels per "
"second)."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ [int], [float], ຫຼື [Array] ທີ່ເກັບ [int] ຫຼື [float] "
"ຄວນຢູ່ໃນຊ່ວງທີ່ລະບຸຜ່ານຂໍ້ຄວາມຄຳໃບ້ [code]\"min,max\"[/code] ຫຼື [code]\"min,max,step\"[/"
"code]. ຂໍ້ຄວາມຄຳໃບ້ສາມາດໃສ່ [code]\"or_greater\"[/code] ແລະ/ຫຼື [code]\"or_less\"[/"
"code] ເພື່ອອະນຸຍາດໃຫ້ປ້ອນຄ່າດ້ວຍມືທີ່ສູງກວ່າຄ່າສູງສຸດ ຫຼື ຕ່ຳກວ່າຄ່າຕ່ຳສຸດໄດ້.\n"
"[b]ຕົວຢ່າງ:[/b] [code]\"-360,360,1,or_greater,or_less\"[/code].\n"
"ນອກຈາກນັ້ນ, ຍັງສາມາດໃສ່ຄຳສຳຄັນອື່ນໆໄດ້: [code]\"exp\"[/code] ສຳລັບການແກ້ໄຂຊ່ວງແບບ "
"exponential, [code]\"radians_as_degrees\"[/code] "
"ສຳລັບການແກ້ໄຂມຸມເຣເດຍນໃນຮູບແບບອົງສາ, [code]\"degrees\"[/code] ເພື່ອບອກວ່າເປັນມຸມ, [code]"
"\"prefer_slider\"[/code] ເພື່ອສະແດງແຖບເລື່ອນສຳລັບເລກຈຳນວນເຕັມ, [code]"
"\"hide_control\"[/code] ເພື່ອເຊື່ອງແຖບເລື່ອນ ຫຼື ລູກສອນຂຶ້ນ-ລົງ, ແລະ [code]\"suffix:px/"
"s\"[/code] ເພື່ອສະແດງຄຳຕໍ່ທ້າຍບອກຫົວໜ່ວຍຂອງຄ່າ (ເຊັ່ນ: [code]px/s[/code])."

msgid ""
"Hints that an [int], [String], or [StringName] property is an enumerated "
"value to pick in a list specified via a hint string.\n"
"The hint string is a comma separated list of names such as [code]"
"\"Hello,Something,Else\"[/code]. Whitespace is [b]not[/b] removed from either "
"end of a name. For integer properties, the first name in the list has value "
"0, the next 1, and so on. Explicit values can also be specified by appending "
"[code]:integer[/code] to the name, e.g. [code]"
"\"Zero,One,Three:3,Four,Six:6\"[/code]."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ [int], [String], ຫຼື [StringName] ແມ່ນຄ່າລາຍການ (enumerated) "
"ໃຫ້ເລືອກຈາກລາຍຊື່ທີ່ລະບຸຜ່ານຂໍ້ຄວາມຄຳໃບ້.\n"
"ຂໍ້ຄວາມຄຳໃບ້ແມ່ນລາຍຊື່ທີ່ແຍກດ້ວຍຈຸດ ເຊັ່ນ [code]\"ສະບາຍດີ,ບາງຢ່າງ,ອື່ນໆ\"[/code]. ຊ່ອງວ່າງຈະ "
"[b]ບໍ່[/b] ຖືກຕັດອອກຈາກຫົວ ຫຼື ທ້າຍຂອງຊື່. ສຳລັບຄຸນສົມບັດເລກຈຳນວນເຕັມ, ຊື່ອັນທຳອິດຈະມີຄ່າ 0, "
"ຕໍ່ມາແມ່ນ 1, ໄປເລື້ອຍໆ. ຍັງສາມາດລະບຸຄ່າໄດ້ໂດຍກົງໂດຍການໃສ່ [code]:ຕົວເລກ[/code] ຕໍ່ທ້າຍຊື່, ເຊັ່ນ "
"[code]\"Zero,One,Three:3,Four,Six:6\"[/code]."

msgid ""
"Hints that a [String] or [StringName] property can be an enumerated value to "
"pick in a list specified via a hint string such as [code]"
"\"Hello,Something,Else\"[/code]. See [constant PROPERTY_HINT_ENUM] for "
"details.\n"
"Unlike [constant PROPERTY_HINT_ENUM], a property with this hint still accepts "
"arbitrary values and can be empty. The list of values serves to suggest "
"possible values."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ [String] ຫຼື [StringName] ສາມາດເລືອກຈາກລາຍການທີ່ລະບຸໃນຂໍ້ຄວາມຄຳໃບ້ ເຊັ່ນ "
"[code]\"ສະບາຍດີ,ບາງຢ່າງ,ອື່ນໆ\"[/code]. ເບິ່ງລາຍລະອຽດທີ່ [constant "
"PROPERTY_HINT_ENUM].\n"
"ຕ່າງຈາກ [constant PROPERTY_HINT_ENUM], ຄຸນສົມບັດທີ່ມີຄຳໃບ້ນີ້ຍັງສາມາດຮັບຄ່າໃດໆກໍໄດ້ ແລະ "
"ສາມາດວ່າງໄດ້. ລາຍການທີ່ລະບຸໄວ້ແມ່ນເພື່ອແນະນຳຄ່າທີ່ເປັນໄປໄດ້ເທົ່ານັ້ນ."

msgid ""
"Hints that a [float] property should be edited using a curve editor showing "
"an exponential easing function. The hint string can include [code]"
"\"attenuation\"[/code] to flip the curve horizontally and/or [code]"
"\"positive_only\"[/code] to exclude in/out easing and limit values to be "
"greater than or equal to zero. This displays differently to a property that "
"uses [constant PROPERTY_HINT_RANGE] with the [code]\"exp\"[/code] keyword, as "
"it's edited with a slider instead of a curve editor."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ [float] ຄວນແກ້ໄຂໂດຍໃຊ້ຕົວແກ້ໄຂເສັ້ນໂຄ້ງ (curve editor) ທີ່ສະແດງຟັງຊັນ "
"exponential easing. ຂໍ້ຄວາມຄຳໃບ້ສາມາດໃສ່ [code]\"attenuation\"[/code] "
"ເພື່ອປີ້ນເສັ້ນໂຄ້ງຕາມລວງນອນ ແລະ/ຫຼື [code]\"positive_only\"[/code] ເພື່ອຈຳກັດຄ່າໃຫ້ຫຼາຍກວ່າ ຫຼື "
"ເທົ່າກັບສູນ. ອັນນີ້ຈະສະແດງຜົນຕ່າງຈາກຄຸນສົມບັດທີ່ໃຊ້ [constant PROPERTY_HINT_RANGE] ທີ່ມີຄຳສຳຄັນ "
"[code]\"exp\"[/code], ເພາະມັນຈະຖືກແກ້ໄຂດ້ວຍແຖບເລື່ອນແທນຕົວແກ້ໄຂເສັ້ນໂຄ້ງ."

msgid ""
"Hints that a vector property should allow its components to be linked. For "
"example, this allows [member Vector2.x] and [member Vector2.y] to be edited "
"together. This hint is supported on [Vector2], [Vector2i], [Vector3], "
"[Vector3i], [Vector4], and [Vector4i]. The hint string can be used to specify "
"a suffix indicating each value's unit with the [code]\"suffix:px/s\"[/code] "
"syntax."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດປະເພດ vector ຄວນອະນຸຍາດໃຫ້ເຊື່ອມໂຍງຄ່າຕ່າງໆເຂົ້າກັນໄດ້. ຕົວຢ່າງ, ຊ່ວຍໃຫ້ "
"[member Vector2.x] ແລະ [member Vector2.y] ຖືກແກ້ໄຂໄປພ້ອມກັນໄດ້. ຄຳໃບ້ນີ້ຮອງຮັບໃນ "
"[Vector2], [Vector2i], [Vector3], [Vector3i], [Vector4], ແລະ [Vector4i]. "
"ຂໍ້ຄວາມຄຳໃບ້ສາມາດໃຊ້ເພື່ອລະບຸຄຳຕໍ່ທ້າຍບອກຫົວໜ່ວຍດ້ວຍໄວຍາກອນ [code]\"suffix:px/s\"[/code]."

msgid ""
"Hints that an [int] property is a bitmask with named bit flags.\n"
"The hint string is a comma separated list of names such as [code]"
"\"Bit0,Bit1,Bit2,Bit3\"[/code]. Whitespace is [b]not[/b] removed from either "
"end of a name. The first name in the list has value 1, the next 2, then 4, 8, "
"16 and so on. Explicit values can also be specified by appending "
"[code]:integer[/code] to the name, e.g. [code]\"A:4,B:8,C:16\"[/code]. You "
"can also combine several flags ([code]\"A:4,B:8,AB:12,C:16\"[/code]).\n"
"[b]Note:[/b] A flag value must be at least [code]1[/code] and at most [code]2 "
"** 32 - 1[/code].\n"
"[b]Note:[/b] Unlike [constant PROPERTY_HINT_ENUM], the previous explicit "
"value is not taken into account. For the hint [code]\"A:16,B,C\"[/code], A is "
"16, B is 2, C is 4."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ [int] ແມ່ນ bitmask ທີ່ມີຊື່ກຳກັບແຕ່ລະບິດ.\n"
"ຂໍ້ຄວາມຄຳໃບ້ແມ່ນລາຍຊື່ແຍກດ້ວຍຈຸດ ເຊັ່ນ [code]\"Bit0,Bit1,Bit2,Bit3\"[/code]. ຊ່ອງວ່າງຈະ "
"[b]ບໍ່[/b] ຖືກຕັດອອກ. ຊື່ອັນທຳອິດມີຄ່າ 1, ຕໍ່ມາແມ່ນ 2, ຈາກນັ້ນແມ່ນ 4, 8, 16 ໄປເລື້ອຍໆ. "
"ສາມາດລະບຸຄ່າໂດຍກົງໄດ້ດ້ວຍ [code]:ຕົວເລກ[/code], ເຊັ່ນ [code]\"A:4,B:8,C:16\"[/code]. "
"ແລະ ສາມາດລວມຫຼາຍແຟລັກ (flag) ເຂົ້າກັນໄດ້.\n"
"[b]ໝາຍເຫດ:[/b] ຄ່າແຟລັກຕ້ອງຢູ່ລະຫວ່າງ [code]1[/code] ຫາ [code]2 ** 32 - 1[/code].\n"
"[b]ໝາຍເຫດ:[/b] ຕ່າງຈາກ [constant PROPERTY_HINT_ENUM], ຄ່າກ່ອນໜ້ານັ້ນຈະບໍ່ຖືກນຳມາຄິດໄລ່ຕໍ່. "
"ສຳລັບຄຳໃບ້ [code]\"A:16,B,C\"[/code], A ຈະແມ່ນ 16, B ແມ່ນ 2, C ແມ່ນ 4."

msgid ""
"Hints that an [int] property is a bitmask using the optionally named 2D "
"render layers."
msgstr "ຄຳໃບ້ວ່າຄຸນສົມບັດ [int] ແມ່ນ bitmask ທີ່ໃຊ້ສຳລັບຊັ້ນການສະແດງຜົນ (render layers) 2D."

msgid ""
"Hints that an [int] property is a bitmask using the optionally named 2D "
"physics layers."
msgstr "ຄຳໃບ້ວ່າຄຸນສົມບັດ [int] ແມ່ນ bitmask ທີ່ໃຊ້ສຳລັບຊັ້ນຟີຊິກ (physics layers) 2D."

msgid ""
"Hints that an [int] property is a bitmask using the optionally named 2D "
"navigation layers."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ [int] ແມ່ນ bitmask ທີ່ໃຊ້ສຳລັບຊັ້ນການນຳທາງ (navigation layers) 2D."

msgid ""
"Hints that an [int] property is a bitmask using the optionally named 3D "
"render layers."
msgstr "ຄຳໃບ້ວ່າຄຸນສົມບັດ [int] ແມ່ນ bitmask ທີ່ໃຊ້ສຳລັບຊັ້ນການສະແດງຜົນ (render layers) 3D."

msgid ""
"Hints that an [int] property is a bitmask using the optionally named 3D "
"physics layers."
msgstr "ຄຳໃບ້ວ່າຄຸນສົມບັດ [int] ແມ່ນ bitmask ທີ່ໃຊ້ສຳລັບຊັ້ນຟີຊິກ (physics layers) 3D."

msgid ""
"Hints that an [int] property is a bitmask using the optionally named 3D "
"navigation layers."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ [int] ແມ່ນ bitmask ທີ່ໃຊ້ສຳລັບຊັ້ນການນຳທາງ (navigation layers) 3D."

msgid ""
"Hints that an integer property is a bitmask using the optionally named "
"avoidance layers."
msgstr "ຄຳໃບ້ວ່າຄຸນສົມບັດເລກຈຳນວນເຕັມແມ່ນ bitmask ທີ່ໃຊ້ສຳລັບຊັ້ນການຫຼົບຫຼີກ (avoidance layers)."

msgid ""
"Hints that a [String] property is a path to a file. Editing it will show a "
"file dialog for picking the path. The hint string can be a set of filters "
"with wildcards like [code]\"*.png,*.jpg\"[/code]. By default the file will be "
"stored as UID whenever available. You can use [ResourceUID] methods to "
"convert it back to path. For storing a raw path, use [constant "
"PROPERTY_HINT_FILE_PATH]."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ [String] ແມ່ນເສັ້ນທາງໄປຫາໄຟລ໌. ການແກ້ໄຂຈະສະແດງປ່ອງຢ້ຽມເລືອກໄຟລ໌. "
"ຂໍ້ຄວາມຄຳໃບ້ສາມາດໃສ່ຕົວຕອງ (filter) ເຊັ່ນ [code]\"*.png,*.jpg\"[/code]. ໂດຍຄ່າເລີ່ມຕົ້ນ, "
"ໄຟລ໌ຈະຖືກເກັບເປັນ UID ຖ້າມີ. ສາມາດໃຊ້ [ResourceUID] ເພື່ອປ່ຽນກັບເປັນເສັ້ນທາງໄດ້. "
"ສຳລັບການເກັບເສັ້ນທາງແບບດິບ (raw path), ໃຫ້ໃຊ້ [constant PROPERTY_HINT_FILE_PATH]."

msgid ""
"Hints that a [String] property is a path to a directory. Editing it will show "
"a file dialog for picking the path."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ [String] ແມ່ນເສັ້ນທາງໄປຫາໂຟນເດີ. ການແກ້ໄຂຈະສະແດງປ່ອງຢ້ຽມເລືອກໂຟນເດີ."

msgid ""
"Hints that a [String] property is an absolute path to a file outside the "
"project folder. Editing it will show a file dialog for picking the path. The "
"hint string can be a set of filters with wildcards, like [code]"
"\"*.png,*.jpg\"[/code]."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ [String] ແມ່ນເສັ້ນທາງເຕັມ (absolute path) ໄປຫາໄຟລ໌ພາຍນອກໂຟນເດີໂປຣເຈັກ. "
"ການແກ້ໄຂຈະສະແດງປ່ອງຢ້ຽມເລືອກໄຟລ໌. ຂໍ້ຄວາມຄຳໃບ້ສາມາດໃສ່ຕົວຕອງໄດ້ ເຊັ່ນ [code]"
"\"*.png,*.jpg\"[/code]."

msgid ""
"Hints that a [String] property is an absolute path to a directory outside the "
"project folder. Editing it will show a file dialog for picking the path."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ [String] ແມ່ນເສັ້ນທາງເຕັມ (absolute path) "
"ໄປຫາໂຟນເດີພາຍນອກໂຟນເດີໂປຣເຈັກ. ການແກ້ໄຂຈະສະແດງປ່ອງຢ້ຽມເລືອກໂຟນເດີ."

msgid ""
"Hints that a property is an instance of a [Resource]-derived type, optionally "
"specified via the hint string (e.g. [code]\"Texture2D\"[/code]). Editing it "
"will show a popup menu of valid resource types to instantiate."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດແມ່ນອິນສະແຕນຊ໌ (instance) ຂອງປະເພດທີ່ສືບທອດມາຈາກ [Resource], "
"ເຊິ່ງສາມາດລະບຸໄດ້ໃນຂໍ້ຄວາມຄຳໃບ້ (ເຊັ່ນ [code]\"Texture2D\"[/code]). "
"ການແກ້ໄຂຈະສະແດງເມນູລາຍຊື່ປະເພດຊັບພະຍາກອນທີ່ສາມາດສ້າງໄດ້."

msgid ""
"Hints that a [String] property is text with line breaks. Editing it will show "
"a text input field where line breaks can be typed.\n"
"The hint string can be set to [code]\"monospace\"[/code] to force the input "
"field to use a monospaced font.\n"
"If the hint string [code]\"no_wrap\"[/code] is set, the input field will not "
"wrap lines at boundaries, instead resorting to making the area scrollable."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ [String] ແມ່ນຂໍ້ຄວາມທີ່ມີການຂຶ້ນບັນທັດໃໝ່. "
"ການແກ້ໄຂຈະສະແດງຊ່ອງປ້ອນຂໍ້ຄວາມທີ່ສາມາດຂຶ້ນບັນທັດໃໝ່ໄດ້.\n"
"ຂໍ້ຄວາມຄຳໃບ້ສາມາດຕັ້ງເປັນ [code]\"monospace\"[/code] ເພື່ອບັງຄັບໃຫ້ໃຊ້ຕົວໜັງສືແບບ "
"monospaced.\n"
"ຖ້າຕັ້ງເປັນ [code]\"no_wrap\"[/code], ຂໍ້ຄວາມຈະບໍ່ຕັດຂຶ້ນບັນທັດໃໝ່ເມື່ອຮອດຂອບ, "
"ແຕ່ຈະປ່ຽນເປັນການເລື່ອນ (scroll) ແທນ."

msgid "Hints that a [String] property is an [Expression]."
msgstr "ຄຳໃບ້ວ່າຄຸນສົມບັດ [String] ແມ່ນ [Expression] (ນິພົດ)."

msgid ""
"Hints that a [String] property should show a placeholder text on its input "
"field, if empty. The hint string is the placeholder text to use."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ [String] ຄວນສະແດງຂໍ້ຄວາມຕົວຢ່າງ (placeholder) ໃນຊ່ອງປ້ອນຂໍ້ມູນຖ້າມັນວ່າງຢູ່. "
"ຂໍ້ຄວາມຄຳໃບ້ຄືຂໍ້ຄວາມທີ່ຈະນຳມາໃຊ້ສະແດງ."

msgid ""
"Hints that a [Color] property should be edited without affecting its "
"transparency ([member Color.a] is not editable)."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ [Color] ຄວນຖືກແກ້ໄຂໂດຍບໍ່ມີຜົນກັບຄວາມໂປ່ງໃສ (ບໍ່ສາມາດແກ້ໄຂ [member Color.a] "
"ໄດ້)."

msgid ""
"Hints that the property's value is an object encoded as object ID, with its "
"type specified in the hint string. Used by the debugger."
msgstr ""
"ຄຳໃບ້ວ່າຄ່າຂອງຄຸນສົມບັດແມ່ນອັອບເຈັກ (object) ທີ່ຖືກເຂົ້າລະຫັດເປັນ ID, "
"ໂດຍມີປະເພດລະບຸໃນຂໍ້ຄວາມຄຳໃບ້. ໃຊ້ໂດຍຕົວດີບັກ (debugger)."

msgid ""
"If a property is [String], hints that the property represents a particular "
"type (class). This allows to select a type from the create dialog. The "
"property will store the selected type as a string.\n"
"If a property is [Array], hints the editor how to show elements. The "
"[code]hint_string[/code] must encode nested types using [code]\":\"[/code] "
"and [code]\"/\"[/code].\n"
"If a property is [Dictionary], hints the editor how to show elements. The "
"[code]hint_string[/code] is the same as [Array], with a [code]\";\"[/code] "
"separating the key and value.\n"
"[codeblocks]\n"
"[gdscript]\n"
"# Array of elem_type.\n"
"hint_string = \"%d:\" % [elem_type]\n"
"hint_string = \"%d/%d:%s\" % [elem_type, elem_hint, elem_hint_string]\n"
"# Two-dimensional array of elem_type (array of arrays of elem_type).\n"
"hint_string = \"%d:%d:\" % [TYPE_ARRAY, elem_type]\n"
"hint_string = \"%d:%d/%d:%s\" % [TYPE_ARRAY, elem_type, elem_hint, "
"elem_hint_string]\n"
"# Three-dimensional array of elem_type (array of arrays of arrays of "
"elem_type).\n"
"hint_string = \"%d:%d:%d:\" % [TYPE_ARRAY, TYPE_ARRAY, elem_type]\n"
"hint_string = \"%d:%d:%d/%d:%s\" % [TYPE_ARRAY, TYPE_ARRAY, elem_type, "
"elem_hint, elem_hint_string]\n"
"[/gdscript]\n"
"[csharp]\n"
"// Array of elemType.\n"
"hintString = $\"{elemType:D}:\";\n"
"hintString = $\"{elemType:D}/{elemHint:D}:{elemHintString}\";\n"
"// Two-dimensional array of elemType (array of arrays of elemType).\n"
"hintString = $\"{Variant.Type.Array:D}:{elemType:D}:\";\n"
"hintString = $\"{Variant.Type.Array:D}:{elemType:D}/{elemHint:D}:"
"{elemHintString}\";\n"
"// Three-dimensional array of elemType (array of arrays of arrays of "
"elemType).\n"
"hintString = $\"{Variant.Type.Array:D}:{Variant.Type.Array:D}:{elemType:D}:"
"\";\n"
"hintString = $\"{Variant.Type.Array:D}:{Variant.Type.Array:D}:{elemType:D}/"
"{elemHint:D}:{elemHintString}\";\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]Examples:[/b]\n"
"[codeblocks]\n"
"[gdscript]\n"
"hint_string = \"%d:\" % [TYPE_INT] # Array of integers.\n"
"hint_string = \"%d/%d:1,10,1\" % [TYPE_INT, PROPERTY_HINT_RANGE] # Array of "
"integers (in range from 1 to 10).\n"
"hint_string = \"%d/%d:Zero,One,Two\" % [TYPE_INT, PROPERTY_HINT_ENUM] # Array "
"of integers (an enum).\n"
"hint_string = \"%d/%d:Zero,One,Three:3,Six:6\" % [TYPE_INT, "
"PROPERTY_HINT_ENUM] # Array of integers (an enum).\n"
"hint_string = \"%d/%d:*.png\" % [TYPE_STRING, PROPERTY_HINT_FILE] # Array of "
"strings (file paths).\n"
"hint_string = \"%d/%d:Texture2D\" % [TYPE_OBJECT, "
"PROPERTY_HINT_RESOURCE_TYPE] # Array of textures.\n"
"\n"
"hint_string = \"%d:%d:\" % [TYPE_ARRAY, TYPE_FLOAT] # Two-dimensional array "
"of floats.\n"
"hint_string = \"%d:%d/%d:\" % [TYPE_ARRAY, TYPE_STRING, "
"PROPERTY_HINT_MULTILINE_TEXT] # Two-dimensional array of multiline strings.\n"
"hint_string = \"%d:%d/%d:-1,1,0.1\" % [TYPE_ARRAY, TYPE_FLOAT, "
"PROPERTY_HINT_RANGE] # Two-dimensional array of floats (in range from -1 to "
"1).\n"
"hint_string = \"%d:%d/%d:Texture2D\" % [TYPE_ARRAY, TYPE_OBJECT, "
"PROPERTY_HINT_RESOURCE_TYPE] # Two-dimensional array of textures.\n"
"[/gdscript]\n"
"[csharp]\n"
"hintString = $\"{Variant.Type.Int:D}/{PropertyHint.Range:D}:1,10,1\"; // "
"Array of integers (in range from 1 to 10).\n"
"hintString = $\"{Variant.Type.Int:D}/{PropertyHint.Enum:D}:Zero,One,Two\"; // "
"Array of integers (an enum).\n"
"hintString = $\"{Variant.Type.Int:D}/"
"{PropertyHint.Enum:D}:Zero,One,Three:3,Six:6\"; // Array of integers (an "
"enum).\n"
"hintString = $\"{Variant.Type.String:D}/{PropertyHint.File:D}:*.png\"; // "
"Array of strings (file paths).\n"
"hintString = $\"{Variant.Type.Object:D}/"
"{PropertyHint.ResourceType:D}:Texture2D\"; // Array of textures.\n"
"\n"
"hintString = $\"{Variant.Type.Array:D}:{Variant.Type.Float:D}:\"; // Two-"
"dimensional array of floats.\n"
"hintString = $\"{Variant.Type.Array:D}:{Variant.Type.String:D}/"
"{PropertyHint.MultilineText:D}:\"; // Two-dimensional array of multiline "
"strings.\n"
"hintString = $\"{Variant.Type.Array:D}:{Variant.Type.Float:D}/"
"{PropertyHint.Range:D}:-1,1,0.1\"; // Two-dimensional array of floats (in "
"range from -1 to 1).\n"
"hintString = $\"{Variant.Type.Array:D}:{Variant.Type.Object:D}/"
"{PropertyHint.ResourceType:D}:Texture2D\"; // Two-dimensional array of "
"textures.\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]Note:[/b] The trailing colon is required for properly detecting built-in "
"types."
msgstr ""
"ຖ້າຄຸນສົມບັດເປັນ [String], ຈະແນະນຳວ່າຄຸນສົມບັດນັ້ນສະແດງເຖິງປະເພດ (ຄລາດ) ສະເພາະໃດໜຶ່ງ. "
"ນີ້ຊ່ວຍໃຫ້ສາມາດເລືອກປະເພດຈາກກ່ອງໂຕ້ຕອບການສ້າງໄດ້. ຄຸນສົມບັດຈະເກັບປະເພດທີ່ເລືອກໄວ້ເປັນສະຕຣິງ.\n"
"ຖ້າຄຸນສົມບັດເປັນ [Array], ຈະແນະນຳຕົວແກ້ໄຂ (editor) ວ່າຄວນສະແດງອົງປະກອບແນວໃດ. "
"[code]hint_string[/code] ຕ້ອງເຂົ້າລະຫັດປະເພດທີ່ຊ້ອນກັນໂດຍໃຊ້ [code]\":\"[/code] ແລະ "
"[code]\"/\"[/code].\n"
"ຖ້າຄຸນສົມບັດເປັນ [Dictionary], ຈະແນະນຳຕົວແກ້ໄຂວ່າຄວນສະແດງອົງປະກອບແນວໃດ. "
"[code]hint_string[/code] ແມ່ນຄືກັນກັບ [Array], ໂດຍມີ [code]\";\"[/code] ແຍກລະຫວ່າງຄີ "
"(key) ແລະ ຄ່າ (value).\n"
"[codeblocks]\n"
"[gdscript]\n"
"# Array ຂອງ elem_type.\n"
"hint_string = \"%d:\" % [elem_type]\n"
"hint_string = \"%d/%d:%s\" % [elem_type, elem_hint, elem_hint_string]\n"
"# Array ສອງມິຕິຂອງ elem_type (array ຂອງ array ຂອງ elem_type).\n"
"hint_string = \"%d:%d:\" % [TYPE_ARRAY, elem_type]\n"
"hint_string = \"%d:%d/%d:%s\" % [TYPE_ARRAY, elem_type, elem_hint, "
"elem_hint_string]\n"
"# Array ສາມມິຕິຂອງ elem_type (array ຂອງ array ຂອງ array ຂອງ elem_type).\n"
"hint_string = \"%d:%d:%d:\" % [TYPE_ARRAY, TYPE_ARRAY, elem_type]\n"
"hint_string = \"%d:%d:%d/%d:%s\" % [TYPE_ARRAY, TYPE_ARRAY, elem_type, "
"elem_hint, elem_hint_string]\n"
"[/gdscript]\n"
"[csharp]\n"
"// Array ຂອງ elemType.\n"
"hintString = $\"{elemType:D}:\";\n"
"hintString = $\"{elemType:D}/{elemHint:D}:{elemHintString}\";\n"
"// Array ສອງມິຕິຂອງ elemType (array ຂອງ array ຂອງ elemType).\n"
"hintString = $\"{Variant.Type.Array:D}:{elemType:D}:\";\n"
"hintString = $\"{Variant.Type.Array:D}:{elemType:D}/{elemHint:D}:"
"{elemHintString}\";\n"
"// Array ສາມມິຕິຂອງ elemType (array ຂອງ array ຂອງ array ຂອງ elemType).\n"
"hintString = $\"{Variant.Type.Array:D}:{Variant.Type.Array:D}:{elemType:D}:"
"\";\n"
"hintString = $\"{Variant.Type.Array:D}:{Variant.Type.Array:D}:{elemType:D}/"
"{elemHint:D}:{elemHintString}\";\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]ຕົວຢ່າງ:[/b]\n"
"[codeblocks]\n"
"[gdscript]\n"
"hint_string = \"%d:\" % [TYPE_INT] # Array ຂອງເລກຖ້ວນ (integers).\n"
"hint_string = \"%d/%d:1,10,1\" % [TYPE_INT, PROPERTY_HINT_RANGE] # Array "
"ຂອງເລກຖ້ວນ (ໃນຊ່ວງແຕ່ 1 ຫາ 10).\n"
"hint_string = \"%d/%d:Zero,One,Two\" % [TYPE_INT, PROPERTY_HINT_ENUM] # Array "
"ຂອງເລກຖ້ວນ (ແບບ enum).\n"
"hint_string = \"%d/%d:Zero,One,Three:3,Six:6\" % [TYPE_INT, "
"PROPERTY_HINT_ENUM] # Array ຂອງເລກຖ້ວນ (ແບບ enum).\n"
"hint_string = \"%d/%d:*.png\" % [TYPE_STRING, PROPERTY_HINT_FILE] # Array "
"ຂອງສະຕຣິງ (ທີ່ຢູ່ໄຟລ໌).\n"
"hint_string = \"%d/%d:Texture2D\" % [TYPE_OBJECT, "
"PROPERTY_HINT_RESOURCE_TYPE] # Array ຂອງພື້ນຜິວ (textures).\n"
"\n"
"hint_string = \"%d:%d:\" % [TYPE_ARRAY, TYPE_FLOAT] # Array "
"ສອງມິຕິຂອງເລກທົດສະນິຍົມ (floats).\n"
"hint_string = \"%d:%d/%d:\" % [TYPE_ARRAY, TYPE_STRING, "
"PROPERTY_HINT_MULTILINE_TEXT] # Array ສອງມິຕິຂອງສະຕຣິງແບບຫຼາຍແຖວ.\n"
"hint_string = \"%d:%d/%d:-1,1,0.1\" % [TYPE_ARRAY, TYPE_FLOAT, "
"PROPERTY_HINT_RANGE] # Array ສອງມິຕິຂອງເລກທົດສະນິຍົມ (ໃນຊ່ວງແຕ່ -1 ຫາ 1).\n"
"hint_string = \"%d:%d/%d:Texture2D\" % [TYPE_ARRAY, TYPE_OBJECT, "
"PROPERTY_HINT_RESOURCE_TYPE] # Array ສອງມິຕິຂອງພື້ນຜິວ.\n"
"[/gdscript]\n"
"[csharp]\n"
"hintString = $\"{Variant.Type.Int:D}/{PropertyHint.Range:D}:1,10,1\"; // "
"Array ຂອງເລກຖ້ວນ (ໃນຊ່ວງແຕ່ 1 ຫາ 10).\n"
"hintString = $\"{Variant.Type.Int:D}/{PropertyHint.Enum:D}:Zero,One,Two\"; // "
"Array ຂອງເລກຖ້ວນ (ແບບ enum).\n"
"hintString = $\"{Variant.Type.Int:D}/"
"{PropertyHint.Enum:D}:Zero,One,Three:3,Six:6\"; // Array ຂອງເລກຖ້ວນ (ແບບ "
"enum).\n"
"hintString = $\"{Variant.Type.String:D}/{PropertyHint.File:D}:*.png\"; // "
"Array ຂອງສະຕຣິງ (ທີ່ຢູ່ໄຟລ໌).\n"
"hintString = $\"{Variant.Type.Object:D}/"
"{PropertyHint.ResourceType:D}:Texture2D\"; // Array ຂອງພື້ນຜິວ.\n"
"\n"
"hintString = $\"{Variant.Type.Array:D}:{Variant.Type.Float:D}:\"; // Array "
"ສອງມິຕິຂອງເລກທົດສະນິຍົມ.\n"
"hintString = $\"{Variant.Type.Array:D}:{Variant.Type.String:D}/"
"{PropertyHint.MultilineText:D}:\"; // Array ສອງມິຕິຂອງສະຕຣິງແບບຫຼາຍແຖວ.\n"
"hintString = $\"{Variant.Type.Array:D}:{Variant.Type.Float:D}/"
"{PropertyHint.Range:D}:-1,1,0.1\"; // Array ສອງມິຕິຂອງເລກທົດສະນິຍົມ (ໃນຊ່ວງແຕ່ -1 ຫາ "
"1).\n"
"hintString = $\"{Variant.Type.Array:D}:{Variant.Type.Object:D}/"
"{PropertyHint.ResourceType:D}:Texture2D\"; // Array ສອງມິຕິຂອງພື້ນຜິວ.\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]ໝາຍເຫດ:[/b] ເຄື່ອງໝາຍຈ້ຳສອງເມັດ (colon) ຢູ່ທາງທ້າຍແມ່ນຈຳເປັນເພື່ອໃຫ້ກວດຫາປະເພດ built-"
"in ໄດ້ຢ່າງຖືກຕ້ອງ."

msgid "This hint is not used by the engine."
msgstr "ຄຳໃບ້ນີ້ບໍ່ໄດ້ຖືກໃຊ້ໂດຍເອນຈິນ."

msgid "Hints that an object is too big to be sent via the debugger."
msgstr "ຄຳໃບ້ວ່າອັອບເຈັກໃຫຍ່ເກີນກວ່າທີ່ຈະສົ່ງຜ່ານຕົວດີບັກໄດ້."

msgid ""
"Hints that the hint string specifies valid node types for property of type "
"[NodePath]."
msgstr "ຄຳໃບ້ວ່າຂໍ້ຄວາມຄຳໃບ້ລະບຸປະເພດໂນດ (node) ທີ່ຖືກຕ້ອງສຳລັບຄຸນສົມບັດປະເພດ [NodePath]."

msgid ""
"Hints that a [String] property is a path to a file. Editing it will show a "
"file dialog for picking the path for the file to be saved at. The dialog has "
"access to the project's directory. The hint string can be a set of filters "
"with wildcards like [code]\"*.png,*.jpg\"[/code]. See also [member "
"FileDialog.filters]."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ [String] ແມ່ນເສັ້ນທາງໄປຫາໄຟລ໌. ການແກ້ໄຂຈະສະແດງປ່ອງຢ້ຽມເລືອກບ່ອນບັນທຶກໄຟລ໌. "
"ປ່ອງຢ້ຽມນີ້ສາມາດເຂົ້າເຖິງໂຟນເດີຂອງໂປຣເຈັກໄດ້. ຂໍ້ຄວາມຄຳໃບ້ສາມາດໃສ່ຕົວຕອງໄດ້ ເຊັ່ນ [code]"
"\"*.png,*.jpg\"[/code]. ເບິ່ງ [member FileDialog.filters] ຕື່ມ."

msgid ""
"Hints that a [String] property is a path to a file. Editing it will show a "
"file dialog for picking the path for the file to be saved at. The dialog has "
"access to the entire filesystem. The hint string can be a set of filters with "
"wildcards like [code]\"*.png,*.jpg\"[/code]. See also [member "
"FileDialog.filters]."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ [String] ແມ່ນເສັ້ນທາງໄປຫາໄຟລ໌. ການແກ້ໄຂຈະສະແດງປ່ອງຢ້ຽມເລືອກບ່ອນບັນທຶກໄຟລ໌. "
"ປ່ອງຢ້ຽມນີ້ສາມາດເຂົ້າເຖິງລະບົບໄຟລ໌ທັງໝົດໃນເຄື່ອງໄດ້. ຂໍ້ຄວາມຄຳໃບ້ສາມາດໃສ່ຕົວຕອງໄດ້ ເຊັ່ນ [code]"
"\"*.png,*.jpg\"[/code]. ເບິ່ງ [member FileDialog.filters] ຕື່ມ."

msgid "Hints that an [int] property is a pointer. Used by GDExtension."
msgstr "ຄຳໃບ້ວ່າຄຸນສົມບັດ [int] ແມ່ນພອຍເຕີ (pointer). ໃຊ້ໂດຍ GDExtension."

msgid ""
"Hints that a property is an [Array] with the stored type specified in the "
"hint string. The hint string contains the type of the array (e.g. [code]"
"\"String\"[/code]).\n"
"Use the hint string format from [constant PROPERTY_HINT_TYPE_STRING] for more "
"control over the stored type."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດແມ່ນ [Array] ໂດຍມີປະເພດຂໍ້ມູນທີ່ເກັບລະບຸໃນຂໍ້ຄວາມຄຳໃບ້ (ເຊັ່ນ [code]\"String\"[/"
"code]).\n"
"ໃຊ້ຮູບແບບຂໍ້ຄວາມຄຳໃບ້ຈາກ [constant PROPERTY_HINT_TYPE_STRING] "
"ເພື່ອຄວບຄຸມປະເພດຂໍ້ມູນໄດ້ລະອຽດຂຶ້ນ."

msgid ""
"Hints that a property is a [Dictionary] with the stored types specified in "
"the hint string. The hint string contains the key and value types separated "
"by a semicolon (e.g. [code]\"int;String\"[/code]).\n"
"Use the hint string format from [constant PROPERTY_HINT_TYPE_STRING] for more "
"control over the stored types."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດແມ່ນ [Dictionary] ໂດຍມີປະເພດຄີ (key) ແລະ ຄ່າ (value) ລະບຸໃນຂໍ້ຄວາມຄຳໃບ້ "
"ແຍກດ້ວຍຈຳ້ຈຸດ (ເຊັ່ນ [code]\"int;String\"[/code]).\n"
"ໃຊ້ຮູບແບບຂໍ້ຄວາມຄຳໃບ້ຈາກ [constant PROPERTY_HINT_TYPE_STRING] "
"ເພື່ອຄວບຄຸມປະເພດຂໍ້ມູນໄດ້ລະອຽດຂຶ້ນ."

msgid ""
"Hints that a string property is a locale code. Editing it will show a locale "
"dialog for picking language and country."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ string ແມ່ນລະຫັດທ້ອງຖິ່ນ (locale code). ການແກ້ໄຂຈະສະແດງປ່ອງຢ້ຽມເລືອກພາສາ "
"ແລະ ປະເທດ."

msgid ""
"Hints that a dictionary property is string translation map. Dictionary keys "
"are locale codes and, values are translated strings."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ dictionary ແມ່ນແຜນຜັງການແປຂໍ້ຄວາມ. ໂດຍຄີ (key) ແມ່ນລະຫັດທ້ອງຖິ່ນ ແລະ ຄ່າ "
"(value) ແມ່ນຂໍ້ຄວາມທີ່ແປແລ້ວ."

msgid ""
"Hints that a property is an instance of a [Node]-derived type, optionally "
"specified via the hint string (e.g. [code]\"Node2D\"[/code]). Editing it will "
"show a dialog for picking a node from the scene."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດແມ່ນອິນສະແຕນຊ໌ຂອງປະເພດທີ່ສືບທອດມາຈາກ [Node], ສາມາດລະບຸໃນຂໍ້ຄວາມຄຳໃບ້ໄດ້ (ເຊັ່ນ "
"[code]\"Node2D\"[/code]). ການແກ້ໄຂຈະສະແດງປ່ອງຢ້ຽມໃຫ້ເລືອກໂນດຈາກສາກ (scene)."

msgid ""
"Hints that a quaternion property should disable the temporary euler editor."
msgstr "ຄຳໃບ້ວ່າຄຸນສົມບັດ quaternion ຄວນປິດການໃຊ້ງານຕົວແກ້ໄຂ euler ຊົ່ວຄາວ."

msgid ""
"Hints that a string property is a password, and every character is replaced "
"with the secret character."
msgstr "ຄຳໃບ້ວ່າຄຸນສົມບັດ string ແມ່ນລະຫັດຜ່ານ, ແລະ ທຸກຕົວອັກສອນຈະຖືກປ່ຽນເປັນເຄື່ອງໝາຍປິດບັງ."

msgid ""
"Hints that a [Callable] property should be displayed as a clickable button. "
"When the button is pressed, the callable is called. The hint string specifies "
"the button text and optionally an icon from the [code]\"EditorIcons\"[/code] "
"theme type.\n"
"[codeblock lang=text]\n"
"\"Click me!\" - A button with the text \"Click me!\" and the default "
"\"Callable\" icon.\n"
"\"Click me!,ColorRect\" - A button with the text \"Click me!\" and the "
"\"ColorRect\" icon.\n"
"[/codeblock]\n"
"[b]Note:[/b] A [Callable] cannot be properly serialized and stored in a file, "
"so it is recommended to use [constant PROPERTY_USAGE_EDITOR] instead of "
"[constant PROPERTY_USAGE_DEFAULT]."
msgstr ""
"ແນະນຳວ່າຄຸນສົມບັດ [Callable] ຄວນຖືກສະແດງເປັນປຸ່ມທີ່ກົດໄດ້. ເມື່ອປຸ່ມຖືກກົດ, callable ຈະຖືກຮຽກໃຊ້. "
"ສະຕຣິງຄຳແນະນຳຈະລະບຸຂໍ້ຄວາມຂອງປຸ່ມ ແລະ ສາມາດກຳນົດໄອຄອນຈາກປະເພດທີມ [code]"
"\"EditorIcons\"[/code] ໄດ້.\n"
"[codeblock lang=text]\n"
"\"Click me!\" - ປຸ່ມທີ່ມີຂໍ້ຄວາມ \"Click me!\" ແລະ ໄອຄອນ \"Callable\" ມາດຕະຖານ.\n"
"\"Click me!,ColorRect\" - ປຸ່ມທີ່ມີຂໍ້ຄວາມ \"Click me!\" ແລະ ໄອຄອນ \"ColorRect\".\n"
"[/codeblock]\n"
"[b]ໝາຍເຫດ:[/b] [Callable] ບໍ່ສາມາດເຮັດເປັນ serialized ແລະ ເກັບໄວ້ໃນໄຟລ໌ໄດ້ຢ່າງຖືກຕ້ອງ, "
"ດັ່ງນັ້ນຈຶ່ງແນະນຳໃຫ້ໃຊ້ [constant PROPERTY_USAGE_EDITOR] ແທນ [constant "
"PROPERTY_USAGE_DEFAULT]."

msgid ""
"Hints that a property will be changed on its own after setting, such as "
"[member AudioStreamPlayer.playing] or [member GPUParticles3D.emitting]."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດຈະມີການປ່ຽນແປງດ້ວຍຕົວມັນເອງຫຼັງຈາກຕັ້ງຄ່າ, ເຊັ່ນ [member "
"AudioStreamPlayer.playing] ຫຼື [member GPUParticles3D.emitting]."

msgid ""
"Hints that a boolean property will enable the feature associated with the "
"group that it occurs in. The property will be displayed as a checkbox on the "
"group header. Only works within a group or subgroup.\n"
"By default, disabling the property hides all properties in the group. Use the "
"optional hint string [code]\"checkbox_only\"[/code] to disable this behavior."
msgstr ""
"ຄຳໃບ້ວ່າຄຸນສົມບັດ boolean ຈະເປີດໃຊ້ງານຟີເຈີທີ່ກ່ຽວຂ້ອງກັບກຸ່ມນັ້ນ. ຄຸນສົມບັດຈະສະແດງເປັນຫ້ອງໝາຍຕິກ "
"(checkbox) ຢູ່ສ່ວນຫົວຂອງກຸ່ມ. ໃຊ້ໄດ້ສະເພາະໃນກຸ່ມ ຫຼື ກຸ່ມຍ່ອຍເທົ່ານັ້ນ.\n"
"ໂດຍຄ່າເລີ່ມຕົ້ນ, ການປິດຄຸນສົມບັດນີ້ຈະເຊື່ອງທຸກຄຸນສົມບັດໃນກຸ່ມ. ໃຊ້ [code]\"checkbox_only\"[/code] "
"ໃນຂໍ້ຄວາມຄຳໃບ້ເພື່ອປິດພຶດຕິກຳນີ້."

msgid ""
"Hints that a [String] or [StringName] property is the name of an input "
"action. This allows the selection of any action name from the Input Map in "
"the Project Settings. The hint string may contain two options separated by "
"commas:\n"
"- If it contains [code]\"show_builtin\"[/code], built-in input actions are "
"included in the selection.\n"
"- If it contains [code]\"loose_mode\"[/code], loose mode is enabled. This "
"allows inserting any action name even if it's not present in the input map."
msgstr ""
"ແນະນຳວ່າຄຸນສົມບັດ [String] ຫຼື [StringName] ແມ່ນຊື່ຂອງການກະທຳອິນພຸດ (input action). "
"ນີ້ຊ່ວຍໃຫ້ສາມາດເລືອກຊື່ການກະທຳໃດໜຶ່ງຈາກ Input Map ໃນ Project Settings ໄດ້. "
"ສະຕຣິງຄຳແນະນຳອາດມີສອງຕົວເລືອກທີ່ແຍກກັນດ້ວຍເຄື່ອງໝາຍຈຸດ:\n"
"- ຖ້າມີ [code]\"show_builtin\"[/code], ການກະທຳອິນພຸດທີ່ມີມາໃຫ້ນຳແລ້ວ (built-in) "
"ຈະຖືກລວມເຂົ້າໃນການເລືອກ.\n"
"- ຖ້າມີ [code]\"loose_mode\"[/code], ໂໝດແບບຫຼົມ (loose mode) ຈະຖືກເປີດໃຊ້. "
"ນີ້ຊ່ວຍໃຫ້ສາມາດປ້ອນຊື່ການກະທຳໃດໆກໍໄດ້ ເຖິງແມ່ນວ່າມັນຈະບໍ່ມີຢູ່ໃນ input map ກໍຕາມ."

msgid ""
"Like [constant PROPERTY_HINT_FILE], but the property is stored as a raw path, "
"not UID. That means the reference will be broken if you move the file. "
"Consider using [constant PROPERTY_HINT_FILE] when possible."
msgstr ""
"ຄ້າຍຄືກັບ [constant PROPERTY_HINT_FILE], ແຕ່ຈະເກັບເປັນເສັ້ນທາງແບບດິບ (raw path) ບໍ່ແມ່ນ "
"UID. ນັ້ນໝາຍຄວາມວ່າລິ້ງຈະເພ (broken) ຖ້າເຈົ້າຍ້າຍໄຟລ໌. ແນະນຳໃຫ້ໃຊ້ [constant "
"PROPERTY_HINT_FILE] ຖ້າເປັນໄປໄດ້."

msgid "Represents the size of the [enum PropertyHint] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ [enum PropertyHint] enum."

msgid ""
"The property is not stored, and does not display in the editor. This is the "
"default for non-exported properties."
msgstr "ຄຸນສົມບັດຈະບໍ່ຖືກເກັບໄວ້ ແລະ ບໍ່ສະແດງໃນຕົວແກ້ໄຂ. ນີ້ແມ່ນຄ່າເລີ່ມຕົ້ນສຳລັບຄຸນສົມບັດທີ່ບໍ່ໄດ້ export."

msgid ""
"The property is serialized and saved in the scene file (default for exported "
"properties)."
msgstr ""
"ຄຸນສົມບັດຈະຖືກຈັດລຽງ (serialized) ແລະ ບັນທຶກລົງໃນໄຟລ໌ສາກ ( scene file) "
"(ຄ່າເລີ່ມຕົ້ນສຳລັບຄຸນສົມບັດທີ່ export)."

msgid ""
"The property is shown in the [EditorInspector] (default for exported "
"properties)."
msgstr "ຄຸນສົມບັດຈະຖືກສະແດງໃນ [EditorInspector] (ຄ່າເລີ່ມຕົ້ນສຳລັບຄຸນສົມບັດທີ່ export)."

msgid "The property is excluded from the class reference."
msgstr "ຄຸນສົມບັດນີ້ຈະຖືກຍົກເວັ້ນຈາກເອກະສານອ້າງອີງຄລາດ (class reference)."

msgid "The property can be checked in the [EditorInspector]."
msgstr "ຄຸນສົມບັດສາມາດໝາຍຕິກເລືອກໄດ້ໃນ [EditorInspector]."

msgid "The property is checked in the [EditorInspector]."
msgstr "ຄຸນສົມບັດຖືກໝາຍຕິກເລືອກໄວ້ໃນ [EditorInspector]."

msgid "Used to group properties together in the editor. See [EditorInspector]."
msgstr "ໃຊ້ເພື່ອລວມກຸ່ມຄຸນສົມບັດເຂົ້າກັນໃນຕົວແກ້ໄຂ. ເບິ່ງ [EditorInspector]."

msgid "Used to categorize properties together in the editor."
msgstr "ໃຊ້ເພື່ອຈັດໝວດໝູ່ຄຸນສົມບັດເຂົ້າກັນໃນຕົວແກ້ໄຂ."

msgid ""
"Used to group properties together in the editor in a subgroup (under a "
"group). See [EditorInspector]."
msgstr ""
"ໃຊ້ເພື່ອລວມກຸ່ມຄຸນສົມບັດເຂົ້າກັນໃນກຸ່ມຍ່ອຍ (subgroup) ໃນຕົວແກ້ໄຂ. ເບິ່ງ [EditorInspector]."

msgid ""
"The property is a bitfield, i.e. it contains multiple flags represented as "
"bits."
msgstr "ຄຸນສົມບັດແມ່ນ bitfield, ເຊິ່ງປະກອບດ້ວຍຫຼາຍແຟລັກ (flag) ທີ່ສະແດງໃນຮູບແບບບິດ."

msgid "The property does not save its state in [PackedScene]."
msgstr "ຄຸນສົມບັດຈະບໍ່ບັນທຶກສະຖານະຂອງມັນໄວ້ໃນ [PackedScene]."

msgid "Editing the property prompts the user for restarting the editor."
msgstr "ການແກ້ໄຂຄຸນສົມບັດນີ້ຈະແຈ້ງເຕືອນໃຫ້ຜູ້ໃຊ້ເລີ່ມຕົ້ນຕົວແກ້ໄຂໃໝ່ (restart editor)."

msgid ""
"The property is a script variable. [constant PROPERTY_USAGE_SCRIPT_VARIABLE] "
"can be used to distinguish between exported script variables from built-in "
"variables (which don't have this usage flag). By default, [constant "
"PROPERTY_USAGE_SCRIPT_VARIABLE] is [b]not[/b] applied to variables that are "
"created by overriding [method Object._get_property_list] in a script."
msgstr ""
"ຄຸນສົມບັດນີ້ແມ່ນຕົວປ່ຽນສະຄຣິບ (script variable). [constant "
"PROPERTY_USAGE_SCRIPT_VARIABLE] ສາມາດໃຊ້ເພື່ອຈຳແນກລະຫວ່າງຕົວປ່ຽນສະຄຣິບທີ່ສົ່ງອອກ "
"(exported script variables) ຈາກຕົວປ່ຽນທີ່ມີມາໃຫ້ນຳແລ້ວ (ເຊິ່ງບໍ່ມີທຸງການໃຊ້ນີ້). "
"ໂດຍມາດຕະຖານແລ້ວ, [constant PROPERTY_USAGE_SCRIPT_VARIABLE] ຈະ [b]ບໍ່[/b] "
"ຖືກນຳໃຊ້ກັບຕົວປ່ຽນທີ່ສ້າງຂຶ້ນໂດຍການຂຽນທັບ [method Object._get_property_list] ໃນສະຄຣິບ."

msgid ""
"The property value of type [Object] will be stored even if its value is "
"[code]null[/code]."
msgstr ""
"ຄ່າຂອງຄຸນສົມບັດປະເພດ [Object] ຈະຖືກບັນທຶກໄວ້ ເຖິງວ່າຄ່າຂອງມັນຈະເປັນ [code]null[/code] ກໍຕາມ."

msgid "If this property is modified, all inspector fields will be refreshed."
msgstr "ຖ້າຄຸນສົມບັດນີ້ຖືກແກ້ໄຂ, ທຸກຊ່ອງໃນ inspector ຈະຖືກຣີເຟຣຊໃໝ່."

msgid "This flag is not used by the engine."
msgstr "ແຟລັກນີ້ບໍ່ໄດ້ຖືກໃຊ້ໂດຍເອນຈິນ."

msgid ""
"The property is a variable of enum type, i.e. it only takes named integer "
"constants from its associated enumeration."
msgstr ""
"ຄຸນສົມບັດນີ້ແມ່ນຕົວປ່ຽນປະເພດ enum, ເຊິ່ງມັນຈະຮັບເອົາພຽງແຕ່ຄ່າຄົງທີ່ຈຳນວນເຕັມທີ່ມີຊື່ຈາກ enumeration "
"ທີ່ກ່ຽວຂ້ອງເທົ່ານັ້ນ."

msgid ""
"If property has [code]nil[/code] as default value, its type will be [Variant]."
msgstr "ຖ້າຄຸນສົມບັດມີຄ່າ [code]nil[/code] ເປັນຄ່າເລີ່ມຕົ້ນ, ປະເພດຂອງມັນຈະເປັນ [Variant]."

msgid ""
"The property is the element count of a property array, i.e. a list of groups "
"of related properties. Properties defined with this usage also need a "
"specific [code]class_name[/code] field in the form of [code]label,prefix[/"
"code]. The field may also include additional comma-separated options:\n"
"- [code]page_size=N[/code]: Overrides [member EditorSettings.interface/"
"inspector/max_array_dictionary_items_per_page] for this array.\n"
"- [code]add_button_text=text[/code]: The text displayed by the \"Add "
"Element\" button.\n"
"- [code]static[/code]: The elements can't be re-arranged.\n"
"- [code]const[/code]: New elements can't be added.\n"
"- [code]numbered[/code]: An index will appear next to each element.\n"
"- [code]unfoldable[/code]: The array can't be folded.\n"
"- [code]swap_method=method_name[/code]: The method that will be called when "
"two elements switch places. The method should take 2 [int] parameters, which "
"will be indices of the elements being swapped.\n"
"Note that making a full-fledged property array requires boilerplate code "
"involving [method Object._get_property_list]."
msgstr ""
"ຄຸນສົມບັດນີ້ແມ່ນຈຳນວນອົງປະກອບຂອງອາເຣຄຸນສົມບັດ (property array), ເຊັ່ນ: "
"ລາຍການຂອງກຸ່ມຄຸນສົມບັດທີ່ກ່ຽວຂ້ອງກັນ. ຄຸນສົມບັດທີ່ກຳນົດດ້ວຍການໃຊ້ງານນີ້ຍັງຕ້ອງການຟີລ "
"[code]class_name[/code] ສະເພາະໃນຮູບແບບ [code]label,prefix[/code]. "
"ຟີລດັ່ງກ່າວຍັງສາມາດລວມເອົາຕົວເລືອກເພີ່ມເຕີມທີ່ຂັ້ນດ້ວຍຈຸດ:\n"
"- [code]page_size=N[/code]: ຂຽນທັບ [member EditorSettings.interface/inspector/"
"max_array_dictionary_items_per_page] ສຳລັບອາເຣນີ້.\n"
"- [code]add_button_text=text[/code]: ຂໍ້ຄວາມທີ່ຈະສະແດງໃນປຸ່ມ \"Add Element\".\n"
"- [code]static[/code]: ອົງປະກອບຕ່າງໆບໍ່ສາມາດຈັດລຽງໃໝ່ໄດ້.\n"
"- [code]const[/code]: ບໍ່ສາມາດເພີ່ມອົງປະກອບໃໝ່ໄດ້.\n"
"- [code]numbered[/code]: ດັດຊະນີຈະປາກົດຂຶ້ນຂ້າງແຕ່ລະອົງປະກອບ.\n"
"- [code]unfoldable[/code]: ອາເຣບໍ່ສາມາດພັບໄດ້.\n"
"- [code]swap_method=method_name[/code]: ເມທອດທີ່ຈະຖືກເອີ້ນເມື່ອສອງອົງປະກອບສະຫຼັບບ່ອນກັນ. "
"ເມທອດຄວນຮັບ 2 ພາຣາມິເຕີ [int], ເຊິ່ງຈະເປັນດັດຊະນີຂອງອົງປະກອບທີ່ຖືກສະຫຼັບ.\n"
"ໝາຍເຫດ: ການສ້າງອາເຣຄຸນສົມບັດແບບເຕັມຮູບແບບນັ້ນຕ້ອງໃຊ້ boilerplate code ທີ່ກ່ຽວຂ້ອງກັບ [method "
"Object._get_property_list]."

msgid ""
"When duplicating a resource with [method Resource.duplicate], and this flag "
"is set on a property of that resource, the property should always be "
"duplicated, regardless of the [code]subresources[/code] bool parameter."
msgstr ""
"ເມື່ອເຮັດສຳເນົາຊັບພະຍາກອນດ້ວຍ [method Resource.duplicate], "
"ແລະທຸງນີ້ຖືກຕັ້ງໄວ້ໃນຄຸນສົມບັດຂອງຊັບພະຍາກອນນັ້ນ, ຄຸນສົມບັດຈະຖືກເຮັດສຳເນົາສະເໝີ ໂດຍບໍ່ສົນໃຈພາຣາມິເຕີບູນີນ "
"[code]subresources[/code]."

msgid ""
"When duplicating a resource with [method Resource.duplicate], and this flag "
"is set on a property of that resource, the property should never be "
"duplicated, regardless of the [code]subresources[/code] bool parameter."
msgstr ""
"ເມື່ອເຮັດສຳເນົາຊັບພະຍາກອນດ້ວຍ [method Resource.duplicate], "
"ແລະທຸງນີ້ຖືກຕັ້ງໄວ້ໃນຄຸນສົມບັດຂອງຊັບພະຍາກອນນັ້ນ, ຄຸນສົມບັດຈະບໍ່ຖືກເຮັດສຳເນົາຈັກເທື່ອ "
"ໂດຍບໍ່ສົນໃຈພາຣາມິເຕີບູນີນ [code]subresources[/code]."

msgid ""
"The property is only shown in the editor if modern renderers are supported "
"(the Compatibility rendering method is excluded)."
msgstr ""
"ຄຸນສົມບັດນີ້ຈະຖືກສະແດງໃນຕົວແກ້ໄຂກໍຕໍ່ເມື່ອຮອງຮັບຕົວປະມວນຜົນການສະແດງຜົນ (renderer) "
"ແບບທັນສະໄໝເທົ່ານັ້ນ (ບໍ່ລວມວິທີການສະແດງຜົນແບບ Compatibility)."

msgid ""
"The [NodePath] property will always be relative to the scene's root. Mostly "
"useful for local resources."
msgstr ""
"ຄຸນສົມບັດ [NodePath] ຈະທຽບກັບຮາກ (root) ຂອງສາກສະເໝີ. "
"ສ່ວນຫຼາຍແມ່ນມີປະໂຫຍດສຳລັບຊັບພະຍາກອນພາຍໃນ (local resources)."

msgid ""
"Use when a resource is created on the fly, i.e. the getter will always return "
"a different instance. [ResourceSaver] needs this information to properly save "
"such resources."
msgstr ""
"ໃຊ້ເມື່ອຊັບພະຍາກອນຖືກສ້າງຂຶ້ນໃນທັນທີ (on the fly), ເຊິ່ງໝາຍຄວາມວ່າ getter ຈະສົ່ງຄືນ instance "
"ທີ່ແຕກຕ່າງກັນສະເໝີ. [ResourceSaver] ຕ້ອງການຂໍ້ມູນນີ້ເພື່ອບັນທຶກຊັບພະຍາກອນດັ່ງກ່າວໄດ້ຢ່າງຖືກຕ້ອງ."

msgid ""
"Inserting an animation key frame of this property will automatically "
"increment the value, allowing to easily keyframe multiple values in a row."
msgstr ""
"ການແຊກຄີເຟຣມແອນິເມຊັນ (animation key frame) ຂອງຄຸນສົມບັດນີ້ຈະເພີ່ມຄ່າໃຫ້ໂດຍອັດຕະໂນມັດ, "
"ເຊິ່ງຊ່ວຍໃຫ້ການເຮັດ keyframe ຫຼາຍໆຄ່າຕິດຕໍ່ກັນໄດ້ງ່າຍຂຶ້ນ."

msgid ""
"When this property is a [Resource] and base object is a [Node], a resource "
"instance will be automatically created whenever the node is created in the "
"editor."
msgstr ""
"ເມື່ອຄຸນສົມບັດນີ້ເປັນ [Resource] ແລະ ອອບເຈັກພື້ນຖານເປັນ [Node], instance "
"ຂອງຊັບພະຍາກອນຈະຖືກສ້າງຂຶ້ນໂດຍອັດຕະໂນມັດທຸກຄັ້ງທີ່ໂນດຖືກສ້າງໃນຕົວແກ້ໄຂ."

msgid ""
"The property is considered a basic setting and will appear even when advanced "
"mode is disabled. Used for project settings."
msgstr ""
"ຄຸນສົມບັດນີ້ຖືວ່າເປັນການຕັ້ງຄ່າພື້ນຖານ ແລະ ຈະປາກົດຂຶ້ນເຖິງແມ່ນວ່າໂໝດຂັ້ນສູງ (advanced mode) "
"ຈະຖືກປິດໄວ້ກໍຕາມ. ໃຊ້ສຳລັບການຕັ້ງຄ່າໂປຣເຈັກ."

msgid "The property is read-only in the [EditorInspector]."
msgstr "ຄຸນສົມບັດນີ້ແມ່ນແບບອ່ານໄດ້ຢ່າງດຽວ (read-only) ໃນ [EditorInspector]."

msgid ""
"An export preset property with this flag contains confidential information "
"and is stored separately from the rest of the export preset configuration."
msgstr ""
"ຄຸນສົມບັດການຕັ້ງຄ່າການສົ່ງອອກ (export preset) ທີ່ມີທຸງນີ້ ຈະມີຂໍ້ມູນລັບ ແລະ "
"ຖືກເກັບແຍກຕ່າງຫາກຈາກສ່ວນທີ່ເຫຼືອຂອງການຕັ້ງຄ່າການສົ່ງອອກ."

msgid "Default usage (storage and editor)."
msgstr "ການໃຊ້ງານມາດຕະຖານ (ບ່ອນເກັບຂໍ້ມູນ ແລະ ຕົວແກ້ໄຂ)."

msgid "Default usage but without showing the property in the editor (storage)."
msgstr "ການໃຊ້ງານມາດຕະຖານ ແຕ່ບໍ່ສະແດງຄຸນສົມບັດໃນຕົວແກ້ໄຂ (ບ່ອນເກັບຂໍ້ມູນຢ່າງດຽວ)."

msgid "Flag for a normal method."
msgstr "ແຟລັກສຳລັບເມັດທອດປົກກະຕິ."

msgid "Flag for an editor method."
msgstr "ແຟລັກສຳລັບເມັດທອດຂອງຕົວແກ້ໄຂ."

msgid "Flag for a constant method."
msgstr "ແຟລັກສຳລັບເມັດທອດຄ່າຄົງທີ່ (constant)."

msgid "Flag for a virtual method."
msgstr "ແຟລັກສຳລັບເມັດທອດສະເໝືອນ (virtual)."

msgid "Flag for a method with a variable number of arguments."
msgstr "ແຟລັກສຳລັບເມັດທອດທີ່ມີຈຳນວນອາຄິວເມນ (argument) ບໍ່ຄົງທີ່."

msgid "Flag for a static method."
msgstr "ແຟລັກສຳລັບເມັດທອດສະແຕຕິກ (static)."

msgid ""
"Used internally. Allows to not dump core virtual methods (such as [method "
"Object._notification]) to the JSON API."
msgstr ""
"ໃຊ້ພາຍໃນ. ຊ່ວຍໃຫ້ບໍ່ຕ້ອງ dump ວິທີການສະເໝືອນຫຼັກ (ເຊັ່ນ [method Object._notification]) "
"ໄປຍັງ JSON API."

msgid ""
"Flag for a virtual method that is required. In GDScript, this flag is set for "
"abstract functions."
msgstr ""
"ທຸງສຳລັບວິທີການສະເໝືອນ (virtual method) ທີ່ຈຳເປັນຕ້ອງມີ. ໃນ GDScript, "
"ທຸງນີ້ຖືກຕັ້ງໄວ້ສຳລັບຟັງຊັນນາມມະທຳ (abstract functions)."

msgid "Default method flags (normal)."
msgstr "ແຟລັກເມັດທອດມາດຕະຖານ (ປົກກະຕິ)."

msgid "Maximum value of an 8-bit unsigned integer."
msgstr "ຄ່າສູງສຸດຂອງເລກຈຳນວນເຕັມບວກ 8 ບິດ (8-bit unsigned integer)."

msgid "Maximum value of a 16-bit unsigned integer."
msgstr "ຄ່າສູງສຸດຂອງເລກຈຳນວນເຕັມບວກ 16 ບິດ (16-bit unsigned integer)."

msgid "Maximum value of a 32-bit unsigned integer."
msgstr "ຄ່າສູງສຸດຂອງເລກຈຳນວນເຕັມບວກ 32 ບິດ (32-bit unsigned integer)."

msgid "Minimum value of an 8-bit signed integer."
msgstr "ຄ່າຕ່ຳສຸດຂອງເລກຈຳນວນເຕັມມີເຄື່ອງໝາຍ 8 ບິດ (8-bit signed integer)."

msgid "Maximum value of an 8-bit signed integer."
msgstr "ຄ່າສູງສຸດຂອງຈຳນວນຖ້ວນ 8-ບິດ ແບບມີເຄື່ອງໝາຍ."

msgid "Minimum value of a 16-bit signed integer."
msgstr "ຄ່າຕ່ຳສຸດຂອງຈຳນວນຖ້ວນ 16-ບິດ ແບບມີເຄື່ອງໝາຍ."

msgid "Maximum value of a 16-bit signed integer."
msgstr "ຄ່າສູງສຸດຂອງຈຳນວນຖ້ວນ 16-ບິດ ແບບມີເຄື່ອງໝາຍ."

msgid "Minimum value of a 32-bit signed integer."
msgstr "ຄ່າຕ່ຳສຸດຂອງຈຳນວນຖ້ວນ 32-ບິດ ແບບມີເຄື່ອງໝາຍ."

msgid "Maximum value of a 32-bit signed integer."
msgstr "ຄ່າສູງສຸດຂອງຈຳນວນຖ້ວນ 32-ບິດ ແບບມີເຄື່ອງໝາຍ."

msgid "Minimum value of a 64-bit signed integer."
msgstr "ຄ່າຕ່ຳສຸດຂອງຈຳນວນຖ້ວນ 64-ບິດ ແບບມີເຄື່ອງໝາຍ."

msgid "Maximum value of a 64-bit signed integer."
msgstr "ຄ່າສູງສຸດຂອງຈຳນວນຖ້ວນ 64-ບິດ ແບບມີເຄື່ອງໝາຍ."

