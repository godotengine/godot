msgid "Greater-than sign ([code]>[/code]) key."
msgstr "ປຸ່ມເຄື່ອງໝາຍໃຫຍ່ກວ່າ ([code]>[/code])."

msgid "Question mark ([code]?[/code]) key."
msgstr "ປຸ່ມເຄື່ອງໝາຍຖາມ ([code]?[/code])."

msgid "At sign ([code]@[/code]) key."
msgstr "ປຸ່ມເຄື່ອງໝາຍແອັດ ([code]@[/code])."

