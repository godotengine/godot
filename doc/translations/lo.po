msgstr "ເວີຊັນທີ່ຂຽນທັບໄດ້ຂອງ [method PhysicsServer2D.body_add_collision_exception]."

msgid ""
"Overridable version of [method "
"PhysicsServer2D.body_add_constant_central_force]."
msgstr ""
