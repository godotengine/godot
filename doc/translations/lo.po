msgid "Represents the size of the [enum DataFormat] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum DataFormat]."

msgid "Vertex shader barrier mask."
msgstr "ໜ້າກາກສິ່ງກີດຂວາງ (barrier mask) ຂອງ vertex shader."

msgid "Fragment shader barrier mask."
msgstr "ໜ້າກາກສິ່ງກີດຂວາງ ຂອງ fragment shader."

msgid "Compute barrier mask."
msgstr "ໜ້າກາກສິ່ງກີດຂວາງ ຂອງ compute."

msgid "Transfer barrier mask."
msgstr "ໜ້າກາກສິ່ງກີດຂວາງ ຂອງ transfer."

msgid ""
"Raster barrier mask (vertex and fragment). Equivalent to "
"[code]BARRIER_MASK_VERTEX | BARRIER_MASK_FRAGMENT[/code]."
msgstr ""
"ໜ້າກາກສິ່ງກີດຂວາງ ຂອງ raster (vertex ແລະ fragment). ທຽບເທົ່າກັບ "
"[code]BARRIER_MASK_VERTEX | BARRIER_MASK_FRAGMENT[/code]."

msgid "Barrier mask for all types (vertex, fragment, compute, transfer)."
msgstr "ໜ້າກາກສິ່ງກີດຂວາງ ສຳລັບທຸກປະເພດ (vertex, fragment, compute, transfer)."

msgid "No barrier for any type."
msgstr "ບໍ່ມີສິ່ງກີດຂວາງ ສຳລັບປະເພດໃດເລີຍ."

msgid "1-dimensional texture."
msgstr "ເທັກເຈີ 1 ມິຕິ."

msgid "2-dimensional texture."
msgstr "ເທັກເຈີ 2 ມິຕິ."

msgid "3-dimensional texture."
msgstr "ເທັກເຈີ 3 ມິຕິ."

msgid "[Cubemap] texture."
msgstr "ເທັກເຈີ [Cubemap]."

msgid "Array of 1-dimensional textures."
msgstr "ອາເຣ (Array) ຂອງເທັກເຈີ 1 ມິຕິ."

msgid "Array of 2-dimensional textures."
msgstr "ອາເຣ ຂອງເທັກເຈີ 2 ມິຕິ."

msgid "Array of [Cubemap] textures."
msgstr "ອາເຣ ຂອງເທັກເຈີ [Cubemap]."

msgid "Represents the size of the [enum TextureType] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum TextureType]."

msgid ""
"Perform 1 texture sample (this is the fastest but lowest-quality for "
"antialiasing)."
msgstr "ທຳການແຊມເປີ້ນ (sample) ເທັກເຈີ 1 ຄັ້ງ (ໄວທີ່ສຸດ ແຕ່ຄຸນນະພາບຕ່ຳສຸດສຳລັບ antialiasing)."

msgid "Perform 2 texture samples."
msgstr "ທຳການແຊມເປີ້ນເທັກເຈີ 2 ຄັ້ງ."

msgid "Perform 4 texture samples."
msgstr "ທຳການແຊມເປີ້ນເທັກເຈີ 4 ຄັ້ງ."

msgid ""
"Perform 8 texture samples. Not supported on mobile GPUs (including Apple "
"Silicon)."
msgstr "ທຳການແຊມເປີ້ນເທັກເຈີ 8 ຄັ້ງ. ບໍ່ຮອງຮັບໃນ GPU ມືຖື (ລວມທັງ Apple Silicon)."

msgid ""
"Perform 16 texture samples. Not supported on mobile GPUs and many desktop "
"GPUs."
msgstr "ທຳການແຊມເປີ້ນເທັກເຈີ 16 ຄັ້ງ. ບໍ່ຮອງຮັບໃນ GPU ມືຖື ແລະ GPU ຄອມພິວເຕີຕັ້ງໂຕະຫຼາຍລຸ້ນ."

msgid "Perform 32 texture samples. Not supported on most GPUs."
msgstr "ທຳການແຊມເປີ້ນເທັກເຈີ 32 ຄັ້ງ. ບໍ່ຮອງຮັບໃນ GPU ສ່ວນໃຫຍ່."

msgid ""
"Perform 64 texture samples (this is the slowest but highest-quality for "
"antialiasing). Not supported on most GPUs."
msgstr ""
"ທຳການແຊມເປີ້ນເທັກເຈີ 64 ຄັ້ງ (ຊ້າທີ່ສຸດ ແຕ່ຄຸນນະພາບສູງສຸດສຳລັບ antialiasing). ບໍ່ຮອງຮັບໃນ GPU "
"ສ່ວນໃຫຍ່."

msgid "Represents the size of the [enum TextureSamples] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum TextureSamples]."

msgid "Texture can be sampled."
msgstr "ເທັກເຈີສາມາດຖືກແຊມເປີ້ນໄດ້."

msgid "Texture can be used as a color attachment in a framebuffer."
msgstr "ເທັກເຈີສາມາດໃຊ້ເປັນ color attachment ໃນ framebuffer ໄດ້."

msgid "Texture can be used as a depth/stencil attachment in a framebuffer."
msgstr "ເທັກເຈີສາມາດໃຊ້ເປັນ depth/stencil attachment ໃນ framebuffer ໄດ້."

msgid ""
"Texture can be used as a depth/stencil resolve attachment in a framebuffer."
msgstr "ເທັກເຈີສາມາດໃຊ້ເປັນ depth/stencil resolve attachment ໃນ framebuffer ໄດ້."

msgid ""
"Texture can be used as a [url=https://registry.khronos.org/vulkan/specs/1.3-"
"extensions/html/vkspec.html#descriptorsets-storageimage]storage image[/url]."
msgstr ""
"ເທັກເຈີສາມາດໃຊ້ເປັນ [url=https://registry.khronos.org/vulkan/specs/1.3-extensions/"
"html/vkspec.html#descriptorsets-storageimage]storage image[/url] ໄດ້."

msgid ""
"Texture can be used as a [url=https://registry.khronos.org/vulkan/specs/1.3-"
"extensions/html/vkspec.html#descriptorsets-storageimage]storage image[/url] "
"with support for atomic operations."
msgstr ""
"ເທັກເຈີສາມາດໃຊ້ເປັນ [url=https://registry.khronos.org/vulkan/specs/1.3-extensions/"
"html/vkspec.html#descriptorsets-storageimage]storage image[/url] "
"ທີ່ຮອງຮັບການປະຕິບັດການແບບອາໂຕມິກ (atomic operations) ໄດ້."

msgid ""
"Texture can be read back on the CPU using [method texture_get_data] faster "
"than without this bit, since it is always kept in the system memory."
msgstr ""
"ເທັກເຈີສາມາດຖືກອ່ານຄືນໂດຍ CPU ຜ່ານ [method texture_get_data] ໄດ້ໄວກວ່າການບໍ່ມີບິດນີ້, "
"ເນື່ອງຈາກມັນຈະຖືກເກັບໄວ້ໃນໜ່ວຍຄວາມຈຳຂອງລະບົບສະເໝີ."

msgid "Texture can be updated using [method texture_update]."
msgstr "ເທັກເຈີສາມາດຖືກອັບເດດຜ່ານ [method texture_update] ໄດ້."

msgid "Texture can be a source for [method texture_copy]."
msgstr "ເທັກເຈີສາມາດເປັນຕົ້ນທາງ (source) ສຳລັບ [method texture_copy] ໄດ້."

msgid "Texture can be a destination for [method texture_copy]."
msgstr "ເທັກເຈີສາມາດເປັນປາຍທາງ (destination) ສຳລັບ [method texture_copy] ໄດ້."

msgid ""
"Texture can be used as a [url=https://registry.khronos.org/vulkan/specs/1.3-"
"extensions/html/vkspec.html#descriptorsets-inputattachment]input attachment[/"
"url] in a framebuffer."
msgstr ""
"ເທັກເຈີສາມາດໃຊ້ເປັນ [url=https://registry.khronos.org/vulkan/specs/1.3-extensions/"
"html/vkspec.html#descriptorsets-inputattachment]input attachment[/url] ໃນ "
"framebuffer ໄດ້."

msgid "Return the sampled value as-is."
msgstr "ສົ່ງຄືນຄ່າທີ່ແຊມເປີ້ນໄດ້ຕາມສະພາບເດີມ."

msgid "Always return [code]0.0[/code] when sampling."
msgstr "ສົ່ງຄືນ [code]0.0[/code] ສະເໝີເມື່ອທຳການແຊມເປີ້ນ."

msgid "Always return [code]1.0[/code] when sampling."
msgstr "ສົ່ງຄືນ [code]1.0[/code] ສະເໝີເມື່ອທຳການແຊມເປີ້ນ."

msgid "Sample the red color channel."
msgstr "ແຊມເປີ້ນຊ່ອງສັນຍານສີແດງ."

msgid "Sample the green color channel."
msgstr "ສຸ່ມຕົວຢ່າງຊ່ອງສີຂຽວ."

msgid "Sample the blue color channel."
msgstr "ສຸ່ມຕົວຢ່າງຊ່ອງສີຟ້າ."

msgid "Sample the alpha channel."
msgstr "ສຸ່ມຕົວຢ່າງຊ່ອງອານຟາ (Alpha)."

msgid "Represents the size of the [enum TextureSwizzle] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum TextureSwizzle]."

msgid "2-dimensional texture slice."
msgstr "ຊິ້ນສ່ວນເທັກເຈີ (texture) ແບບ 2 ມິຕິ."

msgid "Cubemap texture slice."
msgstr "ຊິ້ນສ່ວນເທັກເຈີ (texture) ແບບ Cubemap."

msgid "3-dimensional texture slice."
msgstr "ຊິ້ນສ່ວນເທັກເຈີ (texture) ແບບ 3 ມິຕິ."

msgid ""
"Nearest-neighbor sampler filtering. Sampling at higher resolutions than the "
"source will result in a pixelated look."
msgstr ""
"ການກອງແບບສຸ່ມຕົວຢ່າງເພື່ອນບ້ານທີ່ໃກ້ທີ່ສຸດ. "
"ການສຸ່ມຕົວຢ່າງດ້ວຍຄວາມລະອຽດທີ່ສູງກວ່າຕົ້ນສະບັບຈະເຮັດໃຫ້ເຫັນເປັນເມັດພິກເຊວ."

msgid ""
"Bilinear sampler filtering. Sampling at higher resolutions than the source "
"will result in a blurry look."
msgstr ""
"ການກອງແບບສຸ່ມຕົວຢ່າງ Bilinear. ການສຸ່ມຕົວຢ່າງດ້ວຍຄວາມລະອຽດທີ່ສູງກວ່າຕົ້ນສະບັບຈະເຮັດໃຫ້ພາບເບຼີ."

msgid "Sample with repeating enabled."
msgstr "ສຸ່ມຕົວຢ່າງໂດຍເປີດໃຊ້ການເຮັດຊ້ຳ."

msgid ""
"Sample with mirrored repeating enabled. When sampling outside the [code][0.0, "
"1.0][/code] range, return a mirrored version of the sampler. This mirrored "
"version is mirrored again if sampling further away, with the pattern "
"repeating indefinitely."
msgstr ""
"ສຸ່ມຕົວຢ່າງໂດຍເປີດໃຊ້ການເຮັດຊ້ຳແບບສະທ້ອນເງົາ. ເມື່ອສຸ່ມຕົວຢ່າງຢູ່ນອກໄລຍະ [code][0.0, 1.0][/"
"code], ຈະສົ່ງຄ່າເວີຊັນທີ່ສະທ້ອນເງົາຂອງຕົວຢ່າງນັ້ນກັບຄືນມາ. "
"ເວີຊັນທີ່ສະທ້ອນເງົານີ້ຈະຖືກສະທ້ອນຄືນອີກຄັ້ງຫາກສຸ່ມຕົວຢ່າງໄກອອກໄປ, ໂດຍຮູບແບບຈະເຮັດຊ້ຳໄປເລື້ອຍໆ."

msgid ""
"Sample with repeating disabled. When sampling outside the [code][0.0, 1.0][/"
"code] range, return the color of the last pixel on the edge."
msgstr ""
"ສຸ່ມຕົວຢ່າງໂດຍປິດການເຮັດຊ້ຳ. ເມື່ອສຸ່ມຕົວຢ່າງຢູ່ນອກໄລຍະ [code][0.0, 1.0][/code], "
"ຈະສົ່ງຄ່າສີຂອງພິກເຊວສຸດທ້າຍຢູ່ຂອບກັບຄືນມາ."

msgid ""
"Sample with repeating disabled. When sampling outside the [code][0.0, 1.0][/"
"code] range, return the specified [member RDSamplerState.border_color]."
msgstr ""
"ສຸ່ມຕົວຢ່າງໂດຍປິດການເຮັດຊ້ຳ. ເມື່ອສຸ່ມຕົວຢ່າງຢູ່ນອກໄລຍະ [code][0.0, 1.0][/code], ຈະສົ່ງຄ່າ "
"[member RDSamplerState.border_color] ທີ່ກຳນົດໄວ້ກັບຄືນມາ."

msgid ""
"Sample with mirrored repeating enabled, but only once. When sampling in the "
"[code][-1.0, 0.0][/code] range, return a mirrored version of the sampler. "
"When sampling outside the [code][-1.0, 1.0][/code] range, return the color of "
"the last pixel on the edge."
msgstr ""
"ສຸ່ມຕົວຢ່າງໂດຍເປີດໃຊ້ການເຮັດຊ້ຳແບບສະທ້ອນເງົາ ແຕ່ພຽງຄັ້ງດຽວເທົ່ານັ້ນ. ເມື່ອສຸ່ມຕົວຢ່າງໃນໄລຍະ [code]"
"[-1.0, 0.0][/code], ຈະສົ່ງຄ່າເວີຊັນທີ່ສະທ້ອນເງົາກັບຄືນມາ. ເມື່ອສຸ່ມຕົວຢ່າງຢູ່ນອກໄລຍະ [code]"
"[-1.0, 1.0][/code], ຈະສົ່ງຄ່າສີຂອງພິກເຊວສຸດທ້າຍຢູ່ຂອບກັບຄືນມາ."

msgid "Represents the size of the [enum SamplerRepeatMode] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum SamplerRepeatMode]."

msgid ""
"Return a floating-point transparent black color when sampling outside the "
"[code][0.0, 1.0][/code] range. Only effective if the sampler repeat mode is "
"[constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr ""
"ສົ່ງຄ່າສີດຳໂປ່ງໃສແບບເລກທົດສະນິຍົມ ເມື່ອສຸ່ມຕົວຢ່າງຢູ່ນອກໄລຍະ [code][0.0, 1.0][/code]. "
"ຈະມີຜົນກໍຕໍ່ເມື່ອໂໝດການເຮັດຊ້ຳຂອງຕົວຢ່າງແມ່ນ [constant "
"SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."

msgid ""
"Return an integer transparent black color when sampling outside the [code]"
"[0.0, 1.0][/code] range. Only effective if the sampler repeat mode is "
"[constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr ""
"ສົ່ງຄ່າສີດຳໂປ່ງໃສແບບເລກຖ້ວນ ເມື່ອສຸ່ມຕົວຢ່າງຢູ່ນອກໄລຍະ [code][0.0, 1.0][/code]. "
"ຈະມີຜົນກໍຕໍ່ເມື່ອໂໝດການເຮັດຊ້ຳຂອງຕົວຢ່າງແມ່ນ [constant "
"SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."

msgid ""
"Return a floating-point opaque black color when sampling outside the [code]"
"[0.0, 1.0][/code] range. Only effective if the sampler repeat mode is "
"[constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr ""
"ສົ່ງຄ່າສີດຳທຶບແສງແບບເລກທົດສະນິຍົມ ເມື່ອສຸ່ມຕົວຢ່າງຢູ່ນອກໄລຍະ [code][0.0, 1.0][/code]. "
"ຈະມີຜົນກໍຕໍ່ເມື່ອໂໝດການເຮັດຊ້ຳຂອງຕົວຢ່າງແມ່ນ [constant "
"SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."

msgid ""
"Return an integer opaque black color when sampling outside the [code][0.0, "
"1.0][/code] range. Only effective if the sampler repeat mode is [constant "
"SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr ""
"ສົ່ງຄ່າສີດຳທຶບແສງແບບເລກຖ້ວນ ເມື່ອສຸ່ມຕົວຢ່າງຢູ່ນອກໄລຍະ [code][0.0, 1.0][/code]. "
"ຈະມີຜົນກໍຕໍ່ເມື່ອໂໝດການເຮັດຊ້ຳຂອງຕົວຢ່າງແມ່ນ [constant "
"SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."

msgid ""
"Return a floating-point opaque white color when sampling outside the [code]"
"[0.0, 1.0][/code] range. Only effective if the sampler repeat mode is "
"[constant SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr ""
"ສົ່ງຄ່າສີຂາວທຶບແສງແບບເລກທົດສະນິຍົມ ເມື່ອສຸ່ມຕົວຢ່າງຢູ່ນອກໄລຍະ [code][0.0, 1.0][/code]. "
"ຈະມີຜົນກໍຕໍ່ເມື່ອໂໝດການເຮັດຊ້ຳຂອງຕົວຢ່າງແມ່ນ [constant "
"SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."

msgid ""
"Return an integer opaque white color when sampling outside the [code][0.0, "
"1.0][/code] range. Only effective if the sampler repeat mode is [constant "
"SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."
msgstr ""
"ສົ່ງຄ່າສີຂາວທຶບແສງແບບເລກຖ້ວນ ເມື່ອສຸ່ມຕົວຢ່າງຢູ່ນອກໄລຍະ [code][0.0, 1.0][/code]. "
"ຈະມີຜົນກໍຕໍ່ເມື່ອໂໝດການເຮັດຊ້ຳຂອງຕົວຢ່າງແມ່ນ [constant "
"SAMPLER_REPEAT_MODE_CLAMP_TO_BORDER]."

msgid "Represents the size of the [enum SamplerBorderColor] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum SamplerBorderColor]."

msgid ""
"Vertex attribute addressing is a function of the vertex. This is used to "
"specify the rate at which vertex attributes are pulled from buffers."
msgstr ""
"ການກຳນົດຕຳແໜ່ງຄຸນລັກສະນະຈຸດ (Vertex attribute addressing) ແມ່ນຂຶ້ນກັບຈຸດ (vertex). "
"ສິ່ງນີ້ໃຊ້ເພື່ອລະບຸອັດຕາທີ່ຄຸນລັກສະນະຈຸດຖືກດຶງມາຈາກບັບເຟີ (buffers)."

msgid ""
"Vertex attribute addressing is a function of the instance index. This is used "
"to specify the rate at which vertex attributes are pulled from buffers."
msgstr ""
"ການກຳນົດຕຳແໜ່ງຄຸນລັກສະນະຈຸດແມ່ນຂຶ້ນກັບດັດຊະນີຂອງອິນສະແຕນຊ໌ (instance index). "
"ສິ່ງນີ້ໃຊ້ເພື່ອລະບຸອັດຕາທີ່ຄຸນລັກສະນະຈຸດຖືກດຶງມາຈາກບັບເຟີ."

msgid ""
"Index buffer in 16-bit unsigned integer format. This limits the maximum index "
"that can be specified to [code]65535[/code]."
msgstr ""
"ບັບເຟີດັດຊະນີ (Index buffer) ໃນຮູບແບບເລກຖ້ວນບໍ່ມີເຄື່ອງໝາຍ 16-ບິດ. "
"ສິ່ງນີ້ຈຳກັດດັດຊະນີສູງສຸດທີ່ສາມາດລະບຸໄດ້ຄື [code]65535[/code]."

msgid ""
"Index buffer in 32-bit unsigned integer format. This limits the maximum index "
"that can be specified to [code]4294967295[/code]."
msgstr ""
"ບັບເຟີດັດຊະນີ (Index buffer) ໃນຮູບແບບເລກຖ້ວນບໍ່ມີເຄື່ອງໝາຍ 32-ບິດ. "
"ສິ່ງນີ້ຈຳກັດດັດຊະນີສູງສຸດທີ່ສາມາດລະບຸໄດ້ຄື [code]4294967295[/code]."

msgid ""
"Optionally, set this flag if you wish to use [method "
"buffer_get_device_address] functionality. You must first check the GPU "
"supports it:\n"
"[codeblocks]\n"
"[gdscript]\n"
"rd = RenderingServer.get_rendering_device()\n"
"\n"
"if rd.has_feature(RenderingDevice.SUPPORTS_BUFFER_DEVICE_ADDRESS):\n"
"\tstorage_buffer = rd.storage_buffer_create(bytes.size(), bytes, "
"RenderingDevice.STORAGE_BUFFER_USAGE_SHADER_DEVICE_ADDRESS)\n"
"\tstorage_buffer_address = rd.buffer_get_device_address(storage_buffer)\n"
"[/gdscript]\n"
"[/codeblocks]"
msgstr ""
"ເລືອກຕັ້ງຄ່າທຸງ (flag) ນີ້ຫາກທ່ານຕ້ອງການໃຊ້ຟັງຊັນ [method buffer_get_device_address]. "
"ທ່ານຕ້ອງກວດສອບກ່ອນວ່າ GPU ຮອງຮັບມັນຫຼືບໍ່:\n"
"[codeblocks]\n"
"[gdscript]\n"
"rd = RenderingServer.get_rendering_device()\n"
"\n"
"if rd.has_feature(RenderingDevice.SUPPORTS_BUFFER_DEVICE_ADDRESS):\n"
"\tstorage_buffer = rd.storage_buffer_create(bytes.size(), bytes, "
"RenderingDevice.STORAGE_BUFFER_USAGE_SHADER_DEVICE_ADDRESS)\n"
"\tstorage_buffer_address = rd.buffer_get_device_address(storage_buffer)\n"
"[/gdscript]\n"
"[/codeblocks]"

msgid ""
"Set this flag so that it is created as storage. This is useful if Compute "
"Shaders need access (for reading or writing) to the buffer, e.g. skeletal "
"animations are processed in Compute Shaders which need access to vertex "
"buffers, to be later consumed by vertex shaders as part of the regular "
"rasterization pipeline."
msgstr ""
"ຕັ້ງຄ່າທຸງນີ້ເພື່ອໃຫ້ມັນຖືກສ້າງເປັນບ່ອນເກັບຂໍ້ມູນ (storage). ສິ່ງນີ້ມີປະໂຫຍດຫາກ Compute Shaders "
"ຕ້ອງການເຂົ້າເຖິງ (ເພື່ອອ່ານ ຫຼື ຂຽນ) ບັບເຟີ, ເຊັ່ນ: ອານີເມຊັນໂຄງກະດູກທີ່ຖືກປະມວນຜົນໃນ Compute "
"Shaders ເຊິ່ງຕ້ອງການເຂົ້າເຖິງບັບເຟີຈຸດ (vertex buffers), ເພື່ອໄປໃຊ້ຕໍ່ໃນ vertex shaders "
"ໃນຂັ້ນຕອນການເຣັນເດີປົກກະຕິ."

msgid "Allows the acceleration structure to be updated after it has been built."
msgstr "ອະນຸຍາດໃຫ້ອັບເດດໂຄງສ້າງການເລັ່ງໄດ້ ຫຼັງຈາກທີ່ມັນຖືກສ້າງແລ້ວ."

msgid ""
"Allows the acceleration structure to be compacted to reduce memory usage "
"after it has been built."
msgstr "ອະນຸຍາດໃຫ້ບີບອັດໂຄງສ້າງການເລັ່ງເພື່ອຫຼຸດການໃຊ້ໜ່ວຍຄວາມຈຳ ຫຼັງຈາກທີ່ມັນຖືກສ້າງແລ້ວ."

msgid ""
"Prioritizes ray traversal performance over build performance when building "
"the acceleration structure."
msgstr ""
"ເນັ້ນປະສິດທິພາບການເຄື່ອນທີ່ຂອງລັງສີ (ray traversal) ຫຼາຍກວ່າປະສິດທິພາບການສ້າງ "
"ເມື່ອສ້າງໂຄງສ້າງການເລັ່ງ."

msgid ""
"Prioritizes build performance over ray traversal performance when building "
"the acceleration structure."
msgstr "ເນັ້ນປະສິດທິພາບການສ້າງຫຼາຍກວ່າປະສິດທິພາບການເຄື່ອນທີ່ຂອງລັງສີ ເມື່ອສ້າງໂຄງສ້າງການເລັ່ງ."

msgid ""
"Reduces the memory usage of the acceleration structure, potentially at the "
"cost of reduced ray traversal performance."
msgstr ""
"ຫຼຸດການໃຊ້ໜ່ວຍຄວາມຈຳຂອງໂຄງສ້າງການເລັ່ງ, ເຊິ່ງອາດຈະເຮັດໃຫ້ປະສິດທິພາບການເຄື່ອນທີ່ຂອງລັງສີຫຼຸດລົງ."

msgid "An opaque geometry does not invoke the any hit shaders."
msgstr "ເລຂາຄະນິດແບບທຶບແສງຈະບໍ່ຮຽກໃຊ້ any hit shaders."

msgid ""
"This geometry only calls the any hit shader a single time for each primitive."
msgstr "ເລຂາຄະນິດນີ້ຈະຮຽກໃຊ້ any hit shader ພຽງຄັ້ງດຽວສຳລັບແຕ່ລະຮູບຊົງພື້ນຖານ (primitive)."

msgid "Disables triangle face culling for this instance during ray traversal."
msgstr ""
"ປິດການຄັດອອກໜ້າສາມລ່ຽມ (triangle face culling) "
"ສຳລັບອິນສະແຕນຊ໌ນີ້ໃນລະຫວ່າງການເຄື່ອນທີ່ຂອງລັງສີ."

msgid ""
"Flips the triangle facing direction for this instance during ray traversal."
msgstr "ປີ້ນທິດທາງການຫັນໜ້າຂອງສາມລ່ຽມສຳລັບອິນສະແຕນຊ໌ນີ້ໃນລະຫວ່າງການເຄື່ອນທີ່ຂອງລັງສີ."

msgid ""
"Forces all geometries in this instance to be treated as opaque, preventing "
"any hit shaders from being invoked."
msgstr ""
"ບັງຄັບໃຫ້ເລຂາຄະນິດທັງໝົດໃນອິນສະແຕນຊ໌ນີ້ຖືກປະຕິບັດຄືກັບແບບທຶບແສງ, ເພື່ອປ້ອງກັນບໍ່ໃຫ້ any hit shaders "
"ຖືກຮຽກໃຊ້."

msgid ""
"Forces all geometries in this instance to be treated as non-opaque, allowing "
"any hit shaders to be invoked."
msgstr ""
"ບັງຄັບໃຫ້ເລຂາຄະນິດທັງໝົດໃນອິນສະແຕນຊ໌ນີ້ຖືກປະຕິບັດຄືກັບແບບບໍ່ທຶບແສງ, ເພື່ອອະນຸຍາດໃຫ້ any hit shaders "
"ຖືກຮຽກໃຊ້."

msgid "Sampler uniform."
msgstr "ຢູນິຟອມຕົວສຸ່ມຕົວຢ່າງ (Sampler uniform)."

msgid "Sampler uniform with a texture."
msgstr "ຢູນິຟອມຕົວສຸ່ມຕົວຢ່າງທີ່ມີເທັກເຈີ."

msgid "Texture uniform."
msgstr "ຢູນິຟອມເທັກເຈີ."

msgid "Image uniform."
msgstr "ຢູນິຟອມຮູບພາບ."

msgid "Texture buffer uniform."
msgstr "ຢູນິຟອມບັບເຟີເທັກເຈີ."

msgid "Sampler uniform with a texture buffer."
msgstr "ຢູນິຟອມຕົວສຸ່ມຕົວຢ່າງທີ່ມີບັບເຟີເທັກເຈີ."

msgid "Image buffer uniform."
msgstr "ຢູນິຟອມບັບເຟີຮູບພາບ."

msgid "Uniform buffer uniform."
msgstr "ຢູນິຟອມບັບເຟີຢູນິຟອມ (Uniform buffer uniform)."

msgid ""
"[url=https://vkguide.dev/docs/chapter-4/storage_buffers/]Storage buffer[/url] "
"uniform."
msgstr ""
"ຢູນິຟອມ [url=https://vkguide.dev/docs/chapter-4/storage_buffers/]ບັບເຟີເກັບຂໍ້ມູນ "
"(Storage buffer)[/url]."

msgid "Input attachment uniform."
msgstr "ຢູນິຟອມສິ່ງທີ່ແນບມານຳ (Input attachment uniform)."

msgid ""
"Same as UNIFORM_TYPE_UNIFORM_BUFFER but for buffers created with "
"BUFFER_CREATION_DYNAMIC_PERSISTENT_BIT.\n"
"[b]Note:[/b] This flag is not available to GD users due to being too "
"dangerous (i.e. wrong usage can result in visual glitches).\n"
"It's exposed in case GD users receive a buffer created with such flag from "
"Godot."
msgstr ""
"ຄືກັນກັບ UNIFORM_TYPE_UNIFORM_BUFFER ແຕ່ສຳລັບບັບເຟີທີ່ສ້າງດ້ວຍ "
"BUFFER_CREATION_DYNAMIC_PERSISTENT_BIT.\n"
"[b]ໝາຍເຫດ:[/b] ທຸງນີ້ບໍ່ມີໃຫ້ຜູ້ໃຊ້ GD ໃຊ້ເນື່ອງຈາກມັນອັນຕະລາຍເກີນໄປ (ເຊັ່ນ: "
"ການໃຊ້ຜິດວິທີອາດເຮັດໃຫ້ເກີດຄວາມຜິດພາດທາງພາບ).\n"
"ມັນຖືກເປີດເຜີຍໄວ້ໃນກໍລະນີທີ່ຜູ້ໃຊ້ GD ໄດ້ຮັບບັບເຟີທີ່ສ້າງຂຶ້ນດ້ວຍທຸງດັ່ງກ່າວຈາກ Godot."

msgid ""
"Same as UNIFORM_TYPE_STORAGE_BUFFER but for buffers created with "
"BUFFER_CREATION_DYNAMIC_PERSISTENT_BIT.\n"
"[b]Note:[/b] This flag is not available to GD users due to being too "
"dangerous (i.e. wrong usage can result in visual glitches).\n"
"It's exposed in case GD users receive a buffer created with such flag from "
"Godot."
msgstr ""
"ຄືກັນກັບ UNIFORM_TYPE_STORAGE_BUFFER ແຕ່ສຳລັບບັບເຟີທີ່ສ້າງດ້ວຍ "
"BUFFER_CREATION_DYNAMIC_PERSISTENT_BIT.\n"
"[b]ໝາຍເຫດ:[/b] ທຸງນີ້ບໍ່ມີໃຫ້ຜູ້ໃຊ້ GD ໃຊ້ເນື່ອງຈາກມັນອັນຕະລາຍເກີນໄປ.\n"
"ມັນຖືກເປີດເຜີຍໄວ້ໃນກໍລະນີທີ່ຜູ້ໃຊ້ GD ໄດ້ຮັບບັບເຟີທີ່ສ້າງຂຶ້ນດ້ວຍທຸງດັ່ງກ່າວຈາກ Godot."

msgid "Acceleration structure uniform."
msgstr "ຢູນິຟອມໂຄງສ້າງການເລັ່ງ (Acceleration structure uniform)."

msgid "Represents the size of the [enum UniformType] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum UniformType]."

msgid ""
"Point rendering primitive (with constant size, regardless of distance from "
"camera)."
msgstr "ຮູບຊົງພື້ນຖານການເຣັນເດີແບບຈຸດ (ດ້ວຍຂະໜາດຄົງທີ່, ບໍ່ວ່າຈະຢູ່ຫ່າງຈາກກ້ອງເທົ່າໃດ)."

msgid ""
"Line list rendering primitive. Lines are drawn separated from each other."
msgstr "ຮູບຊົງພື້ນຖານການເຣັນເດີແບບລາຍການເສັ້ນ. ເສັ້ນຈະຖືກແຕ້ມແຍກອອກຈາກກັນ."

msgid ""
"[url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/"
"vkspec.html#drawing-line-lists-with-adjacency]Line list rendering primitive "
"with adjacency.[/url]\n"
"[b]Note:[/b] Adjacency is only useful with geometry shaders, which Godot does "
"not expose."
msgstr ""
"[url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/"
"vkspec.html#drawing-line-lists-with-"
"adjacency]ຮູບຊົງພື້ນຖານການເຣັນເດີແບບລາຍການເສັ້ນທີ່ມີສ່ວນຮ່ວມ (adjacency).[/url]\n"
"[b]ໝາຍເຫດ:[/b] ສ່ວນຮ່ວມແມ່ນມີປະໂຫຍດກັບ geometry shaders ເທົ່ານັ້ນ, ເຊິ່ງ Godot "
"ບໍ່ໄດ້ເປີດໃຫ້ໃຊ້."

msgid ""
"Line strip rendering primitive. Lines drawn are connected to the previous "
"vertex."
msgstr "ຮູບຊົງພື້ນຖານການເຣັນເດີແບບເສັ້ນຕໍ່ເນື່ອງ. ເສັ້ນທີ່ແຕ້ມຈະເຊື່ອມຕໍ່ກັບຈຸດກ່ອນໜ້າ."

msgid ""
"[url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/"
"vkspec.html#drawing-line-strips-with-adjacency]Line strip rendering primitive "
"with adjacency.[/url]\n"
"[b]Note:[/b] Adjacency is only useful with geometry shaders, which Godot does "
"not expose."
msgstr ""
"[url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/"
"vkspec.html#drawing-line-strips-with-"
"adjacency]ຮູບຊົງພື້ນຖານການເຣັນເດີແບບເສັ້ນຕໍ່ເນື່ອງທີ່ມີສ່ວນຮ່ວມ.[/url]\n"
"[b]ໝາຍເຫດ:[/b] ສ່ວນຮ່ວມແມ່ນມີປະໂຫຍດກັບ geometry shaders ເທົ່ານັ້ນ."

msgid ""
"Triangle list rendering primitive. Triangles are drawn separated from each "
"other."
msgstr "ຮູບຊົງພື້ນຖານການເຣັນເດີແບບລາຍການສາມລ່ຽມ. ສາມລ່ຽມຈະຖືກແຕ້ມແຍກອອກຈາກກັນ."

msgid ""
"[url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/"
"vkspec.html#drawing-triangle-lists-with-adjacency]Triangle list rendering "
"primitive with adjacency.[/url]\n"
"[b]Note:[/b] Adjacency is only useful with geometry shaders, which Godot does "
"not expose."
msgstr ""
"[url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/"
"vkspec.html#drawing-triangle-lists-with-"
"adjacency]ຮູບຊົງພື້ນຖານການເຣັນເດີແບບລາຍການສາມລ່ຽມທີ່ມີສ່ວນຮ່ວມ.[/url]\n"
"[b]ໝາຍເຫດ:[/b] ສ່ວນຮ່ວມແມ່ນມີປະໂຫຍດກັບ geometry shaders ເທົ່ານັ້ນ."

msgid ""
"Triangle strip rendering primitive. Triangles drawn are connected to the "
"previous triangle."
msgstr "ຮູບຊົງພື້ນຖານການເຣັນເດີແບບສາມລ່ຽມຕໍ່ເນື່ອງ. ສາມລ່ຽມທີ່ແຕ້ມຈະເຊື່ອມຕໍ່ກັບສາມລ່ຽມກ່ອນໜ້າ."

msgid ""
"[url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/"
"vkspec.html#drawing-triangle-strips-with-adjacency]Triangle strip rendering "
"primitive with adjacency.[/url]\n"
"[b]Note:[/b] Adjacency is only useful with geometry shaders, which Godot does "
"not expose."
msgstr ""
"[url=https://registry.khronos.org/vulkan/specs/1.3-extensions/html/"
"vkspec.html#drawing-triangle-strips-with-"
"adjacency]ຮູບຊົງພື້ນຖານການເຣັນເດີແບບສາມລ່ຽມຕໍ່ເນື່ອງທີ່ມີສ່ວນຮ່ວມ.[/url]\n"
"[b]ໝາຍເຫດ:[/b] ສ່ວນຮ່ວມແມ່ນມີປະໂຫຍດກັບ geometry shaders ເທົ່ານັ້ນ."

msgid ""
"Triangle strip rendering primitive with [i]primitive restart[/i] enabled. "
"Triangles drawn are connected to the previous triangle, but a primitive "
"restart index can be specified before drawing to create a second triangle "
"strip after the specified index.\n"
"[b]Note:[/b] Only compatible with indexed draws."
msgstr ""
"ຮູບຊົງພື້ນຖານການເຣັນເດີແບບສາມລ່ຽມຕໍ່ເນື່ອງ ໂດຍເປີດໃຊ້ [i]primitive restart[/i]. "
"ສາມລ່ຽມທີ່ແຕ້ມຈະເຊື່ອມຕໍ່ກັບສາມລ່ຽມກ່ອນໜ້າ, "
"ແຕ່ສາມາດລະບຸດັດຊະນີເລີ່ມຕົ້ນໃໝ່ກ່ອນການແຕ້ມເພື່ອສ້າງແຖບສາມລ່ຽມທີສອງຫຼັງຈາກດັດຊະນີທີ່ລະບຸ.\n"
"[b]ໝາຍເຫດ:[/b] ໃຊ້ໄດ້ກັບການແຕ້ມແບບມີດັດຊະນີ (indexed draws) ເທົ່ານັ້ນ."

msgid ""
"Tessellation patch rendering primitive. Only useful with tessellation "
"shaders, which can be used to deform these patches."
msgstr ""
"ຮູບຊົງພື້ນຖານການເຣັນເດີແບບ Tessellation patch. ມີປະໂຫຍດກັບ tessellation shaders "
"ເທົ່ານັ້ນ, ເຊິ່ງສາມາດໃຊ້ເພື່ອປ່ຽນຮູບຊົງຂອງ patches ເຫຼົ່ານີ້."

msgid "Represents the size of the [enum RenderPrimitive] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum RenderPrimitive]."

msgid "Do not use polygon front face or backface culling."
msgstr "ບໍ່ໃຊ້ການຄັດອອກໜ້າດ້ານໜ້າ ຫຼື ດ້ານຫຼັງຂອງໂພລີກອນ."

msgid ""
"Use polygon frontface culling (faces pointing towards the camera are hidden)."
msgstr "ໃຊ້ການຄັດອອກໜ້າດ້ານໜ້າຂອງໂພລີກອນ (ໜ້າທີ່ຫັນມາຫາກ້ອງຈະຖືກເຊື່ອງໄວ້)."

msgid ""
"Use polygon backface culling (faces pointing away from the camera are hidden)."
msgstr "ໃຊ້ການຄັດອອກໜ້າດ້ານຫຼັງຂອງໂພລີກອນ (ໜ້າທີ່ຫັນອອກຈາກກ້ອງຈະຖືກເຊື່ອງໄວ້)."

msgid ""
"Clockwise winding order to determine which face of a polygon is its front "
"face."
msgstr "ລຳດັບການວຽນຕາມເຂັມໂມງ ເພື່ອກຳນົດວ່າດ້ານໃດຂອງໂພລີກອນແມ່ນດ້ານໜ້າ."

msgid ""
"Counter-clockwise winding order to determine which face of a polygon is its "
"front face."
msgstr "ລຳດັບການວຽນທວນເຂັມໂມງ ເພື່ອກຳນົດວ່າດ້ານໃດຂອງໂພລີກອນແມ່ນດ້ານໜ້າ."

msgid "Keep the current stencil value."
msgstr "ຮັກສາຄ່າສະເຕນຊິລ (stencil) ປັດຈຸບັນໄວ້."

msgid "Set the stencil value to [code]0[/code]."
msgstr "ຕັ້ງຄ່າສະເຕນຊິລເປັນ [code]0[/code]."

msgid "Replace the existing stencil value with the new one."
msgstr "ແທນບ່ອນຄ່າສະເຕນຊິລເດີມດ້ວຍຄ່າໃໝ່."

msgid ""
"Increment the existing stencil value and clamp to the maximum representable "
"unsigned value if reached. Stencil bits are considered as an unsigned integer."
msgstr ""
"ເພີ່ມຄ່າສະເຕນຊິລເດີມ ແລະ ຈຳກັດ (clamp) ໄວ້ທີ່ຄ່າສູງສຸດຫາກຮອດແລ້ວ. "
"ບິດຂອງສະເຕນຊິລຖືກນັບເປັນເລກຖ້ວນບໍ່ມີເຄື່ອງໝາຍ."

msgid ""
"Decrement the existing stencil value and clamp to the minimum value if "
"reached. Stencil bits are considered as an unsigned integer."
msgstr ""
"ຫຼຸດຄ່າສະເຕນຊິລເດີມ ແລະ ຈຳກັດໄວ້ທີ່ຄ່າຕໍ່າສຸດຫາກຮອດແລ້ວ. ບິດຂອງສະເຕນຊິລຖືກນັບເປັນເລກຖ້ວນບໍ່ມີເຄື່ອງໝາຍ."

msgid "Bitwise-invert the existing stencil value."
msgstr "ປີ້ນຄ່າບິດ (Bitwise-invert) ຂອງຄ່າສະເຕນຊິລເດີມ."

msgid ""
"Increment the stencil value and wrap around to [code]0[/code] if reaching the "
"maximum representable unsigned. Stencil bits are considered as an unsigned "
"integer."
msgstr ""
"ເພີ່ມຄ່າສະເຕນຊິລ ແລະ ວົນກັບມາທີ່ [code]0[/code] ຫາກຮອດຄ່າສູງສຸດ. "
"ບິດຂອງສະເຕນຊິລຖືກນັບເປັນເລກຖ້ວນບໍ່ມີເຄື່ອງໝາຍ."

msgid ""
"Decrement the stencil value and wrap around to the maximum representable "
"unsigned if reaching the minimum. Stencil bits are considered as an unsigned "
"integer."
msgstr ""
"ຫຼຸດຄ່າສະເຕນຊິລ ແລະ ວົນກັບມາທີ່ຄ່າສູງສຸດຫາກຮອດຄ່າຕໍ່າສຸດ. ບິດຂອງສະເຕນຊິລຖືກນັບເປັນເລກຖ້ວນບໍ່ມີເຄື່ອງໝາຍ."

msgid "Represents the size of the [enum StencilOperation] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum StencilOperation]."

msgid "\"Never\" comparison (opposite of [constant COMPARE_OP_ALWAYS])."
msgstr ""
"ການປຽບທຽບແບບ \"ບໍ່ມີທາງ\" (Never) (ກົງກັນຂ້າມກັບ [constant COMPARE_OP_ALWAYS])."

msgid "\"Less than\" comparison."
msgstr "ການປຽບທຽບແບບ \"ນ້ອຍກວ່າ\"."

msgid "\"Equal\" comparison."
msgstr "ການປຽບທຽບແບບ \"ເທົ່າກັບ\"."

msgid "\"Less than or equal\" comparison."
msgstr "ການປຽບທຽບແບບ \"ນ້ອຍກວ່າ ຫຼື ເທົ່າກັບ\"."

msgid "\"Greater than\" comparison."
msgstr "ການປຽບທຽບແບບ \"ຫຼາຍກວ່າ\"."

msgid "\"Not equal\" comparison."
msgstr "ການປຽບທຽບແບບ \"ບໍ່ເທົ່າກັບ\"."

msgid "\"Greater than or equal\" comparison."
msgstr "ການປຽບທຽບແບບ \"ຫຼາຍກວ່າ ຫຼື ເທົ່າກັບ\"."

msgid "\"Always\" comparison (opposite of [constant COMPARE_OP_NEVER])."
msgstr "ການປຽບທຽບແບບ \"ສະເໝີ\" (Always) (ກົງກັນຂ້າມກັບ [constant COMPARE_OP_NEVER])."

msgid "Represents the size of the [enum CompareOperator] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum CompareOperator]."

msgid ""
"Clear logic operation (result is always [code]0[/code]). See also [constant "
"LOGIC_OP_SET]."
msgstr ""
"ການເຮັດວຽກທາງໂລຈິກແບບ Clear (ຜົນລັບແມ່ນ [code]0[/code] ສະເໝີ). ເບິ່ງ [constant "
"LOGIC_OP_SET] ຕື່ມ."

msgid "AND logic operation."
msgstr "ການເຮັດວຽກທາງໂລຈິກແບບ AND."

msgid ""
"AND logic operation with the [i]destination[/i] operand being inverted. See "
"also [constant LOGIC_OP_AND_INVERTED]."
msgstr ""
"ການເຮັດວຽກທາງໂລຈິກແບບ AND ໂດຍທີ່ຕົວຖືກດຳເນີນການ [i]ປາຍທາງ (destination)[/i] ຖືກປີ້ນຄ່າ. "
"ເບິ່ງ [constant LOGIC_OP_AND_INVERTED] ຕື່ມ."

msgid ""
"Copy logic operation (keeps the [i]source[/i] value as-is). See also "
"[constant LOGIC_OP_COPY_INVERTED] and [constant LOGIC_OP_NO_OP]."
msgstr ""
"ການເຮັດວຽກທາງໂລຈິກແບບ Copy (ຮັກສາຄ່າ [i]ຕົ້ນທາງ (source)[/i] ໄວ້ຄືເກົ່າ). ເບິ່ງ [constant "
"LOGIC_OP_COPY_INVERTED] ແລະ [constant LOGIC_OP_NO_OP] ຕື່ມ."

msgid ""
"AND logic operation with the [i]source[/i] operand being inverted. See also "
"[constant LOGIC_OP_AND_REVERSE]."
msgstr ""
"ການເຮັດວຽກທາງໂລຈິກແບບ AND ໂດຍທີ່ຕົວຖືກດຳເນີນການ [i]ຕົ້ນທາງ[/i] ຖືກປີ້ນຄ່າ. ເບິ່ງ [constant "
"LOGIC_OP_AND_REVERSE] ຕື່ມ."

msgid ""
"No-op logic operation (keeps the [i]destination[/i] value as-is). See also "
"[constant LOGIC_OP_COPY]."
msgstr ""
"ການເຮັດວຽກທາງໂລຈິກແບບ No-op (ຮັກສາຄ່າ [i]ປາຍທາງ[/i] ໄວ້ຄືເກົ່າ). ເບິ່ງ [constant "
"LOGIC_OP_COPY] ຕື່ມ."

msgid "Exclusive or (XOR) logic operation."
msgstr "ການເຮັດວຽກທາງໂລຈິກແບບ Exclusive or (XOR)."

msgid "OR logic operation."
msgstr "ການເຮັດວຽກທາງໂລຈິກແບບ OR."

msgid "Not-OR (NOR) logic operation."
msgstr "ການເຮັດວຽກທາງໂລຈິກແບບ Not-OR (NOR)."

msgid "Not-XOR (XNOR) logic operation."
msgstr "ການເຮັດວຽກທາງໂລຈິກແບບ Not-XOR (XNOR)."

msgid "Invert logic operation."
msgstr "ການເຮັດວຽກທາງໂລຈິກແບບປີ້ນຄ່າ (Invert)."

msgid ""
"OR logic operation with the [i]destination[/i] operand being inverted. See "
"also [constant LOGIC_OP_OR_REVERSE]."
msgstr ""
"ການເຮັດວຽກທາງໂລຈິກແບບ OR ໂດຍທີ່ຕົວຖືກດຳເນີນການ [i]ປາຍທາງ[/i] ຖືກປີ້ນຄ່າ. ເບິ່ງ [constant "
"LOGIC_OP_OR_REVERSE] ຕື່ມ."

msgid ""
"NOT logic operation (inverts the value). See also [constant LOGIC_OP_COPY]."
msgstr "ການເຮັດວຽກທາງໂລຈິກແບບ NOT (ປີ້ນຄ່າ). ເບິ່ງ [constant LOGIC_OP_COPY] ຕື່ມ."

msgid ""
"OR logic operation with the [i]source[/i] operand being inverted. See also "
"[constant LOGIC_OP_OR_REVERSE]."
msgstr ""
"ການເຮັດວຽກທາງໂລຈິກແບບ OR ໂດຍທີ່ຕົວຖືກດຳເນີນການ [i]ຕົ້ນທາງ[/i] ຖືກປີ້ນຄ່າ. ເບິ່ງ [constant "
"LOGIC_OP_OR_REVERSE] ຕື່ມ."

msgid "Not-AND (NAND) logic operation."
msgstr "ການເຮັດວຽກທາງໂລຈິກແບບ Not-AND (NAND)."

msgid ""
"SET logic operation (result is always [code]1[/code]). See also [constant "
"LOGIC_OP_CLEAR]."
msgstr ""
"ການເຮັດວຽກທາງໂລຈິກແບບ SET (ຜົນລັບແມ່ນ [code]1[/code] ສະເໝີ). ເບິ່ງ [constant "
"LOGIC_OP_CLEAR] ຕື່ມ."

msgid "Represents the size of the [enum LogicOperation] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum LogicOperation]."

msgid "Constant [code]0.0[/code] blend factor."
msgstr "ປັດໄຈການປະສົມ (blend factor) ຄ່າຄົງທີ່ [code]0.0[/code]."

msgid "Constant [code]1.0[/code] blend factor."
msgstr "ປັດໄຈການປະສົມຄ່າຄົງທີ່ [code]1.0[/code]."

msgid ""
"Color blend factor is [code]source color[/code]. Alpha blend factor is "
"[code]source alpha[/code]."
msgstr ""
"ປັດໄຈການປະສົມສີແມ່ນ [code]source color[/code]. ປັດໄຈການປະສົມອານຟາແມ່ນ [code]source "
"alpha[/code]."

msgid ""
"Color blend factor is [code]1.0 - source color[/code]. Alpha blend factor is "
"[code]1.0 - source alpha[/code]."
msgstr ""
"ປັດໄຈການປະສົມສີແມ່ນ [code]1.0 - source color[/code]. ປັດໄຈການປະສົມອານຟາແມ່ນ "
"[code]1.0 - source alpha[/code]."

msgid ""
"Color blend factor is [code]destination color[/code]. Alpha blend factor is "
"[code]destination alpha[/code]."
msgstr ""
"ປັດໄຈການປະສົມສີແມ່ນ [code]destination color[/code]. ປັດໄຈການປະສົມອານຟາແມ່ນ "
"[code]destination alpha[/code]."

msgid ""
"Color blend factor is [code]1.0 - destination color[/code]. Alpha blend "
"factor is [code]1.0 - destination alpha[/code]."
msgstr ""
"ປັດໄຈການປະສົມສີແມ່ນ [code]1.0 - destination color[/code]. ປັດໄຈການປະສົມອານຟາແມ່ນ "
"[code]1.0 - destination alpha[/code]."

msgid "Color and alpha blend factor is [code]source alpha[/code]."
msgstr "ປັດໄຈການປະສົມສີ ແລະ ອານຟາແມ່ນ [code]source alpha[/code]."

msgid "Color and alpha blend factor is [code]1.0 - source alpha[/code]."
msgstr "ປັດໄຈການປະສົມສີ ແລະ ອານຟາແມ່ນ [code]1.0 - source alpha[/code]."

msgid "Color and alpha blend factor is [code]destination alpha[/code]."
msgstr "ປັດໄຈການປະສົມສີ ແລະ ອານຟາແມ່ນ [code]destination alpha[/code]."

msgid "Color and alpha blend factor is [code]1.0 - destination alpha[/code]."
msgstr "ປັດໄຈການປະສົມສີ ແລະ ອານຟາແມ່ນ [code]1.0 - destination alpha[/code]."

msgid ""
"Color blend factor is [code]blend constant color[/code]. Alpha blend factor "
"is [code]blend constant alpha[/code] (see [method "
"draw_list_set_blend_constants])."
msgstr ""
"ປັດໄຈການປະສົມສີແມ່ນ [code]blend constant color[/code]. ປັດໄຈການປະສົມອານຟາແມ່ນ "
"[code]blend constant alpha[/code] (ເບິ່ງ [method "
"draw_list_set_blend_constants])."

msgid ""
"Color blend factor is [code]1.0 - blend constant color[/code]. Alpha blend "
"factor is [code]1.0 - blend constant alpha[/code] (see [method "
"draw_list_set_blend_constants])."
msgstr ""
"ປັດໄຈການປະສົມສີແມ່ນ [code]1.0 - blend constant color[/code]. ປັດໄຈການປະສົມອານຟາແມ່ນ "
"[code]1.0 - blend constant alpha[/code] (ເບິ່ງ [method "
"draw_list_set_blend_constants])."

msgid ""
"Color and alpha blend factor is [code]blend constant alpha[/code] (see "
"[method draw_list_set_blend_constants])."
msgstr ""
"ປັດໄຈການປະສົມສີ ແລະ ອານຟາແມ່ນ [code]blend constant alpha[/code] (ເບິ່ງ [method "
"draw_list_set_blend_constants])."

msgid ""
"Color and alpha blend factor is [code]1.0 - blend constant alpha[/code] (see "
"[method draw_list_set_blend_constants])."
msgstr ""
"ປັດໄຈການປະສົມສີ ແລະ ອານຟາແມ່ນ [code]1.0 - blend constant alpha[/code] (ເບິ່ງ "
"[method draw_list_set_blend_constants])."

msgid ""
"Color blend factor is [code]min(source alpha, 1.0 - destination alpha)[/"
"code]. Alpha blend factor is [code]1.0[/code]."
msgstr ""
"ປັດໄຈການປະສົມສີແມ່ນ [code]min(source alpha, 1.0 - destination alpha)[/code]. "
"ປັດໄຈການປະສົມອານຟາແມ່ນ [code]1.0[/code]."

msgid ""
"Color blend factor is [code]second source color[/code]. Alpha blend factor is "
"[code]second source alpha[/code]. Only relevant for dual-source blending."
msgstr ""
"ປັດໄຈການປະສົມສີແມ່ນ [code]second source color[/code]. ປັດໄຈການປະສົມອານຟາແມ່ນ "
"[code]second source alpha[/code]. ກ່ຽວຂ້ອງສະເພາະກັບການປະສົມແບບສອງຕົ້ນທາງ (dual-"
"source blending)."

msgid ""
"Color blend factor is [code]1.0 - second source color[/code]. Alpha blend "
"factor is [code]1.0 - second source alpha[/code]. Only relevant for dual-"
"source blending."
msgstr ""
"ປັດໄຈການປະສົມສີແມ່ນ [code]1.0 - second source color[/code]. ປັດໄຈການປະສົມອານຟາແມ່ນ "
"[code]1.0 - second source alpha[/code]. ກ່ຽວຂ້ອງສະເພາະກັບການປະສົມແບບສອງຕົ້ນທາງ."

msgid ""
"Color and alpha blend factor is [code]second source alpha[/code]. Only "
"relevant for dual-source blending."
msgstr ""
"ປັດໄຈການປະສົມສີ ແລະ ອານຟາແມ່ນ [code]second source alpha[/code]. "
"ກ່ຽວຂ້ອງສະເພາະກັບການປະສົມແບບສອງຕົ້ນທາງ."

msgid ""
"Color and alpha blend factor is [code]1.0 - second source alpha[/code]. Only "
"relevant for dual-source blending."
msgstr ""
"ປັດໄຈການປະສົມສີ ແລະ ອານຟາແມ່ນ [code]1.0 - second source alpha[/code]. "
"ກ່ຽວຂ້ອງສະເພາະກັບການປະສົມແບບສອງຕົ້ນທາງ."

msgid "Represents the size of the [enum BlendFactor] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum BlendFactor]."

msgid "Additive blending operation ([code]source + destination[/code])."
msgstr ""
"ການດຳເນີນການປະສົມແບບບວກ (Additive blending) ([code]source + destination[/code])."

msgid "Subtractive blending operation ([code]source - destination[/code])."
msgstr ""
"ການດຳເນີນການປະສົມແບບລົບ (Subtractive blending) ([code]source - destination[/"
"code])."

msgid ""
"Reverse subtractive blending operation ([code]destination - source[/code])."
msgstr "ການດຳເນີນການປະສົມແບບລົບປີ້ນກັບ ([code]destination - source[/code])."

msgid "Minimum blending operation (keep the lowest value of the two)."
msgstr "ການດຳເນີນການປະສົມແບບຄ່າຕໍ່າສຸດ (ຮັກສາຄ່າທີ່ຕໍ່າທີ່ສຸດຂອງທັງສອງ)."

msgid "Maximum blending operation (keep the highest value of the two)."
msgstr "ການດຳເນີນການປະສົມແບບຄ່າສູງສຸດ (ຮັກສາຄ່າທີ່ສູງທີ່ສຸດຂອງທັງສອງ)."

msgid "Represents the size of the [enum BlendOperation] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum BlendOperation]."

msgid "Allows dynamically changing the width of rendering lines."
msgstr "ອະນຸຍາດໃຫ້ປ່ຽນຄວາມກວ້າງຂອງເສັ້ນທີ່ເຣັນເດີໄດ້ແບບໄດນາມິກ."

msgid "Allows dynamically changing the depth bias."
msgstr "ອະນຸຍາດໃຫ້ປ່ຽນຄ່າຄວາມລຳອຽງຂອງຄວາມເລິກ (depth bias) ໄດ້ແບບໄດນາມິກ."

msgid "Initial actions are solved automatically by RenderingDevice."
msgstr "ການດຳເນີນການເລີ່ມຕົ້ນຖືກຈັດການໂດຍອັດຕະໂນມັດໂດຍ RenderingDevice."

msgid "Load the previous contents of the framebuffer."
msgstr "ໂຫຼດເນື້ອຫາທີ່ຜ່ານມາຂອງເຟຣມບັບເຟີ (framebuffer)."

msgid "Clear the whole framebuffer or its specified region."
msgstr "ລຶບ (Clear) ເຟຣມບັບເຟີທັງໝົດ ຫຼື ເຂດທີ່ລະບຸໄວ້."

msgid ""
"Ignore the previous contents of the framebuffer. This is the fastest option "
"if you'll overwrite all of the pixels and don't need to read any of them."
msgstr ""
"ບໍ່ສົນໃຈເນື້ອຫາທີ່ຜ່ານມາຂອງເຟຣມບັບເຟີ. ນີ້ແມ່ນຕົວເລືອກທີ່ໄວທີ່ສຸດຫາກທ່ານຈະຂຽນທັບພິກເຊວທັງໝົດ ແລະ "
"ບໍ່ຈຳເປັນຕ້ອງອ່ານຄ່າໃດໆ."

msgid "Represents the size of the [enum InitialAction] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum InitialAction]."

msgid "Final actions are solved automatically by RenderingDevice."
msgstr "ການດຳເນີນການສຸດທ້າຍຖືກຈັດການໂດຍອັດຕະໂນມັດໂດຍ RenderingDevice."

msgid ""
"Store the result of the draw list in the framebuffer. This is generally what "
"you want to do."
msgstr "ບັນທຶກຜົນລັບຂອງລາຍການແຕ້ມໄວ້ໃນເຟຣມບັບເຟີ. ໂດຍທົ່ວໄປແລ້ວນີ້ແມ່ນສິ່ງທີ່ທ່ານຕ້ອງການ."

msgid ""
"Discard the contents of the framebuffer. This is the fastest option if you "
"don't need to use the results of the draw list."
msgstr "ຖິ້ມເນື້ອຫາຂອງເຟຣມບັບເຟີ. ນີ້ແມ່ນຕົວເລືອກທີ່ໄວທີ່ສຸດຫາກທ່ານບໍ່ຈຳເປັນຕ້ອງໃຊ້ຜົນລັບຂອງລາຍການແຕ້ມ."

msgid "Represents the size of the [enum FinalAction] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum FinalAction]."

msgid ""
"Vertex shader stage. This can be used to manipulate vertices from a shader "
"(but not create new vertices)."
msgstr ""
"ຂັ້ນຕອນ Vertex shader. ສາມາດໃຊ້ເພື່ອຈັດການກັບຈຸດ (vertices) ຈາກເຊດເດີ "
"(ແຕ່ບໍ່ແມ່ນການສ້າງຈຸດໃໝ່)."

msgid ""
"Fragment shader stage (called \"pixel shader\" in Direct3D). This can be used "
"to manipulate pixels from a shader."
msgstr ""
"ຂັ້ນຕອນ Fragment shader (ເອີ້ນວ່າ \"pixel shader\" ໃນ Direct3D). "
"ສາມາດໃຊ້ເພື່ອຈັດການກັບພິກເຊວຈາກເຊດເດີ."

msgid ""
"Tessellation control shader stage. This can be used to create additional "
"geometry from a shader."
msgstr "ຂັ້ນຕອນ Tessellation control shader. ສາມາດໃຊ້ເພື່ອສ້າງເລຂາຄະນິດເພີ່ມເຕີມຈາກເຊດເດີ."

msgid ""
"Tessellation evaluation shader stage. This can be used to create additional "
"geometry from a shader."
msgstr ""
"ຂັ້ນຕອນ Tessellation evaluation shader. ສາມາດໃຊ້ເພື່ອສ້າງເລຂາຄະນິດເພີ່ມເຕີມຈາກເຊດເດີ."

msgid ""
"Compute shader stage. This can be used to run arbitrary computing tasks in a "
"shader, performing them on the GPU instead of the CPU."
msgstr ""
"ຂັ້ນຕອນ Compute shader. ສາມາດໃຊ້ເພື່ອປະມວນຜົນວຽກງານການຄິດໄລ່ທົ່ວໄປໃນເຊດເດີ, ໂດຍເຮັດວຽກເທິງ "
"GPU ແທນ CPU."

msgid "Ray generation shader stage. This can be used to generate primary rays."
msgstr "ຂັ້ນຕອນ Ray generation shader. ສາມາດໃຊ້ເພື່ອສ້າງລັງສີຫຼັກ (primary rays)."

msgid ""
"Any hit shader stage. Invoked when ray intersections are not opaque. This can "
"be used to specify what happens when a ray hits any of the geometry in the "
"scene."
msgstr ""
"ຂັ້ນຕອນ Any hit shader. ຖືກຮຽກໃຊ້ເມື່ອການຕັດກັນຂອງລັງສີບໍ່ແມ່ນແບບທຶບແສງ. "
"ສາມາດໃຊ້ເພື່ອລະບຸວ່າຈະເກີດຫຍັງຂຶ້ນເມື່ອລັງສີກະທົບກັບເລຂາຄະນິດໃດໆໃນສາກ."

msgid ""
"Closest hit shader stage. This can be used to specify what happens when a ray "
"hits the closest geometry in the scene."
msgstr ""
"ຂັ້ນຕອນ Closest hit shader. "
"ສາມາດໃຊ້ເພື່ອລະບຸວ່າຈະເກີດຫຍັງຂຶ້ນເມື່ອລັງສີກະທົບກັບເລຂາຄະນິດທີ່ໃກ້ທີ່ສຸດໃນສາກ."

msgid ""
"Miss shader stage. This can be used to specify what happens if a ray does not "
"hit anything in the scene."
msgstr "ຂັ້ນຕອນ Miss shader. ສາມາດໃຊ້ເພື່ອລະບຸວ່າຈະເກີດຫຍັງຂຶ້ນຫາກລັງສີບໍ່ກະທົບກັບຫຍັງເລີຍໃນສາກ."

msgid ""
"Intersection shader stage. The intersection shader for triangles is built-in. "
"This can be used to compute ray intersections with primitives that are not "
"triangles."
msgstr ""
"ຂັ້ນຕອນ Intersection shader. ເຊດເດີການຕັດກັນສຳລັບສາມລ່ຽມແມ່ນມີໃຫ້ຢູ່ແລ້ວ. "
"ສາມາດໃຊ້ເພື່ອຄິດໄລ່ການຕັດກັນຂອງລັງສີກັບຮູບຊົງພື້ນຖານທີ່ບໍ່ແມ່ນສາມລ່ຽມ."

msgid "Represents the size of the [enum ShaderStage] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum ShaderStage]."

msgid "Vertex shader stage bit (see also [constant SHADER_STAGE_VERTEX])."
msgstr "ບິດຂັ້ນຕອນ Vertex shader (ເບິ່ງ [constant SHADER_STAGE_VERTEX] ຕື່ມ)."

msgid "Fragment shader stage bit (see also [constant SHADER_STAGE_FRAGMENT])."
msgstr "ບິດຂັ້ນຕອນ Fragment shader (ເບິ່ງ [constant SHADER_STAGE_FRAGMENT] ຕື່ມ)."

msgid ""
"Tessellation control shader stage bit (see also [constant "
"SHADER_STAGE_TESSELATION_CONTROL])."
msgstr ""
"ບິດຂັ້ນຕອນ Tessellation control shader (ເບິ່ງ [constant "
"SHADER_STAGE_TESSELATION_CONTROL] ຕື່ມ)."

msgid ""
"Tessellation evaluation shader stage bit (see also [constant "
"SHADER_STAGE_TESSELATION_EVALUATION])."
msgstr ""
"ບິດຂັ້ນຕອນ Tessellation evaluation shader (ເບິ່ງ [constant "
"SHADER_STAGE_TESSELATION_EVALUATION] ຕື່ມ)."

msgid "Compute shader stage bit (see also [constant SHADER_STAGE_COMPUTE])."
msgstr "ບິດຂັ້ນຕອນ Compute shader (ເບິ່ງ [constant SHADER_STAGE_COMPUTE] ຕື່ມ)."

msgid ""
"Ray generation shader stage bit (see also [constant SHADER_STAGE_RAYGEN])."
msgstr "ບິດຂັ້ນຕອນ Ray generation shader (ເບິ່ງ [constant SHADER_STAGE_RAYGEN] ຕື່ມ)."

msgid "Any hit shader stage bit (see also [constant SHADER_STAGE_ANY_HIT])."
msgstr "ບິດຂັ້ນຕອນ Any hit shader (ເບິ່ງ [constant SHADER_STAGE_ANY_HIT] ຕື່ມ)."

msgid ""
"Closest hit shader stage bit (see also [constant SHADER_STAGE_CLOSEST_HIT])."
msgstr ""
"ບິດຂັ້ນຕອນ Closest hit shader (ເບິ່ງ [constant SHADER_STAGE_CLOSEST_HIT] ຕື່ມ)."

msgid "Miss shader stage bit (see also [constant SHADER_STAGE_MISS])."
msgstr "ບິດຂັ້ນຕອນ Miss shader (ເບິ່ງ [constant SHADER_STAGE_MISS] ຕື່ມ)."

msgid ""
"Intersection shader stage bit (see also [constant SHADER_STAGE_INTERSECTION])."
msgstr ""
"ບິດຂັ້ນຕອນ Intersection shader (ເບິ່ງ [constant SHADER_STAGE_INTERSECTION] ຕື່ມ)."

msgid ""
"Khronos' GLSL shading language (used natively by OpenGL and Vulkan). This is "
"the language used for core Godot shaders."
msgstr ""
"ພາສາເຊດເດີ GLSL ຂອງ Khronos (ໃຊ້ໂດຍ OpenGL ແລະ Vulkan). "
"ນີ້ແມ່ນພາສາທີ່ໃຊ້ສຳລັບເຊດເດີຫຼັກຂອງ Godot."

msgid ""
"Microsoft's High-Level Shading Language (used natively by Direct3D, but can "
"also be used in Vulkan)."
msgstr "ພາສາ HLSL ຂອງ Microsoft (ໃຊ້ໂດຍ Direct3D, ແຕ່ສາມາດໃຊ້ໃນ Vulkan ໄດ້ຄືກັນ)."

msgid "Boolean specialization constant."
msgstr "ຄ່າຄົງທີ່ສະເພາະແບບບູລີນ (Boolean)."

msgid "Integer specialization constant."
msgstr "ຄ່າຄົງທີ່ສະເພາະແບບເລກຖ້ວນ (Integer)."

msgid "Floating-point specialization constant."
msgstr "ຄ່າຄົງທີ່ສະເພາະແບບເລກທົດສະນິຍົມ (Floating-point)."

msgid "Support for MetalFX spatial upscaling."
msgstr "ຮອງຮັບການເພີ່ມຄວາມລະອຽດທາງພື້ນທີ່ (spatial upscaling) ຂອງ MetalFX."

msgid "Support for MetalFX temporal upscaling."
msgstr "ຮອງຮັບການເພີ່ມຄວາມລະອຽດທາງເວລາ (temporal upscaling) ຂອງ MetalFX."

msgid "Features support for buffer device address extension."
msgstr "ຄຸນສົມບັດຮອງຮັບສ່ວນຂະຫຍາຍທີ່ຢູ່ອຸປະກອນບັບເຟີ (buffer device address)."

msgid "Support for 32-bit image atomic operations."
msgstr "ຮອງຮັບການເຮັດວຽກແບບອະໂຕມິກ (atomic operations) ຂອງຮູບພາບ 32-ບິດ."

msgid ""
"Support for ray query extension.\n"
"\n"
"[b]Note:[/b] This is currently only supported when using Vulkan. This is not "
"supported on macOS and iOS (even on hardware supporting raytracing) due to "
"MoltenVK limitations."
msgstr ""
"ຮອງຮັບສ່ວນຂະຫຍາຍ ray query.\n"
"\n"
"[b]ໝາຍເຫດ:[/b] ປັດຈຸບັນຮອງຮັບສະເພາະເມື່ອໃຊ້ Vulkan ເທົ່ານັ້ນ. ບໍ່ຮອງຮັບໃນ macOS ແລະ iOS "
"(ເຖິງແມ່ນວ່າຮາດແວຈະຮອງຮັບ raytracing) ເນື່ອງຈາກຂໍ້ຈຳກັດຂອງ MoltenVK."

msgid ""
"Support for raytracing pipeline extension.\n"
"\n"
"[b]Note:[/b] This is currently only supported when using Vulkan. This is not "
"supported on macOS and iOS (even on hardware supporting raytracing) due to "
"MoltenVK limitations."
msgstr ""
"ຮອງຮັບສ່ວນຂະຫຍາຍ raytracing pipeline.\n"
"\n"
"[b]ໝາຍເຫດ:[/b] ປັດຈຸບັນຮອງຮັບສະເພາະເມື່ອໃຊ້ Vulkan ເທົ່ານັ້ນ. ບໍ່ຮອງຮັບໃນ macOS ແລະ iOS."

msgid "Support for high dynamic range (HDR) output."
msgstr "ຮອງຮັບການສະແດງຜົນຊ່ວງສີກວ້າງ (HDR)."

msgid "Maximum number of uniform sets that can be bound at a given time."
msgstr "ຈຳນວນສູງສຸດຂອງຊຸດຢູນິຟອມ (uniform sets) ທີ່ສາມາດເຊື່ອມຕໍ່ໄດ້ໃນເວລາດຽວກັນ."

msgid ""
"Maximum number of color framebuffer attachments that can be used at a given "
"time."
msgstr ""
"ຈຳນວນສູງສຸດຂອງສິ່ງທີ່ແນບມາ (attachments) ຂອງ color framebuffer "
"ທີ່ສາມາດໃຊ້ໄດ້ໃນເວລາດຽວກັນ."

msgid "Maximum number of textures that can be used per uniform set."
msgstr "ຈຳນວນເທັກເຈີສູງສຸດທີ່ສາມາດໃຊ້ໄດ້ຕໍ່ໜຶ່ງຊຸດຢູນິຟອມ."

msgid "Maximum number of samplers that can be used per uniform set."
msgstr "ຈຳນວນຕົວສຸ່ມຕົວຢ່າງສູງສຸດທີ່ສາມາດໃຊ້ໄດ້ຕໍ່ໜຶ່ງຊຸດຢູນິຟອມ."

msgid ""
"Maximum number of [url=https://vkguide.dev/docs/chapter-4/"
"storage_buffers/]storage buffers[/url] per uniform set."
msgstr ""
"ຈຳນວນສູງສຸດຂອງ [url=https://vkguide.dev/docs/chapter-4/"
"storage_buffers/]ບັບເຟີເກັບຂໍ້ມູນ (storage buffers)[/url] ຕໍ່ໜຶ່ງຊຸດຢູນິຟອມ."

msgid "Maximum number of storage images per uniform set."
msgstr "ຈຳນວນຮູບພາບເກັບຂໍ້ມູນສູງສຸດຕໍ່ໜຶ່ງຊຸດຢູນິຟອມ."

msgid "Maximum number of uniform buffers per uniform set."
msgstr "ຈຳນວນບັບເຟີຢູນິຟອມສູງສຸດຕໍ່ໜຶ່ງຊຸດຢູນິຟອມ."

msgid "Maximum index for an indexed draw command."
msgstr "ດັດຊະນີສູງສຸດສຳລັບຄຳສັ່ງແຕ້ມແບບມີດັດຊະນີ."

msgid "Maximum height of a framebuffer (in pixels)."
msgstr "ຄວາມສູງສູງສຸດຂອງເຟຣມບັບເຟີ (ເປັນພິກເຊວ)."

msgid "Maximum width of a framebuffer (in pixels)."
msgstr "ຄວາມກວ້າງສູງສຸດຂອງເຟຣມບັບເຟີ (ເປັນພິກເຊວ)."

msgid "Maximum number of texture array layers."
msgstr "ຈຳນວນຊັ້ນສູງສຸດຂອງອາເຣເທັກເຈີ (texture array layers)."

msgid ""
"Maximum supported 1-dimensional texture size (in pixels on a single axis)."
msgstr "ຂະໜາດເທັກເຈີ 1 ມິຕິສູງສຸດທີ່ຮອງຮັບ (ເປັນພິກເຊວໃນແກນດຽວ)."

msgid ""
"Maximum supported 2-dimensional texture size (in pixels on a single axis)."
msgstr "ຂະໜາດເທັກເຈີ 2 ມິຕິສູງສຸດທີ່ຮອງຮັບ (ເປັນພິກເຊວໃນແກນດຽວ)."

msgid ""
"Maximum supported 3-dimensional texture size (in pixels on a single axis)."
msgstr "ຂະໜາດເທັກເຈີ 3 ມິຕິສູງສຸດທີ່ຮອງຮັບ (ເປັນພິກເຊວໃນແກນດຽວ)."

msgid ""
"Maximum supported cubemap texture size (in pixels on a single axis of a "
"single face)."
msgstr "ຂະໜາດເທັກເຈີ cubemap ສູງສຸດທີ່ຮອງຮັບ (ເປັນພິກເຊວໃນແກນດຽວຂອງໜ້າດຽວ)."

msgid "Maximum number of textures per shader stage."
msgstr "ຈຳນວນເທັກເຈີສູງສຸດຕໍ່ໜຶ່ງຂັ້ນຕອນເຊດເດີ."

msgid "Maximum number of samplers per shader stage."
msgstr "ຈຳນວນຕົວສຸ່ມຕົວຢ່າງສູງສຸດຕໍ່ໜຶ່ງຂັ້ນຕອນເຊດເດີ."

msgid ""
"Maximum number of [url=https://vkguide.dev/docs/chapter-4/"
"storage_buffers/]storage buffers[/url] per shader stage."
msgstr ""
"ຈຳນວນສູງສຸດຂອງ [url=https://vkguide.dev/docs/chapter-4/"
"storage_buffers/]ບັບເຟີເກັບຂໍ້ມູນ[/url] ຕໍ່ໜຶ່ງຂັ້ນຕອນເຊດເດີ."

msgid "Maximum number of storage images per shader stage."
msgstr "ຈຳນວນຮູບພາບເກັບຂໍ້ມູນສູງສຸດຕໍ່ໜຶ່ງຂັ້ນຕອນເຊດເດີ."

msgid ""
"Maximum size of a push constant. A lot of devices are limited to 128 bytes, "
"so try to avoid exceeding 128 bytes in push constants to ensure compatibility "
"even if your GPU is reporting a higher value."
msgstr ""
"ຂະໜາດສູງສຸດຂອງ push constant. ອຸປະກອນຈຳນວນຫຼາຍຖືກຈຳກັດໄວ້ທີ່ 128 ໄບຕ໌, "
"ສະນັ້ນພະຍາຍາມຫຼີກລ່ຽງການໃຊ້ເກີນ 128 ໄບຕ໌ ເພື່ອໃຫ້ແນ່ໃຈວ່າມັນຈະໃຊ້ງານໄດ້ກັບທຸກອຸປະກອນ."

msgid "Maximum size of a uniform buffer."
msgstr "ຂະໜາດສູງສຸດຂອງບັບເຟີຢູນິຟອມ."

msgid "Maximum vertex input attribute offset."
msgstr "ຄ່າອອບເຊັດ (offset) ສູງສຸດຂອງຄຸນລັກສະນະນຳເຂົ້າຂອງຈຸດ (vertex input attribute)."

msgid "Maximum number of vertex input attributes."
msgstr "ຈຳນວນສູງສຸດຂອງຄຸນລັກສະນະນຳເຂົ້າຂອງຈຸດ."

msgid "Maximum number of vertex input bindings."
msgstr "ຈຳນວນສູງສຸດຂອງການເຊື່ອມຕໍ່ນຳເຂົ້າຂອງຈຸດ (vertex input bindings)."

msgid "Maximum vertex input binding stride."
msgstr "ຄ່າໄລຍະຫ່າງ (stride) ສູງສຸດຂອງການເຊື່ອມຕໍ່ນຳເຂົ້າຂອງຈຸດ."

msgid "Minimum uniform buffer offset alignment."
msgstr "ການຈັດລຽງອອບເຊັດຕໍ່າສຸດຂອງບັບເຟີຢູນິຟອມ."

msgid "Maximum shared memory size for compute shaders."
msgstr "ຂະໜາດໜ່ວຍຄວາມຈຳສ່ວນລວມ (shared memory) ສູງສຸດສຳລັບ compute shaders."

msgid "Maximum number of workgroups for compute shaders on the X axis."
msgstr "ຈຳນວນກຸ່ມວຽກ (workgroups) ສູງສຸດສຳລັບ compute shaders ໃນແກນ X."

msgid "Maximum number of workgroups for compute shaders on the Y axis."
msgstr "ຈຳນວນກຸ່ມວຽກສູງສຸດສຳລັບ compute shaders ໃນແກນ Y."

msgid "Maximum number of workgroups for compute shaders on the Z axis."
msgstr "ຈຳນວນກຸ່ມວຽກສູງສຸດສຳລັບ compute shaders ໃນແກນ Z."

msgid "Maximum number of workgroup invocations for compute shaders."
msgstr "ຈຳນວນການຮຽກໃຊ້ກຸ່ມວຽກສູງສຸດສຳລັບ compute shaders."

msgid "Maximum workgroup size for compute shaders on the X axis."
msgstr "ຂະໜາດກຸ່ມວຽກສູງສຸດສຳລັບ compute shaders ໃນແກນ X."

msgid "Maximum workgroup size for compute shaders on the Y axis."
msgstr "ຂະໜາດກຸ່ມວຽກສູງສຸດສຳລັບ compute shaders ໃນແກນ Y."

msgid "Maximum workgroup size for compute shaders on the Z axis."
msgstr "ຂະໜາດກຸ່ມວຽກສູງສຸດສຳລັບ compute shaders ໃນແກນ Z."

msgid "Maximum viewport width (in pixels)."
msgstr "ຄວາມກວ້າງສູງສຸດຂອງວິວພອດ (ເປັນພິກເຊວ)."

msgid "Maximum viewport height (in pixels)."
msgstr "ຄວາມສູງສູງສຸດຂອງວິວພອດ (ເປັນພິກເຊວ)."

msgid ""
"Returns the smallest value for [member ProjectSettings.rendering/scaling_3d/"
"scale] when using the MetalFX temporal upscaler.\n"
"[b]Note:[/b] The returned value is multiplied by a factor of [code]1000000[/"
"code] to preserve 6 digits of precision. It must be divided by "
"[code]1000000.0[/code] to convert the value to a floating point number."
msgstr ""
"ສົ່ງຄ່າທີ່ນ້ອຍທີ່ສຸດສຳລັບ [member ProjectSettings.rendering/scaling_3d/scale] ເມື່ອໃຊ້ "
"MetalFX temporal upscaler.\n"
"[b]ໝາຍເຫດ:[/b] ຄ່າທີ່ສົ່ງກັບຄືນມາຈະຖືກຄູນດ້ວຍ [code]1000000[/code] ເພື່ອຮັກສາຄວາມລະອຽດ 6 "
"ຕຳແໜ່ງ. ມັນຕ້ອງຖືກຫານດ້ວຍ [code]1000000.0[/code] ເພື່ອປ່ຽນເປັນເລກທົດສະນິຍົມ."

msgid ""
"Returns the largest value for [member ProjectSettings.rendering/scaling_3d/"
"scale] when using the MetalFX temporal upscaler.\n"
"[b]Note:[/b] The returned value is multiplied by a factor of [code]1000000[/"
"code] to preserve 6 digits of precision. It must be divided by "
"[code]1000000.0[/code] to convert the value to a floating point number."
msgstr ""
"ສົ່ງຄ່າທີ່ໃຫຍ່ທີ່ສຸດສຳລັບ [member ProjectSettings.rendering/scaling_3d/scale] ເມື່ອໃຊ້ "
"MetalFX temporal upscaler.\n"
"[b]ໝາຍເຫດ:[/b] ຄ່າທີ່ສົ່ງກັບຄືນມາຈະຖືກຄູນດ້ວຍ [code]1000000[/code]. ມັນຕ້ອງຖືກຫານດ້ວຍ "
"[code]1000000.0[/code] ເພື່ອປ່ຽນເປັນເລກທົດສະນິຍົມ."

msgid "Memory taken by textures."
msgstr "ໜ່ວຍຄວາມຈຳທີ່ໃຊ້ໂດຍເທັກເຈີ."

msgid "Memory taken by buffers."
msgstr "ໜ່ວຍຄວາມຈຳທີ່ໃຊ້ໂດຍບັບເຟີ."

msgid ""
"Total memory taken. This is greater than the sum of [constant "
"MEMORY_TEXTURES] and [constant MEMORY_BUFFERS], as it also includes "
"miscellaneous memory usage."
msgstr ""
"ໜ່ວຍຄວາມຈຳທັງໝົດທີ່ໃຊ້. ຄ່ານີ້ຈະຫຼາຍກວ່າຜົນລວມຂອງ [constant MEMORY_TEXTURES] ແລະ "
"[constant MEMORY_BUFFERS] ເນື່ອງຈາກມັນລວມເຖິງການໃຊ້ໜ່ວຍຄວາມຈຳອື່ນໆນຳ."

msgid "Returned by functions that return an ID if a value is invalid."
msgstr "ສົ່ງຄ່າໂດຍຟັງຊັນທີ່ສົ່ງຄ່າ ID ຫາກຄ່ານັ້ນບໍ່ຖືກຕ້ອງ."

msgid "Returned by functions that return a format ID if a value is invalid."
msgstr "ສົ່ງຄ່າໂດຍຟັງຊັນທີ່ສົ່ງຄ່າ format ID ຫາກຄ່ານັ້ນບໍ່ຖືກຕ້ອງ."

msgid "No breadcrumb marker will be added."
msgstr "ຈະບໍ່ມີການເພີ່ມເຄື່ອງໝາຍ breadcrumb."

msgid ""
"During a GPU crash in dev or debug mode, Godot's error message will include "
"[code]\"REFLECTION_PROBES\"[/code] for added context as to when the crash "
"occurred."
