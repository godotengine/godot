"print(color.to_rgba32()) # ສະແດງຜົນ 4286526463\n"
"[/gdscript]\n"
"[csharp]\n"
"var color = new Color(1, 0.5f, 0.2f);\n"
"GD.Print(color.ToRgba32()); // ສະແດງຜົນ 4286526463\n"
"[/csharp]\n"
"[/codeblocks]"

