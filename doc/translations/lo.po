msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum Variant.Type]."

msgid "Equality operator ([code]==[/code])."
msgstr "ຕົວດຳເນີນການຄວາມເທົ່າທຽມ ([code]==[/code])."

msgid "Inequality operator ([code]!=[/code])."
msgstr "ຕົວດຳເນີນການຄວາມບໍ່ເທົ່າທຽມ ([code]!=[/code])."

msgid "Less than operator ([code]<[/code])."
msgstr "ຕົວດຳເນີນການນ້ອຍກວ່າ ([code]<[/code])."

msgid "Less than or equal operator ([code]<=[/code])."
msgstr "ຕົວດຳເນີນການນ້ອຍກວ່າ ຫຼື ເທົ່າກັບ ([code]<=[/code])."

msgid "Greater than operator ([code]>[/code])."
msgstr "ຕົວດຳເນີນການຫຼາຍກວ່າ ([code]>[/code])."

msgid "Greater than or equal operator ([code]>=[/code])."
msgstr "ຕົວດຳເນີນການຫຼາຍກວ່າ ຫຼື ເທົ່າກັບ ([code]>=[/code])."

msgid "Addition operator ([code]+[/code])."
msgstr "ຕົວດຳເນີນການບວກ ([code]+[/code])."

msgid "Subtraction operator ([code]-[/code])."
msgstr "ຕົວດຳເນີນການລົບ ([code]-[/code])."

msgid "Multiplication operator ([code]*[/code])."
msgstr "ຕົວດຳເນີນການຄູນ ([code]*[/code])."

msgid "Division operator ([code]/[/code])."
msgstr "ຕົວດຳເນີນການຫານ ([code]/[/code])."

msgid "Unary negation operator ([code]-[/code])."
msgstr "ຕົວດຳເນີນການນິເສດແບບຍູນາຣີ ([code]-[/code])."

msgid "Unary plus operator ([code]+[/code])."
msgstr "ຕົວດຳເນີນການບວກແບບຍູນາຣີ ([code]+[/code])."

msgid "Remainder/modulo operator ([code]%[/code])."
msgstr "ຕົວດຳເນີນການຫານເອົາສ່ວນເສດ/ໂມດູໂລ ([code]%[/code])."

msgid "Power operator ([code]**[/code])."
msgstr "ຕົວດຳເນີນການເລກກຳລັງ ([code]**[/code])."

msgid "Left shift operator ([code]<<[/code])."
msgstr "ຕົວດຳເນີນການເລື່ອນບິດໄປທາງຊ້າຍ ([code]<<[/code])."

msgid "Right shift operator ([code]>>[/code])."
msgstr "ຕົວດຳເນີນການເລື່ອນບິດໄປທາງຂວາ ([code]>>[/code])."

msgid "Bitwise AND operator ([code]&[/code])."
msgstr "ຕົວດຳເນີນການ AND ແບບບິດ ([code]&[/code])."

msgid "Bitwise OR operator ([code]|[/code])."
msgstr "ຕົວດຳເນີນການ OR ແບບບິດ ([code]|[/code])."

msgid "Bitwise XOR operator ([code]^[/code])."
msgstr "ຕົວດຳເນີນການ XOR ແບບບິດ ([code]^[/code])."

msgid "Bitwise NOT operator ([code]~[/code])."
msgstr "ຕົວດຳເນີນການ NOT ແບບບິດ ([code]~[/code])."

msgid "Logical AND operator ([code]and[/code] or [code]&&[/code])."
msgstr "ຕົວດຳເນີນການຕັກກະສາດ ແລະ ([code]and[/code] ຫຼື [code]&&[/code])."

msgid "Logical OR operator ([code]or[/code] or [code]||[/code])."
msgstr "ຕົວດຳເນີນການຕັກກະສາດ ຫຼື ([code]or[/code] ຫຼື [code]||[/code])."

msgid "Logical XOR operator (not implemented in GDScript)."
msgstr "ຕົວດຳເນີນການຕັກກະສາດ XOR (ຍັງບໍ່ທັນໄດ້ຕິດຕັ້ງໃນ GDScript)."

msgid "Logical NOT operator ([code]not[/code] or [code]![/code])."
msgstr "ຕົວດຳເນີນການຕັກກະສາດ ບໍ່ ([code]not[/code] ຫຼື [code]![/code])."

msgid "Logical IN operator ([code]in[/code])."
msgstr "ຕົວດຳເນີນການຕັກກະສາດ IN ([code]in[/code])."

msgid "Represents the size of the [enum Variant.Operator] enum."
msgstr "ສະແດງເຖິງຂະໜາດຂອງ enum [enum Variant.Operator]."

msgid "A 3D axis-aligned bounding box."
msgstr "ກ່ອງຂອບ (Bounding box) 3D ທີ່ຈັດລຽງຕາມແກນ."

msgid ""
"The [AABB] built-in [Variant] type represents an axis-aligned bounding box in "
"a 3D space. It is defined by its [member position] and [member size], which "
"are [Vector3]. It is frequently used for fast overlap tests (see [method "
"intersects]). Although [AABB] itself is axis-aligned, it can be combined with "
"[Transform3D] to represent a rotated or skewed bounding box.\n"
"It uses floating-point coordinates. The 2D counterpart to [AABB] is [Rect2]. "
"There is no version of [AABB] that uses integer coordinates.\n"
"[b]Note:[/b] Negative values for [member size] are not supported. With "
"negative size, most [AABB] methods do not work correctly. Use [method abs] to "
"get an equivalent [AABB] with a non-negative size.\n"
"[b]Note:[/b] In a boolean context, an [AABB] evaluates to [code]false[/code] "
"if both [member position] and [member size] are zero (equal to [constant "
"Vector3.ZERO]). Otherwise, it always evaluates to [code]true[/code]."
msgstr ""
"ປະເພດ [Variant] ພາຍໃນ [AABB] ສະແດງເຖິງກ່ອງຂອບທີ່ຈັດລຽງຕາມແກນໃນພື້ນທີ່ 3D. ມັນຖືກກຳນົດໂດຍ "
"[member position] ແລະ [member size] ຂອງມັນ, ເຊິ່ງແມ່ນ [Vector3]. "
"ມັນຖືກນຳໃຊ້ເລື້ອຍໆເພື່ອການທົດສອບການຊ້ອນທັບທີ່ໄວ (ເບິ່ງ [method intersects]). ເຖິງແມ່ນວ່າ "
"[AABB] ຈະຖືກຈັດລຽງຕາມແກນດ້ວຍຕົວມັນເອງ, ແຕ່ມັນສາມາດລວມເຂົ້າກັບ [Transform3D] "
"ເພື່ອສະແດງກ່ອງຂອບທີ່ໝູນ ຫຼື ບິດບ້ຽວໄດ້.\n"
"ມັນໃຊ້ພິກັດແບບຈຸດລອຍ (floating-point). ສ່ວນທີ່ທຽບເທົ່າ 2D ຂອງ [AABB] ແມ່ນ [Rect2]. "
"ບໍ່ມີເວີຊັນຂອງ [AABB] ທີ່ໃຊ້ພິກັດເປັນຈຳນວນຖ້ວນ.\n"
"[b]ໝາຍເຫດ:[/b] ບໍ່ຮອງຮັບຄ່າລົບສຳລັບ [member size]. ຖ້າຂະໜາດເປັນຄ່າລົບ, ວິທີການສ່ວນໃຫຍ່ຂອງ "
"[AABB] ຈະເຮັດວຽກບໍ່ຖືກຕ້ອງ. ໃຫ້ໃຊ້ [method abs] ເພື່ອຮັບ [AABB] "
"ທີ່ທຽບເທົ່າທີ່ມີຂະໜາດບໍ່ເປັນຄ່າລົບ.\n"
"[b]ໝາຍເຫດ:[/b] ໃນບໍລິບົດບູລີນ (boolean), [AABB] ຈະໃຫ້ຄ່າເປັນ [code]false[/code] ຖ້າທັງ "
"[member position] ແລະ [member size] ເປັນສູນ (ເທົ່າກັບ [constant Vector3.ZERO]). "
"ຖ້າບໍ່ດັ່ງນັ້ນ, ມັນຈະໃຫ້ຄ່າເປັນ [code]true[/code] ສະເໝີ."

msgid "Math documentation index"
msgstr "ດັດສະນີເອກະສານທາງຄະນິດສາດ"

msgid "Vector math"
msgstr "ຄະນິດສາດເວກເຕີ"

msgid "Advanced vector math"
msgstr "ຄະນິດສາດເວກເຕີຂັ້ນສູງ"

msgid ""
"Constructs an [AABB] with its [member position] and [member size] set to "
"[constant Vector3.ZERO]."
msgstr ""
"ສ້າງ [AABB] ໂດຍທີ່ [member position] ແລະ [member size] ຖືກກຳນົດເປັນ [constant "
"Vector3.ZERO]."

msgid "Constructs an [AABB] as a copy of the given [AABB]."
msgstr "ສ້າງ [AABB] ໂດຍການສຳເນົາຈາກ [AABB] ທີ່ກຳນົດໃຫ້."

msgid "Constructs an [AABB] by [param position] and [param size]."
msgstr "ສ້າງ [AABB] ໂດຍໃຊ້ [param position] ແລະ [param size]."

msgid ""
"Returns an [AABB] equivalent to this bounding box, with its width, height, "
"and depth modified to be non-negative values.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box = AABB(Vector3(5, 0, 5), Vector3(-20, -10, -5))\n"
"var absolute = box.abs()\n"
"print(absolute.position) # Prints (-15.0, -10.0, 0.0)\n"
"print(absolute.size)     # Prints (20.0, 10.0, 5.0)\n"
"[/gdscript]\n"
"[csharp]\n"
"var box = new Aabb(new Vector3(5, 0, 5), new Vector3(-20, -10, -5));\n"
"var absolute = box.Abs();\n"
"GD.Print(absolute.Position); // Prints (-15, -10, 0)\n"
"GD.Print(absolute.Size);     // Prints (20, 10, 5)\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]Note:[/b] It's recommended to use this method when [member size] is "
"negative, as most other methods in Godot assume that the [member size]'s "
"components are greater than [code]0[/code]."
msgstr ""
"ຄືນຄ່າ [AABB] ທີ່ທຽບເທົ່າກັບກ່ອງຂອບນີ້, ໂດຍທີ່ຄວາມກວ້າງ, ຄວາມສູງ, ແລະ "
"ຄວາມເລິກຖືກປັບໃຫ້ເປັນຄ່າບໍ່ເປັນລົບ.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box = AABB(Vector3(5, 0, 5), Vector3(-20, -10, -5))\n"
"var absolute = box.abs()\n"
"print(absolute.position) # ສະແດງ (-15.0, -10.0, 0.0)\n"
"print(absolute.size)     # ສະແດງ (20.0, 10.0, 5.0)\n"
"[/gdscript]\n"
"[csharp]\n"
"var box = new Aabb(new Vector3(5, 0, 5), new Vector3(-20, -10, -5));\n"
"var absolute = box.Abs();\n"
"GD.Print(absolute.Position); // ສະແດງ (-15, -10, 0)\n"
"GD.Print(absolute.Size);     // ສະແດງ (20, 10, 5)\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]ໝາຍເຫດ:[/b] ແນະນຳໃຫ້ໃຊ້ວິທີນີ້ເມື່ອ [member size] ເປັນຄ່າລົບ, ເພາະວ່າວິທີການສ່ວນໃຫຍ່ໃນ "
"Godot ສົມມຸດວ່າສ່ວນປະກອບຂອງ [member size] ມີຄ່າຫຼາຍກວ່າ [code]0[/code]."

msgid ""
"Returns [code]true[/code] if this bounding box [i]completely[/i] encloses the "
"[param with] box. The edges of both boxes are included.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var a = AABB(Vector3(0, 0, 0), Vector3(4, 4, 4))\n"
"var b = AABB(Vector3(1, 1, 1), Vector3(3, 3, 3))\n"
"var c = AABB(Vector3(2, 2, 2), Vector3(8, 8, 8))\n"
"\n"
"print(a.encloses(a)) # Prints true\n"
"print(a.encloses(b)) # Prints true\n"
"print(a.encloses(c)) # Prints false\n"
"[/gdscript]\n"
"[csharp]\n"
"var a = new Aabb(new Vector3(0, 0, 0), new Vector3(4, 4, 4));\n"
"var b = new Aabb(new Vector3(1, 1, 1), new Vector3(3, 3, 3));\n"
"var c = new Aabb(new Vector3(2, 2, 2), new Vector3(8, 8, 8));\n"
"\n"
"GD.Print(a.Encloses(a)); // Prints True\n"
"GD.Print(a.Encloses(b)); // Prints True\n"
"GD.Print(a.Encloses(c)); // Prints False\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"ຄືນຄ່າ [code]true[/code] ຖ້າກ່ອງຂອບນີ້ຄອບຄຸມກ່ອງ [param with] ໄດ້ [i]ທັງໝົດ[/i]. "
"ລວມທັງຂອບຂອງກ່ອງທັງສອງ.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var a = AABB(Vector3(0, 0, 0), Vector3(4, 4, 4))\n"
"var b = AABB(Vector3(1, 1, 1), Vector3(3, 3, 3))\n"
"var c = AABB(Vector3(2, 2, 2), Vector3(8, 8, 8))\n"
"\n"
"print(a.encloses(a)) # ສະແດງ true\n"
"print(a.encloses(b)) # ສະແດງ true\n"
"print(a.encloses(c)) # ສະແດງ false\n"
"[/gdscript]\n"
"[csharp]\n"
"var a = new Aabb(new Vector3(0, 0, 0), new Vector3(4, 4, 4));\n"
"var b = new Aabb(new Vector3(1, 1, 1), new Vector3(3, 3, 3));\n"
"var c = new Aabb(new Vector3(2, 2, 2), new Vector3(8, 8, 8));\n"
"\n"
"GD.Print(a.Encloses(a)); // ສະແດງ True\n"
"GD.Print(a.Encloses(b)); // ສະແດງ True\n"
"GD.Print(a.Encloses(c)); // ສະແດງ False\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Returns a copy of this bounding box expanded to align the edges with the "
"given [param to_point], if necessary.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box = AABB(Vector3(0, 0, 0), Vector3(5, 2, 5))\n"
"\n"
"box = box.expand(Vector3(10, 0, 0))\n"
"print(box.position) # Prints (0.0, 0.0, 0.0)\n"
"print(box.size)     # Prints (10.0, 2.0, 5.0)\n"
"\n"
"box = box.expand(Vector3(-5, 0, 5))\n"
"print(box.position) # Prints (-5.0, 0.0, 0.0)\n"
"print(box.size)     # Prints (15.0, 2.0, 5.0)\n"
"[/gdscript]\n"
"[csharp]\n"
"var box = new Aabb(new Vector3(0, 0, 0), new Vector3(5, 2, 5));\n"
"\n"
"box = box.Expand(new Vector3(10, 0, 0));\n"
"GD.Print(box.Position); // Prints (0, 0, 0)\n"
"GD.Print(box.Size);     // Prints (10, 2, 5)\n"
"\n"
"box = box.Expand(new Vector3(-5, 0, 5));\n"
"GD.Print(box.Position); // Prints (-5, 0, 0)\n"
"GD.Print(box.Size);     // Prints (15, 2, 5)\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"ຄືນຄ່າສຳເນົາຂອງກ່ອງຂອບນີ້ທີ່ຂະຫຍາຍອອກເພື່ອໃຫ້ຂອບພໍດີກັບ [param to_point] ທີ່ກຳນົດໃຫ້, ຖ້າຈຳເປັນ.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box = AABB(Vector3(0, 0, 0), Vector3(5, 2, 5))\n"
"\n"
"box = box.expand(Vector3(10, 0, 0))\n"
"print(box.position) # ສະແດງ (0.0, 0.0, 0.0)\n"
"print(box.size)     # ສະແດງ (10.0, 2.0, 5.0)\n"
"\n"
"box = box.expand(Vector3(-5, 0, 5))\n"
"print(box.position) # ສະແດງ (-5.0, 0.0, 0.0)\n"
"print(box.size)     # ສະແດງ (15.0, 2.0, 5.0)\n"
"[/gdscript]\n"
"[csharp]\n"
"var box = new Aabb(new Vector3(0, 0, 0), new Vector3(5, 2, 5));\n"
"\n"
"box = box.Expand(new Vector3(10, 0, 0));\n"
"GD.Print(box.Position); // ສະແດງ (0, 0, 0)\n"
"GD.Print(box.Size);     // ສະແດງ (10, 2, 5)\n"
"\n"
"box = box.Expand(new Vector3(-5, 0, 5));\n"
"GD.Print(box.Position); // ສະແດງ (-5, 0, 0)\n"
"GD.Print(box.Size);     // ສະແດງ (15, 2, 5)\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Returns the center point of the bounding box. This is the same as "
"[code]position + (size / 2.0)[/code]."
msgstr "ຄືນຄ່າຈຸດໃຈກາງຂອງກ່ອງຂອບ. ນີ້ແມ່ນຄືກັນກັບ [code]position + (size / 2.0)[/code]."

msgid ""
"Returns the position of one of the 8 vertices that compose this bounding box. "
"With an [param idx] of [code]0[/code] this is the same as [member position], "
"and an [param idx] of [code]7[/code] is the same as [member end]."
msgstr ""
"ຄືນຄ່າຕຳແໜ່ງຂອງໜຶ່ງໃນ 8 ຈຸດຈອມ (vertices) ທີ່ປະກອບເປັນກ່ອງຂອບນີ້. ຖ້າ [param idx] ແມ່ນ "
"[code]0[/code] ມັນຈະຄືກັນກັບ [member position], ແລະ [param idx] ແມ່ນ [code]7[/"
"code] ຈະຄືກັນກັບ [member end]."

msgid ""
"Returns the longest normalized axis of this bounding box's [member size], as "
"a [Vector3] ([constant Vector3.RIGHT], [constant Vector3.UP], or [constant "
"Vector3.BACK]).\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box = AABB(Vector3(0, 0, 0), Vector3(2, 4, 8))\n"
"\n"
"print(box.get_longest_axis())       # Prints (0.0, 0.0, 1.0)\n"
"print(box.get_longest_axis_index()) # Prints 2\n"
"print(box.get_longest_axis_size())  # Prints 8.0\n"
"[/gdscript]\n"
"[csharp]\n"
"var box = new Aabb(new Vector3(0, 0, 0), new Vector3(2, 4, 8));\n"
"\n"
"GD.Print(box.GetLongestAxis());      // Prints (0, 0, 1)\n"
"GD.Print(box.GetLongestAxisIndex()); // Prints Z\n"
"GD.Print(box.GetLongestAxisSize());  // Prints 8\n"
"[/csharp]\n"
"[/codeblocks]\n"
"See also [method get_longest_axis_index] and [method get_longest_axis_size]."
msgstr ""
"ຄືນຄ່າແກນທີ່ຍາວທີ່ສຸດທີ່ຖືກນໍມາໄລ (normalized) ຂອງ [member size] ຂອງກ່ອງຂອບນີ້, ເປັນ "
"[Vector3] ([constant Vector3.RIGHT], [constant Vector3.UP], ຫຼື [constant "
"Vector3.BACK]).\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box = AABB(Vector3(0, 0, 0), Vector3(2, 4, 8))\n"
"\n"
"print(box.get_longest_axis())       # ສະແດງ (0.0, 0.0, 1.0)\n"
"print(box.get_longest_axis_index()) # ສະແດງ 2\n"
"print(box.get_longest_axis_size())  # ສະແດງ 8.0\n"
"[/gdscript]\n"
"[csharp]\n"
"var box = new Aabb(new Vector3(0, 0, 0), new Vector3(2, 4, 8));\n"
"\n"
"GD.Print(box.GetLongestAxis());      // ສະແດງ (0, 0, 1)\n"
"GD.Print(box.GetLongestAxisIndex()); // ສະແດງ Z\n"
"GD.Print(box.GetLongestAxisSize());  // ສະແດງ 8\n"
"[/csharp]\n"
"[/codeblocks]\n"
"ເບິ່ງເພີ່ມເຕີມ [method get_longest_axis_index] ແລະ [method get_longest_axis_size]."

msgid ""
"Returns the index to the longest axis of this bounding box's [member size] "
"(see [constant Vector3.AXIS_X], [constant Vector3.AXIS_Y], and [constant "
"Vector3.AXIS_Z]).\n"
"For an example, see [method get_longest_axis]."
msgstr ""
"ຄືນຄ່າດັດສະນີ (index) ຂອງແກນທີ່ຍາວທີ່ສຸດຂອງ [member size] ຂອງກ່ອງຂອບນີ້ (ເບິ່ງ [constant "
"Vector3.AXIS_X], [constant Vector3.AXIS_Y], ແລະ [constant Vector3.AXIS_Z]).\n"
"ສຳລັບຕົວຢ່າງ, ເບິ່ງ [method get_longest_axis]."

msgid ""
"Returns the longest dimension of this bounding box's [member size].\n"
"For an example, see [method get_longest_axis]."
msgstr ""
"ຄືນຄ່າມິຕິທີ່ຍາວທີ່ສຸດຂອງ [member size] ຂອງກ່ອງຂອບນີ້.\n"
"ສຳລັບຕົວຢ່າງ, ເບິ່ງ [method get_longest_axis]."

msgid ""
"Returns the shortest normalized axis of this bounding box's [member size], as "
"a [Vector3] ([constant Vector3.RIGHT], [constant Vector3.UP], or [constant "
"Vector3.BACK]).\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box = AABB(Vector3(0, 0, 0), Vector3(2, 4, 8))\n"
"\n"
"print(box.get_shortest_axis())       # Prints (1.0, 0.0, 0.0)\n"
"print(box.get_shortest_axis_index()) # Prints 0\n"
"print(box.get_shortest_axis_size())  # Prints 2.0\n"
"[/gdscript]\n"
"[csharp]\n"
"var box = new Aabb(new Vector3(0, 0, 0), new Vector3(2, 4, 8));\n"
"\n"
"GD.Print(box.GetShortestAxis());      // Prints (1, 0, 0)\n"
"GD.Print(box.GetShortestAxisIndex()); // Prints X\n"
"GD.Print(box.GetShortestAxisSize());  // Prints 2\n"
"[/csharp]\n"
"[/codeblocks]\n"
"See also [method get_shortest_axis_index] and [method get_shortest_axis_size]."
msgstr ""
"ຄືນຄ່າແກນທີ່ສັ້ນທີ່ສຸດທີ່ຖືກນໍມາໄລ (normalized) ຂອງ [member size] ຂອງກ່ອງຂອບນີ້, ເປັນ "
"[Vector3] ([constant Vector3.RIGHT], [constant Vector3.UP], ຫຼື [constant "
"Vector3.BACK]).\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box = AABB(Vector3(0, 0, 0), Vector3(2, 4, 8))\n"
"\n"
"print(box.get_shortest_axis())       # ສະແດງ (1.0, 0.0, 0.0)\n"
"print(box.get_shortest_axis_index()) # ສະແດງ 0\n"
"print(box.get_shortest_axis_size())  # ສະແດງ 2.0\n"
"[/gdscript]\n"
"[csharp]\n"
"var box = new Aabb(new Vector3(0, 0, 0), new Vector3(2, 4, 8));\n"
"\n"
"GD.Print(box.GetShortestAxis());      // ສະແດງ (1, 0, 0)\n"
"GD.Print(box.GetShortestAxisIndex()); // ສະແດງ X\n"
"GD.Print(box.GetShortestAxisSize());  // ສະແດງ 2\n"
"[/csharp]\n"
"[/codeblocks]\n"
"ເບິ່ງເພີ່ມເຕີມ [method get_shortest_axis_index] ແລະ [method "
"get_shortest_axis_size]."

msgid ""
"Returns the index to the shortest axis of this bounding box's [member size] "
"(see [constant Vector3.AXIS_X], [constant Vector3.AXIS_Y], and [constant "
"Vector3.AXIS_Z]).\n"
"For an example, see [method get_shortest_axis]."
msgstr ""
"ຄືນຄ່າດັດສະນີ (index) ຂອງແກນທີ່ສັ້ນທີ່ສຸດຂອງ [member size] ຂອງກ່ອງຂອບນີ້ (ເບິ່ງ [constant "
"Vector3.AXIS_X], [constant Vector3.AXIS_Y], ແລະ [constant Vector3.AXIS_Z]).\n"
"ສຳລັບຕົວຢ່າງ, ເບິ່ງ [method get_shortest_axis]."

msgid ""
"Returns the shortest dimension of this bounding box's [member size].\n"
"For an example, see [method get_shortest_axis]."
msgstr ""
"ຄືນຄ່າມິຕິທີ່ສັ້ນທີ່ສຸດຂອງ [member size] ຂອງກ່ອງຂອບນີ້.\n"
"ສຳລັບຕົວຢ່າງ, ເບິ່ງ [method get_shortest_axis]."

msgid ""
"Returns the vertex's position of this bounding box that's the farthest in the "
"given direction. This point is commonly known as the support point in "
"collision detection algorithms."
msgstr ""
"ຄືນຄ່າຕຳແໜ່ງຂອງຈຸດຈອມຂອງກ່ອງຂອບນີ້ທີ່ຢູ່ໄກທີ່ສຸດໃນທິດທາງທີ່ກຳນົດໃຫ້. ຈຸດນີ້ມັກຈະຖືກເອີ້ນວ່າ ຈຸດສະໜັບສະໜູນ "
"(support point) ໃນອັນກໍຣິທຶມການກວດສອບການຕຳກັນ."

msgid ""
"Returns the bounding box's volume. This is equivalent to [code]size.x * "
"size.y * size.z[/code]. See also [method has_volume]."
msgstr ""
"ຄືນຄ່າບໍລິມາດຂອງກ່ອງຂອບ. ນີ້ແມ່ນທຽບເທົ່າກັບ [code]size.x * size.y * size.z[/code]. "
"ເບິ່ງເພີ່ມເຕີມ [method has_volume]."

msgid ""
"Returns a copy of this bounding box extended on all sides by the given amount "
"[param by]. A negative amount shrinks the box instead.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var a = AABB(Vector3(4, 4, 4), Vector3(8, 8, 8)).grow(4)\n"
"print(a.position) # Prints (0.0, 0.0, 0.0)\n"
"print(a.size)     # Prints (16.0, 16.0, 16.0)\n"
"\n"
"var b = AABB(Vector3(0, 0, 0), Vector3(8, 4, 2)).grow(2)\n"
"print(b.position) # Prints (-2.0, -2.0, -2.0)\n"
"print(b.size)     # Prints (12.0, 8.0, 6.0)\n"
"[/gdscript]\n"
"[csharp]\n"
"var a = new Aabb(new Vector3(4, 4, 4), new Vector3(8, 8, 8)).Grow(4);\n"
"GD.Print(a.Position); // Prints (0, 0, 0)\n"
"GD.Print(a.Size);     // Prints (16, 16, 16)\n"
"\n"
"var b = new Aabb(new Vector3(0, 0, 0), new Vector3(8, 4, 2)).Grow(2);\n"
"GD.Print(b.Position); // Prints (-2, -2, -2)\n"
"GD.Print(b.Size);     // Prints (12, 8, 6)\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"ຄືນຄ່າສຳເນົາຂອງກ່ອງຂອບນີ້ທີ່ຂະຫຍາຍອອກທຸກດ້ານຕາມຈຳນວນ [param by] ທີ່ກຳນົດໃຫ້. "
"ຖ້າຄ່າເປັນລົບຈະເຮັດໃຫ້ກ່ອງຫົດຕົວລົງ.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var a = AABB(Vector3(4, 4, 4), Vector3(8, 8, 8)).grow(4)\n"
"print(a.position) # ສະແດງ (0.0, 0.0, 0.0)\n"
"print(a.size)     # ສະແດງ (16.0, 16.0, 16.0)\n"
"\n"
"var b = AABB(Vector3(0, 0, 0), Vector3(8, 4, 2)).grow(2)\n"
"print(b.position) # ສະແດງ (-2.0, -2.0, -2.0)\n"
"print(b.size)     # ສະແດງ (12.0, 8.0, 6.0)\n"
"[/gdscript]\n"
"[csharp]\n"
"var a = new Aabb(new Vector3(4, 4, 4), new Vector3(8, 8, 8)).Grow(4);\n"
"GD.Print(a.Position); // ສະແດງ (0, 0, 0)\n"
"GD.Print(a.Size);     // ສະແດງ (16, 16, 16)\n"
"\n"
"var b = new Aabb(new Vector3(0, 0, 0), new Vector3(8, 4, 2)).Grow(2);\n"
"GD.Print(b.Position); // ສະແດງ (-2, -2, -2)\n"
"GD.Print(b.Size);     // ສະແດງ (12, 8, 6)\n"
"[/csharp]\n"
"[/codeblocks]"

msgid ""
"Returns [code]true[/code] if the bounding box contains the given [param "
"point]. By convention, points exactly on the right, top, and front sides are "
"[b]not[/b] included.\n"
"[b]Note:[/b] This method is not reliable for [AABB] with a [i]negative[/i] "
"[member size]. Use [method abs] first to get a valid bounding box."
msgstr ""
"ຄືນຄ່າ [code]true[/code] ຖ້າກ່ອງຂອບມີຈຸດ [param point] ທີ່ກຳນົດໃຫ້ຢູ່ພາຍໃນ. ຕາມຂໍ້ຕົກລົງ, "
"ຈຸດທີ່ຢູ່ເທິງດ້ານຂວາ, ດ້ານເທິງ, ແລະ ດ້ານໜ້າ ພໍດີຈະ [b]ບໍ່[/b] ຖືກນັບລວມ.\n"
"[b]ໝາຍເຫດ:[/b] ວິທີການນີ້ບໍ່ໜ້າເຊື່ອຖືສຳລັບ [AABB] ທີ່ມີ [member size] ເປັນ [i]ຄ່າລົບ[/i]. "
"ໃຫ້ໃຊ້ [method abs] ກ່ອນເພື່ອໃຫ້ໄດ້ກ່ອງຂອບທີ່ຖືກຕ້ອງ."

msgid ""
"Returns [code]true[/code] if this bounding box has a surface or a length, "
"that is, at least one component of [member size] is greater than [code]0[/"
"code]. Otherwise, returns [code]false[/code]."
msgstr ""
"ຄືນຄ່າ [code]true[/code] ຖ້າກ່ອງຂອບນີ້ມີພື້ນຜິວ ຫຼື ຄວາມຍາວ, ນັ້ນຄື ຢ່າງໜ້ອຍໜຶ່ງສ່ວນປະກອບຂອງ "
"[member size] ຫຼາຍກວ່າ [code]0[/code]. ຖ້າບໍ່ດັ່ງນັ້ນ, ຄືນຄ່າ [code]false[/code]."

msgid ""
"Returns [code]true[/code] if this bounding box's width, height, and depth are "
"all positive. See also [method get_volume]."
msgstr ""
"ຄືນຄ່າ [code]true[/code] ຖ້າຄວາມກວ້າງ, ຄວາມສູງ, ແລະ ຄວາມເລິກຂອງກ່ອງຂອບນີ້ເປັນຄ່າບວກທັງໝົດ. "
"ເບິ່ງເພີ່ມເຕີມ [method get_volume]."

msgid ""
"Returns the intersection between this bounding box and [param with]. If the "
"boxes do not intersect, returns an empty [AABB]. If the boxes intersect at "
"the edge, returns a flat [AABB] with no volume (see [method has_surface] and "
"[method has_volume]).\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box1 = AABB(Vector3(0, 0, 0), Vector3(5, 2, 8))\n"
"var box2 = AABB(Vector3(2, 0, 2), Vector3(8, 4, 4))\n"
"\n"
"var intersection = box1.intersection(box2)\n"
"print(intersection.position) # Prints (2.0, 0.0, 2.0)\n"
"print(intersection.size)     # Prints (3.0, 2.0, 4.0)\n"
"[/gdscript]\n"
"[csharp]\n"
"var box1 = new Aabb(new Vector3(0, 0, 0), new Vector3(5, 2, 8));\n"
"var box2 = new Aabb(new Vector3(2, 0, 2), new Vector3(8, 4, 4));\n"
"\n"
"var intersection = box1.Intersection(box2);\n"
"GD.Print(intersection.Position); // Prints (2, 0, 2)\n"
"GD.Print(intersection.Size);     // Prints (3, 2, 4)\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]Note:[/b] If you only need to know whether two bounding boxes are "
"intersecting, use [method intersects], instead."
msgstr ""
"ຄືນຄ່າການຕັດກັນ (intersection) ລະຫວ່າງກ່ອງຂອບນີ້ ແລະ [param with]. ຖ້າກ່ອງບໍ່ຕັດກັນ, "
"ຈະຄືນຄ່າເປັນ [AABB] ຫວ່າງເປົ່າ. ຖ້າກ່ອງຕັດກັນຢູ່ທີ່ຂອບ, ຈະຄືນຄ່າເປັນ [AABB] ທີ່ແປໂດຍບໍ່ມີບໍລິມາດ (ເບິ່ງ "
"[method has_surface] ແລະ [method has_volume]).\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box1 = AABB(Vector3(0, 0, 0), Vector3(5, 2, 8))\n"
"var box2 = AABB(Vector3(2, 0, 2), Vector3(8, 4, 4))\n"
"\n"
"var intersection = box1.intersection(box2)\n"
"print(intersection.position) # ສະແດງ (2.0, 0.0, 2.0)\n"
"print(intersection.size)     # ສະແດງ (3.0, 2.0, 4.0)\n"
"[/gdscript]\n"
"[csharp]\n"
"var box1 = new Aabb(new Vector3(0, 0, 0), new Vector3(5, 2, 8));\n"
"var box2 = new Aabb(new Vector3(2, 0, 2), new Vector3(8, 4, 4));\n"
"\n"
"var intersection = box1.Intersection(box2);\n"
"GD.Print(intersection.Position); // ສະແດງ (2, 0, 2)\n"
"GD.Print(intersection.Size);     // ສະແດງ (3, 2, 4)\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]ໝາຍເຫດ:[/b] ຖ້າທ່ານພຽງແຕ່ຕ້ອງການຮູ້ວ່າກ່ອງຂອບສອງອັນຕັດກັນຫຼືບໍ່, ໃຫ້ໃຊ້ [method intersects] "
"ແທນ."

msgid ""
"Returns [code]true[/code] if this bounding box overlaps with the box [param "
"with]. The edges of both boxes are [i]always[/i] excluded."
msgstr ""
"ຄືນຄ່າ [code]true[/code] ຖ້າກ່ອງຂອບນີ້ຊ້ອນທັບກັບກ່ອງ [param with]. ຂອບຂອງກ່ອງທັງສອງແມ່ນ "
"[i]ສະເໝີ[/i] ທີ່ບໍ່ຖືກນັບລວມ."

msgid ""
"Returns [code]true[/code] if this bounding box is on both sides of the given "
"[param plane]."
msgstr "ຄືນຄ່າ [code]true[/code] ຖ້າກ່ອງຂອບນີ້ຢູ່ທັງສອງດ້ານຂອງ [param plane] ທີ່ກຳນົດໃຫ້."

msgid ""
"Returns the first point where this bounding box and the given ray intersect, "
"as a [Vector3]. If no intersection occurs, returns [code]null[/code].\n"
"The ray begin at [param from], faces [param dir] and extends towards infinity."
msgstr ""
"ຄືນຄ່າຈຸດທຳອິດທີ່ກ່ອງຂອບນີ້ ແລະ ລັງສີ (ray) ທີ່ກຳນົດໃຫ້ຕັດກັນ, ເປັນ [Vector3]. "
"ຖ້າບໍ່ມີການຕັດກັນເກີດຂຶ້ນ, ຈະຄືນຄ່າ [code]null[/code].\n"
"ລັງສີເລີ່ມຈາກ [param from], ປິ່ນໄປທາງ [param dir] ແລະ ຂະຫຍາຍອອກໄປຫາອະສົງໄຂ."

msgid ""
"Returns the first point where this bounding box and the given segment "
"intersect, as a [Vector3]. If no intersection occurs, returns [code]null[/"
"code].\n"
"The segment begins at [param from] and ends at [param to]."
msgstr ""
"ຄືນຄ່າຈຸດທຳອິດທີ່ກ່ອງຂອບນີ້ ແລະ ສ່ວນຂອງເສັ້ນຊື່ (segment) ທີ່ກຳນົດໃຫ້ຕັດກັນ, ເປັນ [Vector3]. "
"ຖ້າບໍ່ມີການຕັດກັນເກີດຂຶ້ນ, ຈະຄືນຄ່າ [code]null[/code].\n"
"ສ່ວນຂອງເສັ້ນຊື່ເລີ່ມຈາກ [param from] ແລະ ສິ້ນສຸດທີ່ [param to]."

msgid ""
"Returns [code]true[/code] if this bounding box and [param aabb] are "
"approximately equal, by calling [method Vector3.is_equal_approx] on the "
"[member position] and the [member size]."
msgstr ""
"ຄືນຄ່າ [code]true[/code] ຖ້າກ່ອງຂອບນີ້ ແລະ [param aabb] ມີຄ່າໃກ້ຄຽງກັນ, ໂດຍການເອີ້ນໃຊ້ "
"[method Vector3.is_equal_approx] ກັບ [member position] ແລະ [member size]."

msgid ""
"Returns [code]true[/code] if this bounding box's values are finite, by "
"calling [method Vector3.is_finite] on the [member position] and the [member "
"size]."
msgstr ""
"ຄືນຄ່າ [code]true[/code] ຖ້າຄ່າຂອງກ່ອງຂອບນີ້ເປັນຄ່າຈຳກັດ (finite), ໂດຍການເອີ້ນໃຊ້ [method "
"Vector3.is_finite] ກັບ [member position] ແລະ [member size]."

msgid ""
"Returns an [AABB] that encloses both this bounding box and [param with] "
"around the edges. See also [method encloses]."
msgstr ""
"ຄືນຄ່າ [AABB] ທີ່ຄອບຄຸມທັງກ່ອງຂອບນີ້ ແລະ [param with] ຮອບໆຂອບ. ເບິ່ງເພີ່ມເຕີມ [method "
"encloses]."

msgid ""
"The ending point. This is usually the corner on the top-right and back of the "
"bounding box, and is equivalent to [code]position + size[/code]. Setting this "
"point affects the [member size]."
msgstr ""
"ຈຸດສິ້ນສຸດ. ປົກກະຕິແລ້ວແມ່ນມຸມຂວາເທິງ ແລະ ດ້ານຫຼັງຂອງກ່ອງຂອບ, ແລະ ທຽບເທົ່າກັບ [code]position + "
"size[/code]. ການກຳນົດຈຸດນີ້ຈະສົ່ງຜົນຕໍ່ [member size]."

msgid ""
"The origin point. This is usually the corner on the bottom-left and forward "
"of the bounding box."
msgstr "ຈຸດກຳເນີດ. ປົກກະຕິແລ້ວແມ່ນມຸມຊ້າຍລຸ່ມ ແລະ ດ້ານໜ້າຂອງກ່ອງຂອບ."

msgid ""
"The bounding box's width, height, and depth starting from [member position]. "
"Setting this value also affects the [member end] point.\n"
"[b]Note:[/b] It's recommended setting the width, height, and depth to non-"
"negative values. This is because most methods in Godot assume that the "
"[member position] is the bottom-left-forward corner, and the [member end] is "
"the top-right-back corner. To get an equivalent bounding box with non-"
"negative size, use [method abs]."
msgstr ""
"ຄວາມກວ້າງ, ຄວາມສູງ, ແລະ ຄວາມເລິກຂອງກ່ອງຂອບເລີ່ມຈາກ [member position]. "
"ການກຳນົດຄ່ານີ້ຍັງສົ່ງຜົນຕໍ່ຈຸດ [member end] ນຳ.\n"
"[b]ໝາຍເຫດ:[/b] ແນະນຳໃຫ້ກຳນົດຄວາມກວ້າງ, ຄວາມສູງ, ແລະ ຄວາມເລິກເປັນຄ່າທີ່ບໍ່ເປັນລົບ. "
"ນີ້ກໍຍ້ອນວ່າວິທີການສ່ວນໃຫຍ່ໃນ Godot ສົມມຸດວ່າ [member position] ແມ່ນມຸມຊ້າຍ-ລຸ່ມ-ໜ້າ, ແລະ "
"[member end] ແມ່ນມຸມຂວາ-ເທິງ-ຫຼັງ. ເພື່ອໃຫ້ໄດ້ກ່ອງຂອບທີ່ທຽບເທົ່າທີ່ມີຂະໜາດບໍ່ເປັນລົບ, ໃຫ້ໃຊ້ [method "
"abs]."

msgid ""
"Returns [code]true[/code] if the [member position] or [member size] of both "
"bounding boxes are not equal.\n"
"[b]Note:[/b] Due to floating-point precision errors, consider using [method "
"is_equal_approx] instead, which is more reliable."
msgstr ""
"ຄືນຄ່າ [code]true[/code] ຖ້າ [member position] ຫຼື [member size] "
"ຂອງກ່ອງຂອບທັງສອງບໍ່ເທົ່າກັນ.\n"
"[b]ໝາຍເຫດ:[/b] ເນື່ອງຈາກຂໍ້ຜິດພາດຂອງຄວາມຊັດເຈນຂອງຈຸດລອຍ (floating-point precision), "
"ໃຫ້ພິຈາລະນາໃຊ້ [method is_equal_approx] ແທນ ເຊິ່ງຈະໜ້າເຊື່ອຖືໄດ້ຫຼາຍກວ່າ."

msgid ""
"Inversely transforms (multiplies) the [AABB] by the given [Transform3D] "
"transformation matrix, under the assumption that the transformation basis is "
"orthonormal (i.e. rotation/reflection is fine, scaling/skew is not).\n"
"[code]aabb * transform[/code] is equivalent to [code]transform.inverse() * "
"aabb[/code]. See [method Transform3D.inverse].\n"
"For transforming by inverse of an affine transformation (e.g. with scaling) "
"[code]transform.affine_inverse() * aabb[/code] can be used instead. See "
"[method Transform3D.affine_inverse]."
msgstr ""
"ແປງຄ່າຍ້ອນກັບ (ຄູນ) [AABB] ດ້ວຍເມທຣິກການແປງ [Transform3D] ທີ່ກຳນົດໃຫ້, "
"ພາຍໃຕ້ສົມມຸດຕິຖານວ່າພື້ນຖານການແປງແມ່ນແບບອໍໂທນໍມໍ (orthonormal) (ຄື: ການໝູນ/"
"ການສະທ້ອນແມ່ນໃຊ້ໄດ້, ແຕ່ການປັບຂະໜາດ/ການບິດບ້ຽວແມ່ນໃຊ້ບໍ່ໄດ້).\n"
"[code]aabb * transform[/code] ແມ່ນທຽບເທົ່າກັບ [code]transform.inverse() * aabb[/"
"code]. ເບິ່ງ [method Transform3D.inverse].\n"
"ສຳລັບການແປງດ້ວຍຄ່າຍ້ອນກັບຂອງການແປງແບບແອບຟາຍ (affine transformation) (ເຊັ່ນ: "
"ການປັບຂະໜາດ) ສາມາດໃຊ້ [code]transform.affine_inverse() * aabb[/code] ແທນໄດ້. ເບິ່ງ "
"[method Transform3D.affine_inverse]."

msgid ""
"Returns [code]true[/code] if both [member position] and [member size] of the "
"bounding boxes are exactly equal, respectively.\n"
"[b]Note:[/b] Due to floating-point precision errors, consider using [method "
"is_equal_approx] instead, which is more reliable."
msgstr ""
"ຄືນຄ່າ [code]true[/code] ຖ້າທັງ [member position] ແລະ [member size] "
"ຂອງກ່ອງຂອບເທົ່າກັນຢ່າງຊັດເຈນ.\n"
"[b]ໝາຍເຫດ:[/b] ເນື່ອງຈາກຂໍ້ຜິດພາດຂອງຄວາມຊັດເຈນຂອງຈຸດລອຍ (floating-point precision), "
"ໃຫ້ພິຈາລະນາໃຊ້ [method is_equal_approx] ແທນ ເຊິ່ງຈະໜ້າເຊື່ອຖືໄດ້ຫຼາຍກວ່າ."

msgid "A base dialog used for user notification."
msgstr "ໜ້າຕ່າງໂຕ້ຕອບ (dialog) ພື້ນຖານທີ່ໃຊ້ສຳລັບການແຈ້ງເຕືອນຜູ້ໃຊ້."

msgid ""
"Adds a button with label [param text] and a custom [param action] to the "
"dialog and returns the created button.\n"
"If [param action] is not empty, pressing the button will emit the [signal "
"custom_action] signal with the specified action string.\n"
"If [code]true[/code], [param right] will place the button to the right of any "
"sibling buttons.\n"
"You can use [method remove_button] method to remove a button created with "
"this method from the dialog."
msgstr ""
"ເພີ່ມປຸ່ມທີ່ມີປ້າຍຊື່ [param text] ແລະ ການກະທຳແບບກຳນົດເອງ [param action] ເຂົ້າໃນໜ້າຕ່າງໂຕ້ຕອບ "
"ແລະ ຄືນຄ່າປຸ່ມທີ່ສ້າງຂຶ້ນ.\n"
"ຖ້າ [param action] ບໍ່ວ່າງເປົ່າ, ການກົດປຸ່ມຈະສົ່ງສັນຍານ [signal custom_action] "
"ພ້ອມກັບຂໍ້ຄວາມການກະທຳທີ່ລະບຸໄວ້.\n"
"ຖ້າເປັນ [code]true[/code], [param right] "
"ຈະວາງປຸ່ມໄວ້ທາງດ້ານຂວາຂອງປຸ່ມອື່ນໆໃນລະດັບດຽວກັນ.\n"
"ທ່ານສາມາດໃຊ້ວິທີ [method remove_button] ເພື່ອລົບປຸ່ມທີ່ສ້າງຂຶ້ນດ້ວຍວິທີນີ້ອອກຈາກໜ້າຕ່າງໂຕ້ຕອບ."

msgid ""
"Adds a button with label [param name] and a cancel action to the dialog and "
"returns the created button.\n"
"You can use [method remove_button] method to remove a button created with "
"this method from the dialog."
msgstr ""
"ເພີ່ມປຸ່ມທີ່ມີປ້າຍຊື່ [param name] ແລະ ການກະທຳຍົກເລີກເຂົ້າໃນໜ້າຕ່າງໂຕ້ຕອບ ແລະ ຄືນຄ່າປຸ່ມທີ່ສ້າງຂຶ້ນ.\n"
"ທ່ານສາມາດໃຊ້ວິທີ [method remove_button] ເພື່ອລົບປຸ່ມທີ່ສ້າງຂຶ້ນດ້ວຍວິທີນີ້ອອກຈາກໜ້າຕ່າງໂຕ້ຕອບ."

msgid ""
"Returns the label used for built-in text.\n"
"[b]Warning:[/b] This is a required internal node, removing and freeing it may "
"cause a crash. If you wish to hide it or any of its children, use their "
"[member CanvasItem.visible] property."
msgstr ""
"ຄືນຄ່າປ້າຍຊື່ (label) ທີ່ໃຊ້ສຳລັບຂໍ້ຄວາມທີ່ມີມາໃຫ້.\n"
"[b]ຄຳເຕືອນ:[/b] ນີ້ແມ່ນໂນດພາຍໃນທີ່ຈຳເປັນ, ການລົບ ຫຼື "
"ການຄືນໜ່ວຍຄວາມຈຳຂອງມັນອາດເຮັດໃຫ້ໂປຣແກຣມຢຸດເຮັດວຽກໄດ້. ຖ້າທ່ານຕ້ອງການເຊື່ອງມັນ ຫຼື ລູກຂອງມັນ, "
"ໃຫ້ໃຊ້ຄຸນສົມບັດ [member CanvasItem.visible] ຂອງພວກມັນແທນ."

msgid ""
"Returns the OK [Button] instance.\n"
"[b]Warning:[/b] This is a required internal node, removing and freeing it may "
"cause a crash. If you wish to hide it or any of its children, use their "
"[member CanvasItem.visible] property."
msgstr ""
"ຄືນຄ່າອິນສະແຕນຊ໌ [Button] ຕົກລົງ (OK).\n"
"[b]ຄຳເຕືອນ:[/b] ນີ້ແມ່ນໂນດພາຍໃນທີ່ຈຳເປັນ, ການລົບ ຫຼື "
"ການຄືນໜ່ວຍຄວາມຈຳຂອງມັນອາດເຮັດໃຫ້ໂປຣແກຣມຢຸດເຮັດວຽກໄດ້. ຖ້າທ່ານຕ້ອງການເຊື່ອງມັນ ຫຼື ລູກຂອງມັນ, "
"ໃຫ້ໃຊ້ຄຸນສົມບັດ [member CanvasItem.visible] ຂອງພວກມັນແທນ."

msgid ""
"Registers a [LineEdit] in the dialog. When the enter key is pressed, the "
"dialog will be accepted."
msgstr "ລົງທະບຽນ [LineEdit] ໃນໜ້າຕ່າງໂຕ້ຕອບ. ເມື່ອກົດປຸ່ມ enter, ໜ້າຕ່າງໂຕ້ຕອບຈະຖືກຍອມຮັບ."

msgid ""
"Removes the [param button] from the dialog. Does NOT free the [param button]. "
"The [param button] must be a [Button] added with [method add_button] or "
"[method add_cancel_button] method. After removal, pressing the [param button] "
"will no longer emit this dialog's [signal custom_action] or [signal canceled] "
"signals."
msgstr ""
"ລົບ [param button] ອອກຈາກໜ້າຕ່າງໂຕ້ຕອບ. ແຕ່ຈະ [b]ບໍ່[/b] ຄືນໜ່ວຍຄວາມຈຳຂອງ [param "
"button]. ປຸ່ມ [param button] ຕ້ອງແມ່ນ [Button] ທີ່ເພີ່ມດ້ວຍວິທີ [method add_button] ຫຼື "
"[method add_cancel_button]. ຫຼັງຈາກລົບອອກແລ້ວ, ການກົດປຸ່ມ [param button] ຈະບໍ່ສົ່ງສັນຍານ "
"[signal custom_action] ຫຼື [signal canceled] ຂອງໜ້າຕ່າງໂຕ້ຕອບນີ້ອີກຕໍ່ໄປ."

msgid "Sets autowrapping for the text in the dialog."
msgstr "ກຳນົດການຕັດຂຶ້ນແຖວໃໝ່ອັດຕະໂນມັດ (autowrapping) ສຳລັບຂໍ້ຄວາມໃນໜ້າຕ່າງໂຕ້ຕອບ."

msgid ""
"If [code]true[/code], the dialog will be hidden when the "
"[code]ui_close_dialog[/code] action is pressed (by default, this action is "
"bound to [kbd]Escape[/kbd], or [kbd]Cmd + W[/kbd] on macOS)."
msgstr ""
"ຖ້າເປັນ [code]true[/code], ໜ້າຕ່າງໂຕ້ຕອບຈະຖືກເຊື່ອງເມື່ອມີການກົດການກະທຳ "
"[code]ui_close_dialog[/code] (ໂດຍເລີ່ມຕົ້ນ, ການກະທຳນີ້ຈະຖືກຜູກໄວ້ກັບປຸ່ມ [kbd]Escape[/"
"kbd], ຫຼື [kbd]Cmd + W[/kbd] ໃນ macOS)."

msgid ""
"If [code]true[/code], the dialog is hidden when the OK button is pressed. You "
"can set it to [code]false[/code] if you want to do e.g. input validation when "
"receiving the [signal confirmed] signal, and handle hiding the dialog in your "
"own logic.\n"
"[b]Note:[/b] Some nodes derived from this class can have a different default "
"value, and potentially their own built-in logic overriding this setting. For "
"example [FileDialog] defaults to [code]false[/code], and has its own input "
"validation code that is called when you press OK, which eventually hides the "
"dialog if the input is valid. As such, this property can't be used in "
"[FileDialog] to disable hiding the dialog when pressing OK."
msgstr ""
"ຖ້າເປັນ [code]true[/code], ໜ້າຕ່າງໂຕ້ຕອບຈະຖືກເຊື່ອງເມື່ອມີການກົດປຸ່ມ OK. ທ່ານສາມາດກຳນົດເປັນ "
"[code]false[/code] ໄດ້ ຖ້າທ່ານຕ້ອງການເຮັດບາງຢ່າງ ເຊັ່ນ: ການກວດສອບຂໍ້ມູນຂາເຂົ້າ (input "
"validation) ເມື່ອໄດ້ຮັບສັນຍານ [signal confirmed], ແລະ "
"ຈັດການການເຊື່ອງໜ້າຕ່າງໂຕ້ຕອບດ້ວຍຕັກກະຂອງທ່ານເອງ.\n"
"[b]ໝາຍເຫດ:[/b] ບາງໂນດທີ່ສືບທອດມາຈາກຄລາດນີ້ອາດມີຄ່າເລີ່ມຕົ້ນທີ່ແຕກຕ່າງກັນ, ແລະ "
"ອາດຈະມີຕັກກະພາຍໃນຂອງມັນເອງທີ່ຂຽນທັບການກຳນົດຄ່ານີ້. ຕົວຢ່າງ: [FileDialog] ມີຄ່າເລີ່ມຕົ້ນເປັນ "
"[code]false[/code], ແລະ ມີລະຫັດກວດສອບຂໍ້ມູນຂອງມັນເອງທີ່ຈະຖືກເອີ້ນໃຊ້ເມື່ອທ່ານກົດ OK, "
"ເຊິ່ງໃນທີ່ສຸດມັນຈະເຊື່ອງໜ້າຕ່າງໂຕ້ຕອບເອງຖ້າຂໍ້ມູນຖືກຕ້ອງ. ດັ່ງນັ້ນ, ຄຸນສົມບັດນີ້ຈຶ່ງບໍ່ສາມາດໃຊ້ໃນ "
"[FileDialog] ເພື່ອປິດການເຊື່ອງໜ້າຕ່າງໂຕ້ຕອບເມື່ອກົດ OK ໄດ້."

msgid "The text displayed by the dialog."
msgstr "ຂໍ້ຄວາມທີ່ສະແດງໂດຍໜ້າຕ່າງໂຕ້ຕອບ."

msgid ""
"The text displayed by the OK button (see [method get_ok_button]). If empty, a "
"default text will be used."
msgstr ""
"ຂໍ້ຄວາມທີ່ສະແດງຢູ່ປຸ່ມ OK (ເບິ່ງ [method get_ok_button]). ຖ້າວ່າງເປົ່າ, ຈະໃຊ້ຂໍ້ຄວາມເລີ່ມຕົ້ນ."

msgid ""
"Emitted when the dialog is closed or the button created with [method "
"add_cancel_button] is pressed."
msgstr ""
"ສົ່ງສັນຍານເມື່ອໜ້າຕ່າງໂຕ້ຕອບຖືກປິດ ຫຼື ປຸ່ມທີ່ສ້າງຂຶ້ນດ້ວຍວິທີ [method add_cancel_button] ຖືກກົດ."

msgid "Emitted when the dialog is accepted, i.e. the OK button is pressed."
msgstr "ສົ່ງສັນຍານເມື່ອໜ້າຕ່າງໂຕ້ຕອບຖືກຍອມຮັບ, ຄື ເມື່ອປຸ່ມ OK ຖືກກົດ."

msgid ""
"Emitted when a custom button with an action is pressed. See [method "
"add_button]."
msgstr "ສົ່ງສັນຍານເມື່ອປຸ່ມກຳນົດເອງທີ່ມີການກະທຳຖືກກົດ. ເບິ່ງ [method add_button]."

msgid ""
"The minimum height of each button in the bottom row (such as OK/Cancel) in "
"pixels. This can be increased to make buttons with short texts easier to "
"click/tap."
msgstr ""
"ຄວາມສູງຂັ້ນຕ່ຳຂອງແຕ່ລະປຸ່ມໃນແຖວລຸ່ມ (ເຊັ່ນ OK/Cancel) ເປັນພິກເຊລ. "
"ສາມາດເພີ່ມຄ່ານີ້ເພື່ອໃຫ້ປຸ່ມທີ່ມີຂໍ້ຄວາມສັ້ນໆ ກົດໄດ້ງ່າຍຂຶ້ນ."

msgid ""
"The minimum width of each button in the bottom row (such as OK/Cancel) in "
"pixels. This can be increased to make buttons with short texts easier to "
"click/tap."
msgstr ""
"ຄວາມກວ້າງຂັ້ນຕ່ຳຂອງແຕ່ລະປຸ່ມໃນແຖວລຸ່ມ (ເຊັ່ນ OK/Cancel) ເປັນພິກເຊລ. "
"ສາມາດເພີ່ມຄ່ານີ້ເພື່ອໃຫ້ປຸ່ມທີ່ມີຂໍ້ຄວາມສັ້ນໆ ກົດໄດ້ງ່າຍຂຶ້ນ."

msgid ""
"The size of the vertical space between the dialog's content and the button "
"row."
msgstr "ຂະໜາດຂອງຊ່ອງຫວ່າງແນວຕັ້ງລະຫວ່າງເນື້ອຫາຂອງໜ້າຕ່າງໂຕ້ຕອບ ແລະ ແຖວຂອງປຸ່ມ."

msgid "The panel that fills the background of the window."
msgstr "ແຜງ (panel) ທີ່ເຕັມພື້ນຫຼັງຂອງໜ້າຕ່າງ."

msgid "A server interface for screen reader support."
msgstr "ອິນເຕີເຟດເຊີເວີສຳລັບການຮອງຮັບເຄື່ອງອ່ານໜ້າຈໍ (screen reader)."

msgid ""
"Creates a new, empty accessibility element resource.\n"
"[b]Note:[/b] An accessibility element is created and freed automatically for "
"each [Node]. In general, this function should not be called manually."
msgstr ""
"ສ້າງຊັບພະຍາກອນອົງປະກອບການເຂົ້າເຖິງ (accessibility element) ໃໝ່ທີ່ວ່າງເປົ່າ.\n"
"[b]ໝາຍເຫດ:[/b] ອົງປະກອບການເຂົ້າເຖິງຈະຖືກສ້າງ ແລະ ຄືນໜ່ວຍຄວາມຈຳໂດຍອັດຕະໂນມັດສຳລັບແຕ່ລະ "
"[Node]. ໂດຍທົ່ວໄປແລ້ວ, ຟັງຊັນນີ້ບໍ່ຄວນຖືກເອີ້ນໃຊ້ດ້ວຍຕົນເອງ."

msgid ""
"Creates a new, empty accessibility sub-element resource. Sub-elements can be "
"used to provide accessibility information for objects which are not [Node]s, "
"such as list items, table cells, or menu items. Sub-elements are freed "
"automatically when the parent element is freed, or can be freed early using "
"the [method free_element] method."
msgstr ""
"ສ້າງຊັບພະຍາກອນອົງປະກອບຍ່ອຍການເຂົ້າເຖິງໃໝ່ທີ່ວ່າງເປົ່າ. "
"ອົງປະກອບຍ່ອຍສາມາດໃຊ້ເພື່ອໃຫ້ຂໍ້ມູນການເຂົ້າເຖິງສຳລັບວັດຖຸທີ່ບໍ່ແມ່ນ [Node], ເຊັ່ນ ລາຍການໃນລາຍຊື່, "
"ຫ້ອງໃນຕາຕະລາງ, ຫຼື ລາຍການໃນເມນູ. "
"ອົງປະກອບຍ່ອຍຈະຖືກຄືນໜ່ວຍຄວາມຈຳໂດຍອັດຕະໂນມັດເມື່ອອົງປະກອບຫຼັກຖືກຄືນໜ່ວຍຄວາມຈຳ, ຫຼື "
"ສາມາດຄືນໜ່ວຍຄວາມຈຳກ່ອນໄດ້ໂດຍໃຊ້ວິທີ [method free_element]."

msgid ""
"Creates a new, empty accessibility sub-element from the shaped text buffer. "
"Sub-elements are freed automatically when the parent element is freed, or can "
"be freed early using the [method free_element] method.\n"
"If [param is_last_line] is [code]true[/code], no trailing newline is appended "
"to the text content. Set to [code]true[/code] for the last line in multi-line "
"text fields and for single-line text fields."
msgstr ""
"ສ້າງອົງປະກອບຍ່ອຍການເຂົ້າເຖິງໃໝ່ທີ່ວ່າງເປົ່າຈາກບັບເຟີຂໍ້ຄວາມ (shaped text buffer). "
"ອົງປະກອບຍ່ອຍຈະຖືກຄືນໜ່ວຍຄວາມຈຳໂດຍອັດຕະໂນມັດເມື່ອອົງປະກອບຫຼັກຖືກຄືນໜ່ວຍຄວາມຈຳ, ຫຼື "
"ສາມາດຄືນໜ່ວຍຄວາມຈຳກ່ອນໄດ້ໂດຍໃຊ້ວິທີ [method free_element].\n"
"ຖ້າ [param is_last_line] ເປັນ [code]true[/code], "
"ຈະບໍ່ມີການເພີ່ມການຂຶ້ນແຖວໃໝ່ຕໍ່ທ້າຍເນື້ອຫາຂໍ້ຄວາມ. ໃຫ້ກຳນົດເປັນ [code]true[/code] "
"ສຳລັບແຖວສຸດທ້າຍໃນຟີວຂໍ້ຄວາມຫຼາຍແຖວ ແລະ ສຳລັບຟີວຂໍ້ຄວາມແຖວດຽວ."

msgid "Returns the metadata of the accessibility element [param id]."
msgstr "ຄືນຄ່າຂໍ້ມູນເມຕາ (metadata) ຂອງອົງປະກອບການເຂົ້າເຖິງ [param id]."

msgid ""
"Sets the metadata of the accessibility element [param id] to [param meta]."
msgstr "ກຳນົດຂໍ້ມູນເມຕາຂອງອົງປະກອບການເຂົ້າເຖິງ [param id] ເປັນ [param meta]."

msgid ""
"Frees the accessibility element [param id] created by [method "
"create_element], [method create_sub_element], or [method "
"create_sub_text_edit_elements]."
msgstr ""
"ຄືນໜ່ວຍຄວາມຈຳຂອງອົງປະກອບການເຂົ້າເຖິງ [param id] ທີ່ສ້າງໂດຍ [method create_element], "
"[method create_sub_element], ຫຼື [method create_sub_text_edit_elements]."

msgid "Returns the main accessibility element of the OS native window."
msgstr "ຄືນຄ່າອົງປະກອບການເຂົ້າເຖິງຫຼັກຂອງໜ້າຕ່າງລະບົບປະຕິບັດການ (OS native window)."

msgid ""
"Returns [code]true[/code] if [param id] is a valid accessibility element."
msgstr "ຄືນຄ່າ [code]true[/code] ຖ້າ [param id] ແມ່ນອົງປະກອບການເຂົ້າເຖິງທີ່ຖືກຕ້ອງ."

msgid ""
"Returns [code]true[/code] if screen reader is support by this implementation."
msgstr "ຄືນຄ່າ [code]true[/code] ຖ້າການເຮັດວຽກນີ້ຮອງຮັບເຄື່ອງອ່ານໜ້າຈໍ (screen reader)."

msgid ""
"Sets the window focused state for assistive apps.\n"
"[b]Note:[/b] This method is implemented on Linux, macOS, and Windows.\n"
"[b]Note:[/b] Advanced users only! [Window] objects call this method "
"automatically."
msgstr ""
"ກຳນົດສະຖານະການໂຟກັສຂອງໜ້າຕ່າງສຳລັບແອັບຊ່ວຍເຫຼືອ (assistive apps).\n"
"[b]ໝາຍເຫດ:[/b] ວິທີການນີ້ຖືກຕິດຕັ້ງໃນ Linux, macOS, ແລະ Windows.\n"
"[b]ໝາຍເຫດ:[/b] ສຳລັບຜູ້ໃຊ້ຂັ້ນສູງເທົ່ານັ້ນ! ວັດຖຸ [Window] ຈະເອີ້ນໃຊ້ວິທີການນີ້ໂດຍອັດຕະໂນມັດ."

msgid ""
"Sets window outer (with decorations) and inner (without decorations) bounds "
"for assistive apps.\n"
"[b]Note:[/b] This method is implemented on Linux, macOS, and Windows.\n"
"[b]Note:[/b] Advanced users only! [Window] objects call this method "
"automatically."
msgstr ""
"ກຳນົດຂອບເຂດພາຍນອກ (ລວມທັງສ່ວນຕົບແຕ່ງ) ແລະ ພາຍໃນ (ບໍ່ລວມສ່ວນຕົບແຕ່ງ) "
"ຂອງໜ້າຕ່າງສຳລັບແອັບຊ່ວຍເຫຼືອ.\n"
"[b]ໝາຍເຫດ:[/b] ວິທີການນີ້ຖືກຕິດຕັ້ງໃນ Linux, macOS, ແລະ Windows.\n"
"[b]ໝາຍເຫດ:[/b] ສຳລັບຜູ້ໃຊ້ຂັ້ນສູງເທົ່ານັ້ນ! ວັດຖຸ [Window] ຈະເອີ້ນໃຊ້ວິທີການນີ້ໂດຍອັດຕະໂນມັດ."

msgid ""
"Adds a callback for the accessibility action (action which can be performed "
"by using a special screen reader command or buttons on the Braille display), "
"and marks this action as supported. The action callback receives one "
"[Variant] argument, which value depends on action type."
msgstr ""
"ເພີ່ມຄໍແບັກ (callback) ສຳລັບການກະທຳການເຂົ້າເຖິງ "
"(ການກະທຳທີ່ສາມາດເຮັດໄດ້ໂດຍການໃຊ້ຄຳສັ່ງເຄື່ອງອ່ານໜ້າຈໍພິເສດ ຫຼື ປຸ່ມໃນຈໍສະແດງຜົນອັກສອນເບຣວ), ແລະ "
"ໝາຍວ່າການກະທຳນີ້ໄດ້ຮັບການຮອງຮັບ. ຄໍແບັກການກະທຳຈະໄດ້ຮັບໜຶ່ງອາກິວເມນ [Variant], "
"ເຊິ່ງຄ່າຂອງມັນຈະຂຶ້ນກັບປະເພດຂອງການກະທຳ."

msgid ""
"Adds a child accessibility element.\n"
"[b]Note:[/b] [Node] children and sub-elements are added to the child list "
"automatically."
msgstr ""
"ເພີ່ມອົງປະກອບຍ່ອຍການເຂົ້າເຖິງ.\n"
"[b]ໝາຍເຫດ:[/b] ລູກຂອງ [Node] ແລະ ອົງປະກອບຍ່ອຍຈະຖືກເພີ່ມເຂົ້າໃນລາຍຊື່ລູກໂດຍອັດຕະໂນມັດ."

msgid ""
"Adds support for a custom accessibility action. [param action_id] is passed "
"as an argument to the callback of [constant ACTION_CUSTOM] action."
msgstr ""
"ເພີ່ມການຮອງຮັບສຳລັບການກະທຳການເຂົ້າເຖິງແບບກຳນົດເອງ. [param action_id] "
"ຈະຖືກສົ່ງເປັນອາກິວເມນໃຫ້ກັບຄໍແບັກຂອງການກະທຳ [constant ACTION_CUSTOM]."

msgid "Adds an element that is controlled by this element."
msgstr "ເພີ່ມອົງປະກອບທີ່ຖືກຄວບຄຸມໂດຍອົງປະກອບນີ້."

msgid "Adds an element that describes this element."
msgstr "ເພີ່ມອົງປະກອບທີ່ອະທິບາຍອົງປະກອບນີ້."

msgid "Adds an element that details this element."
msgstr "ເພີ່ມອົງປະກອບທີ່ໃຫ້ລາຍລະອຽດກ່ຽວກັບອົງປະກອບນີ້."

msgid "Adds an element that this element flow into."
msgstr "ເພີ່ມອົງປະກອບທີ່ອົງປະກອບນີ້ຈະໄຫຼໄປຫາ."

msgid "Adds an element that labels this element."
msgstr "ເພີ່ມອົງປະກອບທີ່ໃຊ້ເປັນປ້າຍຊື່ໃຫ້ກັບອົງປະກອບນີ້."

msgid ""
"Adds an element that is part of the same radio group.\n"
"[b]Note:[/b] This method should be called on each element of the group, using "
"all other elements as [param related_id]."
msgstr ""
"ເພີ່ມອົງປະກອບທີ່ເປັນສ່ວນໜຶ່ງຂອງກຸ່ມວິທະຍຸ (radio group) ດຽວກັນ.\n"
"[b]ໝາຍເຫດ:[/b] ວິທີການນີ້ຄວນຖືກເອີ້ນໃຊ້ໃນແຕ່ລະອົງປະກອບຂອງກຸ່ມ, ໂດຍໃຊ້ອົງປະກອບອື່ນໆທັງໝົດເປັນ "
"[param related_id]."

msgid "Adds an element that is an active descendant of this element."
msgstr "ເພີ່ມອົງປະກອບທີ່ເປັນລູກຫຼານທີ່ກຳລັງເຮັດວຽກ (active descendant) ຂອງອົງປະກອບນີ້."

msgid "Sets element background color."
msgstr "ກຳນົດສີພື້ນຫຼັງຂອງອົງປະກອບ."

msgid "Sets element bounding box, relative to the node position."
msgstr "ກຳນົດກ່ອງຂອບ (bounding box) ຂອງອົງປະກອບ, ທີ່ທຽບກັບຕຳແໜ່ງຂອງໂນດ."

msgid "Sets element accessibility label for Braille display."
msgstr "ກຳນົດປ້າຍຊື່ການເຂົ້າເຖິງຂອງອົງປະກອບສຳລັບຈໍສະແດງຜົນອັກສອນເບຣວ."

msgid "Sets element accessibility role description for Braille display."
msgstr "ກຳນົດຄຳອະທິບາຍບົດບາດການເຂົ້າເຖິງຂອງອົງປະກອບສຳລັບຈໍສະແດງຜົນອັກສອນເບຣວ."

msgid "Sets element checked state."
msgstr "ກຳນົດສະຖານະການເລືອກ (checked state) ຂອງອົງປະກອບ."

msgid "Sets element class name."
msgstr "ກຳນົດຊື່ຄລາດ (class name) ຂອງອົງປະກອບ."

msgid "Sets element color value."
msgstr "ກຳນົດຄ່າສີຂອງອົງປະກອບ."

msgid "Sets element accessibility description."
msgstr "ກຳນົດຄຳອະທິບາຍການເຂົ້າເຖິງຂອງອົງປະກອບ."

msgid "Sets an element which contains an error message for this element."
msgstr "ກຳນົດອົງປະກອບທີ່ມີຂໍ້ຄວາມສະແດງຂໍ້ຜິດພາດສຳລັບອົງປະກອບນີ້."

msgid "Sets element accessibility extra information added to the element name."
msgstr "ກຳນົດຂໍ້ມູນເພີ່ມເຕີມການເຂົ້າເຖິງຂອງອົງປະກອບທີ່ເພີ່ມໃສ່ຊື່ອົງປະກອບ."

msgid "Sets element flag."
msgstr "ກຳນົດແຟລັກ (flag) ຂອງອົງປະກອບ."

msgid "Sets currently focused element."
msgstr "ກຳນົດອົງປະກອບທີ່ຖືກໂຟກັສໃນປັດຈຸບັນ."

msgid "Sets element foreground color."
msgstr "ກຳນົດສີຕົວອັກສອນ (foreground color) ຂອງອົງປະກອບ."

msgid "Sets target element for the link."
msgstr "ກຳນົດອົງປະກອບເປົ້າໝາຍສຳລັບລິ້ງ."

msgid "Sets element text language."
msgstr "ກຳນົດພາສາຂອງຂໍ້ຄວາມໃນອົງປະກອບ."

msgid "Sets number of items in the list."
msgstr "ກຳນົດຈຳນວນລາຍການໃນລາຍຊື່."

msgid "Sets list/tree item expanded status."
msgstr "ກຳນົດສະຖານະການຂະຫຍາຍຂອງລາຍການໃນລາຍຊື່/ຕົ້ນໄມ້ (tree)."

msgid "Sets the position of the element in the list."
msgstr "ກຳນົດຕຳແໜ່ງຂອງອົງປະກອບໃນລາຍຊື່."

msgid "Sets the hierarchical level of the element in the list."
msgstr "ກຳນົດລະດັບລຳດັບຂັ້ນ (hierarchical level) ຂອງອົງປະກອບໃນລາຍຊື່."

msgid "Sets list/tree item selected status."
msgstr "ກຳນົດສະຖານະການຖືກເລືອກຂອງລາຍການໃນລາຍຊື່/ຕົ້ນໄມ້."

msgid "Sets the orientation of the list elements."
msgstr "ກຳນົດທິດທາງ (orientation) ຂອງອົງປະກອບໃນລາຍຊື່."

msgid "Sets the priority of the live region updates."
msgstr "ກຳນົດລຳດັບຄວາມສຳຄັນຂອງການອັບເດດເຂດຂໍ້ມູນສົດ (live region)."

msgid "Sets the element to be a member of the group."
msgstr "ກຳນົດອົງປະກອບໃຫ້ເປັນສະມາຊິກຂອງກຸ່ມ."

msgid "Sets element accessibility name."
msgstr "ກຳນົດຊື່ການເຂົ້າເຖິງຂອງອົງປະກອບ."

msgid "Sets next element on the line."
msgstr "ກຳນົດອົງປະກອບຖັດໄປໃນແຖວ."

msgid "Sets numeric value jump."
msgstr "ກຳນົດການກະໂດດຂອງຄ່າຕົວເລກ (numeric value jump)."

msgid "Sets numeric value range."
msgstr "ກຳນົດຊ່ວງຂອງຄ່າຕົວເລກ."

msgid "Sets numeric value step."
msgstr "ກຳນົດຂັ້ນຕອນ (step) ຂອງຄ່າຕົວເລກ."

msgid "Sets numeric value."
msgstr "ກຳນົດຄ່າຕົວເລກ."

msgid "Sets placeholder text."
msgstr "ກຳນົດຂໍ້ຄວາມຕົວຢ່າງ (placeholder text)."

msgid "Sets popup type for popup buttons."
msgstr "ກຳນົດປະເພດປັອບອັບ (popup) ສຳລັບປຸ່ມປັອບອັບ."

msgid "Sets previous element on the line."
msgstr "ກຳນົດອົງປະກອບກ່ອນໜ້າໃນແຖວ."

msgid "Sets element accessibility role."
msgstr "ກຳນົດບົດບາດ (role) ການເຂົ້າເຖິງຂອງອົງປະກອບ."

msgid "Sets element accessibility role description text."
msgstr "ກຳນົດຂໍ້ຄວາມອະທິບາຍບົດບາດການເຂົ້າເຖິງຂອງອົງປະກອບ."

msgid "Sets scroll bar x position."
msgstr "ກຳນົດຕຳແໜ່ງ x ຂອງແຖບເລື່ອນ (scroll bar)."

msgid "Sets scroll bar x range."
msgstr "ກຳນົດຊ່ວງ x ຂອງແຖບເລື່ອນ."

msgid "Sets scroll bar y position."
msgstr "ກຳນົດຕຳແໜ່ງ y ຂອງແຖບເລື່ອນ."

msgid "Sets scroll bar y range."
msgstr "ກຳນົດຊ່ວງ y ຂອງແຖບເລື່ອນ."

msgid "Sets the list of keyboard shortcuts used by element."
msgstr "ກຳນົດລາຍຊື່ປຸ່ມລັດຄີບອດທີ່ໃຊ້ໂດຍອົງປະກອບ."

msgid "Sets human-readable description of the current checked state."
msgstr "ກຳນົດຄຳອະທິບາຍທີ່ຄົນອ່ານເຂົ້າໃຈໄດ້ຂອງສະຖານະການເລືອກໃນປັດຈຸບັນ."

msgid "Sets cell position in the table."
msgstr "ກຳນົດຕຳແໜ່ງຂອງຫ້ອງ (cell) ໃນຕາຕະລາງ."

msgid "Sets cell row/column span."
msgstr "ກຳນົດການລວມແຖວ/ຖັນ (span) ຂອງຫ້ອງ."

msgid "Sets number of columns in the table."
msgstr "ກຳນົດຈຳນວນຖັນໃນຕາຕະລາງ."

msgid "Sets position of the column."
msgstr "ກຳນົດຕຳແໜ່ງຂອງຖັນ."

msgid "Sets number of rows in the table."
msgstr "ກຳນົດຈຳນວນແຖວໃນຕາຕະລາງ."

msgid "Sets position of the row in the table."
msgstr "ກຳນົດຕຳແໜ່ງຂອງແຖວໃນຕາຕະລາງ."

msgid "Sets element text alignment."
msgstr "ກຳນົດການຈັດວາງຂໍ້ຄວາມໃນອົງປະກອບ."

msgid "Sets text underline/overline/strikethrough."
msgstr "ກຳນົດການຂີດກ້ອງ/ຂີດເທິງ/ຂີດຂ້າ ຂໍ້ຄວາມ."

msgid "Sets text orientation."
msgstr "ກຳນົດທິດທາງຂອງຂໍ້ຄວາມ."

msgid ""
"Sets text selection to the text field. [param text_start_id] and [param "
"text_end_id] should be elements created by [method "
"create_sub_text_edit_elements]. Character offsets are relative to the "
"corresponding element."
msgstr ""
"ກຳນົດການເລືອກຂໍ້ຄວາມໃນຟີວຂໍ້ຄວາມ. [param text_start_id] ແລະ [param text_end_id] "
"ຄວນແມ່ນອົງປະກອບທີ່ສ້າງໂດຍ [method create_sub_text_edit_elements]. ຄ່າເລື່ອນຕົວອັກສອນ "
"(character offsets) ຈະທຽບກັບອົງປະກອບທີ່ກ່ຽວຂ້ອງ."

msgid "Sets tooltip text."
msgstr "ກຳນົດຂໍ້ຄວາມຄຳແນະນຳ (tooltip text)."

msgid "Sets element 2D transform."
msgstr "ກຳນົດການແປງຄ່າ 2D (2D transform) ຂອງອົງປະກອບ."

msgid "Sets link URL."
msgstr "ກຳນົດ URL ຂອງລິ້ງ."

msgid "Sets element text value."
msgstr "ກຳນົດຄ່າຂໍ້ຄວາມຂອງອົງປະກອບ."

msgid "Unknown or custom role."
msgstr "ບົດບາດທີ່ບໍ່ຮູ້ຈັກ ຫຼື ແບບກຳນົດເອງ."

msgid "Default dialog button element."
msgstr "ອົງປະກອບປຸ່ມມາດຕະຖານຂອງໜ້າຕ່າງໂຕ້ຕອບ."

msgid "Audio player element."
msgstr "ອົງປະກອບເຄື່ອງຫຼິ້ນສຽງ."

msgid "Video player element."
msgstr "ອົງປະກອບເຄື່ອງຫຼິ້ນວິດີໂອ."

msgid "Non-editable text label."
msgstr "ປ້າຍຂໍ້ຄວາມທີ່ແກ້ໄຂບໍ່ໄດ້."

msgid ""
"Container element. Elements with this role are used for internal structure "
"and ignored by screen readers."
msgstr ""
"ອົງປະກອບກ່ອງບັນຈຸ (container). ອົງປະກອບທີ່ມີບົດບາດນີ້ຖືກໃຊ້ສຳລັບໂຄງສ້າງພາຍໃນ ແລະ "
"ຈະຖືກມອງຂ້າມໂດຍເຄື່ອງອ່ານໜ້າຈໍ."

msgid "Panel container element."
msgstr "ອົງປະກອບກ່ອງບັນຈຸແຜງ (panel)."

msgid "Button element."
msgstr "ອົງປະກອບປຸ່ມ."

msgid "Link element."
msgstr "ອົງປະກອບລິ້ງ."

msgid "Check box element."
msgstr "ອົງປະກອບກ່ອງເລືອກ (check box)."

msgid "Radio button element."
msgstr "ອົງປະກອບປຸ່ມວິທະຍຸ (radio button)."

msgid "Check button element."
msgstr "ອົງປະກອບປຸ່ມເປີດ/ປິດ (check button)."

msgid "Scroll bar element."
msgstr "ອົງປະກອບແຖບເລື່ອນ."

msgid "Scroll container element."
msgstr "ອົງປະກອບກ່ອງບັນຈຸການເລື່ອນ."

msgid "Container splitter handle element."
msgstr "ອົງປະກອບມືຈັບແບ່ງສ່ວນກ່ອງບັນຈຸ (splitter handle)."

msgid "Slider element."
msgstr "ອົງປະກອບແຖບເລື່ອນປັບຄ່າ (slider)."

msgid "Spin box element."
msgstr "ອົງປະກອບກ່ອງປັບຕົວເລກ (spin box)."

msgid "Progress indicator element."
msgstr "ອົງປະກອບສະແດງຄວາມຄືບໜ້າ (progress indicator)."

msgid "Editable text field element."
msgstr "ອົງປະກອບຟີວຂໍ້ຄວາມທີ່ແກ້ໄຂໄດ້."

msgid "Multiline editable text field element."
msgstr "ອົງປະກອບຟີວຂໍ້ຄວາມຫຼາຍແຖວທີ່ແກ້ໄຂໄດ້."

msgid "Color picker element."
msgstr "ອົງປະກອບເຄື່ອງເລືອກສີ (color picker)."

msgid "Table element."
msgstr "ອົງປະກອບຕາຕະລາງ."

msgid "Table/tree cell element."
msgstr "ອົງປະກອບຫ້ອງຕາຕະລາງ/ຕົ້ນໄມ້."

msgid "Table/tree row element."
msgstr "ອົງປະກອບແຖວຕາຕະລາງ/ຕົ້ນໄມ້."

msgid "Table/tree row group element."
msgstr "ອົງປະກອບກຸ່ມແຖວຕາຕະລາງ/ຕົ້ນໄມ້."

msgid "Table/tree row header element."
msgstr "ອົງປະກອບຫົວແຖວຕາຕະລາງ/ຕົ້ນໄມ້."

msgid "Table/tree column header element."
msgstr "ອົງປະກອບຫົວຖັນຕາຕະລາງ/ຕົ້ນໄມ້."

msgid "Tree view element."
msgstr "ອົງປະກອບມຸມມອງຕົ້ນໄມ້ (tree view)."

msgid "Tree view item element."
msgstr "ອົງປະກອບລາຍການໃນມຸມມອງຕົ້ນໄມ້."

msgid "List element."
msgstr "ອົງປະກອບລາຍຊື່ (list)."

msgid "List item element."
msgstr "ອົງປະກອບລາຍການໃນລາຍຊື່."

msgid "List view element."
msgstr "ອົງປະກອບມຸມມອງລາຍຊື່ (list view)."

msgid "List view item element."
msgstr "ອົງປະກອບລາຍການໃນມຸມມອງລາຍຊື່."

msgid "Tab bar element."
msgstr "ອົງປະກອບແຖບແທັບ (tab bar)."

msgid "Tab bar item element."
msgstr "ອົງປະກອບລາຍການໃນແຖບແທັບ."

msgid "Tab panel element."
msgstr "ອົງປະກອບແຜງແທັບ (tab panel)."

msgid "Menu bar element."
msgstr "ອົງປະກອບແຖບເມນູ (menu bar)."

msgid "Popup menu element."
msgstr "ອົງປະກອບເມນູປັອບອັບ."

msgid "Popup menu item element."
msgstr "ອົງປະກອບລາຍການໃນເມນູປັອບອັບ."

msgid "Popup menu check button item element."
msgstr "ອົງປະກອບລາຍການປຸ່ມເປີດ/ປິດ ໃນເມນູປັອບອັບ."

msgid "Popup menu radio button item element."
msgstr "ອົງປະກອບລາຍການປຸ່ມວິທະຍຸ ໃນເມນູປັອບອັບ."

msgid "Image element."
msgstr "ອົງປະກອບຮູບພາບ."

msgid "Window element."
msgstr "ອົງປະກອບໜ້າຕ່າງ."

msgid "Embedded window title bar element."
msgstr "ອົງປະກອບແຖບຊື່ຂອງໜ້າຕ່າງທີ່ຝັງໄວ້."

msgid "Dialog window element."
msgstr "ອົງປະກອບໜ້າຕ່າງໂຕ້ຕອບ."

msgid "Tooltip element."
msgstr "ອົງປະກອບຄຳແນະນຳ (tooltip)."

msgid ""
"Region/landmark element. Screen readers can navigate between regions using "
"landmark navigation."
msgstr ""
"ອົງປະກອບເຂດ/ຈຸດສຳຄັນ (region/landmark). "
"ເຄື່ອງອ່ານໜ້າຈໍສາມາດເຄື່ອນຍ້າຍລະຫວ່າງເຂດຕ່າງໆໂດຍການໃຊ້ການນຳທາງຜ່ານຈຸດສຳຄັນ."

msgid ""
"Unifor text run.\n"
"Note: This role is used for internal text elements, and should not be "
"assigned to nodes."
msgstr ""
"ຊຸດຂໍ້ຄວາມທີ່ເປັນເອກະພາບ (uniform text run).\n"
"ໝາຍເຫດ: ບົດບາດນີ້ໃຊ້ສຳລັບອົງປະກອບຂໍ້ຄວາມພາຍໃນ, ແລະ ບໍ່ຄວນກຳນົດໃຫ້ກັບໂນດ."

msgid "Popup menu."
msgstr "ເມນູປັອບອັບ."

msgid "Popup list."
msgstr "ລາຍຊື່ປັອບອັບ."

msgid "Popup tree view."
msgstr "ມຸມມອງຕົ້ນໄມ້ປັອບອັບ."

msgid "Popup dialog."
msgstr "ໜ້າຕ່າງໂຕ້ຕອບປັອບອັບ."

msgid "Element is hidden for accessibility tools."
msgstr "ອົງປະກອບຖືກເຊື່ອງໄວ້ສຳລັບເຄື່ອງມືການເຂົ້າເຖິງ."

msgid "Element supports multiple item selection."
msgstr "ອົງປະກອບຮອງຮັບການເລືອກຫຼາຍລາຍການ."

msgid "Element require user input."
msgstr "ອົງປະກອບຕ້ອງການຂໍ້ມູນຂາເຂົ້າຈາກຜູ້ໃຊ້."

msgid "Element is a visited link."
