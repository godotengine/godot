"                │           │    └─ LeftIndexDistal\n"
"                │           ├─ LeftMiddleProximal\n"
"                │           │  └─ LeftMiddleIntermediate\n"
"                │           │    └─ LeftMiddleDistal\n"
"                │           ├─ LeftRingProximal\n"
"                │           │  └─ LeftRingIntermediate\n"
"                │           │    └─ LeftRingDistal\n"
