"                │     └─ LeftLowerArm\n"
"                │        └─ LeftHand\n"
"                │           ├─ LeftThumbMetacarpal\n"
"                │           │  └─ LeftThumbProximal\n"
"                │           │    └─ LeftThumbDistal\n"
