" Дивіться також [constant PROPERTY_HINT_LAYERS_2D_RENDER].\n"
"[codeblock]\n"
" @export_flags_2d_render var render_layers: int\n"
" @export_flags_2d_render var render_layers_array: Array[int]\n"
"[/codeblock]"

