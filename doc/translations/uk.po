msgid "Dark orange color."
msgstr "Темно-помаранчевий колір."

msgid "Dark orchid color."
msgstr "Темний колір орхідеї."

msgid "Dark red color."
msgstr "Темно-червоного кольору."

msgid "Dark salmon color."
msgstr "Темний колір лосося."

msgid "Dark sea green color."
msgstr "Темно-морський зелений колір."

msgid "Dark slate blue color."
