"Returns an associated 4D vector if the provided boolean value is true or "
"false."
msgstr "ຄືນຄ່າເວັກເຕີ 4D ທີ່ກ່ຽວຂ້ອງ ຖ້າຄ່າບູນລີນທີ່ໃຫ້ມາເປັນ ຈິງ ຫຼື ເທັດ."

msgid ""
"Returns an associated boolean if the provided boolean value is true or false."
msgstr "ຄືນຄ່າບູນລີນທີ່ກ່ຽວຂ້ອງ ຖ້າຄ່າບູນລີນທີ່ໃຫ້ມາເປັນ ຈິງ ຫຼື ເທັດ."

msgid ""
"Returns an associated floating-point scalar if the provided boolean value is "
"true or false."
msgstr "ຄືນຄ່າສະກາລາຈຸດທົດສະນິຍົມ ຖ້າຄ່າບູນລີນທີ່ໃຫ້ມາເປັນ ຈິງ ຫຼື ເທັດ."

msgid ""
"Returns an associated integer scalar if the provided boolean value is true or "
"false."
msgstr "ຄືນຄ່າສະກາລາຈຳນວນຖ້ວນ ຖ້າຄ່າບູນລີນທີ່ໃຫ້ມາເປັນ ຈິງ ຫຼື ເທັດ."

msgid ""
"Returns an associated transform if the provided boolean value is true or "
"false."
msgstr "ຄືນຄ່າການແປງ (transform) ທີ່ກ່ຽວຂ້ອງ ຖ້າຄ່າບູນລີນທີ່ໃຫ້ມາເປັນ ຈິງ ຫຼື ເທັດ."

msgid ""
"Returns an associated unsigned integer scalar if the provided boolean value "
"is true or false."
msgstr "ຄືນຄ່າສະກາລາຈຳນວນຖ້ວນບວກ (unsigned) ຖ້າຄ່າບູນລີນທີ່ໃຫ້ມາເປັນ ຈິງ ຫຼື ເທັດ."

msgid "Returns the boolean result of the comparison between two parameters."
msgstr "ຄືນຄ່າຜົນລັດບູນລີນຈາກການປຽບທຽບລະຫວ່າງສອງພາລາມິເຕີ."

msgid ""
"Returns the boolean result of the comparison between INF (or NaN) and a "
"scalar parameter."
msgstr "ຄືນຄ່າຜົນລັດບູນລີນຈາກການປຽບທຽບລະຫວ່າງ INF (ຫຼື NaN) ແລະ ພາລາມິເຕີສະກາລາ."

msgid "Boolean constant."
msgstr "ຄ່າຄົງທີ່ບູນລີນ."

msgid "Boolean parameter."
msgstr "ພາລາມິເຕີບູນລີນ."

msgid "Translated to '%s' in Godot Shading Language."
msgstr "ຖືກແປເປັນ '%s' ໃນພາສາ Godot Shading."

msgid "'%s' input parameter for all shader modes."
msgstr "ພາລາມິເຕີຂາເຂົ້າ '%s' ສຳລັບທຸກໂໝດເຊດເດີ."

msgid "Input parameter."
msgstr "ພາລາມິເຕີຂາເຂົ້າ."

msgid "'%s' input parameter for vertex and fragment shader modes."
msgstr "ພາລາມິເຕີຂາເຂົ້າ '%s' ສຳລັບໂໝດ vertex ແລະ fragment."

msgid "'%s' input parameter for fragment and light shader modes."
msgstr "ພາລາມິເຕີຂາເຂົ້າ '%s' ສຳລັບໂໝດ fragment ແລະ light."

msgid "'%s' input parameter for fragment shader mode."
msgstr "ພາລາມິເຕີຂາເຂົ້າ '%s' ສຳລັບໂໝດ fragment shader."

msgid "'%s' input parameter for sky shader mode."
msgstr "ພາລາມິເຕີຂາເຂົ້າ '%s' ສຳລັບໂໝດ sky shader."

msgid "'%s' input parameter for fog shader mode."
msgstr "ພາລາມິເຕີຂາເຂົ້າ '%s' ສຳລັບໂໝດ fog shader."

msgid "'%s' input parameter for blit shader mode."
msgstr "ພາລາມິເຕີຂາເຂົ້າ '%s' ສຳລັບໂໝດ blit shader."

msgid "'%s' input parameter for light shader mode."
msgstr "ພາລາມິເຕີຂາເຂົ້າ '%s' ສຳລັບໂໝດ light shader."

msgid "'%s' input parameter for vertex shader mode."
msgstr "ພາລາມິເຕີຂາເຂົ້າ '%s' ສຳລັບໂໝດ vertex shader."

msgid "'%s' input parameter for start shader mode."
msgstr "ພາລາມິເຕີຂາເຂົ້າ '%s' ສຳລັບໂໝດ start shader."

msgid "'%s' input parameter for process shader mode."
msgstr "ພາລາມິເຕີຂາເຂົ້າ '%s' ສຳລັບໂໝດ process shader."

msgid "'%s' input parameter for start and process shader modes."
msgstr "ພາລາມິເຕີຂາເຂົ້າ '%s' ສຳລັບໂໝດ start ແລະ process shader."

msgid "'%s' input parameter for process and collide shader modes."
msgstr "ພາລາມິເຕີຂາເຂົ້າ '%s' ສຳລັບໂໝດ process ແລະ collide shader."

msgid ""
"A node for help to multiply a position input vector by rotation using "
"specific axis. Intended to work with emitters."
msgstr ""
"ໂນດທີ່ຊ່ວຍໃນການຄູນເວັກເຕີຕຳແໜ່ງຂາເຂົ້າດ້ວຍການໝຸນຕາມແກນທີ່ກຳນົດ. ອອກແບບມາເພື່ອໃຊ້ກັບ emitters."

msgid "Float function."
msgstr "ຟັງຊັນເລກທົດສະນິຍົມ (Float)."

msgid "Float operator."
msgstr "ຕົວດຳເນີນການເລກທົດສະນິຍົມ (Float)."

msgid "Integer function."
msgstr "ຟັງຊັນຈຳນວນຖ້ວນ (Integer)."

msgid "Integer operator."
msgstr "ຕົວດຳເນີນການຈຳນວນຖ້ວນ (Integer)."

msgid "Unsigned integer function."
msgstr "ຟັງຊັນຈຳນວນຖ້ວນບວກ (Unsigned integer)."

msgid "Unsigned integer operator."
msgstr "ຕົວດຳເນີນການຈຳນວນຖ້ວນບວກ (Unsigned integer)."

msgid "Returns the absolute value of the parameter."
msgstr "ຄືນຄ່າສຳບູນ (absolute value) ຂອງພາລາມິເຕີ."

msgid "Returns the arc-cosine of the parameter."
msgstr "ຄືນຄ່າ arc-cosine ຂອງພາລາມິເຕີ."

msgid "Returns the inverse hyperbolic cosine of the parameter."
msgstr "ຄືນຄ່າ inverse hyperbolic cosine ຂອງພາລາມິເຕີ."

msgid "Returns the arc-sine of the parameter."
msgstr "ຄືນຄ່າ arc-sine ຂອງພາລາມິເຕີ."

msgid "Returns the inverse hyperbolic sine of the parameter."
msgstr "ຄືນຄ່າ inverse hyperbolic sine ຂອງພາລາມິເຕີ."

msgid "Returns the arc-tangent of the parameter."
msgstr "ຄືນຄ່າ arc-tangent ຂອງພາລາມິເຕີ."

msgid "Returns the arc-tangent of the parameters."
msgstr "ຄືນຄ່າ arc-tangent ຂອງພາລາມິເຕີ."

msgid "Returns the inverse hyperbolic tangent of the parameter."
msgstr "ຄືນຄ່າ inverse hyperbolic tangent ຂອງພາລາມິເຕີ."

msgid "Returns the result of bitwise NOT (~a) operation on the integer."
msgstr "ຄືນຄ່າຜົນລັດຈາກການດຳເນີນການ bitwise NOT (~a) ໃນຈຳນວນຖ້ວນ."

msgid ""
"Returns the result of bitwise NOT (~a) operation on the unsigned integer."
msgstr "ຄືນຄ່າຜົນລັດຈາກການດຳເນີນການ bitwise NOT (~a) ໃນຈຳນວນຖ້ວນບວກ."

msgid ""
"Finds the nearest integer that is greater than or equal to the parameter."
msgstr "ຊອກຫາຈຳນວນຖ້ວນທີ່ໃກ້ທີ່ສຸດ ທີ່ມີຄ່າຫຼາຍກວ່າ ຫຼື ເທົ່າກັບພາລາມິເຕີ."

msgid "Constrains a value to lie between two further values."
msgstr "ຈຳກັດຄ່າໃຫ້ຢູ່ລະຫວ່າງສອງຄ່າທີ່ກຳນົດ."

msgid "Returns the cosine of the parameter."
msgstr "ຄືນຄ່າ cosine ຂອງພາລາມິເຕີ."

msgid "Returns the hyperbolic cosine of the parameter."
msgstr "ຄືນຄ່າ hyperbolic cosine ຂອງພາລາມິເຕີ."

msgid "Converts a quantity in radians to degrees."
msgstr "ແປງຄ່າຈາກ ເຣເດຍ (radians) ເປັນ ອົງສາ (degrees)."

msgid ""
"(Fragment/Light mode only) (Scalar) Derivative in 'x' using local "
"differencing."
msgstr ""
"(ສະເພາະໂໝດ Fragment/Light) (Scalar) ອະນຸພັນໃນແກນ 'x' ໂດຍໃຊ້ຄວາມແຕກຕ່າງທ້ອງຖິ່ນ."

msgid ""
"(Fragment/Light mode only) (Scalar) Derivative in 'y' using local "
"differencing."
msgstr ""
"(ສະເພາະໂໝດ Fragment/Light) (Scalar) ອະນຸພັນໃນແກນ 'y' ໂດຍໃຊ້ຄວາມແຕກຕ່າງທ້ອງຖິ່ນ."

msgid "(Scalar) Derivative in 'x' using local differencing."
msgstr "(Scalar) ອະນຸພັນໃນແກນ 'x' ໂດຍໃຊ້ຄວາມແຕກຕ່າງທ້ອງຖິ່ນ."

msgid "(Scalar) Derivative in 'y' using local differencing."
msgstr "(Scalar) ອະນຸພັນໃນແກນ 'y' ໂດຍໃຊ້ຄວາມແຕກຕ່າງທ້ອງຖິ່ນ."

msgid "Base-e Exponential."
msgstr "ເລກກຳລັງຖານ e."

msgid "Base-2 Exponential."
msgstr "ເລກກຳລັງຖານ 2."

msgid "Finds the nearest integer less than or equal to the parameter."
msgstr "ຊອກຫາຈຳນວນຖ້ວນທີ່ໃກ້ທີ່ສຸດ ທີ່ມີຄ່ານ້ອຍກວ່າ ຫຼື ເທົ່າກັບພາລາມິເຕີ."

msgid "Computes the fractional part of the argument."
msgstr "ຄຳນວນຫາສ່ວນເສດ (fractional part) ຂອງອາຄິວເມນ."

msgid "Returns the inverse of the square root of the parameter."
msgstr "ຄືນຄ່າສ່ວນກັບຂອງຮາກຂັ້ນສອງຂອງພາລາມິເຕີ."

msgid "Natural logarithm."
msgstr "ລໍກາຣິດທຳທຳມະຊາດ (Natural logarithm)."

msgid "Base-2 logarithm."
msgstr "ລໍກາຣິດທຳຖານ 2."

msgid "Returns the greater of two values."
msgstr "ຄືນຄ່າທີ່ຫຼາຍກວ່າລະຫວ່າງສອງຄ່າ."

msgid "Returns the lesser of two values."
msgstr "ຄືນຄ່າທີ່ນ້ອຍກວ່າລະຫວ່າງສອງຄ່າ."

msgid "Linear interpolation between two scalars."
msgstr "ການແຊກຄ່າແບບເສັ້ນ (Linear interpolation) ລະຫວ່າງສອງສະກາລາ."

msgid "Performs a fused multiply-add operation (a * b + c) on scalars."
msgstr "ດຳເນີນການຄູນແລ້ວບວກ (fused multiply-add) (a * b + c) ໃນສະກາລາ."

msgid "Returns the opposite value of the parameter."
msgstr "ຄືນຄ່າກົງກັນຂ້າມຂອງພາລາມິເຕີ."

msgid "1.0 - scalar"
msgstr "1.0 - scalar"

msgid ""
"Returns the value of the first parameter raised to the power of the second."
msgstr "ຄືນຄ່າຂອງພາລາມິເຕີທຳອິດ ຍົກກຳລັງດ້ວຍພາລາມິເຕີທີສອງ."

msgid "Converts a quantity in degrees to radians."
msgstr "ແປງຄ່າຈາກ ອົງສາ ເປັນ ເຣເດຍ."

msgid "1.0 / scalar"
msgstr "1.0 / scalar"

msgid "Remaps a value from the input range to the output range."
msgstr "ປ່ຽນຊ່ວງຂອງຄ່າ (Remaps) ຈາກຊ່ວງຂາເຂົ້າ ໄປຫາຊ່ວງຂາອອກ."

msgid "Finds the nearest integer to the parameter."
msgstr "ຊອກຫາຈຳນວນຖ້ວນທີ່ໃກ້ທີ່ສຸດກັບພາລາມິເຕີ."

msgid "Finds the nearest even integer to the parameter."
msgstr "ຊອກຫາຈຳນວນຄູ່ທີ່ໃກ້ທີ່ສຸດກັບພາລາມິເຕີ."

msgid "Clamps the value between 0.0 and 1.0."
msgstr "ຈຳກັດຄ່າໃຫ້ຢູ່ລະຫວ່າງ 0.0 ແລະ 1.0."

msgid "Extracts the sign of the parameter."
msgstr "ດຶງເອົາເຄື່ອງໝາຍ (sign) ຂອງພາລາມິເຕີ."

msgid "Returns the sine of the parameter."
msgstr "ຄືນຄ່າ sine ຂອງພາລາມິເຕີ."

msgid "Returns the hyperbolic sine of the parameter."
msgstr "ຄືນຄ່າ hyperbolic sine ຂອງພາລາມິເຕີ."

msgid "Returns the square root of the parameter."
msgstr "ຄືນຄ່າຮາກຂັ້ນສອງຂອງພາລາມິເຕີ."

msgid ""
"SmoothStep function( scalar(edge0), scalar(edge1), scalar(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge0' and 1.0 if x is larger than "
"'edge1'. Otherwise the return value is interpolated between 0.0 and 1.0 using "
"Hermite polynomials."
msgstr ""
"ຟັງຊັນ SmoothStep( scalar(edge0), scalar(edge1), scalar(x) ).\n"
"\n"
"ຄືນຄ່າ 0.0 ຖ້າ 'x' ນ້ອຍກວ່າ 'edge0' ແລະ ຄືນຄ່າ 1.0 ຖ້າ 'x' ຫຼາຍກວ່າ 'edge1'. ຖ້າບໍ່ດັ່ງນັ້ນ "
"ຄ່າທີ່ຄືນຈະຖືກແຊກລະຫວ່າງ 0.0 ແລະ 1.0 ໂດຍໃຊ້ Hermite polynomials."

msgid ""
"Step function( scalar(edge), scalar(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge' and otherwise 1.0."
msgstr ""
"ຟັງຊັນ Step( scalar(edge), scalar(x) ).\n"
"\n"
"ຄືນຄ່າ 0.0 ຖ້າ 'x' ນ້ອຍກວ່າ 'edge', ຖ້າບໍ່ດັ່ງນັ້ນຄືນຄ່າ 1.0."

msgid ""
"(Fragment/Light mode only) (Scalar) Sum of absolute derivative in 'x' and 'y'."
msgstr "(ສະເພາະໂໝດ Fragment/Light) (Scalar) ຜົນລວມຂອງອະນຸພັນສຳບູນໃນແກນ 'x' ແລະ 'y'."

msgid "(Scalar) Sum of absolute derivative in 'x' and 'y'."
msgstr "(Scalar) ຜົນລວມຂອງອະນຸພັນສຳບູນໃນແກນ 'x' ແລະ 'y'."

msgid "Returns the tangent of the parameter."
msgstr "ຄືນຄ່າ tangent ຂອງພາລາມິເຕີ."

msgid "Returns the hyperbolic tangent of the parameter."
msgstr "ຄືນຄ່າ hyperbolic tangent ຂອງພາລາມິເຕີ."

msgid "Finds the truncated value of the parameter."
msgstr "ຊອກຫາຄ່າທີ່ຖືກຕັດເສດ (truncated value) ຂອງພາລາມິເຕີ."

msgid "Sums two floating-point scalars."
msgstr "ບວກສອງສະກາລາຈຸດທົດສະນິຍົມ."

msgid "Sums two integer scalars."
msgstr "ບວກສອງສະກາລາຈຳນວນຖ້ວນ."

msgid "Sums two unsigned integer scalars."
msgstr "ບວກສອງສະກາລາຈຳນວນຖ້ວນບວກ."

msgid "Returns the result of bitwise AND (a & b) operation for two integers."
msgstr "ຄືນຄ່າຜົນລັດຈາກການດຳເນີນການ bitwise AND (a & b) ຂອງສອງຈຳນວນຖ້ວນ."

msgid ""
"Returns the result of bitwise AND (a & b) operation for two unsigned integers."
msgstr "ຄືນຄ່າຜົນລັດຈາກການດຳເນີນການ bitwise AND (a & b) ຂອງສອງຈຳນວນຖ້ວນບວກ."

msgid ""
"Returns the result of bitwise left shift (a << b) operation on the integer."
msgstr "ຄືນຄ່າຜົນລັດຈາກການດຳເນີນການ bitwise left shift (a << b) ໃນຈຳນວນຖ້ວນ."

msgid ""
"Returns the result of bitwise left shift (a << b) operation on the unsigned "
"integer."
msgstr "ຄືນຄ່າຜົນລັດຈາກການດຳເນີນການ bitwise left shift (a << b) ໃນຈຳນວນຖ້ວນບວກ."

msgid "Returns the result of bitwise OR (a | b) operation for two integers."
msgstr "ຄືນຄ່າຜົນລັດຈາກການດຳເນີນການ bitwise OR (a | b) ຂອງສອງຈຳນວນຖ້ວນ."

msgid ""
"Returns the result of bitwise OR (a | b) operation for two unsigned integers."
msgstr "ຄືນຄ່າຜົນລັດຈາກການດຳເນີນການ bitwise OR (a | b) ຂອງສອງຈຳນວນຖ້ວນບວກ."

msgid ""
"Returns the result of bitwise right shift (a >> b) operation on the integer."
msgstr "ຄືນຄ່າຜົນລັດຈາກການດຳເນີນການ bitwise right shift (a >> b) ໃນຈຳນວນຖ້ວນ."

msgid ""
"Returns the result of bitwise right shift (a >> b) operation on the unsigned "
"integer."
msgstr "ຄືນຄ່າຜົນລັດຈາກການດຳເນີນການ bitwise right shift (a >> b) ໃນຈຳນວນຖ້ວນບວກ."

msgid "Returns the result of bitwise XOR (a ^ b) operation on the integer."
msgstr "ຄືນຄ່າຜົນລັດຈາກການດຳເນີນການ bitwise XOR (a ^ b) ໃນຈຳນວນຖ້ວນ."

msgid ""
"Returns the result of bitwise XOR (a ^ b) operation on the unsigned integer."
msgstr "ຄືນຄ່າຜົນລັດຈາກການດຳເນີນການ bitwise XOR (a ^ b) ໃນຈຳນວນຖ້ວນບວກ."

msgid "Divides two floating-point scalars."
msgstr "ຫານສອງສະກາລາຈຸດທົດສະນິຍົມ."

msgid "Divides two integer scalars."
msgstr "ຫານສອງສະກາລາຈຳນວນຖ້ວນ."

msgid "Divides two unsigned integer scalars."
msgstr "ຫານສອງສະກາລາຈຳນວນຖ້ວນບວກ."

msgid "Multiplies two floating-point scalars."
msgstr "ຄູນສອງສະກາລາຈຸດທົດສະນິຍົມ."

msgid "Multiplies two integer scalars."
msgstr "ຄູນສອງສະກາລາຈຳນວນຖ້ວນ."

msgid "Multiplies two unsigned integer scalars."
msgstr "ຄູນສອງສະກາລາຈຳນວນຖ້ວນບວກ."

msgid "Returns the remainder of the two floating-point scalars."
msgstr "ຄືນຄ່າເສດຈາກການຫານສອງສະກາລາຈຸດທົດສະນິຍົມ."

msgid "Returns the remainder of the two integer scalars."
msgstr "ຄືນຄ່າເສດຈາກການຫານສອງສະກາລາຈຳນວນຖ້ວນ."

msgid "Returns the remainder of the two unsigned integer scalars."
msgstr "ຄືນຄ່າເສດຈາກການຫານສອງສະກາລາຈຳນວນຖ້ວນບວກ."

msgid "Subtracts two floating-point scalars."
msgstr "ລົບສອງສະກາລາຈຸດທົດສະນິຍົມ."

msgid "Subtracts two integer scalars."
msgstr "ລົບສອງສະກາລາຈຳນວນຖ້ວນ."

msgid "Subtracts two unsigned integer scalars."
msgstr "ລົບສອງສະກາລາຈຳນວນຖ້ວນບວກ."

msgid "Scalar floating-point constant."
msgstr "ຄ່າຄົງທີ່ສະກາລາຈຸດທົດສະນິຍົມ."

msgid "Scalar integer constant."
msgstr "ຄ່າຄົງທີ່ສະກາລາຈຳນວນຖ້ວນ."

msgid "Scalar unsigned integer constant."
msgstr "ຄ່າຄົງທີ່ສະກາລາຈຳນວນຖ້ວນບວກ."

msgid "Scalar floating-point parameter."
msgstr "ພາລາມິເຕີສະກາລາຈຸດທົດສະນິຍົມ."

msgid "Scalar integer parameter."
msgstr "ພາລາມິເຕີສະກາລາຈຳນວນຖ້ວນ."

msgid "Scalar unsigned integer parameter."
msgstr "ພາລາມິເຕີສະກາລາຈຳນວນຖ້ວນບວກ."

msgid "Converts screen UV to a SDF."
msgstr "ແປງ screen UV ເປັນ SDF."

msgid "Casts a ray against the screen SDF and returns the distance travelled."
msgstr "ຍິງລັງສີ (ray) ໃສ່ screen SDF ແລະ ຄືນຄ່າໄລຍະທາງທີ່ຜ່ານໄປ."

msgid "Converts a SDF to screen UV."
msgstr "ແປງ SDF ເປັນ screen UV."

msgid "Performs a SDF texture lookup."
msgstr "ດຳເນີນການຄົ້ນຫາ (lookup) ເທັກເຈີ SDF."

msgid "Performs a SDF normal texture lookup."
msgstr "ດຳເນີນການຄົ້ນຫາເທັກເຈີ Normal ຂອງ SDF."

msgid "Function to be applied on texture coordinates."
msgstr "ຟັງຊັນທີ່ຈະນຳໃຊ້ກັບພິກັດເທັກເຈີ (texture coordinates)."

msgid "Polar coordinates conversion applied on texture coordinates."
msgstr "ການແປງພິກັດໂພລາ (polar coordinates) ທີ່ໃຊ້ກັບພິກັດເທັກເຈີ."

msgid "Perform the cubic texture lookup."
msgstr "ດຳເນີນການຄົ້ນຫາເທັກເຈີແບບ cubic."

msgid "Perform the curve texture lookup."
msgstr "ດຳເນີນການຄົ້ນຫາເທັກເຈີແບບ curve."

msgid "Perform the three components curve texture lookup."
msgstr "ດຳເນີນການຄົ້ນຫາເທັກເຈີແບບ curve ສາມສ່ວນປະກອບ."

msgid ""
"Returns the depth value obtained from the depth prepass in a linear space."
msgstr "ຄືນຄ່າຄວາມເລິກ (depth) ທີ່ໄດ້ຈາກ depth prepass ໃນ Linear space."

msgid "Reconstructs the World Position of the Node from the depth texture."
msgstr "ສ້າງຕຳແໜ່ງໂລກ (World Position) ຂອງໂນດຄືນໃໝ່ຈາກ depth texture."

msgid "Unpacks the Screen Normal Texture in World Space"
msgstr "ແຍກ (Unpack) Screen Normal Texture ໃນ World Space"

msgid "Perform the 2D texture lookup."
msgstr "ດຳເນີນການຄົ້ນຫາເທັກເຈີ 2D."

msgid "Perform the 2D-array texture lookup."
msgstr "ດຳເນີນການຄົ້ນຫາເທັກເຈີ 2D-array."

msgid "Perform the 3D texture lookup."
msgstr "ດຳເນີນການຄົ້ນຫາເທັກເຈີ 3D."

msgid "Apply panning function on texture coordinates."
msgstr "ໃຊ້ຟັງຊັນເລື່ອນພາບ (panning) ກັບພິກັດເທັກເຈີ."

msgid "Apply scaling function on texture coordinates."
msgstr "ໃຊ້ຟັງຊັນປັບຂະໜາດ (scaling) ກັບພິກັດເທັກເຈີ."

msgid "Cubic texture parameter lookup."
msgstr "ການຄົ້ນຫາພາລາມິເຕີເທັກເຈີແບບ Cubic."

msgid "2D texture parameter lookup."
msgstr "ການຄົ້ນຫາພາລາມິເຕີເທັກເຈີແບບ 2D."

msgid "2D texture parameter lookup with triplanar."
msgstr "ການຄົ້ນຫາພາລາມິເຕີເທັກເຈີແບບ 2D ດ້ວຍ Triplanar."

msgid "2D array of textures parameter lookup."
msgstr "ການຄົ້ນຫາພາລາມິເຕີຂອງ 2D array textures."

msgid "3D texture parameter lookup."
msgstr "ການຄົ້ນຫາພາລາມິເຕີເທັກເຈີແບບ 3D."

msgid "Transform function."
msgstr "ຟັງຊັນການແປງ (Transform)."

msgid "Transform operator."
msgstr "ຕົວດຳເນີນການການແປງ (Transform)."

msgid ""
"Calculate the outer product of a pair of vectors.\n"
"\n"
"OuterProduct treats the first parameter 'c' as a column vector (matrix with "
"one column) and the second parameter 'r' as a row vector (matrix with one "
"row) and does a linear algebraic matrix multiply 'c * r', yielding a matrix "
"whose number of rows is the number of components in 'c' and whose number of "
"columns is the number of components in 'r'."
msgstr ""
"ຄຳນວນ Outer Product ຂອງຄູ່ເວັກເຕີ.\n"
"\n"
"OuterProduct ຈະປະຕິບັດກັບພາລາມິເຕີທຳອິດ 'c' ເປັນເວັກເຕີຖັນ (ມາທຣິກທີ່ມີໜຶ່ງຖັນ) ແລະ "
"ພາລາມິເຕີທີສອງ 'r' ເປັນເວັກເຕີແຖວ (ມາທຣິກທີ່ມີໜຶ່ງແຖວ) ແລະ ເຮັດການຄູນມາທຣິກທາງພຶດຊະຄະນິດເສັ້ນຊື່ "
"'c * r', ເຊິ່ງຈະໄດ້ມາທຣິກທີ່ມີຈຳນວນແຖວເທົ່າກັບຈຳນວນສ່ວນປະກອບໃນ 'c' ແລະ "
"ຈຳນວນຖັນເທົ່າກັບຈຳນວນສ່ວນປະກອບໃນ 'r'."

msgid "Composes transform from four vectors."
msgstr "ສ້າງ Transform ຈາກສີ່ເວັກເຕີ."

msgid "Decomposes transform to four vectors."
msgstr "ແຍກ Transform ອອກເປັນສີ່ເວັກເຕີ."

msgid "Calculates the determinant of a transform."
msgstr "ຄຳນວນຫາ ດີເຕີມີນັງ (determinant) ຂອງການແປງ."

msgid ""
"Calculates how the object should face the camera to be applied on Model View "
"Matrix output port for 3D objects."
msgstr ""
"ຄຳນວນວິທີທີ່ວັດຖຸຄວນປິ່ນໜ້າເຂົ້າຫາ ກ້ອງ ເພື່ອໃຊ້ກັບຊ່ອງຂາອອກ Model View Matrix ສຳລັບວັດຖຸ 3D."

msgid "Calculates the inverse of a transform."
msgstr "ຄຳນວນຫາ ສ່ວນກັບ (inverse) ຂອງການແປງ."

msgid "Calculates the transpose of a transform."
msgstr "ຄຳນວນຫາ ການສະຫຼັບປ່ຽນ (transpose) ຂອງການແປງ."

msgid "Sums two transforms."
msgstr "ບວກສອງການແປງ (transform)."

msgid "Divides two transforms."
msgstr "ຫານສອງການແປງ (transform)."

msgid "Multiplies two transforms."
msgstr "ຄູນສອງການແປງ (transform)."

msgid "Performs per-component multiplication of two transforms."
msgstr "ດຳເນີນການຄູນແຍກແຕ່ລະສ່ວນປະກອບຂອງສອງການແປງ."

msgid "Subtracts two transforms."
msgstr "ລົບສອງການແປງ (transform)."

msgid "Multiplies vector by transform."
msgstr "ຄູນເວັກເຕີດ້ວຍການແປງ (transform)."

msgid "Transform constant."
msgstr "ຄ່າຄົງທີ່ການແປງ (Transform)."

msgid "Transform parameter."
msgstr "ພາລາມິເຕີການແປງ (Transform)."

msgid ""
"The distance fade effect fades out each pixel based on its distance to "
"another object."
msgstr ""
"ເອັບເຟັກການຈາງຫາຍຕາມໄລຍະທາງ (distance fade) "
"ຈະເຮັດໃຫ້ແຕ່ລະພິກເຊວຈາງລົງຕາມໄລຍະຫ່າງຈາກວັດຖຸອື່ນ."

msgid ""
"The proximity fade effect fades out each pixel based on its distance to "
"another object."
msgstr ""
"ເອັບເຟັກການຈາງຫາຍຕາມຄວາມໃກ້ຊິດ (proximity fade) "
"ຈະເຮັດໃຫ້ແຕ່ລະພິກເຊວຈາງລົງຕາມໄລຍະຫ່າງຈາກວັດຖຸອື່ນ."

msgid "Returns a random value between the minimum and maximum input values."
msgstr "ຄືນຄ່າສຸ່ມລະຫວ່າງຄ່າຕ່ຳສຸດ ແລະ ສູງສຸດທີ່ປ້ອນເຂົ້າ."

msgid ""
"Builds a rotation matrix from the given axis and angle, multiply the input "
"vector by it and returns both this vector and a matrix."
msgstr ""
"ສ້າງມາທຣິກການໝຸນຈາກແກນ ແລະ ມຸມທີ່ກຳນົດ, ຄູນເວັກເຕີຂາເຂົ້າດ້ວຍມາທຣິກນັ້ນ ແລະ ຄືນຄ່າທັງເວັກເຕີ ແລະ "
"ມາທຣິກ."

msgid "Vector function."
msgstr "ຟັງຊັນເວັກເຕີ."

msgid "Vector operator."
msgstr "ຕົວດຳເນີນການເວັກເຕີ."

msgid "Composes vector from scalars."
msgstr "ສ້າງເວັກເຕີຈາກສະກາລາ."

msgid "Decomposes vector to scalars."
msgstr "ແຍກເວັກເຕີອອກເປັນສະກາລາ."

msgid "Composes 2D vector from two scalars."
msgstr "ສ້າງເວັກເຕີ 2D ຈາກສອງສະກາລາ."

msgid "Decomposes 2D vector to two scalars."
msgstr "ແຍກເວັກເຕີ 2D ອອກເປັນສອງສະກາລາ."

msgid "Composes 3D vector from three scalars."
msgstr "ສ້າງເວັກເຕີ 3D ຈາກສາມສະກາລາ."

msgid "Decomposes 3D vector to three scalars."
msgstr "ແຍກເວັກເຕີ 3D ອອກເປັນສາມສະກາລາ."

msgid "Composes 4D vector from four scalars."
msgstr "ສ້າງເວັກເຕີ 4D ຈາກສີ່ສະກາລາ."

msgid "Decomposes 4D vector to four scalars."
msgstr "ແຍກເວັກເຕີ 4D ອອກເປັນສີ່ສະກາລາ."

msgid "Calculates the cross product of two vectors."
msgstr "ຄຳນວນ Cross Product ຂອງສອງເວັກເຕີ."

msgid ""
"(Fragment/Light mode only) (Vector) Derivative in 'x' using local "
"differencing."
msgstr "(ສະເພາະໂໝດ Fragment/Light) (ເວັກເຕີ) ອະນຸພັນໃນແກນ 'x' ໂດຍໃຊ້ຄວາມແຕກຕ່າງທ້ອງຖິ່ນ."

msgid ""
"(Fragment/Light mode only) (Vector) Derivative in 'y' using local "
"differencing."
msgstr "(ສະເພາະໂໝດ Fragment/Light) (ເວັກເຕີ) ອະນຸພັນໃນແກນ 'y' ໂດຍໃຊ້ຄວາມແຕກຕ່າງທ້ອງຖິ່ນ."

msgid "(Vector) Derivative in 'x' using local differencing."
msgstr "(ເວັກເຕີ) ອະນຸພັນໃນແກນ 'x' ໂດຍໃຊ້ຄວາມແຕກຕ່າງທ້ອງຖິ່ນ."

msgid "(Vector) Derivative in 'y' using local differencing."
msgstr "(ເວັກເຕີ) ອະນຸພັນໃນແກນ 'y' ໂດຍໃຊ້ຄວາມແຕກຕ່າງທ້ອງຖິ່ນ."

msgid "Returns the distance between two points."
msgstr "ຄືນຄ່າໄລຍະຫ່າງລະຫວ່າງສອງຈຸດ."

msgid "Calculates the dot product of two vectors."
msgstr "ຄຳນວນ Dot Product ຂອງສອງເວັກເຕີ."

msgid ""
"Returns the vector that points in the same direction as a reference vector. "
"The function has three vector parameters : N, the vector to orient, I, the "
"incident vector, and Nref, the reference vector. If the dot product of I and "
"Nref is smaller than zero the return value is N. Otherwise -N is returned."
msgstr ""
"ຄືນຄ່າເວັກເຕີທີ່ຊີ້ໄປໃນທິດທາງດຽວກັບເວັກເຕີອ້າງອີງ. ຟັງຊັນມີສາມພາລາມິເຕີເວັກເຕີ: N "
"(ເວັກເຕີທີ່ຕ້ອງການຈັດທິດ), I (ເວັກເຕີຕົກກະທົບ), ແລະ Nref (ເວັກເຕີອ້າງອີງ). ຖ້າ Dot Product "
"ຂອງ I ແລະ Nref ນ້ອຍກວ່າສູນ ຄ່າທີ່ຄືນຈະເປັນ N, ຖ້າບໍ່ດັ່ງນັ້ນຈະຄືນຄ່າ -N."

msgid ""
"Returns falloff based on the dot product of surface normal and view direction "
"of camera (pass associated inputs to it)."
msgstr ""
"ຄືນຄ່າການຫຼຸດໜ້ອຍຖອຍລົງ (falloff) ໂດຍອີງຕາມ Dot Product ຂອງແນວສາກພື້ນຜິວ (surface "
"normal) ແລະ ທິດທາງການເບິ່ງຂອງກ້ອງ."

msgid "Calculates the length of a vector."
msgstr "ຄຳນວນຫາລວງຍາວຂອງເວັກເຕີ."

msgid "Linear interpolation between two vectors."
msgstr "ການແຊກຄ່າແບບເສັ້ນລະຫວ່າງສອງເວັກເຕີ."

msgid "Linear interpolation between two vectors using scalar."
msgstr "ການແຊກຄ່າແບບເສັ້ນລະຫວ່າງສອງເວັກເຕີໂດຍໃຊ້ສະກາລາ."

msgid "Performs a fused multiply-add operation (a * b + c) on vectors."
msgstr "ດຳເນີນການຄູນແລ້ວບວກ (a * b + c) ໃນເວັກເຕີ."

msgid "Calculates the normalize product of vector."
msgstr "ຄຳນວນຫາເວັກເຕີຫົວໜ່ວຍ (normalize) ຂອງເວັກເຕີ."

msgid "1.0 - vector"
msgstr "1.0 - vector"

msgid "1.0 / vector"
msgstr "1.0 / vector"

msgid ""
"Returns the vector that points in the direction of reflection ( a : incident "
"vector, b : normal vector )."
msgstr "ຄືນຄ່າເວັກເຕີທີ່ຊີ້ໄປໃນທິດທາງຂອງການສະທ້ອນ ( a: ເວັກເຕີຕົກກະທົບ, b: ເວັກເຕີແນວສາກ )."

msgid "Returns the vector that points in the direction of refraction."
msgstr "ຄືນຄ່າເວັກເຕີທີ່ຊີ້ໄປໃນທິດທາງຂອງການຫັກເຫ (refraction)."

msgid "Remaps a vector from the input range to the output range."
msgstr "ປ່ຽນຊ່ວງຂອງເວັກເຕີຈາກຊ່ວງຂາເຂົ້າ ໄປຫາຊ່ວງຂາອອກ."

msgid ""
"Remaps a vector from the input range to the output range. Ranges defined with "
"scalars."
msgstr "ປ່ຽນຊ່ວງຂອງເວັກເຕີຈາກຊ່ວງຂາເຂົ້າ ໄປຫາຊ່ວງຂາອອກ ໂດຍຊ່ວງຖືກກຳນົດດ້ວຍສະກາລາ."

msgid ""
"SmoothStep function( vector(edge0), vector(edge1), vector(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge0' and 1.0 if 'x' is larger than "
"'edge1'. Otherwise the return value is interpolated between 0.0 and 1.0 using "
"Hermite polynomials."
msgstr ""
"ຟັງຊັນ SmoothStep( vector(edge0), vector(edge1), vector(x) ).\n"
"\n"
"ຄືນຄ່າ 0.0 ຖ້າ 'x' ນ້ອຍກວ່າ 'edge0' ແລະ ຄືນຄ່າ 1.0 ຖ້າ 'x' ຫຼາຍກວ່າ 'edge1'. ຖ້າບໍ່ດັ່ງນັ້ນ "
"ຄ່າທີ່ຄືນຈະຖືກແຊກລະຫວ່າງ 0.0 ແລະ 1.0 ໂດຍໃຊ້ Hermite polynomials."

msgid ""
"SmoothStep function( scalar(edge0), scalar(edge1), vector(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge0' and 1.0 if 'x' is larger than "
"'edge1'. Otherwise the return value is interpolated between 0.0 and 1.0 using "
"Hermite polynomials."
msgstr ""
"ຟັງຊັນ SmoothStep( scalar(edge0), scalar(edge1), vector(x) ).\n"
"\n"
"ຄືນຄ່າ 0.0 ຖ້າ 'x' ນ້ອຍກວ່າ 'edge0' ແລະ ຄືນຄ່າ 1.0 ຖ້າ 'x' ຫຼາຍກວ່າ 'edge1'. ຖ້າບໍ່ດັ່ງນັ້ນ "
"ຄ່າທີ່ຄືນຈະຖືກແຊກລະຫວ່າງ 0.0 ແລະ 1.0 ໂດຍໃຊ້ Hermite polynomials."

msgid ""
"Step function( vector(edge), vector(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge' and otherwise 1.0."
msgstr ""
"ຟັງຊັນ Step( vector(edge), vector(x) ).\n"
"\n"
"ຄືນຄ່າ 0.0 ຖ້າ 'x' ນ້ອຍກວ່າ 'edge', ຖ້າບໍ່ດັ່ງນັ້ນຄືນຄ່າ 1.0."

msgid ""
"Step function( scalar(edge), vector(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge' and otherwise 1.0."
msgstr ""
"ຟັງຊັນ Step( scalar(edge), vector(x) ).\n"
"\n"
"ຄືນຄ່າ 0.0 ຖ້າ 'x' ນ້ອຍກວ່າ 'edge', ຖ້າບໍ່ດັ່ງນັ້ນຄືນຄ່າ 1.0."

msgid ""
"(Fragment/Light mode only) (Vector) Sum of absolute derivative in 'x' and 'y'."
msgstr "(ສະເພາະໂໝດ Fragment/Light) (ເວັກເຕີ) ຜົນລວມຂອງອະນຸພັນສຳບູນໃນແກນ 'x' ແລະ 'y'."

msgid "(Vector) Sum of absolute derivative in 'x' and 'y'."
msgstr "(ເວັກເຕີ) ຜົນລວມຂອງອະນຸພັນສຳບູນໃນແກນ 'x' ແລະ 'y'."

msgid "Adds 2D vector to 2D vector."
msgstr "ບວກເວັກເຕີ 2D ກັບເວັກເຕີ 2D."

msgid "Adds 3D vector to 3D vector."
msgstr "ບວກເວັກເຕີ 3D ກັບເວັກເຕີ 3D."

msgid "Adds 4D vector to 4D vector."
msgstr "ບວກເວັກເຕີ 4D ກັບເວັກເຕີ 4D."

msgid "Divides 2D vector by 2D vector."
msgstr "ຫານເວັກເຕີ 2D ດ້ວຍເວັກເຕີ 2D."

msgid "Divides 3D vector by 3D vector."
msgstr "ຫານເວັກເຕີ 3D ດ້ວຍເວັກເຕີ 3D."

msgid "Divides 4D vector by 4D vector."
msgstr "ຫານເວັກເຕີ 4D ດ້ວຍເວັກເຕີ 4D."

msgid "Multiplies 2D vector by 2D vector."
msgstr "ຄູນເວັກເຕີ 2D ດ້ວຍເວັກເຕີ 2D."

msgid "Multiplies 3D vector by 3D vector."
msgstr "ຄູນເວັກເຕີ 3D ດ້ວຍເວັກເຕີ 3D."

msgid "Multiplies 4D vector by 4D vector."
msgstr "ຄູນເວັກເຕີ 4D ດ້ວຍເວັກເຕີ 4D."

msgid "Returns the remainder of the two 2D vectors."
msgstr "ຄືນຄ່າເສດຈາກການຫານສອງເວັກເຕີ 2D."

msgid "Returns the remainder of the two 3D vectors."
msgstr "ຄືນຄ່າເສດຈາກການຫານສອງເວັກເຕີ 3D."

msgid "Returns the remainder of the two 4D vectors."
msgstr "ຄືນຄ່າເສດຈາກການຫານສອງເວັກເຕີ 4D."

msgid "Subtracts 2D vector from 2D vector."
msgstr "ລົບເວັກເຕີ 2D ອອກຈາກເວັກເຕີ 2D."

msgid "Subtracts 3D vector from 3D vector."
msgstr "ລົບເວັກເຕີ 3D ອອກຈາກເວັກເຕີ 3D."

msgid "Subtracts 4D vector from 4D vector."
msgstr "ລົບເວັກເຕີ 4D ອອກຈາກເວັກເຕີ 4D."

msgid "2D vector constant."
msgstr "ຄ່າຄົງທີ່ເວັກເຕີ 2D."

msgid "2D vector parameter."
msgstr "ພາລາມິເຕີເວັກເຕີ 2D."

msgid "3D vector constant."
msgstr "ຄ່າຄົງທີ່ເວັກເຕີ 3D."

msgid "3D vector parameter."
msgstr "ພາລາມິເຕີເວັກເຕີ 3D."

msgid "4D vector constant."
msgstr "ຄ່າຄົງທີ່ເວັກເຕີ 4D."

msgid "4D vector parameter."
msgstr "ພາລາມິເຕີເວັກເຕີ 4D."

msgid ""
"A rectangular area with a description string for better graph organization."
msgstr "ພື້ນທີ່ຮູບສີ່ແຈທີ່ມີຄຳອະທິບາຍ ເພື່ອການຈັດລະບຽບກຣາບທີ່ດີຂຶ້ນ."

msgid ""
"Custom Godot Shader Language expression, with custom amount of input and "
"output ports. This is a direct injection of code into the vertex/fragment/"
"light function, do not use it to write the function declarations inside."
msgstr ""
"ນິພົດພາສາ Godot Shader ແບບກຳນົດເອງ, ໂດຍສາມາດກຳນົດຈຳນວນຊ່ອງຂາເຂົ້າ ແລະ ຂາອອກໄດ້. "
"ນີ້ແມ່ນການແຊກໂຄ້ດເຂົ້າໄປໃນຟັງຊັນ vertex/fragment/light ໂດຍກົງ, "
"ຢ່າໃຊ້ເພື່ອຂຽນການປະກາດຟັງຊັນໄວ້ທາງໃນ."

msgid ""
"Custom Godot Shader Language expression, which is placed on top of the "
"resulted shader. You can place various function definitions inside and call "
"it later in the Expressions. You can also declare varyings, parameters and "
"constants."
msgstr ""
"ນິພົດພາສາ Godot Shader ແບບກຳນົດເອງ ເຊິ່ງຈະຖືກວາງໄວ້ສ່ວນເທິງສຸດຂອງເຊດເດີ. "
"ທ່ານສາມາດປະກາດຟັງຊັນຕ່າງໆໄວ້ທາງໃນແລ້ວເອີ້ນໃຊ້ໃນ Expressions ພາຍຫຼັງໄດ້. ທ່ານຍັງສາມາດປະກາດ "
"varyings, ພາລາມິເຕີ ແລະ ຄ່າຄົງທີ່ໄດ້ອີກດ້ວຍ."

msgid "A reference to an existing parameter."
msgstr "ການອ້າງອີງເຖິງພາລາມິເຕີທີ່ມີຢູ່ແລ້ວ."

msgid "Get varying parameter."
msgstr "ດຶງຄ່າ Varying parameter."

msgid "Set varying parameter."
msgstr "ກຳນົດຄ່າ Varying parameter."

msgid ""
"Reroute connections freely, can be used to connect multiple input ports to "
"single output port."
msgstr "ປ່ຽນເສັ້ນທາງການເຊື່ອມຕໍ່ໄດ້ຢ່າງອິດສະຫຼະ, ສາມາດໃຊ້ເພື່ອເຊື່ອມຕໍ່ຫຼາຍຊ່ອງຂາເຂົ້າຫາຊ່ອງຂາອອກດຽວ."

msgid "[None]"
msgstr "[ບໍ່ມີ]"

msgid "Edit Visual Property: %s"
msgstr "ແກ້ໄຂຄຸນສົມບັດ Visual: %s"

msgid "Visual Shader Mode Changed"
msgstr "ໂໝດ Visual Shader ຖືກປ່ຽນແປງ"

msgid ""
"Cannot convert VisualShader to GDShader because VisualShader has embedded "
"subresources."
msgstr ""
"ບໍ່ສາມາດແປງ VisualShader ເປັນ GDShader ໄດ້ ເພາະວ່າ VisualShader "
"ມີຊັບພະຍາກອນຍ່ອຍທີ່ຝັງຢູ່ທາງໃນ."

msgid ""
"Visual Shader conversion cannot convert external dependencies. Resource "
"references from Nodes will have to be rebound as ShaderParameters on a "
"Material."
msgstr ""
"ການແປງ Visual Shader ບໍ່ສາມາດແປງໄຟລ໌ທີ່ຂຶ້ນຕໍ່ກັນຈາກພາຍນອກໄດ້. ການອ້າງອີງຊັບພະຍາກອນຈາກ "
"Nodes ຈະຕ້ອງຖືກເຊື່ອມຕໍ່ໃໝ່ເປັນ ShaderParameters ໃນ Material."

msgid ""
"Shader keywords cannot be used as parameter names.\n"
"Choose another name."
msgstr ""
"ບໍ່ສາມາດໃຊ້ຄຳສຳຄັນ (keywords) ຂອງເຊດເດີເປັນຊື່ພາລາມິເຕີໄດ້.\n"
"ກະລຸນາເລືອກຊື່ອື່ນ."

msgid "This parameter type does not support the '%s' qualifier."
msgstr "ປະເພດພາລາມິເຕີນີບໍ່ຮອງຮັບຕົວລະບຸ (qualifier) '%s'."

msgid ""
"Global parameter '%s' does not exist.\n"
"Create it in the Project Settings."
msgstr ""
"ບໍ່ມີພາລາມິເຕີທົ່ວໂລກ (Global parameter) '%s' ຢູ່.\n"
"ກະລຸນາສ້າງມັນໃນການຕັ້ງຄ່າໂຄງການ (Project Settings)."

msgid ""
"Global parameter '%s' has an incompatible type for this kind of node.\n"
"Change it in the Project Settings."
msgstr ""
"ພາລາມິເຕີທົ່ວໂລກ '%s' ມີປະເພດທີ່ບໍ່ເຂົ້າກັນກັບໂນດຊະນິດນີ້.\n"
"ກະລຸນາປ່ຽນມັນໃນການຕັ້ງຄ່າໂຄງການ."

msgid ""
"The sampler port is connected but not used. Consider changing the source to "
"'SamplerPort'."
msgstr "ຊ່ອງ Sampler ຖືກເຊື່ອມຕໍ່ແຕ່ບໍ່ໄດ້ຖືກໃຊ້ງານ. ພິຈາລະນາປ່ຽນແຫຼ່ງຂໍ້ມູນເປັນ 'SamplerPort'."

msgid "Invalid source for preview."
msgstr "ແຫຼ່ງຂໍ້ມູນບໍ່ຖືກຕ້ອງສຳລັບການເບິ່ງຕົວຢ່າງ."

msgid "Invalid source for shader."
msgstr "ແຫຼ່ງຂໍ້ມູນບໍ່ຖືກຕ້ອງສຳລັບເຊດເດີ."

msgid "Invalid operator for that type."
msgstr "ຕົວດຳເນີນການບໍ່ຖືກຕ້ອງສຳລັບຂໍ້ມູນປະເພດນັ້ນ."

msgid ""
"`%s` precision mode is not available for `gl_compatibility` profile.\n"
"Reverted to `None` precision."
msgstr ""
"ໂໝດຄວາມລະອຽດ `%s` ບໍ່ມີໃຫ້ໃຊ້ສຳລັບໂປຣໄຟລ໌ `gl_compatibility`.\n"
"ໄດ້ກັບຄືນໄປໃຊ້ຄວາມລະອຽດແບບ `None`."

msgid "'%s' type is incompatible with '%s' source."
msgstr "ປະເພດ '%s' ບໍ່ເຂົ້າກັນກັບແຫຼ່ງຂໍ້ມູນ '%s'."

msgid "'%s' default color is incompatible with '%s' source."
msgstr "ສີເລີ່ມຕົ້ນ '%s' ບໍ່ເຂົ້າກັນກັບແຫຼ່ງຂໍ້ມູນ '%s'."

msgid "Default Color"
msgstr "ສີເລີ່ມຕົ້ນ"

msgid "Repeat"
msgstr "ເຮັດຊ້ຳ"

msgid "Invalid comparison function for that type."
msgstr "ຟັງຊັນການປຽບທຽບບໍ່ຖືກຕ້ອງສຳລັບປະເພດນັ້ນ."

msgid "2D Mode"
msgstr "ໂໝດ 2D"

msgid "Use All Surfaces"
msgstr "ໃຊ້ທຸກພື້ນຜິວ"

msgid "Surface Index"
msgstr "ດັດຊະນີພື້ນຜິວ"

msgid "Building Android Project (gradle)"
msgstr "ກຳລັງບິວດ໌ໂຄງການ Android (gradle)"

msgid "> Connecting to Gradle Build Environment..."
msgstr "> ກຳລັງເຊື່ອມຕໍ່ກັບສະພາບແວດລ້ອມການບິວດ໌ Gradle..."

msgid "Unable to connect to Gradle Build Environment service"
msgstr "ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບບໍລິການ Gradle Build Environment ໄດ້"

msgid "> Starting Gradle build..."
msgstr "> ກຳລັງເລີ່ມການບິວດ໌ Gradle..."

msgid "Failed to execute Gradle command"
msgstr "ການປະຕິບັດຄຳສັ່ງ Gradle ລົ້ມເຫຼວ"

msgid "> Copying Gradle artifacts..."
msgstr "> ກຳລັງຄັດລອກໄຟລ໌ຜົນລັດ (artifacts) ຂອງ Gradle..."

msgid "Package name is missing."
msgstr "ຊື່ແພັກເກດຫາຍໄປ."

msgid "Package segments must be of non-zero length."
msgstr "ແຕ່ລະສ່ວນຂອງຊື່ແພັກເກດຕ້ອງມີຄວາມຍາວບໍ່ເປັນສູນ."

msgid "The character '%s' is not allowed in Android application package names."
msgstr "ບໍ່ອະນຸຍາດໃຫ້ໃຊ້ຕົວອັກສອນ '%s' ໃນຊື່ແພັກເກດແອັບພລິເຄຊັນ Android."

msgid "A digit cannot be the first character in a package segment."
msgstr "ຕົວເລກບໍ່ສາມາດເປັນຕົວອັກສອນທຳອິດໃນແຕ່ລະສ່ວນຂອງແພັກເກດໄດ້."

msgid "The character '%s' cannot be the first character in a package segment."
msgstr "ຕົວອັກສອນ '%s' ບໍ່ສາມາດເປັນຕົວອັກສອນທຳອິດໃນແຕ່ລະສ່ວນຂອງແພັກເກດໄດ້."

msgid "The package must have at least one '.' separator."
msgstr "ຊື່ແພັກເກດຕ້ອງມີເຄື່ອງໝາຍຈ້ຳ '.' ຂັ້ນຢ່າງໜ້ອຍໜຶ່ງຈຸດ."

msgid "Error creating keystores directory:"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການສ້າງໂຟນເດີ keystores:"

msgid "Invalid package name:"
msgstr "ຊື່ແພັກເກດບໍ່ຖືກຕ້ອງ:"

msgid "\"Use Gradle Build\" is required to enable \"Swipe to dismiss\"."
msgstr "ຕ້ອງເປີດໃຊ້ \"Use Gradle Build\" ເພື່ອເປີດໃຊ້ງານ \"Swipe to dismiss\"."

msgid "\"Use Gradle Build\" must be enabled to use the plugins."
msgstr "ຕ້ອງເປີດໃຊ້ \"Use Gradle Build\" ເພື່ອໃຊ້ງານປລັກອິນ."

msgid ""
"\"Compress Native Libraries\" is only valid when \"Use Gradle Build\" is "
"enabled."
msgstr ""
"\"Compress Native Libraries\" ຈະໃຊ້ໄດ້ກໍຕໍ່ເມື່ອເປີດໃຊ້ \"Use Gradle Build\" ເທົ່ານັ້ນ."

msgid "\"Export AAB\" is only valid when \"Use Gradle Build\" is enabled."
msgstr "\"Export AAB\" ຈະໃຊ້ໄດ້ກໍຕໍ່ເມື່ອເປີດໃຊ້ \"Use Gradle Build\" ເທົ່ານັ້ນ."

msgid "\"Min SDK\" can only be overridden when \"Use Gradle Build\" is enabled."
msgstr "\"Min SDK\" ສາມາດປ່ຽນແປງໄດ້ກໍຕໍ່ເມື່ອເປີດໃຊ້ \"Use Gradle Build\" ເທົ່ານັ້ນ."

msgid "\"Min SDK\" should be a valid integer, but got \"%s\" which is invalid."
msgstr "\"Min SDK\" ຄວນເປັນຈຳນວນຖ້ວນທີ່ຖືກຕ້ອງ, ແຕ່ໄດ້ຮັບ \"%s\" ເຊິ່ງບໍ່ຖືກຕ້ອງ."

msgid ""
"\"Min SDK\" cannot be lower than %d, which is the version needed by the Godot "
"library."
msgstr "\"Min SDK\" ບໍ່ສາມາດຕ່ຳກວ່າ %d ເຊິ່ງເປັນເວີຊັນທີ່ຫ້ອງສະໝຸດ Godot ຕ້ອງການ."

msgid ""
"\"Target SDK\" can only be overridden when \"Use Gradle Build\" is enabled."
msgstr "\"Target SDK\" ສາມາດປ່ຽນແປງໄດ້ກໍຕໍ່ເມື່ອເປີດໃຊ້ \"Use Gradle Build\" ເທົ່ານັ້ນ."

msgid ""
"\"Target SDK\" should be a valid integer, but got \"%s\" which is invalid."
msgstr "\"Target SDK\" ຄວນເປັນຈຳນວນຖ້ວນທີ່ຖືກຕ້ອງ, ແຕ່ໄດ້ຮັບ \"%s\" ເຊິ່ງບໍ່ຖືກຕ້ອງ."

msgid "\"Target SDK\" version must be greater or equal to \"Min SDK\" version."
msgstr "ເວີຊັນຂອງ \"Target SDK\" ຕ້ອງຫຼາຍກວ່າ ຫຼື ເທົ່າກັບເວີຊັນຂອງ \"Min SDK\"."

msgid "\"Use Gradle Build\" is required to add custom theme attributes."
msgstr ""
"ຕ້ອງເປີດໃຊ້ \"Use Gradle Build\" ເພື່ອເພີ່ມຄຸນລັກສະນະທີມ (theme attributes) ແບບກຳນົດເອງ."

msgid "\"Use Gradle Build\" must be enabled to enable \"Show In Android Tv\"."
msgstr "ຕ້ອງເປີດໃຊ້ \"Use Gradle Build\" ເພື່ອເປີດໃຊ້ງານ \"Show In Android Tv\"."

msgid "\"Use Gradle Build\" must be enabled to enable \"Show As Launcher App\"."
msgstr "ຕ້ອງເປີດໃຊ້ \"Use Gradle Build\" ເພື່ອເປີດໃຊ້ງານ \"Show As Launcher App\"."

msgid "\"Use Gradle Build\" must be enabled to disable \"Show In App Library\"."
msgstr "ຕ້ອງເປີດໃຊ້ \"Use Gradle Build\" ເພື່ອປິດໃຊ້ງານ \"Show In App Library\"."

msgid "Mirror Android devices"
msgstr "ສະທ້ອນໜ້າຈໍອຸປະກອນ Android (Mirror)"

msgid ""
"If enabled, \"scrcpy\" is used to start the project and automatically stream "
"device display (or virtual display) content."
msgstr ""
"ຖ້າເປີດໃຊ້, ຈະໃຊ້ \"scrcpy\" ເພື່ອເລີ່ມໂຄງການ ແລະ ສະຕຣີມໜ້າຈໍອຸປະກອນ (ຫຼື ໜ້າຈໍສະເືອນ) "
"ໂດຍອັດຕະໂນມັດ."

msgid "Exporting APK..."
msgstr "ກຳລັງສົ່ງອອກ APK..."

msgid "Uninstalling..."
msgstr "ກຳລັງຖອນການຕິດຕັ້ງ..."

msgid "Installing to device, please wait..."
msgstr "ກຳລັງຕິດຕັ້ງລົງອຸປະກອນ, ກະລຸນາລໍຖ້າ..."

msgid "Could not install to device: %s"
msgstr "ບໍ່ສາມາດຕິດຕັ້ງລົງອຸປະກອນໄດ້: %s"

msgid "Running on device..."
msgstr "ກຳລັງເຮັດວຽກໃນອຸປະກອນ..."

msgid ""
"Could not start scrcpy executable. Configure scrcpy path in the Editor "
"Settings (Export > Android > scrcpy > Path)."
msgstr ""
"ບໍ່ສາມາດເລີ່ມໄຟລ໌ scrcpy ໄດ້. ກະລຸນາຕັ້ງຄ່າເສັ້ນທາງ scrcpy ໃນ Editor Settings (Export > "
"Android > scrcpy > Path)."

msgid "Could not execute on device."
msgstr "ບໍ່ສາມາດສັ່ງໃຫ້ເຮັດວຽກໃນອຸປະກອນໄດ້."

msgid "Error: There was a problem validating the keystore username and password"
msgstr "ຂໍ້ຜິດພາດ: ເກີດບັນຫາໃນການກວດສອບຊື່ຜູ້ໃຊ້ ແລະ ລະຫັດຜ່ານຂອງ keystore"

msgid ""
"Unable to determine the C# project's TFM, it may be incompatible. The export "
"template only supports '%s'. Make sure the project targets '%s' or consider "
"using gradle builds instead."
msgstr ""
"ບໍ່ສາມາດລະບຸ TFM ຂອງໂຄງການ C# ໄດ້, ມັນອາດຈະບໍ່ເຂົ້າກັນ. ແມ່ແບບການສົ່ງອອກຮອງຮັບແຕ່ '%s' "
"ເທົ່ານັ້ນ. ກວດສອບໃຫ້ແນ່ໃຈວ່າໂຄງການກຳນົດເປົ້າໝາຍເປັນ '%s' ຫຼື ພິຈາລະນາໃຊ້ການບິວດ໌ດ້ວຍ gradle ແທນ."

msgid ""
"C# project targets '%s' but the export template only supports '%s'. Consider "
"using gradle builds instead."
msgstr ""
"ໂຄງການ C# ກຳນົດເປົ້າໝາຍເປັນ '%s' ແຕ່ແມ່ແບບການສົ່ງອອກຮອງຮັບແຕ່ '%s'. ພິຈາລະນາໃຊ້ການບິວດ໌ດ້ວຍ "
"gradle ແທນ."

msgid "Exporting to Android when using C#/.NET is experimental."
msgstr "ການສົ່ງອອກໄປ Android ເມື່ອໃຊ້ C#/.NET ແມ່ນຍັງຢູ່ໃນຂັ້ນຕອນທົດລອງ."

msgid "Custom Android source template not found."
msgstr "ບໍ່ພົບແມ່ແບບຊອຣ໌ສ Android ແບບກຳນົດເອງ."

msgid ""
"Android build template not installed in the project. Install it from the "
"Project menu."
msgstr "ຍັງບໍ່ໄດ້ຕິດຕັ້ງແມ່ແບບການບິວດ໌ Android ໃນໂຄງການ. ກະລຸນາຕິດຕັ້ງຈາກເມນູ Project."

msgid ""
"Either Debug Keystore, Debug User AND Debug Password settings must be "
"configured OR none of them."
msgstr ""
"ຕ້ອງຕັ້ງຄ່າທັງ Debug Keystore, Debug User ແລະ Debug Password ໃຫ້ຄົບ ຫຼື "
"ບໍ່ຕ້ອງຕັ້ງຄ່າເລີຍທັງໝົດ."

msgid "Debug keystore not configured in the Editor Settings nor in the preset."
msgstr "ບໍ່ໄດ້ຕັ້ງຄ່າ Debug keystore ໃນ Editor Settings ຫຼື ໃນ preset."

msgid ""
"Either Release Keystore, Release User AND Release Password settings must be "
"configured OR none of them."
msgstr ""
"ຕ້ອງຕັ້ງຄ່າທັງ Release Keystore, Release User ແລະ Release Password ໃຫ້ຄົບ ຫຼື "
"ບໍ່ຕ້ອງຕັ້ງຄ່າເລີຍທັງໝົດ."

msgid "Release keystore incorrectly configured in the export preset."
msgstr "ຕັ້ງຄ່າ Release keystore ບໍ່ຖືກຕ້ອງໃນ export preset."

msgid "A valid Java SDK path is required in Editor Settings."
msgstr "ຕ້ອງການເສັ້ນທາງ Java SDK ທີ່ຖືກຕ້ອງໃນ Editor Settings."

msgid "Invalid Java SDK path in Editor Settings."
msgstr "ເສັ້ນທາງ Java SDK ໃນ Editor Settings ບໍ່ຖືກຕ້ອງ."

msgid "Missing 'bin' directory!"
msgstr "ບໍ່ພົບໂຟນເດີ 'bin'!"

msgid "Unable to find 'java' command using the Java SDK path."
msgstr "ບໍ່ພົບຄຳສັ່ງ 'java' ໂດຍໃຊ້ເສັ້ນທາງ Java SDK ນີ້."

msgid "Please check the Java SDK directory specified in Editor Settings."
msgstr "ກະລຸນາກວດສອບໂຟນເດີ Java SDK ທີ່ລະບຸໄວ້ໃນ Editor Settings."

msgid "A valid Android SDK path is required in Editor Settings."
msgstr "ຕ້ອງການເສັ້ນທາງ Android SDK ທີ່ຖືກຕ້ອງໃນ Editor Settings."

msgid "Invalid Android SDK path in Editor Settings."
msgstr "ເສັ້ນທາງ Android SDK ໃນ Editor Settings ບໍ່ຖືກຕ້ອງ."

msgid "Missing 'platform-tools' directory!"
msgstr "ບໍ່ພົບໂຟນເດີ 'platform-tools'!"

msgid "Unable to find Android SDK platform-tools' adb command."
msgstr "ບໍ່ພົບຄຳສັ່ງ adb ໃນ platform-tools ຂອງ Android SDK."

msgid "Please check in the Android SDK directory specified in Editor Settings."
msgstr "ກະລຸນາກວດສອບໃນໂຟນເດີ Android SDK ທີ່ລະບຸໄວ້ໃນ Editor Settings."

msgid "Missing 'build-tools' directory!"
msgstr "ບໍ່ພົບໂຟນເດີ 'build-tools'!"

msgid "Unable to find Android SDK build-tools' apksigner command."
msgstr "ບໍ່ພົບຄຳສັ່ງ apksigner ໃນ build-tools ຂອງ Android SDK."

msgid ""
"ETC2/ASTC texture compression is required for Android export. In Project "
"Settings, search for 'ETC2' in the search field, or enable 'Advanced "
"Settings' and go to Rendering > Textures > VRAM Compression to enable 'Import "
"ETC2 ASTC'."
msgstr ""
"ຕ້ອງໃຊ້ການບີບອັດເທັກເຈີແບບ ETC2/ASTC ສຳລັບການສົ່ງອອກ Android. ໃນ Project Settings, "
"ຄົ້ນຫາ 'ETC2' ຫຼື ເປີດ 'Advanced Settings' ແລ້ວໄປທີ່ Rendering > Textures > VRAM "
"Compression ເພື່ອເປີດໃຊ້ 'Import ETC2 ASTC'."

msgid "\"Use Gradle Build\" is required for transparent background on Android"
msgstr "ຕ້ອງໃຊ້ \"Use Gradle Build\" ເພື່ອໃຫ້ພື້ນຫຼັງໂປ່ງໃສໃນ Android"

msgid ""
"\"Target SDK\" %d is higher than the default version %d. This may work, but "
"wasn't tested and may be unstable."
msgstr ""
"\"Target SDK\" %d ສູງກວ່າເວີຊັນເລີ່ມຕົ້ນ %d. ມັນອາດຈະໃຊ້ວຽກໄດ້, ແຕ່ຍັງບໍ່ໄດ້ຮັບການທົດສອບ ແລະ "
"ອາດຈະບໍ່ຄົງທີ່."

msgid ""
"The \"%s\" renderer is designed for Desktop devices, and is not suitable for "
"Android devices."
msgstr ""
"ຕົວເຣັນເດີ \"%s\" ຖືກອອກແບບມາສຳລັບອຸປະກອນຄອມພິວເຕີ (Desktop), ແລະ ບໍ່ເໝາະສົມກັບອຸປະກອນ "
"Android."

msgid "\"Min SDK\" should be greater or equal to %d for the \"%s\" renderer."
msgstr "\"Min SDK\" ຄວນຫຼາຍກວ່າ ຫຼື ເທົ່າກັບ %d ສຳລັບຕົວເຣັນເດີ \"%s\"."

msgid ""
"The project name does not meet the requirement for the package name format "
"and will be updated to \"%s\". Please explicitly specify the package name if "
"needed."
msgstr ""
"ຊື່ໂຄງການບໍ່ກົງກັບຮູບແບບທີ່ຕ້ອງການສຳລັບຊື່ແພັກເກດ ແລະ ຈະຖືກປ່ຽນເປັນ \"%s\". "
