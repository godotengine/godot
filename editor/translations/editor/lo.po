msgstr "ຣີເຊັດລະດັບສຽງ"

msgid "Delete Effect"
msgstr "ລຶບເອັບເຟັກ"

msgid "Add Audio Bus"
msgstr "ເພີ່ມບັສສຽງ"

msgid "Master bus can't be deleted!"
msgstr "ບັສຫຼັກ (Master) ບໍ່ສາມາດລຶບໄດ້!"

msgid "Delete Audio Bus"
msgstr "ລຶບບັສສຽງ"

msgid "Duplicate Audio Bus"
msgstr "ສ້າງບັສສຽງຊ້ຳ"

msgid "Reset Bus Volume"
msgstr "ຣີເຊັດລະດັບສຽງບັສ"

msgid "Move Audio Bus"
msgstr "ຍ້າຍບັສສຽງ"

msgid "Save Audio Bus Layout As..."
msgstr "ບັນທຶກຮູບແບບບັສສຽງເປັນ..."

msgid "Location for New Layout..."
msgstr "ບ່ອນເກັບຮູບແບບໃໝ່..."

msgid "Open Audio Bus Layout"
msgstr "ເປີດຮູບແບບບັສສຽງ"

msgid "Error saving file: %s"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການບັນທຶກໄຟລ໌: %s"

msgid "Toggle Audio Dock"
msgstr "ສະລັບແຖບສຽງ"

msgid "Layout:"
msgstr "ຮູບແບບ (Layout):"

msgid "Add Bus"
msgstr "ເພີ່ມບັສ"

msgid "Add a new Audio Bus to this layout."
msgstr "ເພີ່ມບັສສຽງໃໝ່ເຂົ້າໃນຮູບແບບນີ້."

msgid "Load"
msgstr "ໂຫຼດ"

msgid "Load an existing Bus Layout."
msgstr "ໂຫຼດຮູບແບບບັສທີ່ມີຢູ່ແລ້ວ."

msgid "Save this Bus Layout to a file."
msgstr "ບັນທຶກຮູບແບບບັສນີ້ລົງໃນໄຟລ໌."

msgid "Load Default"
msgstr "ໂຫຼດຄ່າເລີ່ມຕົ້ນ"

msgid "Load the default Bus Layout."
msgstr "ໂຫຼດຮູບແບບບັສເລີ່ມຕົ້ນ."

msgid "Create a new Bus Layout."
msgstr "ສ້າງຮູບແບບບັສໃໝ່."

msgid "Audio Bus Layout"
msgstr "ຮູບແບບບັສສຽງ"

msgid "Step Into"
msgstr "ເຂົ້າໄປຂ້າງໃນ (Step Into)"

msgid "Step Over"
msgstr "ຂ້າມໄປ (Step Over)"

msgid "Step Out"
msgstr "ອອກໄປຂ້າງນອກ (Step Out)"

msgid "Break"
msgstr "ຢຸດຊົ່ວຄາວ (Break)"

msgid "Continue"
msgstr "ດຳເນີນການຕໍ່"

msgid "Debug with External Editor"
msgstr "ດີບັກດ້ວຍຕົວແກ້ໄຂພາຍນອກ"

msgid "Deploy with Remote Debug"
msgstr "ຕິດຕັ້ງດ້ວຍການດີບັກທາງໄກ"

msgid ""
"When this option is enabled, using one-click deploy will make the executable "
"attempt to connect to this computer's IP so the running project can be "
"debugged.\n"
"This option is intended to be used for remote debugging (typically with a "
"mobile device).\n"
"You don't need to enable it to use the GDScript debugger locally."
msgstr ""
"ເມື່ອເປີດຕົວເລືອກນີ້, ການຕິດຕັ້ງແບບຄລິກດຽວຈະເຮັດໃຫ້ໄຟລ໌ທີ່ເຮັດວຽກໄດ້ພະຍາຍາມເຊື່ອມຕໍ່ຫາ IP "
"ຂອງຄອມພິວເຕີເຄື່ອງນີ້ ເພື່ອໃຫ້ສາມາດດີບັກໂປຣເຈັກທີ່ກຳລັງເຮັດວຽກຢູ່ໄດ້.\n"
"ຕົວເລືອກນີ້ມີໄວ້ສຳລັບການດີບັກທາງໄກ (ໂດຍປົກກະຕິແມ່ນໃຊ້ມືຖື).\n"
"ທ່ານບໍ່ຈຳເປັນຕ້ອງເປີດມັນຫາກຕ້ອງການດີບັກ GDScript ຢູ່ໃນເຄື່ອງໂດຍກົງ."

msgid "Small Deploy with Network Filesystem"
msgstr "ຕິດຕັ້ງແບບຂະໜາດນ້ອຍດ້ວຍລະບົບໄຟລ໌ເຄືອຂ່າຍ"

msgid ""
"When this option is enabled, using one-click deploy for Android will only "
"export an executable without the project data.\n"
"The filesystem will be provided from the project by the editor over the "
"network.\n"
"On Android, deploying will use the USB cable for faster performance. This "
"option speeds up testing for projects with large assets."
msgstr ""
"ເມື່ອເປີດຕົວເລືອກນີ້, ການຕິດຕັ້ງແບບຄລິກດຽວສຳລັບ Android "
"ຈະສົ່ງອອກສະເພາະໄຟລ໌ທີ່ເຮັດວຽກໄດ້ໂດຍບໍ່ມີຂໍ້ມູນໂປຣເຈັກ.\n"
"ລະບົບໄຟລ໌ຈະຖືກສົ່ງຈາກຕົວແກ້ໄຂຜ່ານເຄືອຂ່າຍ.\n"
"ໃນ Android, ການຕິດຕັ້ງຈະໃຊ້ສາຍ USB ເພື່ອຄວາມໄວ. "
"ຕົວເລືອກນີ້ຊ່ວຍໃຫ້ການທົດສອບໂປຣເຈັກທີ່ມີແອັດເຊັດຂະໜາດໃຫຍ່ໄວຂຶ້ນ."

msgid "Visible Collision Shapes"
msgstr "ສະແດງຮູບຊົງການຕຳ"

msgid ""
"When this option is enabled, collision shapes and raycast nodes (for 2D and "
"3D) will be visible in the running project."
msgstr ""
"ເມື່ອເປີດຕົວເລືອກນີ້, ຮູບຊົງການຕຳ ແລະ ໂນດ raycast (ທັງ 2D ແລະ 3D) "
"ຈະປາກົດໃຫ້ເຫັນໃນຂະນະທີ່ໂປຣເຈັກກຳລັງເຮັດວຽກ."

msgid "Visible Paths"
msgstr "ສະແດງເສັ້ນທາງ (Paths)"

msgid ""
"When this option is enabled, curve resources used by path nodes will be "
"visible in the running project."
msgstr ""
"ເມື່ອເປີດຕົວເລືອກນີ້, "
"ຊັບພະຍາກອນເສັ້ນໂຄ້ງທີ່ໃຊ້ໂດຍໂນດເສັ້ນທາງຈະປາກົດໃຫ້ເຫັນໃນຂະນະທີ່ໂປຣເຈັກກຳລັງເຮັດວຽກ."

msgid "Visible Navigation"
msgstr "ສະແດງການນຳທາງ (Navigation)"

msgid ""
"When this option is enabled, navigation meshes, and polygons will be visible "
"in the running project."
msgstr ""
"ເມື່ອເປີດຕົວເລືອກນີ້, navigation meshes ແລະ polygons "
"ຈະປາກົດໃຫ້ເຫັນໃນຂະນະທີ່ໂປຣເຈັກກຳລັງເຮັດວຽກ."

msgid "Visible Avoidance"
msgstr "ສະແດງການຫຼີກລ່ຽງ (Avoidance)"

msgid ""
"When this option is enabled, avoidance object shapes, radiuses, and "
"velocities will be visible in the running project."
msgstr ""
"ເມື່ອເປີດຕົວເລືອກນີ້, ຮູບຊົງວັດຖຸຫຼີກລ່ຽງ, ລັດສະໝີ ແລະ "
"ຄວາມໄວຈະປາກົດໃຫ້ເຫັນໃນຂະນະທີ່ໂປຣເຈັກກຳລັງເຮັດວຽກ."

msgid "Debug CanvasItem Redraws"
msgstr "ດີບັກການແຕ້ມໃໝ່ຂອງ CanvasItem"

msgid ""
"When this option is enabled, redraw requests of 2D objects will become "
"visible (as a short flash) in the running project.\n"
"This is useful to troubleshoot low processor mode."
msgstr ""
"ເມື່ອເປີດຕົວເລືອກນີ້, ການຮ້ອງຂໍແຕ້ມໃໝ່ຂອງວັດຖຸ 2D ຈະປາກົດໃຫ້ເຫັນ (ເປັນແສງວາບສັ້ນໆ) "
"ໃນຂະນະທີ່ໂປຣເຈັກກຳລັງເຮັດວຽກ.\n"
"ນີ້ມີປະໂຫຍດໃນການແກ້ໄຂບັນຫາໃນໂໝດການປະມວນຜົນຕ່ຳ."

msgid "Synchronize Scene Changes"
msgstr "ຊິງໂຄຣໄນການປ່ຽນແປງສາກ"

msgid ""
"When this option is enabled, any changes made to the scene in the editor will "
"be replicated in the running project.\n"
"When used remotely on a device, this is more efficient when the network "
"filesystem option is enabled."
msgstr ""
"ເມື່ອເປີດຕົວເລືອກນີ້, "
"ການປ່ຽນແປງໃດໆທີ່ເກີດຂຶ້ນກັບສາກໃນຕົວແກ້ໄຂຈະຖືກນຳໄປໃຊ້ໃນໂປຣເຈັກທີ່ກຳລັງເຮັດວຽກຢູ່.\n"
"ເມື່ອໃຊ້ກັບອຸປະກອນທາງໄກ, ຕົວເລືອກນີ້ຈະມີປະສິດທິພາບຫຼາຍຂຶ້ນຫາກເປີດໃຊ້ລະບົບໄຟລ໌ເຄືອຂ່າຍ."

msgid "Synchronize Script Changes"
msgstr "ຊິງໂຄຣໄນການປ່ຽນແປງສະຄຣິບ"

msgid ""
"When this option is enabled, any script that is saved will be reloaded in the "
"running project.\n"
"When used remotely on a device, this is more efficient when the network "
