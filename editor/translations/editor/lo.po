msgstr "ປ່ຽນປະເພດ..."

msgid "Attach Script..."
msgstr "ໃສ່ສະຄຣິບ..."

msgid "Extend Script..."
msgstr "ຂະຫຍາຍສະຄຣິບ..."

msgid "Move Up"
msgstr "ຍ້າຍຂຶ້ນ"

msgid "Move Down"
msgstr "ຍ້າຍລົງ"

msgid "Duplicate"
msgstr "ສຳເນົາ"

msgid "Reparent..."
msgstr "ປ່ຽນໂນດແມ່..."

