msgstr "ວາງພາລາມິເຕີ"

msgid "Updating Scene"
msgstr "ກຳລັງອັບເດດສາກ"

msgid "Storing local changes..."
msgstr "ກຳລັງບັນທຶກການປ່ຽນແປງພາຍໃນ..."

msgid "Updating scene..."
msgstr "ກຳລັງອັບເດດສາກ..."

msgid "[empty]"
msgstr "[ຫວ່າງ]"

msgid "[unsaved]"
msgstr "[ຍັງບໍ່ໄດ້ບັນທຶກ]"

msgid "Creating Mesh Previews"
msgstr "ກຳລັງສ້າງຕົວຢ່າງ Mesh"

msgid "Thumbnail..."
msgstr "ຮູບຕົວຢ່າງ..."

msgid "Create New %s"
msgstr "ສ້າງ %s ໃໝ່"

msgid "Output"
msgstr "ເອົາທ໌ພຸດ (Output)"

msgid "Toggle Output Dock"
msgstr "ເປີດ/ປິດ ໜ້າຕ່າງເອົາທ໌ພຸດ"

msgid "Clear Log"
msgstr "ລ້າງບັນທຶກ"

msgid "Clear Output"
msgstr "ລ້າງເອົາທ໌ພຸດ"

msgid ""
"Collapse duplicate messages into one log entry. Shows number of occurrences."
msgstr "ຮວມຂໍ້ຄວາມທີ່ຊ້ຳກັນເຂົ້າເປັນລາຍການດຽວ. ສະແດງຈຳນວນຄັ້ງທີ່ເກີດຂຶ້ນ."

msgid "Filter Messages"
msgstr "ກອງຂໍ້ຄວາມ"

msgid "Standard Messages"
msgstr "ຂໍ້ຄວາມມາດຕະຖານ"

msgid "Toggle visibility of standard output messages."
msgstr "ເປີດ/ປິດ ການເບິ່ງເຫັນຂໍ້ຄວາມເອົາທ໌ພຸດມາດຕະຖານ."

msgid "Toggle visibility of errors."
msgstr "ເປີດ/ປິດ ການເບິ່ງເຫັນຂໍ້ຜິດພາດ."

msgid "Warnings"
msgstr "ຄຳເຕືອນ"

msgid "Toggle visibility of warnings."
msgstr "ເປີດ/ປິດ ການເບິ່ງເຫັນຄຳເຕືອນ."

msgid "Editor Messages"
msgstr "ຂໍ້ຄວາມຈາກຕົວແກ້ໄຂ"

msgid "Toggle visibility of editor messages."
msgstr "ເປີດ/ປິດ ການເບິ່ງເຫັນຂໍ້ຄວາມຈາກຕົວແກ້ໄຂ."

msgid ""
"The Android build template is already installed in this project and it won't "
"be overwritten.\n"
"Remove the \"%s\" directory manually before attempting this operation again."
msgstr ""
"ເທັມເພລັດສຳລັບ Android ຖືກຕິດຕັ້ງໃນໂປຣເຈັກນີ້ແລ້ວ ແລະ ຈະບໍ່ຖືກຂຽນທັບ.\n"
"ໃຫ້ລຶບໂຟນເດີ \"%s\" ອອກດ້ວຍຕົນເອງກ່ອນທີ່ຈະລອງໃໝ່."

msgid ""
"This will set up your project for gradle Android builds by installing the "
"source template to \"%s\".\n"
"Note that in order to make gradle builds instead of using pre-built APKs, the "
"\"Use Gradle Build\" option should be enabled in the Android export preset."
msgstr ""
"ນີ້ຈະເປັນການຕັ້ງຄ່າໂປຣເຈັກຂອງທ່ານສຳລັບການບິວດ໌ Android ດ້ວຍ Gradle ໂດຍການຕິດຕັ້ງເທັມເພລັດໄປທີ່ "
"\"%s\".\n"
"ໝາຍເຫດ: ເພື່ອໃຊ້ Gradle ບິວດ໌ ແທນການໃຊ້ APK ທີ່ບິວດ໌ໄວ້ແລ້ວ, ທ່ານຕ້ອງເປີດໃຊ້ຕົວເລືອກ \"Use "
"Gradle Build\" ໃນການຕັ້ງຄ່າການສົ່ງອອກ Android."

msgid "Unnamed Project"
msgstr "ໂປຣເຈັກທີ່ບໍ່ມີຊື່"

msgid "Toggle Selected Node(s) Visibility"
msgstr "ເປີດ/ປິດ ການເບິ່ງເຫັນຂອງໂນດທີ່ເລືອກ"

msgid "%s (Overridden)"
msgstr "%s (ຖືກຂຽນທັບ)"

msgid "Recovery Mode is enabled. Editor functionality has been restricted."
msgstr "ໂໝດກູ້ຄືນຖືກເປີດໃຊ້. ຟັງຊັນຂອງຕົວແກ້ໄຂຖືກຈຳກັດໄວ້."

msgid ""
"Spins when the editor window redraws.\n"
"Update Continuously is enabled, which can increase power usage. Click to "
"disable it."
msgstr ""
"ຈະໝູນເມື່ອໜ້າຕ່າງຕົວແກ້ໄຂມີການແຕ້ມໃໝ່.\n"
"ການອັບເດດແບບຕໍ່ເນື່ອງຖືກເປີດໃຊ້ຢູ່ ເຊິ່ງອາດເຮັດໃຫ້ໃຊ້ພະລັງງານຫຼາຍຂຶ້ນ. ຄລິກເພື່ອປິດ."

msgid "Spins when the editor window redraws."
msgstr "ຈະໝູນເມື່ອໜ້າຕ່າງຕົວແກ້ໄຂມີການແຕ້ມໃໝ່."

msgid ""
"Cannot save resource at path \"%s\", as it is imported.\n"
"Imported resources can't be saved. Instead, modify the source file or change "
"options in the Import dock."
msgstr ""
"ບໍ່ສາມາດບັນທຶກຊັບພະຍາກອນທີ່ \"%s\" ໄດ້ ເພາະມັນຖືກນຳເຂົ້າ (Import) ມາ.\n"
"ຊັບພະຍາກອນທີ່ນຳເຂົ້າບໍ່ສາມາດບັນທຶກທັບໄດ້. ໃຫ້ແກ້ໄຂທີ່ໄຟລ໌ຕົ້ນສະບັບ ຫຼື ປ່ຽນຕົວເລືອກໃນໜ້າຕ່າງ Import ແທນ."

msgid "Error saving resource at path \"%s\": %s."
msgstr "ເກີດຂໍ້ຜິດພາດໃນການບັນທຶກຊັບພະຍາກອນທີ່ \"%s\": %s."

msgid ""
"The text-based resource at path \"%s\" is large on disk (%s), likely because "
"it has embedded binary data.\n"
"This slows down resource saving and loading.\n"
"Consider saving its binary subresource(s) to a binary `.res` file or saving "
"the resource as a binary `.res` file.\n"
"This warning can be disabled in the Editor Settings (FileSystem > On Save > "
"Warn on Saving Large Text Resources)."
msgstr ""
"ຊັບພະຍາກອນແບບຂໍ້ຄວາມທີ່ \"%s\" ມີຂະໜາດໃຫຍ່ (%s), ອາດເປັນຍ້ອນມີຂໍ້ມູນໄບນະລີຝັງຢູ່.\n"
"ນີ້ຈະເຮັດໃຫ້ການບັນທຶກ ແລະ ການໂຫລດຊ້າລົງ.\n"
"ຄວນພິຈາລະນາບັນທຶກຊັບພະຍາກອນຍ່ອຍເປັນໄຟລ໌ `.res` ຫຼື ບັນທຶກຊັບພະຍາກອນນີ້ເປັນໄຟລ໌ `.res` ແທນ.\n"
"ທ່ານສາມາດປິດຄຳເຕືອນນີ້ໄດ້ໃນ Editor Settings."

msgid ""
"This resource can't be saved because it was imported from another file. Make "
"it unique first."
msgstr ""
"ຊັບພະຍາກອນນີ້ບໍ່ສາມາດບັນທຶກໄດ້ເພາະມັນຖືກນຳເຂົ້າມາຈາກໄຟລ໌ອື່ນ. ໃຫ້ເຮັດໃຫ້ມັນເປັນເອກະລັກ (Make "
"Unique) ກ່ອນ."

msgid ""
"This resource can't be saved because it does not belong to the edited scene. "
"Make it unique first."
msgstr ""
"ຊັບພະຍາກອນນີ້ບໍ່ສາມາດບັນທຶກໄດ້ເພາະມັນບໍ່ໄດ້ເປັນຂອງສາກທີ່ກຳລັງແກ້ໄຂຢູ່. ໃຫ້ເຮັດໃຫ້ມັນເປັນເອກະລັກກ່ອນ."

msgid "Save Resource As..."
msgstr "ບັນທຶກຊັບພະຍາກອນເປັນ..."

msgid "Can't open file for writing:"
msgstr "ບໍ່ສາມາດເປີດໄຟລ໌ເພື່ອຂຽນໄດ້:"

msgid "Requested file format unknown:"
msgstr "ບໍ່ຮູ້ຈັກຮູບແບບໄຟລ໌ທີ່ຮ້ອງຂໍ:"

msgid "Error while saving."
msgstr "ເກີດຂໍ້ຜິດພາດຂະນະບັນທຶກ."

msgid "Can't open file '%s'. The file could have been moved or deleted."
msgstr "ບໍ່ສາມາດເປີດໄຟລ໌ '%s' ໄດ້. ໄຟລ໌ອາດຖືກຍ້າຍ ຫຼື ລຶບໄປແລ້ວ."

msgid "Error while parsing file '%s'."
msgstr "ເກີດຂໍ້ຜິດພາດໃນການອ່ານໄຟລ໌ '%s'."

msgid "Scene file '%s' appears to be invalid/corrupt."
msgstr "ໄຟລ໌ສາກ '%s' ເບິ່ງຄືວ່າບໍ່ຖືກຕ້ອງ ຫຼື ເສຍຫາຍ."

msgid "Missing file '%s' or one of its dependencies."
msgstr "ບໍ່ພົບໄຟລ໌ '%s' ຫຼື ໄຟລ໌ທີ່ກ່ຽວຂ້ອງ."

msgid ""
"File '%s' is saved in a format that is newer than the formats supported by "
"this version of Godot, so it can't be opened."
msgstr "ໄຟລ໌ '%s' ຖືກບັນທຶກໃນຮູບແບບທີ່ໃໝ່ກວ່າລຸ້ນຂອງ Godot ທີ່ທ່ານໃຊ້ຢູ່, ຈຶ່ງບໍ່ສາມາດເປີດໄດ້."

msgid "Error while loading file '%s'."
msgstr "ເກີດຂໍ້ຜິດພາດຂະນະໂຫລດໄຟລ໌ '%s'."

msgid "Saving Scene"
msgstr "ກຳລັງບັນທຶກສາກ"

msgid "Analyzing"
msgstr "ກຳລັງວິເຄາະ"

msgid "Creating Thumbnail"
msgstr "ກຳລັງສ້າງຮູບຕົວຢ່າງ"

msgid "This operation can't be done without a tree root."
msgstr "ການດຳເນີນການນີ້ບໍ່ສາມາດເຮັດໄດ້ຖ້າບໍ່ມີສ່ວນຮາກຂອງຕົ້ນໄມ້."

msgid ""
"This scene can't be saved because there is a cyclic instance inclusion.\n"
"Please resolve it and then attempt to save again."
msgstr ""
"ບໍ່ສາມາດບັນທຶກສາກນີ້ໄດ້ ເພາະມີການຮ້ອງຂໍໄຟລ໌ແບບວົນລູບ (cyclic instance).\n"
"ກະລຸນາແກ້ໄຂກ່ອນ ແລ້ວຈຶ່ງລອງບັນທຶກໃໝ່."

msgid ""
"Couldn't save scene. Likely dependencies (instances or inheritance) couldn't "
"be satisfied."
msgstr "ບໍ່ສາມາດບັນທຶກສາກໄດ້. ອາດເປັນຍ້ອນໄຟລ໌ທີ່ກ່ຽວຂ້ອງ (instances ຫຼື inheritance) ບໍ່ຖືກຕ້ອງ."

msgid ""
"The text-based scene at path \"%s\" is large on disk (%s), likely because it "
"has embedded binary data.\n"
"This slows down scene saving and loading.\n"
"Consider saving its binary subresource(s) to a binary `.res` file or saving "
"the scene as a binary `.scn` file.\n"
"This warning can be disabled in the Editor Settings (FileSystem > On Save > "
"Warn on Saving Large Text Resources)."
msgstr ""
"ສາກແບບຂໍ້ຄວາມທີ່ \"%s\" ມີຂະໜາດໃຫຍ່ (%s), ອາດເປັນຍ້ອນມີຂໍ້ມູນໄບນະລີຝັງຢູ່.\n"
"ນີ້ຈະເຮັດໃຫ້ການບັນທຶກ ແລະ ການໂຫລດຊ້າລົງ.\n"
"ຄວນພິຈາລະນາບັນທຶກຊັບພະຍາກອນຍ່ອຍເປັນໄຟລ໌ `.res` ຫຼື ບັນທຶກສາກເປັນໄຟລ໌ `.scn` ແທນ.\n"
"ທ່ານສາມາດປິດຄຳເຕືອນນີ້ໄດ້ໃນ Editor Settings."

msgid "Save scene before running..."
msgstr "ບັນທຶກສາກກ່ອນການຣັນ..."

msgid "Merge With Existing"
msgstr "ຮວມເຂົ້າກັບທີ່ມີຢູ່ແລ້ວ"

msgid "Apply MeshInstance Transforms"
msgstr "ນຳໃຊ້ການແປງຄ່າ (Transforms) ຂອງ MeshInstance"

msgid "Can't load MeshLibrary for merging!"
msgstr "ບໍ່ສາມາດໂຫລດ MeshLibrary ເພື່ອມາຮວມກັນໄດ້!"

msgid "Error saving MeshLibrary!"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການບັນທຶກ MeshLibrary!"

msgid ""
"An error occurred while trying to save the editor layout.\n"
"Make sure the editor's user data path is writable."
msgstr ""
"ເກີດຂໍ້ຜິດພາດຂະນະບັນທຶກຮູບແບບ (layout) ຂອງຕົວແກ້ໄຂ.\n"
"ກວດສອບໃຫ້ແນ່ໃຈວ່າເສັ້ນທາງຂໍ້ມູນຜູ້ໃຊ້ສາມາດຂຽນໄດ້."

msgid ""
"Default editor layout overridden.\n"
"To restore the Default layout to its base settings, use the Delete Layout "
"option and delete the Default layout."
msgstr ""
"ຮູບແບບເລີ່ມຕົ້ນຖືກຂຽນທັບແລ້ວ.\n"
"ເພື່ອຄືນຄ່າຮູບແບບເລີ່ມຕົ້ນ, ໃຫ້ໃຊ້ຕົວເລືອກ Delete Layout ແລ້ວລຶບຮູບແບບ Default ອອກ."

msgid "Layout name not found!"
msgstr "ບໍ່ພົບຊື່ຮູບແບບ (Layout)!"

msgid "Restored the Default layout to its base settings."
msgstr "ຄືນຄ່າຮູບແບບເລີ່ມຕົ້ນໄປຫາຄ່າພື້ນຖານແລ້ວ."

msgid "This object is marked as read-only, so it's not editable."
msgstr "ວັດຖຸນີ້ຖືກຕັ້ງຄ່າໃຫ້ອ່ານໄດ້ຢ່າງດຽວ, ຈຶ່ງບໍ່ສາມາດແກ້ໄຂໄດ້."

msgid ""
"This resource belongs to a scene that was imported, so it's not editable.\n"
"Please read the documentation relevant to importing scenes to better "
"understand this workflow."
msgstr ""
"ຊັບພະຍາກອນນີ້ເປັນຂອງສາກທີ່ຖືກນຳເຂົ້າມາ, ຈຶ່ງບໍ່ສາມາດແກ້ໄຂໄດ້.\n"
"ກະລຸນາອ່ານເອກະສານກ່ຽວກັບການນຳເຂົ້າສາກເພື່ອຄວາມເຂົ້າໃຈ."

msgid ""
"This resource belongs to a scene that was instantiated or inherited.\n"
"Changes to it must be made inside the original scene."
msgstr ""
"ຊັບພະຍາກອນນີ້ເປັນຂອງສາກທີ່ຖືກສ້າງເປັນອິນສະແຕນຊ໌ ຫຼື ສືບທອດມາ.\n"
"ການປ່ຽນແປງຕ້ອງເຮັດພາຍໃນສາກຕົ້ນສະບັບ."

msgid ""
"This resource was imported, so it's not editable. Change its settings in the "
"import panel and then re-import."
msgstr ""
"ຊັບພະຍາກອນນີ້ຖືກນຳເຂົ້າມາ, ຈຶ່ງບໍ່ສາມາດແກ້ໄຂໄດ້. ໃຫ້ປ່ຽນການຕັ້ງຄ່າໃນໜ້າຕ່າງ Import ແລ້ວນຳເຂົ້າໃໝ່."

msgid ""
"This scene was imported, so changes to it won't be kept.\n"
"Instantiating or inheriting it will allow you to make changes to it.\n"
"Please read the documentation relevant to importing scenes to better "
"understand this workflow."
msgstr ""
"ສາກນີ້ຖືກນຳເຂົ້າມາ, ການປ່ຽນແປງຈະບໍ່ຖືກບັນທຶກ.\n"
"ການສ້າງເປັນອິນສະແຕນຊ໌ ຫຼື ສືບທອດສາກຈະຊ່ວຍໃຫ້ທ່ານແກ້ໄຂໄດ້.\n"
"ກະລຸນາອ່ານເອກະສານກ່ຽວກັບການນຳເຂົ້າສາກ."

msgid "Changes may be lost!"
msgstr "ການປ່ຽນແປງອາດຈະສູນຫາຍ!"

msgid "This object is read-only."
msgstr "ວັດຖຸນີ້ນຳໃຊ້ອ່ານໄດ້ຢ່າງດຽວ."

msgid "%d second ago"
msgid_plural "%d seconds ago"
msgstr[0] "%d ວິນາທີກ່ອນ"

msgid "%d minute ago"
msgid_plural "%d minutes ago"
msgstr[0] "%d ນາທີກ່ອນ"

msgid "%d hour ago"
msgid_plural "%d hours ago"
msgstr[0] "%d ຊົ່ວໂມງກ່ອນ"

msgid "Scene opened: %s."
msgstr "ເປີດສາກແລ້ວ: %s."

msgid "Last saved: %s."
msgstr "ບັນທຶກຫຼ້າສຸດ: %s."

msgid ""
"Scene \"%s\" has unsaved changes.\n"
"%s"
msgstr ""
"ສາກ \"%s\" ມີການປ່ຽນແປງທີ່ຍັງບໍ່ໄດ້ບັນທຶກ.\n"
"%s"

msgid "Open Base Scene"
msgstr "ເປີດສາກຫຼັກ (Base Scene)"

msgid "%s no longer exists! Please specify a new save location."
msgstr "%s ບໍ່ມີຢູ່ແລ້ວ! ກະລຸນາລະບຸບ່ອນບັນທຶກໃໝ່."

msgid ""
"The current scene has no root node, but %d modified external resource(s) and/"
"or plugin data were saved anyway."
msgstr "ສາກປັດຈຸບັນບໍ່ມີໂນດຮາກ, ແຕ່ຊັບພະຍາກອນພາຍນອກ %d ຢ່າງ ຫຼື ຂໍ້ມູນປລັກອິນຖືກບັນທຶກແລ້ວ."

msgid ""
"A root node is required to save the scene. You can add a root node using the "
"Scene tree dock."
msgstr "ຕ້ອງມີໂນດຮາກເພື່ອບັນທຶກສາກ. ທ່ານສາມາດເພີ່ມໂນດຮາກໄດ້ໃນໜ້າຕ່າງສາກ."

msgid "Save Scene As..."
msgstr "ບັນທຶກສາກເປັນ..."

msgid "Save new main scene..."
msgstr "ບັນທຶກສາກຫຼັກໃໝ່..."

msgid "Can't undo while mouse buttons are pressed."
msgstr "ບໍ່ສາມາດຍົກເລີກການກະທຳ (Undo) ໄດ້ຂະນະທີ່ຍັງຄລິກເມົ້າຄ້າງໄວ້."

msgid "Nothing to undo."
msgstr "ບໍ່ມີຫຍັງໃຫ້ຍົກເລີກ."

msgid "Global Undo: %s"
msgstr "ຍົກເລີກທັງໝົດ: %s"

msgid "Remote Undo: %s"
msgstr "ຍົກເລີກຣີໂມດ: %s"

msgid "Scene Undo: %s"
msgstr "ຍົກເລີກໃນສາກ: %s"

msgid "Can't redo while mouse buttons are pressed."
msgstr "ບໍ່ສາມາດເຮັດຊ້ຳການກະທຳ (Redo) ໄດ້ຂະນະທີ່ຍັງຄລິກເມົ້າຄ້າງໄວ້."

msgid "Nothing to redo."
msgstr "ບໍ່ມີຫຍັງໃຫ້ເຮັດຊ້ຳ."

msgid "Global Redo: %s"
msgstr "ເຮັດຊ້ຳທັງໝົດ: %s"

msgid "Remote Redo: %s"
msgstr "ເຮັດຊ້ຳຣີໂມດ: %s"

msgid "Scene Redo: %s"
msgstr "ເຮັດຊ້ຳໃນສາກ: %s"

msgid "Can't reload a scene that was never saved."
msgstr "ບໍ່ສາມາດໂຫລດສາກທີ່ບໍ່ເຄີຍຖືກບັນທຶກໃໝ່ໄດ້."

msgid "Save & Reload"
msgstr "ບັນທຶກ ແລະ ໂຫລດໃໝ່"

msgid "Save before reloading the scene?"
msgstr "ບັນທຶກກ່ອນທີ່ຈະໂຫລດສາກໃໝ່ບໍ?"

msgid "Stop running project before reloading the current project?"
msgstr "ຢຸດການຣັນໂປຣເຈັກກ່ອນທີ່ຈະໂຫລດໂປຣເຈັກປັດຈຸບັນໃໝ່ບໍ?"

msgid "Stop & Reload"
msgstr "ຢຸດ ແລະ ໂຫລດໃໝ່"

msgid "Stop running project before exiting the editor?"
msgstr "ຢຸດການຣັນໂປຣເຈັກກ່ອນທີ່ຈະອອກຈາກຕົວແກ້ໄຂບໍ?"

msgid "Stop & Quit"
msgstr "ຢຸດ ແລະ ອອກ"

msgid "The export templates are still being downloaded."
msgstr "ເທັມເພລັດສຳລັບການສົ່ງອອກກຳລັງຖືກດາວໂຫລດ."

msgid "Save modified resources before reloading?"
msgstr "ບັນທຶກຊັບພະຍາກອນທີ່ຖືກແກ້ໄຂກ່ອນໂຫລດໃໝ່ບໍ?"

msgid "Save & Quit"
msgstr "ບັນທຶກ ແລະ ອອກ"

msgid "Save modified resources before closing?"
msgstr "ບັນທຶກຊັບພະຍາກອນທີ່ຖືກແກ້ໄຂກ່ອນປິດບໍ?"

msgid "Save changes to the following scene(s) before reloading?"
msgstr "ບັນທຶກການປ່ຽນແປງໃນສາກຕໍ່ໄປນີ້ກ່ອນໂຫລດໃໝ່ບໍ?"

msgid "Save changes to the following scene(s) before quitting?"
msgstr "ບັນທຶກການປ່ຽນແປງໃນສາກຕໍ່ໄປນີ້ກ່ອນຈະອອກບໍ?"

msgid "Save changes to the following scene(s) before opening Project Manager?"
msgstr "ບັນທຶກການປ່ຽນແປງໃນສາກຕໍ່ໄປນີ້ກ່ອນຈະເປີດ Project Manager ບໍ?"

msgid ""
"This option is deprecated. Situations where refresh must be forced are now "
"considered a bug. Please report."
msgstr "ຕົວເລືອກນີ້ບໍ່ຖືກແນະນຳໃຫ້ໃຊ້ແລ້ວ. ຖ້າຈຳເປັນຕ້ອງບັງຄັບຣີເຟຣຊ ອາດຖືວ່າເປັນບັກ. ກະລຸນາແຈ້ງບັກ."

msgid "Pick a Main Scene"
msgstr "ເລືອກສາກຫຼັກ"

msgid "This operation can't be done without a scene."
msgstr "ການດຳເນີນການນີ້ບໍ່ສາມາດເຮັດໄດ້ຖ້າບໍ່ມີສາກ."

msgid "Export Mesh Library"
msgstr "ສົ່ງອອກ Mesh Library"

msgid "All scenes are already saved."
msgstr "ທຸກສາກຖືກບັນທຶກແລ້ວ."

msgid "Quick Open Color Palette..."
msgstr "ເປີດຈານສີແບບດ່ວນ..."

msgid "Unable to enable addon plugin at: '%s' parsing of config failed."
msgstr "ບໍ່ສາມາດເປີດໃຊ້ປລັກອິນເສີມທີ່: '%s' ເນື່ອງຈາກການອ່ານໄຟລ໌ຕັ້ງຄ່າລົ້ມເຫຼວ."

msgid "Unable to find script field for addon plugin at: '%s'."
msgstr "ບໍ່ພົບຟີວສະຄຣິບສຳລັບປລັກອິນເສີມທີ່: '%s'."

msgid "Unable to load addon script from path: '%s'."
msgstr "ບໍ່ສາມາດໂຫລດສະຄຣິບປລັກອິນຈາກ: '%s'."

msgid ""
"Unable to load addon script from path: '%s'. This might be due to a code "
"error in that script.\n"
"Disabling the addon at '%s' to prevent further errors."
msgstr ""
"ບໍ່ສາມາດໂຫລດສະຄຣິບປລັກອິນຈາກ: '%s'. ອາດເປັນຍ້ອນຂໍ້ຜິດພາດໃນໂຄ້ດ.\n"
"ຈະປິດການໃຊ້ງານປລັກອິນທີ່ '%s' ເພື່ອປ້ອງກັນຂໍ້ຜິດພາດອື່ນໆ."

msgid ""
"Unable to load addon script from path: '%s'. Base type is not 'EditorPlugin'."
msgstr "ບໍ່ສາມາດໂຫລດສະຄຣິບປລັກອິນຈາກ: '%s'. ເພາະປະເພດຫຼັກບໍ່ແມ່ນ 'EditorPlugin'."

msgid "Unable to load addon script from path: '%s'. Script is not in tool mode."
msgstr "ບໍ່ສາມາດໂຫລດສະຄຣິບປລັກອິນຈາກ: '%s'. ເພາະສະຄຣິບບໍ່ໄດ້ຢູ່ໃນ tool mode."

msgid ""
"Scene '%s' was automatically imported, so it can't be modified.\n"
"To make changes to it, a new inherited scene can be created."
msgstr ""
"ສາກ '%s' ຖືກນຳເຂົ້າໂດຍອັດຕະໂນມັດ, ຈຶ່ງບໍ່ສາມາດແກ້ໄຂໄດ້.\n"
"ເພື່ອປ່ຽນແປງ, ໃຫ້ສ້າງສາກສືບທອດໃໝ່ແທນ."

msgid ""
"Error loading scene, it must be inside the project path. Use 'Import' to open "
"the scene, then save it inside the project path."
msgstr ""
"ເກີດຂໍ້ຜິດພາດໃນການໂຫລດສາກ, ມັນຕ້ອງຢູ່ໃນເສັ້ນທາງຂອງໂປຣເຈັກ. ໃຫ້ໃຊ້ 'Import' ເພື່ອເປີດສາກ "
"ແລ້ວບັນທຶກມັນໄວ້ໃນໂປຣເຈັກ."

msgid "Scene '%s' has broken dependencies:"
msgstr "ສາກ '%s' ມີໄຟລ໌ທີ່ກ່ຽວຂ້ອງເສຍຫາຍ:"

msgid ""
"Multi-window support is not available because the `--single-window` command "
"line argument was used to start the editor."
msgstr "ບໍ່ຮອງຮັບລະບົບຫຼາຍໜ້າຕ່າງ ເພາະມີການໃຊ້ `--single-window` ໃນການເປີດຕົວແກ້ໄຂ."

msgid ""
"Multi-window support is not available because the current platform doesn't "
"support multiple windows."
msgstr "ບໍ່ຮອງຮັບລະບົບຫຼາຍໜ້າຕ່າງ ເພາະລະບົບປະຕິບັດການນີ້ບໍ່ຮອງຮັບ."

msgid ""
"Multi-window support is not available because Interface > Editor > Single "
"Window Mode is enabled in the editor settings."
msgstr "ບໍ່ຮອງຮັບລະບົບຫຼາຍໜ້າຕ່າງ ເພາະມີການເປີດ Single Window Mode ໄວ້ໃນການຕັ້ງຄ່າ."

msgid ""
"Multi-window support is not available because Interface > Multi Window > "
"Enable is disabled in the editor settings."
msgstr "ບໍ່ຮອງຮັບລະບົບຫຼາຍໜ້າຕ່າງ ເພາະຕົວເລືອກ Multi Window ຖືກປິດໄວ້."

msgid "No Recent Scenes"
msgstr "ບໍ່ມີສາກທີ່ເປີດຫຼ້າສຸດ"

msgid "Clear Recent Scenes"
msgstr "ລ້າງລາຍການສາກທີ່ເປີດຫຼ້າສຸດ"

msgid "There is no defined scene to run."
msgstr "ບໍ່ມີສາກທີ່ກຳນົດໄວ້ເພື່ອຣັນ."

msgid "Loading editor"
msgstr "ກຳລັງໂຫລດຕົວແກ້ໄຂ"

msgid "Loading editor layout..."
msgstr "ກຳລັງໂຫລດຮູບແບບຕົວແກ້ໄຂ..."

msgid "Loading docks..."
msgstr "ກຳລັງໂຫລດໜ້າຕ່າງ (docks)..."

msgid "Reopening scenes..."
msgstr "ກຳລັງເປີດສາກຄືນໃໝ່..."

msgid "Loading central editor layout..."
msgstr "ກຳລັງໂຫລດຮູບແບບຕົວແກ້ໄຂສ່ວນກາງ..."

msgid "Loading plugin window layout..."
msgstr "ກຳລັງໂຫລດຮູບແບບໜ້າຕ່າງປລັກອິນ..."

msgid "Editor layout ready."
msgstr "ຮູບແບບຕົວແກ້ໄຂພ້ອມແລ້ວ."

msgid ""
"No main scene has ever been defined. Select one?\n"
"You can change it later in \"Project Settings\" under the 'application' "
"category."
msgstr ""
"ຍັງບໍ່ເຄີຍມີການກຳນົດສາກຫຼັກ. ຕ້ອງການເລືອກເລີຍບໍ?\n"
"ທ່ານສາມາດປ່ຽນມັນໄດ້ພາຍຫຼັງໃນ \"Project Settings\"."

msgid ""
"Selected scene '%s' does not exist. Select a valid one?\n"
"You can change it later in \"Project Settings\" under the 'application' "
"category."
msgstr ""
"ສາກ '%s' ທີ່ເລືອກບໍ່ມີຢູ່. ຕ້ອງການເລືອກສາກໃໝ່ບໍ?\n"
"ທ່ານສາມາດປ່ຽນມັນໄດ້ພາຍຫຼັງໃນ \"Project Settings\"."

msgid ""
"Selected scene '%s' is not a scene file. Select a valid one?\n"
"You can change it later in \"Project Settings\" under the 'application' "
"category."
msgstr ""
"ໄຟລ໌ '%s' ບໍ່ແມ່ນໄຟລ໌ສາກ. ຕ້ອງການເລືອກສາກໃໝ່ບໍ?\n"
"ທ່ານສາມາດປ່ຽນມັນໄດ້ພາຍຫຼັງໃນ \"Project Settings\"."

msgid "User data dir '%s' is not valid. Change to a valid one?"
