msgstr "Asset Store ບໍ່ສາມາດໃຊ້ງານໄດ້."

msgid "Select a Folder to Scan"
msgstr "ເລືອກໂຟນເດີທີ່ຈະສະແກນ"

msgid "Remove All"
msgstr "ລົບທັງໝົດ"

msgid "Edit normally"
msgstr "ແກ້ໄຂແບບປົກກະຕິ"

msgid "Edit in Recovery Mode"
msgstr "ແກ້ໄຂໃນໂໝດກູ້ຄືນ"

msgid "Backup project first"
msgstr "ສຳຮອງຂໍ້ມູນໂຄງການກ່ອນ"

msgid "Convert Full Project"
msgstr "ແປງທັງໝົດໂຄງການ"

msgid "See Migration Guide"
msgstr "ເບິ່ງຄູ່ມືການຍ້າຍເວີຊັນ"

msgid ""
"This option will perform full project conversion, updating scenes, resources "
"and scripts from Godot 3 to work in Godot 4.\n"
"\n"
"Note that this is a best-effort conversion, i.e. it makes upgrading the "
"project easier, but it will not open out-of-the-box and will still require "
"manual adjustments.\n"
"\n"
"IMPORTANT: Make sure to backup your project before converting, as this "
"operation makes it impossible to open it in older versions of Godot."
msgstr "ທາງເລືອກນີ້ຈະແປງໂຄງການທັງໝົດຈາກ Godot 3 ເປັນ Godot 4."

msgid "Error"
msgstr "ຂໍ້ຜິດພາດ"

msgid "Manage Project Tags"
msgstr "ຈັດການແທັກໂຄງການ"

msgid "Project Tags"
msgstr "ແທັກໂຄງການ"

msgid "Click tag to remove it from the project."
msgstr "ຄລິກທີ່ແທັກເພື່ອເອົາອອກຈາກໂຄງການ."

msgid "All Tags"
msgstr "ແທັກທັງໝົດ"

msgid "Click tag to add it to the project."
msgstr "ຄລິກທີ່ແທັກເພື່ອເພີ່ມເຂົ້າໃນໂຄງການ."

msgid "Create New Tag"
msgstr "ສ້າງແທັກໃໝ່"

msgid "Tags are capitalized automatically when displayed."
msgstr "ແທັກຈະຖືກປ່ຽນເປັນຕົວພິມໃຫຍ່ໂດຍອັດຕະໂນມັດເມື່ອສະແດງຜົນ."

msgid "New Tag Name"
msgstr "ຊື່ແທັກໃໝ່"

msgid "example_tag (will display as Example Tag)"
msgstr "example_tag (ຈະສະແດງເປັນ Example Tag)"

msgid "Create Tag"
msgstr "ສ້າງແທັກ"

msgid "Project Tag: %s"
msgstr "ແທັກໂຄງການ: %s"

msgid "Restart Now"
msgstr "ເລີ່ມລະບົບໃໝ່ດຽວນີ້"

msgid "Quick Settings"
msgstr "ການຕັ້ງຄ່າດ່ວນ"

msgid "Language"
msgstr "ພາສາ"

msgid "Style"
msgstr "ຮູບແບບ (Style)"

msgid "Color Preset"
msgstr "ຊຸດສີທີ່ກຳນົດໄວ້"

msgid "Custom preset can be further configured in the editor."
msgstr "ຊຸດສີກຳນົດເອງສາມາດປັບແຕ່ງເພີ່ມເຕີມໄດ້ໃນຕົວແກ້ໄຂ."

msgid "Display Scale"
msgstr "ມາດຕາສ່ວນການສະແດງຜົນ"

msgid "Network Mode"
msgstr "ໂໝດເຄືອຂ່າຍ"

msgid "Check for Updates"
msgstr "ກວດສອບການອັບເດດ"

msgid "Directory Naming Convention"
msgstr "ຮູບແບບການຕັ້ງຊື່ໂຟນເດີ"

msgid "Edit All Settings"
msgstr "ແກ້ໄຂການຕັ້ງຄ່າທັງໝົດ"

msgid ""
"Settings changed! The project manager must be restarted for changes to take "
"effect."
msgstr "ປ່ຽນແປງການຕັ້ງຄ່າແລ້ວ! ຕ້ອງເລີ່ມຕົວຈັດການໂຄງການໃໝ່ເພື່ອໃຫ້ມີຜົນ."

msgid ""
"Different engine version may have minor differences in various Resources, "
"like additional fields or removed properties. When upgrading the project to a "
"new version, such changes can cause diffs when saving scenes or resources, or "
"reimporting.\n"
"\n"
"This tool ensures that such changes are performed all at once. It will:\n"
"- Regenerate UID cache\n"
"- Load and re-save every text/binary Resource\n"
"- Reimport every importable Resource\n"
"\n"
"Full upgrade will take considerable amount of time, but afterwards saving/"
"reimporting any scene/resource should not cause unintended changes."
msgstr "ເຄື່ອງມືນີ້ຈະຊ່ວຍອັບເກຣດໂຄງການຂອງທ່ານໃຫ້ເຂົ້າກັບເວີຊັນໃໝ່."

msgid "Restart & Upgrade"
msgstr "ເລີ່ມລະບົບໃໝ່ ແລະ ອັບເກຣດ"

msgid "Updating Project Scenes"
msgstr "ກຳລັງອັບເດດສາກໃນໂຄງການ"

msgid "Re-saving scene:"
msgstr "ກຳລັງບັນທຶກສາກຄືນໃໝ່:"

msgid "Updating Project Resources"
msgstr "ກຳລັງອັບເດດ resource ໃນໂຄງການ"

msgid "Re-saving resource:"
msgstr "ກຳລັງບັນທຶກ resource ຄືນໃໝ່:"

msgid "Run the project's main scene."
msgstr "ລັນສາກຫຼັກຂອງໂຄງການ."

msgid "Play the currently edited scene."
msgstr "ຫຼິ້ນສາກທີ່ກຳລັງແກ້ໄຂຢູ່."

msgid "Play a custom scene."
msgstr "ຫຼິ້ນສາກທີ່ກຳນົດເອງ."

msgid "Reload the played scene that was being edited."
msgstr "ໂຫຼດສາກທີ່ກຳລັງຫຼິ້ນ ແລະ ຖືກແກ້ໄຂໃໝ່."

msgid "Reload the played custom scene."
msgstr "ໂຫຼດສາກທີ່ກຳນົດເອງຄືນໃໝ່."

msgid "Reload the played main scene."
msgstr "ໂຫລດສາກຫຼັກທີ່ກຳລັງຫຼິ້ນຢູ່ຄືນໃໝ່."

msgid "Failed to run the project because the project.godot file is missing."
msgstr "ລົ້ມເຫຼວໃນການຣັນໂຄງການ ເພາະບໍ່ພົບໄຟລ໌ project.godot."

msgid ""
"Movie Maker mode is enabled, but no movie file path has been specified.\n"
"A default movie file path can be specified in the project settings under the "
"Editor > Movie Writer category.\n"
"Alternatively, for running single scenes, a `movie_file` string metadata can "
"be added to the root node,\n"
"specifying the path to a movie file that will be used when recording that "
"scene."
msgstr ""
"ໂໝດ Movie Maker ຖືກເປີດໃຊ້ງານຢູ່, ແຕ່ຍັງບໍ່ໄດ້ກຳນົດເສັ້ນທາງໄຟລ໌ວິດີໂອ.\n"
"ສາມາດກຳນົດເສັ້ນທາງໄຟລ໌ວິດີໂອເລີ່ມຕົ້ນໄດ້ໃນການຕັ້ງຄ່າໂຄງການພາຍໃຕ້ໝວດ Editor > Movie Writer.\n"
"ຫຼື ສຳລັບການຣັນສາກດຽວ, ສາມາດເພີ່ມ metadata ແບບຂໍ້ຄວາມ `movie_file` ເຂົ້າໃນໂນດຫຼັກ (root "
"node),\n"
"ເພື່ອລະບຸເສັ້ນທາງຂອງໄຟລ໌ວິດີໂອທີ່ຈະໃຊ້ໃນເວລາບັນທຶກສາກນັ້ນ."

msgid "Could not start subprocess(es)!"
msgstr "ບໍ່ສາມາດເລີ່ມຂະບວນການຍ່ອຍໄດ້!"

msgid "Recovery Mode is enabled. Disable it to run the project."
msgstr "ໂໝດກູ້ຄືນຖືກເປີດໃຊ້ງານຢູ່. ປິດມັນເພື່ອຣັນໂຄງການ."

msgid ""
"Autostart is enabled for the following profilers, which can have a "
"performance impact:"
msgstr ""
"ການເລີ່ມຕົ້ນອັດຕະໂນມັດຖືກເປີດໃຊ້ງານສຳລັບຕົວວິເຄາະປະສິດທິພາບຕໍ່ໄປນີ້, ຊຶ່ງອາດສົ່ງຜົນກະທົບຕໍ່ຄວາມໄວ:"

msgid "Network Profiler"
msgstr "ຕົວວິເຄາະປະສິດທິພາບເຄືອຂ່າຍ"

msgid "Click to open the first profiler for which autostart is enabled."
msgstr "ຄລິກເພື່ອເປີດຕົວວິເຄາະປະສິດທິພາບທຳອິດທີ່ຖືກເປີດໃຊ້ງານການເລີ່ມຕົ້ນອັດຕະໂນມັດ."

msgid "Recovery Mode"
msgstr "ໂໝດກູ້ຄືນ"

msgid ""
"Godot opened the project in Recovery Mode, which is a special mode that can "
"help recover projects that crash the engine upon initialization. The "
"following features have been temporarily disabled:"
msgstr ""
"Godot ໄດ້ເປີດໂຄງການໃນໂໝດກູ້ຄືນ, ຊຶ່ງເປັນໂໝດພິເສດທີ່ຊ່ວຍກູ້ຄືນໂຄງການທີ່ເຮັດໃຫ້ Engine "
"ຄ້າງໃນຕອນເລີ່ມຕົ້ນ. ຄຸນສົມບັດຕໍ່ໄປນີ້ຖືກປິດໃຊ້ງານຊົ່ວຄາວ:"

msgid ""
"If the project cannot be opened outside of this mode, then it's very likely "
"any of these components is preventing this project from launching. This mode "
"is intended only for basic editing to troubleshoot such issues, and therefore "
"it is not possible to run a project in this mode."
msgstr ""
"ຫາກໂຄງການບໍ່ສາມາດເປີດຢູ່ນອກໂໝດນີ້ໄດ້, ກໍເປັນໄປໄດ້ສູງວ່າອົງປະກອບເຫຼົ່ານີ້ອາດຂັດຂວາງການເປີດໂຄງການ. "
"ໂໝດນີ້ມີໄວ້ເພື່ອການແກ້ໄຂພື້ນຖານເພື່ອຫາສາເຫດຂອງບັນຫາເທົ່ານັ້ນ, ດັ່ງນັ້ນຈຶ່ງບໍ່ສາມາດຣັນໂຄງການໃນໂໝດນີ້ໄດ້."

msgid ""
"To disable Recovery Mode, reload the project by pressing the Reload button "
"next to the Recovery Mode banner, or by reopening the project normally."
msgstr ""
"ເພື່ອປິດໂໝດກູ້ຄືນ, ໃຫ້ໂຫລດໂຄງການຄືນໃໝ່ໂດຍການກົດປຸ່ມ Reload ຖັດຈາກປ້າຍໂໝດກູ້ຄືນ, ຫຼື "
"ເປີດໂຄງການຄືນໃໝ່ຕາມປົກກະຕິ."

msgid "Disable recovery mode and reload the project."
msgstr "ປິດໂໝດກູ້ຄືນ ແລະ ໂຫລດໂຄງການຄືນໃໝ່."

msgid "Recovery Mode is enabled. Click for more details."
msgstr "ໂໝດກູ້ຄືນຖືກເປີດໃຊ້ງານຢູ່. ຄລິກເພື່ອເບິ່ງລາຍລະອຽດເພີ່ມເຕີມ."

msgid "Pause the running project's execution for debugging."
msgstr "ຢຸດການເຮັດວຽກຂອງໂຄງການຊົ່ວຄາວເພື່ອດີບັກ (Debug)."

msgid "Pause Running Project"
msgstr "ຢຸດໂຄງການທີ່ກຳລັງຣັນຢູ່ຊົ່ວຄາວ"

msgid "Stop the currently running project."
msgstr "ຢຸດໂຄງການທີ່ກຳລັງຣັນຢູ່ໃນປັດຈຸບັນ."

msgid "Stop Running Project"
msgstr "ຢຸດການຣັນໂຄງການ"

msgid "Run Current Scene"
msgstr "ຣັນສາກປັດຈຸບັນ"

msgid "Run Scene in Regular Mode"
msgstr "ຣັນສາກໃນໂໝດປົກກະຕິ"

msgid "Run Scene in XR Mode"
msgstr "ຣັນສາກໃນໂໝດ XR"

msgid "Run Specific Scene"
msgstr "ຣັນສາກທີ່ລະບຸ"

msgid "Run in Regular Mode"
msgstr "ຣັນໃນໂໝດປົກກະຕິ"

msgid "Run in XR Mode"
msgstr "ຣັນໃນໂໝດ XR"

msgid "Enable Movie Maker Mode"
msgstr "ເປີດໃຊ້ງານໂໝດ Movie Maker"

msgid "Open Movie Maker Settings..."
msgstr "ເປີດການຕັ້ງຄ່າ Movie Maker..."

msgid ""
"Enable Movie Maker mode.\n"
"The project will run at stable FPS and the visual and audio output will be "
"recorded to a video file."
msgstr ""
"ເປີດໃຊ້ງານໂໝດ Movie Maker.\n"
"ໂຄງການຈະຣັນດ້ວຍ FPS ທີ່ຄົງທີ່ ແລະ ຜົນການສະແດງພາບ ແລະ ສຽງຈະຖືກບັນທຶກລົງໃນໄຟລ໌ວິດີໂອ."

msgid ""
"No runnable export preset found for this platform.\n"
"Please add a runnable preset in the Export menu or define an existing preset "
"as runnable."
msgstr ""
"ບໍ່ພົບຄ່າການສົ່ງອອກ (Export Preset) ທີ່ຣັນໄດ້ສຳລັບແພລັດຟອມນີ້.\n"
"ກະລຸນາເພີ່ມຄ່າທີ່ຣັນໄດ້ໃນເມນູ Export ຫຼື ກຳນົດຄ່າທີ່ມີຢູ່ໃຫ້ສາມາດຣັນໄດ້."

msgid ""
"Warning: The CPU architecture \"%s\" is not active in your export preset.\n"
"\n"
"Run \"Remote Deploy\" anyway?"
msgstr ""
"ຄຳເຕືອນ: ສະຖາປັດຕະຍະກຳ CPU \"%s\" ບໍ່ໄດ້ຖືກເປີດໃຊ້ໃນຄ່າການສົ່ງອອກຂອງທ່ານ.\n"
"\n"
"ຍັງຕ້ອງການຣັນ \"Remote Deploy\" ຫຼືບໍ່?"

msgid "Deploy to First Device in List"
msgstr "ຕິດຕັ້ງ (Deploy) ລົງໃນອຸປະກອນທຳອິດໃນລາຍການ"

msgid "Deploy to Second Device in List"
msgstr "ຕິດຕັ້ງ (Deploy) ລົງໃນອຸປະກອນທີສອງໃນລາຍການ"

msgid "Deploy to Third Device in List"
msgstr "ຕິດຕັ້ງ (Deploy) ລົງໃນອຸປະກອນທີສາມໃນລາຍການ"

msgid "Deploy to Fourth Device in List"
msgstr "ຕິດຕັ້ງ (Deploy) ລົງໃນອຸປະກອນທີສີ່ໃນລາຍການ"

msgid "Remote Deploy"
msgstr "ການຕິດຕັ້ງທາງໄກ"

msgid "Project Run"
msgstr "ການຣັນໂຄງການ"

msgid "Suspend/Resume Embedded Project"
msgstr "ຢຸດຊົ່ວຄາວ/ສືບຕໍ່ ໂຄງການທີ່ຝັງຢູ່"

msgid "Next Frame"
msgstr "ເຟຣມຖັດໄປ"

msgid "Connection impossible to the game process."
msgstr "ບໍ່ສາມາດເຊື່ອມຕໍ່ຫາຂະບວນການຂອງເກມໄດ້."

msgid "Window Dynamic Range"
msgstr "ຊ່ວງໄດນາມິກຂອງໜ້າຕ່າງ"

msgid "Game starting..."
msgstr "ເກມກຳລັງເລີ່ມ..."

msgid "Game running not embedded."
msgstr "ເກມກຳລັງຣັນຢູ່ແບບບໍ່ຝັງຕົວ."

msgid "Press play to start the game."
msgstr "ກົດ Play ເພື່ອເລີ່ມເກມ."

msgid "Embedding is disabled."
msgstr "ການຝັງຕົວຖືກປິດໃຊ້ງານ."

msgid "Game embedding not available on your OS."
msgstr "ການຝັງຕົວຂອງເກມບໍ່ຮອງຮັບໃນລະບົບປະຕິບັດການຂອງທ່ານ."

msgid ""
"Game embedding not available for the Display Server: '%s'.\n"
"Display Server can be modified in the Project Settings (Display > Display "
"Server > Driver)."
msgstr ""
"ການຝັງຕົວຂອງເກມບໍ່ຮອງຮັບສຳລັບ Display Server: '%s'.\n"
"ສາມາດປ່ຽນ Display Server ໄດ້ໃນການຕັ້ງຄ່າໂຄງການ (Display > Display Server > Driver)."

msgid "Game embedding not available when the game starts minimized."
msgstr "ການຝັງຕົວຂອງເກມບໍ່ສາມາດໃຊ້ໄດ້ເມື່ອເກມເລີ່ມຕົ້ນແບບຫຍໍ້ໜ້າຕ່າງ (minimized)."

msgid ""
"Consider overriding the window mode project setting with the editor feature "
"tag to Windowed to use game embedding while leaving the exported project "
"intact."
msgstr ""
"ພິຈາລະນາການໃຊ້ຄ່າ override ໃນ window mode ໃຫ້ເປັນ Windowed ໂດຍໃຊ້ feature tag ຂອງ "
"editor ເພື່ອໃຊ້ການຝັງຕົວຂອງເກມ ໃນຂະນະທີ່ໂຄງການທີ່ສົ່ງອອກໄປຍັງຄືເກົ່າ."

msgid "Game embedding not available when the game starts maximized."
msgstr "ການຝັງຕົວຂອງເກມບໍ່ສາມາດໃຊ້ໄດ້ເມື່ອເກມເລີ່ມຕົ້ນແບບຂະຫຍາຍເຕັມຈໍ (maximized)."

msgid "Game embedding not available when the game starts in fullscreen."
msgstr "ການຝັງຕົວຂອງເກມບໍ່ສາມາດໃຊ້ໄດ້ເມື່ອເກມເລີ່ມຕົ້ນແບບເຕັມຈໍ (fullscreen)."

msgid "Game embedding not available in single window mode."
msgstr "ການຝັງຕົວຂອງເກມບໍ່ສາມາດໃຊ້ໄດ້ໃນໂໝດໜ້າຕ່າງດຽວ."

msgid "Game embedding not available when the game starts in headless mode."
msgstr "ການຝັງຕົວຂອງເກມບໍ່ສາມາດໃຊ້ໄດ້ເມື່ອເກມເລີ່ມຕົ້ນໃນໂໝດ headless."

msgid "HDR"
msgstr "HDR"

msgid ""
"Window size: %s\n"
"Mode: %s\n"
"Maximum linear value: %.2f%s"
msgstr ""
"ຂະໜາດໜ້າຕ່າງ: %s\n"
"ໂໝດ: %s\n"
"ຄ່າ linear ສູງສຸດ: %.2f%s"

msgid "SDR"
msgstr "SDR"

msgid ""
"\n"
"Reference luminance: %.0f nits\n"
"Maximum luminance: %.0f nits"
msgstr ""
"\n"
"ຄວາມສະຫວ່າງອ້າງອີງ: %.0f nits\n"
"ຄວາມສະຫວ່າງສູງສຸດ: %.0f nits"

msgid "Unmute game audio."
msgstr "ເປີດສຽງເກມ."

msgid "Mute game audio."
msgstr "ປິດສຽງເກມ."

msgid "Request HDR Output"
msgstr "ຮ້ອງຂໍການສະແດງຜົນ HDR"

msgid "Window does not support HDR output."
msgstr "ໜ້າຕ່າງບໍ່ຮອງຮັບການສະແດງຜົນ HDR."

msgid ""
"Move the game window to a screen\n"
"that is operating in HDR mode."
msgstr ""
"ຍ້າຍໜ້າຕ່າງເກມໄປຍັງຈໍພາບ\n"
"ທີ່ກຳລັງເຮັດວຽກໃນໂໝດ HDR."

msgid "Display server does not support HDR output."
msgstr "Display server ບໍ່ຮອງຮັບການສະແດງຜົນ HDR."

msgid "Renderer does not support HDR output."
msgstr "Renderer ບໍ່ຮອງຮັບການສະແດງຜົນ HDR."

msgid ""
"Change the display/display_server/driver\n"
"advanced project setting to a driver\n"
"that supports HDR output."
msgstr ""
"ປ່ຽນການຕັ້ງຄ່າ display/display_server/driver\n"
"ໃນໂໝດຂັ້ນສູງໃຫ້ເປັນໄດຣເວີ\n"
"ທີ່ຮອງຮັບການສະແດງຜົນ HDR."

msgid ""
"Change the rendering/renderer/rendering_method\n"
"project setting to a renderer that supports HDR output and\n"
"the rendering/rendering_device/driver advanced project\n"
"setting to a driver that supports HDR output."
msgstr ""
"ປ່ຽນການຕັ້ງຄ່າ rendering/renderer/rendering_method\n"
"ໃຫ້ເປັນ renderer ທີ່ຮອງຮັບ HDR ແລະ ປ່ຽນການຕັ້ງຄ່າຂັ້ນສູງ\n"
"rendering/rendering_device/driver ໃຫ້ເປັນໄດຣເວີ\n"
"ທີ່ຮອງຮັບການສະແດງຜົນ HDR."

msgid "%s+Alt+RMB: Show list of all nodes at position clicked."
msgstr "%s+Alt+ຄລິກຂວາ: ສະແດງລາຍການໂນດທັງໝົດໃນຕຳແໜ່ງທີ່ຄລິກ."

msgid "Suspend"
msgstr "ລະງັບຊົ່ວຄາວ"

msgid ""
"Force pause at SceneTree level. Stops all processing, but you can still "
"interact with the project."
msgstr ""
"ບັງຄັບໃຫ້ຢຸດຊົ່ວຄາວໃນລະດັບ SceneTree. ຢຸດການປະມວນຜົນທັງໝົດ, ແຕ່ທ່ານຍັງສາມາດໂຕ້ຕອບກັບໂຄງການໄດ້."

msgid "Change the game speed."
msgstr "ປ່ຽນຄວາມໄວຂອງເກມ."

msgid "Speed State"
msgstr "ສະຖານະຄວາມໄວ"

msgid "Reset the game speed."
msgstr "ຕັ້ງຄ່າຄວາມໄວເກມຄືນໃໝ່."

msgid "Reset Speed"
msgstr "ຣີເຊັດຄວາມໄວ"

msgid "Input"
msgstr "ອິນພຸດ"

msgid "Allow game input."
msgstr "ອະນຸຍາດໃຫ້ເກມຮັບອິນພຸດ."

msgid ""
"Disable game input and allow to select Node2Ds, Controls, and manipulate the "
"2D camera."
msgstr "ປິດອິນພຸດຂອງເກມ ແລະ ອະນຸຍາດໃຫ້ເລືອກ Node2Ds, Controls, ແລະ ຄວບຄຸມກ້ອງ 2D."

msgid ""
"Disable game input and allow to select Node3Ds and manipulate the 3D camera."
msgstr "ປິດອິນພຸດຂອງເກມ ແລະ ອະນຸຍາດໃຫ້ເລືອກ Node3Ds ແລະ ຄວບຄຸມກ້ອງ 3D."

msgid "Show list of selectable nodes at position clicked."
msgstr "ສະແດງລາຍການໂນດທີ່ເລືອກໄດ້ໃນຕຳແໜ່ງທີ່ຄລິກ."

msgid "Toggle Selection Visibility"
msgstr "ເປີດ/ປິດ ການເບິ່ງເຫັນການເລືອກ"

msgid "Selection Options"
msgstr "ຕົວເລືອກການເລືອກ"

msgid "Don't Select Locked Nodes"
msgstr "ບໍ່ເລືອກໂນດທີ່ລັອກໄວ້"

msgid "Select Group Over Children"
msgstr "ເລືອກກຸ່ມແທນໂນດລູກ"

msgid "Override the in-game camera."
msgstr "ຄວບຄຸມກ້ອງໃນເກມດ້ວຍຕົນເອງ."

msgid "Camera Override Options"
msgstr "ຕົວເລືອກການ Override ກ້ອງ"

msgid "Reset 2D Camera"
msgstr "ຣີເຊັດກ້ອງ 2D"

msgid "Reset 3D Camera"
msgstr "ຣີເຊັດກ້ອງ 3D"

msgid "Manipulate In-Game"
msgstr "ຈັດການໃນເກມ"

msgid "Manipulate From Editors"
msgstr "ຈັດການຈາກ Editor"

msgid "Game Window Options"
msgstr "ຕົວເລືອກໜ້າຕ່າງເກມ"

msgid "Embed Game on Next Play"
msgstr "ຝັງເກມໃນການຫຼິ້ນຄັ້ງຖັດໄປ"

msgid "Make Game Workspace Floating on Next Play"
msgstr "ເຮັດໃຫ້ພື້ນທີ່ເຮັດວຽກເກມເປັນແບບລອຍໃນການຫຼິ້ນຄັ້ງຖັດໄປ"

msgid "Embedded Window Sizing"
msgstr "ການກຳນົດຂະໜາດໜ້າຕ່າງທີ່ຝັງ"

msgid "Fixed Size"
msgstr "ຂະໜາດຄົງທີ່"

msgid ""
"Embedded game size is based on project settings.\n"
"The 'Keep Aspect' mode is used when the Game Workspace is smaller than the "
"desired size."
