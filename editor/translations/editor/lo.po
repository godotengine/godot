msgid "Paste as Unique"
msgstr "ວາງເປັນແບບເອກະລັກ"

msgid "Convert to %s"
msgstr "ແປງເປັນ %s"

msgid "Select resources to make unique:"
msgstr "ເລືອກ resources ທີ່ຈະເຮັດໃຫ້ເປັນເອກະລັກ:"

msgid "Duplicate resources"
msgstr "ສຳເນົາ resources"

msgid "New"
msgstr "ໃໝ່"

msgid "Number of Linked Resources."
msgstr "ຈຳນວນ Resource ທີ່ເຊື່ອມໂຍງ."

msgid "Assign Resource"
msgstr "ກຳນົດ Resource"

msgid "Quick Load"
msgstr "ໂຫຼດດ່ວນ"

msgid "New Shader..."
msgstr "Shader ໃໝ່..."

msgid "Size: %s"
msgstr "ຂະໜາດ: %s"

msgid "Invalid file or broken link."
msgstr "ໄຟລ໌ບໍ່ຖືກຕ້ອງ ຫຼື ລິ້ງເສຍ."

msgid "Type: %s"
msgstr "ປະເພດ: %s"

msgid "Dimensions: %d × %d"
msgstr "ຂະໜາດມິຕິ: %d × %d"

msgid "Length: %0dm %0ds"
msgstr "ຄວາມຍາວ: %0d ນາທີ %0d ວິນາທີ"

msgid "Length: %0.1fs"
msgstr "ຄວາມຍາວ: %0.1f ວິນາທີ"

msgid "Length: %0.3fs"
msgstr "ຄວາມຍາວ: %0.3f ວິນາທີ"

msgid "Advanced settings are always shown when searching."
msgstr "ການຕັ້ງຄ່າຂັ້ນສູງຈະສະແດງສະເໝີເມື່ອມີການຄົ້ນຫາ."

msgid "Event Configured"
msgstr "ຕັ້ງຄ່າເຫດການ (Event) ແລ້ວ"

msgid "Configure"
msgstr "ຕັ້ງຄ່າ"

msgid "Set %s on %d nodes"
msgstr "ຕັ້ງຄ່າ %s ໃນ %d ໂນດ"

msgid "%s (%d Selected)"
msgstr "%s (ເລືອກໄວ້ %d)"

msgid "Select Property"
msgstr "ເລືອກຄຸນສົມບັດ"

msgid "Select Virtual Method"
msgstr "ເລືອກ Virtual Method"

msgid "Select Method"
msgstr "ເລືອກ Method"

msgid "The assigned tool button callback can't be used with multiple nodes."
msgstr "ຄໍແບັກ (Callback) ຂອງປຸ່ມເຄື່ອງມືທີ່ກຳນົດໄວ້ ບໍ່ສາມາດໃຊ້ກັບຫຼາຍໂນດໄດ້."

msgid ""
"Name: %s\n"
"Path: %s\n"
"Main Script: %s\n"
"\n"
"%s"
msgstr ""
"ຊື່: %s\n"
"ເສັ້ນທາງ: %s\n"
"ສະຄຣິບຫຼັກ: %s\n"
"\n"
"%s"

msgid "Edit Plugin"
msgstr "ແກ້ໄຂປລັກອິນ"

msgid ""
"Recovery mode is enabled. Enabled plugins will not run while this mode is "
"active."
msgstr "ເປີດໃຊ້ໂໝດກູ້ຄືນ. ປລັກອິນທີ່ເປີດໄວ້ຈະບໍ່ເຮັດວຽກໃນຂະນະທີ່ຢູ່ໃນໂໝດນີ້."

msgid "Installed Plugins:"
msgstr "ປລັກອິນທີ່ຕິດຕັ້ງແລ້ວ:"

msgid "Create New Plugin"
msgstr "ສ້າງປລັກອິນໃໝ່"

msgid "Enabled"
msgstr "ເປີດໃຊ້ງານ"

msgid "Version"
msgstr "ເວີຊັນ"

msgid "Plugin name cannot be blank."
msgstr "ຊື່ປລັກອິນບໍ່ສາມາດວ່າງເປົ່າໄດ້."

msgid "Subfolder name is not a valid folder name."
msgstr "ຊື່ໂຟນເດີຍ່ອຍບໍ່ຖືກຕ້ອງ."

msgid "Subfolder cannot be one which already exists."
msgstr "ໂຟນເດີຍ່ອຍຕ້ອງບໍ່ແມ່ນໂຟນເດີທີ່ມີຢູ່ແລ້ວ."

msgid "Script extension must match chosen language extension (.%s)."
msgstr "ນາມສະກຸນສະຄຣິບຕ້ອງກົງກັບພາສາທີ່ເລືອກ (.%s)."

msgid ""
"Consider enabling GDScript warnings for this plugin by adding an entry for it "
"to the project setting Debug > GDScript > Warnings > Directory Rules."
msgstr "ພິຈາລະນາເປີດການແຈ້ງເຕືອນ GDScript ສຳລັບປລັກອິນນີ້."

msgid "Edit a Plugin"
msgstr "ແກ້ໄຂປລັກອິນ"

msgid "Create a Plugin"
msgstr "ສ້າງປລັກອິນ"

msgid "Update"
msgstr "ອັບເດດ"

msgid "Plugin Name:"
msgstr "ຊື່ປລັກອິນ:"

msgid "Required. This name will be displayed in the list of plugins."
msgstr "ຈຳເປັນ. ຊື່ນີ້ຈະສະແດງໃນລາຍການປລັກອິນ."

msgid "Subfolder:"
msgstr "ໂຟນເດີຍ່ອຍ:"

msgid ""
"Optional. The folder name should generally use `snake_case` naming (avoid "
"spaces and special characters).\n"
"If left empty, the folder will be named after the plugin name converted to "
"`snake_case`."
msgstr "ທາງເລືອກ. ຊື່ໂຟນເດີຄວນໃຊ້ຮູບແບບ `snake_case`."

msgid ""
"Optional. This description should be kept relatively short (up to 5 lines).\n"
"It will display when hovering the plugin in the list of plugins."
msgstr "ທາງເລືອກ. ຄຳອະທິບາຍຄວນສັ້ນ (ບໍ່ເກີນ 5 ແຖວ)."

msgid "Author:"
msgstr "ຜູ້ຂຽນ:"

msgid "Optional. The author's username, full name, or organization name."
msgstr "ທາງເລືອກ. ຊື່ຜູ້ໃຊ້, ຊື່ແທ້ ຫຼື ຊື່ອົງກອນຂອງຜູ້ຂຽນ."

msgid ""
"Optional. A human-readable version identifier used for informational purposes "
"only."
msgstr "ທາງເລືອກ. ເລກເວີຊັນສຳລັບໃຫ້ຂໍ້ມູນເທົ່ານັ້ນ."

msgid "Language:"
msgstr "ພາສາ:"

msgid ""
"Required. The scripting language to use for the script.\n"
"Note that a plugin may use several languages at once by adding more scripts "
"to the plugin."
msgstr "ຈຳເປັນ. ພາສາທີ່ໃຊ້ຂຽນສະຄຣິບ."

msgid "Script Name:"
msgstr "ຊື່ສະຄຣິບ:"

msgid ""
"Optional. The name of the script file. If left empty, will default to the "
"subfolder name."
msgstr "ທາງເລືອກ. ຊື່ໄຟລ໌ສະຄຣິບ."

msgid "Plugin name is valid."
msgstr "ຊື່ປລັກອິນໃຊ້ງານໄດ້."

msgid "Script extension is valid."
msgstr "ນາມສະກຸນສະຄຣິບຖືກຕ້ອງ."

msgid "Subfolder name is valid."
msgstr "ຊື່ໂຟນເດີຍ່ອຍຖືກຕ້ອງ."

msgid "Failed to check for updates. Error: %d."
msgstr "ກວດສອບການອັບເດດບໍ່ສຳເລັດ. ຂໍ້ຜິດພາດ: %d."

msgid "Failed to check for updates. Response code: %d."
msgstr "ກວດສອບການອັບເດດບໍ່ສຳເລັດ. ລະຫັດຕອບຮັບ: %d."

msgid "Failed to parse version JSON."
msgstr "ແປງຂໍ້ມູນ JSON ຂອງເວີຊັນບໍ່ສຳເລັດ."

msgid "Received JSON data is not a valid version array."
msgstr "ຂໍ້ມູນ JSON ທີ່ໄດ້ຮັບບໍ່ແມ່ນ Array ຂອງເວີຊັນທີ່ຖືກຕ້ອງ."

msgid "Update available: %s."
msgstr "ມີເວີຊັນໃໝ່ໃຫ້ອັບເດດ: %s."

msgid "Offline mode, update checks disabled."
msgstr "ຢູ່ໃນໂໝດອອຟລາຍ, ປິດການກວດສອບອັບເດດ."

msgid "Update checks disabled."
msgstr "ປິດການກວດສອບອັບເດດແລ້ວ."

msgid "An error has occurred. Click to try again."
msgstr "ເກີດຂໍ້ຜິດພາດ. ຄລິກເພື່ອລອງໃໝ່."

msgid "Click to open download page."
msgstr "ຄລິກເພື່ອເປີດໜ້າດາວໂຫຼດ."

msgid "It would be a good idea to name your project."
msgstr "ທ່ານຄວນຕັ້ງຊື່ໃຫ້ກັບໂຄງການຂອງທ່ານ."

msgid "Invalid \".zip\" project file; it is not in ZIP format."
msgstr "ໄຟລ໌ \".zip\" ບໍ່ຖືກຕ້ອງ; ບໍ່ແມ່ນຮູບແບບ ZIP."

msgid ""
"Invalid \".zip\" project file; it doesn't contain a \"project.godot\" file."
msgstr "ໄຟລ໌ \".zip\" ບໍ່ຖືກຕ້ອງ; ບໍ່ມີໄຟລ໌ \"project.godot\" ຢູ່ຂ້າງໃນ."

msgid "Valid project found at path."
msgstr "ພົບໂຄງການທີ່ຖືກຕ້ອງໃນເສັ້ນທາງນີ້."

msgid ""
"Please choose a \"project.godot\", a directory with one, or a \".zip\" file."
msgstr "ກະລຸນາເລືອກໄຟລ໌ \"project.godot\", ໂຟນເດີທີ່ມີໄຟລ໌ດັ່ງກ່າວ, ຫຼື ໄຟລ໌ \".zip\"."

msgid "The path specified is invalid."
msgstr "ເສັ້ນທາງທີ່ລະບຸບໍ່ຖືກຕ້ອງ."

msgid ""
"The directory name specified contains invalid characters or trailing "
"whitespace."
msgstr "ຊື່ໂຟນເດີມີຕົວອັກສອນທີ່ບໍ່ຖືກຕ້ອງ ຫຼື ມີຊ່ອງວ່າງທາງທ້າຍ."

msgid ""
"Creating a project at the engine's working directory or executable directory "
"is not allowed, as it would prevent the project manager from starting."
msgstr "ບໍ່ອະນຸຍາດໃຫ້ສ້າງໂຄງການໃນໂຟນເດີດຽວກັນກັບຕົວໂປຣແກຣມ."

msgid ""
"You cannot save a project at the selected path. Please create a subfolder or "
"choose a new path."
msgstr "ບໍ່ສາມາດບັນທຶກໂຄງການໃນເສັ້ນທາງນີ້ໄດ້. ກະລຸນາສ້າງໂຟນເດີຍ່ອຍ ຫຼື ເລືອກເສັ້ນທາງໃໝ່."

msgid "The parent directory of the path specified doesn't exist."
msgstr "ໂຟນເດີຫຼັກຂອງເສັ້ນທາງທີ່ລະບຸບໍ່ມີຢູ່ຈິງ."

msgid "The project folder already exists and is empty."
msgstr "ໂຟນເດີໂຄງການມີຢູ່ແລ້ວ ແລະ ເປັນໂຟນເດີວ່າງ."

msgid "The project folder will be automatically created."
msgstr "ໂຟນເດີໂຄງການຈະຖືກສ້າງຂຶ້ນໂດຍອັດຕະໂນມັດ."

msgid "The path specified doesn't exist."
msgstr "ເສັ້ນທາງທີ່ລະບຸບໍ່ມີຢູ່ຈິງ."

msgid "The project folder exists and is empty."
msgstr "ໂຟນເດີໂຄງການມີຢູ່ແລ້ວ ແລະ ວ່າງເປົ່າ."

msgid ""
"The selected path is not empty. Choosing an empty folder is highly "
"recommended."
msgstr "ເສັ້ນທາງທີ່ເລືອກບໍ່ແມ່ນໂຟນເດີວ່າງ. ແນະນຳໃຫ້ເລືອກໂຟນເດີວ່າງ."

msgid "Cannot duplicate a project into itself."
msgstr "ບໍ່ສາມາດສຳເນົາໂຄງການທັບຊ້ອນໃສ່ຕົວມັນເອງໄດ້."

msgid "New Game Project"
msgstr "ໂຄງການເກມໃໝ່"

msgid "Supports desktop platforms only."
msgstr "ຮອງຮັບສະເພາະແພລັດຟອມເດັສທັອບ (Desktop) ເທົ່ານັ້ນ."

msgid "Advanced 3D graphics available."
msgstr "ຮອງຮັບກຣາຟິກ 3D ຂັ້ນສູງ."

msgid "Can scale to large complex scenes."
msgstr "ສາມາດຮອງຮັບສາກທີ່ໃຫຍ່ ແລະ ຊັບຊ້ອນໄດ້."

msgid "Uses RenderingDevice backend."
msgstr "ໃຊ້ລະບົບ RenderingDevice."

msgid "Slower rendering of simple scenes."
msgstr "ປະມວນຜົນສາກທີ່ບໍ່ຊັບຊ້ອນໄດ້ຊ້າກວ່າ."

msgid "Supports desktop + mobile platforms."
msgstr "ຮອງຮັບທັງເດັສທັອບ ແລະ ມືຖື."

msgid "Less advanced 3D graphics."
msgstr "ກຣາຟິກ 3D ຂັ້ນສູງໜ້ອຍກວ່າ."

msgid "Less scalable for complex scenes."
msgstr "ຮອງຮັບສາກທີ່ຊັບຊ້ອນໄດ້ໜ້ອຍກວ່າ."

msgid "Fast rendering of simple scenes."
msgstr "ປະມວນຜົນສາກທີ່ບໍ່ຊັບຊ້ອນໄດ້ໄວ."

msgid "Supports desktop, mobile + web platforms."
msgstr "ຮອງຮັບເດັສທັອບ, ມືຖື ແລະ ເວັບ."

msgid "Least advanced 3D graphics."
msgstr "ກຣາຟິກ 3D ລະດັບພື້ນຖານ."

msgid "Intended for low-end/older devices."
msgstr "ອອກແບບມາສຳລັບອຸປະກອນສະເປັກຕ່ຳ ຫຼື ລຸ້ນເກົ່າ."

msgid "Uses OpenGL 3 backend (OpenGL 3.3/ES 3.0/WebGL2)."
msgstr "ໃຊ້ OpenGL 3 (OpenGL 3.3/ES 3.0/WebGL2)."

msgid "Fastest rendering of simple scenes."
msgstr "ປະມວນຜົນສາກທົ່ວໄປໄດ້ໄວທີ່ສຸດ."

msgid "Warning: This folder is not empty"
msgstr "ຄຳເຕືອນ: ໂຟນເດີນີ້ບໍ່ແມ່ນໂຟນເດີວ່າງ"

msgid ""
"You are about to create a Godot project in a non-empty folder.\n"
"The entire contents of this folder will be imported as project resources!\n"
"\n"
"Are you sure you wish to continue?"
msgstr ""
"ທ່ານກຳລັງຈະສ້າງໂຄງການ Godot ໃນໂຟນເດີທີ່ມີໄຟລ໌ຢູ່ແລ້ວ.\n"
"ໄຟລ໌ທັງໝົດໃນນີ້ຈະຖືກນຳເຂົ້າເປັນ resource ຂອງໂຄງການ!\n"
"\n"
"ທ່ານແນ່ໃຈຫຼືບໍ່ວ່າຈະສືບຕໍ່?"

msgid "Couldn't create project directory, check permissions."
msgstr "ບໍ່ສາມາດສ້າງໂຟນເດີໂຄງການໄດ້, ກະລຸນາກວດສອບສິດການເຂົ້າເຖິງ (Permissions)."

msgid "Couldn't create project.godot in project path."
msgstr "ບໍ່ສາມາດສ້າງໄຟລ໌ project.godot ໃນເສັ້ນທາງທີ່ລະບຸໄດ້."

msgid "Couldn't create icon.svg in project path."
msgstr "ບໍ່ສາມາດສ້າງໄຟລ໌ icon.svg ໃນເສັ້ນທາງທີ່ລະບຸໄດ້."

msgid "Error opening package file, not in ZIP format."
msgstr "ເກີດຂໍ້ຜິດພາດໃນການເປີດໄຟລ໌ແພັກເກດ, ບໍ່ແມ່ນຮູບແບບ ZIP."

msgid "The following files failed extraction from package:"
msgstr "ບໍ່ສາມາດແຍກໄຟລ໌ຕໍ່ໄປນີ້ອອກຈາກແພັກເກດໄດ້:"

msgid "Couldn't duplicate project (error %d)."
msgstr "ບໍ່ສາມາດສຳເນົາໂຄງການໄດ້ (ຂໍ້ຜິດພາດ %d)."

msgid ""
"Couldn't load project at '%s' (error %d). It may be missing or corrupted."
msgstr "ບໍ່ສາມາດໂຫຼດໂຄງການທີ່ '%s' ໄດ້ (ຂໍ້ຜິດພາດ %d). ໄຟລ໌ອາດຈະຫາຍ ຫຼື ເສຍຫາຍ."

msgid "Couldn't save project at '%s' (error %d)."
msgstr "ບໍ່ສາມາດບັນທຶກໂຄງການທີ່ '%s' ໄດ້ (ຂໍ້ຜິດພາດ %d)."

