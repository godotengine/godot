msgstr "ເກັບໄຟລ໌ໄວ້ (ສົ່ງອອກຕາມສະພາບເດີມ)"

msgid "Skip File (not exported)"
msgstr "ຂ້າມໄຟລ໌ (ບໍ່ສົ່ງອອກ)"

msgid "%d Files"
msgstr "%d ໄຟລ໌"

msgid "Default"
msgstr "ຄ່າເລີ່ມຕົ້ນ"

msgid "Set as Default for '%s'"
msgstr "ຕັ້ງເປັນຄ່າເລີ່ມຕົ້ນສຳລັບ '%s'"

msgid "Clear Default for '%s'"
msgstr "ລ້າງຄ່າເລີ່ມຕົ້ນສຳລັບ '%s'"

msgid ""
"You have pending changes that haven't been applied yet. Click Reimport to "
"apply changes made to the import options.\n"
"Selecting another resource in the FileSystem dock without clicking Reimport "
"first will discard changes made in the Import dock."
msgstr ""
"ທ່ານມີການປ່ຽນແປງທີ່ຍັງບໍ່ທັນໄດ້ນຳໃຊ້. ຄລິກ 'ນຳເຂົ້າໃໝ່' ເພື່ອຢືນຢັນການປ່ຽນແປງໃນຕົວເລືອກການນຳເຂົ້າ.\n"
"ການເລືອກຊັບພະຍາກອນອື່ນໃນແຖບລະບົບໄຟລ໌ໂດຍບໍ່ຄລິກ 'ນຳເຂົ້າໃໝ່' ກ່ອນ "
"ຈະເຮັດໃຫ້ການປ່ຽນແປງໃນແຖບນຳເຂົ້າຖືກຍົກເລີກ."

msgid "Import"
msgstr "ນຳເຂົ້າ"

msgid "Open Import Dock"
msgstr "ເປີດແຖບນຳເຂົ້າ"

msgid "Import As:"
msgstr "ນຳເຂົ້າເປັນ:"

msgid "Preset"
msgstr "ຄ່າທີ່ຕັ້ງໄວ້ກ່ອນ"

msgid "Advanced..."
msgstr "ຂັ້ນສູງ..."

msgid ""
"The imported resource is currently loaded. All instances will be replaced and "
"undo history will be cleared."
msgstr ""
"ຊັບພະຍາກອນທີ່ນຳເຂົ້າມາຖືກໂຫຼດຢູ່ໃນຂະນະນີ້. ອິນສະແຕນຊ໌ທັງໝົດຈະຖືກແທນທີ່ ແລະ "
"ປະຫວັດການຍົກເລີກຈະຖືກລ້າງອອກ."

msgid ""
"WARNING: Assets exist that use this resource. They may stop loading properly "
"after changing type."
msgstr "ຄຳເຕືອນ: ມີແອສເຊັດທີ່ໃຊ້ຊັບພະຍາກອນນີ້ຢູ່. ພວກມັນອາດຈະໂຫຼດບໍ່ຖືກຕ້ອງຫຼັງຈາກປ່ຽນປະເພດ."

msgid ""
"Select a resource file in the filesystem or in the inspector to adjust import "
"settings."
msgstr "ເລືອກໄຟລ໌ຊັບພະຍາກອນໃນລະບົບໄຟລ໌ ຫຼື ໃນອິນສະເປັກເຕີເພື່ອປັບແຕ່ງການຕັ້ງຄ່ານຳເຂົ້າ."

msgid ""
"The following resources will be duplicated and embedded within this resource/"
"object."
msgstr "ຊັບພະຍາກອນຕໍ່ໄປນີ້ຈະຖືກເຮັດສຳເນົາ ແລະ ຝັງໄວ້ໃນຊັບພະຍາກອນ/ອັອບເຈັກນີ້."

msgid "This object has no resources to duplicate."
msgstr "ອັອບເຈັກນີ້ບໍ່ມີຊັບພະຍາກອນທີ່ຈະເຮັດສຳເນົາ."

msgid "Make Sub-Resources Unique"
msgstr "ເຮັດໃຫ້ຊັບພະຍາກອນຍ່ອຍເປັນເອກະລັກ"

msgid "Failed to load resource."
msgstr "ໂຫຼດຊັບພະຍາກອນຫຼົ້ມເຫຼວ."

msgid "(Current)"
msgstr "(ປັດຈຸບັນ)"

msgid "Expand Non-Default"
msgstr "ຂະຫຍາຍສ່ວນທີ່ບໍ່ແມ່ນຄ່າເລີ່ມຕົ້ນ"

msgid "Property Name Style"
msgstr "ຮູບແບບຊື່ຄຸນສົມບັດ"

msgid "Raw (e.g. \"%s\")"
msgstr "ດິບ (ເຊັ່ນ: \"%s\")"

msgid "Capitalized (e.g. \"%s\")"
msgstr "ຕົວພິມໃຫຍ່ (ເຊັ່ນ: \"%s\")"

msgid "Localized (e.g. \"Z Index\")"
msgstr "ຕາມພາສາທ້ອງຖິ່ນ (ເຊັ່ນ: \"Z Index\")"

msgid "Localization not available for current language."
msgstr "ບໍ່ມີການແປພາສາທ້ອງຖິ່ນສຳລັບພາສາປັດຈຸບັນ."

msgid "Copy Properties"
msgstr "ສຳເນົາຄຸນສົມບັດ"

msgid "Paste Properties"
msgstr "ວາງຄຸນສົມບັດ"

msgid "Inspector"
msgstr "ອິນສະເປັກເຕີ"

msgid "Open Inspector Dock"
msgstr "ເປີດແຖບອິນສະເປັກເຕີ"

msgid "Create a new resource in memory and edit it."
msgstr "ສ້າງຊັບພະຍາກອນໃໝ່ໃນໜ່ວຍຄວາມຈຳ ແລະ ແກ້ໄຂມັນ."

msgid "Load an existing resource from disk and edit it."
msgstr "ໂຫຼດຊັບພະຍາກອນທີ່ມີຢູ່ຈາກດິສກ໌ ແລະ ແກ້ໄຂມັນ."

msgid "Save the currently edited resource."
msgstr "ບັນທຶກຊັບພະຍາກອນທີ່ກຳລັງແກ້ໄຂຢູ່."

msgid "Save As..."
msgstr "ບັນທຶກເປັນ..."

msgid "Extra resource options."
msgstr "ຕົວເລືອກຊັບພະຍາກອນເພີ່ມເຕີມ."

msgid "Edit Resource from Clipboard"
msgstr "ແກ້ໄຂຊັບພະຍາກອນຈາກຄລິບບອດ"

msgid "Copy Resource"
msgstr "ສຳເນົາຊັບພະຍາກອນ"

msgid "Make Resource Built-In"
msgstr "ເຮັດໃຫ້ຊັບພະຍາກອນເປັນແບບຝັງໃນ (Built-In)"

msgid "Go to previous edited object in history."
msgstr "ໄປທີ່ອັອບເຈັກທີ່ແກ້ໄຂກ່ອນໜ້າໃນປະຫວັດ."

msgid "Go to next edited object in history."
msgstr "ໄປທີ່ອັອບເຈັກທີ່ແກ້ໄຂຖັດໄປໃນປະຫວັດ."

msgid "History of recently edited objects."
msgstr "ປະຫວັດຂອງອັອບເຈັກທີ່ຫາກໍ່ແກ້ໄຂ."

msgid "Open documentation for this object."
msgstr "ເປີດເອກະສານຄວາມຊ່ວຍເຫຼືອສຳລັບອັອບເຈັກນີ້."

msgid "Open Documentation"
msgstr "ເປີດເອກະສານຄວາມຊ່ວຍເຫຼືອ"

msgid "Filter Properties"
msgstr "ກັ່ນຕອງຄຸນສົມບັດ"

msgid "Manage object properties."
msgstr "ຈັດການຄຸນສົມບັດຂອງອັອບເຈັກ."

msgid "Information"
msgstr "ຂໍ້ມູນ"

msgid "No parent to instantiate a child at."
msgstr "ບໍ່ມີໂນດຫຼັກທີ່ຈະສ້າງອິນສະແຕນຊ໌ລູກ."

msgid "No parent to instantiate the scenes at."
msgstr "ບໍ່ມີໂນດຫຼັກທີ່ຈະສ້າງອິນສະແຕນຊ໌ສາກ."

msgid "Error loading scene from %s"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການໂຫຼດສາກຈາກ %s"

msgid "Error instantiating scene from %s"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການສ້າງອິນສະແຕນຊ໌ສາກຈາກ %s"

msgid ""
"Cannot instantiate the scene '%s' because the current scene exists within one "
"of its nodes."
msgstr "ບໍ່ສາມາດສ້າງອິນສະແຕນຊ໌ສາກ '%s' ໄດ້ ເພາະວ່າສາກປັດຈຸບັນມີຢູ່ໃນໜຶ່ງໃນໂນດຂອງມັນ."

msgid "Instantiate Scene"
msgid_plural "Instantiate Scenes"
msgstr[0] "ສ້າງອິນສະແຕນຊ໌ສາກ"

msgid "Error loading audio stream from %s"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການໂຫຼດສຽງຈາກ %s"

msgid "Create AudioStreamPlayer"
msgid_plural "Create AudioStreamPlayers"
msgstr[0] "ສ້າງເຄື່ອງຫຼິ້ນສຽງ (AudioStreamPlayer)"

msgid "Replace with Branch Scene"
msgstr "ແທນທີ່ດ້ວຍສາກກິ່ງ (Branch Scene)"

msgid "This operation can't be done on the tree root."
msgstr "ການດຳເນີນການນີ້ບໍ່ສາມາດເຮັດໄດ້ຢູ່ສ່ວນຮາກຂອງຕົ້ນໄມ້."

msgid "Detach Script"
msgstr "ຖອນສະຄຣິບອອກ"

msgid "Move Node in Parent"
msgstr "ຍ້າຍໂນດໃນໂນດແມ່"

msgid "Move Nodes in Parent"
msgstr "ຍ້າຍຫຼາຍໂນດໃນໂນດແມ່"

msgid "Duplicate Node(s)"
msgstr "ສຳເນົາໂນດ"

msgid "Can't reparent nodes in inherited scenes, order of nodes can't change."
msgstr "ບໍ່ສາມາດປ່ຽນໂນດແມ່ໃນສາກທີ່ສືບທອດມາໄດ້, ລຳດັບຂອງໂນດບໍ່ສາມາດປ່ຽນແປງໄດ້."

msgid "Node must belong to the edited scene to become root."
msgstr "ໂນດຕ້ອງເປັນຂອງສາກທີ່ກຳລັງແກ້ໄຂຢູ່ ເພື່ອທີ່ຈະກາຍເປັນສ່ວນຮາກໄດ້."

msgid "Instantiated scenes can't become root"
msgstr "ສາກທີ່ຖືກສ້າງເປັນອິນສະແຕນຊ໌ບໍ່ສາມາດກາຍເປັນສ່ວນຮາກໄດ້"

msgid "Make node as Root"
msgstr "ຕັ້ງໂນດໃຫ້ເປັນສ່ວນຮາກ"

msgid "Delete %d nodes and any children?"
msgstr "ລຶບ %d ໂນດ ແລະ ໂນດລູກທັງໝົດບໍ?"

msgid "Delete %d nodes?"
msgstr "ລຶບ %d ໂນດບໍ?"

msgid "Delete the root node \"%s\"?"
msgstr "ລຶບໂນດຮາກ \"%s\" ບໍ?"

msgid "Delete node \"%s\" and its children?"
msgstr "ລຶບໂນດ \"%s\" ແລະ ໂນດລູກຂອງມັນບໍ?"

msgid "Delete node \"%s\"?"
msgstr "ລຶບໂນດ \"%s\" ບໍ?"

msgid "Some nodes are referenced by animation tracks."
msgstr "ບາງໂນດຖືກອ້າງອີງໂດຍແທຣັກແອນິເມຊັນ."

msgid "Saving the branch as a scene requires having a scene open in the editor."
msgstr "ການບັນທຶກກິ່ງເປັນສາກໃໝ່ ຕ້ອງມີການເປີດສາກໃດໜຶ່ງໄວ້ໃນຕົວແກ້ໄຂ."

msgid ""
"Can't save the root node branch as an instantiated scene.\n"
"To create an editable copy of the current scene, duplicate it using the "
"FileSystem dock context menu\n"
"or create an inherited scene using Scene > New Inherited Scene... instead."
msgstr ""
"ບໍ່ສາມາດບັນທຶກກິ່ງຂອງໂນດຮາກເປັນສາກອິນສະແຕນຊ໌ໄດ້.\n"
"ເພື່ອສ້າງສຳເນົາຂອງສາກປັດຈຸບັນທີ່ແກ້ໄຂໄດ້, ໃຫ້ສຳເນົາໂດຍໃຊ້ເມນູຄລິກຂວາໃນ FileSystem\n"
"ຫຼື ສ້າງສາກສືບທອດໂດຍໃຊ້ Scene > New Inherited Scene... ແທນ."

msgid ""
"Can't save the branch of an already instantiated scene.\n"
"To create a variation of a scene, you can make an inherited scene based on "
"the instantiated scene using Scene > New Inherited Scene... instead."
msgstr ""
"ບໍ່ສາມາດບັນທຶກກິ່ງຂອງສາກທີ່ເປັນອິນສະແຕນຊ໌ຢູ່ແລ້ວໄດ້.\n"
"ເພື່ອສ້າງສາກທີ່ແຕກຕ່າງອອກໄປ, ທ່ານສາມາດສ້າງສາກສືບທອດຈາກສາກອິນສະແຕນຊ໌ນັ້ນ ໂດຍໃຊ້ Scene > New "
"Inherited Scene... ແທນ."

msgid ""
"Can't save a branch which is a child of an already instantiated scene.\n"
"To save this branch into its own scene, open the original scene, right click "
"on this branch, and select \"Save Branch as Scene\"."
msgstr ""
"ບໍ່ສາມາດບັນທຶກກິ່ງທີ່ເປັນລູກຂອງສາກອິນສະແຕນຊ໌ໄດ້.\n"
"ເພື່ອບັນທຶກກິ່ງນີ້ເປັນສາກຂອງມັນເອງ, ໃຫ້ເປີດສາກຕົ້ນສະບັບ, ຄລິກຂວາໃສ່ກິ່ງນີ້, ແລ້ວເລືອກ \"Save Branch "
"as Scene\"."

msgid ""
"Can't save a branch which is part of an inherited scene.\n"
"To save this branch into its own scene, open the original scene, right click "
"on this branch, and select \"Save Branch as Scene\"."
msgstr ""
"ບໍ່ສາມາດບັນທຶກກິ່ງທີ່ເປັນສ່ວນໜຶ່ງຂອງສາກສືບທອດໄດ້.\n"
"ເພື່ອບັນທຶກກິ່ງນີ້ເປັນສາກຂອງມັນເອງ, ໃຫ້ເປີດສາກຕົ້ນສະບັບ, ຄລິກຂວາໃສ່ກິ່ງນີ້, ແລ້ວເລືອກ \"Save Branch "
"as Scene\"."

msgid "Save New Scene As..."
msgstr "ບັນທຶກສາກໃໝ່ເປັນ..."

msgid ""
"Disabling \"Editable Children\" will cause all properties of this subscene's "
"descendant nodes to be reverted to their default."
msgstr ""
"ການປິດ \"Editable Children\" ຈະເຮັດໃຫ້ຄຸນສົມບັດທັງໝົດຂອງໂນດລູກຫຼານໃນສາກຍ່ອຍນີ້ "
"ຖືກກັບຄືນໄປເປັນຄ່າເລີ່ມຕົ້ນ."

msgid ""
"Enabling \"Load as Placeholder\" will disable \"Editable Children\" and cause "
"all properties of the node to be reverted to their default."
msgstr ""
"ການເປີດ \"Load as Placeholder\" ຈະປິດການໃຊ້ງານ \"Editable Children\" ແລະ "
"ເຮັດໃຫ້ຄຸນສົມບັດທັງໝົດຂອງໂນດຖືກກັບຄືນໄປເປັນຄ່າເລີ່ມຕົ້ນ."

msgid "Make Local"
msgstr "ເຮັດໃຫ້ເປັນໂລຄໍ (Local)"

msgid "Can't toggle unique name for nodes in subscene!"
msgstr "ບໍ່ສາມາດປ່ຽນສະຖານະຊື່ສະເພາະສຳລັບໂນດໃນສາກຍ່ອຍໄດ້!"

msgid "Enable Scene Unique Name(s)"
msgstr "ເປີດໃຊ້ຊື່ສະເພາະຂອງສາກ"

msgid "Unique names already used by another node in the scene:"
msgstr "ຊື່ສະເພາະຖືກໃຊ້ໂດຍໂນດອື່ນໃນສາກແລ້ວ:"

msgid "Disable Scene Unique Name(s)"
msgstr "ປິດການໃຊ້ຊື່ສະເພາະຂອງສາກ"

