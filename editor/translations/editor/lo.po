msgstr "ບໍ່ສາມາດຂຽນທັບສາກທີ່ຍັງເປີດຢູ່ໄດ້!"

msgid "Reset Position"
msgstr "ຕັ້ງຄ່າຕຳແໜ່ງໃໝ່"

msgid "Reset Scale"
msgstr "ຕັ້ງຄ່າຂະໜາດໃໝ່"

msgid "Reset Rotation"
msgstr "ຕັ້ງຄ່າການໝູນໃໝ່"

msgid ""
"Couldn't save new scene. Likely dependencies (instances) couldn't be "
"satisfied."
msgstr "ບໍ່ສາມາດບັນທຶກສາກໃໝ່ໄດ້. ອາດເປັນຍ້ອນບໍ່ພົບໄຟລ໌ທີ່ກ່ຽວຂ້ອງ (instances)."

msgid "Error saving scene."
msgstr "ເກີດຂໍ້ຜິດພາດໃນການບັນທຶກສາກ."

msgid "Error duplicating scene to save it."
msgstr "ເກີດຂໍ້ຜິດພາດໃນການສຳເນົາສາກເພື່ອບັນທຶກ."

msgid "Instantiate Script"
msgstr "ສ້າງອິນສະແຕນຊ໌ຂອງສະຄຣິບ"

msgid "<unknown>"
msgstr "<ບໍ່ຮູ້ຈັກ>"

msgid "Sub-Resources"
msgstr "ຊັບພະຍາກອນຍ່ອຍ"

msgid "Clear Inheritance"
msgstr "ລ້າງການສືບທອດ"

msgid "Editable Children"
msgstr "ລູກທີ່ສາມາດແກ້ໄຂໄດ້"

msgid "Load as Placeholder"
msgstr "ໂຫລດເປັນຕົວແທນ (Placeholder)"

msgid "Access as Unique Name"
msgstr "ເຂົ້າເຖິງດ້ວຍຊື່ສະເພາະ"

msgid "Open in Editor"
msgstr "ເປີດໃນຕົວແກ້ໄຂ (Editor)"

msgid "Auto Expand to Selected"
msgstr "ຂະຫຍາຍລາຍການທີ່ເລືອກໂດຍອັດຕະໂນມັດ"

msgid "Center Node on Reparent"
msgstr "ຈັດໂນດໃຫ້ຢູ່ເຄິ່ງກາງເມື່ອປ່ຽນໂນດແມ່"

msgid ""
"If enabled, Reparent to New Node will create the new node in the center of "
"the selected nodes, if possible."
msgstr "ຖ້າເປີດໃຊ້, ການປ່ຽນໄປຫາໂນດແມ່ໃໝ່ຈະສ້າງໂນດໃໝ່ໄວ້ເຄິ່ງກາງຂອງໂນດທີ່ເລືອກ (ຖ້າເປັນໄປໄດ້)."

msgid "Hide Filtered Out Parents"
msgstr "ເຊື່ອງໂນດແມ່ທີ່ຖືກກອງອອກ"

msgid "Show Accessibility Warnings"
msgstr "ສະແດງຄຳເຕືອນກ່ຽວກັບການເຂົ້າເຖິງ"

msgid "All Scene Sub-Resources"
msgstr "ຊັບພະຍາກອນຍ່ອຍທັງໝົດຂອງສາກ"

msgid ""
"Filter nodes by entering a part of their name, type (if prefixed with \"type:"
"\" or \"t:\")\n"
"or group (if prefixed with \"group:\" or \"g:\"). Filtering is case-"
"insensitive."
msgstr ""
"ກອງໂນດໂດຍການປ້ອນບາງສ່ວນຂອງຊື່, ປະເພດ (ຖ້ານຳໜ້າດ້ວຍ \"type:\" ຫຼື \"t:\")\n"
"ຫຼື ກຸ່ມ (ຖ້ານຳໜ້າດ້ວຍ \"group:\" ຫຼື \"g:\"). ການກອງບໍ່ແຍກຕົວອັກສອນໃຫຍ່-ນ້ອຍ."

msgid "Filter by Type"
msgstr "ກອງຕາມປະເພດ"

msgid ""
"Selects all Nodes of the given type.\n"
"Inserts \"type:\". You can also use the shorthand \"t:\"."
msgstr ""
"ເລືອກທຸກໂນດຕາມປະເພດທີ່ລະບຸ.\n"
"ຈະໃສ່ \"type:\". ທ່ານສາມາດໃຊ້ຕົວຫຍໍ້ \"t:\" ໄດ້ຄືກັນ."

msgid "Filter by Group"
msgstr "ກອງຕາມກຸ່ມ"

msgid ""
"Selects all Nodes belonging to the given group.\n"
"If empty, selects any Node belonging to any group.\n"
"Inserts \"group:\". You can also use the shorthand \"g:\"."
msgstr ""
"ເລືອກທຸກໂນດທີ່ຢູ່ໃນກຸ່ມທີ່ລະບຸ.\n"
"ຖ້າຫວ່າງໄວ້, ຈະເລືອກທຸກໂນດທີ່ຢູ່ໃນກຸ່ມໃດກໍໄດ້.\n"
"ຈະໃສ່ \"group:\". ທ່ານສາມາດໃຊ້ຕົວຫຍໍ້ \"g:\" ໄດ້ຄືກັນ."

msgid ""
"Cannot attach a script: there are no languages registered.\n"
"This is probably because this editor was built with all language modules "
"disabled."
msgstr ""
"ບໍ່ສາມາດໃສ່ສະຄຣິບໄດ້: ບໍ່ມີພາສາໃດຖືກລົງທະບຽນໄວ້.\n"
"ນີ້ອາດເປັນຍ້ອນຕົວແກ້ໄຂນີ້ຖືກສ້າງຂຶ້ນໂດຍປິດໂມດູນພາສາທັງໝົດ."

msgid "Can't paste root node into the same scene."
msgstr "ບໍ່ສາມາດວາງໂນດຮາກລົງໃນສາກດຽວກັນໄດ້."

msgid "Paste Node(s) as Sibling of %s"
msgstr "ວາງໂນດເປັນໂນດລະດັບດຽວກັນກັບ %s"

