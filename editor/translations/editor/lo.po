msgstr "Proxies ໃນລະດັບ Source"

msgid "Coords-level proxies"
msgstr "Proxies ໃນລະດັບ Coords"

msgid "Alternative-level proxies"
msgstr "Proxies ໃນລະດັບ Alternative"

msgid "Add a new tile proxy:"
msgstr "ເພີ່ມ tile proxy ໃໝ່:"

msgid "From Source"
msgstr "ຈາກ Source"

msgid "From Coords"
msgstr "ຈາກ Coords"

msgid "From Alternative"
msgstr "ຈາກ Alternative"

msgid "To Source"
msgstr "ໄປຫາ Source"

msgid "To Coords"
msgstr "ໄປຫາ Coords"

msgid "To Alternative"
msgstr "ໄປຫາ Alternative"

msgid "Global actions:"
msgstr "ຄຳສັ່ງທົ່ວໄປ:"

msgid "Clear Invalid"
msgstr "ລ້າງອັນທີ່ບໍ່ຖືກຕ້ອງ"

msgid "Atlas"
msgstr "ແອດລັສ (Atlas)"

msgid "Base Tile"
msgstr "Tile ພື້ນຖານ"

msgid "Alternative Tile"
msgstr "Tile ທາງເລືອກ"

msgid ""
"Selected tile:\n"
"Source: %d\n"
"Atlas coordinates: %s\n"
"Alternative: %d"
msgstr ""
"Tile ທີ່ເລືອກ:\n"
"Source: %d\n"
"ພິກັດ Atlas: %s\n"
"Alternative: %d"

msgid "Rendering"
msgstr "ການສະແດງຜົນ (Rendering)"

msgid "Texture Origin"
msgstr "ຈຸດກຳເນີດ Texture"

msgid "Modulate"
msgstr "ປັບສີ (Modulate)"

msgid "Z Index"
msgstr "Z Index"

msgid "Y Sort Origin"
msgstr "Y Sort Origin"

msgid "Occlusion Layer %d"
msgstr "Occlusion Layer %d"

msgid "Probability"
msgstr "ຄວາມເປັນໄປໄດ້"

msgid "Physics"
msgstr "ຟີຊິກ (Physics)"

msgid "Physics Layer %d"
msgstr "Physics Layer %d"

msgid "No physics layers"
msgstr "ບໍ່ມີ Physics Layer"

msgid ""
"Create and customize physics layers in the inspector of the TileSet resource."
msgstr "ສ້າງ ແລະ ປັບແຕ່ງ physics layers ໃນ inspector ຂອງ TileSet resource."

msgid "Navigation"
msgstr "ການນຳທາງ (Navigation)"

msgid "Navigation Layer %d"
msgstr "Navigation Layer %d"

msgid "No navigation layers"
msgstr "ບໍ່ມີ Navigation Layer"

msgid ""
"Create and customize navigation layers in the inspector of the TileSet "
"resource."
msgstr "ສ້າງ ແລະ ປັບແຕ່ງ navigation layers ໃນ inspector ຂອງ TileSet resource."

msgid "Custom Data"
msgstr "ຂໍ້ມູນກຳນົດເອງ (Custom Data)"

msgid "Custom Data %d"
msgstr "Custom Data %d"

msgid "No custom data layers"
msgstr "ບໍ່ມີ Custom Data Layer"

msgid ""
"Create and customize custom data layers in the inspector of the TileSet "
"resource."
msgstr "ສ້າງ ແລະ ປັບແຕ່ງ custom data layers ໃນ inspector ຂອງ TileSet resource."

msgid "Select a property editor"
msgstr "ເລືອກ Property Editor"

msgid "Hold Ctrl to create multiple tiles."
msgstr "ກົດ Ctrl ຄ້າງໄວ້ເພື່ອສ້າງຫຼາຍ tile."

msgid "Hold Shift to create big tiles."
msgstr "ກົດ Shift ຄ້າງໄວ້ເພື່ອສ້າງ tile ຂະໜາດໃຫຍ່."

msgid "Hold Shift to select multiple regions."
msgstr "ກົດ Shift ຄ້າງໄວ້ເພື່ອເລືອກຫຼາຍພື້ນທີ່ (regions)."

msgid ""
"TileSet is in read-only mode. Make the resource unique to edit TileSet "
"properties."
msgstr "TileSet ຢູ່ໃນໂໝດອ່ານຢ່າງດຽວ. ເຮັດໃຫ້ resource ເປັນແບບ unique ເພື່ອແກ້ໄຂຄຸນສົມບັດ."

msgid "Paint properties."
msgstr "ລະບາຍຄຸນສົມບັດ."

msgid "Create tiles"
msgstr "ສ້າງ tile"

msgid "Create a tile"
msgstr "ສ້າງ tile ອັນດຽວ"

msgid "Remove tiles"
msgstr "ລຶບ tile"

msgid "Move a tile"
msgstr "ຍ້າຍ tile"

msgid "Resize a tile"
msgstr "ປັບຂະໜາດ tile"

msgid "Remove tile"
msgstr "ລຶບ tile"

msgid "Create tile alternatives"
msgstr "ສ້າງ tile ທາງເລືອກ"

msgid "Remove Tiles Outside the Texture"
msgstr "ລຶບ tile ທີ່ຢູ່ນອກ texture"

msgid "Create tiles in non-transparent texture regions"
msgstr "ສ້າງ tile ໃນພື້ນທີ່ texture ທີ່ບໍ່ໂປ່ງໃສ"

msgid "Remove tiles in fully transparent texture regions"
msgstr "ລຶບ tile ໃນພື້ນທີ່ texture ທີ່ໂປ່ງໃສທັງໝົດ"

msgid ""
"The tile's unique identifier within this TileSet. Each tile stores its source "
"ID, so changing one may make tiles invalid."
msgstr ""
"ລະຫັດລະບຸຕົວຕົນສະເພາະຂອງ tile ໃນ TileSet ນີ້. ແຕ່ລະ tile ຈະເກັບ source ID ຂອງມັນໄວ້, "
"ດັ່ງນັ້ນການປ່ຽນອັນໃດອັນໜຶ່ງອາດເຮັດໃຫ້ tile ບໍ່ຖືກຕ້ອງ."

msgid ""
"The human-readable name for the atlas. Use a descriptive name here for "
"organizational purposes (such as \"terrain\", \"decoration\", etc.)."
msgstr ""
"ຊື່ທີ່ຄົນອ່ານເຂົ້າໃຈໄດ້ສຳລັບອັດລັສ (atlas). ໃຊ້ຊື່ທີ່ອະທິບາຍຈະແຈ້ງຢູ່ບ່ອນນີ້ເພື່ອຄວາມເປັນລະບຽບ (ເຊັ່ນ "
"\"terrain\", \"decoration\", ແລະ ອື່ນໆ)."

msgid "The image from which the tiles will be created."
msgstr "ຮູບພາບທີ່ຈະຖືກນຳມາສ້າງເປັນໄທລ໌ (tiles)."

msgid ""
"The margins on the image's edges that should not be selectable as tiles (in "
"pixels). Increasing this can be useful if you download a tilesheet image that "
"has margins on the edges (e.g. for attribution)."
msgstr ""
"ຂອບຢູ່ແຄມຂອງຮູບພາບທີ່ບໍ່ຄວນຖືກເລືອກເປັນໄທລ໌ (ເປັນພິກເຊວ). ການເພີ່ມຄ່ານີ້ຈະມີປະໂຫຍດ "
"ຫາກເຈົ້າດາວໂຫຼດຮູບ tilesheet ທີ່ມີຂອບຢູ່ແຄມ (ເຊັ່ນ ເພື່ອໃຫ້ເຄຣດິດຜູ້ສ້າງ)."

msgid ""
"The separation between each tile on the atlas in pixels. Increasing this can "
"be useful if the tilesheet image you're using contains guides (such as "
"outlines between every tile)."
msgstr ""
"ໄລຍະຫ່າງລະຫວ່າງແຕ່ລະໄທລ໌ໃນອັດລັສເປັນພິກເຊວ. ການເພີ່ມຄ່ານີ້ຈະມີປະໂຫຍດ ຫາກຮູບ tilesheet "
"ທີ່ເຈົ້າໃຊ້ມີເສັ້ນນຳທາງ (ເຊັ່ນ ເສັ້ນຂອບລະຫວ່າງແຕ່ລະໄທລ໌)."

msgid ""
"The size of each tile on the atlas in pixels. In most cases, this should "
"match the tile size defined in the TileMap property (although this is not "
"strictly necessary)."
msgstr ""
"ຂະໜາດຂອງແຕ່ລະໄທລ໌ໃນອັດລັສເປັນພິກເຊວ. ສ່ວນຫຼາຍແລ້ວ, ຄ່ານີ້ຄວນຈະກົງກັບຂະໜາດໄທລ໌ "
"ທີ່ກຳນົດໄວ້ໃນຄຸນສົມບັດຂອງ TileMap (ເຖິງແມ່ນວ່າຈະບໍ່ຈຳເປັນຕ້ອງຄືກັນແທ້ໆກໍຕາມ)."

msgid ""
"If checked, adds a 1-pixel transparent edge around each tile to prevent "
"texture bleeding when filtering is enabled. It's recommended to leave this "
"enabled unless you're running into rendering issues due to texture padding."
msgstr ""
"ຫາກໝາຍເລືອກ, ຈະເພີ່ມຂອບໂປ່ງໃສຂະໜາດ 1 ພິກເຊວ ອ້ອມຮອບແຕ່ລະໄທລ໌ເພື່ອປ້ອງກັນ ສີເທັກເຈີເຫຼື້ອມປົນກັນ "
"(texture bleeding) ເມື່ອເປີດໃຊ້ filtering. ແນະນຳໃຫ້ເປີດໃຊ້ຄ່ານີ້ໄວ້ "
"ເວັ້ນເສຍແຕ່ເຈົ້າຈະພົບບັນຫາການສະແດງຜົນເນື່ອງມາຈາກ texture padding."

msgid ""
"The position of the tile's top-left corner in the atlas. The position and "
"size must be within the atlas and can't overlap another tile.\n"
"Each painted tile has associated atlas coords, so changing this property may "
"cause your TileMaps to not display properly."
msgstr ""
"ຕຳແໜ່ງຂອງມຸມຊ້າຍເທິງຂອງໄທລ໌ໃນອັດລັສ. ຕຳແໜ່ງ ແລະ ຂະໜາດຕ້ອງຢູ່ພາຍໃນອັດລັສ ແລະ "
"ບໍ່ສາມາດຊ້ອນທັບກັບໄທລ໌ອື່ນໄດ້.\n"
"ແຕ່ລະໄທລ໌ທີ່ແຕ້ມລົງໄປຈະມີພິກັດອັດລັສທີ່ກ່ຽວຂ້ອງ, ດັ່ງນັ້ນການປ່ຽນຄຸນສົມບັດນີ້ ອາດເຮັດໃຫ້ TileMaps "
"ຂອງເຈົ້າສະແດງຜົນບໍ່ຖືກຕ້ອງ."

msgid "The unit size of the tile."
msgstr "ຂະໜາດຫົວໜ່ວຍຂອງໄທລ໌."

msgid ""
"Number of columns for the animation grid. If number of columns is lower than "
"number of frames, the animation will automatically adjust row count."
msgstr ""
"ຈຳນວນຖັນສຳລັບຕາຕະລາງແອນິເມຊັນ. ຫາກຈຳນວນຖັນໜ້ອຍກວ່າຈຳນວນເຟຣມ, "
"ແອນິເມຊັນຈະປັບຈຳນວນແຖວໃຫ້ໂດຍອັດຕະໂນມັດ."

msgid "The space (in tiles) between each frame of the animation."
msgstr "ໄລຍະຫ່າງ (ເປັນຫົວໜ່ວຍໄທລ໌) ລະຫວ່າງແຕ່ລະເຟຣມຂອງແອນິເມຊັນ."

msgid "Animation speed in frames per second."
msgstr "ຄວາມໄວແອນິເມຊັນເປັນເຟຣມຕໍ່ວິນາທີ."

msgid ""
"Determines how animation will start. In \"Default\" mode all tiles start "
"animating at the same frame. In \"Random Start Times\" mode, each tile starts "
"animation with a random offset."
msgstr ""
"ກຳນົດຮູບແບບການເລີ່ມຕົ້ນຂອງແອນິເມຊັນ. ໃນໂໝດ \"Default\" ທຸກໄທລ໌ຈະເລີ່ມ ແອນິເມຊັນຢູ່ເຟຣມດຽວກັນ. "
"ໃນໂໝດ \"Random Start Times\", ແຕ່ລະໄທລ໌ ຈະເລີ່ມແອນິເມຊັນດ້ວຍການສຸ່ມເວລາເລີ່ມຕົ້ນ."

msgid "If [code]true[/code], the tile is horizontally flipped."
msgstr "ຫາກເປັນ [code]true[/code], ໄທລ໌ຈະຖືກພິກໃນແນວນອນ."

msgid "If [code]true[/code], the tile is vertically flipped."
msgstr "ຫາກເປັນ [code]true[/code], ໄທລ໌ຈະຖືກພິກໃນແນວຕັ້ງ."

msgid ""
"If [code]true[/code], the tile is rotated 90 degrees [i]counter-clockwise[/i] "
"and then flipped vertically. In practice, this means that to rotate a tile by "
"90 degrees clockwise without flipping it, you should enable [b]Flip H[/b] and "
"[b]Transpose[/b]. To rotate a tile by 180 degrees clockwise, enable [b]Flip "
"H[/b] and [b]Flip V[/b]. To rotate a tile by 270 degrees clockwise, enable "
"[b]Flip V[/b] and [b]Transpose[/b]."
msgstr ""
"ຫາກເປັນ [code]true[/code], ໄທລ໌ຈະຖືກໝູນ 90 ອົງສາ [i]ທວນເຂັມໂມງ[/i] ແລ້ວພິກແນວຕັ້ງ. "
"ໃນທາງປະຕິບັດ, ນີ້ໝາຍຄວາມວ່າການໝູນໄທລ໌ 90 ອົງສາຕາມເຂັມໂມງໂດຍບໍ່ພິກ, ເຈົ້າຄວນເປີດໃຊ້ [b]Flip H[/"
"b] ແລະ [b]Transpose[/b]. ເພື່ອໝູນໄທລ໌ 180 ອົງສາຕາມເຂັມໂມງ, ໃຫ້ເປີດ [b]Flip H[/b] ແລະ "
"[b]Flip V[/b]. ເພື່ອໝູນໄທລ໌ 270 ອົງສາຕາມເຂັມໂມງ, ໃຫ້ເປີດ [b]Flip V[/b] ແລະ "
"[b]Transpose[/b]."

msgid ""
"The origin to use for drawing the tile. This can be used to visually offset "
"the tile compared to the base tile."
msgstr ""
"ຈຸດກຳເນີດ (origin) ທີ່ຈະໃຊ້ໃນການແຕ້ມໄທລ໌. ສາມາດໃຊ້ເພື່ອປັບໄລຍະຫ່າງ (offset) "
"ຂອງໄທລ໌ເມື່ອທຽບກັບໄທລ໌ພື້ນຖານ."

msgid "The color multiplier to use when rendering the tile."
msgstr "ຕົວຄູນສີທີ່ຈະໃຊ້ໃນເວລາປະມວນຜົນສະແດງໄທລ໌."

msgid ""
"The material to use for this tile. This can be used to apply a different "
"blend mode or custom shaders to a single tile."
msgstr ""
"ວັດສະດຸ (material) ທີ່ຈະໃຊ້ສຳລັບໄທລ໌ນີ້. ສາມາດໃຊ້ເພື່ອຕັ້ງຄ່າ blend mode ທີ່ແຕກຕ່າງ ຫຼື ໃຊ້ custom "
"shaders ກັບໄທລ໌ດຽວໄດ້."

msgid ""
"The sorting order for this tile. Higher values will make the tile render in "
"front of others on the same layer. The index is relative to the TileMap's own "
"Z index."
msgstr ""
"ລຳດັບການຈັດລຽງສຳລັບໄທລ໌ນີ້. ຄ່າທີ່ສູງກວ່າຈະເຮັດໃຫ້ໄທລ໌ສະແດງຜົນຢູ່ທາງໜ້າໄທລ໌ອື່ນໆ ໃນເລເຍີ (layer) "
"ດຽວກັນ. ຄ່ານີ້ຈະອ້າງອີງຕາມ Z index ຂອງ TileMap ເອງ."

msgid ""
"The vertical offset to use for tile sorting based on its Y coordinate (in "
"pixels). This allows using layers as if they were on different height for top-"
"down games. Adjusting this can help alleviate issues with sorting certain "
"tiles. Only effective if Y Sort Enabled is true on the TileMap layer the tile "
"is placed on."
msgstr ""
"ໄລຍະຫ່າງແນວຕັ້ງທີ່ຈະໃຊ້ໃນການຈັດລຽງໄທລ໌ຕາມພິກັດ Y (ເປັນພິກເຊວ). ນີ້ຊ່ວຍໃຫ້ສາມາດ "
"ໃຊ້ເລເຍີຄືກັບວ່າມັນຢູ່ຄວາມສູງທີ່ຕ່າງກັນສຳລັບເກມແນວ top-down. ການປັບຄ່ານີ້ສາມາດຊ່ວຍ "
"ແກ້ໄຂບັນຫາການຈັດລຽງໄທລ໌ບາງອັນໄດ້. ຈະມີຜົນກໍຕໍ່ເມື່ອ Y Sort Enabled ເປັນ true ໃນເລເຍີຂອງ "
"TileMap ທີ່ໄທລ໌ນັ້ນວາງຢູ່."

msgid ""
"The index of the terrain set this tile belongs to. [code]-1[/code] means it "
"will not be used in terrains."
msgstr ""
"ລຳດັບ (index) ຂອງ terrain set ທີ່ໄທລ໌ນີ້ສັງກັດຢູ່. [code]-1[/code] ໝາຍເຖິງ ຈະບໍ່ຖືກນຳໃຊ້ໃນ "
"terrains."

msgid ""
"The index of the terrain inside the terrain set this tile belongs to. "
"[code]-1[/code] means it will not be used in terrains."
msgstr ""
"ລຳດັບ (index) ຂອງ terrain ພາຍໃນ terrain set ທີ່ໄທລ໌ນີ້ສັງກັດຢູ່. [code]-1[/code] "
"ໝາຍເຖິງຈະບໍ່ຖືກນຳໃຊ້ໃນ terrains."

msgid ""
"The relative probability of this tile appearing when painting with \"Place "
"Random Tile\" enabled."
msgstr ""
"ໂອກາດທີ່ກ່ຽວຂ້ອງ (relative probability) ທີ່ໄທລ໌ນີ້ຈະປາກົດຂຶ້ນ ເມື່ອແຕ້ມດ້ວຍການເປີດໃຊ້ \"Place "
"Random Tile\"."

msgid ""
"The current atlas source has tiles outside the texture.\n"
"You can clear it using \"%s\" option in the 3 dots menu."
msgstr ""
"ແຫຼ່ງອັດລັສ (atlas source) ປັດຈຸບັນມີໄທລ໌ທີ່ຢູ່ນອກເທັກເຈີ (texture).\n"
"ເຈົ້າສາມາດລຶບມັນອອກໄດ້ໂດຍໃຊ້ຕົວເລືອກ \"%s\" ໃນເມນູ 3 ຈ້ຳ."

msgid "Setup"
msgstr "ຕັ້ງຄ່າ"

msgid ""
"Atlas setup. Add/Remove tiles tool (use the shift key to create big tiles, "
"control for rectangle editing)."
msgstr ""
"ການຕັ້ງຄ່າອັດລັສ. ເຄື່ອງມື ເພີ່ມ/ລຶບ ໄທລ໌ (ໃຊ້ປຸ່ມ shift ເພື່ອສ້າງໄທລ໌ຂະໜາດໃຫຍ່, ປຸ່ມ control "
"ສຳລັບການແກ້ໄຂແບບຮູບສີ່ແຈ)."

msgid "Select tiles."
msgstr "ເລືອກໄທລ໌."

msgid "Paint"
msgstr "ແຕ້ມ"

msgid ""
"No tiles selected.\n"
"Select one or more tiles from the palette to edit its properties."
msgstr ""
"ບໍ່ມີໄທລ໌ທີ່ຖືກເລືອກ.\n"
"ເລືອກໄທລ໌ໜຶ່ງອັນ ຫຼື ຫຼາຍກວ່ານັ້ນຈາກ palette ເພື່ອແກ້ໄຂຄຸນສົມບັດຂອງມັນ."

msgid "Paint Properties:"
msgstr "ຄຸນສົມບັດການແຕ້ມ:"

msgid "Create Tiles in Non-Transparent Texture Regions"
msgstr "ສ້າງໄທລ໌ໃນສ່ວນຂອງເທັກເຈີທີ່ບໍ່ໂປ່ງໃສ"

msgid "Remove Tiles in Fully Transparent Texture Regions"
msgstr "ລຶບໄທລ໌ໃນສ່ວນຂອງເທັກເຈີທີ່ໂປ່ງໃສທັງໝົດ"

msgid "Create an Alternative Tile"
msgstr "ສ້າງໄທລ໌ທາງເລືອກ (Alternative Tile)"

msgid "Create a Tile"
msgstr "ສ້າງໄທລ໌"

msgid "Auto Create Tiles in Non-Transparent Texture Regions?"
msgstr "ສ້າງໄທລ໌ໃນສ່ວນຂອງເທັກເຈີທີ່ບໍ່ໂປ່ງໃສໂດຍອັດຕະໂນມັດບໍ່?"

msgid ""
"The atlas's texture was modified.\n"
"Would you like to automatically create tiles in the atlas?"
msgstr ""
"ເທັກເຈີຂອງອັດລັສຖືກປ່ຽນແປງ.\n"
"ເຈົ້າຕ້ອງການສ້າງໄທລ໌ໃນອັດລັສໂດຍອັດຕະໂນມັດບໍ່?"

msgid "Yes"
msgstr "ແມ່ນ"

msgid "No"
msgstr "ບໍ່"

msgid "Invalid texture selected."
msgstr "ເທັກເຈີທີ່ເລືອກບໍ່ຖືກຕ້ອງ."

msgid "Add a new atlas source"
msgstr "ເພີ່ມແຫຼ່ງອັດລັສໃໝ່"

msgid "Remove source"
msgstr "ລຶບແຫຼ່ງຂໍ້ມູນອອກ"

msgid "Add atlas source"
msgstr "ເພີ່ມແຫຼ່ງອັດລັສ"

msgid "TileSet"
msgstr "TileSet"

msgid "Open TileSet Dock"
msgstr "ເປີດ Dock ຂອງ TileSet"

msgid "Tile Sources"
msgstr "ແຫຼ່ງຂໍ້ມູນໄທລ໌"

msgid "Sort Sources"
msgstr "ຈັດລຽງແຫຼ່ງຂໍ້ມູນ"

msgid "A palette of tiles made from a texture."
msgstr "ຊຸດຂອງໄທລ໌ທີ່ສ້າງມາຈາກເທັກເຈີ."

msgid "Scenes Collection"
msgstr "ຊຸດສະສົມສາກ (Scenes Collection)"

msgid "A collection of scenes that can be instantiated and placed as tiles."
msgstr "ຊຸດຂອງສາກ (scenes) ທີ່ສາມາດສ້າງ instance ແລະ ວາງເປັນໄທລ໌ໄດ້."

msgid "Open Atlas Merging Tool"
msgstr "ເປີດເຄື່ອງມືລວມອັດລັສ"

msgid "Manage Tile Proxies"
msgstr "ຈັດການ Tile Proxies"

msgid ""
"No TileSet source selected. Select or create a TileSet source.\n"
"You can create a new source by using the Add button on the left or by "
"dropping a tileset texture onto the source list."
msgstr ""
"ບໍ່ໄດ້ເລືອກແຫຼ່ງ TileSet. ກະລຸນາເລືອກ ຫຼື ສ້າງແຫຼ່ງ TileSet.\n"
"ເຈົ້າສາມາດສ້າງແຫຼ່ງໃໝ່ໄດ້ໂດຍການໃຊ້ປຸ່ມ Add ຢູ່ທາງຊ້າຍ ຫຼື ໂດຍການລາກ tileset texture "
"ມາໃສ່ໃນລາຍການແຫຼ່ງຂໍ້ມູນ."

msgid "Add new patterns in the TileMap editing mode."
msgstr "ເພີ່ມຮູບແບບ (patterns) ໃໝ່ໃນໂໝດການແກ້ໄຂ TileMap."

msgid ""
"Warning: Modifying a source ID will result in all TileMaps using that source "
"to reference an invalid source instead. This may result in unexpected data "
"loss. Change this ID carefully."
msgstr ""
"ຄຳເຕືອນ: ການປ່ຽນແປງ ID ຂອງແຫຼ່ງຂໍ້ມູນ ຈະເຮັດໃຫ້ TileMaps ທັງໝົດທີ່ໃຊ້ແຫຼ່ງນັ້ນ "
"ໄປອ້າງອີງເຖິງແຫຼ່ງທີ່ບໍ່ຖືກຕ້ອງແທນ. ນີ້ອາດເຮັດໃຫ້ຂໍ້ມູນສູນຫາຍໂດຍບໍ່ຄາດຄິດ. ກະລຸນາປ່ຽນ ID "
"ນີ້ດ້ວຍຄວາມລະມັດລະວັງ."

msgid "Add a Scene Tile"
msgstr "ເພີ່ມ Scene Tile"

msgid "Remove a Scene Tile"
msgstr "ລຶບ Scene Tile"

msgid "Drag and drop scenes here or use the Add button."
msgstr "ລາກ ແລະ ວາງສາກ (scenes) ໃສ່ນີ້ ຫຼື ໃຊ້ປຸ່ມ Add."

msgid ""
"The human-readable name for the scene collection. Use a descriptive name here "
"for organizational purposes (such as \"obstacles\", \"decoration\", etc.)."
msgstr ""
"ຊື່ທີ່ຄົນອ່ານເຂົ້າໃຈໄດ້ສຳລັບຊຸດສະສົມສາກ. ໃຊ້ຊື່ທີ່ອະທິບາຍຈະແຈ້ງຢູ່ບ່ອນນີ້ເພື່ອຄວາມເປັນລະບຽບ (ເຊັ່ນ "
"\"obstacles\", \"decoration\", ແລະ ອື່ນໆ)."

msgid ""
"ID of the scene tile in the collection. Each painted tile has associated ID, "
"so changing this property may cause your TileMaps to not display properly."
msgstr ""
"ID ຂອງ scene tile ໃນຊຸດສະສົມ. ແຕ່ລະໄທລ໌ທີ່ແຕ້ມລົງໄປຈະມີ ID ທີ່ກ່ຽວຂ້ອງ, "
"ດັ່ງນັ້ນການປ່ຽນຄຸນສົມບັດນີ້ອາດເຮັດໃຫ້ TileMaps ຂອງເຈົ້າສະແດງຜົນບໍ່ຖືກຕ້ອງ."

msgid "Absolute path to the scene associated with this tile."
msgstr "ທີ່ຢູ່ເຕັມ (Absolute path) ຂອງສາກທີ່ກ່ຽວຂ້ອງກັບໄທລ໌ນີ້."

msgid ""
"If [code]true[/code], a placeholder marker will be displayed on top of the "
"scene's preview. The marker is displayed anyway if the scene has no valid "
"preview."
msgstr ""
"ຫາກເປັນ [code]true[/code], ເຄື່ອງໝາຍບ່ອນວາງ (placeholder) ຈະຖືກສະແດງຢູ່ເທິງ "
"ຕົວຢ່າງຂອງສາກ. ເຄື່ອງໝາຍຈະຖືກສະແດງຢູ່ແລ້ວຫາກສາກນັ້ນບໍ່ມີຕົວຢ່າງທີ່ຖືກຕ້ອງ."

msgid "Scenes collection properties:"
msgstr "ຄຸນສົມບັດຊຸດສະສົມສາກ:"

msgid "Tile properties:"
msgstr "ຄຸນສົມບັດໄທລ໌:"

msgid "Eraser Tool"
msgstr "ເຄື່ອງມືຢາງລຶບ"

msgid "Picker Tool"
msgstr "ເຄື່ອງມືດູດສີ/ເລືອກ"

msgid ""
"Source ID: %d\n"
"Texture path: %s"
msgstr ""
"ID ແຫຼ່ງຂໍ້ມູນ: %d\n"
"ທີ່ຢູ່ເທັກເຈີ: %s"

msgid "Source ID: %d"
msgstr "ID ແຫຼ່ງຂໍ້ມູນ: %d"

msgid "Bone Picker:"
msgstr "ເຄື່ອງມືເລືອກກະດູກ:"

msgid "Clear mappings in current group."
msgstr "ລຶບການຈັບຄູ່ (mappings) ໃນກຸ່ມປັດຈຸບັນ."

msgid "Preview"
msgstr "ເບິ່ງຕົວຢ່າງ"

msgid "Camera Preview"
msgstr "ຕົວຢ່າງຈາກກ້ອງ"

msgid "Change AudioStreamPlayer3D Emission Angle"
msgstr "ປ່ຽນມຸມການປ່ອຍສຽງຂອງ AudioStreamPlayer3D"

msgid "Change Camera FOV"
msgstr "ປ່ຽນ FOV ຂອງກ້ອງ"

msgid "Change Camera Size"
msgstr "ປ່ຽນຂະໜາດກ້ອງ"

msgid "Change Decal Size"
msgstr "ປ່ຽນຂະໜາດ Decal"

msgid "Change FogVolume Size"
msgstr "ປ່ຽນຂະໜາດ FogVolume"

msgid "Change Radius"
msgstr "ປ່ຽນລັດສະໝີ"

msgid "Change Area Light Width"
msgstr "ປ່ຽນຄວາມກວ້າງຂອງ Area Light"

msgid "Change Light Radius"
msgstr "ປ່ຽນລັດສະໝີແສງ"

msgid "Change Area Light Height"
msgstr "ປ່ຽນຄວາມສູງຂອງ Area Light"

msgid "Change Capsule Mesh Radius"
msgstr "ປ່ຽນລັດສະໝີຂອງ Capsule Mesh"

msgid "Change Capsule Mesh Height"
msgstr "ປ່ຽນຄວາມສູງຂອງ Capsule Mesh"

msgid "Change Cylinder Mesh Radius"
msgstr "ປ່ຽນລັດສະໝີຂອງ Cylinder Mesh"

msgid "Change Cylinder Mesh Height"
msgstr "ປ່ຽນຄວາມສູງຂອງ Cylinder Mesh"

msgid "Change Box Mesh Size"
msgstr "ປ່ຽນຂະໜາດຂອງ Box Mesh"

msgid "Change Sphere Shape Radius"
msgstr "ປ່ຽນລັດສະໝີຮູບຊົງວົງມົນ"

msgid "Change Box Shape Size"
msgstr "ປ່ຽນຂະໜາດຮູບຊົງກ່ອງ"

msgid "Change Capsule Shape Radius"
msgstr "ປ່ຽນລັດສະໝີຮູບຊົງແຄັບຊູນ"

msgid "Change Capsule Shape Height"
msgstr "ປ່ຽນຄວາມສູງຮູບຊົງແຄັບຊູນ"

msgid "Change Cylinder Shape Radius"
msgstr "ປ່ຽນລັດສະໝີຮູບຊົງທໍ່ກົມ"

msgid "Change Cylinder Shape Height"
msgstr "ປ່ຽນຄວາມສູງຮູບຊົງທໍ່ກົມ"

msgid "Change Separation Ray Shape Length"
msgstr "ປ່ຽນຄວາມຍາວຂອງຮູບຊົງລັງສີແຍກ (Separation Ray)"

msgid "Remove SoftBody3D pinned point %d"
msgstr "ລຶບຈຸດປັກໝຸດ SoftBody3D %d"

