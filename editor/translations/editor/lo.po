msgstr "ເລືອກ TileMapLayer ທັງໝົດໃນສາກ"

msgid "Highlight Selected TileMap Layer"
msgstr "ເນັ້ນ Layer ຂອງ TileMap ທີ່ເລືອກ"

msgid "Toggle grid visibility."
msgstr "ເປີດ/ປິດ ການເບິ່ງເຫັນຕາຕະລາງ."

msgid "Advanced settings."
msgstr "ການຕັ້ງຄ່າຂັ້ນສູງ."

msgid "Automatically Replace Tiles with Proxies"
msgstr "ປ່ຽນແທນ tile ດ້ວຍ proxy ອັດຕະໂນມັດ"

msgid "Remove Tile Proxies"
msgstr "ລຶບ Tile Proxies"

msgid "Create Alternative-level Tile Proxy"
msgstr "ສ້າງ Tile Proxy ໃນລະດັບ Alternative"

msgid "Create Coords-level Tile Proxy"
msgstr "ສ້າງ Tile Proxy ໃນລະດັບ Coords"

msgid "Create source-level Tile Proxy"
msgstr "ສ້າງ Tile Proxy ໃນລະດັບ Source"

msgid "Delete All Invalid Tile Proxies"
msgstr "ລຶບ Tile Proxies ທີ່ບໍ່ຖືກຕ້ອງທັງໝົດ"

msgid "Delete All Tile Proxies"
msgstr "ລຶບ Tile Proxies ທັງໝົດ"

