msgstr "ແກ້ໄຂດຽວນີ້"

msgid "Project Name"
msgstr "ຊື່ໂຄງການ"

msgid "Project Path"
msgstr "ເສັ້ນທາງໂຄງການ"

msgid "This project was last edited in a different Godot version: "
msgstr "ໂຄງການນີ້ຖືກແກ້ໄຂຫຼ້າສຸດດ້ວຍ Godot ເວີຊັນອື່ນ: "

msgid "Opening it will upgrade it to Godot %s.%s."
msgstr "ການເປີດໂຄງການນີ້ຈະເປັນການອັບເກຣດເປັນ Godot %s.%s."

msgid "Opening it will downgrade it to Godot %s.%s."
msgstr "ການເປີດໂຄງການນີ້ຈະເປັນການດາວເກຣດ (Downgrade) ລົງເປັນ Godot %s.%s."

msgid "Downgrading projects is not recommended."
msgstr "ບໍ່ແນະນຳໃຫ້ດາວເກຣດໂຄງການ."

msgid "Unknown version"
msgstr "ບໍ່ຮູ້ເວີຊັນ"

msgid "This project uses an unknown version of Godot."
msgstr "ໂຄງການນີ້ໃຊ້ Godot ເວີຊັນທີ່ບໍ່ຮູ້ຈັກ."

msgid "This project uses features unsupported by the current build:"
msgstr "ໂຄງການນີ້ໃຊ້ຄຸນສົມບັດທີ່ບໍ່ຮອງຮັບໃນເວີຊັນນີ້:"

msgid "Error: Project is missing on the filesystem."
msgstr "ຂໍ້ຜິດພາດ: ບໍ່ພົບໂຄງການໃນລະບົບໄຟລ໌."

msgid "Toggle Favorite"
msgstr "ສະຫຼັບລາຍການທີ່ມັກ"

msgid "Open in file manager"
msgstr "ເປີດໃນຕົວຈັດການໄຟລ໌"

msgid "Last edited timestamp"
msgstr "ເວລາທີ່ແກ້ໄຂຫຼ້າສຸດ"

msgid "Missing Date"
msgstr "ບໍ່ພົບວັນທີ"

msgid "Scanning"
msgstr "ກຳລັງສະແກນ"

msgid "Scanning for projects..."
msgstr "ກຳລັງສະແກນຫາໂຄງການ..."

msgid "Missing Project"
msgstr "ບໍ່ພົບໂຄງການ"

msgid "Open in Editor (Verbose Mode)"
msgstr "ເປີດໃນຕົວແກ້ໄຂ (ໂໝດລະອຽດ)"

msgid "Open in Editor (Recovery Mode)"
msgstr "ເປີດໃນຕົວແກ້ໄຂ (ໂໝດກູ້ຄືນ)"

msgid "Run Project"
msgstr "ລັນໂຄງການ"

msgid "Manage Tags"
msgstr "ຈັດການແທັກ"

msgid "Remove from Project List"
msgstr "ເອົາອອກຈາກລາຍການໂຄງການ"

msgid "New Window"
msgstr "ໜ້າຕ່າງໃໝ່"

msgctxt "Application"
msgid "Project Manager"
msgstr "ຕົວຈັດການໂຄງການ"

msgid "You don't have any projects yet."
msgstr "ທ່ານຍັງບໍ່ມີໂຄງການໃດໆ."

msgid ""
"Get started by creating a new one,\n"
"importing one that exists, or by downloading a project template from the "
"Asset Store!"
msgstr ""
"ເລີ່ມຕົ້ນໂດຍການສ້າງໃໝ່,\n"
"ນຳເຂົ້າໂຄງການທີ່ມີຢູ່ແລ້ວ, ຫຼື ດາວໂຫຼດແມ່ແບບຈາກ Asset Store!"

msgid "Go Online and Open Asset Store"
msgstr "ເຊື່ອມຕໍ່ອິນເຕີເນັດ ແລະ ເປີດ Asset Store"

msgid "Are you sure to run %d projects at once?"
msgstr "ທ່ານແນ່ໃຈຫຼືບໍ່ທີ່ຈະລັນ %d ໂຄງການພ້ອມກັນ?"

msgid ""
"Can't run project: Project has no main scene defined.\n"
"Please edit the project and set the main scene in the Project Settings under "
"the \"Application\" category."
msgstr "ບໍ່ສາມາດລັນໂຄງການໄດ້: ຍັງບໍ່ໄດ້ກຳນົດສາກຫຼັກ (Main Scene)."

msgid ""
"Can't run project: Assets need to be imported first.\n"
"Please edit the project to trigger the initial import."
msgstr "ບໍ່ສາມາດລັນໂຄງການໄດ້: ຕ້ອງນຳເຂົ້າ Asset ກ່ອນ."

msgid ""
"Can't open project at '%s'.\n"
"Project file doesn't exist or is inaccessible."
msgstr "ບໍ່ສາມາດເປີດໂຄງການທີ່ '%s' ໄດ້."

msgid ""
"Can't open project at '%s'.\n"
"Failed to start the editor."
msgstr "ບໍ່ສາມາດເປີດໂຄງການທີ່ '%s' ໄດ້. ບໍ່ສາມາດເລີ່ມຕົວແກ້ໄຂໄດ້."

msgid ""
"You requested to open %d projects in parallel. Do you confirm?\n"
"Note that usual checks for engine version compatibility will be bypassed."
msgstr "ທ່ານຕ້ອງການເປີດ %d ໂຄງການພ້ອມກັນ ຫຼື ບໍ່?"

msgid ""
"The selected project \"%s\" does not specify its supported Godot version in "
"its configuration file (\"project.godot\").\n"
"\n"
"Project path: %s\n"
"\n"
"If you proceed with opening it, it will be converted to Godot's current "
"configuration file format.\n"
"\n"
"Warning: You won't be able to open the project with previous versions of the "
"engine anymore."
msgstr ""
"ໂຄງການທີ່ເລືອກ \"%s\" ບໍ່ໄດ້ລະບຸເວີຊັນ Godot ທີ່ຮອງຮັບໃນໄຟລ໌ກຳນົດຄ່າ (\"project.godot\").\n"
"ເສັ້ນທາງໂຄງການ: %s\n"
"\n"
"ຖ້າທ່ານດຳເນີນການເປີດມັນ, ມັນຈະຖືກແປງເປັນຮູບແບບໄຟລ໌ກຳນົດຄ່າປັດຈຸບັນຂອງ Godot.\n"
"\n"
"ຄຳເຕືອນ: ທ່ານຈະບໍ່ສາມາດເປີດໂຄງການນີ້ດ້ວຍເວີຊັນກ່ອນໜ້າຂອງເອນຈິນໄດ້ອີກຕໍ່ໄປ."

msgid ""
"The selected project \"%s\" was generated by Godot 3.x, and needs to be "
"converted for Godot 4.x.\n"
"\n"
"Project path: %s\n"
"\n"
"You have three options:\n"
"- Convert only the configuration file (\"project.godot\"). Use this to open "
"the project without attempting to convert its scenes, resources and scripts.\n"
"- Convert the entire project including its scenes, resources and scripts "
"(recommended if you are upgrading).\n"
"- Do nothing and go back.\n"
"\n"
"Warning: If you select a conversion option, you won't be able to open the "
"project with previous versions of the engine anymore."
msgstr ""
"ໂຄງການທີ່ເລືອກ \"%s\" ຖືກສ້າງຂຶ້ນໂດຍ Godot 3.x, ແລະ ຈຳເປັນຕ້ອງໄດ້ຮັບການແປງສຳລັບ Godot "
"4.x.\n"
"\n"
"ເສັ້ນທາງໂຄງການ: %s\n"
"\n"
"ເຈົ້າມີສາມທາງເລືອກ:\n"
"- ແປງສະເພາະໄຟລ໌ການຕັ້ງຄ່າ (\"project.godot\"). "
"ໃຊ້ຕົວເລືອກນີ້ເພື່ອເປີດໂຄງການໂດຍບໍ່ຕ້ອງແປງສາກ, ຊັບພະຍາກອນ ແລະ ສະຄຣິບຂອງມັນ.\n"
"- ແປງທັງໝົດໂຄງການ ລວມທັງສາກ, ຊັບພະຍາກອນ ແລະ ສະຄຣິບ (ແນະນຳຫາກທ່ານກຳລັງອັບເກຣດ).\n"
"- ບໍ່ຕ້ອງເຮັດຫຍັງ ແລະ ກັບຄືນ.\n"
"\n"
"ຄຳເຕືອນ: ຫາກທ່ານເລືອກຕົວເລືອກການແປງ, "
"ທ່ານຈະບໍ່ສາມາດເປີດໂຄງການດ້ວຍເວີຊັນກ່ອນໜ້າຂອງເອນຈິນໄດ້ອີກຕໍ່ໄປ."

msgid "Convert project.godot Only"
msgstr "ແປງສະເພາະ project.godot"

msgid ""
"The selected project \"%s\" was generated by an older engine version, and "
"needs to be converted for this version.\n"
"\n"
"Project path: %s\n"
"\n"
"Do you want to convert it?\n"
"\n"
"Warning: You won't be able to open the project with previous versions of the "
"engine anymore."
msgstr ""
"ໂຄງການທີ່ເລືອກ \"%s\" ຖືກສ້າງຂຶ້ນໂດຍເຄື່ອງຈັກລຸ້ນທີ່ເກົ່າກວ່າ, ແລະ ຈຳເປັນຕ້ອງໄດ້ຮັບການແປງສຳລັບລຸ້ນນີ້.\n"
"\n"
"ເສັ້ນທາງໂຄງການ: %s\n"
"\n"
"ເຈົ້າຕ້ອງການແປງມັນບໍ່?\n"
"\n"
"ຄຳເຕືອນ: ເເຈົ້າຈະບໍ່ສາມາດເປີດໂຄງການນີ້ດ້ວຍເຄື່ອງຈັກລຸ້ນກ່ອນໜ້ານີ້ໄດ້ອີກຕໍ່ໄປ."

msgid "Convert project.godot"
msgstr "ແປງ project.godot"

msgid ""
"Can't open project \"%s\" at the following path:\n"
"\n"
"%s\n"
"\n"
"The project settings were created by a newer engine version, whose settings "
"are not compatible with this version."
msgstr ""
"ບໍ່ສາມາດເປີດໂຄງການ \"%s\" ຕາມເສັ້ນທາງຕໍ່ໄປນີ້:\n"
"\n"
"%s\n"
"\n"
"ການຕັ້ງຄ່າໂຄງການຖືກສ້າງຂຶ້ນໂດຍເວີຊັນຂອງເອນຈິນທີ່ໃໝ່ກວ່າ, ເຊິ່ງການຕັ້ງຄ່າເຫຼົ່ານັ້ນບໍ່ເຂົ້າກັນໄດ້ກັບເວີຊັນນີ້."

msgid ""
"Warning: This project uses double precision floats, but this version of\n"
"Godot uses single precision floats. Opening this project may cause data "
"loss.\n"
"\n"
msgstr ""
"ຄຳເຕືອນ: ໂຄງການນີ້ໃຊ້ເລກຈຸດລອຍຄວາມລະອຽດສອງເທົ່າ, ແຕ່ເວີຊັນນີ້ຂອງ\n"
"Godot ໃຊ້ເລກຈຸດລອຍຄວາມລະອຽດດ່ຽວ. ການເປີດໂຄງການນີ້ອາດເຮັດໃຫ້ຂໍ້ມູນສູນຫາຍ.\n"
"\n"

msgid ""
"Warning: This project uses C#, but this build of Godot does not have\n"
"the Mono module. If you proceed you will not be able to use any C# scripts.\n"
"\n"
msgstr ""
"ຄຳເຕືອນ: ໂຄງການນີ້ໃຊ້ C#, ແຕ່ເວີຊັນຂອງ Godot ນີ້ບໍ່ມີ\n"
"ໂມດູນ Mono. ຖ້າທ່ານດຳເນີນການຕໍ່ ທ່ານຈະບໍ່ສາມາດໃຊ້ສະຄຣິບ C# ໃດໆໄດ້.\n"
"\n"

msgid ""
"Warning: This project was last edited in Godot %s. Opening will change it to "
"Godot %s.\n"
"\n"
msgstr ""
"ຄຳເຕືອນ: ໂຄງການນີ້ຖືກແກ້ໄຂຄັ້ງລ່າສຸດໃນ Godot %s. ການເປີດຈະປ່ຽນມັນເປັນ Godot %s.\n"
"\n"

msgid ""
"Warning: This project uses the following features not supported by this build "
"of Godot:\n"
"\n"
"%s\n"
"\n"
msgstr ""
"ຄຳເຕືອນ: ໂຄງການນີ້ໃຊ້ຄຸນສົມບັດດັ່ງຕໍ່ໄປນີ້ ທີ່ບໍ່ຮອງຮັບໂດຍເວີຊັນ Godot ນີ້:\n"
"\n"
"%s\n"
"\n"

msgid "Open anyway? Project will be modified."
msgstr "ຕ້ອງການເປີດຕໍ່ ຫຼື ບໍ່? ໂຄງການຈະຖືກປ່ຽນແປງ."

msgid "Remove %d projects from the list?"
msgstr "ລົບ %d ໂຄງການອອກຈາກລາຍການ ຫຼື ບໍ່?"

msgid "Remove this project from the list?"
msgstr "ລົບໂຄງການນີ້ອອກຈາກລາຍການ ຫຼື ບໍ່?"

msgid ""
"Remove all missing projects from the list?\n"
"The project folders' contents won't be modified."
msgstr "ລົບໂຄງການທີ່ຫາຍໄປທັງໝົດອອກຈາກລາຍການ ຫຼື ບໍ່?"

msgid ""
"It looks like Godot crashed when opening this project the last time. If "
"you're having problems editing this project, you can try to open it in "
"Recovery Mode."
msgstr "ເບິ່ງຄືວ່າ Godot ເພຫຼ້າສຸດທີ່ເປີດໂຄງການນີ້. ທ່ານສາມາດລອງເປີດໃນໂໝດກູ້ຄືນໄດ້."

msgid ""
"Recovery Mode is a special mode that may help to recover projects that crash "
"the engine during initialization. This mode temporarily disables the "
"following features:"
msgstr "ໂໝດກູ້ຄືນຈະປິດໃຊ້ງານຄຸນສົມບັດຕໍ່ໄປນີ້ຊົ່ວຄາວ:"

msgid "Tool scripts"
msgstr "ສະຄຣິບເຄື່ອງມື (Tool scripts)"

msgid "Editor plugins"
msgstr "ປລັກອິນຕົວແກ້ໄຂ"

msgid "GDExtension addons"
msgstr "GDExtension ແອດອອນ"

msgid "Automatic scene restoring"
msgstr "ການຄືນຄ່າສາກອັດຕະໂນມັດ"

msgid ""
"This mode is intended only for basic editing to troubleshoot such issues, and "
"therefore it will not be possible to run the project during this mode. It is "
"also a good idea to make a backup of your project before proceeding."
msgstr "ໂໝດນີ້ມີໄວ້ເພື່ອແກ້ໄຂບັນຫາເທົ່ານັ້ນ, ທ່ານຈະບໍ່ສາມາດລັນໂຄງການໄດ້."

msgid "Edit the project in Recovery Mode?"
msgstr "ແກ້ໄຂໂຄງການໃນໂໝດກູ້ຄືນ ຫຼື ບໍ່?"

msgid "Couldn't load project at '%s'. It may be missing or corrupted."
msgstr "ບໍ່ສາມາດໂຫຼດໂຄງການທີ່ '%s' ໄດ້."

msgid "Tag name can't be empty."
msgstr "ຊື່ແທັກບໍ່ສາມາດວ່າງເປົ່າໄດ້."

msgid "Tag name can't begin or end with underscore."
msgstr "ຊື່ແທັກບໍ່ສາມາດເລີ່ມຕົ້ນ ຫຼື ລົງທ້າຍດ້ວຍຂີດກ້ອງ (_)."

msgid "Tag name can't contain consecutive underscores or spaces."
msgstr "ຊື່ແທັກບໍ່ສາມາດມີຂີດກ້ອງ ຫຼື ຊ່ອງວ່າງລຽນກັນໄດ້."

msgid "These characters are not allowed in tags: %s."
msgstr "ຕົວອັກສອນເຫຼົ່ານີ້ບໍ່ອະນຸຍາດໃຫ້ໃຊ້ໃນແທັກ: %s."

