msgstr "מחזיר את התוצאה הבוליאנית של ההשוואה בין NaN לבין משתנה סקלרי."

msgid "Less Than (<)"
msgstr "קטן מ־(<)"

msgid "Less Than or Equal (<=)"
msgstr "קטן או שווה (<=)"

msgid "Not Equal (!=)"
msgstr "לא שווה (!=)"

msgid ""
"Returns an associated 2D vector if the provided boolean value is true or "
"false."
msgstr "מחזיר וקטור דו־ממדי משויך אם הערך הבוליאני שסופק הוא אמת או שקר."

msgid ""
"Returns an associated 3D vector if the provided boolean value is true or "
"false."
msgstr "מחזיר וקטור תלת־ממדי משויך אם הערך הבוליאני שסופק הוא אמת או שקר."

msgid ""
"Returns an associated 4D vector if the provided boolean value is true or "
"false."
msgstr "מחזיר וקטור ארבע־ממדי משויך אם הערך הבוליאני שסופק הוא true או false."

msgid ""
"Returns an associated boolean if the provided boolean value is true or false."
msgstr "מחזיר ערך בוליאני משויך אם הערך הבוליאני שסופק הוא אמת או שקר."

msgid ""
"Returns an associated floating-point scalar if the provided boolean value is "
"true or false."
msgstr "מחזיר סקלר נקודה צפה משויך אם הערך הבוליאני שסופק הוא אמת או שקר."

msgid ""
"Returns an associated integer scalar if the provided boolean value is true or "
"false."
msgstr "מחזיר סקלר מספר שלם משויך אם הערך הבוליאני שסופק הוא אמת או שקר."

msgid ""
"Returns an associated transform if the provided boolean value is true or "
"false."
msgstr "מחזיר שינוי צורה משויך אם הערך הבוליאני שסופק הוא אמת או שקר."

msgid ""
"Returns an associated unsigned integer scalar if the provided boolean value "
"is true or false."
msgstr ""
"מחזיר סקלר מספר שלם אי־שלילי משויך אם הערך הבוליאני שסופק הוא אמת או שקר."

msgid "Returns the boolean result of the comparison between two parameters."
msgstr "מחזיר את התוצאה הבוליאנית של ההשוואה בין שני משתנים."

msgid ""
"Returns the boolean result of the comparison between INF (or NaN) and a "
"scalar parameter."
msgstr "מחזיר את התוצאה הבוליאנית של ההשוואה בין INF (או NaN) לבין משתנה סקלרי."

msgid "Boolean constant."
msgstr "קבוע בוליאני."

msgid "Boolean parameter."
msgstr "משתנה בוליאני."

msgid "Translated to '%s' in Godot Shading Language."
msgstr "מתורגם ל־'%s' בשפת ההצללה של Godot."

msgid "'%s' input parameter for all shader modes."
msgstr "משתנה קלט '%s' עבור כל מצבי המצליל."

msgid "Input parameter."
msgstr "משתנה קלט."

msgid "'%s' input parameter for vertex and fragment shader modes."
msgstr "משתנה קלט '%s' עבור מצבי המצליל vertex ו־fragment."

msgid "'%s' input parameter for fragment and light shader modes."
msgstr "משתנה קלט '%s' עבור מצבי המצליל fragment ו־light."

msgid "'%s' input parameter for fragment shader mode."
msgstr "משתנה קלט '%s' עבור מצב המצליל fragment."

msgid "'%s' input parameter for sky shader mode."
msgstr "משתנה קלט '%s' עבור מצב המצליל sky."

msgid "'%s' input parameter for fog shader mode."
msgstr "משתנה קלט '%s' עבור מצב המצליל fog."

msgid "'%s' input parameter for blit shader mode."
msgstr "פרמטר קלט '%s' למצב מצליל blit."

msgid "'%s' input parameter for light shader mode."
msgstr "משתנה קלט '%s' עבור מצב המצליל light."

msgid "'%s' input parameter for vertex shader mode."
msgstr "משתנה קלט '%s' עבור מצב המצליל vertex."

msgid ""
"A node for help to multiply a position input vector by rotation using "
"specific axis. Intended to work with emitters."
msgstr ""
"מפרק שעוזר להכפיל וקטור קלט של מיקום בסיבוב סביב ציר מסוים. מיועד לעבודה עם "
"פולטים."

msgid "Float function."
msgstr "פונקציית Float."

msgid "Float operator."
msgstr "אופרטור Float."

msgid "Integer function."
msgstr "פונקציית מספר שלם."

msgid "Integer operator."
msgstr "אופרטור מספר שלם."

