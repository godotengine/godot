msgstr "פונקציית מספר שלם אי־שלילי."

msgid "Unsigned integer operator."
msgstr "אופרטור מספר שלם אי־שלילי."

msgid "Returns the absolute value of the parameter."
msgstr "מחזיר את הערך המוחלט של המשתנה."

msgid "Returns the arc-cosine of the parameter."
msgstr "מחזיר את הארק־קוסינוס של המשתנה."

msgid "Returns the inverse hyperbolic cosine of the parameter."
msgstr "מחזיר את הקוסינוס ההיפרבולי ההופכי של המשתנה."

msgid "Returns the arc-sine of the parameter."
msgstr "מחזיר את הארק־סינוס של המשתנה."

msgid "Returns the inverse hyperbolic sine of the parameter."
msgstr "מחזיר את הסינוס ההיפרבולי ההופכי של המשתנה."

msgid "Returns the arc-tangent of the parameter."
msgstr "מחזיר את הארק־טנגנס של המשתנה."

msgid "Returns the arc-tangent of the parameters."
msgstr "מחזיר את הארק־טנגנס של המשתנים."

msgid "Returns the inverse hyperbolic tangent of the parameter."
msgstr "מחזיר את הטנגנס ההיפרבולי ההופכי של המשתנה."

msgid "Returns the result of bitwise NOT (~a) operation on the integer."
msgstr "מחזיר את התוצאה של פעולת NOT ברמת הסיביות (‎~a) על המספר השלם."

msgid ""
"Returns the result of bitwise NOT (~a) operation on the unsigned integer."
msgstr "מחזיר את התוצאה של פעולת NOT ברמת הסיביות (‎~a) על המספר השלם האי־שלילי."

msgid ""
"Finds the nearest integer that is greater than or equal to the parameter."
msgstr "מוצא את המספר השלם הקרוב ביותר שגדול מהמשתנה או שווה לו."

msgid "Constrains a value to lie between two further values."
msgstr "מגביל ערך כך שיהיה בין שני ערכים אחרים."

msgid "Returns the cosine of the parameter."
msgstr "מחזיר את הקוסינוס של המשתנה."

msgid "Returns the hyperbolic cosine of the parameter."
msgstr "מחזיר את הקוסינוס ההיפרבולי של המשתנה."

msgid "Converts a quantity in radians to degrees."
msgstr "ממיר כמות ברדיאנים למעלות."

msgid ""
"(Fragment/Light mode only) (Scalar) Derivative in 'x' using local "
"differencing."
msgstr "(מצב Fragment/Light בלבד) (סקלר) נגזרת ב־'x' באמצעות הפרשים מקומיים."

msgid ""
"(Fragment/Light mode only) (Scalar) Derivative in 'y' using local "
"differencing."
msgstr "(מצב Fragment/Light בלבד) (סקלר) נגזרת ב־'y' באמצעות הפרשים מקומיים."

msgid "(Scalar) Derivative in 'x' using local differencing."
msgstr "(סקלר) נגזרת ב־'x' באמצעות הפרשים מקומיים."

msgid "(Scalar) Derivative in 'y' using local differencing."
msgstr "(סקלר) נגזרת ב־'y' באמצעות הפרשים מקומיים."

msgid "Base-e Exponential."
msgstr "מעריכית בבסיס e."

msgid "Base-2 Exponential."
msgstr "מעריכית בבסיס 2."

msgid "Finds the nearest integer less than or equal to the parameter."
msgstr "מוצא את המספר השלם הקרוב ביותר שקטן מהמשתנה או שווה לו."

msgid "Computes the fractional part of the argument."
msgstr "מחשב את החלק השברי של הארגומנט."

msgid "Returns the inverse of the square root of the parameter."
msgstr "מחזיר את ההופכי של השורש הריבועי של המשתנה."

msgid "Natural logarithm."
msgstr "לוגריתם טבעי."

msgid "Base-2 logarithm."
msgstr "לוגריתם בבסיס 2."

msgid "Returns the greater of two values."
msgstr "מחזיר את הגדול מבין שני ערכים."

msgid "Returns the lesser of two values."
msgstr "מחזיר את הקטן מבין שני ערכים."

msgid "Linear interpolation between two scalars."
msgstr "אינטרפולציה ליניארית בין שני סקלרים."

msgid "Performs a fused multiply-add operation (a * b + c) on scalars."
msgstr "ביצוע פעולת כפל־חיבור משולבת (a * b + c) על סקלרים."

msgid "Returns the opposite value of the parameter."
msgstr "מחזיר את הערך הנגדי של המשתנה."

msgid "1.0 - scalar"
msgstr "1.0 - סקלר"

msgid ""
"Returns the value of the first parameter raised to the power of the second."
msgstr "מחזיר את ערך המשתנה הראשון בחזקת השני."

msgid "Converts a quantity in degrees to radians."
msgstr "ממיר כמות במעלות לרדיאנים."

msgid "1.0 / scalar"
msgstr "1.0 / סקלר"

msgid "Remaps a value from the input range to the output range."
msgstr "ממפה מחדש ערך מטווח הקלט לטווח הפלט."

msgid "Finds the nearest integer to the parameter."
msgstr "מוצא את המספר השלם הקרוב ביותר למשתנה."

msgid "Finds the nearest even integer to the parameter."
msgstr "מוצא את המספר השלם הזוגי הקרוב ביותר למשתנה."

msgid "Clamps the value between 0.0 and 1.0."
msgstr "מגביל את הערך לטווח שבין 0.0 ל־1.0."

msgid "Extracts the sign of the parameter."
msgstr "מחלץ את הסימן של המשתנה."

msgid "Returns the sine of the parameter."
msgstr "מחזיר את הסינוס של המשתנה."

msgid "Returns the hyperbolic sine of the parameter."
msgstr "מחזיר את הסינוס ההיפרבולי של המשתנה."

msgid "Returns the square root of the parameter."
msgstr "מחזיר את השורש הריבועי של המשתנה."

msgid ""
"SmoothStep function( scalar(edge0), scalar(edge1), scalar(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge0' and 1.0 if x is larger than "
"'edge1'. Otherwise the return value is interpolated between 0.0 and 1.0 using "
"Hermite polynomials."
msgstr ""
"הפונקציה SmoothStep( scalar(edge0), scalar(edge1), scalar(x) ).\n"
"\n"
"מחזירה 0.0 אם 'x' קטן מ־'edge0' ו־1.0 אם x גדול מ־'edge1'. אחרת הערך המוחזר "
"הוא אינטרפולציה בין 0.0 ל־1.0 באמצעות פולינומי הרמיט."

msgid ""
"Step function( scalar(edge), scalar(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge' and otherwise 1.0."
msgstr ""
"הפונקציה Step( scalar(edge), scalar(x) ).\n"
"\n"
"מחזירה 0.0 אם 'x' קטן מ־'edge' ואחרת 1.0."

msgid ""
"(Fragment/Light mode only) (Scalar) Sum of absolute derivative in 'x' and 'y'."
msgstr "(מצב Fragment/Light בלבד) (סקלר) סכום הנגזרות המוחלטות ב־'x' וב־'y'."

msgid "(Scalar) Sum of absolute derivative in 'x' and 'y'."
msgstr "(סקלר) סכום הנגזרות המוחלטות ב־'x' וב־'y'."

msgid "Returns the tangent of the parameter."
msgstr "מחזיר את הטנגנס של המשתנה."

msgid "Returns the hyperbolic tangent of the parameter."
msgstr "מחזיר את הטנגנס ההיפרבולי של המשתנה."

msgid "Finds the truncated value of the parameter."
msgstr "מוצא את הערך הקטום של המשתנה."

msgid "Sums two floating-point scalars."
msgstr "חיבור שני סקלרים מסוג נקודה צפה."

msgid "Sums two integer scalars."
msgstr "חיבור שני סקלרים מסוג מספר שלם."

msgid "Sums two unsigned integer scalars."
msgstr "חיבור שני סקלרים מסוג מספר שלם אי־שלילי."

msgid "Returns the result of bitwise AND (a & b) operation for two integers."
msgstr ""
"מחזיר את התוצאה של פעולת AND ברמת הסיביות (a & b) עבור שני מספרים שלמים."

msgid ""
"Returns the result of bitwise AND (a & b) operation for two unsigned integers."
msgstr ""
"מחזיר את התוצאה של פעולת AND ברמת הסיביות (a & b) עבור שני מספרים שלמים אי־"
"שליליים."

msgid ""
"Returns the result of bitwise left shift (a << b) operation on the integer."
msgstr ""
"מחזיר את התוצאה של פעולת הזזה שמאלה ברמת הסיביות (a << b) על המספר השלם."

msgid ""
"Returns the result of bitwise left shift (a << b) operation on the unsigned "
"integer."
msgstr ""
"מחזיר את התוצאה של פעולת הזזה שמאלה ברמת הסיביות (a << b) על המספר השלם האי־"
"שלילי."

msgid "Returns the result of bitwise OR (a | b) operation for two integers."
msgstr "מחזיר את התוצאה של פעולת OR ברמת הסיביות (a | b) עבור שני מספרים שלמים."

msgid ""
"Returns the result of bitwise OR (a | b) operation for two unsigned integers."
msgstr ""
"מחזיר את התוצאה של פעולת OR ברמת הסיביות (a | b) עבור שני מספרים שלמים אי־"
"שליליים."

msgid ""
"Returns the result of bitwise right shift (a >> b) operation on the integer."
msgstr ""
"מחזיר את התוצאה של פעולת הזזה ימינה ברמת הסיביות (a >> b) על המספר השלם."

msgid ""
"Returns the result of bitwise right shift (a >> b) operation on the unsigned "
"integer."
msgstr ""
"מחזיר את התוצאה של פעולת הזזה ימינה ברמת הסיביות (a >> b) על המספר השלם האי־"
"שלילי."

msgid "Returns the result of bitwise XOR (a ^ b) operation on the integer."
msgstr "מחזיר את התוצאה של פעולת XOR ברמת הסיביות (a ^ b) על המספר השלם."

msgid ""
"Returns the result of bitwise XOR (a ^ b) operation on the unsigned integer."
msgstr ""
"מחזיר את התוצאה של פעולת XOR ברמת הסיביות (a ^ b) על המספר השלם האי־שלילי."

msgid "Divides two floating-point scalars."
msgstr "חילוק שני סקלרים מסוג נקודה צפה."

msgid "Divides two integer scalars."
msgstr "חילוק שני סקלרים מסוג מספר שלם."

msgid "Divides two unsigned integer scalars."
msgstr "חילוק שני סקלרים מסוג מספר שלם אי־שלילי."

msgid "Multiplies two floating-point scalars."
msgstr "כפל שני סקלרים מסוג נקודה צפה."

msgid "Multiplies two integer scalars."
msgstr "כפל שני סקלרים מסוג מספר שלם."

msgid "Multiplies two unsigned integer scalars."
msgstr "כפל שני סקלרים מסוג מספר שלם אי־שלילי."

msgid "Returns the remainder of the two floating-point scalars."
msgstr "מחזיר את השארית של שני הסקלרים מסוג נקודה צפה."

msgid "Returns the remainder of the two integer scalars."
msgstr "מחזיר את השארית של שני הסקלרים מסוג מספר שלם."

msgid "Returns the remainder of the two unsigned integer scalars."
msgstr "מחזיר את השארית של שני הסקלרים מסוג מספר שלם אי־שלילי."

msgid "Subtracts two floating-point scalars."
msgstr "חיסור שני סקלרים מסוג נקודה צפה."

msgid "Subtracts two integer scalars."
msgstr "חיסור שני סקלרים מסוג מספר שלם."

msgid "Subtracts two unsigned integer scalars."
msgstr "חיסור שני סקלרים מסוג מספר שלם אי־שלילי."

msgid "Scalar floating-point constant."
msgstr "קבוע סקלרי מסוג נקודה צפה."

msgid "Scalar integer constant."
msgstr "קבוע סקלרי מסוג מספר שלם."

msgid "Scalar unsigned integer constant."
msgstr "קבוע סקלרי מסוג מספר שלם אי־שלילי."

msgid "Scalar floating-point parameter."
msgstr "משתנה סקלרי מסוג נקודה צפה."

msgid "Scalar integer parameter."
msgstr "משתנה סקלרי מסוג מספר שלם."

msgid "Scalar unsigned integer parameter."
msgstr "משתנה סקלרי מסוג מספר שלם אי־שלילי."

msgid "Converts screen UV to a SDF."
msgstr "המרת UV של המסך ל־SDF."

msgid "Casts a ray against the screen SDF and returns the distance travelled."
msgstr "הטלת קרן מול ה־SDF של המסך והחזרת המרחק שעברה."

msgid "Converts a SDF to screen UV."
msgstr "המרת SDF ל־UV של המסך."

msgid "Performs a SDF texture lookup."
msgstr "ביצוע חיפוש במרקם SDF."

msgid "Performs a SDF normal texture lookup."
msgstr "ביצוע חיפוש במרקם נורמלים של SDF."

msgid "Function to be applied on texture coordinates."
msgstr "פונקציה שתוחל על קואורדינטות המרקם."

msgid "Polar coordinates conversion applied on texture coordinates."
msgstr "המרת קואורדינטות קוטביות שמוחלת על קואורדינטות המרקם."

msgid "Perform the cubic texture lookup."
msgstr "ביצוע חיפוש מרקם קובייתי."

msgid "Perform the curve texture lookup."
msgstr "ביצוע חיפוש במרקם עקום."

msgid "Perform the three components curve texture lookup."
msgstr "ביצוע חיפוש במרקם עקום בעל שלושה רכיבים."

msgid ""
"Returns the depth value obtained from the depth prepass in a linear space."
msgstr "מחזיר את ערך העומק שהתקבל ממעבר העומק המקדים במרחב ליניארי."

msgid "Reconstructs the World Position of the Node from the depth texture."
msgstr "משחזר את מיקום העולם של המפרק ממרקם העומק."

msgid "Perform the 2D texture lookup."
msgstr "ביצוע חיפוש במרקם דו־ממדי."

msgid "Perform the 2D-array texture lookup."
msgstr "ביצוע חיפוש במערך מרקמים דו־ממדי."

msgid "Perform the 3D texture lookup."
msgstr "ביצוע חיפוש במרקם תלת־ממדי."

msgid "Apply panning function on texture coordinates."
msgstr "החלת פונקציית הזזה על קואורדינטות המרקם."

msgid "Apply scaling function on texture coordinates."
msgstr "החלת פונקציית שינוי קנה מידה על קואורדינטות המרקם."

msgid "Cubic texture parameter lookup."
msgstr "חיפוש במשתנה מרקם קובייתי."

msgid "2D texture parameter lookup."
msgstr "חיפוש במשתנה מרקם דו־ממדי."

msgid "2D texture parameter lookup with triplanar."
msgstr "חיפוש במשתנה מרקם דו־ממדי עם הטלה תלת־מישורית."

msgid "2D array of textures parameter lookup."
msgstr "חיפוש במשתנה מערך מרקמים דו־ממדי."

msgid "3D texture parameter lookup."
msgstr "חיפוש במשתנה מרקם תלת־ממדי."

msgid "Transform function."
msgstr "פונקציית שינוי צורה."

msgid "Transform operator."
msgstr "אופרטור שינוי צורה."

msgid ""
"Calculate the outer product of a pair of vectors.\n"
"\n"
"OuterProduct treats the first parameter 'c' as a column vector (matrix with "
"one column) and the second parameter 'r' as a row vector (matrix with one "
"row) and does a linear algebraic matrix multiply 'c * r', yielding a matrix "
"whose number of rows is the number of components in 'c' and whose number of "
"columns is the number of components in 'r'."
msgstr ""
"חישוב המכפלה החיצונית של זוג וקטורים.\n"
"\n"
"OuterProduct מתייחס למשתנה הראשון 'c' כווקטור עמודה (מטריצה עם עמודה אחת) "
"ולמשתנה השני 'r' כווקטור שורה (מטריצה עם שורה אחת) ומבצע כפל מטריצות אלגברי "
"ליניארי 'c * r', שמניב מטריצה שמספר השורות בה הוא מספר הרכיבים ב־'c' ומספר "
"העמודות בה הוא מספר הרכיבים ב־'r'."

msgid "Composes transform from four vectors."
msgstr "מרכיב שינוי צורה מארבעה וקטורים."

msgid "Decomposes transform to four vectors."
msgstr "מפרק שינוי צורה לארבעה וקטורים."

msgid "Calculates the determinant of a transform."
msgstr "מחשב את הדטרמיננטה של שינוי צורה."

msgid ""
"Calculates how the object should face the camera to be applied on Model View "
"Matrix output port for 3D objects."
msgstr ""
"חישוב האופן שבו האובייקט צריך לפנות אל המצלמה, להחלה על פתחת הפלט Model View "
"Matrix עבור אובייקטים תלת־ממדיים."

msgid "Calculates the inverse of a transform."
msgstr "מחשב את ההופכי של שינוי צורה."

msgid "Calculates the transpose of a transform."
msgstr "מחשב את השחלוף של שינוי צורה."

msgid "Sums two transforms."
msgstr "חיבור שני שינויי צורה."

msgid "Divides two transforms."
msgstr "חילוק שני שינויי צורה."

msgid "Multiplies two transforms."
msgstr "כפל שני שינויי צורה."

msgid "Performs per-component multiplication of two transforms."
msgstr "ביצוע כפל לפי רכיבים של שני שינויי צורה."

msgid "Subtracts two transforms."
msgstr "חיסור שני שינויי צורה."

msgid "Multiplies vector by transform."
msgstr "מכפיל וקטור בשינוי צורה."

msgid "Transform constant."
msgstr "קבוע שינוי צורה."

msgid "Transform parameter."
msgstr "משתנה שינוי צורה."

msgid ""
"The distance fade effect fades out each pixel based on its distance to "
"another object."
msgstr "אפקט דעיכת המרחק מעמעם כל פיקסל לפי המרחק שלו מאובייקט אחר."

msgid ""
"The proximity fade effect fades out each pixel based on its distance to "
"another object."
msgstr "אפקט דעיכת הקרבה מעמעם כל פיקסל לפי המרחק שלו מאובייקט אחר."

msgid "Returns a random value between the minimum and maximum input values."
msgstr "מחזיר ערך אקראי בין ערכי הקלט המזערי והמרבי."

msgid "Vector function."
msgstr "פונקציה וקטורית."

msgid "Vector operator."
msgstr "אופרטור וקטורי."

msgid "Composes vector from scalars."
msgstr "הרכבת וקטור מסקלרים."

msgid "Decomposes vector to scalars."
msgstr "פירוק וקטור לסקלרים."

msgid "Composes 2D vector from two scalars."
msgstr "הרכבת וקטור דו־ממדי משני סקלרים."

msgid "Decomposes 2D vector to two scalars."
msgstr "פירוק וקטור דו־ממדי לשני סקלרים."

msgid "Composes 3D vector from three scalars."
msgstr "הרכבת וקטור תלת־ממדי משלושה סקלרים."

msgid "Decomposes 3D vector to three scalars."
msgstr "פירוק וקטור תלת־ממדי לשלושה סקלרים."

msgid "Composes 4D vector from four scalars."
msgstr "הרכבת וקטור ארבע־ממדי מארבעה סקלרים."

msgid "Decomposes 4D vector to four scalars."
msgstr "פירוק וקטור ארבע־ממדי לארבעה סקלרים."

msgid "Calculates the cross product of two vectors."
msgstr "מחשב את המכפלה הווקטורית של שני וקטורים."

msgid ""
"(Fragment/Light mode only) (Vector) Derivative in 'x' using local "
"differencing."
msgstr "(מצב Fragment/Light בלבד) (וקטור) נגזרת ב־'x' באמצעות הפרשים מקומיים."

msgid ""
"(Fragment/Light mode only) (Vector) Derivative in 'y' using local "
"differencing."
msgstr "(מצב Fragment/Light בלבד) (וקטור) נגזרת ב־'y' באמצעות הפרשים מקומיים."

msgid "(Vector) Derivative in 'x' using local differencing."
msgstr "(וקטור) נגזרת ב־'x' באמצעות הפרשים מקומיים."

msgid "(Vector) Derivative in 'y' using local differencing."
msgstr "(וקטור) נגזרת ב־'y' באמצעות הפרשים מקומיים."

msgid "Returns the distance between two points."
msgstr "מחזיר את המרחק בין שתי נקודות."

msgid "Calculates the dot product of two vectors."
msgstr "מחשב את המכפלה הסקלרית של שני וקטורים."

msgid ""
"Returns the vector that points in the same direction as a reference vector. "
"The function has three vector parameters : N, the vector to orient, I, the "
"incident vector, and Nref, the reference vector. If the dot product of I and "
"Nref is smaller than zero the return value is N. Otherwise -N is returned."
msgstr ""
"מחזיר את הווקטור שמצביע לאותו כיוון כמו וקטור ייחוס. לפונקציה שלושה משתנים "
"וקטוריים: N, הווקטור שיש לכוון, I, וקטור הפגיעה, ו־Nref, וקטור הייחוס. אם "
"המכפלה הסקלרית של I ו־Nref קטנה מאפס, הערך המוחזר הוא N. אחרת מוחזר ‎-N."

msgid ""
"Returns falloff based on the dot product of surface normal and view direction "
"of camera (pass associated inputs to it)."
msgstr ""
"מחזיר דעיכה לפי המכפלה הסקלרית של נורמל המשטח וכיוון המבט של המצלמה (יש "
"להעביר אליו את הקלטים המשויכים)."

msgid "Calculates the length of a vector."
msgstr "מחשב את אורכו של וקטור."

msgid "Linear interpolation between two vectors."
msgstr "אינטרפולציה ליניארית בין שני וקטורים."

msgid "Linear interpolation between two vectors using scalar."
msgstr "אינטרפולציה ליניארית בין שני וקטורים באמצעות סקלר."

msgid "Performs a fused multiply-add operation (a * b + c) on vectors."
msgstr "ביצוע פעולת כפל־חיבור משולבת (a * b + c) על וקטורים."

msgid "Calculates the normalize product of vector."
msgstr "מחשב את הנרמול של וקטור."

msgid "1.0 - vector"
msgstr "1.0 - וקטור"

msgid "1.0 / vector"
msgstr "1.0 / וקטור"

msgid ""
"Returns the vector that points in the direction of reflection ( a : incident "
"vector, b : normal vector )."
msgstr ""
"מחזיר את הווקטור שמצביע לכיוון ההחזרה (a: וקטור הפגיעה, b: וקטור הנורמל)."

msgid "Returns the vector that points in the direction of refraction."
msgstr "מחזיר את הווקטור שמצביע לכיוון השבירה."

msgid "Remaps a vector from the input range to the output range."
msgstr "ממפה מחדש וקטור מטווח הקלט לטווח הפלט."

msgid ""
"Remaps a vector from the input range to the output range. Ranges defined with "
"scalars."
msgstr "ממפה מחדש וקטור מטווח הקלט לטווח הפלט. הטווחים מוגדרים באמצעות סקלרים."

msgid ""
"SmoothStep function( vector(edge0), vector(edge1), vector(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge0' and 1.0 if 'x' is larger than "
"'edge1'. Otherwise the return value is interpolated between 0.0 and 1.0 using "
"Hermite polynomials."
msgstr ""
"הפונקציה SmoothStep( vector(edge0), vector(edge1), vector(x) ).\n"
"\n"
"מחזירה 0.0 אם 'x' קטן מ־'edge0' ו־1.0 אם 'x' גדול מ־'edge1'. אחרת הערך המוחזר "
"הוא אינטרפולציה בין 0.0 ל־1.0 באמצעות פולינומי הרמיט."

msgid ""
"SmoothStep function( scalar(edge0), scalar(edge1), vector(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge0' and 1.0 if 'x' is larger than "
"'edge1'. Otherwise the return value is interpolated between 0.0 and 1.0 using "
"Hermite polynomials."
msgstr ""
"הפונקציה SmoothStep( scalar(edge0), scalar(edge1), vector(x) ).\n"
"\n"
"מחזירה 0.0 אם 'x' קטן מ־'edge0' ו־1.0 אם 'x' גדול מ־'edge1'. אחרת הערך המוחזר "
"הוא אינטרפולציה בין 0.0 ל־1.0 באמצעות פולינומי הרמיט."

msgid ""
"Step function( vector(edge), vector(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge' and otherwise 1.0."
msgstr ""
"הפונקציה Step( vector(edge), vector(x) ).\n"
"\n"
"מחזירה 0.0 אם 'x' קטן מ־'edge' ואחרת 1.0."

msgid ""
"Step function( scalar(edge), vector(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge' and otherwise 1.0."
msgstr ""
"הפונקציה Step( scalar(edge), vector(x) ).\n"
"\n"
"מחזירה 0.0 אם 'x' קטן מ־'edge' ואחרת 1.0."

msgid ""
"(Fragment/Light mode only) (Vector) Sum of absolute derivative in 'x' and 'y'."
msgstr "(מצב Fragment/Light בלבד) (וקטור) סכום הנגזרות המוחלטות ב־'x' וב־'y'."

msgid "(Vector) Sum of absolute derivative in 'x' and 'y'."
msgstr "(וקטור) סכום הנגזרות המוחלטות ב־'x' וב־'y'."

msgid "Adds 2D vector to 2D vector."
msgstr "חיבור וקטור דו־ממדי לווקטור דו־ממדי."

msgid "Adds 3D vector to 3D vector."
msgstr "חיבור וקטור תלת־ממדי לווקטור תלת־ממדי."

msgid "Adds 4D vector to 4D vector."
msgstr "חיבור וקטור ארבע־ממדי לווקטור ארבע־ממדי."

msgid "Divides 2D vector by 2D vector."
msgstr "חילוק וקטור דו־ממדי בווקטור דו־ממדי."

msgid "Divides 3D vector by 3D vector."
msgstr "חילוק וקטור תלת־ממדי בווקטור תלת־ממדי."

msgid "Divides 4D vector by 4D vector."
msgstr "חילוק וקטור ארבע־ממדי בווקטור ארבע־ממדי."

msgid "Multiplies 2D vector by 2D vector."
msgstr "כפל וקטור דו־ממדי בווקטור דו־ממדי."

msgid "Multiplies 3D vector by 3D vector."
msgstr "כפל וקטור תלת־ממדי בווקטור תלת־ממדי."

msgid "Multiplies 4D vector by 4D vector."
msgstr "כפל וקטור ארבע־ממדי בווקטור ארבע־ממדי."

msgid "Returns the remainder of the two 2D vectors."
msgstr "מחזיר את השארית של שני הווקטורים הדו־ממדיים."

msgid "Returns the remainder of the two 3D vectors."
msgstr "מחזיר את השארית של שני הווקטורים התלת־ממדיים."

msgid "Returns the remainder of the two 4D vectors."
msgstr "מחזיר את השארית של שני הווקטורים הארבע־ממדיים."

msgid "Subtracts 2D vector from 2D vector."
msgstr "חיסור וקטור דו־ממדי מווקטור דו־ממדי."

msgid "Subtracts 3D vector from 3D vector."
msgstr "חיסור וקטור תלת־ממדי מווקטור תלת־ממדי."

msgid "Subtracts 4D vector from 4D vector."
msgstr "חיסור וקטור ארבע־ממדי מווקטור ארבע־ממדי."

msgid "2D vector constant."
msgstr "קבוע וקטור דו־ממדי."

msgid "2D vector parameter."
msgstr "משתנה וקטור דו־ממדי."

msgid "3D vector constant."
msgstr "קבוע וקטור תלת־ממדי."

msgid "3D vector parameter."
msgstr "משתנה וקטור תלת־ממדי."

msgid "4D vector constant."
msgstr "קבוע וקטור ארבע־ממדי."

msgid "4D vector parameter."
msgstr "משתנה וקטור ארבע־ממדי."

msgid ""
"A rectangular area with a description string for better graph organization."
msgstr "אזור מלבני עם מחרוזת תיאור לארגון טוב יותר של הגרף."

msgid ""
"Custom Godot Shader Language expression, with custom amount of input and "
"output ports. This is a direct injection of code into the vertex/fragment/"
"light function, do not use it to write the function declarations inside."
msgstr ""
"ביטוי מותאם אישית בשפת המצלילים של Godot, עם מספר מותאם אישית של פתחות קלט "
"ופלט. זוהי הזרקה ישירה של קוד לפונקציית vertex/fragment/light, אין להשתמש בה "
"לכתיבת הצהרות פונקציות בתוכה."

msgid ""
"Custom Godot Shader Language expression, which is placed on top of the "
"resulted shader. You can place various function definitions inside and call "
"it later in the Expressions. You can also declare varyings, parameters and "
"constants."
msgstr ""
"ביטוי מותאם אישית בשפת המצלילים של Godot, שממוקם בראש המצליל שנוצר. ניתן למקם "
"בתוכו הגדרות פונקציות שונות ולקרוא להן מאוחר יותר בביטויים. ניתן גם להצהיר על "
"varyings, משתנים וקבועים."

msgid "A reference to an existing parameter."
msgstr "הפניה למשתנה קיים."

msgid "Get varying parameter."
msgstr "קבלת משתנה varying."

msgid "Set varying parameter."
msgstr "הגדרת משתנה varying."

msgid ""
"Reroute connections freely, can be used to connect multiple input ports to "
"single output port."
msgstr ""
"ניתוב מחדש של חיבורים בחופשיות, ניתן להשתמש בזה כדי לחבר כמה מחברי קלט למחבר "
"פלט יחיד."

msgid "[None]"
msgstr "[ללא]"

msgid "Edit Visual Property: %s"
msgstr "עריכת מאפיין חזותי: %s"

msgid "Visual Shader Mode Changed"
msgstr "מצב המצליל החזותי השתנה"

msgid ""
"Cannot convert VisualShader to GDShader because VisualShader has embedded "
"subresources."
msgstr ""
"לא ניתן להמיר VisualShader ל־GDShader כי ב־VisualShader יש תת־משאבים מוטמעים."

msgid ""
"Visual Shader conversion cannot convert external dependencies. Resource "
"references from Nodes will have to be rebound as ShaderParameters on a "
"Material."
msgstr ""
"המרת Visual Shader לא יכולה להמיר תלויות חיצוניות. יהיה צורך לכרוך מחדש "
"הפניות למשאבים מהמפרקים כ־ShaderParameters בחומר."

msgid ""
"Shader keywords cannot be used as parameter names.\n"
"Choose another name."
msgstr ""
"לא ניתן להשתמש במילות מפתח של מצלילים כשמות משתנים.\n"
"יש לבחור שם אחר."

msgid "This parameter type does not support the '%s' qualifier."
msgstr "סוג משתנה זה אינו תומך במגדיר '%s'."

msgid ""
"Global parameter '%s' does not exist.\n"
"Create it in the Project Settings."
msgstr ""
"המשתנה הגלובלי '%s' לא קיים.\n"
"יש ליצור אותו בהגדרות המיזם."

msgid ""
"Global parameter '%s' has an incompatible type for this kind of node.\n"
"Change it in the Project Settings."
msgstr ""
"למשתנה הגלובלי '%s' יש סוג שאינו תואם לסוג מפרק זה.\n"
"יש לשנות אותו בהגדרות המיזם."

msgid ""
"The sampler port is connected but not used. Consider changing the source to "
"'SamplerPort'."
msgstr ""
"פתחת הדוגם מחוברת אך לא בשימוש. כדאי לשקול לשנות את המקור ל־'SamplerPort'."

msgid "Invalid source for preview."
msgstr "מקור לא תקין לתצוגה מקדימה."

msgid "Invalid source for shader."
msgstr "מקור לא תקין ל-shader."

msgid "Invalid operator for that type."
msgstr "אופרטור לא תקין עבור סוג זה."

msgid ""
"`%s` precision mode is not available for `gl_compatibility` profile.\n"
"Reverted to `None` precision."
msgstr ""
"מצב הדיוק `%s` אינו זמין בפרופיל `gl_compatibility`.\n"
"הוחזר לדיוק `None`."

msgid "'%s' type is incompatible with '%s' source."
msgstr "הסוג '%s' אינו תואם למקור '%s'."

msgid "'%s' default color is incompatible with '%s' source."
msgstr "צבע בררת המחדל '%s' אינו תואם למקור '%s'."

msgid "Default Color"
msgstr "צבע בררת מחדל"

msgid "Repeat"
msgstr "חזרה"

msgid "Invalid comparison function for that type."
