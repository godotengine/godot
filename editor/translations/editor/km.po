msgstr "ឈុតឆាក (Scene) បានបើក: %s។"

msgid "Last saved: %s."
msgstr "បានរក្សាទុកចុងក្រោយ: %s។"

msgid ""
"Scene \"%s\" has unsaved changes.\n"
"%s"
msgstr ""
"ឈុតឆាក (Scene) \"%s\" មានការផ្លាស់ប្ដូរដែលមិនទាន់បានរក្សាទុក។\n"
"%s"

