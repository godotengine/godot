msgstr "\"Use Gradle Build\" ត្រូវបានទាមទារដើម្បីបើក \"Swipe to dismiss\"។"

msgid "\"Use Gradle Build\" must be enabled to use the plugins."
msgstr "\"Use Gradle Build\" ត្រូវតែត្រូវបានបើក ដើម្បីប្រើ plugins។"

msgid ""
"\"Compress Native Libraries\" is only valid when \"Use Gradle Build\" is "
"enabled."
msgstr ""
"\"Compress Native Libraries\" មានសុពលភាពតែនៅពេលដែល \"Use Gradle Build\" "
"ត្រូវបានបើកប៉ុណ្ណោះ។"

