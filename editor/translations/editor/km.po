msgstr "ធ្វើបច្ចុប្បន្នភាពពីឈុតឆាក (Scene)"

msgid "Filter Meshes"
msgstr "ច្រោះ Meshes"

msgid ""
"No items found inside the MeshLibrary.\n"
"You can add some by using the Add button on the left, or by importing them "
"from a scene file via the Import menu."
msgstr ""
"រកមិនឃើញធាតុនៅក្នុង MeshLibrary ទេ។\n"
"អ្នកអាចបន្ថែមធាតុដោយប្រើប៊ូតុង Add នៅខាងឆ្វេង ឬដោយ import វាពីឯកសារឈុតឆាក (Scene) "
"តាមរយៈម៉ឺនុយ Import។"

msgid "Apply without Transforms"
msgstr "អនុវត្តដោយមិនយក Transforms"

msgid "Apply with Transforms"
msgstr "អនុវត្តដោយយក Transforms"

msgid "No mesh source specified (and no MultiMesh set in node)."
msgstr "មិនបានកំណត់ប្រភព mesh (ហើយគ្មាន MultiMesh ក្នុងណូត (Node) ទេ)។"

msgid "No mesh source specified (and MultiMesh contains no Mesh)."
msgstr "មិនបានកំណត់ប្រភព mesh (ហើយ MultiMesh គ្មាន Mesh ទេ)។"

msgid "Mesh source is invalid (invalid path)."
msgstr "ប្រភព Mesh មិនត្រឹមត្រូវ (path មិនត្រឹមត្រូវ)។"

msgid "Mesh source is invalid (not a MeshInstance3D)."
msgstr "ប្រភព Mesh មិនត្រឹមត្រូវ (មិនមែនជា MeshInstance3D)។"

msgid "Mesh source is invalid (contains no Mesh resource)."
msgstr "ប្រភព Mesh មិនត្រឹមត្រូវ (គ្មាន resource Mesh ទេ)។"

msgid "No surface source specified."
msgstr "មិនបានកំណត់ប្រភព surface ទេ។"

msgid "Surface source is invalid (invalid path)."
msgstr "ប្រភព Surface មិនត្រឹមត្រូវ (path មិនត្រឹមត្រូវ)។"

msgid "Surface source is invalid (no geometry)."
msgstr "ប្រភព Surface មិនត្រឹមត្រូវ (គ្មាន geometry ទេ)។"

msgid "Surface source is invalid (no faces)."
msgstr "ប្រភព Surface មិនត្រឹមត្រូវ (គ្មាន faces ទេ)។"

msgid "Select a Source Mesh:"
msgstr "ជ្រើសរើស Source Mesh:"

msgid "Select a Target Surface:"
msgstr "ជ្រើសរើស Target Surface:"

msgid "Populate Surface"
msgstr "បំពេញ Surface"

msgid "Populate MultiMesh"
