#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

import os

from platform_methods import combine_libs_ar, filter_file_libs

import sdl3_sources

# Full SDL3 is part of this platform's build; the joypad driver links against it.
sdl3_files, env_sdl = sdl3_sources.build(env)

sources = [
    "os_sdl3.cpp",
    "display_server_sdl3.cpp",
    "key_mapping_sdl3.cpp",
]

if env["vulkan"]:
    sources.append("rendering_context_driver_vulkan_sdl3.cpp")

# libgodot only: an executable needs a main() the engine does not own.
sources.append("libgodot_sdl3.cpp")

env_thirdparty = env_sdl.Clone()
env_thirdparty.disable_warnings()
env_thirdparty.add_source_files(sources, sdl3_files)

if env["library_type"] == "static_library":
    platform_lib = env.add_library("#bin/godot_static", sources)
    env.CommandNoCache(
        f"#bin/libgodot{env['LIBSUFFIX']}",
        filter_file_libs([platform_lib] + env["LIBS"]),
        env.Run(combine_libs_ar),
    )
elif env["library_type"] == "shared_library":
    # SHLIBSUFFIX carries extra_suffix (".shared_library" for 2dog builds). Without it
    # SCons links the unsuffixed name and the staged artifact silently stays stale.
    shared_args = {"SHLIBSUFFIX": env["SHLIBSUFFIX"]}
    if getattr(env, "msvc", False):
        # mslink's emitter expects the import library's .exp at bin/godot.exp, but link.exe names it after the
        # DLL (godot.<suffix>.exp). SCons never finds it and relinks on every run.
        shared_args["WINDOWSEXPSUFFIX"] = os.path.splitext(env["SHLIBSUFFIX"])[0] + ".exp"
    env.add_shared_library("#bin/godot", sources, **shared_args)
else:
    env.add_program("#bin/godot", sources, PROGSUFFIX=env["PROGSUFFIX"])
