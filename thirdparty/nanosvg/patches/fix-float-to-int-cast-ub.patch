 static int nsvg__curveDivs(float r, float arc, float tol)
 {
 	float da = acosf(r / (r + tol)) * 2.0f;
+	/* For a huge stroke width r/(r+tol) rounds to 1.0f, so acosf() returns 0
+	 * and arc/da becomes +inf; casting that to int is undefined behavior.
+	 * Fall back to the minimum subdivision in that case. */
+	if (!(da > 0.0f)) return 2;
 	int divs = (int)ceilf(arc / da);
 	if (divs < 2) divs = 2;
 	return divs;
