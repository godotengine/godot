+    if (p_node->result_id != 0 && p_node->result_id < p_parser->id_bound) {
+      p_parser->node_index_by_id[p_node->result_id] = node_index + 1;
+    }
+
     if (p_node->is_type) {
       ++(p_parser->type_count);
     }
