+std::vector<ResourceBinding> Inspector::GetModuleResourceBindings() {
+    std::vector<ResourceBinding> result;
+    for (auto* variable : program_.AST().GlobalVariables()) {
+        auto* global = program_.Sem().Get<sem::GlobalVariable>(variable);
+        if (!global || !global->Attributes().binding_point) {
+            continue;
+        }
+        if (global->AddressSpace() == core::AddressSpace::kUniform ||
+            global->AddressSpace() == core::AddressSpace::kStorage) {
+            result.push_back(ConvertBufferToResourceBinding(global));
+        } else if (global->AddressSpace() == core::AddressSpace::kHandle) {
+            result.push_back(ConvertHandleToResourceBinding(global));
+        }
+    }
+    return result;
+}
