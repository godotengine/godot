_complete_godot_options() {
  # Since Bash doesn't support option descriptions in autocompletion,
  # only display long options to be more descriptive.
  # shellcheck disable=SC2207
  COMPREPLY=($(compgen -W " \
--help
--version
--verbose
--quiet
--no-header
--editor
--project-manager
--recovery-mode
--debug-server
--dap-port
--lsp-port
--quit
--quit-after
--language
--path
--scene
--main-pack
--render-thread
--remote-fs
--remote-fs-password
--audio-driver
--display-driver
--audio-output-latency
--rendering-method
--rendering-driver
--gpu-index
--text-driver
--tablet-driver
--headless
--log-file
--write-movie
--fullscreen
--maximized
--windowed
--always-on-top
--resolution
--position
