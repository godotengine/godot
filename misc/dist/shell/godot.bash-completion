--dump-gdextension-interface-json
--dump-extension-api
--dump-extension-api-with-docs
--validate-extension-api
--benchmark
--benchmark-file
--test
" -- "$1"))
}

_complete_godot_bash() {
  local cur="${COMP_WORDS[$COMP_CWORD]}" prev

  # Complete options or the positional argument.
  if [[ $cur == -* ]]; then
    _complete_godot_options "$cur"
  else
    local IFS=$'\n\t'
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -f -X "!*.@(scn|tscn|escn|godot)" -- "$cur"))
  fi

  # If the array is accessed out of bounds (which will happen for the first argument),
  # `$prev` will be an empty string and won't match any of the conditions below.
  prev="${COMP_WORDS[$((COMP_CWORD-1))]}"

  # Complete option values.
  if [[ $prev == "--render-thread" ]]; then
    local IFS=$' \n\t'
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -W "safe separate" -- "$cur"))
  elif [[ $prev == "--audio-driver" ]]; then
    local IFS=$' \n\t'
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -W "PulseAudio ALSA CoreAudio WASAPI XAudio2 Dummy" -- "$cur"))
  elif [[ $prev == "--display-driver" ]]; then
    local IFS=$' \n\t'
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -W "x11 wayland macos windows headless" -- "$cur"))
  elif [[ $prev == "--rendering-method" ]]; then
    local IFS=$' \n\t'
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -W "forward_plus mobile gl_compatibility dummy" -- "$cur"))
  elif [[ $prev == "--rendering-driver" ]]; then
    local IFS=$' \n\t'
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -W "vulkan d3d12 metal opengl3 opengl3_es opengl3_angle dummy" -- "$cur"))
  elif [[ $prev == "--xr-mode" ]]; then
    local IFS=$' \n\t'
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -W "default off on" -- "$cur"))
  elif [[ $prev == "--accessibility" ]]; then
    local IFS=$' \n\t'
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -W "auto always disabled" -- "$cur"))
  elif [[ $prev == "--accessibility-driver" ]]; then
    local IFS=$' \n\t'
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -W "accesskit dummy" -- "$cur"))
  elif [[ $prev == "--delta-smoothing" ]]; then
    local IFS=$' \n\t'
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -W "enable disable" -- "$cur"))
  elif [[ $prev == "--path" || $prev == "--doctool" || $prev == "--gdscript-docs" ]]; then
    local IFS=$'\n\t'
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -d -- "$cur"))
  elif [[ $prev == "--scene" ]]; then
    local IFS=$'\n\t'
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -f -X "!*.@(scn|tscn|escn)" -- "$cur"))
  elif [[ $prev == "--main-pack" ]]; then
    local IFS=$'\n\t'
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -f -X "!*.@(pck|zip)" -- "$cur"))
  elif [[ $prev == "-s" || $prev == "--script" ]]; then
    local IFS=$'\n\t'
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -f -X "!*.gd" -- "$cur"))
  elif [[ $prev == "--log-file" || $prev == "--write-movie" || $prev == "--validate-extension-api" || $prev == "--benchmark-file" ]]; then
    local IFS=$'\n\t'
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -f -- "$cur"))
  fi
}

complete -o filenames -F _complete_godot_bash godot
