<?xml version="1.0" encoding="UTF-8" ?>
<class name="VisualShaderNodeSwitch" inherits="VisualShaderNode" api_type="core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
	<brief_description>
		A selector function for use within the visual shader graph.
	</brief_description>
	<description>
		Returns an associated value of the [member op_type] type if the provided boolean value is [code]true[/code] or [code]false[/code].
	</description>
	<tutorials>
	</tutorials>
	<members>
		<member name="op_type" type="int" setter="set_op_type" getter="get_op_type" enum="VisualShaderNodeSwitch.OpType" default="0">
			A type of operands and returned value.
		</member>
	</members>
	<enums>
		<enum name="OpType">
			<constant name="OP_TYPE_FLOAT" value="0">
				A floating-point scalar.
			</constant>
			<constant name="OP_TYPE_INT" value="1">
				An integer scalar.
			</constant>
			<constant name="OP_TYPE_UINT" value="2">
				An unsigned integer scalar.
			</constant>
			<constant name="OP_TYPE_VECTOR_2D" value="3">
				A 2D vector type.
			</constant>
			<constant name="OP_TYPE_VECTOR_3D" value="4">
				A 3D vector type.
			</constant>
			<constant name="OP_TYPE_VECTOR_4D" value="5">
				A 4D vector type.
			</constant>
			<constant name="OP_TYPE_BOOLEAN" value="6">
				A boolean type.
			</constant>
			<constant name="OP_TYPE_TRANSFORM" value="7">
				A transform type.
			</constant>
			<constant name="OP_TYPE_MAX" value="8">
				Represents the size of the [enum OpType] enum.
			</constant>
		</enum>
	</enums>
</class>
