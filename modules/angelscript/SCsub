#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_as = env_modules.Clone()

env_as.Prepend(CPPPATH=["#modules/angelscript/thirdparty/angelscript/include"])

env_angelscript = env_as.Clone()

# 依据平台/架构/编译器显式接线 AngelScript 的 callfunc 汇编实现。
# vendored 的 as_callfunc_*.cpp 只覆盖部分架构；arm/riscv 等需要额外的 .S，
# 而 x86_64 的 GCC/Clang 实现完整内联在 as_callfunc_x64_gcc.cpp。
import sys

sys.path.insert(0, env.Dir("#modules/angelscript").abspath)
import asm_sources

_selection = asm_sources.select_callfunc_sources(env["platform"], env["arch"], env.msvc)

if _selection.max_portability:
    # 未映射的架构：回退到 AngelScript 的纯可移植实现。
    env_angelscript.Append(CPPDEFINES=["AS_MAX_PORTABILITY"])
elif env.msvc:
    # MSVC 的 x64 callfunc 是独立 .asm，需要 ml64 汇编成 .obj。
    for _asm_name in _selection.asm_sources:
        _asm_path = "thirdparty/angelscript/source/" + _asm_name
        _asm_obj = env.Command(
            _asm_path[:-4] + ".obj",
            _asm_path,
            "ml64 /c /nologo /W3 /Zi /Fo$TARGET /Ta $SOURCE",
        )
        env.modules_sources.append(_asm_obj)
elif _selection.asm_sources:
    env_angelscript.add_source_files(
        env.modules_sources,
        ["thirdparty/angelscript/source/" + _asm_name for _asm_name in _selection.asm_sources],
    )

if not env.msvc:
    env_angelscript.Append(CCFLAGS=["-fno-strict-aliasing"])

# 第三方代码不由我们维护，不参与引擎的告警策略。
env_angelscript.disable_warnings()
env_angelscript.add_source_files(env.modules_sources, "thirdparty/angelscript/source/*.cpp")

# Apply only to our binding/test sources, not the VM or the rest of Godot.
if env["angelscript_force_generic"]:
    env_as.Append(CPPDEFINES=["AS_NATIVE_VALUE_OPS_FORCE_GENERIC"])
if env["angelscript_pod_geometry_probe"]:
    env_as.Append(CPPDEFINES=["AS_POD_GEOMETRY_PROBE"])

env_as.add_source_files(env.modules_sources, "*.cpp")

# binding/ 子目录（M2 绑定层）；同时把模块根加入 include 路径，
# 让模块内跨目录 include 写成 "binding/as_binding_*.h"。
env_as.Prepend(CPPPATH=["#modules/angelscript"])
env_as.add_source_files(env.modules_sources, "binding/*.cpp")

# editor/ 子目录（编辑器语法高亮器）；仅在编辑器构建下编译，运行时零影响。
if env.editor_build:
    env_as.add_source_files(env.modules_sources, "./editor/*.cpp")

if env["tests"]:
    # 用例注册写在 tests/*.h：modules/modules_tests.gen.h 会把各模块的 tests/*.h
    # include 进 tests/test_main.cpp，用例才会进入最终二进制。
    # 这里的 tests/*.cpp 只放用例辅助实现，编进 module_angelscript.lib 后由链接器按需拉入。
    env_as.add_source_files(env.modules_sources, "./tests/*.cpp")
