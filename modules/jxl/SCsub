    env_jxl.Append(CPPDEFINES=["JXL_STATIC_DEFINE", "JXL_CMS_STATIC_DEFINE"])

    env_thirdparty = env_jxl.Clone()
    env_thirdparty.disable_warnings()
    env_thirdparty.Append(
        CPPDEFINES=[
            "JXL_INTERNAL_LIBRARY_BUILD",
            ("JPEGXL_ENABLE_SKCMS", 1),
            # Leave out JPEG transcoding and metadata boxes.
            ("JPEGXL_ENABLE_TRANSCODE_JPEG", 0),
            ("JPEGXL_ENABLE_BOXES", 0),
            "SKCMS_DISABLE_HSW",
            "SKCMS_DISABLE_SKX",
        ]
    )
    if env["platform"] == "windows":
        env_thirdparty.Append(CPPDEFINES=[("SKCMS_HAS_MUSTTAIL", 0)])
    # SSSE3 is never used, since Godot requires SSE4.2.
    hwy_disabled_targets = ["HWY_SSSE3"]
    if not env["jxl_all_simd_targets"]:
        hwy_disabled_targets += [
            "HWY_AVX3",
            "HWY_AVX3_DL",
            "HWY_AVX3_ZEN4",
            "HWY_AVX3_SPR",
            "HWY_NEON_BF16",
            "HWY_ALL_SVE",
        ]
    # Target bits don't overlap, so + works like | and avoids shell-special characters.
    env_thirdparty.Append(CPPDEFINES=[("HWY_DISABLED_TARGETS", "+".join(hwy_disabled_targets))])
    env_thirdparty.add_source_files(thirdparty_obj, highway_sources)
    env_thirdparty.add_source_files(thirdparty_obj, skcms_sources)
    env_thirdparty.add_source_files(thirdparty_obj, jxl_sources)
    env.modules_sources += thirdparty_obj


# Godot source files

module_obj = []

env_jxl.add_source_files(module_obj, "*.cpp")
env.modules_sources += module_obj

# Needed to force rebuilding the module files when the thirdparty library is updated.
env.Depends(module_obj, thirdparty_obj)
